-- Anti Afk - Matcha LuauVM
-- Keeps the client active without moving, jumping or touching your mouse.
-- Keys are injected into Roblox only, never into another window.
-- Roblox's own 20 minute timer is client input based: whether an unfocused
-- client still counts injected input varies by build, so this script reports
-- what it sees instead of assuming.

local NAME    = 'AntiAfk'
local VERSION = 'v2.0'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local UIS     = game:GetService('UserInputService')
local running = true
local built   = false
local fires   = 0
local seen    = 0
local skipped = 0
local nextAt  = 0
local works   = nil

local cfg = {
    enabled   = true,
    interval  = 55,
    jitter    = 15,
    unfocused = true,
}

local VK = 0x13
local remotes = {}

local function log(...)
    print('[' .. NAME .. ']', ...)
end

local function schedule()
    local j = 0
    if cfg.jitter > 0 then
        j = math.random(-cfg.jitter, cfg.jitter)
    end
    local w = cfg.interval + j
    if w < 10 then w = 10 end
    nextAt = tick() + w
end

local connIn = UIS.InputBegan:Connect(function(input)
    seen = seen + 1
end)

local function pingRemotes()
    local n = 0
    for i = 1, #remotes do
        local r = remotes[i]
        local ok = pcall(function()
            r.obj:FireServer(table.unpack(r.args))
        end)
        if ok then n = n + 1 end
    end
    return n
end

local function inject()
    if not cfg.enabled then return false end
    local active = true
    if type(isrbxactive) == 'function' then
        active = isrbxactive()
    end
    if not active and not cfg.unfocused then
        skipped = skipped + 1
        return false
    end
    local before = seen
    if type(setrobloxinput) == 'function' then
        pcall(setrobloxinput, true)
    end
    if type(keypress) == 'function' then
        pcall(keypress, VK)
        task.wait(0.05)
        pcall(keyrelease, VK)
    end
    if type(setrobloxinput) == 'function' then
        pcall(setrobloxinput, true, VK)
        task.wait(0.02)
        pcall(setrobloxinput, false, VK)
    end
    task.wait(0.12)
    fires = fires + 1
    if seen > before then
        works = true
    elseif works == nil then
        works = false
    end
    return true
end

local function addRemote(remote, args)
    if remote == nil then return false end
    remotes[#remotes + 1] = { obj = remote, args = args or {} }
    log('remote added, total ' .. #remotes)
    return true
end

task.spawn(function()
    schedule()
    while running do
        if tick() >= nextAt then
            local sent = inject()
            local r = pingRemotes()
            if sent and r > 0 then
                log('key sent and ' .. r .. ' remote pinged')
            elseif sent then
                log('key sent, total ' .. fires)
            end
            schedule()
        end
        task.wait(1)
    end
end)

-- menu ---------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section failed: ' .. name)
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function statusLine()
    local a = false
    if type(isrbxactive) == 'function' then a = isrbxactive() end
    local w = 'unknown'
    if works == true then w = 'client sees it'
    elseif works == false then w = 'client does not see it'
    end
    return 'enabled=' .. tostring(cfg.enabled) .. ' fires=' .. fires ..
        ' seen=' .. seen .. ' skipped=' .. skipped ..
        ' window=' .. tostring(a) .. ' input=' .. w .. ' remotes=' .. #remotes
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Keepalive')
        if not sec then return end
        mkToggle(sec, 'Enabled', 'aa_enabled', true, function(v)
            cfg.enabled = v
            log('enabled = ' .. tostring(v))
        end)
        mkToggle(sec, 'Try While Unfocused', 'aa_unfocused', true, function(v)
            cfg.unfocused = v
            log('unfocused attempts = ' .. tostring(v))
        end)
        mkSlider(sec, 'Interval (s)', 'aa_interval', 20, 300, 55, function(v)
            cfg.interval = v
            schedule()
        end)
        mkSlider(sec, 'Jitter (s)', 'aa_jitter', 0, 60, 15, function(v)
            cfg.jitter = v
        end)
        mkButton(sec, 'Send now', function()
            local sent = inject()
            log('manual send ' .. tostring(sent) .. ', total ' .. fires)
            if type(notify) == 'function' then
                notify('Anti Afk', sent and 'key sent' or 'skipped', 2)
            end
        end)
        mkButton(sec, 'Ping remotes', function()
            local n = pingRemotes()
            log('pinged ' .. n .. ' remotes')
            if type(notify) == 'function' then
                notify('Anti Afk', 'pinged ' .. n .. ' remotes', 2)
            end
        end)
        mkButton(sec, 'Status', function()
            log(statusLine())
            if type(notify) == 'function' then
                notify('Anti Afk', statusLine(), 4)
            end
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] build error: ' .. tostring(err))
    end
    log('tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Anti Afk', function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

local function stop()
    running = false
    pcall(function() connIn:Disconnect() end)
    if type(UI) == 'table' and type(UI.RemoveTab) == 'function' then
        pcall(function() UI.RemoveTab('Anti Afk') end)
    end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION, addRemote = addRemote }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI))
