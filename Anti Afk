-- Anti Afk - Matcha LuauVM
-- Built to work while the Roblox window is NOT focused.
-- Probed on this build: keypress / mouse1click / setrobloxinput reach an
-- unfocused client 0 times, so the keepalive uses the two things that do
-- work without focus - the client's own activity remote and a camera
-- micro-drift. Neither moves the character, so nothing is visible to others.

local NAME    = 'AntiAfk'
local VERSION = 'v3.0'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local UIS = game:GetService('UserInputService')
local RRS = game:GetService('RobloxReplicatedStorage')
local RS  = game:GetService('ReplicatedStorage')

local running     = true
local built       = false
local fires       = 0
local remoteFires = 0
local camDrifts   = 0
local skipped     = 0
local nextAt      = 0
local works       = nil

local cfg = {
    enabled  = true,
    interval = 60,
    jitter   = 15,
    keys     = true,
    camera   = true,
    remote   = true,
}

local VK      = 0x13
local remotes = {}
local seen    = 0

local function log(...)
    print('[' .. NAME .. ']', ...)
end

local function isActive()
    if type(isrbxactive) == 'function' then
        local ok, v = pcall(isrbxactive)
        if ok then return v == true end
    end
    return false
end

local function schedule()
    local j = 0
    if cfg.jitter > 0 then
        j = math.random(-cfg.jitter, cfg.jitter)
    end
    local w = cfg.interval + j
    if w < 10 then w = 10 end
    nextAt = tick() + w
end

local connIn = UIS.InputBegan:Connect(function(input)
    seen = seen + 1
end)

-- remotes ------------------------------------------------------------

local function addRemote(obj, args)
    if obj == nil then return false end
    for i = 1, #remotes do
        if remotes[i].name == obj.Name then return false end
    end
    remotes[#remotes + 1] = { obj = obj, name = obj.Name, args = args or { true } }
    log('remote registered: ' .. tostring(obj.Name) .. ' (total ' .. #remotes .. ')')
    return true
end

local function pingRemotes()
    if not cfg.remote then return 0 end
    local n = 0
    for i = 1, #remotes do
        local r = remotes[i]
        local ok = pcall(function()
            r.obj:FireServer(table.unpack(r.args))
        end)
        if ok then
            n = n + 1
            remoteFires = remoteFires + 1
        end
    end
    return n
end

local function scanRemotes()
    local found = {}
    local roots = { RRS, RS }
    for i = 1, #roots do
        local root = roots[i]
        if root then
            local ok, kids = pcall(function() return root:GetChildren() end)
            if ok and kids then
                for k = 1, #kids do
                    local c = kids[k]
                    if c.ClassName == 'RemoteEvent' then
                        local n = string.lower(c.Name)
                        if string.find(n, 'active', 1, true) or string.find(n, 'idle', 1, true) or string.find(n, 'presence', 1, true) then
                            found[#found + 1] = c.Name
                        end
                    end
                end
            end
        end
    end
    if #found == 0 then
        log('scan: no activity remotes found')
    else
        log('scan: ' .. table.concat(found, ', '))
    end
    return found
end

-- camera -------------------------------------------------------------

local function driftCamera()
    if not cfg.camera then return false end
    local cam = workspace.CurrentCamera
    if cam == nil then return false end
    local ok = pcall(function()
        for i = 1, 4 do
            cam.CFrame = cam.CFrame * CFrame.Angles(0, math.rad(0.3), 0)
            task.wait(0.03)
        end
    end)
    if ok then
        camDrifts = camDrifts + 1
        return true
    end
    return false
end

-- keys (only land while the window is focused) -----------------------

local function injectKeys()
    if not cfg.keys then return false end
    if not isActive() then
        skipped = skipped + 1
        return false
    end
    local before = seen
    if type(setrobloxinput) == 'function' then
        pcall(setrobloxinput, true)
    end
    if type(keypress) == 'function' then
        pcall(keypress, VK)
        task.wait(0.05)
        pcall(keyrelease, VK)
    end
    task.wait(0.08)
    fires = fires + 1
    if seen > before then
        works = true
    elseif works == nil then
        works = false
    end
    return true
end

local function pass()
    if not cfg.enabled then return end
    local active = isActive()
    local r = pingRemotes()
    driftCamera()
    if active then
        injectKeys()
    else
        skipped = skipped + 1
    end
    log('pass: focus=' .. tostring(active) .. ' remotes=' .. r ..
        ' cam=' .. camDrifts .. ' keys=' .. fires .. ' skipped=' .. skipped)
end

-- boot ---------------------------------------------------------------

do
    local sua = RRS and RRS:FindFirstChild('SetUserActive')
    if sua then
        addRemote(sua, { true })
    else
        log('SetUserActive not found in this game')
    end
    pcall(function() scanRemotes() end)
end

task.spawn(function()
    schedule()
    task.wait(0.2)
    pcall(pingRemotes)
    while running do
        if tick() >= nextAt then
            pcall(pass)
            schedule()
        end
        task.wait(1)
    end
end)

-- menu ---------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section failed: ' .. name)
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function statusLine()
    local w = 'unknown'
    if works == true then w = 'keys seen'
    elseif works == false then w = 'keys not seen' end
    return 'enabled=' .. tostring(cfg.enabled) ..
        ' focus=' .. tostring(isActive()) ..
        ' remotes=' .. #remotes .. '/' .. remoteFires ..
        ' cam=' .. camDrifts ..
        ' keys=' .. fires .. ' skipped=' .. skipped ..
        ' input=' .. w
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Keepalive')
        if not sec then return end
        mkToggle(sec, 'Enabled', 'aa_enabled', true, function(v)
            cfg.enabled = v
            log('enabled = ' .. tostring(v))
        end)
        mkToggle(sec, 'Remote Ping', 'aa_remote', true, function(v)
            cfg.remote = v
            log('remote ping = ' .. tostring(v))
        end)
        mkToggle(sec, 'Camera Drift', 'aa_camera', true, function(v)
            cfg.camera = v
            log('camera drift = ' .. tostring(v))
        end)
        mkToggle(sec, 'Keys When Focused', 'aa_keys', true, function(v)
            cfg.keys = v
            log('keys = ' .. tostring(v))
        end)
        mkSlider(sec, 'Interval (s)', 'aa_interval', 20, 300, 60, function(v)
            cfg.interval = v
            schedule()
        end)
        mkSlider(sec, 'Jitter (s)', 'aa_jitter', 0, 60, 15, function(v)
            cfg.jitter = v
        end)
        mkButton(sec, 'Send now', function()
            pcall(pass)
            log('manual pass, status: ' .. statusLine())
            if type(notify) == 'function' then
                notify('Anti Afk', 'pass sent', 2)
            end
        end)
        mkButton(sec, 'Scan remotes', function()
            local f = scanRemotes()
            if type(notify) == 'function' then
                notify('Anti Afk', #f .. ' candidates in log', 3)
            end
        end)
        mkButton(sec, 'Status', function()
            log(statusLine())
            if type(notify) == 'function' then
                notify('Anti Afk', statusLine(), 4)
            end
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] build error: ' .. tostring(err))
    end
    log('tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Anti Afk', function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table, running with defaults')
end

local function stop()
    running = false
    pcall(function() connIn:Disconnect() end)
    if type(UI) == 'table' and type(UI.RemoveTab) == 'function' then
        pcall(function() UI.RemoveTab('Anti Afk') end)
    end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, addRemote = addRemote, scan = scanRemotes, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, remotes=' .. #remotes .. ' menu=' .. tostring(HAS_UI))
