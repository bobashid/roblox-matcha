local ov = { bg = nil, title = nil, big = nil, sub = nil, ok = false }

local function destroyOverlay()
    if ov.bg then pcall(function() ov.bg:Remove() end) ov.bg = nil end
    if ov.title then pcall(function() ov.title:Remove() end) ov.title = nil end
    if ov.big then pcall(function() ov.big:Remove() end) ov.big = nil end
    if ov.sub then pcall(function() ov.sub:Remove() end) ov.sub = nil end
    ov.ok = false
