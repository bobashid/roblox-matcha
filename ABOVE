-- ABOVE
-- VERSION 5.1.0
-- place 124357835578554 (game.Name reports "Ugc")
-- One toggle, "Auto Harvest (berries)":
--   * finds every ripe BerryBush (HB:Ripe == true), warps onto it and fires
--     RequestHarvest with that bush's HB (the call shape you gave me)
--   * finds every loose berry (a BasePart carrying a numeric "Count"
--     attribute - the game's own LooseCountController reads exactly that;
--     CollectionService tags are nil in this VM) and fires RequestPickup
--     on it from within reach
--   * warps you back to where you started once nothing is left
-- Both remotes are range-checked by the server, so standing still can never
-- farm past arm's length. No keys, no Drawing, no ESP.
-- Stop = switch the toggle off.

local NAME = "AboveBerries"
local VERSION = "5.1.0"

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local function svc(name)
    local ok, s = pcall(function() return game:GetService(name) end)
    if ok and s then return s end
    return game:FindFirstChild(name)
end

local Players = svc("Players")
local RS = svc("ReplicatedStorage")

local CFG = {
    on = false,
    interval = 0.15,
    rescanTicks = 4,
    bushPerTick = 1,
    pickupPerTick = 6,
    reachY = 3,
    nearStuds = 6,
    warpGap = 0.05,
    idleReturn = 3,
}

local PART = {
    Part = true,
    MeshPart = true,
    UnionOperation = true,
    WedgePart = true,
    CornerWedgePart = true,
}

local SKIPNAME = {
    Nodes = true,
    Decoration = true,
    PlacementGhost = true,
    Prefabs = true,
}

local running = true
local built = false
local homeCF = nil
local lastWarp = 0
local idleSince = 0
local ticks = 0
local drops = {}
local stats = { bushes = 0, ripe = 0, harvest = 0, pickup = 0, warps = 0, back = 0, drops = 0 }
local lastStatus = 0

local function log(msg)
    print("[ABOVE] " .. tostring(msg))
end

local function getRoot()
    if not Players then return nil end
    local lp = Players.LocalPlayer
    if not lp then return nil end
    local ch = lp.Character
    if not ch then return nil end
    return ch:FindFirstChild("HumanoidRootPart")
end

local function getIsland()
    for i, d in ipairs(workspace:GetChildren()) do
        if string.sub(d.Name, 1, 7) == "Island_" then return d end
    end
    return nil
end

local function remote(name)
    if not RS then return nil end
    local r = RS:FindFirstChild("Remotes")
    if not r then return nil end
    return r:FindFirstChild(name)
end

local function numAttr(o, k)
    if not o then return nil end
    local ok, v = pcall(function() return o:GetAttribute(k) end)
    if ok and type(v) == "number" then return v end
    return nil
end

local function boolAttr(o, k)
    if not o then return nil end
    local ok, v = pcall(function() return o:GetAttribute(k) end)
    if ok and type(v) == "boolean" then return v end
    return nil
end

local function posOf(o)
    if not o then return nil end
    local ok, p = pcall(function() return o.Position end)
    if ok and p then return p end
    return nil
end

local function isRipe(hb)
    local r = boolAttr(hb, "Ripe")
    if r ~= nil then return r end
    local bush = hb and hb.Parent
    if bush then
        local ber = bush:FindFirstChild("Berries")
        if ber then
            local p = ber:GetChildren()[1]
            if p then
                local ok, t = pcall(function() return p.Transparency end)
                if ok and type(t) == "number" then return t < 0.5 end
            end
        end
    end
    return false
end

local function collectRipe(ppos)
    local isl = getIsland()
    if not isl then return nil, {}, 0 end
    local nodes = isl:FindFirstChild("Nodes")
    if not nodes then return isl, {}, 0 end
    local list = {}
    local total = 0
    for i, n in ipairs(nodes:GetChildren()) do
        if n.Name == "BerryBush" then
            total = total + 1
            local hb = n:FindFirstChild("HB")
            if hb and isRipe(hb) then
                local p = posOf(hb)
                local d = math.huge
                if p then d = (p - ppos).Magnitude end
                list[#list + 1] = { hb = hb, pos = p, d = d }
            end
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    return isl, list, total
end

local function skipped(d)
    local p = d
    for i = 1, 8 do
        if not p or p == workspace then return false end
        if SKIPNAME[p.Name] then return true end
        if string.find(p.Name, "Rock", 1, true) then return true end
        p = p.Parent
    end
    return false
end

local function looksLoose(d)
    local low = string.lower(d.Name)
    if string.find(low, "berry", 1, true) then return true end
    return string.sub(low, 1, 9) == "icosphere"
end

-- A loose berry is a BasePart with a numeric Count attribute. Name alone is
-- useless: decoration rocks are MeshParts named Icosphere / Icosphere.001
-- under Workspace.Hub.Decoration.Rock 2.
local function scanLoose()
    local out = {}
    local seen = {}
    local checked = 0
    pcall(function()
        for i, d in ipairs(workspace:GetDescendants()) do
            if checked >= 200 then break end
            if PART[d.ClassName] and looksLoose(d) and not skipped(d) then
                checked = checked + 1
                local c = numAttr(d, "Count")
                if c and c >= 1 then
                    local key = nil
                    local okn, nm = pcall(function() return d:GetFullName() end)
                    if okn and type(nm) == "string" then key = nm end
                    if key and not seen[key] then
                        seen[key] = true
                        out[#out + 1] = { part = d, pos = posOf(d) }
                    end
                end
            end
        end
    end)
    return out
end

local function warpTo(pos, rp, lift)
    if not pos or not rp then return false end
    local now = os.clock()
    if now - lastWarp < CFG.warpGap then return false end
    lastWarp = now
    local ok = pcall(function()
        rp.CFrame = CFrame.new(pos.X, pos.Y + (lift or CFG.reachY), pos.Z)
    end)
    if ok then stats.warps = stats.warps + 1 end
    return ok
end

local function saveHome(rp)
    if homeCF or not rp then return end
    local ok, cf = pcall(function() return rp.CFrame end)
    if ok and cf then homeCF = cf end
end

local function goHome(rp)
    if not homeCF or not rp then return end
    pcall(function() rp.CFrame = homeCF end)
    homeCF = nil
    stats.back = stats.back + 1
end

local function fire(ev, arg)
    if not ev or not arg then return false end
    local ok = pcall(function() ev:FireServer(arg) end)
    return ok
end

local function tick()
    local rp = getRoot()
    if not rp then return end
    local ppos = posOf(rp)
    if not ppos then return end
    ticks = ticks + 1

    local isl, list, total = collectRipe(ppos)
    stats.bushes = total or 0
    stats.ripe = #list

    if ticks % CFG.rescanTicks == 1 then
        drops = scanLoose()
        stats.drops = #drops
    end

    local busy = false
    if #list > 0 then busy = true end
    if #drops > 0 then busy = true end

    if not busy then
        if homeCF and os.clock() - idleSince > CFG.idleReturn then goHome(rp) end
        idleSince = os.clock()
    else
        idleSince = os.clock()
        saveHome(rp)

        local evH = remote("RequestHarvest")
        local done = 0
        for i, e in ipairs(list) do
            if done >= CFG.bushPerTick then break end
            done = done + 1
            if e.hb and e.hb.Parent and e.pos then
                if e.d > CFG.nearStuds then warpTo(e.pos, rp) end
                if fire(evH, e.hb) then stats.harvest = stats.harvest + 1 end
            end
        end

        local evP = remote("RequestPickup")
        local fired = 0
        for i, d in ipairs(drops) do
            if fired >= CFG.pickupPerTick then break end
            if d.part and d.part.Parent then
                fired = fired + 1
                local p = d.pos or posOf(d.part)
                if p then
                    if (p - ppos).Magnitude > CFG.nearStuds then warpTo(p, rp, 2) end
                end
                if fire(evP, d.part) then stats.pickup = stats.pickup + 1 end
            end
        end
    end

    local now = os.clock()
    if now - lastStatus > 10 then
        lastStatus = now
        log("bushes " .. tostring(stats.bushes)
            .. " | ripe " .. tostring(stats.ripe)
            .. " | harvest " .. tostring(stats.harvest)
            .. " | drops " .. tostring(stats.drops)
            .. " | pickups " .. tostring(stats.pickup)
            .. " | warps " .. tostring(stats.warps))
    end
end

local function pollWidgets()
    local M = _G.UI
    if not M or not M.GetValue then return end
    local ok, v = pcall(function() return M.GetValue("ab_on") end)
    if ok and type(v) == "boolean" then
        CFG.on = v
    end
end

local function buildMenu()
    local M = _G.UI
    if not M or not M.AddTab then
        log("UI not found - toggle unavailable")
        return
    end
    local ok = pcall(function()
        M.AddTab("ABOVE Berries", function(tab)
            if built then return end
            built = true
            pcall(function()
                local sec = tab:Section("Berries", "Left")
                if sec then
                    sec:Toggle("ab_on", "Auto Harvest (berries)", false, function(v)
                        CFG.on = v
                    end)
                    sec:Tip("Warps to each ripe bush and berry, then back.")
                end
            end)
        end)
    end)
    if not ok then
        log("AddTab failed")
    end
end

local function stop()
    running = false
    local rp = getRoot()
    if homeCF and rp then
        pcall(function() rp.CFrame = homeCF end)
        homeCF = nil
    end
    drops = {}
    local M = _G.UI
    if M and M.RemoveTab then
        pcall(function() M.RemoveTab("ABOVE Berries") end)
    end
    _G[NAME] = nil
    log("stopped")
end

task.spawn(function()
    local waited = 0
    while running and not (_G.UI and _G.UI.AddTab) and waited < 15 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    buildMenu()
end)

task.spawn(function()
    while running do
        pcall(pollWidgets)
        if CFG.on then
            local ok, err = pcall(tick)
            if not ok then
                log("tick error " .. tostring(err))
            end
        else
            local rp = getRoot()
            if homeCF and rp then goHome(rp) end
        end
        task.wait(CFG.interval)
    end
end)

_G[NAME] = { stop = stop, version = VERSION }
log("v" .. VERSION .. " loaded on place " .. tostring(game.PlaceId))
