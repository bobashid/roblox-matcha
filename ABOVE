    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
        log("Drawing unavailable - counter overlay disabled")
        return
    end
    local vx, vy = overlayOrigin()
    local ok = pcall(function()
        ov.bg = Drawing.new("Square")
        ov.bg.Filled = true
        ov.bg.Color = Color3.fromRGB(16, 18, 26)
        ov.bg.Transparency = 0.35
        ov.bg.Size = Vector2.new(OVERLAY_W, OVERLAY_H)
        ov.bg.Position = Vector2.new(vx, vy)
        ov.bg.Visible = true

        ov.title = Drawing.new("Text")
        ov.title.Text = "BERRIES HARVESTED / SEC"
        ov.title.Size = 18
        ov.title.Color = Color3.fromRGB(140, 225, 155)
        ov.title.Outline = true
        ov.title.Center = false
        ov.title.Position = Vector2.new(vx + 18, vy + 10)
        ov.title.Visible = true

        ov.big = Drawing.new("Text")
        ov.big.Text = "0.0"
        ov.big.Size = 48
        ov.big.Color = Color3.fromRGB(255, 255, 255)
        ov.big.Outline = true
        ov.big.Center = false
        ov.big.Position = Vector2.new(vx + 16, vy + 32)
        ov.big.Visible = true

        ov.sub = Drawing.new("Text")
        ov.sub.Text = "harvested 0  |  picked 0"
        ov.sub.Size = 18
