--[[
    ABOVE  -  silent berry farm
    Place: 124357835578554  (game.Name reports 'Ugc' - match by place id)

    What it does
      - Silent ESP on ripe BerryBush nodes (Drawing only, no Highlight, no GuiObject)
      - Auto harvest of the nearest ripe bush inside Radius
      - Harvest route ladder (the RequestHarvest argument shape is not yet confirmed,
        so the script tries the documented shapes and credits the one that changes the world)
      - Probe button that prints HB attribute names/values and the remote classes

    Controls: menu only. Stop = turn the toggle off.

    Version 1.0.0
]]

local VERSION = "1.0.0"
local NAME = "ABOVE_BerryFarm"

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local unpackFn = table.unpack or unpack

local function svc(n)
    local ok, r = pcall(function() return game:GetService(n) end)
    if ok and r then return r end
    ok, r = pcall(function() return game:FindFirstChild(n) end)
    if ok and r then return r end
    ok, r = pcall(function() return game:GetChildren() end)
    if ok and type(r) == "table" then
        for i = 1, #r do
            if r[i].ClassName == n then return r[i] end
        end
    end
    return nil
end

local Players = svc("Players")
local RS = svc("ReplicatedStorage")
local RunService = svc("RunService")
local Remotes = nil
if RS then Remotes = RS:FindFirstChild("Remotes") end

print("[ABOVE] v" .. VERSION .. " loading")

local CONFIG = {
    esp = false,
    autoHarvest = false,
    radius = 300,
    delay = 0.35,
    route = 0,
}

local running = true
local conns = {}
local SNAP = {}

-- ---------------------------------------------------------------- helpers

local function attr(obj, key)
    if not obj then return nil end
    local ok, v = pcall(function() return obj:GetAttribute(key) end)
    if ok then return v end
    return nil
end

local function children(obj)
    if not obj then return {} end
    local ok, r = pcall(function() return obj:GetChildren() end)
    if ok and type(r) == "table" then return r end
    return {}
end

local function myIsland()
    local lp = Players and Players.LocalPlayer
    local uid = lp and lp.UserId
    local ok, kids = pcall(function() return workspace:GetChildren() end)
    if not ok or type(kids) ~= "table" then return nil end
    local fallback = nil
    for i = 1, #kids do
        local c = kids[i]
        local nm = c.Name
        if string.sub(nm, 1, 7) == "Island_" then
            if not fallback then fallback = c end
            if uid and string.find(nm, tostring(uid), 1, true) then return c end
        end
    end
    return fallback
end

local function scanBushes()
    local out = {}
    local isl = myIsland()
    if not isl then return out end
    local nodes = isl:FindFirstChild("Nodes")
    if not nodes then return out end
    local kids = children(nodes)
    for i = 1, #kids do
        local n = kids[i]
        if n.Name == "BerryBush" then
            local hb = n:FindFirstChild("HB")
            if hb then
                out[#out + 1] = { model = n, hb = hb, ber = n:FindFirstChild("Berries") }
            end
        end
    end
    return out
end

local function isRipe(e)
    local r = attr(e.hb, "Ripe")
    if r == true then return true end
    if type(r) == "number" and r > 0 then return true end
    local ber = e.ber
    if ber then
        local kids = children(ber)
        local visible = 0
        for i = 1, #kids do
            local t = kids[i].Transparency
            if type(t) == "number" and t < 0.9 then visible = visible + 1 end
        end
        if visible > 0 then return true end
    end
    return false
end

local function berryCount(list)
    local n = 0
    for i = 1, #list do
        local ber = list[i].ber
        if ber then n = n + #children(ber) end
    end
    return n
end

-- ---------------------------------------------------------------- drawing

local POOL_MAX = 96
local pool = {}
local poolN = 0

local function newSlot()
    if poolN >= POOL_MAX then return nil end
    poolN = poolN + 1
    local s = {}
    s.sq = Drawing.new("Square")
    s.sq.Thickness = 1
    s.sq.Filled = false
    s.sq.Visible = false
    s.txt = Drawing.new("Text")
    s.txt.Size = 13
    s.txt.Center = true
    s.txt.Outline = true
    s.txt.Visible = false
    pool[poolN] = s
    return s
end

local renderConn = nil

local function startRender()
    if renderConn or not RunService then return end
    renderConn = RunService.RenderStepped:Connect(function()
        local used = 0
        if CONFIG.esp then
            local cam = workspace.CurrentCamera
            if cam then
                local lp = Players and Players.LocalPlayer
                local char = lp and lp.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local origin = root and root.Position
                local list = SNAP
                for i = 1, #list do
                    local e = list[i]
                    if isRipe(e) then
                        local pos = e.hb.Position
                        local d = 0
                        if origin then d = (pos - origin).Magnitude end
                        if d <= CONFIG.radius then
                            local sp, on = WorldToScreen(pos)
                            if on then
                                if used < POOL_MAX then
                                    local slot = pool[used + 1] or newSlot()
                                    if slot then
                                        used = used + 1
                                        slot.sq.Position = Vector2.new(sp.X - 9, sp.Y - 9)
                                        slot.sq.Size = Vector2.new(18, 18)
                                        slot.sq.Color = Color3.fromRGB(255, 90, 120)
                                        slot.sq.Visible = true
                                        slot.txt.Position = Vector2.new(sp.X, sp.Y + 12)
                                        slot.txt.Text = string.format("%d", math.floor(d))
                                        slot.txt.Color = Color3.fromRGB(255, 205, 215)
                                        slot.txt.Visible = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        for i = used + 1, poolN do
            local s = pool[i]
            if s then
                s.sq.Visible = false
                s.txt.Visible = false
            end
        end
    end)
    conns[#conns + 1] = renderConn
end

-- ---------------------------------------------------------------- harvest

local routeHits = { 0, 0, 0, 0, 0, 0 }
local lastRoute = 1

local function fire(remote, ...)
    if not remote then return false end
    local n = select("#", ...)
    local args = { ... }
    local ok = pcall(function() remote:FireServer(unpackFn(args, 1, n)) end)
    return ok
end

local function rem(nm)
    if not Remotes then return nil end
    return Remotes:FindFirstChild(nm)
end

local function attempt(e, route)
    local cell = attr(e.hb, "BushCell")
    if route == 1 then
        if cell ~= nil then fire(rem("RequestHarvest"), cell) end
    elseif route == 2 then
        fire(rem("RequestHarvest"), e.hb)
    elseif route == 3 then
        fire(rem("RequestHarvest"), e.hb.Position)
    elseif route == 4 then
        fire(rem("RequestSwing"), e.hb)
    elseif route == 5 then
        fire(rem("RequestPickup"), e.hb)
    elseif route == 6 then
        if cell ~= nil then fire(rem("RequestHarvest"), cell, e.hb) end
    end
end

local function probe()
    local isl = myIsland()
    print("[ABOVE] island " .. tostring(isl and isl:GetFullName() or "none"))
    local list = scanBushes()
    print("[ABOVE] bushes " .. #list .. " berries " .. berryCount(list))
    local e = list[1]
    if not e then
        print("[ABOVE] no bush to probe")
        return
    end
    print("[ABOVE] HB " .. e.hb:GetFullName())
    local ok, names = pcall(function() return e.hb:GetAttributes() end)
    if ok and type(names) == "table" then
        for i = 1, #names do
            local k = names[i]
            local v = attr(e.hb, k)
            print("   " .. tostring(k) .. " = " .. type(v) .. " " .. tostring(v))
        end
    end
    local want = { "RequestHarvest", "RequestPickup", "RequestSwing", "RequestDrop", "RequestPollinate" }
    for i = 1, #want do
        local r = rem(want[i])
        print("   remote " .. want[i] .. " = " .. tostring(r and r.ClassName or "nil"))
    end
end

local function report()
    local parts = {}
    for i = 1, #routeHits do
        parts[#parts + 1] = "r" .. i .. "=" .. tostring(routeHits[i])
    end
    print("[ABOVE] route hits " .. table.concat(parts, " ") .. " last=" .. tostring(lastRoute))
end

-- ---------------------------------------------------------------- menu

local built = false
local getterWorks = {}

local function buildMenu()
    if built then return end
    local UI = _G.UI
    if not UI or type(UI.AddTab) ~= "function" then return end
    local ok = pcall(function()
        UI.AddTab("ABOVE", function(tab)
            if built then return end
            local L = tab:Section("Berry Farm", "Left")
            if L ~= nil then
                L:Toggle("above_auto", "Auto Harvest", false, function(v) CONFIG.autoHarvest = v end)
                L:SliderInt("above_rad", "Radius", 20, 2000, 300, function(v) CONFIG.radius = v end)
                L:SliderInt("above_delay", "Delay ms", 100, 2000, 350, function(v) CONFIG.delay = v / 1000 end)
                L:SliderInt("above_route", "Route 0=auto", 0, 6, 0, function(v) CONFIG.route = math.floor(v) end)
                L:Button("Scan Now", function()
                    local list = scanBushes()
                    local ripe = 0
                    for i = 1, #list do
                        if isRipe(list[i]) then ripe = ripe + 1 end
                    end
                    print("[ABOVE] bushes " .. #list .. " ripe " .. ripe)
                end)
                L:Button("Probe Harvest Data", function() probe() end)
            end
            local R = tab:Section("ESP", "Right")
            if R ~= nil then
                R:Toggle("above_esp", "Berry ESP", false, function(v)
                    CONFIG.esp = v
                    if v then startRender() end
                end)
                R:Button("Route Report", function() report() end)
            end
            built = true
        end)
    end)
    if not ok then print("[ABOVE] menu build failed") end
end

local function pollMenu()
    local UI = _G.UI
    if not UI or type(UI.GetValue) ~= "function" then return end
    local ok, v = pcall(UI.GetValue, "above_auto")
    if ok and type(v) == "boolean" then
        getterWorks.auto = true
        CONFIG.autoHarvest = v
    end
    ok, v = pcall(UI.GetValue, "above_esp")
    if ok and type(v) == "boolean" then
        getterWorks.esp = true
        if v and not CONFIG.esp then
            CONFIG.esp = true
            startRender()
        elseif not v then
            CONFIG.esp = false
        end
    end
    ok, v = pcall(UI.GetValue, "above_rad")
    if ok and type(v) == "number" then CONFIG.radius = v end
    ok, v = pcall(UI.GetValue, "above_delay")
    if ok and type(v) == "number" then CONFIG.delay = v / 1000 end
    ok, v = pcall(UI.GetValue, "above_route")
    if ok and type(v) == "number" then CONFIG.route = math.floor(v) end
end

-- ---------------------------------------------------------------- loops

local prevBerries = -1

local function farmLoop()
    while running do
        local list = scanBushes()
        SNAP = list
        local total = berryCount(list)
        if prevBerries >= 0 and total < prevBerries then
            routeHits[lastRoute] = routeHits[lastRoute] + 1
        end
        prevBerries = total

        if CONFIG.autoHarvest then
            local lp = Players and Players.LocalPlayer
            local char = lp and lp.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local origin = root and root.Position
            local target = nil
            local best = math.huge
            for i = 1, #list do
                local e = list[i]
                if isRipe(e) then
                    local d = 0
                    if origin then d = (e.hb.Position - origin).Magnitude end
                    if d <= CONFIG.radius and d < best then
                        best = d
                        target = e
                    end
                end
            end
            if target then
                local route = CONFIG.route
                if route == 0 then
                    route = (lastRoute % 6) + 1
                end
                lastRoute = route
                attempt(target, route)
            end
            task.wait(CONFIG.delay)
        else
            task.wait(0.5)
        end
    end
end

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    for i = 1, poolN do
        local s = pool[i]
        if s then
            pcall(function() s.sq:Remove() end)
            pcall(function() s.txt:Remove() end)
        end
    end
    poolN = 0
    pool = {}
    local UI = _G.UI
    if UI and type(UI.RemoveTab) == "function" then pcall(UI.RemoveTab, "ABOVE") end
    _G[NAME] = nil
    print("[ABOVE] stopped")
end

-- ---------------------------------------------------------------- start

task.spawn(function()
    buildMenu()
    while running do
        pcall(pollMenu)
        task.wait(0.15)
    end
end)

task.spawn(function()
    pcall(farmLoop)
end)

_G[NAME] = { stop = stop, version = VERSION }
print("[ABOVE] v" .. VERSION .. " loaded - menu tab 'ABOVE'")
