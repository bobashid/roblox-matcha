end

-- ---- gate 1: seated in the cart ----

local function refreshCarts(isl)
    cachedCarts = nil
    if not isl then return end
    pcall(function() cachedCarts = isl:FindFirstChild("Carts") end)
end

local function getSeatCart()
    if not cachedCarts then return nil end
    if not Players then return nil end
    local lp = nil
    pcall(function() lp = Players.LocalPlayer end)
    if not lp then return nil end
    local uid = nil
    pcall(function() uid = lp.UserId end)
    if uid == nil then return nil end
    local found = nil
    pcall(function()
        for _, c in ipairs(cachedCarts:GetChildren()) do
            if found == nil then
                local rider = nil
                pcall(function() rider = c:GetAttribute("Rider") end)
                if rider ~= nil and rider == uid then
                    found = c
                end
            end
        end
    end)
    return found
end

-- ---- gate 2: standing on a conveyor ----

local function buildConveyors(isl)
    local out = {}
    local blocks = nil
    pcall(function() blocks = isl:FindFirstChild("Blocks") end)
    if not blocks then return out end
    pcall(function()
        for _, c in ipairs(blocks:GetChildren()) do
            local nm = tostring(c.Name)
            if string.sub(nm, 1, #CONV_PREFIX) == CONV_PREFIX then
                local q = posOf(c)
                local sz = nil
                pcall(function() sz = c.Size end)
                if q and sz then
                    out[#out + 1] = {
                        x = q.X, y = q.Y, z = q.Z,
                        hx = sz.X / 2, hy = sz.Y / 2, hz = sz.Z / 2,
                    }
                end
            end
        end
    end)
    return out
end

local function onConveyor()
    if not conveyorCache or #conveyorCache == 0 then return false end
    local q = posOf(getRoot())
    if not q then return false end
    for i = 1, #conveyorCache do
        local c = conveyorCache[i]
        local dx = q.X - c.x
        if dx < 0 then dx = -dx end
        if dx <= c.hx + CONV_MARGIN then
            local dz = q.Z - c.z
            if dz < 0 then dz = -dz end
            if dz <= c.hz + CONV_MARGIN then
                local top = c.y + c.hy
                if q.Y >= top - CONV_MARGIN and q.Y <= top + CONV_UP then
                    return true
                end
            end
        end
    end
    return false
end

-- ---- rate counter (counts HARVESTS - pickups alone stay at zero here) ----

local function addRate(n)
    if n == nil or n <= 0 then return end
    rateEvents[#rateEvents + 1] = { t = os.clock(), n = n }
end

local function perSecond()
    local now = os.clock()
    local keep = {}
    local sum = 0
    for i = 1, #rateEvents do
        local e = rateEvents[i]
        if now - e.t <= RATE_WINDOW then
            keep[#keep + 1] = e
            sum = sum + e.n
        end
    end
    rateEvents = keep
    return sum / RATE_WINDOW
end

local function countOf(c)
    if c == nil then return 0 end
    local n = nil
    pcall(function() n = c:GetAttribute("Count") end)
    if type(n) == "number" and n >= 1 then return math.floor(n) end
    return 1
end

local function resolvePickVerify()
    if #pickVerify == 0 then return end
    local now = os.clock()
    local keep = {}
    for i = 1, #pickVerify do
        local v = pickVerify[i]
        if v.due > now then
            keep[#keep + 1] = v
        else
            local gone = false
            pcall(function() gone = (v.part == nil) or (v.part.Parent == nil) end)
            if gone then
                totalPicked = totalPicked + v.n
                addRate(v.n)
            end
        end
    end
    pickVerify = keep
end

