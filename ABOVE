-- ABOVE
-- VERSION 5.0.0
-- place 124357835578554 (game.Name reports "Ugc")
-- One toggle. Walks your character onto each ripe BerryBush, fires
-- RequestHarvest there, then onto each dropped berry, fires RequestPickup
-- there, and puts you back where you started when nothing is left.
-- Both remotes are range-checked by the server (proven: a 51-stud harvest
-- changed nothing), so a warp is the only way to farm beyond arm's length.
-- No keys, no Drawing, no ESP. Stop = switch the toggle off.

local NAME = "AboveBerries"
local VERSION = "5.0.0"

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local function svc(name)
    local ok, s = pcall(function() return game:GetService(name) end)
    if ok and s then return s end
    return game:FindFirstChild(name)
end

local Players = svc("Players")
local RS = svc("ReplicatedStorage")

local CFG = {
    on = false,
    interval = 0.15,
    perTick = 1,
    reachY = 3,
    nearStuds = 8,
    pickupTries = 3,
    idleReturn = 3,
}

local PART = {
    Part = true,
    MeshPart = true,
    UnionOperation = true,
    WedgePart = true,
    CornerWedgePart = true,
}

local running = true
local built = false
local homeCF = nil
local lastWarp = 0
local idleSince = 0
local stats = { bushes = 0, ripe = 0, harvest = 0, pickup = 0, warps = 0, back = 0 }
local lastStatus = 0

local function log(msg)
    print("[ABOVE] " .. tostring(msg))
end

local function getRoot()
    if not Players then return nil end
    local lp = Players.LocalPlayer
    if not lp then return nil end
    local ch = lp.Character
    if not ch then return nil end
    return ch:FindFirstChild("HumanoidRootPart")
end

local function getIsland()
    for i, d in ipairs(workspace:GetChildren()) do
        if string.sub(d.Name, 1, 7) == "Island_" then return d end
    end
    return nil
end

local function remote(name)
    if not RS then return nil end
    local r = RS:FindFirstChild("Remotes")
    if not r then return nil end
    return r:FindFirstChild(name)
end

local function numAttr(o, k)
    if not o then return nil end
    local ok, v = pcall(function() return o:GetAttribute(k) end)
    if ok and type(v) == "number" then return v end
    return nil
end

local function posOf(o)
    if not o then return nil end
    local ok, p = pcall(function() return o.Position end)
    if ok and p then return p end
    return nil
end

local function isRipe(hb)
    if not hb then return false end
    local ok, v = pcall(function() return hb:GetAttribute("Ripe") end)
    if ok and type(v) == "boolean" then return v end
    local bush = hb.Parent
    if bush then
        local ber = bush:FindFirstChild("Berries")
        if ber then
            local p = ber:GetChildren()[1]
            if p then
                local ok2, t = pcall(function() return p.Transparency end)
                if ok2 and type(t) == "number" then return t < 0.5 end
            end
        end
    end
    return false
end

local function collectRipe(ppos)
    local isl = getIsland()
    if not isl then return nil, {}, 0 end
    local nodes = isl:FindFirstChild("Nodes")
    if not nodes then return isl, {}, 0 end
    local list = {}
    local total = 0
    for i, n in ipairs(nodes:GetChildren()) do
        if n.Name == "BerryBush" then
            total = total + 1
            local hb = n:FindFirstChild("HB")
            if hb and isRipe(hb) then
                local p = posOf(hb)
                local d = p and (p - ppos).Magnitude or math.huge
                list[#list + 1] = { hb = hb, pos = p, d = d }
            end
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    return isl, list, total
end

-- A loose berry is a BasePart carrying a numeric "Count" attribute (that is
-- what the game's own LooseCountController reads). Decoration rocks share the
-- Icosphere mesh name, so the name alone must never be the test.
local function considerDrop(p, ppos, out, seen)
    if not p or not PART[p.ClassName] then return end
    local c = numAttr(p, "Count")
    if not c or c < 1 then return end
    local key = nil
    local okn, nm = pcall(function() return p:GetFullName() end)
    if okn and type(nm) == "string" then key = nm end
    if not key or seen[key] then return end
    seen[key] = true
    local pos = posOf(p)
    local d = pos and (pos - ppos).Magnitude or math.huge
    out[#out + 1] = { part = p, pos = pos, d = d }
end

local function collectDrops(isl, ppos)
    local out = {}
    local seen = {}
    if isl then
        local items = isl:FindFirstChild("Items")
        if items then
            for i, c in ipairs(items:GetChildren()) do
                if PART[c.ClassName] then
                    considerDrop(c, ppos, out, seen)
                else
                    for k, g in ipairs(c:GetChildren()) do
                        considerDrop(g, ppos, out, seen)
                    end
                end
            end
        end
    end
    local guard = 0
    for i, c in ipairs(workspace:GetChildren()) do
        if guard > 400 then break end
        guard = guard + 1
        considerDrop(c, ppos, out, seen)
    end
    table.sort(out, function(a, b) return a.d < b.d end)
    return out
end

local function warpTo(pos, rp, lift)
    if not pos or not rp then return false end
    local now = os.clock()
    if now - lastWarp < 0.05 then return false end
    lastWarp = now
    local ok = pcall(function()
        rp.CFrame = CFrame.new(pos.X, pos.Y + (lift or CFG.reachY), pos.Z)
    end)
    if ok then stats.warps = stats.warps + 1 end
    return ok
end

local function saveHome(rp)
    if homeCF or not rp then return end
    local ok, cf = pcall(function() return rp.CFrame end)
    if ok and cf then homeCF = cf end
end

local function goHome(rp)
    if not homeCF or not rp then return end
    pcall(function() rp.CFrame = homeCF end)
    homeCF = nil
    stats.back = stats.back + 1
end

local function fire(ev, arg)
    if not ev or not arg then return false end
    local ok = pcall(function() ev:FireServer(arg) end)
    return ok
end

local function tick()
    local rp = getRoot()
    if not rp then return end
    local ppos = posOf(rp)
    if not ppos then return end

    local evH = remote("RequestHarvest")
    local evP = remote("RequestPickup")
    local isl, list, total = collectRipe(ppos)
    stats.bushes = total or 0
    stats.ripe = #list

    if #list == 0 then
        if homeCF and os.clock() - idleSince > CFG.idleReturn then goHome(rp) end
        idleSince = os.clock()
        return
    end

    idleSince = os.clock()
    saveHome(rp)

    local done = 0
    for i, e in ipairs(list) do
        if done >= CFG.perTick then break end
        done = done + 1
        if e.hb and e.hb.Parent and e.pos then
            if e.d > CFG.nearStuds then warpTo(e.pos, rp) end
            if fire(evH, e.hb) then stats.harvest = stats.harvest + 1 end

            local drops = collectDrops(isl, e.pos)
            for k, d in ipairs(drops) do
                if d.pos then
                    if d.d > CFG.nearStuds then warpTo(d.pos, rp, 2) end
                    for t = 1, CFG.pickupTries do
                        if fire(evP, d.part) then stats.pickup = stats.pickup + 1 end
                    end
                end
            end
        end
    end

    local now = os.clock()
    if now - lastStatus > 10 then
        lastStatus = now
        log("bushes " .. tostring(stats.bushes)
            .. " | ripe " .. tostring(stats.ripe)
            .. " | harvest " .. tostring(stats.harvest)
            .. " | pickups " .. tostring(stats.pickup)
            .. " | warps " .. tostring(stats.warps))
    end
end

local function pollWidgets()
    local M = _G.UI
    if not M or not M.GetValue then return end
    local ok, v = pcall(function() return M.GetValue("ab_on") end)
    if ok and type(v) == "boolean" then
        CFG.on = v
    end
end

local function buildMenu()
    local M = _G.UI
    if not M or not M.AddTab then
        log("UI not found - toggle unavailable")
        return
    end
    local ok = pcall(function()
        M.AddTab("ABOVE Berries", function(tab)
            if built then return end
            built = true
            pcall(function()
                local sec = tab:Section("Berries", "Left")
                if sec then
                    sec:Toggle("ab_on", "Auto Harvest (berries)", false, function(v)
                        CFG.on = v
                    end)
                end
            end)
        end)
    end)
    if not ok then
        log("AddTab failed")
    end
end

local function stop()
    running = false
    local rp = getRoot()
    if homeCF and rp then
        pcall(function() rp.CFrame = homeCF end)
        homeCF = nil
    end
    local M = _G.UI
    if M and M.RemoveTab then
        pcall(function() M.RemoveTab("ABOVE Berries") end)
    end
    _G[NAME] = nil
    log("stopped")
end

task.spawn(function()
    local waited = 0
    while running and not (_G.UI and _G.UI.AddTab) and waited < 15 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    buildMenu()
end)

task.spawn(function()
    while running do
        pcall(pollWidgets)
        if CFG.on then
            local ok, err = pcall(tick)
            if not ok then
                log("tick error " .. tostring(err))
            end
        else
            local rp = getRoot()
            if homeCF and rp then goHome(rp) end
        end
        task.wait(CFG.interval)
    end
end)

_G[NAME] = { stop = stop, version = VERSION }
log("v" .. VERSION .. " loaded on place " .. tostring(game.PlaceId))
