-- ABOVE
-- VERSION 10.0.0
-- place 124357835578554 (game.Name reports "Ugc" - match by place id, never by name)
--
-- Berry farmer for ABOVE. TWO toggles, nothing else in the menu.
--
--   Rail Cart Berry Farm  - runs while you are SEATED IN THE CART.
--   Conveyor Berry Farm   - runs while you have been STANDING ON A CONVEYOR for
--                           3 seconds, and stops the moment you leave it.
--
-- Either gate turns the same farm on. Both do exactly the same work: harvest
-- every ripe berry bush within 17 studs, and pick up the berries that drop.
-- No teleport, no CFrame write, no key press. Stop = switch the toggle off.
--
-- Seated check: IronRailcart has no Seat/VehicleSeat. Boarding (its HB's
-- ProximityPrompt) sets cart attribute Rider = <your UserId>. Humanoid.Sit and
-- Humanoid.SeatPart read nil, no SeatWeld appears, char.Parent stays Workspace,
-- and distance to the cart is useless (1.4 studs while merely standing beside it).
--
-- Conveyor check (measured in game): a conveyor is a plain Part named "Conveyor"
-- (264 of them) plus "ConveyorCorner" (4) and "ConveyorCornerLeft" (8), each
-- 3.0 x 0.7 x 3.0 - exactly one 3-stud grid cell - with MachineId = "Conveyor",
-- CellKey and Cells attributes, top surface at y + 0.35. There is no raycast in
-- this VM (workspace:Raycast is an inert stub), so standing on one is detected by
-- geometry: the HumanoidRootPart must be inside the part's XZ footprint plus a
-- 1.5-stud margin, and within 1.5 studs below to 6 studs above its top face.
--
-- Island identity: leaving and returning creates a NEW Nodes folder under the
-- SAME island name, so the cache is keyed on Nodes.Address (measured
-- 1459067867248) and a change triggers a full rebuild.
--
-- Speed, all measured in game (place 124357835578554):
--   * Reach is 18 studs from HumanoidRootPart. 17.54 harvested, 18.07 did not.
--   * Server drops bursts: 0.05 s gap -> 95%, 0.02 s -> 87%, and 20 fires in a
--     SINGLE frame -> 38% (so it processes ~7-8 per frame). Per-frame bursting is
--     worse than serial firing; GAP = 0.01 with verification is used instead.
--   * The real ceiling is NOT the fire rate: a 2032-bush island had only ~69
--     bushes inside 17 studs, so a cluster is gone in about a second and the farm
--     then waits for regrow. Regrow re-checks are what decide responsiveness.
--   * A fire is not a harvest, so each fire is parked with a due time and re-read
--     0.3 s later. No blocking wait in the pass.
--   * RequestPickup takes the item's EntityId STRING, not the Part.
--   * Pickup collects ONLY ItemId "Berries". BerryPie / BerryJam / BerryBushSeed
--     and ground berries are left alone.
--   * No ProximityPrompt exists on any bush or loose item.
--
-- Four loops: menu, harvest, pickup, toggle poller.

local NAME = "AboveBerries"
local VERSION = "10.0.0"

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

-- ---- constants (measured, do not guess these) ----

local RADIUS = 17
local GAP = 0.01
local VERIFY_AFTER = 0.3
local MAX_TRIES = 3
local PICK_GAP = 0.08
local PICK_BATCH = 6
local PICK_TRIES = 2
local RECHECK_BATCH = 60
local RECHECK_EVERY = 0.15
local COUNT_EVERY = 10
local ISLAND_EVERY = 1.0
local CONV_DELAY = 3
local CONV_MARGIN = 1.5
local CONV_UP = 6
local BUSY_WAIT = 0.01
local IDLE_WAIT = 0.10
local PICK_WAIT = 0.10
local GATE_WAIT = 0.15

local PICK_ITEM_ID = "Berries"
local CONV_PREFIX = "Conveyor"

-- ---- services ----

local function svc(name)
    local ok, s = pcall(function() return game:GetService(name) end)
    if ok and s then return s end
    return game:FindFirstChild(name)
end

local Players = svc("Players")
local RS = svc("ReplicatedStorage")

-- ---- state ----

local CFG = { cart = false, conv = false }

local running = true
local built = false
local activeMode = nil
local convSince = nil
local conveyorCache = nil
local seeded = false
local bushCache = nil
local cacheIsland = nil
local islandAddr = nil
local pending = {}
local done = {}
local verifyQueue = {}
local doneIdx = 1
local pickIdx = 1
local lastStatus = 0
local lastRegrow = 0
local lastCount = 0
local lastIsland = 0
local cachedIsland = nil
local cachedCarts = nil
local stats = { ok = 0, miss = 0, fired = 0, picked = 0, rebuilds = 0, resets = 0, pauses = 0 }

local function log(msg)
    print("[ABOVE Berries] " .. tostring(msg))
end

-- ---- world helpers ----

local function getRoot()
    if not Players then return nil end
    local ok1, lp = pcall(function() return Players.LocalPlayer end)
    if not ok1 or not lp then return nil end
    local ok2, ch = pcall(function() return lp.Character end)
    if not ok2 or not ch then return nil end
    local ok3, rp = pcall(function() return ch:FindFirstChild("HumanoidRootPart") end)
    if ok3 and rp then return rp end
    return nil
end

local function posOf(o)
    if not o then return nil end
    local ok, p = pcall(function() return o.Position end)
    if ok and p then return p end
    return nil
end

local function nodesOf(isl)
    if not isl then return nil end
    local nodes = nil
    pcall(function() nodes = isl:FindFirstChild("Nodes") end)
    return nodes
end

local function nodesAddress(isl)
    local nodes = nodesOf(isl)
    if not nodes then return nil end
    local ok, a = pcall(function() return nodes.Address end)
    if ok and a ~= nil then return tostring(a) end
    return nil
end

local function getIsland()
    if cachedIsland and cachedIsland.Parent and cachedIsland:FindFirstChild("Nodes") then
        return cachedIsland
    end
    cachedIsland = nil
    local found = nil
    pcall(function()
        for _, d in ipairs(workspace:GetChildren()) do
            if found == nil and string.sub(d.Name, 1, 7) == "Island_" then
                if d:FindFirstChild("Nodes") then
                    found = d
                end
            end
        end
    end)
    cachedIsland = found
    return found
end

local function remote(name)
    if not RS then return nil end
    local ok, r = pcall(function() return RS:FindFirstChild("Remotes") end)
    if not ok or not r then return nil end
    local ok2, ev = pcall(function() return r:FindFirstChild(name) end)
    if ok2 and ev then return ev end
    return nil
end

-- ---- gate 1: seated in the cart (IronRailcart.Rider == your UserId) ----

local function refreshCarts(isl)
    cachedCarts = nil
    if not isl then return end
    pcall(function() cachedCarts = isl:FindFirstChild("Carts") end)
end

local function getSeatCart()
    if not cachedCarts then return nil end
    if not Players then return nil end
    local lp = nil
    pcall(function() lp = Players.LocalPlayer end)
    if not lp then return nil end
    local uid = nil
    pcall(function() uid = lp.UserId end)
    if uid == nil then return nil end
    local found = nil
    pcall(function()
        for _, c in ipairs(cachedCarts:GetChildren()) do
            if found == nil then
                local rider = nil
                pcall(function() rider = c:GetAttribute("Rider") end)
                if rider ~= nil and rider == uid then
                    found = c
                end
            end
        end
    end)
    return found
end

-- ---- gate 2: standing on a conveyor ----
-- Cached once per island: position + half extents. No property reads per check.

local function buildConveyors(isl)
    local out = {}
    local blocks = nil
    pcall(function() blocks = isl:FindFirstChild("Blocks") end)
    if not blocks then return out end
    pcall(function()
        for _, c in ipairs(blocks:GetChildren()) do
            local nm = tostring(c.Name)
            if string.sub(nm, 1, #CONV_PREFIX) == CONV_PREFIX then
                local q = posOf(c)
                local sz = nil
                pcall(function() sz = c.Size end)
                if q and sz then
                    out[#out + 1] = {
                        x = q.X, y = q.Y, z = q.Z,
                        hx = sz.X / 2, hy = sz.Y / 2, hz = sz.Z / 2,
                    }
                end
            end
        end
    end)
    return out
end

local function onConveyor()
    if not conveyorCache or #conveyorCache == 0 then return false end
    local q = posOf(getRoot())
    if not q then return false end
    for i = 1, #conveyorCache do
        local c = conveyorCache[i]
        local dx = q.X - c.x
        if dx < 0 then dx = -dx end
        if dx <= c.hx + CONV_MARGIN then
            local dz = q.Z - c.z
            if dz < 0 then dz = -dz end
            if dz <= c.hz + CONV_MARGIN then
                local top = c.y + c.hy
                if q.Y >= top - CONV_MARGIN and q.Y <= top + CONV_UP then
                    return true
                end
            end
        end
    end
    return false
end

-- ---- bush cache ----

local function bushCount(isl)
    local n = 0
    local nodes = nodesOf(isl)
    if not nodes then return 0 end
    pcall(function()
        for _, c in ipairs(nodes:GetChildren()) do
            if c.Name == "BerryBush" then
                n = n + 1
            end
        end
    end)
    return n
end

local function buildCache(isl)
    local out = {}
    local nodes = nodesOf(isl)
    if not nodes then return out end
    pcall(function()
        for _, n in ipairs(nodes:GetChildren()) do
            if n.Name == "BerryBush" then
                local hb = n:FindFirstChild("HB")
                if hb then
                    local q = posOf(hb)
                    if q then
                        out[#out + 1] = { hb = hb, x = q.X, y = q.Y, z = q.Z, tries = 0 }
                    end
                end
            end
        end
    end)
    return out
end

local function clearLists()
    pending = {}
    done = {}
    verifyQueue = {}
    doneIdx = 1
    pickIdx = 1
    seeded = false
end

local function hardReset(isl)
    local was = islandAddr
    bushCache = nil
    cacheIsland = nil
    conveyorCache = nil
    clearLists()
    cachedIsland = isl
    islandAddr = nodesAddress(isl)
    refreshCarts(isl)
    stats.resets = stats.resets + 1
    if was ~= nil then
        log("island changed (nodes addr " .. tostring(was) .. " -> "
            .. tostring(islandAddr) .. ") - rebuilt from scratch")
    end
end

local function ensureCache(isl)
    local nm = tostring(isl.Name)
    if bushCache and cacheIsland == nm and #bushCache > 0 then
        local probes = math.min(10, #bushCache)
        local alive = 0
        for i = 1, probes do
            local e = bushCache[i]
            if e.hb and e.hb.Parent then
                alive = alive + 1
            end
        end
        if alive >= math.floor(probes * 0.8) then return bushCache end
    end
    bushCache = buildCache(isl)
    cacheIsland = nm
    islandAddr = nodesAddress(isl)
    clearLists()
    log("bush cache built: " .. tostring(#bushCache) .. " bush(es)")
    return bushCache
end

local function isRipe(hb)
    if hb == nil then return false end
    local ripe = nil
    pcall(function() ripe = hb:GetAttribute("Ripe") end)
    return ripe == true
end

local function seedLists(cache)
    clearLists()
    for i = 1, #cache do
        local e = cache[i]
        e.tries = 0
        if isRipe(e.hb) then
            pending[#pending + 1] = e
        else
            done[#done + 1] = e
        end
    end
    log("scan: " .. tostring(#pending) .. " ripe, " .. tostring(#done) .. " not ripe")
end

local function regrowCheck()
    if #done == 0 then return end
    local found = 0
    local i = doneIdx
    local checked = 0
    while checked < RECHECK_BATCH and #done > 0 do
        if i > #done then i = 1 end
        local e = done[i]
        if e.hb and e.hb.Parent and isRipe(e.hb) then
            e.tries = 0
            pending[#pending + 1] = e
            done[i] = done[#done]
            done[#done] = nil
            found = found + 1
        else
            i = i + 1
        end
        checked = checked + 1
    end
    if #done == 0 or i > #done then
        i = 1
    end
    doneIdx = i
    if found > 0 then
        log("regrown: " .. tostring(found) .. " back in the queue")
    end
end

-- ---- verification: a fire is not a harvest ----

local function resolveVerify()
    if #verifyQueue == 0 then return end
    local now = os.clock()
    local keep = {}
    local okN, missN = 0, 0
    for i = 1, #verifyQueue do
        local v = verifyQueue[i]
        if v.due > now then
            keep[#keep + 1] = v
        else
            local e = v.e
            if e.hb ~= nil and isRipe(e.hb) then
                e.tries = (e.tries or 0) + 1
                missN = missN + 1
                if e.tries >= MAX_TRIES then
                    done[#done + 1] = e
                else
                    pending[#pending + 1] = e
                end
            else
                e.tries = 0
                done[#done + 1] = e
                okN = okN + 1
            end
        end
    end
    verifyQueue = keep
    stats.ok = stats.ok + okN
    stats.miss = stats.miss + missN
    if okN + missN > 0 then
        log("verified " .. tostring(okN) .. " ok, " .. tostring(missN)
            .. " retry | queued " .. tostring(#pending)
            .. " | verifying " .. tostring(#verifyQueue))
    end
end

-- ---- one harvest pass over everything in reach ----

local function harvestPass(ev)
    local root = getRoot()
    if not root then return 0 end
    local q = posOf(root)
    if not q then return 0 end
    local cx, cy, cz = q.X, q.Y, q.Z
    local r2 = RADIUS * RADIUS
    local keep = {}
    local fired = 0
    for i = 1, #pending do
        local e = pending[i]
        if e.hb ~= nil and e.hb.Parent ~= nil then
            local dx, dy, dz = e.x - cx, e.y - cy, e.z - cz
            if dx * dx + dy * dy + dz * dz <= r2 then
                if running and activeMode ~= nil then
                    pcall(function() ev:FireServer(e.hb) end)
                    verifyQueue[#verifyQueue + 1] = { e = e, due = os.clock() + VERIFY_AFTER }
                    stats.fired = stats.fired + 1
                    fired = fired + 1
                    task.wait(GAP)
                    local nq = posOf(root)
                    if nq then
                        cx = nq.X
                        cy = nq.Y
                        cz = nq.Z
                    end
                else
                    keep[#keep + 1] = e
                end
            else
                keep[#keep + 1] = e
            end
        end
    end
    pending = keep
    if fired > 0 then
        log("fired " .. tostring(fired) .. " | queued " .. tostring(#pending))
    end
    return fired
end

-- ---- pickup: ONLY the bush's own item ----

local function isBushBerry(c)
    if c == nil then return false end
    local id = nil
    pcall(function() id = c:GetAttribute("ItemId") end)
    if id == nil then
        return tostring(c.Name) == PICK_ITEM_ID
    end
    return tostring(id) == PICK_ITEM_ID
end

local function collectLoose()
    local isl = getIsland()
    if not isl then return end
    local items = nil
    pcall(function() items = isl:FindFirstChild("Items") end)
    if not items then return end
    local ev = remote("RequestPickup")
    if not ev then return end

    local targets = {}
    pcall(function()
        for _, c in ipairs(items:GetChildren()) do
            if isBushBerry(c) then
                local eid = nil
                pcall(function() eid = c:GetAttribute("EntityId") end)
                targets[#targets + 1] = { part = c, eid = eid }
            end
        end
    end)
    if #targets == 0 then
        pickIdx = 1
        return
    end
    if pickIdx > #targets then
        pickIdx = 1
    end

    for k = 1, PICK_BATCH do
        if not running or activeMode == nil then return end
        local i = pickIdx
        if i > #targets then
            i = 1
        end
        local t = targets[i]
        pickIdx = i + 1
        if t.eid ~= nil then
            for tryN = 1, PICK_TRIES do
                if t.part.Parent == nil then break end
                pcall(function() ev:FireServer(t.eid) end)
                stats.picked = stats.picked + 1
                task.wait(PICK_GAP)
            end
        else
            pcall(function() ev:FireServer(t.part) end)
            stats.picked = stats.picked + 1
            task.wait(PICK_GAP)
        end
    end
end

-- ---- menu ----

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    if not tab then return nil end
    local sides = { "Left", "Right" }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    warn("[ABOVE Berries] section failed: " .. tostring(name))
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() return sec:Toggle(id, label, default, cb) end,
        function() return sec:Toggle(label, id, default, cb) end,
        function() return sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[ABOVE Berries] toggle failed: " .. tostring(label))
    return false
end

local TOGGLES = {}
local cbWorks = {}

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id }
end

local function pollToggles()
    local M = _G.UI
    if not M or type(M.GetValue) ~= "function" then return end
    for i = 1, #TOGGLES do
        local t = TOGGLES[i]
        if not cbWorks[t.key] then
            local ok, v = pcall(function() return M.GetValue(t.id) end)
            if ok and type(v) == "boolean" and CFG[t.key] ~= v then
                CFG[t.key] = v
                log(t.key .. " = " .. tostring(v))
            end
        end
    end
end

local function printStats()
    log("stats: harvested " .. tostring(stats.ok)
        .. " | missed+retried " .. tostring(stats.miss)
        .. " | harvest fires " .. tostring(stats.fired)
        .. " | pickup fires " .. tostring(stats.picked)
        .. " | queued " .. tostring(#pending)
        .. " | verifying " .. tostring(#verifyQueue)
        .. " | done pool " .. tostring(#done)
        .. " | resets " .. tostring(stats.resets)
        .. " | gate " .. tostring(activeMode))
end

local function buildMenu()
    local M = _G.UI
    if not M or type(M.AddTab) ~= "function" then
        log("UI not found - farm still runs with the defaults")
        return
    end
    local ok = pcall(function()
        M.AddTab("ABOVE Berries", function(tab)
            if built then return end
            built = true
            local okb, err = pcall(function()
                local sec = mkSection(tab, "Farm")
                if sec then
                    mkToggle(sec, "Rail Cart Berry Farm", "ab_cart", false, function(v)
                        CFG.cart = v
                        cbWorks.cart = true
                        log("rail cart berry farm " .. (v and "ON" or "OFF"))
                    end)
                    registerToggle("cart", "ab_cart")

                    mkToggle(sec, "Conveyor Berry Farm", "ab_conv", false, function(v)
                        CFG.conv = v
                        cbWorks.conv = true
                        if not v then
                            convSince = nil
                        end
                        log("conveyor berry farm " .. (v and "ON" or "OFF"))
                    end)
                    registerToggle("conv", "ab_conv")
                end
            end)
            if not okb then
                warn("[ABOVE Berries] build error: " .. tostring(err))
            end
            log("tab widgets built")
        end)
    end)
    if not ok then
        warn("[ABOVE Berries] AddTab failed")
    end
end

-- ---- stop ----

local function stop()
    running = false
    CFG.cart = false
    CFG.conv = false
    local M = _G.UI
    if M and type(M.RemoveTab) == "function" then
        pcall(function() M.RemoveTab("ABOVE Berries") end)
    end
    _G[NAME] = nil
    log("stopped")
end

-- ---- loop 1: menu ----

task.spawn(function()
    local waited = 0
    while running and not (_G.UI and _G.UI.AddTab) and waited < 15 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    buildMenu()
end)

-- ---- loop 2: gates + harvest ----

task.spawn(function()
    while running do
        if not CFG.cart and not CFG.conv then
            if activeMode then
                activeMode = nil
                log("all farms off - paused")
            end
            convSince = nil
            seeded = false
            task.wait(0.2)
        else
            local isl = getIsland()

            if isl then
                local addr = nodesAddress(isl)
                if addr ~= nil and addr ~= islandAddr then
                    hardReset(isl)
                end
            end

            local now = os.clock()
            if now - lastIsland > ISLAND_EVERY or cachedCarts == nil then
                lastIsland = now
                refreshCarts(isl)
                if conveyorCache == nil and isl then
                    conveyorCache = buildConveyors(isl)
                    log("conveyor cache: " .. tostring(#conveyorCache) .. " part(s)")
                end
            end

            -- which gate is satisfied right now?
            local mode = nil
            if CFG.cart and getSeatCart() ~= nil then
                mode = "rail cart"
            end
            if mode == nil and CFG.conv then
                if onConveyor() then
                    if convSince == nil then
                        convSince = now
                        log("on a conveyor - arming (" .. tostring(CONV_DELAY) .. "s)")
                    elseif now - convSince >= CONV_DELAY then
                        mode = "conveyor"
                    end
                elseif convSince ~= nil then
                    convSince = nil
                    log("left the conveyor - disarmed")
                end
            end

            if mode == nil then
                if activeMode then
                    activeMode = nil
                    stats.pauses = stats.pauses + 1
                    log("farm paused")
                end
                task.wait(GATE_WAIT)
            else
                if activeMode ~= mode then
                    activeMode = mode
                    log("farming (" .. mode .. ")")
                end

                if not isl then
                    task.wait(0.5)
                else
                    local t2 = os.clock()
                    if t2 - lastCount > COUNT_EVERY then
                        lastCount = t2
                        local live = bushCount(isl)
                        if bushCache and live ~= #bushCache then
                            log("island bush count changed (" .. tostring(#bushCache)
                                .. " -> " .. tostring(live) .. "), rebuilding")
                            bushCache = nil
                            cacheIsland = nil
                            clearLists()
                            stats.rebuilds = stats.rebuilds + 1
                        end
                    end

                    local cache = ensureCache(isl)
                    if not seeded and #cache > 0 then
                        seedLists(cache)
                        seeded = true
                    end

                    resolveVerify()

                    if os.clock() - lastRegrow > RECHECK_EVERY then
                        lastRegrow = os.clock()
                        regrowCheck()
                    end

                    local ev = remote("RequestHarvest")
                    local fired = 0
                    if ev and #pending > 0 then
                        fired = harvestPass(ev)
                    end

                    if os.clock() - lastStatus > 10 then
                        lastStatus = os.clock()
                        printStats()
                    end

                    if fired > 0 then
                        task.wait(BUSY_WAIT)
                    else
                        task.wait(IDLE_WAIT)
                    end
                end
            end
        end
    end
end)

-- ---- loop 3: pickup ----

task.spawn(function()
    while running do
        if activeMode ~= nil then
            local okp, errp = pcall(collectLoose)
            if not okp then
                log("pickup error: " .. tostring(errp))
            end
            task.wait(PICK_WAIT)
        else
            task.wait(0.25)
        end
    end
end)

-- ---- loop 4: toggle poller ----

task.spawn(function()
    while running do
        pcall(pollToggles)
        task.wait(0.15)
    end
end)

_G[NAME] = { stop = stop, version = VERSION }
log("v" .. VERSION .. " loaded on place " .. tostring(game.PlaceId))
