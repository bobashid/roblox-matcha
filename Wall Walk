--[[
  Wall Walk (universal) - Matcha LuauVM
  Version: v3.5
  ONE toggle. Hold W at a wall: your feet go ON the wall. WASD then walks
  that wall as if it were the ground. Space steps off.

  WHY v3.5 - two probes disagreed, so the script no longer assumes either
    Probe A: hum.Move -> function, lp.Move -> function, RigType -> R15
    Probe B: hum.Move -> nil,      lp.Move -> nil,      RigType -> nil,
             and char:GetChildren() listed Torso / Left Arm / Right Leg,
             which is an R6 rig, not R15.
  Two probes disagreeing on the same global means neither is a rule. v3.4
  called hum:Move unconditionally and would have raised 'attempt to call a
  nil value' inside a pcall - silently doing nothing, which is the exact
  failure mode this file has a history of. v3.5 resolves the path at runtime
  and falls back, and the HUD prints which path is live so this can never be
  a mystery again.

  THE MOVEMENT PATH, resolved on attach and again whenever it fails:
    hum  -> hum:Move(dir, false)     the humanoid walks; its own animate
                                     script plays the real walk cycle
    lp   -> lp:Move(dir, false)      the player module moves the humanoid;
                                     animations play the same way
    cf   -> we move the position     no humanoid movement, so NO walk cycle.
                                     This is v3.3's sliding path - used only
                                     when neither Move exists.
  The fix for 'feels like sliding' is the hum/lp path: animation is driven by
  humanoid movement, so writing CFrame instead of moving the humanoid gives a
  static pose gliding along the wall. If the HUD says walk=cf, that is why.

  WHAT EACH PATH DOES TO POSITION
    hum/lp: target = current position, then pulled to standoff. We correct
            only the distance from the wall - the humanoid produced the
            motion itself.
    cf    : target = current + move * walk * dt, then pulled to standoff.
            We produce the motion, which is why no animation plays.

  BOB defaults to 0. With a real walk cycle it is unnecessary; raise CFG.bobAmp
  to ~0.2 if you want extra weight shift. It rides the same write, no cost.

  HISTORY - every earlier failure was silent until probed
    v1.0  Humanoid.PlatformStand - not writable, pcall swallowed the error.
    v2.0  workspace:Raycast - PROBED: accepts the call, returns nil for every
          ray. FindPartOnRay, GetPartBoundsInBox, GetPartsInRadius,
          GetPartsInPart, Region3 all nil. No spatial query in this VM.
    v2.1-3 OBB geometry detection (probe-verified correct) but Velocity-only,
          so the character stayed upright - a climb, not a walk.
    v3.0  CFrame.fromMatrix - PROBED: nil. Would have failed to write.
    v3.1  the 12-number CFrame.new basis - worked, but grabbed hard.
    v3.2  eased the constraint: hysteresis, ramped pull, lerped basis.
    v3.3  body bob, after wrongly concluding no animation could play.
    v3.4  hum:Move unconditionally - would have been a silent no-op.

  PROBED, and the reason the orientation code looks like this
    CFrame.fromMatrix     -> nil
    CFrame.fromAxisAngle  -> nil
    CFrame.Angles         -> function, cannot set a custom up
    CFrame.lookAt         -> function, IGNORES its up argument
    CFrame.new(x,y,z, rX,uX,bX, rY,uY,bY, rZ,uZ,bZ) -> works; the three
      vectors are the COLUMNS of the rotation matrix: right, up, back.
    A rotated write PERSISTS across a physics step, but gravity still acts, so
    position has to be corrected every step.

  THE CONSTANTS TO TUNE
    CFG.standoff = 2.6  HRP centre distance from the wall. Feet sit ~2 studs
                        below HRP along the character's up. Floating -> 2.2,
                        sinking in -> 3.0.
    CFG.speedMul = 1.0  scales the humanoid's own speed on the hum/lp path.
                        0.6 careful, 1.4 fast. Does nothing on the cf path.
    CFG.walk     = 18   studs/s on the cf fallback path only.
    CFG.bobAmp   = 0    raise to ~0.2 for extra weight shift.

  COST
    One CFrame write per Heartbeat, only while attached. The humanoid movement
    on the hum/lp path is ordinary gameplay movement and costs nothing extra.

  Stop with _G.WallWalk.stop(), the toggle, or Space to step off.
]]

local NAME = 'WallWalk'
local VERSION = 'v3.5'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp = Players.LocalPlayer

local running = true
local conns = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local clamp = math.clamp or function(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local CFG = {
    on       = false,
    attach   = 4.5,
    keep     = 7.5,
    standoff = 2.6,
    pullRate = 10,
    turnRate = 8,
    faceDot  = 0.15,
    maxY     = 0.7,
    recache  = 40,
    keepR    = 160,
    walk     = 18,
    speedMul = 1.0,
    bobAmp   = 0,
    bobRate  = 7,
    bobEase  = 6,
    keyW     = 0x57,
    keyA     = 0x41,
    keyS     = 0x53,
    keyD     = 0x44,
    keyJump  = 0x20,
}

local status = 'off'
local wallInfo = '-'
local stuck = false
local stuckN = nil
local stuckUp = nil
local pull = 0
local bobPhase = 0
local bobAmp = 0
local lastJump = false
local walkPath = '?'

local parts = {}
local cacheAt = nil

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

local function fnOf(obj, name)
    if obj == nil then return nil end
    local ok, v = pcall(function() return obj[name] end)
    if ok and type(v) == 'function' then return v end
    return nil
end

-- Resolve the movement path from what is actually there, not from what a
-- single probe once said. Probe A gave hum.Move = function; Probe B gave nil.
local function resolvePath(hum)
    if fnOf(hum, 'Move') then return 'hum' end
    if fnOf(lp, 'Move') then return 'lp' end
    return 'cf'
end

local function rebuildCache(char, at)
    local out = {}
    local ok, list = pcall(function() return workspace:GetDescendants() end)
    if not ok or not list then
        log('GetDescendants failed')
        return
    end
    for i = 1, #list do
        local p = list[i]
        local okc, cls = pcall(function() return p.ClassName end)
        if okc and cls == 'Part' then
            local okPos, pos = pcall(function() return p.Position end)
            local okSz, sz = pcall(function() return p.Size end)
            if okPos and okSz and pos and sz and sz.X >= 1 and sz.Y >= 1 and sz.Z >= 1 then
                local halfDiag = sz.Magnitude * 0.5
                if (pos - at).Magnitude - halfDiag <= CFG.keepR then
                    local okA, anc = pcall(function() return p:IsDescendantOf(char) end)
                    if not okA or anc ~= true then
                        out[#out + 1] = {
                            part = p, pos = pos,
                            hx = sz.X * 0.5, hy = sz.Y * 0.5, hz = sz.Z * 0.5,
                            halfDiag = halfDiag,
                        }
                    end
                end
            end
        end
    end
    parts = out
    cacheAt = at
    log('nearby parts cached: ' .. tostring(#out))
end

local function findWall(char, p, reach)
    if not cacheAt or (cacheAt - p).Magnitude > CFG.recache then
        rebuildCache(char, p)
    end

    local bestN, bestD, bestE = nil, reach, nil
    for i = 1, #parts do
        local e = parts[i]
        local dx, dy, dz = e.pos.X - p.X, e.pos.Y - p.Y, e.pos.Z - p.Z
        local d2 = dx*dx + dy*dy + dz*dz
        local lim = reach + e.halfDiag
        if d2 <= lim * lim then
            local okCf, cf = pcall(function() return e.part.CFrame end)
            if okCf and cf then
                local rel = cf:PointToObjectSpace(p)
                local cx = clamp(rel.X, -e.hx, e.hx)
                local cy = clamp(rel.Y, -e.hy, e.hy)
                local cz = clamp(rel.Z, -e.hz, e.hz)
                local wc = cf:PointToWorldSpace(Vector3.new(cx, cy, cz))
                local bx, by, bz = p.X - wc.X, p.Y - wc.Y, p.Z - wc.Z
                local bd = math.sqrt(bx*bx + by*by + bz*bz)
                if bd > 1e-4 and bd <= bestD then
                    local wn = cf:VectorToWorldSpace(rel - Vector3.new(cx, cy, cz))
                    if wn.Magnitude > 1e-4 then
                        wn = wn.Unit
                        if math.abs(wn.Y) <= CFG.maxY then
                            bestN, bestD, bestE = wn, bd, e
                        end
                    end
                end
            end
        end
    end
    return bestN, bestD, bestE
end

local function closestOn(e, p)
    local okCf, cf = pcall(function() return e.part.CFrame end)
    if not okCf or not cf then return nil end
    local rel = cf:PointToObjectSpace(p)
    local cx = clamp(rel.X, -e.hx, e.hx)
    local cy = clamp(rel.Y, -e.hy, e.hy)
    local cz = clamp(rel.Z, -e.hz, e.hz)
    return cf:PointToWorldSpace(Vector3.new(cx, cy, cz))
end

local function flatten(v, up)
    local f = v - up * v:Dot(up)
    if f.Magnitude > 1e-3 then return f.Unit end
    return nil
end

local function wallLook(cam, up)
    local l = flatten(cam.CFrame.LookVector, up)
    if l then return l end
    for _, cand in ipairs({ Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1) }) do
        local f = flatten(cand, up)
        if f then return f end
    end
    return nil
end

local function makeCFrame(pos, right, up, back)
    return CFrame.new(
        pos.X, pos.Y, pos.Z,
        right.X, up.X, back.X,
        right.Y, up.Y, back.Y,
        right.Z, up.Z, back.Z
    )
end

local function detach()
    if not stuck then return end
    stuck = false
    stuckN = nil
    stuckUp = nil
    pull = 0
    bobPhase = 0
    bobAmp = 0
    status = 'detached'
end

-- hand the direction to whichever mover exists; returns true if one took it
local function pushMove(hum, move)
    if walkPath == 'hum' then
        local f = fnOf(hum, 'Move')
        if f then
            local ok = pcall(function() f(hum, move, false) end)
            if ok then return true end
        end
        walkPath = resolvePath(hum)
        return false
    end
    if walkPath == 'lp' then
        local f = fnOf(lp, 'Move')
        if f then
            local ok = pcall(function() f(lp, move, false) end)
            if ok then return true end
        end
        walkPath = resolvePath(hum)
        return false
    end
    return false
end

track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local char = lp.Character
    local hum = char and char:FindFirstChild('Humanoid')
    local hrp = char and char:FindFirstChild('HumanoidRootPart')
    local cam = workspace.CurrentCamera

    if not CFG.on then
        if stuck then detach() end
        status = 'off'
        return
    end
    if not char or not hum or not hrp or not cam then
        if stuck then detach() end
        status = 'no character'
        return
    end
    if hum.Health <= 0 then
        if stuck then detach() end
        status = 'dead'
        return
    end

    local jumpDown = held(CFG.keyJump)
    local jumpEdge = jumpDown and not lastJump
    lastJump = jumpDown

    -- ---------- attach ----------
    if not stuck then
        if jumpEdge then return end
        if not held(CFG.keyW) then
            status = 'ready - hold W at a wall'
            return
        end
        local n, d, e = findWall(char, hrp.Position, CFG.attach)
        if not n then
            status = 'no wall within ' .. tostring(CFG.attach)
            return
        end
        if cam.CFrame.LookVector:Dot(-n) < CFG.faceDot then
            status = 'wall beside you - face it'
            return
        end
        stuck = true
        stuckN = n
        walkPath = resolvePath(hum)
        log('move path: ' .. walkPath)
        local okUp, curUp = pcall(function() return hrp.CFrame.UpVector end)
        if okUp and curUp and curUp.Magnitude > 0.5 then
            stuckUp = curUp.Unit
        else
            stuckUp = Vector3.new(0, 1, 0)
        end
        pull = 0
        bobPhase = 0
        bobAmp = 0
        status = 'stuck (d=' .. string.format('%.1f', d) .. ')'
    end

    -- ---------- release ----------
    if jumpEdge then
        local away = stuckN or Vector3.new(0, 1, 0)
        pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position + away * 1.2)
            hrp.Velocity = away * 32 + Vector3.new(0, 14, 0)
        end)
        detach()
        return
    end

    local p = hrp.Position
    local n, d, e = findWall(char, p, CFG.keep)
    if not n or not e then
        detach()
        status = 'wall lost'
        return
    end
    if stuckN and n:Dot(stuckN) < 0.35 then
        detach()
        status = 'face changed'
        return
    end
    stuckN = n

    local aTurn = math.min(1, dt * CFG.turnRate)
    local newUp = stuckUp:Lerp(n, aTurn)
    if newUp.Magnitude < 1e-3 then newUp = n else newUp = newUp.Unit end
    stuckUp = newUp

    local look = wallLook(cam, newUp)
    if not look then detach() status = 'no look' return end

    local right = look:Cross(newUp)
    if right.Magnitude < 1e-3 then detach() status = 'bad basis' return end
    right = right.Unit
    local back = -look

    local f, r = 0, 0
    if held(CFG.keyW) then f = f + 1 end
    if held(CFG.keyS) then f = f - 1 end
    if held(CFG.keyD) then r = r + 1 end
    if held(CFG.keyA) then r = r - 1 end

    local move = look * f + right * r
    if move.Magnitude > 1e-3 then move = move.Unit else move = Vector3.new(0, 0, 0) end

    -- ---------- movement ----------
    -- hum/lp: the humanoid moves itself, so the real walk cycle plays.
    -- cf    : we move the position, which cannot animate - v3.3's slide.
    local moved = false
    if walkPath ~= 'cf' then
        moved = pushMove(hum, move)
        if not moved and walkPath == 'cf' then
            log('move path fell back to cf')
        end
    end

    local target = p
    if walkPath == 'cf' then
        target = p + move * CFG.walk * dt
    end

    local wc = closestOn(e, target)
    if wc then
        pull = math.min(1, pull + dt * CFG.pullRate)
        local onWall = wc + n * CFG.standoff
        target = target + (onWall - target) * pull
        status = (pull < 0.98) and string.format('settling %.2f', pull) or 'on wall'
    else
        target = p
        status = 'edge - holding'
    end

    local moving = (move.Magnitude > 1e-3) and (pull > 0.5)
    if CFG.bobAmp > 0 then
        if moving then
            bobPhase = bobPhase + dt * CFG.bobRate
            if bobPhase > 6.283185307179586 then
                bobPhase = bobPhase - 6.283185307179586
            end
        end
        local wantAmp = moving and CFG.bobAmp or 0
        bobAmp = bobAmp + (wantAmp - bobAmp) * math.min(1, dt * CFG.bobEase)
        if bobAmp > 0.001 then
            target = target + newUp * (math.sin(bobPhase) * bobAmp)
        end
    end

    local ok = pcall(function()
        hrp.CFrame = makeCFrame(target, right, newUp, back)
    end)
    if not ok then
        detach()
        status = 'write failed'
        return
    end

    wallInfo = string.format('walk=%s n=%.2f,%.2f,%.2f d=%.1f',
        walkPath, n.X, n.Y, n.Z, d or -1)
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    hud.Text = string.format('[%s] on=%s | %s | %s', VERSION, tostring(CFG.on), status, wallInfo)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Wall Walk', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Wall Walk')
                if not sec then return end
                mkToggle(sec, 'Wall Walk', 'ww_on', CFG.on, function(v)
                    CFG.on = v
                    if not v then detach() end
                    log('wall walk ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    detach()
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Wall Walk') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION, path = function() return walkPath end }
log(VERSION .. ' loaded - toggle on, hold W at a wall, WASD to walk, Space to step off')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Wall Walk', 3) end)
