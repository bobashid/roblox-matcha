--[[
  Wall Walk (universal) - Matcha LuauVM
  Version: v3.1
  ONE toggle. Hold W at a wall: your feet go ON the wall. WASD then walks
  that wall as if it were the ground. Space steps off.

  HISTORY - five versions, every failure silent until probed
    v1.0 wrote Humanoid.PlatformStand. Not writable; the pcall swallowed it.
    v2.0 used workspace:Raycast. PROBED: accepts the call, returns nil for
         every ray. FindPartOnRay, GetPartBoundsInBox, GetPartsInRadius,
         GetPartsInPart and Region3 are all nil too. No spatial query here.
    v2.1-v2.3 read part geometry with OBB maths (probe-verified correct) but
         only wrote Velocity, so the character stayed upright. A climb.
    v3.0 called CFrame.fromMatrix. PROBED: it is nil. The earlier probe that
         appeared to confirm it was garbled output, and I built on it anyway.
         That version would have failed at the write, every frame.

  v3.1 - the constructor that actually exists
    PROBED this session, in order:
      CFrame.fromMatrix   -> nil
      CFrame.fromAxisAngle-> nil
      CFrame.Angles       -> function, but no way to set a custom up
      CFrame.lookAt       -> function, but it IGNORED the up argument
                             (passed (1,0,0), got UpVector (0,1,0) back)
      CFrame.new(x,y,z, rX,uX,bX, rY,uY,bY, rZ,uZ,bZ) -> works, and the basis
                             reads back exactly: up (1,0,0), right (0,-1,0)
    So the 12-number form is the only constructor here that can build an
    arbitrary orientation. The three vectors are the COLUMNS of the rotation
    matrix in the order right, up, back.

  WHAT THE PROBE ALSO PROVED
    A rotated write PERSISTS: up read back (1,0,0) immediately and still
    (1,0,0) after 0.1 s - the humanoid does not snap you upright.
    But Y fell 24.00 -> 23.02 in that 0.1 s, so gravity still acts. That is
    exactly why Position is rewritten every physics step: the rewrite is what
    holds you on the wall, not the rotation alone.

  HOW IT HOLDS YOU
    Each Heartbeat while attached:
      up         = wall face normal        (feet on the wall)
      look       = camera look projected onto the wall plane (WASD direction)
      right      = look x up
      back       = -look
      position   = closest point on the face + normal * standoff
    Written as one CFrame.new with 12 numbers, and Velocity zeroed so the
    character does not accumulate downward speed between writes.

  COST
    A CFrame write is thousands of internal memory operations; doing it every
    Heartbeat is the documented "continuous motion, user asked for it" case.
    Writes happen ONLY while attached. Detach and they stop entirely.

  DETECTION - unchanged, probe-verified
    OBB closest-point: transform into part space, clamp to half-extents, back
    to world. Offset from that point to the player = outward face normal.
    |n.Y| <= 0.7 rejects floors and ceilings. Broad-phase uses centre distance
    minus half-diagonal, so a large wall's face is never skipped.
    The cache entry is carried by reference - never compare two Instances with
    ==, they do not hash equal in this VM.

  Stop with _G.WallWalk.stop(), the toggle, or Space to step off.
]]

local NAME    = 'WallWalk'
local VERSION = 'v3.1'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local clamp = math.clamp or function(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local CFG = {
    on       = false,
    walk     = 18,     -- studs/s along the wall
    reach    = 7,      -- how close a face must be to attach
    standoff = 3.2,    -- HRP centre distance from the wall surface
    maxY     = 0.7,    -- reject floor/ceiling faces
    recache  = 25,     -- rebuild the part cache after moving this far
    keep     = 120,    -- cache radius
    keyW     = 0x57,
    keyA     = 0x41,
    keyS     = 0x53,
    keyD     = 0x44,
    keyJump  = 0x20,
}

local status   = 'off'
local wallInfo = '-'
local stuck    = false
local stuckUp  = nil
local lastJump = false

local parts   = {}
local cacheAt = nil

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

-- One traversal. Each entry caches pos + half-extents so the per-tick loop
-- does no property reads until a candidate passes the broad-phase.
local function rebuildCache(char, at)
    local out = {}
    local ok, list = pcall(function() return workspace:GetDescendants() end)
    if not ok or not list then
        log('GetDescendants failed')
        return
    end
    for i = 1, #list do
        local p = list[i]
        local okc, cls = pcall(function() return p.ClassName end)
        if okc and cls == 'Part' then
            local okPos, pos = pcall(function() return p.Position end)
            local okSz, sz  = pcall(function() return p.Size end)
            if okPos and okSz and pos and sz and sz.X >= 1 and sz.Y >= 1 and sz.Z >= 1 then
                local halfDiag = sz.Magnitude * 0.5
                if (pos - at).Magnitude - halfDiag <= CFG.keep then
                    local okA, anc = pcall(function() return p:IsDescendantOf(char) end)
                    if not okA or anc ~= true then
                        out[#out + 1] = {
                            part = p, pos = pos,
                            hx = sz.X * 0.5, hy = sz.Y * 0.5, hz = sz.Z * 0.5,
                            halfDiag = halfDiag,
                        }
                    end
                end
            end
        end
    end
    parts = out
    cacheAt = at
    log('nearby parts cached: ' .. tostring(#out))
end

-- Nearest wall-like face within reach. Returns normal, distance, and the
-- cache ENTRY (never the Instance - instances do not compare equal here).
local function findWall(char, p)
    if not cacheAt or (cacheAt - p).Magnitude > CFG.recache then
        rebuildCache(char, p)
    end

    local bestN, bestD, bestE = nil, CFG.reach, nil
    for i = 1, #parts do
        local e = parts[i]
        local dx, dy, dz = e.pos.X - p.X, e.pos.Y - p.Y, e.pos.Z - p.Z
        local d2 = dx*dx + dy*dy + dz*dz
        local lim = CFG.reach + e.halfDiag
        if d2 <= lim * lim then
            local okCf, cf = pcall(function() return e.part.CFrame end)
            if okCf and cf then
                local rel = cf:PointToObjectSpace(p)
                local cx = clamp(rel.X, -e.hx, e.hx)
                local cy = clamp(rel.Y, -e.hy, e.hy)
                local cz = clamp(rel.Z, -e.hz, e.hz)
                local lc = Vector3.new(cx, cy, cz)
                local wc = cf:PointToWorldSpace(lc)
                local bx, by, bz = p.X - wc.X, p.Y - wc.Y, p.Z - wc.Z
                local bd = math.sqrt(bx*bx + by*by + bz*bz)
                if bd > 1e-4 and bd <= bestD then
                    local wn = cf:VectorToWorldSpace(rel - lc)
                    if wn.Magnitude > 1e-4 then
                        wn = wn.Unit
                        if math.abs(wn.Y) <= CFG.maxY then
                            bestN, bestD, bestE = wn, bd, e
                        end
                    end
                end
            end
        end
    end
    return bestN, bestD, bestE
end

-- Closest point on the cached entry's box, in world space.
local function closestOn(e, p)
    local okCf, cf = pcall(function() return e.part.CFrame end)
    if not okCf or not cf then return nil end
    local rel = cf:PointToObjectSpace(p)
    local cx = clamp(rel.X, -e.hx, e.hx)
    local cy = clamp(rel.Y, -e.hy, e.hy)
    local cz = clamp(rel.Z, -e.hz, e.hz)
    return cf:PointToWorldSpace(Vector3.new(cx, cy, cz)), cf, rel
end

local function wallLook(cam, up)
    local l = cam.CFrame.LookVector
    local flat = l - up * l:Dot(up)
    if flat.Magnitude > 1e-3 then return flat.Unit end
    for _, cand in ipairs({ Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1) }) do
        local f2 = cand - up * cand:Dot(up)
        if f2.Magnitude > 1e-3 then return f2.Unit end
    end
    return nil
end

-- The only constructor here that builds an arbitrary orientation.
-- Columns are right, up, back.
local function makeCFrame(pos, right, up, back)
    return CFrame.new(
        pos.X, pos.Y, pos.Z,
        right.X, up.X, back.X,
        right.Y, up.Y, back.Y,
        right.Z, up.Z, back.Z
    )
end

local function detach()
    if not stuck then return end
    stuck = false
    stuckUp = nil
    status = 'detached'
end

track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local char = lp.Character
    local hum  = char and char:FindFirstChild('Humanoid')
    local hrp  = char and char:FindFirstChild('HumanoidRootPart')
    local cam  = workspace.CurrentCamera

    if not CFG.on then
        if stuck then detach() end
        status = 'off'
        return
    end
    if not char or not hum or not hrp or not cam then
        if stuck then detach() end
        status = 'no character'
        return
    end
    if hum.Health <= 0 then
        if stuck then detach() end
        status = 'dead'
        return
    end

    local jumpDown = held(CFG.keyJump)
    local jumpEdge = jumpDown and not lastJump
    lastJump = jumpDown

    if not stuck then
        if jumpEdge then return end
        if not held(CFG.keyW) then
            status = 'ready - hold W at a wall'
            return
        end
        local n, d = findWall(char, hrp.Position)
        if not n then
            status = 'no wall within ' .. tostring(CFG.reach)
            return
        end
        stuck = true
        stuckUp = n
        status = 'stuck (d=' .. string.format('%.1f', d) .. ')'
        wallInfo = string.format('n=%.2f,%.2f,%.2f parts=%d', n.X, n.Y, n.Z, #parts)
    end

    if jumpEdge then
        local away = stuckUp or Vector3.new(0, 1, 0)
        pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position + away * 1.2)
            hrp.Velocity = away * 32 + Vector3.new(0, 14, 0)
        end)
        detach()
        return
    end

    local p = hrp.Position
    local n, d, e = findWall(char, p)
    if not n or not e then
        detach()
        status = 'wall lost'
        return
    end
    if stuckUp and n:Dot(stuckUp) < 0.35 then
        detach()
        status = 'face changed'
        return
    end
    stuckUp = n

    local look = wallLook(cam, n)
    if not look then detach() status = 'no look' return end

    local right = look:Cross(n)
    if right.Magnitude < 1e-3 then detach() status = 'bad basis' return end
    right = right.Unit
    local back = -look

    local f, r = 0, 0
    if held(CFG.keyW) then f = f + 1 end
    if held(CFG.keyS) then f = f - 1 end
    if held(CFG.keyD) then r = r + 1 end
    if held(CFG.keyA) then r = r - 1 end

    local move = look * f + right * r
    if move.Magnitude > 1e-3 then move = move.Unit else move = Vector3.new(0, 0, 0) end

    local target = p + move * CFG.walk * dt

    -- project the target back onto the face at a fixed standoff, so walking
    -- along the wall can never drift off it or into it
    local wc = closestOn(e, target)
    if wc then
        target = wc + n * CFG.standoff
    else
        target = p
        status = 'edge - holding'
    end

    local ok = pcall(function()
        hrp.CFrame = makeCFrame(target, right, n, back)
        hrp.Velocity = Vector3.new(0, 0, 0)
    end)
    if not ok then
        detach()
        status = 'write failed'
        return
    end

    status = 'on wall'
    wallInfo = string.format('n=%.2f,%.2f,%.2f d=%.1f', n.X, n.Y, n.Z, d or -1)
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    hud.Text = string.format('[%s] on=%s | %s | %s', VERSION, tostring(CFG.on), status, wallInfo)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Wall Walk', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Wall Walk')
                if not sec then return end
                mkToggle(sec, 'Wall Walk', 'ww_on', CFG.on, function(v)
                    CFG.on = v
                    if not v then detach() end
                    log('wall walk ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    detach()
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Wall Walk') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - toggle on, hold W at a wall, WASD to walk, Space to step off')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Wall Walk', 3) end)
