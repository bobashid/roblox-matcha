--[[
  Wall Walk (universal) - Matcha LuauVM
  Version: v3.0
  ONE toggle. Hold W at a wall to stick to it with your feet ON the wall;
  WASD then walks on that wall as if it were the ground. Space steps off.

  WHY EARLIER VERSIONS FAILED
    v1.0 wrote Humanoid.PlatformStand - not writable, pcall swallowed it.
    v2.0 used workspace:Raycast - PROBED: accepts the call, always returns nil.
         FindPartOnRay, GetPartBoundsInBox, GetPartsInRadius, GetPartsInPart and
         Region3 are all nil too. No spatial query in this build at all.
    v2.1/v2.2/v2.3 read part geometry with OBB maths (correct, probe-verified:
         boxDist 2.000 / normal 0,0,1 / isWall true on live geometry), but they
         only changed Velocity, so the character kept its upright orientation
         and gravity kept pulling down. That is a wall CLIMB, not wall walking.

  v3.0 - the mechanism the backflip script revealed
    A CFrame write with a rotated up vector STICKS. Probed this session:
    writing CFrame.fromMatrix(pos, right, up, -look) with up = (1,0,0) read
    back UpVector (1,0,0) immediately AND still (1,0,0) 0.1 s later, with Y
    unchanged. The humanoid does not snap the character upright.
    So each physics step we write:
      UpVector   = wall normal      (feet on the wall)
      LookVector = camera look projected onto the wall plane
      Position   = closest point on wall + normal * standoff
    Writing Position every step also cancels gravity, which is what holds you
    on the wall. No Instance, no raycast, no PlatformStand needed.

  COST - this is the one heavy thing in the script
    A CFrame write performs thousands of internal memory operations. Writing
    it every Heartbeat is the documented "continuous motion, user asked for it"
    case. It is only written while the toggle is on AND you are stuck to a
    wall; the moment you step off, writes stop entirely.

  DETECTION - unchanged from v2.3, probe-verified
    OBB closest-point: transform into part space, clamp to half-extents, back
    to world. Offset from that point = outward face normal. |n.Y| <= 0.7
    rejects floors and ceilings. Broad-phase uses centre distance minus half
    diagonal so a large wall's face is never skipped.

  Stop with _G.WallWalk.stop(), the toggle, or Space to step off the wall.
]]

local NAME    = 'WallWalk'
local VERSION = 'v3.0'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local clamp = math.clamp or function(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local CFG = {
    on       = false,
    walk     = 18,     -- studs/s while walking on the wall
    reach    = 7,      -- how close a face must be to attach
    standoff = 3.2,    -- HRP centre distance from the wall surface
    maxY     = 0.7,    -- reject floor/ceiling faces
    recache  = 25,
    keep     = 120,
    keyW     = 0x57,
    keyA     = 0x41,
    keyS     = 0x53,
    keyD     = 0x44,
    keyJump  = 0x20,
}

local status    = 'off'
local wallInfo  = '-'
local stuck     = false
local stuckN    = nil
local stuckLook = nil
local lastJump  = false

local parts   = {}
local cacheAt = nil

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

local function rebuildCache(char, at)
    local out = {}
    local ok, list = pcall(function() return workspace:GetDescendants() end)
    if not ok or not list then return end
    for i = 1, #list do
        local p = list[i]
        local okc, cls = pcall(function() return p.ClassName end)
        if okc and cls == 'Part' then
            local okPos, pos = pcall(function() return p.Position end)
            local okSz, sz  = pcall(function() return p.Size end)
            if okPos and okSz and pos and sz and sz.X >= 1 and sz.Y >= 1 and sz.Z >= 1 then
                local halfDiag = sz.Magnitude * 0.5
                if (pos - at).Magnitude - halfDiag <= CFG.keep then
                    local okA, anc = pcall(function() return p:IsDescendantOf(char) end)
                    if not okA or anc ~= true then
                        out[#out + 1] = {
                            part = p, pos = pos,
                            hx = sz.X * 0.5, hy = sz.Y * 0.5, hz = sz.Z * 0.5,
                            halfDiag = halfDiag,
                        }
                    end
                end
            end
        end
    end
    parts = out
    cacheAt = at
    log('nearby parts cached: ' .. tostring(#out))
end

-- nearest part face within reach, with its closest point and outward normal
local function findWall(char, p, wantPart)
    if not cacheAt or (cacheAt - p).Magnitude > CFG.recache then
        rebuildCache(char, p)
    end

    local bestN, bestD, bestCf, bestE = nil, CFG.reach, nil, nil
    for i = 1, #parts do
        local e = parts[i]
        local dx, dy, dz = e.pos.X - p.X, e.pos.Y - p.Y, e.pos.Z - p.Z
        local d2 = dx*dx + dy*dy + dz*dz
        local lim = CFG.reach + e.halfDiag
        if d2 <= lim * lim then
            local okCf, cf = pcall(function() return e.part.CFrame end)
            if okCf and cf then
                local rel = cf:PointToObjectSpace(p)
                local cx = clamp(rel.X, -e.hx, e.hx)
                local cy = clamp(rel.Y, -e.hy, e.hy)
                local cz = clamp(rel.Z, -e.hz, e.hz)
                local lc = Vector3.new(cx, cy, cz)
                local wc = cf:PointToWorldSpace(lc)
                local bx, by, bz = p.X - wc.X, p.Y - wc.Y, p.Z - wc.Z
                local bd = math.sqrt(bx*bx + by*by + bz*bz)
                if bd > 1e-4 and bd <= bestD then
                    local wn = cf:VectorToWorldSpace(rel - lc)
                    if wn.Magnitude > 1e-4 then
                        wn = wn.Unit
                        if math.abs(wn.Y) <= CFG.maxY then
                            if not wantPart or e.part == wantPart then
                                bestN, bestD, bestCf, bestE = wn, bd, cf, e
                            end
                        end
                    end
                end
            end
        end
    end
    return bestN, bestD, bestCf, bestE
end

-- project the camera look onto the wall plane, fall back to world up
local function wallLook(cam, up)
    local l = cam.CFrame.LookVector
    local flat = l - up * l:Dot(up)
    if flat.Magnitude > 1e-3 then return flat.Unit end
    local w = Vector3.new(0, 1, 0)
    flat = w - up * w:Dot(up)
    if flat.Magnitude > 1e-3 then return flat.Unit end
    w = Vector3.new(1, 0, 0)
    flat = w - up * w:Dot(up)
    if flat.Magnitude > 1e-3 then return flat.Unit end
    return nil
end

local function detach()
    if not stuck then return end
    stuck = false
    stuckN = nil
    stuckLook = nil
    status = 'detached'
end

-- physics step: this is where the character is held on the wall
track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local char = lp.Character
    local hum  = char and char:FindFirstChild('Humanoid')
    local hrp  = char and char:FindFirstChild('HumanoidRootPart')
    local cam  = workspace.CurrentCamera

    if not CFG.on then
        if stuck then detach() end
        status = 'off'
        return
    end
    if not char or not hum or not hrp or not cam then
        if stuck then detach() end
        status = 'no character'
        return
    end
    if hum.Health <= 0 then
        if stuck then detach() end
        status = 'dead'
        return
    end

    local jumpDown = held(CFG.keyJump)
    local jumpEdge = jumpDown and not lastJump
    lastJump = jumpDown

    if not stuck then
        if jumpEdge then return end
        if not held(CFG.keyW) then
            status = 'ready - hold W at a wall'
            return
        end
        local n, d = findWall(char, hrp.Position, nil)
        if not n then
            status = 'no wall within ' .. tostring(CFG.reach)
            return
        end
        stuck = true
        stuckN = n
        status = 'stuck (d=' .. string.format('%.1f', d) .. ')'
        wallInfo = string.format('n=%.2f,%.2f,%.2f parts=%d', n.X, n.Y, n.Z, #parts)
    end

    -- SPACE steps off, kicking away from the wall
    if jumpEdge then
        local away = stuckN or Vector3.new(0, 1, 0)
        pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position + away * 1.2)
            hrp.Velocity = away * 32 + Vector3.new(0, 14, 0)
        end)
        detach()
        return
    end

    -- still on a wall? re-check against the part we are attached to
    local up = stuckN
    if not up then detach() return end

    local p = hrp.Position
    local n2 = findWall(char, p, nil)
    if not n2 then
        detach()
        status = 'wall lost'
        return
    end
    if n2:Dot(up) < 0.35 then
        detach()
        status = 'face changed'
        return
    end
    up = n2
    stuckN = up

    local look = wallLook(cam, up)
    if not look then detach() return end
    stuckLook = look

    local right = look:Cross(up)
    if right.Magnitude < 1e-3 then detach() return end
    right = right.Unit

    local f = 0
    if held(CFG.keyW) then f = f + 1 end
    if held(CFG.keyS) then f = f - 1 end
    local r = 0
    if held(CFG.keyD) then r = r + 1 end
    if held(CFG.keyA) then r = r - 1 end

    local move = look * f + right * r
    if move.Magnitude > 1e-3 then move = move.Unit else move = Vector3.new(0, 0, 0) end

    local target = p + move * CFG.walk * dt

    -- pull the target back onto the attached face at a fixed standoff
    local _, _, wcf = findWall(char, target, nil)
    if wcf then
        local rel = wcf:PointToObjectSpace(target)
        -- nearest point on the same face plane, along the normal
        local nx, ny, nz = up.X, up.Y, up.Z
        local planeD = rel.X * nx + rel.Y * ny + rel.Z * nz
        -- approximate: just step along the surface and re-add standoff
    end

    local _, _, _, e = findWall(char, target, nil)
    if not e then
        -- walked off the edge: keep the last good position, do not fall
        status = 'edge - holding'
        target = p
    end

    -- recompute closest point and standoff from whichever face we are on
    local nFace, dFace, cfFace = findWall(char, target, nil)
    if nFace and cfFace then
        local rel = cfFace:PointToObjectSpace(target)
        local e2 = nil
        -- locate the entry that produced cfFace to clamp properly
        for i = 1, #parts do
            if parts[i].part and parts[i].part.CFrame == cfFace then e2 = parts[i] break end
        end
        if e2 then
            local cx = clamp(rel.X, -e2.hx, e2.hx)
            local cy = clamp(rel.Y, -e2.hy, e2.hy)
            local cz = clamp(rel.Z, -e2.hz, e2.hz)
            local wc = cfFace:PointToWorldSpace(Vector3.new(cx, cy, cz))
            target = wc + nFace * CFG.standoff
            up = nFace
            stuckN = up
        end
    end

    local ok = pcall(function()
        hrp.CFrame = CFrame.fromMatrix(target, right, up, -look)
        hrp.Velocity = Vector3.new(0, 0, 0)
    end)
    if not ok then
        detach()
        status = 'write failed'
        return
    end

    status = 'on wall'
    wallInfo = string.format('n=%.2f,%.2f,%.2f d=%.1f', up.X, up.Y, up.Z, dFace or -1)
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    hud.Text = string.format('[%s] %s | %s | %s', VERSION, tostring(CFG.on), status, wallInfo)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Wall Walk', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Wall Walk')
                if not sec then return end
                mkToggle(sec, 'Wall Walk', 'ww_on', CFG.on, function(v)
                    CFG.on = v
                    if not v then detach() end
                    log('wall walk ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    detach()
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Wall Walk') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - toggle on, hold W at a wall, WASD to walk, Space to step off')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Wall Walk', 3) end)
