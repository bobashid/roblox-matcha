--[[
  Wall Walk (universal) - Matcha LuauVM
  Version: v3.2
  ONE toggle. Hold W at a wall: your feet go ON the wall. WASD then walks
  that wall as if it were the ground. Space steps off.

  WHY v3.2 - "feels unsmooth and i feel like my feet are magnets to walls"
  That report is not a detection bug. Detection was already correct. It was
  the CONSTRAINT being applied at full strength on the first frame:

    1. One radius for attach and for stay. reach was 7 while standoff was
       3.2, so you were grabbed from up to 3.8 studs away and teleported
       onto the wall in a single frame. That is the magnet.
    2. The wall pull was binary. Every frame the position was written as
       closest + normal * standoff, exactly. No ramp, no glide.
    3. The basis was assigned outright. Any change in the surface normal
       rotated the character instantly, so corners snapped.

  v3.2 changes three things and nothing else:
    - attach at 4.5 studs, stay while within 7.5 (hysteresis). Grabs when you
      are actually at the wall, lets go when you clearly are not.
    - a `pull` value that starts at 0 on attach and eases to 1 at ~10/s. The
      tangential movement stays full speed; only the pull onto the surface
      ramps, so you glide onto the wall over ~0.25 s instead of teleporting.
    - the up vector is LERPed toward the wall normal at ~8/s instead of being
      assigned, so corners and face changes round off.
  Also: attaching now requires you to be facing the wall (camLook dot -n), or
  brushing past one latches you. And standoff is 2.6, not 3.2, so your feet
  sit on the surface rather than 1.2 studs off it.

  HISTORY - every earlier failure was silent until probed
    v1.0 wrote Humanoid.PlatformStand. Not writable; the pcall swallowed it.
    v2.0 used workspace:Raycast. PROBED: accepts the call, returns nil for
         every ray. FindPartOnRay, GetPartBoundsInBox, GetPartsInRadius,
         GetPartsInPart, Region3 are all nil. No spatial query in this VM.
    v2.1-v2.3 read part geometry with OBB maths (probe-verified) but only
         wrote Velocity, so the character stayed upright. A climb.
    v3.0 called CFrame.fromMatrix. PROBED: nil. Would have failed to write.
    v3.1 used the 12-number CFrame.new basis and worked, but grabbed hard.

  PROBED, and the reason this design exists
    CFrame.fromMatrix       -> nil
    CFrame.fromAxisAngle    -> nil
    CFrame.Angles           -> function, cannot set a custom up
    CFrame.lookAt           -> function, IGNORES its up argument
    CFrame.new(x,y,z, rX,uX,bX, rY,uY,bY, rZ,uZ,bZ) -> works; the three
      vectors are the COLUMNS of the rotation matrix: right, up, back.
    A rotated write PERSISTS across a physics step (up read back (1,0,0)
    immediately and still (1,0,0) after 0.1 s), but gravity still acts
    (Y 24.00 -> 23.02 in that 0.1 s). So position must be rewritten every
    physics step; the rewrite is what holds you on the wall.

  THE ONE VISUAL CONSTANT TO TUNE
    CFG.standoff = 2.6 is the HRP centre distance from the wall surface.
    Feet sit roughly 2 studs below HRP along the character's up, so 2.6 puts
    them ~0.6 off the wall. Lower it if you float, raise it if you sink in.

  COST
    A CFrame write is thousands of internal memory ops. It happens only
    while attached, on Heartbeat, and stops the instant you detach.
    The part cache rebuilds after 40 studs of travel (not 25), which removes
    a visible hitch from the old value.

  Stop with _G.WallWalk.stop(), the toggle, or Space to step off.
]]

local NAME    = 'WallWalk'
local VERSION = 'v3.2'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local clamp = math.clamp or function(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local CFG = {
    on       = false,
    walk     = 18,     -- studs/s along the wall
    attach   = 4.5,    -- must be this close to grab
    keep     = 7.5,    -- stays grabbed until this far (hysteresis)
    standoff = 2.6,    -- HRP centre distance from the wall surface
    pullRate = 10,     -- 1/s, how fast the wall pull ramps 0 -> 1
    turnRate = 8,      -- 1/s, how fast the up vector eases to the normal
    faceDot  = 0.15,   -- must be looking into the wall to grab
    maxY     = 0.7,    -- reject floor/ceiling faces
    recache  = 40,     -- rebuild the part cache after moving this far
    keepR    = 160,    -- cache radius
    keyW     = 0x57,
    keyA     = 0x41,
    keyS     = 0x53,
    keyD     = 0x44,
    keyJump  = 0x20,
}

local status   = 'off'
local wallInfo = '-'
local stuck    = false
local stuckN   = nil    -- last raw normal, for the face-changed test
local stuckUp  = nil    -- eased basis up
local pull     = 0      -- 0 = free, 1 = fully on the wall
local lastJump = false

local parts   = {}
local cacheAt = nil

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

local function rebuildCache(char, at)
    local out = {}
    local ok, list = pcall(function() return workspace:GetDescendants() end)
    if not ok or not list then
        log('GetDescendants failed')
        return
    end
    for i = 1, #list do
        local p = list[i]
        local okc, cls = pcall(function() return p.ClassName end)
        if okc and cls == 'Part' then
            local okPos, pos = pcall(function() return p.Position end)
            local okSz, sz  = pcall(function() return p.Size end)
            if okPos and okSz and pos and sz and sz.X >= 1 and sz.Y >= 1 and sz.Z >= 1 then
                local halfDiag = sz.Magnitude * 0.5
                if (pos - at).Magnitude - halfDiag <= CFG.keepR then
                    local okA, anc = pcall(function() return p:IsDescendantOf(char) end)
                    if not okA or anc ~= true then
                        out[#out + 1] = {
                            part = p, pos = pos,
                            hx = sz.X * 0.5, hy = sz.Y * 0.5, hz = sz.Z * 0.5,
                            halfDiag = halfDiag,
                        }
                    end
                end
            end
        end
    end
    parts = out
    cacheAt = at
    log('nearby parts cached: ' .. tostring(#out))
end

-- Nearest wall-like face within `reach`. Returns normal, distance, entry.
local function findWall(char, p, reach)
    if not cacheAt or (cacheAt - p).Magnitude > CFG.recache then
        rebuildCache(char, p)
    end

    local bestN, bestD, bestE = nil, reach, nil
    for i = 1, #parts do
        local e = parts[i]
        local dx, dy, dz = e.pos.X - p.X, e.pos.Y - p.Y, e.pos.Z - p.Z
        local d2 = dx*dx + dy*dy + dz*dz
        local lim = reach + e.halfDiag
        if d2 <= lim * lim then
            local okCf, cf = pcall(function() return e.part.CFrame end)
            if okCf and cf then
                local rel = cf:PointToObjectSpace(p)
                local cx = clamp(rel.X, -e.hx, e.hx)
                local cy = clamp(rel.Y, -e.hy, e.hy)
                local cz = clamp(rel.Z, -e.hz, e.hz)
                local wc = cf:PointToWorldSpace(Vector3.new(cx, cy, cz))
                local bx, by, bz = p.X - wc.X, p.Y - wc.Y, p.Z - wc.Z
                local bd = math.sqrt(bx*bx + by*by + bz*bz)
                if bd > 1e-4 and bd <= bestD then
                    local wn = cf:VectorToWorldSpace(rel - Vector3.new(cx, cy, cz))
                    if wn.Magnitude > 1e-4 then
                        wn = wn.Unit
                        if math.abs(wn.Y) <= CFG.maxY then
                            bestN, bestD, bestE = wn, bd, e
                        end
                    end
                end
            end
        end
    end
    return bestN, bestD, bestE
end

local function closestOn(e, p)
    local okCf, cf = pcall(function() return e.part.CFrame end)
    if not okCf or not cf then return nil end
    local rel = cf:PointToObjectSpace(p)
    local cx = clamp(rel.X, -e.hx, e.hx)
    local cy = clamp(rel.Y, -e.hy, e.hy)
    local cz = clamp(rel.Z, -e.hz, e.hz)
    return cf:PointToWorldSpace(Vector3.new(cx, cy, cz))
end

-- Project a direction onto the plane whose normal is `up`.
local function flatten(v, up)
    local f = v - up * v:Dot(up)
    if f.Magnitude > 1e-3 then return f.Unit end
    return nil
end

local function wallLook(cam, up)
    local l = flatten(cam.CFrame.LookVector, up)
    if l then return l end
    for _, cand in ipairs({ Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1) }) do
        local f = flatten(cand, up)
        if f then return f end
    end
    return nil
end

-- The only constructor here that builds an arbitrary orientation.
-- Columns are right, up, back.
local function makeCFrame(pos, right, up, back)
    return CFrame.new(
        pos.X, pos.Y, pos.Z,
        right.X, up.X, back.X,
        right.Y, up.Y, back.Y,
        right.Z, up.Z, back.Z
    )
end

local function detach()
    if not stuck then return end
    stuck   = false
    stuckN  = nil
    stuckUp = nil
    pull    = 0
    status  = 'detached'
end

track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local char = lp.Character
    local hum  = char and char:FindFirstChild('Humanoid')
    local hrp  = char and char:FindFirstChild('HumanoidRootPart')
    local cam  = workspace.CurrentCamera

    if not CFG.on then
        if stuck then detach() end
        status = 'off'
        return
    end
    if not char or not hum or not hrp or not cam then
        if stuck then detach() end
        status = 'no character'
        return
    end
    if hum.Health <= 0 then
        if stuck then detach() end
        status = 'dead'
        return
    end

    local jumpDown = held(CFG.keyJump)
    local jumpEdge = jumpDown and not lastJump
    lastJump = jumpDown

    -- ---------- attach ----------
    if not stuck then
        if jumpEdge then return end
        if not held(CFG.keyW) then
            status = 'ready - hold W at a wall'
            return
        end
        local n, d, e = findWall(char, hrp.Position, CFG.attach)
        if not n then
            status = 'no wall within ' .. tostring(CFG.attach)
            return
        end
        -- must actually be looking into the wall, or walking past one latches
        if cam.CFrame.LookVector:Dot(-n) < CFG.faceDot then
            status = 'wall beside you - face it'
            return
        end
        stuck  = true
        stuckN = n
        -- start the basis from where the character actually is, so the
        -- rotation onto the wall eases instead of snapping
        local okUp, curUp = pcall(function() return hrp.CFrame.UpVector end)
        if okUp and curUp and curUp.Magnitude > 0.5 then
            stuckUp = curUp.Unit
        else
            stuckUp = Vector3.new(0, 1, 0)
        end
        pull   = 0
        status = 'stuck (d=' .. string.format('%.1f', d) .. ')'
    end

    -- ---------- release ----------
    if jumpEdge then
        local away = stuckN or Vector3.new(0, 1, 0)
        pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position + away * 1.2)
            hrp.Velocity = away * 32 + Vector3.new(0, 14, 0)
        end)
        detach()
        return
    end

    local p = hrp.Position
    local n, d, e = findWall(char, p, CFG.keep)
    if not n or not e then
        detach()
        status = 'wall lost'
        return
    end
    -- compare the RAW normal, not the eased one, or the easing reads as a change
    if stuckN and n:Dot(stuckN) < 0.35 then
        detach()
        status = 'face changed'
        return
    end
    stuckN = n

    -- ---------- ease the basis ----------
    local aTurn = math.min(1, dt * CFG.turnRate)
    local newUp = stuckUp:Lerp(n, aTurn)
    if newUp.Magnitude < 1e-3 then newUp = n else newUp = newUp.Unit end
    stuckUp = newUp

    local look = wallLook(cam, newUp)
    if not look then detach() status = 'no look' return end

    local right = look:Cross(newUp)
    if right.Magnitude < 1e-3 then detach() status = 'bad basis' return end
    right = right.Unit
    local back = -look

    -- ---------- movement, full speed, tangential ----------
    local f, r = 0, 0
    if held(CFG.keyW) then f = f + 1 end
    if held(CFG.keyS) then f = f - 1 end
    if held(CFG.keyD) then r = r + 1 end
    if held(CFG.keyA) then r = r - 1 end

    local move = look * f + right * r
    if move.Magnitude > 1e-3 then move = move.Unit else move = Vector3.new(0, 0, 0) end

    local desired = p + move * CFG.walk * dt

    -- ---------- ease the wall pull ----------
    local target
    local wc = closestOn(e, desired)
    if wc then
        pull = math.min(1, pull + dt * CFG.pullRate)
        local onWall = wc + n * CFG.standoff
        target = desired + (onWall - desired) * pull
        status = (pull < 0.98) and string.format('settling %.2f', pull) or 'on wall'
    else
        -- walked past the edge of this face; hold, do not fling
        target = p
        status = 'edge - holding'
    end

    local ok = pcall(function()
        hrp.CFrame = makeCFrame(target, right, newUp, back)
        hrp.Velocity = Vector3.new(0, 0, 0)
    end)
    if not ok then
        detach()
        status = 'write failed'
        return
    end

    wallInfo = string.format('n=%.2f,%.2f,%.2f d=%.1f pull=%.2f', n.X, n.Y, n.Z, d or -1, pull)
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    hud.Text = string.format('[%s] on=%s | %s | %s', VERSION, tostring(CFG.on), status, wallInfo)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Wall Walk', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Wall Walk')
                if not sec then return end
                mkToggle(sec, 'Wall Walk', 'ww_on', CFG.on, function(v)
                    CFG.on = v
                    if not v then detach() end
                    log('wall walk ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    detach()
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Wall Walk') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - toggle on, hold W at a wall, WASD to walk, Space to step off')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Wall Walk', 3) end)
