--[[
  Wall Walk (universal) - Matcha LuauVM
  Version: v2.2
  ONE toggle: Wall Climb. Hold W at a wall to go up, S to come down.

  HISTORY - three versions, all failing silently in different ways
    v1.0 wrote Humanoid.PlatformStand. Not writable here, the pcall swallowed
         'Unknown property', nothing happened.
    v2.0 used workspace:Raycast. PROBED: it accepts the call and returns nil
         for every ray, including straight down at the ground. FindPartOnRay,
         GetPartBoundsInBox, GetPartsInRadius, GetPartsInPart and Region3 are
         all nil as well. There is no spatial query in this build.
    v2.1 read part geometry directly (OBB maths). Correct approach, but the
         probe that was supposed to confirm geometry returned a stale answer
         (34 objects, 0 Parts) and I wrongly called it dead. The real numbers
         are 7210 descendants, 1276 Parts, 228 Models, 67 parts within 60
         studs of the character. Geometry is there and dense.

  v2.2 - what changed
    reach raised 4.5 -> 7, because HumanoidRootPart sits at the character's
      centre and a wall face is roughly 1.5-2 studs out; 4.5 was cutting it fine.
    The cache now keeps only parts within 80 studs, so the per-tick loop walks
      a few dozen candidates instead of 1276.
    HUD reports the measured box distance and the normal components, so one
      test says whether it sees a wall and which way the face points.

  DETECTION, no queries
    Transform the player point into the part's local space, clamp to the
    half-extents, transform back = closest point on the box. The offset from
    that point to the player is the outward direction, and it is the face
    normal when the player is just outside a flat side. |n.Y| <= 0.7 rejects
    floors and ceilings, so only walls qualify.

  PERFORMANCE
    Position/CFrame/Velocity writes cost thousands of internal memory ops each,
    so the climb write is throttled to ~30 Hz and only fires while a direction
    key is held against a wall. The part cache is rebuilt only after moving 25
    studs. RenderStepped repaints text and nothing else.

  No Instance.new anywhere - Instance does not exist in this VM at all.
  Stop with _G.WallWalk.stop() or toggle off in the menu.
]]

local NAME    = 'WallWalk'
local VERSION = 'v2.2'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local clamp = math.clamp or function(v, a, b)
    if v < a then return a end
    if v > b then return b end
    return v
end

local CFG = {
    on      = false,
    climb   = 34,
    sink    = 22,
    stick   = 8,
    reach   = 7,
    maxY    = 0.7,
    tick    = 0.033,
    recache = 25,
    keep    = 80,
    keyW    = 0x57,
    keyS    = 0x53,
}

local status   = 'off'
local wallInfo = '-'
local wallDist = -1

local parts   = {}
local cacheAt = nil

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

local function rebuildCache(char, at)
    local out = {}
    local ok, list = pcall(function() return workspace:GetDescendants() end)
    if not ok or not list then
        log('GetDescendants failed')
        return
    end
    for i = 1, #list do
        local p = list[i]
        local okc, cls = pcall(function() return p.ClassName end)
        if okc and cls == 'Part' then
            local okPos, pos = pcall(function() return p.Position end)
            local okSz, sz  = pcall(function() return p.Size end)
            if okPos and okSz and pos and sz and sz.X >= 1 and sz.Y >= 1 and sz.Z >= 1 then
                if (pos - at).Magnitude <= CFG.keep then
                    local okA, anc = pcall(function() return p:IsDescendantOf(char) end)
                    if not okA or anc ~= true then
                        out[#out + 1] = p
                    end
                end
            end
        end
    end
    parts = out
    cacheAt = at
    log('nearby parts cached: ' .. tostring(#out))
end

local function nearestOnBox(part, p)
    local okCf, cf = pcall(function() return part.CFrame end)
    local okSz, sz = pcall(function() return part.Size end)
    if not okCf or not okSz or not cf or not sz then return nil end

    local rel = cf:PointToObjectSpace(p)
    local hx, hy, hz = sz.X * 0.5, sz.Y * 0.5, sz.Z * 0.5

    local cx = clamp(rel.X, -hx, hx)
    local cy = clamp(rel.Y, -hy, hy)
    local cz = clamp(rel.Z, -hz, hz)

    local localClosest = Vector3.new(cx, cy, cz)
    local worldClosest = cf:PointToWorldSpace(localClosest)
    local dist = (p - worldClosest).Magnitude

    local localNormal
    if dist > 1e-4 then
        localNormal = rel - localClosest
    else
        local px, py, pz = hx - math.abs(rel.X), hy - math.abs(rel.Y), hz - math.abs(rel.Z)
        if px <= py and px <= pz then
            localNormal = Vector3.new(rel.X >= 0 and 1 or -1, 0, 0)
        elseif py <= pz then
            localNormal = Vector3.new(0, rel.Y >= 0 and 1 or -1, 0)
        else
            localNormal = Vector3.new(0, 0, rel.Z >= 0 and 1 or -1)
        end
    end

    local worldNormal = cf:VectorToWorldSpace(localNormal)
    if worldNormal.Magnitude < 1e-4 then return nil end
    return worldClosest, worldNormal.Unit, dist
end

local function findWall(char, p)
    if not cacheAt or (cacheAt - p).Magnitude > CFG.recache then
        rebuildCache(char, p)
    end

    local bestN, bestD = nil, CFG.reach
    for i = 1, #parts do
        local part = parts[i]
        local okP, pp = pcall(function() return part.Position end)
        if okP and pp and (pp - p).Magnitude < CFG.reach + 10 then
            local _, normal, dist = nearestOnBox(part, p)
            if normal and dist <= bestD and math.abs(normal.Y) <= CFG.maxY then
                bestN, bestD = normal, dist
            end
        end
    end
    return bestN, bestD
end

task.spawn(function()
    while running do
        local char = lp.Character
        local hum  = char and char:FindFirstChild('Humanoid')
        local hrp  = char and char:FindFirstChild('HumanoidRootPart')

        if not CFG.on then
            status, wallInfo, wallDist = 'off', '-', -1
        elseif not char or not hum or not hrp then
            status = 'no character'
        elseif hum.Health <= 0 then
            status = 'dead'
        else
            local p = hrp.Position
            local n, d = findWall(char, p)
            if n then
                wallInfo = string.format('n=%.2f,%.2f,%.2f parts=%d', n.X, n.Y, n.Z, #parts)
                wallDist = d
                local climb = 0
                if held(CFG.keyW) then
                    climb = CFG.climb
                elseif held(CFG.keyS) then
                    climb = -CFG.sink
                end
                if climb ~= 0 then
                    pcall(function()
                        hrp.Velocity = Vector3.new(-n.X * CFG.stick, climb, -n.Z * CFG.stick)
                    end)
                    status = string.format('climbing %+d', climb)
                else
                    status = 'wall found - W up / S down'
                end
            else
                wallInfo = string.format('parts=%d', #parts)
                wallDist = -1
                status = 'no wall within ' .. tostring(CFG.reach)
            end
        end

        task.wait(CFG.tick)
    end
end)

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    hud.Text = string.format('[%s] %s | dist %.2f | %s', VERSION, status, wallDist, wallInfo)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Wall Walk', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Wall Walk')
                if not sec then return end
                mkToggle(sec, 'Wall Climb', 'ww_on', CFG.on, function(v)
                    CFG.on = v
                    log('wall climb ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Wall Walk') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - toggle on, hold W at a wall')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Wall Walk', 3) end)
