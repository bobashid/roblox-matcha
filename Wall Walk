--[[
  Wall Walk (universal) - Matcha LuauVM
  Version: v2.0
  ONE toggle: Wall Climb. Hold W at a wall to go up, S to come down.

  WHAT WAS WRONG IN v1.0 (both real bugs, both silent)
    1. It wrote Humanoid.PlatformStand. That property is NOT in Matcha's
       writable list, so the assignment raised 'Unknown property'. The pcall
       around it swallowed the error, so the write never happened and the
       script looked like it did nothing.
    2. Wall detection measured how far you had moved over 0.2 s. That is a
       guess, not a signal: it fires on lag, on slopes, on stepping into a
       corner, and it does not know which way the wall faces.

  WHAT CHANGED IN v2.0
    workspace:Raycast exists in this VM, with RaycastParams and a real
    surface Normal. Wall detection is now a forward ray - 5 studs along the
    camera's flattened look vector, character filtered out. A hit means you
    are facing a wall, and res.Normal tells us which way to push into it.

  PERFORMANCE
    Assigning Velocity performs thousands of internal memory writes each
    time, so the write is throttled to about 30 Hz on a task.spawn loop. It
    is never done per RenderStepped. The raycast is cheap and runs on the
    same tick. RenderStepped is used only for the HUD text.

  No Instance.new anywhere - Instance does not exist in this VM at all.
  Stop with _G.WallWalk.stop() or by toggling off in the menu.
]]

local NAME    = 'WallWalk'
local VERSION = 'v2.0'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local CFG = {
    on    = false,
    climb = 34,     -- studs/s upward while W is held
    sink  = 22,     -- studs/s downward while S is held
    stick = 9,      -- studs/s pressed into the wall
    reach = 5,      -- forward ray length
    tick  = 0.033,  -- about 30 Hz
    keyW  = 0x57,
    keyS  = 0x53,
}

local UP      = Vector3.new(0, 1, 0)
local status  = 'off'
local wallHit = false

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

local function newParams(char)
    local ok, p = pcall(function() return RaycastParams.new() end)
    if not ok or not p then return nil end
    pcall(function() p.FilterDescendantsInstances = { char } end)
    pcall(function() p.FilterType = Enum.RaycastFilterType.Exclude end)
    pcall(function() p.FilterType = Enum.RaycastFilterType.Blacklist end)
    pcall(function() p.IgnoreWater = true end)
    return p
end

local function flatLook(cam)
    local l = cam.CFrame.LookVector
    local f = Vector3.new(l.X, 0, l.Z)
    if f.Magnitude < 1e-3 then return nil end
    return f.Unit
end

local params, paramsChar = nil, nil

-- main tick: raycast + throttled velocity write
task.spawn(function()
    while running do
        local char = lp.Character
        local hum  = char and char:FindFirstChild('Humanoid')
        local hrp  = char and char:FindFirstChild('HumanoidRootPart')
        local cam  = workspace.CurrentCamera

        wallHit = false

        if not CFG.on then
            status = 'off'
        elseif not char or not hum or not hrp then
            status = 'no character'
        elseif hum.Health <= 0 then
            status = 'dead'
        elseif not cam then
            status = 'no camera'
        else
            local dir = flatLook(cam)
            if not dir then
                status = 'camera straight up/down'
            else
                if paramsChar ~= char then
                    params = newParams(char)
                    paramsChar = char
                end

                local res = nil
                if params then
                    local ok, r = pcall(function()
                        return workspace:Raycast(hrp.Position, dir * CFG.reach, params)
                    end)
                    if ok then res = r end
                end

                if not res or not res.Normal then
                    status = 'no wall'
                else
                    local n  = res.Normal
                    local fn = Vector3.new(n.X, 0, n.Z)
                    if fn.Magnitude < 1e-3 then
                        status = 'wall normal is vertical'
                    else
                        fn = fn.Unit
                        wallHit = true
                        local climb = 0
                        if held(CFG.keyW) then
                            climb = CFG.climb
                        elseif held(CFG.keyS) then
                            climb = -CFG.sink
                        end
                        if climb ~= 0 then
                            local v = Vector3.new(-fn.X * CFG.stick, climb, -fn.Z * CFG.stick)
                            pcall(function() hrp.Velocity = v end)
                            status = string.format('climbing %+d', climb)
                        else
                            status = 'on wall - W up / S down'
                        end
                    end
                end
            end
        end

        task.wait(CFG.tick)
    end
end)

-- HUD: the only thing that runs per frame
local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    hud.Text = string.format('[%s] %s | wall %s', VERSION, status, tostring(wallHit))
end))

-- menu: exactly one toggle
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Wall Walk', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Wall Walk')
                if not sec then return end
                mkToggle(sec, 'Wall Climb', 'ww_on', CFG.on, function(v)
                    CFG.on = v
                    log('wall climb ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Wall Walk') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - toggle on, hold W at a wall')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Wall Walk', 3) end)
