--==================================================================
--  Clean Everything  |  Crossmap Pickup + Enemy Health Bars
--  Matcha LuaVM  -  built-in Matcha menu tab (UI.AddTab)
--
--  NO TELEPORTING. Every pickup is fired from where you stand:
--    ProximityPrompt -> fireproximityprompt(prompt)
--    ClickDetector   -> fireclickdetector(cd, 0, "MouseClick")
--
--  NAMING
--    ObjectText / ActionText read as nil in Matcha, and when the
--    game does expose them they hold the action word ("STORE"),
--    not the item. So the name comes from the floating label over
--    the item: the longest TextLabel that is not a prompt line
--    ("Press [E] to pick up", "STORE" are skipped).
--
--  GROUPING
--    Names are reduced to their base: "Chocolate Bar (Minty Moon)"
--    and "Chocolate Bar (Original)" both become "Chocolate Bar",
--    so ONE button fires every bar on the map. NPCs and bots that
--    carry a prompt are grouped the same way, under the model name.
--
--  HEALTH BARS
--    Matcha's built-in ESP does not render in this game, so the
--    bars here are pooled Drawing squares drawn in RenderStepped.
--    Every Humanoid except yours gets a background bar, a colour
--    -coded fill and the raw HP number above it.
--
--  MENU: Auto Pickup All, Pick Up Everything, Rescan World,
--        Show Enemy Health, and one button per discovered item.
--==================================================================
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")

local LP = Players.LocalPlayer

local VERSION       = "1.3.0"
local NAME          = "CleanEverything"
local MAX_BUTTONS   = 30
local SCAN_EVERY    = 2
local FIRE_COOLDOWN = 0.35

local HEALTH_POOL   = 48
local ENEMY_SCAN    = 0.75

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local running  = true
local conns    = {}
local drawings = {}

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    for i = 1, #drawings do
        pcall(function() drawings[i]:Remove() end)
    end
    drawings = {}
    print("[Clean Everything] stopped")
end

local Config = { AutoAll = false, ShowHealth = true }

local TOGGLES     = {}
local getterWorks = {}

local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local n = select("#", ...)
        for i = 1, n do
            local v = select(i, ...)
            if type(v) == "boolean" then
                Config[key] = v
                return
            end
        end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local v = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
    }
    for i = 1, #v do if pcall(v[i]) then return true end end
    warn("[Clean Everything] Toggle failed: " .. tostring(name))
    return false
end

local function safeButton(sec, name, id, cb)
    local v = {
        function() sec:Button(name, cb) end,
        function() sec:Button(name, id, cb) end,
        function() sec:Button(id, name, cb) end,
    }
    for i = 1, #v do if pcall(v[i]) then return true end end
    warn("[Clean Everything] Button failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

--------------------------------------------------------------------
-- NAMING
--------------------------------------------------------------------
local GENERIC = {
    Prompt = true, Prompts = true, ProximityPrompt = true,
    ClickDetector = true, Detector = true, Interact = true,
    Interactables = true, Interactions = true, Items = true, Item = true,
    Folder = true, Folders = true, Part = true, Model = true,
    MeshPart = true, Union = true, UnionOperation = true, Wedge = true,
    Hitbox = true, Click = true, Pickup = true, PickUp = true,
    Pickups = true, Collect = true, Collectable = true, Collectible = true,
    Spawn = true, Spawner = true, Decoration = true, Decor = true,
    Handle = true, Main = true, Root = true, Base = true,
    BillboardGui = true, SurfaceGui = true, TextLabel = true,
    Store = true, STORE = true, Shop = true, Buy = true,
    NPC = true, Npc = true, Bot = true, Enemy = true,
}

local function readProp(inst, prop)
    local ok, v = pcall(function() return inst[prop] end)
    if ok then return v end
    return nil
end

local function cleanName(v)
    if type(v) ~= "string" then return nil end
    v = v:gsub("^%s+", "")
    v = v:gsub("%s+$", "")
    if v == "" then return nil end
    return v
end

local function isPromptText(s)
    local low = s:lower()
    if low == "store" or low == "shop" or low == "buy" then return true end
    if low:find("press", 1, true) then return true end
    if low:find("pick up", 1, true) then return true end
    if low:find("pickup", 1, true) then return true end
    if low:find("to open", 1, true) then return true end
    if low:find("to use", 1, true) then return true end
    if low:find("to equip", 1, true) then return true end
    if low:find("to talk", 1, true) then return true end
    if low:find("to interact", 1, true) then return true end
    return false
end

local function meaningful(v)
    local s = cleanName(v)
    if not s then return nil end
    if GENERIC[s] then return nil end
    if s:match("^%d+$") then return nil end
    if isPromptText(s) then return nil end
    return s
end

-- "Chocolate Bar (Minty Moon)" -> "Chocolate Bar"
local function baseName(s)
    if type(s) ~= "string" then return s end
    local b = s:gsub("%b()", "")
    b = b:gsub("%b[]", "")
    b = b:gsub("%s*[%-:|].*$", "")
    b = b:gsub("%s+", " ")
    b = b:gsub("^%s+", "")
    b = b:gsub("%s+$", "")
    if b == "" then return s end
    return b
end

local function labelName(node)
    local ok, kids = pcall(function() return node:GetDescendants() end)
    if not ok or type(kids) ~= "table" then return nil end
    local n = #kids
    if n > 80 then n = 80 end
    local best = nil
    for i = 1, n do
        local d = kids[i]
        if d.ClassName == "TextLabel" then
            local t = meaningful(readProp(d, "Text"))
            if t and (best == nil or #t > #best) then best = t end
        end
    end
    return best
end

local function nameFor(inst)
    local node    = inst.Parent
    local depth   = 0
    local nearest = nil

    while node and node ~= Workspace and depth < 6 do
        local lbl = labelName(node)
        if lbl then return baseName(lbl) end

        local n = meaningful(readProp(node, "Name"))
        if n then
            if node.ClassName == "Model" then return baseName(n) end
            if nearest == nil then nearest = n end
        end
        node  = node.Parent
        depth = depth + 1
    end

    local obj = meaningful(readProp(inst, "ObjectText"))
    if obj then return baseName(obj) end
    if nearest then return baseName(nearest) end
    local own = meaningful(readProp(inst, "Name"))
    if own then return baseName(own) end
    return "Item"
end

--------------------------------------------------------------------
-- SCAN
--------------------------------------------------------------------
local groups     = {}
local groupOrder = {}
local lastFired  = {}

local function scan()
    local ok, list = pcall(function() return Workspace:GetDescendants() end)
    if not ok or type(list) ~= "table" then return end

    local fresh = {}
    local order = {}
    local seen  = {}

    for i = 1, #list do
        local inst = list[i]
        local cn   = inst.ClassName
        local kind = nil
        if cn == "ProximityPrompt" then
            kind = "prompt"
        elseif cn == "ClickDetector" then
            kind = "click"
        end

        if kind then
            local key = nameFor(inst)
            local g   = fresh[key]
            if not g then
                g = { name = key, entries = {} }
                fresh[key] = g
                order[#order + 1] = key
            end
            if not seen[inst] then
                seen[inst] = true
                g.entries[#g.entries + 1] = { inst = inst, kind = kind }
            end
        end
    end

    table.sort(order, function(a, b) return a < b end)

    groups     = fresh
    groupOrder = order
end

--------------------------------------------------------------------
-- FIRE
--------------------------------------------------------------------
local warnedPrompt = false
local warnedClick  = false

local function fireEntry(e)
    if not e or not e.inst then return false end

    local now  = os.clock()
    local last = lastFired[e.inst]
    if last and (now - last) < FIRE_COOLDOWN then return false end

    if e.kind == "prompt" then
        if type(fireproximityprompt) ~= "function" then
            if not warnedPrompt then
                warnedPrompt = true
                print("[Clean Everything] fireproximityprompt missing - re-run the Matcha loader (Pro)")
            end
            return false
        end
        lastFired[e.inst] = now
        pcall(fireproximityprompt, e.inst)
        return true
    end

    if type(fireclickdetector) ~= "function" then
        if not warnedClick then
            warnedClick = true
            print("[Clean Everything] fireclickdetector missing - re-run the Matcha loader (Pro)")
        end
        return false
    end
    lastFired[e.inst] = now
    pcall(fireclickdetector, e.inst, 0, "MouseClick")
    return true
end

local function fireGroup(key)
    local g = groups[key]
    if not g then return 0 end
    local n = 0
    for i = 1, #g.entries do
        if fireEntry(g.entries[i]) then n = n + 1 end
    end
    return n
end

local function fireAll()
    local n = 0
    for i = 1, #groupOrder do
        n = n + fireGroup(groupOrder[i])
    end
    return n
end

local function printList()
    local parts = {}
    for i = 1, #groupOrder do
        local g = groups[groupOrder[i]]
        if g then
            parts[#parts + 1] = g.name .. " (" .. tostring(#g.entries) .. ")"
        end
    end
    local msg = "none"
    if #parts > 0 then msg = table.concat(parts, ", ") end
    print("[Clean Everything] items: " .. msg)
end

--------------------------------------------------------------------
-- ENEMY HEALTH BARS
--------------------------------------------------------------------
local healthBars = {}
for i = 1, HEALTH_POOL do
    local bg = Drawing.new("Square")
    bg.Filled    = true
    bg.Thickness = 1
    bg.Visible   = false

    local fill = Drawing.new("Square")
    fill.Filled    = true
    fill.Thickness = 1
    fill.Visible   = false

    local tag = Drawing.new("Text")
    tag.Size    = 11
    tag.Center  = true
    tag.Outline = true
    tag.Visible = false

    healthBars[i] = { bg = bg, fill = fill, tag = tag }
    drawings[#drawings + 1] = bg
    drawings[#drawings + 1] = fill
    drawings[#drawings + 1] = tag
end

local enemies = {}

task.spawn(function()
    while running do
        local ok, list = pcall(function() return Workspace:GetDescendants() end)
        if ok and type(list) == "table" then
            local out = {}
            for i = 1, #list do
                local inst = list[i]
                if inst.ClassName == "Humanoid" then
                    local model = inst.Parent
                    if model and model ~= LP.Character then
                        local root = model:FindFirstChild("HumanoidRootPart")
                        if root then
                            out[#out + 1] = { model = model, hum = inst, root = root }
                        end
                    end
                end
            end
            enemies = out
        end
        task.wait(ENEMY_SCAN)
    end
end)

local renderConn = RunService.RenderStepped:Connect(function()
    local idx = 0
    if Config.ShowHealth then
        local list = enemies
        for i = 1, #list do
            if idx >= HEALTH_POOL then break end
            local e   = list[i]
            local hum = e.hum
            local health    = hum.Health
            local maxHealth = hum.MaxHealth
            if health and maxHealth and health > 0 and maxHealth > 0 then
                local pos = e.root.Position + Vector3.new(0, 3.2, 0)
                local screen, onScreen = WorldToScreen(pos)
                if onScreen and screen then
                    idx = idx + 1
                    local bar  = healthBars[idx]
                    local barW = 44
                    local barH = 4
                    local x    = screen.X - barW * 0.5
                    local y    = screen.Y

                    bar.bg.Position = Vector2.new(x, y)
                    bar.bg.Size     = Vector2.new(barW, barH)
                    bar.bg.Color    = Color3.fromRGB(20, 20, 20)
                    bar.bg.Visible  = true

                    local frac = health / maxHealth
                    if frac < 0 then frac = 0 end
                    if frac > 1 then frac = 1 end

                    local col
                    if frac > 0.5 then
                        col = Color3.fromRGB(80, 220, 100)
                    elseif frac > 0.25 then
                        col = Color3.fromRGB(240, 200, 60)
                    else
                        col = Color3.fromRGB(230, 70, 70)
                    end

                    bar.fill.Position = Vector2.new(x, y)
                    bar.fill.Size     = Vector2.new(barW * frac, barH)
                    bar.fill.Color    = col
                    bar.fill.Visible  = true

                    bar.tag.Text     = tostring(math.floor(health))
                    bar.tag.Position = Vector2.new(screen.X, y - 13)
                    bar.tag.Color    = col
                    bar.tag.Visible  = true
                end
            end
        end
    end
    for i = idx + 1, HEALTH_POOL do
        local bar = healthBars[i]
        bar.bg.Visible   = false
        bar.fill.Visible = false
        bar.tag.Visible  = false
    end
end)
conns[#conns + 1] = renderConn

--------------------------------------------------------------------
-- MENU
--------------------------------------------------------------------
local tabBuilt      = false
local firstScanDone = false

local function buildTab(tab)
    if tabBuilt then return end
    if not firstScanDone then return end
    if type(tab) ~= "table" then return end
    tabBuilt = true

    pcall(function()
        local secA = makeSection(tab, "Auto", "Left")
        if secA then
            if safeToggle(secA, "Auto Pickup All", "ce_auto_all", false, applyBool("AutoAll")) then
                registerToggle("AutoAll", "ce_auto_all", "Auto Pickup All")
            end
            safeButton(secA, "Pick Up Everything Now", "ce_pick_all", function()
                local n = fireAll()
                print("[Clean Everything] fired " .. tostring(n) .. " pickups")
            end)
            safeButton(secA, "Rescan World", "ce_rescan", function()
                scan()
                printList()
            end)
        end

        local secH = makeSection(tab, "Health", "Left")
        if secH then
            if safeToggle(secH, "Show Enemy Health", "ce_health", true, applyBool("ShowHealth")) then
                registerToggle("ShowHealth", "ce_health", "Show Enemy Health")
            end
        end

        local secI = makeSection(tab, "Items", "Right")
        if secI then
            local shown = 0
            for i = 1, #groupOrder do
                if shown >= MAX_BUTTONS then break end
                local key = groupOrder[i]
                local g   = groups[key]
                if g and #g.entries > 0 then
                    shown = shown + 1
                    local id    = "ce_item_" .. tostring(shown)
                    local label = key .. "  x" .. tostring(#g.entries)
                    safeButton(secI, label, id, function()
                        local n = fireGroup(key)
                        print("[Clean Everything] " .. key .. " -> " .. tostring(n))
                    end)
                end
            end
            if shown == 0 then
                safeButton(secI, "No prompts found - press Rescan", "ce_item_none", function()
                    scan()
                    printList()
                end)
            end
        end
    end)
end

pcall(function()
    UI.AddTab("Clean Everything", function(tab) buildTab(tab) end)
end)

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t   = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[Clean Everything] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(0.1)
    end
end)

--------------------------------------------------------------------
-- SCAN LOOP
--------------------------------------------------------------------
task.spawn(function()
    local started = os.clock()
    while running do
        scan()
        if not firstScanDone then
            if #groupOrder > 0 or (os.clock() - started) > 8 then
                firstScanDone = true
                printList()
            end
        end
        task.wait(SCAN_EVERY)
    end
end)

--------------------------------------------------------------------
-- AUTO LOOP
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoAll then
            fireAll()
        end
        task.wait(0.2)
    end
end)

