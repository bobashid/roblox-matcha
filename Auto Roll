-- Auto Roll
-- Version: 2.1.0
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Auto%20Roll",true))()

local VERSION = "2.1.0"
print("[Auto Roll] v" .. VERSION)

if _G.AutoRoll and _G.AutoRoll.stop then
    pcall(_G.AutoRoll.stop)
end

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local CONFIG = {
    Key         = Enum.KeyCode.E,
    ClickPrompt = true,   -- click the game's ProximityPrompts UI
    KeyFallback = true,   -- also hold the prompt key
    DoRoll      = true,
    DoBuy       = true,
    MoveToRoll  = true,
    MoveToBuy   = true,
    Range       = 8,
    PromptWait  = 2.0,
    RollWait    = 1.0,
    BuyWait     = 1.0,
    WalkTimeout = 5,
    StopAfter   = 0,
}

local running = true
local conns = {}

local function stop()
    running = false
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}
    pcall(function() setrobloxinput(CONFIG.Key, false) end)
end

_G.AutoRoll = { stop = stop, version = VERSION }

local function getChar()
    local c = lp.Character
    return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function dist(a, b)
    return (a - b).Magnitude
end

local function nearestCategory()
    local _, root = getChar()
    if not root then return nil end
    local g = workspace:FindFirstChild("Game")
    local lobby = g and g:FindFirstChild("Lobby")
    local plots = lobby and lobby:FindFirstChild("Plots")
    if not plots then return nil end
    local best, bestD = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        local rolls = plot:FindFirstChild("Rolls")
        if rolls then
            for _, cat in ipairs(rolls:GetChildren()) do
                local roll = cat:FindFirstChild("Roll")
                if roll then
                    local d = dist(root.Position, roll.Position)
                    if d < bestD then bestD = d; best = cat end
                end
            end
        end
    end
    return best
end

local function inRange(pos)
    local _, root = getChar()
    return root ~= nil and dist(root.Position, pos) <= CONFIG.Range
end

local function walkTo(pos, timeout)
    local _, root, hum = getChar()
    if not (root and hum) then return false end
    pcall(function() hum.WalkToPoint = pos end)
    local t0 = tick()
    while tick() - t0 < timeout and running do
        _, root, hum = getChar()
        if not (root and hum) then return false end
        if dist(root.Position, pos) <= CONFIG.Range * 0.6 then
            pcall(function() hum.WalkToPoint = root.Position end)
            return true
        end
        task.wait(0.1)
    end
    _, root, hum = getChar()
    if root and hum then pcall(function() hum.WalkToPoint = root.Position end) end
    return false
end

-- Click the game's own proximity prompt UI (PlayerGui.ProximityPrompts).
local function clickPromptUI()
    if not CONFIG.ClickPrompt then return false end
    local pg = lp:FindFirstChild("PlayerGui")
    local sp = pg and pg:FindFirstChild("ProximityPrompts")
    if not sp then return false end

    local target = nil
    for _, d in ipairs(sp:GetDescendants()) do
        local ap = d.AbsolutePosition
        local as = d.AbsoluteSize
        if ap and as and as.X > 4 and as.Y > 4 then
            local cls = d.ClassName
            if cls == "ImageButton" or cls == "TextButton" then
                target = d
                break
            elseif not target and (cls == "ImageLabel" or cls == "Frame" or cls == "TextLabel") then
                target = d
            end
        end
    end
    if not target then return false end

    local ap = target.AbsolutePosition
    local as = target.AbsoluteSize
    local x = ap.X + as.X * 0.5
    local y = ap.Y + as.Y * 0.5
    pcall(function() mousemoveabs(x, y) end)
    task.wait(0.05)
    pcall(function() mouse1press() end)
    task.wait(0.12)
    pcall(function() mouse1release() end)
    return true
end

local function holdKey()
    if not CONFIG.KeyFallback then return end
    pcall(function() setrobloxinput(CONFIG.Key, true) end)
end

local function releaseKey()
    pcall(function() setrobloxinput(CONFIG.Key, false) end)
end

-- Hold the key and click the prompt UI until it goes away or times out.
local function activatePrompt()
    holdKey()
    local t0 = tick()
    local clicked = false
    while running and tick() - t0 < CONFIG.PromptWait do
        if clickPromptUI() then clicked = true end
        task.wait(0.15)
    end
    releaseKey()
    return clicked
end

task.spawn(function()
    local cycles = 0
    while running do
        local cat = nearestCategory()
        if cat then
            local roll = cat:FindFirstChild("Roll")
            local ip   = cat:FindFirstChild("ItemPlace")

            if CONFIG.DoRoll and roll then
                if not inRange(roll.Position) and CONFIG.MoveToRoll then
                    walkTo(roll.Position, CONFIG.WalkTimeout)
                end
                if inRange(roll.Position) then
                    activatePrompt()
                end
                task.wait(CONFIG.RollWait)
            end

            if CONFIG.DoBuy and ip and running then
                if not inRange(ip.Position) and CONFIG.MoveToBuy then
                    walkTo(ip.Position, CONFIG.WalkTimeout)
                end
                if inRange(ip.Position) then
                    activatePrompt()
                end
                task.wait(CONFIG.BuyWait)
            end
        end

        cycles = cycles + 1
        if CONFIG.StopAfter > 0 and cycles >= CONFIG.StopAfter then break end
        task.wait(0.15)
    end
    stop()
end)

print("[Auto Roll] running. Stop with: _G.AutoRoll.stop()")
