-- Auto Roll
-- Version: 2.0.0
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Auto%20Roll",true))()

local VERSION = "2.0.0"
print("[Auto Roll] v" .. VERSION)

if _G.AutoRoll and _G.AutoRoll.stop then
    pcall(_G.AutoRoll.stop)
end

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local CONFIG = {
    Key         = Enum.KeyCode.E,
    HoldTime    = 0.9,
    RollWait    = 1.2,
    BuyWait     = 1.2,
    DoRoll      = true,
    DoBuy       = true,
    ClickPrompt = true,
    KeyFallback = true,
    MoveToRoll  = true,
    MoveToBuy   = true,
    WalkTimeout = 5,
    StopAfter   = 0,
}

local running = true
local conns = {}

local function stop()
    running = false
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}
    pcall(function() setrobloxinput(CONFIG.Key, false) end)
end

_G.AutoRoll = { stop = stop, version = VERSION }

local function getChar()
    local c = lp.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    return c, root, hum
end

local function dist(a, b)
    return (a - b).Magnitude
end

local function nearestPlot()
    local _, root = getChar()
    if not root then return nil end
    local g = workspace:FindFirstChild("Game")
    local lobby = g and g:FindFirstChild("Lobby")
    local plots = lobby and lobby:FindFirstChild("Plots")
    if not plots then return nil end
    local best, bestD = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        local rolls = plot:FindFirstChild("Rolls")
        if rolls then
            for _, cat in ipairs(rolls:GetChildren()) do
                local roll = cat:FindFirstChild("Roll")
                if roll then
                    local d = dist(root.Position, roll.Position)
                    if d < bestD then bestD = d; best = cat end
                end
            end
        end
    end
    return best
end

local function walkTo(pos, timeout)
    local _, root, hum = getChar()
    if not (root and hum) then return false end
    pcall(function() hum.WalkToPoint = pos end)
    local t0 = tick()
    while tick() - t0 < timeout and running do
        _, root, hum = getChar()
        if not (root and hum) then return false end
        if dist(root.Position, pos) < 4 then
            pcall(function() hum.WalkToPoint = root.Position end)
            return true
        end
        task.wait(0.1)
    end
    local _, r2, h2 = getChar()
    if r2 and h2 then pcall(function() h2.WalkToPoint = r2.Position end) end
    return false
end

-- find a visible clickable GUI button by name under PlayerGui
local function findButton(names)
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local found = nil
    for _, d in ipairs(pg:GetDescendants()) do
        if names[d.Name] then
            local ap = d.AbsolutePosition
            local as = d.AbsoluteSize
            if ap and as and as.X > 0 and as.Y > 0 then
                found = d
                break
            end
        end
    end
    return found
end

local function clickGui(obj)
    if not obj then return false end
    local ap = obj.AbsolutePosition
    local as = obj.AbsoluteSize
    if not (ap and as) then return false end
    if as.X <= 0 or as.Y <= 0 then return false end
    local x = ap.X + as.X * 0.5
    local y = ap.Y + as.Y * 0.5
    pcall(function() mousemoveabs(x, y) end)
    task.wait(0.08)
    pcall(function() mouse1click() end)
    return true
end

local function holdKey()
    if not CONFIG.KeyFallback then return end
    pcall(function() setrobloxinput(CONFIG.Key, true) end)
    task.wait(CONFIG.HoldTime)
    pcall(function() setrobloxinput(CONFIG.Key, false) end)
end

local PROMPT_NAMES = { PromptFrame = true, Prompt = true, ProximityPrompt = true }
local ROLL_NAMES   = { ["ROLL"] = true, ["Roll button BG"] = true, ["ROLL Shadow"] = true, ["Roll IMG"] = true }
local BUY_NAMES    = { BuyAll = true, Buy = true, BuyButton = true }

local function activate(buttonNames, fallbackKey)
    if CONFIG.ClickPrompt then
        local b = findButton(buttonNames)
        if b and clickGui(b) then
            task.wait(0.2)
            return true
        end
    end
    if fallbackKey then holdKey() end
    return false
end

task.spawn(function()
    local cycles = 0
    while running do
        local cat = nearestPlot()
        if cat then
            local roll = cat:FindFirstChild("Roll")
            local ip   = cat:FindFirstChild("ItemPlace")

            if CONFIG.DoRoll and roll then
                if CONFIG.MoveToRoll then
                    local _, root = getChar()
                    if root and dist(root.Position, roll.Position) > 8 then
                        walkTo(roll.Position, CONFIG.WalkTimeout)
                    end
                end
                activate(ROLL_NAMES, true)
                task.wait(CONFIG.RollWait)
            end

            if CONFIG.DoBuy and ip and running then
                if CONFIG.MoveToBuy then
                    walkTo(ip.Position, CONFIG.WalkTimeout)
                end
                activate(PROMPT_NAMES, true)
                task.wait(0.25)
                activate(BUY_NAMES, true)
                task.wait(CONFIG.BuyWait)
            end
        end

        cycles = cycles + 1
        if CONFIG.StopAfter > 0 and cycles >= CONFIG.StopAfter then break end
        task.wait(0.15)
    end
    stop()
end)

print("[Auto Roll] running. Stop with: _G.AutoRoll.stop()")
