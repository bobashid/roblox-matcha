            end)
            safeButton(main, 'Collect One Dish', function()
                local ty = findTycoon()
                local ok, d = oneDish(ty)
                note('one dish: ' .. (ok and 'OK ' or 'FAIL ') .. tostring(d))
            end)
            safeButton(main, 'Collect Tips Now', function()
                local ty = findTycoon()
                local ok, d = takeTips(ty)
                note('tips: ' .. (ok and 'OK ' or 'FAIL ') .. tostring(d))
            end)
            safeButton(main, 'Report', function() report() end)
            safeButton(main, 'Stop', function() stop() end)
        end)
    end)
