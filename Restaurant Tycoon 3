                    note('seat idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Orders and (t - lastOrder) >= CONFIG.OrderEvery then
                lastOrder = t
                local ok, d = oneOrder(ty)
