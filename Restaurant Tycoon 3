-- Restaurant Tycoon 3 (place 119048529960596) - Matcha LuauVM
-- Version: 8.0.0 -- SERVE VIA THE GAME'S OWN INPUT PATH
--
-- WHY THIS BUILD EXISTS (decompile-confirmed 2026-10-27):
--
-- Source.Systems.Restaurant.Interactions.Interact(tycoon, promptData) does TWO things:
--     p18.Interacted:Fire(p19, p20)     -- LOCAL Signal -> GrabFood listens to THIS
--     v_u_13:FireServer(p19, p20)       -- the remote we captured
-- GrabFood.Init is `Interacted:Connect(...)`: it only fills GrabFood.Storage from the LOCAL
-- signal. So firing Interacted:FireServer from a script tells the SERVER something happened
-- but never runs GrabFood - Storage stays empty, IsHoldingFoodForNPC returns nil,
-- ServeFood.CompleteForNPC returns false, and EVERY TaskCompleted 'Serve' is refused.
-- That is why v6.4.0-v7.1.0 all failed at serve. The payload was never the problem.
--
-- And serving itself is NOT remotely reachable: ServeFood listens to Tasks.TaskInputReceived,
-- a Packets.Signal fired by Tasks:HandleInput, which runs from a mouse click raycast or a
-- speech-bubble click. Probe this turn: getgc('TaskInputReceived') returns 12 entries whose
-- values are STRINGS, and getgc() with no key returns 0 entries - so the Tasks table cannot be
-- found and the Signal cannot be fired. Route (b) is dead.
--
-- Route (a), the only one left, is what this build does:
--   1. GRAB  : fireproximityprompt on the prompt(s) under workspace.Temp. That goes through the
--              game's own Interact -> local signal -> GrabFood, so Storage fills and the task
--              becomes Serve. This is the ONLY way to get food into Storage.
--   2. SERVE : aim the camera at each customer's HumanoidRootPart, put the mouse at the centre
--              of the viewport and click. That is literally what the game's HandleInput raycast
--              expects, so GroupId/CustomerId come from the game itself, not from us.
--   3. UNSTICK: if a grab produced nothing servable, fire CancelGrabRequested so food is never
--              left welded to your hands.
--
-- UNVERIFIED: the click route depends on the camera staying aimed for one frame and on the
-- raycast hitting the customer model. It is the architecturally correct path, not a proven one.
-- Report prints promptEnabled so a disabled prompt (Customer Prompts setting off) is visible.
--
-- Everything else is unchanged from v7.1.0 and user-confirmed working: bills, tips, dishes,
-- orders, seating. Two call budgets (serve 8 / other 12 per 0.5 s). No test buttons.
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '8.0.0'
print('[Restaurant Tycoon 3] v' .. VERSION)

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players  = game:GetService('Players')
local RS       = game:GetService('ReplicatedStorage')
local lp       = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    Bills = true, Tips = true, Dishes = true, Orders = true, Seat = true, Serve = true,
    Gap = 0.15, TipsEvery = 2.0, BillEvery = 0.3, DishEvery = 0.3,
    OrderEvery = 0.5, SeatEvery = 0.2, ServeEvery = 0.6,
    OrderCooldown = 10.0, SeatCooldown = 2.0,
    MaxPerPass = 6, SeatTriesPerPass = 8, MaxPickupPrompts = 3,
    MaxServeClicks = 6,        -- customers clicked per pass
    AimSettle = 0.06,          -- wait after aiming before the click
    ServeBudget = 8, OtherBudget = 12,
}

local running = true
local stat = { bills=0, tips=0, dishes=0, orders=0, seats=0, serves=0,
               promptPicks=0, clicks=0, passes=0, skipped=0, unstuck=0,
               blockedServe=0, blockedOther=0 }
local lastTips, lastBill, lastDish, lastOrder, lastSeat, lastServe = 0,0,0,0,0,0
local bServe = { start = 0, count = 0 }
local bOther = { start = 0, count = 0 }
local orderIdx, seatIdx, tableIdx, serveIdx = 1,1,1,1
local orderAt, seatAt = {}, {}

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s) print('[RT3] ' .. tostring(s)) end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

local function allow(kind)
    local b = bOther
    local cap = CONFIG.OtherBudget
    if kind == 'serve' then b = bServe cap = CONFIG.ServeBudget end
    local t = nowT()
    if (t - b.start) >= 0.5 then b.start = t b.count = 0 end
    if b.count >= cap then
        if kind == 'serve' then stat.blockedServe = stat.blockedServe + 1
        else stat.blockedOther = stat.blockedOther + 1 end
        return false
    end
    b.count = b.count + 1
    return true
end

local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(kind, r, ...)
    if not r then return false, 'missing' end
    if not allow(kind) then return false, 'rate capped' end
    local a = packArgs(...)
    return (pcall(function() r:FireServer(unpackFn(a, 1, a.n)) end))
end

local EV = RS:FindFirstChild('Events')

local function folder(...)
    local node = EV
    if not node then return nil end
    for _, nm in ipairs({ ... }) do
        node = node:FindFirstChild(nm)
        if not node then return nil end
    end
    return node
end

local function remote(folderName, remoteName)
    local f = folderName and folder(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' or cn == 'RemoteFunction' then
                return c
            end
        end
    end
    return nil
end

local function interactedRemote()
    local f = folder('Restaurant', 'Interactions')
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == 'Interacted' then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

local function aPart(model)
    if not model then return nil end
    local pp
    pcall(function() pp = model.PrimaryPart end)
    if pp then
        local cn = pp.ClassName
        if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
            return pp
        end
    end
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            local cn = d.ClassName
            if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
                return d
            end
        end
    end
    return nil
end

local function surfaceList(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do out[#out + 1] = m end
    return out
end

local function surfacesWith(ty, childName)
    local out = {}
    for _, m in ipairs(surfaceList(ty)) do
        local has = false
        pcall(function() has = (m:FindFirstChild(childName) ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

local function billTargets(ty) return surfacesWith(ty, 'Bill') end
local function dishTargets(ty) return surfacesWith(ty, 'Trash') end

local function foodList(ty)
    local out = {}
    if not ty then return out end
    local objs = ty:FindFirstChild('Objects')
    if not objs then return out end
    local food = objs:FindFirstChild('Food') or objs:FindFirstChild('Foods')
    if not food then return out end
    for _, c in ipairs(food:GetChildren()) do out[#out + 1] = c end
    return out
end

local function customerList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        for _, c in ipairs(g:GetChildren()) do
            out[#out + 1] = { groupId = g.Name, customerId = c.Name, model = c }
        end
    end
    return out
end

local function groupList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        local n = 0
        for _, c in ipairs(g:GetChildren()) do n = n + 1 end
        if n > 0 then out[#out + 1] = g.Name end
    end
    return out
end

-- every ProximityPrompt under workspace.Temp. There is no per-dish prompt: only the group
-- (tray) pickup. The id in the name changes (140, 172, 176), so nothing is hardcoded.
local function servePrompts()
    local out = {}
    local temp = workspace:FindFirstChild('Temp')
    if not temp then return out end
    local ok, desc = pcall(function() return temp:GetDescendants() end)
    if not ok or not desc then return out end
    for _, d in ipairs(desc) do
        if d.ClassName == 'ProximityPrompt' then out[#out + 1] = d end
    end
    return out
end

local function rootPos()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local r = c:FindFirstChild('HumanoidRootPart')
    if not r then return nil end
    local p
    pcall(function() p = r.Position end)
    if typeof(p) == 'Vector3' then return p end
    return nil
end

local function tableFree(m)
    if not m or not m.Parent then return false end
    if m:FindFirstChild('Bill') then return false end
    if m:FindFirstChild('Trash') then return false end
    for _, att in ipairs({ 'Occupied', 'IsOccupied', 'InUse', 'Taken' }) do
        local v
        pcall(function() v = m:GetAttribute(att) end)
        if v then return false end
    end
    local ok, desc = pcall(function() return m:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            if d.ClassName == 'Seat' then
                local occ
                pcall(function() occ = d.Occupant end)
                if occ then return false end
            end
        end
    end
    return true
end

-- tables are T<n> only; K<n> are kitchen counters
local function freeTables(ty)
    local out = {}
    for _, m in ipairs(surfaceList(ty)) do
        if string.match(m.Name, '^T%d+$') and tableFree(m) then
            out[#out + 1] = m
        end
    end
    return out
end

-- ===== STEP 1: grab through the game's own prompt (fills GrabFood.Storage) =====
local function pickupViaPrompt()
    local prompts = servePrompts()
    if #prompts == 0 then return false, 'no prompt under workspace.Temp' end
    local fired, enabled = 0, 0
    for i = 1, math.min(#prompts, CONFIG.MaxPickupPrompts) do
        local p = prompts[i]
        local en = true
        pcall(function() en = p.Enabled end)
        if en then
            enabled = enabled + 1
            if allow('serve') then
                local ok = pcall(fireproximityprompt, p)
                if ok then fired = fired + 1 end
            end
        end
    end
    if fired > 0 then stat.promptPicks = stat.promptPicks + fired end
    if enabled == 0 then
        return false, 'all ' .. #prompts .. ' prompt(s) DISABLED (Customer Prompts setting?)'
    end
    return fired > 0, 'prompt x' .. fired .. '/' .. enabled .. ' enabled of ' .. #prompts
end

local function cancelGrab()
    local c = remote('Restaurant', 'CancelGrabRequested')
    if c then
        fire('serve', c)
        stat.unstuck = stat.unstuck + 1
    end
end

-- ===== STEP 2: serve by aiming the camera at a customer and clicking =====
local function camera()
    local cam
    pcall(function() cam = workspace.CurrentCamera end)
    return cam
end

local function aimAt(pos)
    local cam = camera()
    if not cam or typeof(pos) ~= 'Vector3' then return false end
    local eye
    pcall(function() eye = cam.CFrame.Position end)
    if typeof(eye) ~= 'Vector3' then return false end
    return (pcall(function() cam.CFrame = CFrame.lookAt(eye, pos) end))
end

local function clickCentre()
    local cam = camera()
    if not cam then return false end
    local vp
    pcall(function() vp = cam.ViewportSize end)
    if not vp then return false end
    local x, y = math.floor(vp.X / 2), math.floor(vp.Y / 2)
    pcall(function() mousemoveabs(x, y) end)
    local ok = pcall(mouse1click)
    if not ok then
        pcall(mouse1press)
        pcall(mouse1release)
    end
    return true
end

local function humanoidRoot(model)
    if not model then return nil end
    local r
    pcall(function() r = model:FindFirstChild('HumanoidRootPart') end)
    if not r then
        pcall(function() r = model:FindFirstChild('Head') end)
    end
    return r
end

local function serveByClick(entry)
    local model = entry and entry.model
    if not model then return false, 'no model' end
    local hrp = humanoidRoot(model)
    if not hrp then return false, 'no HumanoidRootPart' end
    local pos
    pcall(function() pos = hrp.Position end)
    if typeof(pos) ~= 'Vector3' then return false, 'no position' end

    -- Tasks.HandleInput rejects targets more than 32 studs horizontally or vertically away
    local origin = rootPos()
    if origin then
        local dx, dz, dy = pos.X - origin.X, pos.Z - origin.Z, pos.Y - origin.Y
        if (dx * dx + dz * dz) > 1024 or math.abs(dy) > 32 then
            return false, 'too far (dx2+dz2=' .. math.floor(dx * dx + dz * dz) .. ')'
        end
    end

    if not aimAt(pos) then return false, 'aim failed' end
    task.wait(CONFIG.AimSettle)
    if not clickCentre() then return false, 'click failed' end
    stat.clicks = stat.clicks + 1
    return true, 'clicked ' .. tostring(entry.groupId) .. ':' .. tostring(entry.customerId)
end

local function collectBill(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local part = aPart(model)
    if not part then
        stat.skipped = stat.skipped + 1
        return false, 'no BasePart under ' .. model.Name
    end
    local pos = Vector3.new(0, 0, 0)
    local okp, p = pcall(function() return part.Position end)
    if okp and typeof(p) == 'Vector3' then pos = p end
    local it = interactedRemote()
    if it then
        fire('other', it, ty, {
            Id = '1', ActionText = '', WorldPosition = pos,
            GamepadKeyCode = 1000, TemporaryPart = part, KeyboardKeyCode = 101,
            Range = 7.2, IsCustomerPrompt = true, Key = 'CollectBill',
            Model = model, Part = part, Prompt = 1,
            InteractionType = 'CollectBill', HoldDuration = 0,
        })
    end
    local ok, err = fire('other', tc, { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model })
    if ok then stat.bills = stat.bills + 1 end
    return ok, err
end

local function collectDish(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire('other', tc, { Tycoon = ty, Name = 'CollectDishes', FurnitureModel = model })
    if ok then stat.dishes = stat.dishes + 1 end
    return ok, err
end

local function takeOrder(ty, cust)
    if not ty or not cust then return false, 'missing customer' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire('other', tc, {
        CustomerId = cust.customerId, GroupId = cust.groupId,
        Tycoon = ty, Name = 'TakeOrder',
    })
    if ok then stat.orders = stat.orders + 1 end
    return ok, err
end

local function sendToTable(ty, groupId, table)
    if not ty or not groupId or not table then return false, 'missing group/table' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire('other', tc, {
        FurnitureModel = table, GroupId = groupId, Tycoon = ty, Name = 'SendToTable',
    })
    if ok then stat.seats = stat.seats + 1 end
    return ok, err
end

local function takeTips(ty)
    local tips = remote('Restaurant', 'TipsCollected')
    if not tips or not ty then return false, 'TipsCollected missing' end
    local ok, err = fire('other', tips, ty)
    if ok then stat.tips = stat.tips + 1 end
    return ok, err
end

local function oneBill(ty)
    local l = billTargets(ty)
    if #l == 0 then return false, 'no bills' end
    local n = 0
    for i = 1, math.min(#l, CONFIG.MaxPerPass) do
        if collectBill(ty, l[i]) then n = n + 1 end
    end
    return n > 0, 'bills ' .. n .. '/' .. #l
end

local function oneDish(ty)
    local l = dishTargets(ty)
    if #l == 0 then return false, 'no trash' end
    local n = 0
    for i = 1, math.min(#l, CONFIG.MaxPerPass) do
        if collectDish(ty, l[i]) then n = n + 1 end
    end
    return n > 0, 'dishes ' .. n .. '/' .. #l
end

local function oneOrder(ty)
    local l = customerList(ty)
    if #l == 0 then return false, 'no customers' end
    if orderIdx > #l then orderIdx = 1 end
    local t = nowT()
    local tried = 0
    for _ = 1, #l do
        local c = l[orderIdx]
        orderIdx = orderIdx + 1
        if orderIdx > #l then orderIdx = 1 end
        local key = tostring(c.groupId) .. ':' .. tostring(c.customerId)
        local last = orderAt[key]
        if not last or (t - last) >= CONFIG.OrderCooldown then
            orderAt[key] = t
            tried = tried + 1
            if takeOrder(ty, c) then
                return true, 'order ' .. tostring(c.groupId) .. ':' .. tostring(c.customerId)
            end
        end
    end
    return false, 'all on cooldown (' .. tried .. ' tried)'
end

-- spam (group, table) PAIRS; cooldown keyed on the pair so a busy table blocks nothing else
local function oneSeat(ty)
    local groups = groupList(ty)
    if #groups == 0 then return false, 'no customers' end
    local tables = freeTables(ty)
    if #tables == 0 then return false, 'no free TABLES' end
    local t = nowT()
    local done, detail, attempts = 0, '', 0
    for _ = 1, CONFIG.SeatTriesPerPass do
        if seatIdx > #groups then seatIdx = 1 end
        if tableIdx > #tables then tableIdx = 1 end
        local gid = groups[seatIdx]
        local table = tables[tableIdx]
        seatIdx = seatIdx + 1
        tableIdx = tableIdx + 1
        if gid and table then
            local key = tostring(gid) .. '>' .. table.Name
            local last = seatAt[key]
            if not last or (t - last) >= CONFIG.SeatCooldown then
                seatAt[key] = t
                attempts = attempts + 1
                local ok = sendToTable(ty, gid, table)
                detail = tostring(gid) .. '->' .. table.Name
                if ok then done = done + 1 end
            end
        end
    end
    if done == 0 then
        return false, 'no pair landed (' .. attempts .. ' tried, last ' .. detail .. ')'
    end
    return true, done .. ' seat(s), last ' .. detail
end

-- SERVE: grab via the prompt, then click each customer so the game's own HandleInput runs
local function oneServe(ty)
    local dishes = foodList(ty)
    if #dishes == 0 then return false, 'no dishes on counter' end
    local guests = customerList(ty)
    if #guests == 0 then return false, 'no customers' end

    local pok, pdetail = pickupViaPrompt()
    if not pok then
        -- a dish may already be in hand from an earlier pass; do not give up on serving
        pdetail = tostring(pdetail)
    end

    if serveIdx > #guests then serveIdx = 1 end
    local clicked, lastDetail = 0, ''
    for _ = 1, math.min(#guests, CONFIG.MaxServeClicks) do
        if serveIdx > #guests then serveIdx = 1 end
        local entry = guests[serveIdx]
        serveIdx = serveIdx + 1
        if entry then
            local ok, d = serveByClick(entry)
            lastDetail = tostring(d)
            if ok then clicked = clicked + 1 end
        end
    end

    if clicked == 0 then
        -- nothing was served: release the grab so food is never welded to the hands
        if pok then cancelGrab() end
        return false, pdetail .. ', no click landed (last ' .. lastDetail .. ')'
    end
    return true, pdetail .. ', clicked ' .. clicked .. ', last ' .. lastDetail
end

local function report()
    local ty = findTycoon()
    local food = ty and foodList(ty) or {}
    local cust = ty and customerList(ty) or {}
    local prompts = servePrompts()
    local tables = ty and freeTables(ty) or {}
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('bills=' .. #(ty and billTargets(ty) or {}) .. ' trash=' .. #(ty and dishTargets(ty) or {}))
    note('customers=' .. #cust .. ' foodOnCounter=' .. #food)
    note('freeTables=' .. #tables .. ' promptsUnderTemp=' .. #prompts)
    for i, p in ipairs(prompts) do
        if i <= 3 then
            local en, act, dist
            pcall(function() en = p.Enabled end)
            pcall(function() act = p.ActionText end)
            pcall(function() dist = p.MaxActivationDistance end)
            note('  prompt ' .. tostring(p.Name) .. ' enabled=' .. tostring(en) ..
                 ' act=' .. tostring(act) .. ' dist=' .. tostring(dist))
        end
    end
    note('promptPicks=' .. stat.promptPicks .. ' clicks=' .. stat.clicks ..
         ' unstuck=' .. stat.unstuck)
    note('serves=' .. stat.serves .. ' orders=' .. stat.orders .. ' seats=' .. stat.seats)
    note('bills=' .. stat.bills .. ' dishes=' .. stat.dishes .. ' tips=' .. stat.tips)
    note('blockedServe=' .. stat.blockedServe .. ' blockedOther=' .. stat.blockedOther)
    note('skippedNoPart=' .. stat.skipped .. ' passes=' .. stat.passes)
    note('--- end ---')
end

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

