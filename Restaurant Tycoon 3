-- Restaurant Tycoon 3 (place 119048529960596) - Matcha LuauVM
-- Version: 5.0.0 -- AUTO SERVE ONLY (user request 2026-10-27)
--
-- User report driving this build:
--   "i am picking the food up into my hand but not giving it to them also it bugs me so i
--    cant give it to them myself, also i only want auto serve toggle for now"
--
-- So this build does exactly one thing, and does it in one motion:
--   1. cancel any stuck grab on load (CancelGrabRequested) so your hands are clean
--   2. find a dish on the counter, GrabFood:InvokeServer(dish)
--   3. immediately TaskCompleted{Name='Serve', FoodModel=dish, CustomerId, GroupId}
--      for each guest currently in ClientCustomers - the game only accepts the dish that
--      guest ordered, so trying each guest is the matching step, not a guess at the ids.
--
-- Customer ids come from Tycoon.ClientCustomers: group FOLDER NAME = GroupId,
-- child MODEL NAME = CustomerId. Names are opaque strings - never validated with tonumber().
--
-- Known limit, observed in a live dump: dishes on the counter carry NO CustomerId/GroupId
-- (only EatMethod, Taken, Part:Head, UnionOperation:TestNewPlate, Model:Contents). So the
-- target can only come from the live guest list, never from the dish.
--
-- Upgrades excluded. No Instance.new. ClassName tests only (IsA always true in Matcha).
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '5.0.0'
print('[Restaurant Tycoon 3] v' .. VERSION .. ' (auto serve only)')

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    Serve = true,
    Gap   = 0.15,     -- loop tick
    ServeGap = 0.20,  -- min time between two serve attempts
    MaxGuests = 6,    -- try at most this many guests per dish
    MaxDishes = 2,    -- try at most this many dishes per pass
}

local running = true
local stat = { grabs = 0, served = 0, passes = 0 }
local lastServe = 0

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s)
    print('[RT3] ' .. s)
end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

-- varargs must be packed: `...` inside the pcall closure is a parse error
local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(remote, ...)
    if not remote then return false, 'missing' end
    local a = packArgs(...)
    local ok, err = pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end)
    return ok, err
end

local function invoke(remote, ...)
    if not remote then return false, 'missing', nil end
    local a = packArgs(...)
    local ok, x, y = pcall(function() return remote:InvokeServer(unpackFn(a, 1, a.n)) end)
    if ok then return true, x, y end
    return false, x, y
end

local EV = RS:FindFirstChild('Events')
local function remote(folderName, remoteName)
    if not EV then return nil end
    local f = folderName and EV:FindFirstChild(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' or cn == 'RemoteFunction' then
                return c
            end
        end
    end
    return f:FindFirstChild(remoteName)
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

-- guests currently inside: group folder name = GroupId, model name = CustomerId
local function guestList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        for _, c in ipairs(g:GetChildren()) do
            out[#out + 1] = { groupId = g.Name, customerId = c.Name }
        end
    end
    return out
end

local function dishList(ty)
    local out = {}
    if not ty then return out end
    local objs = ty:FindFirstChild('Objects')
    if not objs then return out end
    local food = objs:FindFirstChild('Food') or objs:FindFirstChild('Foods')
    if not food then return out end
    for _, c in ipairs(food:GetChildren()) do
        out[#out + 1] = c
    end
    return out
end

local function cancelGrab()
    local c = remote('Restaurant', 'CancelGrabRequested')
    if c then pcall(function() c:FireServer() end) end
end

-- grab one dish then offer it to each guest; the game accepts only the matching order
local function servePass(ty)
    local guests = guestList(ty)
    if #guests == 0 then return false, 'no guests present' end

    local dishes = dishList(ty)
    if #dishes == 0 then return false, 'no dishes on counter' end

    local gf = remote('Restaurant', 'GrabFood')
    local tc = remote('Restaurant', 'TaskCompleted')
    if not gf or not tc then return false, 'remote missing' end

    local servedAny = false
    local tried = 0

    for d = 1, math.min(#dishes, CONFIG.MaxDishes) do
        local dish = dishes[d]
        if dish and dish.Parent then
            local gok = invoke(gf, dish)
            if gok then
                stat.grabs = stat.grabs + 1
                for k = 1, math.min(#guests, CONFIG.MaxGuests) do
                    local t = nowT()
                    if (t - lastServe) >= CONFIG.ServeGap then
                        lastServe = t
                        local g = guests[k]
                        local ok = fire(tc, {
                            Name = 'Serve',
                            Tycoon = ty,
                            FoodModel = dish,
                            CustomerId = g.customerId,
                            GroupId = g.groupId,
                        })
                        tried = tried + 1
                        if ok then
                            servedAny = true
                            stat.served = stat.served + 1
                            note('serve attempt dish=' .. dish.Name .. ' guest=' .. g.groupId .. ':' .. g.customerId)
                        end
                    end
                end
                if servedAny then break end
            end
        end
    end

    if not servedAny then
        return false, 'grabbed but no serve fired (tried ' .. tried .. ', guests=' .. #guests .. ', dishes=' .. #dishes .. ')'
    end
    return true, 'served (tried ' .. tried .. ' guests)'
end

local function report()
    local ty = findTycoon()
    local guests = guestList(ty)
    local dishes = dishList(ty)
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('guests=' .. #guests .. ' dishes=' .. #dishes)
    for i, g in ipairs(guests) do
        if i <= 6 then note('  guest ' .. g.groupId .. ':' .. g.customerId) end
    end
    for i, d in ipairs(dishes) do
        if i <= 4 then note('  dish ' .. d.Name) end
    end
    note('grabs=' .. stat.grabs .. ' serves=' .. stat.served .. ' passes=' .. stat.passes)
    note('--- end ---')
end

-- menu: one toggle, as asked
local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Auto Serve', 'Left')
            safeToggle(main, 'rt3_serve', 'Auto Serve', CONFIG.Serve, function(v) CONFIG.Serve = v end)
            safeButton(main, 'Unstick My Hands', function()
                cancelGrab()
                note('cancel grab sent')
            end)
            safeButton(main, 'Report', function() report() end)
            safeButton(main, 'Stop', function() stop() end)
        end)
    end)
end

-- clear any stuck grab left by an earlier version before the loop starts
cancelGrab()
note('cleared grab state')

local function pollToggle()
    local ok, v = pcall(function() return UI.GetValue('rt3_serve') end)
    if not ok or type(v) ~= 'boolean' then
        ok, v = pcall(function() return UI.GetValue('Auto Serve') end)
    end
    if ok and type(v) == 'boolean' then CONFIG.Serve = v end
end

task.spawn(function()
    while running do
        pollToggle()
        task.wait(0.15)
    end
end)

task.spawn(function()
    local lastMsg, lastMsgT = '', 0
    while running do
        if CONFIG.Serve then
            stat.passes = stat.passes + 1
            local ty = findTycoon()
            if ty then
                local ok, why = servePass(ty)
                if not ok then
                    local t = nowT()
                    if why ~= lastMsg or (t - lastMsgT) > 8 then
                        note('idle: ' .. tostring(why))
                        lastMsg, lastMsgT = why, t
                    end
                end
            else
                local t = nowT()
                if (t - lastMsgT) > 8 then
                    note('idle: tycoon not found')
                    lastMsgT = t
                end
            end
        end
        task.wait(CONFIG.Gap)
    end
end)

note('loaded. Auto Serve is ON. Your hands are clean - it grabs and serves in one motion.')
print('[Restaurant Tycoon 3] running. Stop with: _G.RestaurantTycoon3.stop()')
