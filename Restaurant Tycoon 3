-- Restaurant Tycoon 3 (place 119048529960596) - Matcha LuauVM
-- Version: 2.0.0
-- Silent automation of the game's own entry points:
--   * grab food    -> Events.Restaurant.GrabFood:InvokeServer(foodModel)
--   * serve        -> fires the customer's own Dialog ProximityPrompt, so the game
--                     builds the task (incl. the Task enum we cannot read statically)
--   * grow all     -> GrowAllPrompt via fireproximityprompt
--   * ingredient   -> IngredientShopPrompt via fireproximityprompt
-- Money drops need nothing: the game auto-collects inside 7+SizeModifier studs.
-- Upgrades are deliberately NOT touched.
-- No teleports, no Drawing, no notifications.
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '2.0.0'
print('[Restaurant Tycoon 3] v' .. VERSION)

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local CONFIG = {
    Grab      = true,
    Serve     = true,
    Grow      = true,
    Shop      = true,
    Cycle     = 0.35,
    MaxHeld   = 3,
    ServeEach = 2,
    GrowEvery = 6,
    ShopEvery = 40,
}

local running   = true
local conns     = {}
local toggles   = {}
local cd        = {}
local held      = 0
local cycles    = 0

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }

local function ev(folder, name)
    local ok, r = pcall(function()
        local f = RS:FindFirstChild('Events')
        f = f and f:FindFirstChild(folder)
        return f and f:FindFirstChild(name)
    end)
    if ok then return r end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        local ov = p:FindFirstChild('Player')
        if ov then
            local v
            pcall(function() v = ov.Value end)
            if v == lp then return p end
        end
    end
    return nil
end

local function rootPos()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local r = c:FindFirstChild('HumanoidRootPart')
    if not r then return nil end
    local p
    pcall(function() p = r.Position end)
    if typeof(p) == 'Vector3' then return p end
    return nil
end

local function foodList(ty)
    local out = {}
    if not ty then return out end
    local objs = ty:FindFirstChild('Objects')
    local food = objs and objs:FindFirstChild('Food')
    if not food then return out end
    for _, c in ipairs(food:GetChildren()) do
        local taken
        pcall(function() taken = c:GetAttribute('Taken') end)
        if not taken then out[#out + 1] = c end
    end
    return out
end

local function tryGrab(model)
    local gf = ev('Restaurant', 'GrabFood')
    if not gf or not model then return false end
    local ok, res = pcall(function() return gf:InvokeServer(model) end)
    if not ok then return false end
    if res == true or type(res) == 'table' then return true end
    return false
end

local function tryCancel()
    local c = ev('Restaurant', 'CancelGrabRequested')
    if c then pcall(function() c:FireServer() end) end
end

local function promptReady(p, gap)
    local t = nowT()
    local last = cd[p]
    if last and (t - last) < gap then return false end
    cd[p] = t
    return true
end

local function promptsNamed(want)
    local out = {}
    local ok, desc = pcall(function() return workspace:GetDescendants() end)
    if not ok or not desc then return out end
    for i = 1, #desc do
        local d = desc[i]
        if d.ClassName == 'ProximityPrompt' and d.Name == want then
            out[#out + 1] = d
        end
    end
    return out
end

local function firePrompt(p)
    if not p then return false end
    return (pcall(fireproximityprompt, p))
end

local function safeToggle(sec, id, label, default, cb)
    local variants = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeSlider(sec, id, label, min, max, default, cb)
    local variants = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    local variants = {
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function reg(id, label, key)
    toggles[#toggles + 1] = { id = id, name = label, key = key }
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Automation', 'Left')
            safeToggle(main, 'rt3_grab', 'Auto Grab Food', CONFIG.Grab, function(v) CONFIG.Grab = v end)
            reg('rt3_grab', 'Auto Grab Food', 'Grab')
            safeToggle(main, 'rt3_serve', 'Auto Serve', CONFIG.Serve, function(v) CONFIG.Serve = v end)
            reg('rt3_serve', 'Auto Serve', 'Serve')
            safeToggle(main, 'rt3_grow', 'Auto Grow All', CONFIG.Grow, function(v) CONFIG.Grow = v end)
            reg('rt3_grow', 'Auto Grow All', 'Grow')
            safeToggle(main, 'rt3_shop', 'Auto Ingredient Shop', CONFIG.Shop, function(v) CONFIG.Shop = v end)
            reg('rt3_shop', 'Auto Ingredient Shop', 'Shop')

            local tune = tab:Section('Tuning', 'Right')
            safeSlider(tune, 'rt3_held', 'Max Held', 1, 4, CONFIG.MaxHeld, function(v) CONFIG.MaxHeld = v end)
            safeSlider(tune, 'rt3_serve_each', 'Serve Prompts / Cycle', 1, 6, CONFIG.ServeEach, function(v) CONFIG.ServeEach = v end)
            safeSlider(tune, 'rt3_grow_every', 'Grow Every (cycles)', 2, 40, CONFIG.GrowEvery, function(v) CONFIG.GrowEvery = v end)
            safeButton(tune, 'Drop Held Food', function() tryCancel() held = 0 end)
            safeButton(tune, 'Stop', function() stop() end)
        end)
    end)
end

task.spawn(function()
    while running do
        for i = 1, #toggles do
            local t = toggles[i]
            local ok, v = pcall(function() return UI.GetValue(t.id) end)
            if not ok or type(v) ~= 'boolean' then
                ok, v = pcall(function() return UI.GetValue(t.name) end)
            end
            if ok and type(v) == 'boolean' then
                CONFIG[t.key] = v
            end
        end
        task.wait(0.15)
    end
end)

task.spawn(function()
    local growList = {}
    local shopList = {}
    while running do
        cycles = cycles + 1
        local ty = findTycoon()

        if CONFIG.Grab and ty and held < CONFIG.MaxHeld then
            local list = foodList(ty)
            if #list > 0 then
                if tryGrab(list[1]) then
                    held = held + 1
                else
                    held = 0
                end
            end
        end

        if CONFIG.Serve then
            if #growList == 0 and (cycles % 10) == 0 then
                growList = promptsNamed('GrowAllPrompt')
            end
            local served = 0
            local ok, desc = pcall(function() return workspace:GetDescendants() end)
            if ok and desc then
                for i = 1, #desc do
                    if served >= CONFIG.ServeEach then break end
                    local d = desc[i]
                    if d.ClassName == 'ProximityPrompt' and d.Name == 'Dialog' then
                        if promptReady(d, 2.0) then
                            if firePrompt(d) then
                                served = served + 1
                                if held > 0 then held = held - 1 end
                            end
                        end
                    end
                end
            end
        end

        if CONFIG.Grow and (cycles % CONFIG.GrowEvery) == 0 then
            if #growList == 0 then growList = promptsNamed('GrowAllPrompt') end
            for i = 1, #growList do
                if promptReady(growList[i], 3.0) then firePrompt(growList[i]) end
            end
        end

        if CONFIG.Shop and (cycles % CONFIG.ShopEvery) == 0 then
            shopList = promptsNamed('IngredientShopPrompt')
            for i = 1, #shopList do
                if promptReady(shopList[i], 5.0) then firePrompt(shopList[i]) end
            end
        end

        task.wait(CONFIG.Cycle)
    end
end)

print('[Restaurant Tycoon 3] running. Stop with: _G.RestaurantTycoon3.stop()')
