-- v6.0.1 is CONFIRMED WORKING by the user (2026-10-27): "nice everything there works".
-- This build keeps every v6.0.1 fix untouched and adds one thing: auto dish pickup.
--
-- User-captured dish payload (2026-10-27):
--   TaskCompleted:FireServer({Tycoon=tycoon, Name="CollectDishes",
--                             FurnitureModel=Items.Surface.T19})
-- NOTE the shape difference from bills:
--   * bill  = Interactions.Interacted  THEN TaskCompleted 'CollectBill'
--   * dish  = TaskCompleted 'CollectDishes' ONLY - no interaction call
--   * target is the Items.Surface model that holds a `Trash` child (same model shape
--     as a bill's `Bill` child), NOT the Trash itself and NOT Objects.Food.
--
-- v6.0.1 fixes still in force (do not regress):
--   1. `Interacted` lives INSIDE the Restaurant.Interactions FOLDER (probed: X2 Folder,
--      X3 RemoteEvent Interacted). Resolving the folder and firing it was the v6.0.0 crash path.
--   2. BaseParts are found by ClassName only - FindFirstChildWhichIsA is unreliable here
--      because IsA always returns true. A target with no findable part is SKIPPED, not sent.
--   3. Token bucket caps outgoing calls (8 per 0.5 s) and only ONE target is collected per
--      pass per feature.
--   4. No task.wait inside collection; the loop yields between passes only.
--
-- Upgrades excluded. No Instance.new. ClassName tests only.
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '6.1.0'
print('[Restaurant Tycoon 3] v' .. VERSION .. ' (money + dishes)')

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    Bills  = true,
    Tips   = true,
    Dishes = true,
    Gap       = 0.5,
    TipsEvery = 2.0,
    BillEvery = 0.8,
    DishEvery = 0.8,
    MaxPerHalf = 8,
}

local running = true
local stat = { bills = 0, tips = 0, dishes = 0, passes = 0, skipped = 0, blocked = 0 }
local lastTips, lastBill, lastDish = 0, 0, 0
local windowStart, windowCount = 0, 0

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s) print('[RT3] ' .. s) end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

-- token bucket (v6.0.1)
local function allow()
    local t = nowT()
    if (t - windowStart) >= 0.5 then
        windowStart = t
        windowCount = 0
    end
    if windowCount >= CONFIG.MaxPerHalf then
        stat.blocked = stat.blocked + 1
        return false
    end
    windowCount = windowCount + 1
    return true
end

local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(remote, ...)
    if not remote then return false, 'missing' end
    if not allow() then return false, 'rate capped' end
    local a = packArgs(...)
    local ok, err = pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end)
    return ok, err
end

local EV = RS:FindFirstChild('Events')
local function folder(...)
    local node = EV
    if not node then return nil end
    for _, name in ipairs({ ... }) do
        node = node:FindFirstChild(name)
        if not node then return nil end
    end
    return node
end

local function remote(folderName, remoteName)
    local f = folderName and folder(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

-- v6.0.1 fix: Interacted is a child of the Interactions FOLDER
local function interacted()
    local f = folder('Restaurant', 'Interactions')
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == 'Interacted' then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

-- v6.0.1 fix: ClassName only
local function aPart(model)
    if not model then return nil end
    local pp
    pcall(function() pp = model.PrimaryPart end)
    if pp then
        local cn = pp.ClassName
        if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
            return pp
        end
    end
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            local cn = d.ClassName
            if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
                return d
            end
        end
    end
    return nil
end

-- Surface models holding a given child name ('Bill' or 'Trash')
local function surfacesWith(ty, childName)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do
        local has = false
        pcall(function() has = (m:FindFirstChild(childName) ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

local function billTargets(ty) return surfacesWith(ty, 'Bill') end
local function dishTargets(ty) return surfacesWith(ty, 'Trash') end

-- BILL: captured two-call pair
local function collectBill(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end

    local part = aPart(model)
    if not part then
        stat.skipped = stat.skipped + 1
        return false, 'no BasePart under ' .. model.Name .. ' - skipped'
    end

    local pos = Vector3.new(0, 0, 0)
    local okp, p = pcall(function() return part.Position end)
    if okp and typeof(p) == 'Vector3' then pos = p end

    local it = interacted()
    if it then
        fire(it, ty, {
            Id = '1',
            ActionText = '',
            WorldPosition = pos,
            GamepadKeyCode = 1000,
            TemporaryPart = part,
            KeyboardKeyCode = 101,
            Range = 7.2,
            IsCustomerPrompt = true,
            Key = 'CollectBill',
            Model = model,
            Part = part,
            Prompt = 1,
            InteractionType = 'CollectBill',
            HoldDuration = 0,
        })
    end

    local ok, err = fire(tc, { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model })
    if ok then stat.bills = stat.bills + 1 end
    return ok, err
end

-- DISHES: user-captured single call, no Interacted
local function collectDish(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire(tc, { Tycoon = ty, Name = 'CollectDishes', FurnitureModel = model })
    if ok then stat.dishes = stat.dishes + 1 end
    return ok, err
end

local function takeTips(ty)
    local tips = remote('Restaurant', 'TipsCollected')
    if not tips or not ty then return false, 'TipsCollected missing' end
    local ok, err = fire(tips, ty)
    if ok then stat.tips = stat.tips + 1 end
    return ok, err
end

local function oneBill(ty)
    local list = billTargets(ty)
    if #list == 0 then return false, 'no bills' end
    return collectBill(ty, list[1])
end

local function oneDish(ty)
    local list = dishTargets(ty)
    if #list == 0 then return false, 'no trash' end
    return collectDish(ty, list[1])
end

local function report()
    local ty = findTycoon()
    local bills = ty and billTargets(ty) or {}
    local dishes = ty and dishTargets(ty) or {}
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('bills on tables=' .. #bills .. '  dishes on tables=' .. #dishes)
    for i, m in ipairs(bills) do
        if i <= 4 then
            local part = aPart(m)
            note('  bill ' .. m.Name .. ' part=' .. tostring(part and part.Name or 'NONE'))
        end
    end
    for i, m in ipairs(dishes) do
        if i <= 4 then note('  dish ' .. m.Name) end
    end
    note('remote Interacted=' .. tostring(interacted() ~= nil))
    note('remote TaskCompleted=' .. tostring(remote('Restaurant', 'TaskCompleted') ~= nil))
    note('remote TipsCollected=' .. tostring(remote('Restaurant', 'TipsCollected') ~= nil))
    note('bills=' .. stat.bills .. ' tips=' .. stat.tips .. ' dishes=' .. stat.dishes .. ' passes=' .. stat.passes)
    note('skippedNoPart=' .. stat.skipped .. ' rateBlocked=' .. stat.blocked)
    note('--- end ---')
end

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Auto Money', 'Left')
            safeToggle(main, 'rt3_bills', 'Auto Collect Bills', CONFIG.Bills, function(v) CONFIG.Bills = v end)
            safeToggle(main, 'rt3_tips', 'Auto Collect Tips', CONFIG.Tips, function(v) CONFIG.Tips = v end)
            safeToggle(main, 'rt3_dishes', 'Auto Pickup Dishes', CONFIG.Dishes, function(v) CONFIG.Dishes = v end)
            safeButton(main, 'Collect One Bill', function()
                local ty = findTycoon()
                local ok, d = oneBill(ty)
