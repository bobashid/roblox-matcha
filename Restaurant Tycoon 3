task.spawn(function()
    while running do
        for i = 1, #toggles do
            local t = toggles[i]
            local ok, v = pcall(function() return UI.GetValue(t.id) end)
            if not ok or type(v) ~= 'boolean' then
                ok, v = pcall(function() return UI.GetValue(t.name) end)
            end
            if ok and type(v) == 'boolean' then
                CONFIG[t.key] = v
            end
        end
        task.wait(0.15)
    end
end)

task.spawn(function()
    while running do
        local ty = findTycoon()
        local t = nowT()

        if CONFIG.Seat and ty and (t - tSeat) >= CONFIG.SeatGap then
            local guests = guestList(ty)
            local tables = tableList(ty)
            if #guests > 0 and #tables > 0 then
                if tableIdx > #tables then tableIdx = 1 end
                if seat(ty, guests[1], tables[tableIdx]) then
                    tSeat = t
                    tableIdx = tableIdx + 1
                end
            end
        end

        if CONFIG.Dish and ty and not held then
            local list = foodList(ty)
            if list[1] then
                if tryGrab(list[1]) then
                    held = list[1]
                    stat.grabs = stat.grabs + 1
                end
            end
        end

        if CONFIG.Serve and ty and held and (t - tServe) >= CONFIG.ServeGap then
            local guests = guestList(ty)
            if #guests > 0 then
                if guestIdx > #guests then guestIdx = 1 end
                local guest = guests[guestIdx]
                local cids = customersOf(guest)
                local cid = cids[1] or '1'
                guestIdx = guestIdx + 1
                if serve(ty, guest, cid, held) then
                    tServe = t
                    held = nil
                end
            end
        end

        if CONFIG.Bill and ty and (t - tBill) >= CONFIG.BillEvery then
            local b = billTargets(ty)
            if b[1] then
                if takeBill(ty, b[1]) then tBill = t end
            end
        end

        if CONFIG.Tips and ty and (t - tTips) >= CONFIG.TipsEvery then
            if takeTips(ty) then tTips = t end
        end

        task.wait(CONFIG.Cycle)
    end
end)

