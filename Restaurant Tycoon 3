local function pollToggle()
    local function getv(id, name)
        local ok, v = pcall(function() return UI.GetValue(id) end)
        if not ok or type(v) ~= 'boolean' then
            ok, v = pcall(function() return UI.GetValue(name) end)
        end
        if ok and type(v) == 'boolean' then return v end
        return nil
    end
    local s = getv('rt3_serve', 'Auto Serve Food') if s ~= nil then CONFIG.Serve = s end
    local st = getv('rt3_seat', 'Auto Seat Customers') if st ~= nil then CONFIG.Seat = st end
    local o = getv('rt3_orders', 'Auto Take Order') if o ~= nil then CONFIG.Orders = o end
    local b = getv('rt3_bills', 'Auto Collect Bills') if b ~= nil then CONFIG.Bills = b end
    local d = getv('rt3_dishes', 'Auto Pickup Dishes') if d ~= nil then CONFIG.Dishes = d end
    local t = getv('rt3_tips', 'Auto Collect Tips') if t ~= nil then CONFIG.Tips = t end
end

