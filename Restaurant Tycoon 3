-- Restaurant Tycoon 3 (place 119048529960596) - Matcha LuauVM
-- Version: 6.0.1 -- AUTO MONEY ONLY (bills + tips), SAFE RATE
--
-- v6.0.0 CRASHED THE USER'S GAME. Per the crash protocol this build adds NO features:
-- it removes the defects that could have caused it and hardens everything else.
--
-- Defects found in v6.0.0 and fixed here:
--   1. `Interactions` is a **Folder**, not a RemoteEvent. `remote('Restaurant','Interactions')`
--      returned the Folder and `Folder:FireServer(...)` threw inside pcall - the first of the
--      two bill calls never fired. Now `Interacted` is resolved INSIDE that folder.
--   2. `FindFirstChildWhichIsA('BasePart', true)` is unreliable in this VM (IsA is always true).
--      Parts are now found by ClassName only, and a bill with no findable part is SKIPPED
--      instead of sending a Model where the server expects a Part.
--   3. No rate limit: up to 12 bills x 2 calls every 0.25 s. Now a token bucket caps every
--      outgoing call (default 8 per 0.5 s) and only ONE bill is collected per pass.
--   4. `task.wait` inside the collect loop is gone; the loop yields between passes only.
--
-- Captures this is built on (user, 2026-10-27):
--   Interactions.Interacted:FireServer(tycoon, {Id="1", ActionText="", WorldPosition=...,
--     GamepadKeyCode=1000, TemporaryPart=Part, KeyboardKeyCode=101, Range=7.2,
--     IsCustomerPrompt=true, Key="CollectBill", Model=Items.Surface.T1, Part=Part,
--     Prompt=1, InteractionType="CollectBill", HoldDuration=0})
--   TaskCompleted:FireServer({Tycoon=tycoon, Name="CollectBill", FurnitureModel=Surface.T1})
--   TipsCollected:FireServer(tycoon)
-- An earlier capture used Id="142"/Prompt=142/KeyCode E, so those are just prompt numbers
-- and key codes - not fixed constants.
--
-- Upgrades excluded. No Instance.new. ClassName tests only.
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '6.0.1'
print('[Restaurant Tycoon 3] v' .. VERSION .. ' (auto money, safe rate)')

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    Bills = true,
    Tips  = true,
    Gap       = 0.5,    -- seconds between passes
    TipsEvery = 2.0,    -- seconds between tip calls
    BillEvery = 0.8,    -- seconds between bill attempts
    MaxPerHalf = 8,     -- hard cap on outgoing calls per 0.5 s
}

local running = true
local stat = { bills = 0, tips = 0, passes = 0, skipped = 0, blocked = 0 }
local lastTips, lastBill = 0, 0
local windowStart, windowCount = 0, 0

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s) print('[RT3] ' .. s) end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

-- token bucket: the reference caps at ~260/0.5s; we cap far lower on purpose
local function allow()
    local t = nowT()
    if (t - windowStart) >= 0.5 then
        windowStart = t
        windowCount = 0
    end
    if windowCount >= CONFIG.MaxPerHalf then
        stat.blocked = stat.blocked + 1
        return false
    end
    windowCount = windowCount + 1
    return true
end

local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(remote, ...)
    if not remote then return false, 'missing' end
    if not allow() then return false, 'rate capped' end
    local a = packArgs(...)
    local ok, err = pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end)
    return ok, err
end

local EV = RS:FindFirstChild('Events')
local function folder(...)
    local node = EV
    if not node then return nil end
    for _, name in ipairs({ ... }) do
        node = node:FindFirstChild(name)
        if not node then return nil end
    end
    return node
end

-- a fireable remote by name inside a folder
local function remote(folderName, remoteName)
    local f = folderName and folder(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

-- FIX 1: Interacted lives INSIDE the Interactions folder
local function interacted()
    local f = folder('Restaurant', 'Interactions')
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == 'Interacted' then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

-- FIX 2: ClassName only; IsA / FindFirstChildWhichIsA are unreliable here
local function aPart(model)
    if not model then return nil end
    local pp
    pcall(function() pp = model.PrimaryPart end)
    if pp then
        local cn = pp.ClassName
        if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
            return pp
        end
    end
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            local cn = d.ClassName
            if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
                return d
            end
        end
    end
    return nil
end

local function billTargets(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do
        local has = false
        pcall(function() has = (m:FindFirstChild('Bill') ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

-- one bill, captured order and shape; skips if no real BasePart is present
local function collectBill(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end

    local part = aPart(model)
    if not part then
        stat.skipped = stat.skipped + 1
        return false, 'no BasePart under ' .. model.Name .. ' - skipped'
    end

    local pos = Vector3.new(0, 0, 0)
    local okp, p = pcall(function() return part.Position end)
    if okp and typeof(p) == 'Vector3' then pos = p end

    local it = interacted()
    if it then
        fire(it, ty, {
            Id = '1',
            ActionText = '',
            WorldPosition = pos,
            GamepadKeyCode = 1000,
            TemporaryPart = part,
            KeyboardKeyCode = 101,
            Range = 7.2,
            IsCustomerPrompt = true,
            Key = 'CollectBill',
            Model = model,
            Part = part,
            Prompt = 1,
            InteractionType = 'CollectBill',
            HoldDuration = 0,
        })
    end

    local ok, err = fire(tc, { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model })
    if ok then stat.bills = stat.bills + 1 end
    return ok, err
end

local function takeTips(ty)
    local tips = remote('Restaurant', 'TipsCollected')
    if not tips or not ty then return false, 'TipsCollected missing' end
    local ok, err = fire(tips, ty)
    if ok then stat.tips = stat.tips + 1 end
    return ok, err
end

-- FIX 3/4: exactly one bill per pass, no waits inside the loop
local function oneBill(ty)
    local list = billTargets(ty)
    if #list == 0 then return false, 'no bills' end
    return collectBill(ty, list[1])
end

local function report()
    local ty = findTycoon()
    local list = ty and billTargets(ty) or {}
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('bills on tables=' .. #list)
    for i, m in ipairs(list) do
        if i <= 6 then
            local part = aPart(m)
            note('  bill on ' .. m.Name .. ' part=' .. tostring(part and part.Name or 'NONE'))
        end
    end
    note('remote Interacted=' .. tostring(interacted() ~= nil))
    note('remote TaskCompleted=' .. tostring(remote('Restaurant', 'TaskCompleted') ~= nil))
    note('remote TipsCollected=' .. tostring(remote('Restaurant', 'TipsCollected') ~= nil))
    note('bills=' .. stat.bills .. ' tips=' .. stat.tips .. ' passes=' .. stat.passes)
    note('skippedNoPart=' .. stat.skipped .. ' rateBlocked=' .. stat.blocked)
    note('--- end ---')
end

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Auto Money', 'Left')
            safeToggle(main, 'rt3_bills', 'Auto Collect Bills', CONFIG.Bills, function(v) CONFIG.Bills = v end)
            safeToggle(main, 'rt3_tips', 'Auto Collect Tips', CONFIG.Tips, function(v) CONFIG.Tips = v end)
            safeButton(main, 'Collect One Bill', function()
                local ty = findTycoon()
                local ok, d = oneBill(ty)
                note('one bill: ' .. (ok and 'OK ' or 'FAIL ') .. tostring(d))
            end)
            safeButton(main, 'Collect Tips Now', function()
                local ty = findTycoon()
                local ok, d = takeTips(ty)
                note('tips: ' .. (ok and 'OK ' or 'FAIL ') .. tostring(d))
            end)
            safeButton(main, 'Report', function() report() end)
            safeButton(main, 'Stop', function() stop() end)
        end)
    end)
end

local function pollToggle()
    local ok, v = pcall(function() return UI.GetValue('rt3_bills') end)
    if not ok or type(v) ~= 'boolean' then
        ok, v = pcall(function() return UI.GetValue('Auto Collect Bills') end)
    end
    if ok and type(v) == 'boolean' then CONFIG.Bills = v end
    local ok2, v2 = pcall(function() return UI.GetValue('rt3_tips') end)
    if not ok2 or type(v2) ~= 'boolean' then
        ok2, v2 = pcall(function() return UI.GetValue('Auto Collect Tips') end)
    end
    if ok2 and type(v2) == 'boolean' then CONFIG.Tips = v2 end
end

task.spawn(function()
    while running do
        pollToggle()
        task.wait(0.2)
    end
end)

task.spawn(function()
    local lastMsgT = 0
    while running do
        stat.passes = stat.passes + 1
        local ty = findTycoon()
        local t = nowT()

        if ty then
            if CONFIG.Bills and (t - lastBill) >= CONFIG.BillEvery then
                lastBill = t
                local ok, d = oneBill(ty)
                if ok then
                    note('bill collected')
                elseif d ~= 'no bills' and (t - lastMsgT) > 10 then
                    note('bill idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Tips and (t - lastTips) >= CONFIG.TipsEvery then
                lastTips = t
                takeTips(ty)
            end
        else
            if (t - lastMsgT) > 12 then
                note('idle: tycoon not found')
                lastMsgT = t
            end
        end

        task.wait(CONFIG.Gap)
    end
end)

note('loaded. One bill per pass, tips every 2s, outgoing calls capped.')
print('[Restaurant Tycoon 3] running. Stop with: _G.RestaurantTycoon3.stop()')
