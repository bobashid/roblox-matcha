            if CONFIG.Tips and (t - lastTips) >= CONFIG.TipsEvery then
                lastTips = t
                takeTips(ty)
            end
        else
            if (t - lastMsgT) > 12 then
                note('idle: tycoon not found')
                lastMsgT = t
            end
        end

        task.wait(CONFIG.Gap)
    end
end)

