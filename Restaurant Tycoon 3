    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    Bills  = true,
    Tips   = true,
    Dishes = true,
    Orders = true,
    Seat   = true,
    Gap        = 0.2,
    TipsEvery  = 1.0,
    BillEvery  = 0.35,
    DishEvery  = 0.35,
    OrderEvery = 0.35,
    SeatEvery  = 0.5,
    OrderCooldown = 6.0,
    SeatCooldown  = 10.0,
    MaxPerHalf = 8,      -- crash safety: do NOT raise
}

local running = true
local stat = { bills = 0, tips = 0, dishes = 0, orders = 0, seats = 0,
               passes = 0, skipped = 0, blocked = 0 }
local lastTips, lastBill, lastDish, lastOrder, lastSeat = 0, 0, 0, 0, 0
local windowStart, windowCount = 0, 0
local orderIdx, seatIdx, tableIdx = 1, 1, 1
local orderAt, seatAt = {}, {}

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s) print('[RT3] ' .. s) end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

-- token bucket: unchanged from the build that stopped crashing
local function allow()
    local t = nowT()
    if (t - windowStart) >= 0.5 then
        windowStart = t
        windowCount = 0
    end
    if windowCount >= CONFIG.MaxPerHalf then
        stat.blocked = stat.blocked + 1
        return false
    end
    windowCount = windowCount + 1
    return true
end

-- `...` inside a nested closure is a parse error, so pack/unpack
local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(remote, ...)
    if not remote then return false, 'missing' end
    if not allow() then return false, 'rate capped' end
    local a = packArgs(...)
    local ok, err = pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end)
    return ok, err
end

local EV = RS:FindFirstChild('Events')
local function folder(...)
    local node = EV
    if not node then return nil end
    for _, name in ipairs({ ... }) do
        node = node:FindFirstChild(name)
        if not node then return nil end
    end
    return node
end

local function remote(folderName, remoteName)
    local f = folderName and folder(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

-- Interacted lives INSIDE the Interactions FOLDER (v6.0.0 crash fix)
local function interacted()
    local f = folder('Restaurant', 'Interactions')
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == 'Interacted' then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

-- ClassName only - FindFirstChildWhichIsA is unreliable here
local function aPart(model)
    if not model then return nil end
    local pp
    pcall(function() pp = model.PrimaryPart end)
    if pp then
        local cn = pp.ClassName
        if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
            return pp
        end
    end
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            local cn = d.ClassName
            if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
                return d
            end
        end
    end
    return nil
end

local function surfaceList(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do out[#out + 1] = m end
    return out
end

local function surfacesWith(ty, childName)
    local out = {}
    for _, m in ipairs(surfaceList(ty)) do
        local has = false
        pcall(function() has = (m:FindFirstChild(childName) ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

local function billTargets(ty) return surfacesWith(ty, 'Bill') end
local function dishTargets(ty) return surfacesWith(ty, 'Trash') end

-- guests: folder name = GroupId, model name = CustomerId (opaque strings)
local function customerList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        for _, c in ipairs(g:GetChildren()) do
            out[#out + 1] = { groupId = g.Name, customerId = c.Name }
        end
    end
    return out
end

-- one entry per group folder (SendToTable takes GroupId only)
local function groupList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        local n = 0
        for _, c in ipairs(g:GetChildren()) do n = n + 1 end
        if n > 0 then out[#out + 1] = g.Name end
    end
    return out
end

-- a table is free when it has no Bill, no Trash, no occupied flag, no occupied Seat
local function tableFree(m)
    if not m or not m.Parent then return false end
    if m:FindFirstChild('Bill') then return false end
    if m:FindFirstChild('Trash') then return false end
    for _, att in ipairs({ 'Occupied', 'IsOccupied', 'InUse', 'Taken' }) do
        local v
        pcall(function() v = m:GetAttribute(att) end)
        if v then return false end
    end
    local ok, desc = pcall(function() return m:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            if d.ClassName == 'Seat' then
                local occ
                pcall(function() occ = d.Occupant end)
                if occ then return false end
            end
        end
    end
    return true
end

local function freeTables(ty)
    local out = {}
    for _, m in ipairs(surfaceList(ty)) do
        if tableFree(m) then out[#out + 1] = m end
    end
    return out
end

-- BILL: captured two-call pair
local function collectBill(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end

    local part = aPart(model)
    if not part then
        stat.skipped = stat.skipped + 1
        return false, 'no BasePart under ' .. model.Name .. ' - skipped'
    end

    local pos = Vector3.new(0, 0, 0)
    local okp, p = pcall(function() return part.Position end)
    if okp and typeof(p) == 'Vector3' then pos = p end

    local it = interacted()
    if it then
        fire(it, ty, {
            Id = '1', ActionText = '', WorldPosition = pos,
            GamepadKeyCode = 1000, TemporaryPart = part, KeyboardKeyCode = 101,
            Range = 7.2, IsCustomerPrompt = true, Key = 'CollectBill',
            Model = model, Part = part, Prompt = 1,
            InteractionType = 'CollectBill', HoldDuration = 0,
        })
    end

    local ok, err = fire(tc, { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model })
    if ok then stat.bills = stat.bills + 1 end
    return ok, err
end

-- DISHES: single call
local function collectDish(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire(tc, { Tycoon = ty, Name = 'CollectDishes', FurnitureModel = model })
    if ok then stat.dishes = stat.dishes + 1 end
    return ok, err
end

-- ORDER: single call, ids as strings
local function takeOrder(ty, cust)
    if not ty or not cust then return false, 'missing customer' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire(tc, {
        CustomerId = cust.customerId,
        GroupId = cust.groupId,
        Tycoon = ty,
        Name = 'TakeOrder',
    })
    if ok then stat.orders = stat.orders + 1 end
    return ok, err
end

-- SEAT: single call, FurnitureModel = table, GroupId = group folder name (string)
local function sendToTable(ty, groupId, table)
    if not ty or not groupId or not table then return false, 'missing group/table' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire(tc, {
        FurnitureModel = table,
        GroupId = groupId,
        Tycoon = ty,
        Name = 'SendToTable',
    })
    if ok then stat.seats = stat.seats + 1 end
    return ok, err
end

local function takeTips(ty)
    local tips = remote('Restaurant', 'TipsCollected')
    if not tips or not ty then return false, 'TipsCollected missing' end
    local ok, err = fire(tips, ty)
    if ok then stat.tips = stat.tips + 1 end
    return ok, err
end

local function oneBill(ty)
    local list = billTargets(ty)
    if #list == 0 then return false, 'no bills' end
    return collectBill(ty, list[1])
end

local function oneDish(ty)
    local list = dishTargets(ty)
    if #list == 0 then return false, 'no trash' end
    return collectDish(ty, list[1])
end

local function oneOrder(ty)
    local list = customerList(ty)
    if #list == 0 then return false, 'no customers' end
    if orderIdx > #list then orderIdx = 1 end
    local t = nowT()
    local tries = 0
    while tries < #list do
        local c = list[orderIdx]
        orderIdx = orderIdx + 1
        if orderIdx > #list then orderIdx = 1 end
        tries = tries + 1
        local key = tostring(c.groupId) .. ':' .. tostring(c.customerId)
        local last = orderAt[key]
        if not last or (t - last) >= CONFIG.OrderCooldown then
            orderAt[key] = t
            return takeOrder(ty, c)
        end
    end
    return false, 'all customers on cooldown'
end

-- one GROUP per pass, round-robin over groups, per-group cooldown, needs a free table
local function oneSeat(ty)
    local groups = groupList(ty)
    if #groups == 0 then return false, 'no customers' end
    local tables = freeTables(ty)
    if #tables == 0 then return false, 'no free tables' end
    if seatIdx > #groups then seatIdx = 1 end
    if tableIdx > #tables then tableIdx = 1 end

    local t = nowT()
    local tries = 0
    while tries < #groups do
        local gid = groups[seatIdx]
        seatIdx = seatIdx + 1
        if seatIdx > #groups then seatIdx = 1 end
        tries = tries + 1
        local last = seatAt[gid]
        if not last or (t - last) >= CONFIG.SeatCooldown then
            local table = tables[tableIdx]
            tableIdx = tableIdx + 1
            if tableIdx > #tables then tableIdx = 1 end
            seatAt[gid] = t
            local ok, err = sendToTable(ty, gid, table)
            return ok, 'group ' .. tostring(gid) .. ' -> ' .. table.Name .. (ok and '' or (' err ' .. tostring(err)))
        end
    end
    return false, 'all groups on cooldown'
end

local function report()
    local ty = findTycoon()
    local bills = ty and billTargets(ty) or {}
    local dishes = ty and dishTargets(ty) or {}
    local cust = ty and customerList(ty) or {}
    local groups = ty and groupList(ty) or {}
    local free = ty and freeTables(ty) or {}
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('bills=' .. #bills .. ' dishes=' .. #dishes .. ' customers=' .. #cust)
    note('groups=' .. #groups .. ' freeTables=' .. #free)
    for i, c in ipairs(cust) do
        if i <= 8 then note('  cust group=' .. tostring(c.groupId) .. ' id=' .. tostring(c.customerId)) end
    end
    for i, m in ipairs(free) do
        if i <= 6 then note('  free table ' .. m.Name) end
    end
    note('remote Interacted=' .. tostring(interacted() ~= nil))
    note('remote TaskCompleted=' .. tostring(remote('Restaurant', 'TaskCompleted') ~= nil))
    note('remote TipsCollected=' .. tostring(remote('Restaurant', 'TipsCollected') ~= nil))
    note('bills=' .. stat.bills .. ' tips=' .. stat.tips .. ' dishes=' .. stat.dishes ..
         ' orders=' .. stat.orders .. ' seats=' .. stat.seats .. ' passes=' .. stat.passes)
    note('skippedNoPart=' .. stat.skipped .. ' rateBlocked=' .. stat.blocked)
    note('--- end ---')
end

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

