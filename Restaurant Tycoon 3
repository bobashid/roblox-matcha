local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s) print('[RT3] ' .. s) end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

local function allow(kind)
    local b, cap = bOther, CONFIG.MaxPerHalf
    if kind == 'serve' then b, cap = bServe, CONFIG.ServeBudget end
    local t = nowT()
    if (t - b.start) >= 0.5 then b.start = t b.count = 0 end
    if b.count >= cap then
        if kind == 'serve' then stat.blockedServe = stat.blockedServe + 1
        else stat.blocked = stat.blocked + 1 end
        return false
    end
    b.count = b.count + 1
    return true
end

local function packArgs(...) return { n = select('#', ...), ... } end

local function fire(kind, r, ...)
    if not r then return false, 'missing' end
    if not allow(kind) then return false, 'rate capped' end
    local a = packArgs(...)
    return (pcall(function() r:FireServer(unpackFn(a, 1, a.n)) end))
end

local EV = RS:FindFirstChild('Events')
local function folder(...)
    local node = EV
    if not node then return nil end
    for _, nm in ipairs({ ... }) do
        node = node:FindFirstChild(nm)
        if not node then return nil end
    end
    return node
end

local function remote(folderName, remoteName)
    local f = folderName and folder(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' or cn == 'RemoteFunction' then
                return c
            end
        end
    end
    return nil
end

local function interacted()
    local f = folder('Restaurant', 'Interactions')
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == 'Interacted' then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then return c end
        end
    end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

local function aPart(model)
    if not model then return nil end
    local pp
    pcall(function() pp = model.PrimaryPart end)
    if pp then
        local cn = pp.ClassName
        if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
            return pp
        end
    end
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            local cn = d.ClassName
            if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
                return d
            end
        end
    end
    return nil
end

local function surfaceList(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do out[#out + 1] = m end
    return out
end

local function surfacesWith(ty, childName)
    local out = {}
    for _, m in ipairs(surfaceList(ty)) do
        local has = false
        pcall(function() has = (m:FindFirstChild(childName) ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

local function billTargets(ty) return surfacesWith(ty, 'Bill') end
local function dishTargets(ty) return surfacesWith(ty, 'Trash') end

local function foodFolder(ty)
    local objs = ty and ty:FindFirstChild('Objects')
    if not objs then return nil end
    return objs:FindFirstChild('Food') or objs:FindFirstChild('Foods')
end

local function foodList(ty)
    local out = {}
    local ff = foodFolder(ty)
    if not ff then return out end
    for _, c in ipairs(ff:GetChildren()) do out[#out + 1] = c end
    return out
end

-- GrabFood.AttemptGrab sets a Taken attribute on the plate it grabs, so those are the held ones.
local function takenList(ty)
    local out = {}
    for _, c in ipairs(foodList(ty)) do
        local t = false
        pcall(function() t = c:GetAttribute('Taken') end)
        if t then out[#out + 1] = c end
    end
    return out
end

local function serveDishes(ty)
    local held = takenList(ty)
    if #held > 0 then return held, true end
    return foodList(ty), false
end

-- THE acceptance test: the plate left Objects.Food => the server took it.
local function stillOnTray(ty, dish)
    if not dish then return false end
    local ok, parent = pcall(function() return dish.Parent end)
    if not ok or not parent then return false end
    local ff = foodFolder(ty)
    if not ff then return false end
    local ok2, isDesc = pcall(function() return dish:IsDescendantOf(ff) end)
    if ok2 then return isDesc == true end
    return parent == ff
end

local function customerList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        for _, c in ipairs(g:GetChildren()) do
            out[#out + 1] = { groupId = g.Name, customerId = c.Name, model = c }
        end
    end
    return out
end

local function groupList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        local n = 0
        for _, c in ipairs(g:GetChildren()) do n = n + 1 end
        if n > 0 then out[#out + 1] = g.Name end
    end
    return out
end

-- There is no per-dish prompt; workspace.Temp holds the GROUP (tray) pickup prompt(s).
local function servePrompts()
    local out = {}
    local temp = workspace:FindFirstChild('Temp')
    if not temp then return out end
    local ok, desc = pcall(function() return temp:GetDescendants() end)
    if not ok or not desc then return out end
    for _, d in ipairs(desc) do
        if d.ClassName == 'ProximityPrompt' then out[#out + 1] = d end
    end
    return out
end

local function nearestCounter(ty)
    local origin
    local c
    pcall(function() c = lp.Character end)
    if c then
        local r = c:FindFirstChild('HumanoidRootPart')
        if r then
            local p
            pcall(function() p = r.Position end)
            if typeof(p) == 'Vector3' then origin = p end
        end
    end
    local best, bestD = nil, math.huge
    for _, m in ipairs(surfaceList(ty)) do
        if string.match(m.Name, '^K%d+$') then
            local part = aPart(m)
            if part then
                local pos
                pcall(function() pos = part.Position end)
                if origin and typeof(pos) == 'Vector3' then
                    local d = (origin - pos).Magnitude
                    if d < bestD then bestD, best = d, m end
                elseif not best then
                    best = m
                end
            end
        end
    end
    return best
end

local function tableFree(m)
    if not m or not m.Parent then return false end
    if m:FindFirstChild('Bill') then return false end
    if m:FindFirstChild('Trash') then return false end
    for _, att in ipairs({ 'Occupied', 'IsOccupied', 'InUse', 'Taken' }) do
        local v
        pcall(function() v = m:GetAttribute(att) end)
        if v then return false end
    end
    local ok, desc = pcall(function() return m:GetDescendants() end)
    if ok and desc then
        for _, d in ipairs(desc) do
            if d.ClassName == 'Seat' then
                local occ
                pcall(function() occ = d.Occupant end)
                if occ then return false end
            end
        end
    end
    return true
end

-- Tables are T<n> only. K<n> are kitchen counters and must never be seated on.
local function freeTables(ty)
    local out = {}
    for _, m in ipairs(surfaceList(ty)) do
        if string.match(m.Name, '^T%d+$') and tableFree(m) then
            out[#out + 1] = m
        end
    end
    return out
end

-- PICKUP: fire the tray prompt(s) under workspace.Temp, no text filter
local function pickupViaPrompt()
    local prompts = servePrompts()
    if #prompts == 0 then return false, 'no prompt under workspace.Temp (stand at the counter)' end
    local n = 0
    for i = 1, math.min(#prompts, CONFIG.MaxPickupPrompts) do
        if allow('serve') then
            local ok = pcall(fireproximityprompt, prompts[i])
            if ok then n = n + 1 end
        end
    end
    if n > 0 then stat.promptPicks = stat.promptPicks + n end
    return n > 0, 'fireproximityprompt x' .. n .. ' of ' .. #prompts
end

-- FALLBACK: the captured Interacted call (range gated, so it needs you at the counter)
local function pickupViaRemote(ty)
    local it = interacted()
    if not it then return false, 'Interacted missing' end
    local prompts = servePrompts()
    local prompt = prompts[1]
    if not prompt then return false, 'no prompt object to reference' end
    local part = prompt.Parent
    if not part then return false, 'prompt has no parent part' end
    local counter = nearestCounter(ty)
    if not counter then return false, 'no K counter model' end
    local pos = Vector3.new(0, 0, 0)
    local okp, p = pcall(function() return part.Position end)
    if okp and typeof(p) == 'Vector3' then pos = p end
    local ok, err = fire('serve', it, ty, {
        HoldDuration = 0.25,
        Id = tostring(prompt.Name),
        ActionText = 'Serve',
        WorldPosition = pos,
        GamepadKeyCode = Enum.KeyCode.Thumbstick2,
        TemporaryPart = part,
        KeyboardKeyCode = Enum.KeyCode.F,
        Range = 9,
        IsCustomerPrompt = true,
        Key = 'Serve',
        Model = counter,
        Part = part,
        Prompt = prompt,
        InteractionType = 'OrderCounter',
    })
    if ok then stat.remotePicks = stat.remotePicks + 1 end
    return ok, err
end

-- HAND-OFF: payload is EXACTLY the 6.8.0 one the user confirmed works. No extra keys.
local function serveToGuest(ty, food, cust)
    if not ty or not food or not cust then return false, 'missing food/guest' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local ok, err = fire('serve', tc, {
        FoodModel = food,
        Name = 'Serve',
        Tycoon = ty,
        GroupId = cust.groupId,
        CustomerId = cust.customerId,
    })
    return ok, err
end

local function collectBill(ty, model)
    if not ty or not model then return false, 'missing model' end
    local tc = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, 'TaskCompleted missing' end
    local part = aPart(model)
    if not part then
        stat.skipped = stat.skipped + 1
        return false, 'no BasePart under ' .. model.Name
    end
    local pos = Vector3.new(0, 0, 0)
    local okp, p = pcall(function() return part.Position end)
    if okp and typeof(p) == 'Vector3' then pos = p end
    local it = interacted()
    if it then
        fire('other', it, ty, {
            Id = '1', ActionText = '', WorldPosition = pos,
            GamepadKeyCode = 1000, TemporaryPart = part, KeyboardKeyCode = 101,
            Range = 7.2, IsCustomerPrompt = true, Key = 'CollectBill',
            Model = model, Part = part, Prompt = 1,
            InteractionType = 'CollectBill', HoldDuration = 0,
        })
    end
    local ok, err = fire('other', tc, { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model })
    if ok then stat.bills = stat.bills + 1 end
    return ok, err
end

