local function oneBill(ty)
    local l = billTargets(ty)
    if #l == 0 then return false, 'no bills' end
    return collectBill(ty, l[1])
end

local function oneDish(ty)
    local l = dishTargets(ty)
    if #l == 0 then return false, 'no trash' end
    return collectDish(ty, l[1])
end

local function oneOrder(ty)
    local l = customerList(ty)
    if #l == 0 then return false, 'no customers' end
    if orderIdx > #l then orderIdx = 1 end
    local t = nowT()
    for _ = 1, #l do
        local c = l[orderIdx]
        orderIdx = orderIdx + 1
        if orderIdx > #l then orderIdx = 1 end
        local key = tostring(c.groupId) .. ':' .. tostring(c.customerId)
        local last = orderAt[key]
        if not last or (t - last) >= CONFIG.OrderCooldown then
            orderAt[key] = t
            return takeOrder(ty, c)
        end
    end
    return false, 'all customers on cooldown'
end

local function oneSeat(ty)
    local groups = groupList(ty)
    if #groups == 0 then return false, 'no customers' end
    local tables = freeTables(ty)
    if #tables == 0 then return false, 'no free TABLES (counters excluded)' end
    if seatIdx > #groups then seatIdx = 1 end
    if tableIdx > #tables then tableIdx = 1 end
    local t = nowT()
    for _ = 1, #groups do
        local gid = groups[seatIdx]
        seatIdx = seatIdx + 1
        if seatIdx > #groups then seatIdx = 1 end
        local last = seatAt[gid]
        if not last or (t - last) >= CONFIG.SeatCooldown then
            local tableModel = tables[tableIdx]
            tableIdx = tableIdx + 1
            if tableIdx > #tables then tableIdx = 1 end
            seatAt[gid] = t
            seatTable[gid] = tableModel
            local ok, err = sendToTable(ty, gid, tableModel)
            return ok, 'group ' .. tostring(gid) .. ' -> ' .. tableModel.Name ..
                   (ok and '' or (' err ' .. tostring(err)))
        end
    end
    return false, 'all groups on cooldown'
end

-- SERVE: grab if the tray is empty, then click each in-range customer and watch the tray.
local function oneServe(ty)
    if not ty then return false, 'no tycoon' end
    local guests = customerList(ty)
    if #guests == 0 then return false, 'no customers' end

    local total0 = #foodList(ty)
    local held = #takenList(ty)

    if held == 0 then
        local pok, pdetail = pickupViaPrompt()
        if not pok then
            local rok, rdetail = pickupViaRemote(ty)
            if not rok then
                return false, 'grab failed (prompt: ' .. tostring(pdetail) ..
                              ' | remote: ' .. tostring(rdetail) .. ')'
            end
            pdetail = 'remote: ' .. tostring(rdetail)
        end
        task.wait(0.15)
        held = #takenList(ty)
        if held == 0 and #foodList(ty) == 0 then
            lastServeDetail = 'tray empty after grab'
            return false, lastServeDetail
        end
    end

    local inRange = 0
    local origin = rootPos()
    if origin then
        for _, g in ipairs(guests) do
            if g.pos then
                local dx, dz, dy = g.pos.X - origin.X, g.pos.Z - origin.Z, g.pos.Y - origin.Y
                if (dx * dx + dz * dz) <= CONFIG.RangeXZ2 and math.abs(dy) <= CONFIG.MaxY then
                    inRange = inRange + 1
                end
            end
        end
    end

    local clicks, served, lastDetail = 0, 0, ''
    for _, g in ipairs(guests) do
        if clicks >= CONFIG.MaxClicksPerPass then break end
        if total0 > 0 and #foodList(ty) == 0 then break end
        local before = #foodList(ty)
        local ok, d = clickCustomer(g)
        lastDetail = tostring(d)
        clicks = clicks + 1
        if ok then
            task.wait(CONFIG.ClickSettle)
            local after = #foodList(ty)
            if before > 0 and after < before then
                served = served + (before - after)
                stat.serves = stat.serves + (before - after)
            end
        end
        task.wait(CONFIG.ServeGap)
    end

    local detail = 'held=' .. tostring(held) .. ' tray=' .. #foodList(ty) ..
                   ' guests=' .. #guests .. ' inRange=' .. inRange ..
                   ' clicks=' .. clicks .. ' leftTray=' .. served
    lastServeDetail = detail
    if clicks == 0 then return false, 'no guest to click (' .. detail .. ')' end
    if served == 0 then
        return false, detail .. ' (last: ' .. tostring(lastDetail) .. ') - no dish left the tray'
    end
    return true, detail
end

local function report()
    local ty = findTycoon()
    local food = ty and foodList(ty) or {}
    local taken = ty and takenList(ty) or {}
    local cust = ty and customerList(ty) or {}
    local prompts = servePrompts()
    local tables = ty and freeTables(ty) or {}
    local counters = {}
    for _, m in ipairs(surfaceList(ty)) do
        if string.match(m.Name, '^K%d+$') then counters[#counters + 1] = m.Name end
    end
    local rbx
    pcall(function() rbx = isrbxactive() end)
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('bills=' .. #(ty and billTargets(ty) or {}) .. ' trash=' .. #(ty and dishTargets(ty) or {}) ..
         ' customers=' .. #cust)
    note('foodOnCounter=' .. #food .. ' taken(held)=' .. #taken)
    for i, m in ipairs(taken) do
        if i <= 6 then note('  held ' .. tostring(m.Name)) end
    end
    note('freeTables=' .. #tables .. ' counters=' .. table.concat(counters, ','))
    note('promptsUnderTemp=' .. #prompts)
    note('remote Interacted=' .. tostring(interacted() ~= nil) ..
         ' TaskCompleted=' .. tostring(remote('Restaurant', 'TaskCompleted') ~= nil) ..
         ' TipsCollected=' .. tostring(remote('Restaurant', 'TipsCollected') ~= nil))
    note('aimMode=' .. tostring(aimMode) .. ' rbxActive=' .. tostring(rbx) .. ' clicks=' .. stat.clicks)
    note('lastServe=' .. tostring(lastServeDetail))
    note('counters promptPicks=' .. stat.promptPicks .. ' remotePicks=' .. stat.remotePicks ..
         ' serves=' .. stat.serves .. ' orders=' .. stat.orders .. ' seats=' .. stat.seats ..
         ' bills=' .. stat.bills .. ' dishes=' .. stat.dishes .. ' tips=' .. stat.tips)
    note('skippedNoPart=' .. stat.skipped .. ' rateBlocked=' .. stat.blocked ..
         ' aimFail=' .. stat.aimFail .. ' passes=' .. stat.passes)
    note('--- end ---')
end

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

