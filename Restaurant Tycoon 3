-- Version: 3.5.0
-- Scope: pickup dishes, SERVE the dish actually in hand, tips, bills.
-- v3.5.0 fixes the real serve bug: foodList() skips dishes with Taken set, so after a
-- grab the held dish vanished from that list and v3.4 served a different dish entirely.
-- The grabbed model is now remembered in `held` and that is what gets served.
-- 'Serve' as the TaskCompleted Name is CONFIRMED (getgc("Serve") returned 27 string
-- entries including "Serve", "Name", "Key", "IsHoldingFoodForNPC").
-- Tips and bill payloads are USER-CAPTURED.
-- Upgrades untouched. No teleports, no Drawing, no Dialog firing, no seat firing.
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '3.5.0'
print('[Restaurant Tycoon 3] v' .. VERSION)

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local CONFIG = {
    Dish  = true,
    Serve = true,
    Tips  = true,
    Bill  = true,
    Cycle     = 0.4,
    ServeGap  = 0.8,
    TipsEvery = 4.0,
    BillEvery = 2.0,
}

local running = true
local toggles = {}
local tServe, tTips, tBill = 0, 0, 0
local held = nil
local guestIdx = 1
local stat = { grabs = 0, serves = 0, tips = 0, bills = 0 }

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }

local function ev(folder, name)
    local ok, r = pcall(function()
        local f = RS:FindFirstChild('Events')
        f = f and f:FindFirstChild(folder)
        return f and f:FindFirstChild(name)
    end)
    if ok then return r end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        local ov = p:FindFirstChild('Player')
        if ov then
            local v
            pcall(function() v = ov.Value end)
            if v == lp then return p end
        end
    end
    return nil
end

-- untaken dishes still sitting on the counter (candidates to grab)
local function foodList(ty)
    local out = {}
    if not ty then return out end
    local objs = ty:FindFirstChild('Objects')
    local food = objs and objs:FindFirstChild('Food')
    if not food then return out end
    for _, c in ipairs(food:GetChildren()) do
        local taken
        pcall(function() taken = c:GetAttribute('Taken') end)
        if not taken then out[#out + 1] = c end
    end
    return out
end

local function tryGrab(model)
    local gf = ev('Restaurant', 'GrabFood')
    if not gf or not model then return false end
    local ok, res = pcall(function() return gf:InvokeServer(model) end)
    if not ok then return false end
    return (res == true or type(res) == 'table')
end

-- group folder name = GroupId, child Model name = CustomerId (both integers)
local function guestList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        local gid = tonumber(g.Name)
        if gid then
            for _, c in ipairs(g:GetChildren()) do
                local cid = tonumber(c.Name)
                if cid then out[#out + 1] = { GroupId = gid, CustomerId = cid } end
            end
        end
    end
    return out
end

local function serve(ty, guest, foodModel)
    local tc = ev('Restaurant', 'TaskCompleted')
    if not tc or not ty or not guest or not foodModel then return false end
    local payload = {
        Name = 'Serve',
        Tycoon = ty,
        GroupId = guest.GroupId,
        CustomerId = guest.CustomerId,
        FoodModel = foodModel,
    }
    local ok = pcall(function() tc:FireServer(payload) end)
    if ok then stat.serves = stat.serves + 1 end
    return ok
end

local function takeTips(ty)
    local tc = ev('Restaurant', 'TipsCollected')
    if not tc or not ty then return false end
    local ok = pcall(function() tc:FireServer(ty) end)
    if ok then stat.tips = stat.tips + 1 end
    return ok
end

local function billTargets(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do
        local hasBill = false
        pcall(function() hasBill = (m:FindFirstChild('Bill') ~= nil) end)
        if hasBill then out[#out + 1] = m end
    end
    return out
end

local function takeBill(ty, model)
    local tc = ev('Restaurant', 'TaskCompleted')
    if not tc or not ty or not model then return false end
    local payload = { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model }
    local ok = pcall(function() tc:FireServer(payload) end)
    if ok then stat.bills = stat.bills + 1 end
    return ok
end

local function safeToggle(sec, id, label, default, cb)
    local variants = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeSlider(sec, id, label, min, max, default, cb)
    local variants = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    local variants = {
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function reg(id, label, key)
    toggles[#toggles + 1] = { id = id, name = label, key = key }
end

local function report()
    local ty = findTycoon()
    local f = ty and foodList(ty)
    local g = ty and guestList(ty)
    local b = ty and billTargets(ty)
    local line = 'counter=' .. tostring(f and #f or -1) ..
                 ' held=' .. tostring(held and held.Name or 'nil') ..
                 ' guests=' .. tostring(g and #g or -1) ..
                 ' grabs=' .. tostring(stat.grabs) ..
                 ' serves=' .. tostring(stat.serves) ..
                 ' tips=' .. tostring(stat.tips) ..
                 ' bills=' .. tostring(stat.bills) ..
                 ' billsLeft=' .. tostring(b and #b or -1)
    print('[RT3] ' .. line)
    pcall(function() notify('RT3', line, 5) end)
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Automation', 'Left')
            safeToggle(main, 'rt3_dish', 'Auto Pickup Dishes', CONFIG.Dish, function(v) CONFIG.Dish = v end)
            reg('rt3_dish', 'Auto Pickup Dishes', 'Dish')
            safeToggle(main, 'rt3_serve', 'Auto Serve To Guest', CONFIG.Serve, function(v) CONFIG.Serve = v end)
            reg('rt3_serve', 'Auto Serve To Guest', 'Serve')
            safeToggle(main, 'rt3_tips', 'Auto Collect Tips', CONFIG.Tips, function(v) CONFIG.Tips = v end)
            reg('rt3_tips', 'Auto Collect Tips', 'Tips')
            safeToggle(main, 'rt3_bill', 'Auto Collect Bills', CONFIG.Bill, function(v) CONFIG.Bill = v end)
            reg('rt3_bill', 'Auto Collect Bills', 'Bill')

            local tune = tab:Section('Tuning', 'Right')
            safeSlider(tune, 'rt3_servegap', 'Serve Gap x10', 5, 60, 8, function(v) CONFIG.ServeGap = v / 10 end)
            safeSlider(tune, 'rt3_tipsevery', 'Tips Every x10', 10, 120, 40, function(v) CONFIG.TipsEvery = v / 10 end)
            safeButton(tune, 'Serve Held Now', function()
                local ty = findTycoon()
                local g = ty and guestList(ty)
                if ty and g and g[1] and held then serve(ty, g[1], held) end
            end)
            safeButton(tune, 'Drop Held', function()
                local c = ev('Restaurant', 'CancelGrabRequested')
                if c then pcall(function() c:FireServer() end) end
                held = nil
            end)
            safeButton(tune, 'Collect Tips Now', function() local ty = findTycoon() takeTips(ty) end)
            safeButton(tune, 'Collect Bill Now', function()
                local ty = findTycoon()
                local b = ty and billTargets(ty)
                if b and b[1] then takeBill(ty, b[1]) end
            end)
            safeButton(tune, 'Report', function() report() end)
            safeButton(tune, 'Stop', function() stop() end)
        end)
    end)
end

task.spawn(function()
    while running do
        for i = 1, #toggles do
            local t = toggles[i]
            local ok, v = pcall(function() return UI.GetValue(t.id) end)
            if not ok or type(v) ~= 'boolean' then
                ok, v = pcall(function() return UI.GetValue(t.name) end)
            end
            if ok and type(v) == 'boolean' then
                CONFIG[t.key] = v
            end
        end
        task.wait(0.15)
    end
end)

task.spawn(function()
    while running do
        local ty = findTycoon()
        local t = nowT()

        -- grab one dish and remember it; that exact model is what gets served
        if CONFIG.Dish and ty and not held then
            local list = foodList(ty)
            if list[1] then
                if tryGrab(list[1]) then
                    held = list[1]
                    stat.grabs = stat.grabs + 1
                end
            end
        end

        -- serve the held dish, round-robin over guests (only the matching order lands)
        if CONFIG.Serve and ty and held and (t - tServe) >= CONFIG.ServeGap then
            local guests = guestList(ty)
            if #guests > 0 then
                if guestIdx > #guests then guestIdx = 1 end
                local guest = guests[guestIdx]
                guestIdx = guestIdx + 1
                if serve(ty, guest, held) then
                    tServe = t
                    held = nil
                end
            end
        end

        if CONFIG.Bill and ty and (t - tBill) >= CONFIG.BillEvery then
            local b = billTargets(ty)
            if b[1] then
                if takeBill(ty, b[1]) then tBill = t end
            end
        end

        if CONFIG.Tips and ty and (t - tTips) >= CONFIG.TipsEvery then
            if takeTips(ty) then tTips = t end
        end

        task.wait(CONFIG.Cycle)
    end
end)

print('[Restaurant Tycoon 3] running. Stop with: _G.RestaurantTycoon3.stop()')
