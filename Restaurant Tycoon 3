            safeToggle(auto, 'rt3_tips', 'Auto Tips', CONFIG.Tips, function(v) CONFIG.Tips = v end)
            reg('rt3_tips', 'Auto Tips', 'Tips')
            safeButton(auto, 'Stop', function() stop() end)
        end)
    end)
