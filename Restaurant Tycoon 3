        local ty = findTycoon()
        local t = nowT()

        if ty then
            if CONFIG.Serve and (t - lastServe) >= CONFIG.ServeEvery then
                lastServe = t
                local ok, d = oneServe(ty)
                if ok then
                    note('served: ' .. tostring(d))
                elseif d ~= 'no dishes on counter' and d ~= 'no customers'
                    and d ~= 'every pair on cooldown' and (t - lastMsgT) > 10 then
                    note('serve idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Seat and (t - lastSeat) >= CONFIG.SeatEvery then
                lastSeat = t
                local ok, d = oneSeat(ty)
                if ok then note('seated: ' .. tostring(d))
                elseif d ~= 'no customers' and d ~= 'no free tables' and (t - lastMsgT) > 10 then
                    note('seat idle: ' .. tostring(d)) lastMsgT = t
                end
            end

            if CONFIG.Orders and (t - lastOrder) >= CONFIG.OrderEvery then
                lastOrder = t
                local ok, d = oneOrder(ty)
                if ok then note('order taken')
                elseif d ~= 'no customers' and (t - lastMsgT) > 10 then
                    note('order idle: ' .. tostring(d)) lastMsgT = t
                end
            end

            if CONFIG.Bills and (t - lastBill) >= CONFIG.BillEvery then
                lastBill = t
                local ok, d = oneBill(ty)
                if ok then note('bill collected')
                elseif d ~= 'no bills' and (t - lastMsgT) > 10 then
                    note('bill idle: ' .. tostring(d)) lastMsgT = t
                end
            end

            if CONFIG.Dishes and (t - lastDish) >= CONFIG.DishEvery then
                lastDish = t
                local ok, d = oneDish(ty)
                if ok then note('dish collected')
                elseif d ~= 'no trash' and (t - lastMsgT) > 10 then
                    note('dish idle: ' .. tostring(d)) lastMsgT = t
                end
            end

            if CONFIG.Tips and (t - lastTips) >= CONFIG.TipsEvery then
                lastTips = t takeTips(ty)
            end
        else
            if (t - lastMsgT) > 12 then note('idle: tycoon not found') lastMsgT = t end
        end

        task.wait(CONFIG.Gap)
    end
end)

