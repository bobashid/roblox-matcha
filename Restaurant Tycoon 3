-- ===== STEP 2: serve by clicking the customer (the only route that runs ServeFood) =====
local function camera()
    local cam
    pcall(function() cam = workspace.CurrentCamera end)
    return cam
end

local function aimAt(pos)
    local cam = camera()
    if not cam or typeof(pos) ~= 'Vector3' then return false, 'no camera' end
    local eye
    pcall(function() eye = cam.CFrame.Position end)
    if typeof(eye) ~= 'Vector3' then return false, 'no camera position' end
    if pcall(function() cam.CFrame = CFrame.lookAt(eye, pos) end) then
        aimMode = 'lookAt'
        return true
    end
    if pcall(function() cam.CFrame = CFrame.new(eye, pos) end) then
        aimMode = 'new(eye,pos)'
        return true
    end
    aimMode = 'unavailable'
    stat.aimFail = stat.aimFail + 1
    return false, 'cannot aim camera'
end

local function clickCentre()
    local cam = camera()
    if not cam then return false end
    local vp
    pcall(function() vp = cam.ViewportSize end)
    if vp then
        pcall(function() mousemoveabs(math.floor(vp.X / 2), math.floor(vp.Y / 2)) end)
    end
    local ok = pcall(mouse1click)
    if not ok then
        pcall(mouse1press)
        pcall(mouse1release)
    end
    stat.clicks = stat.clicks + 1
    return true
end

local function clickCustomer(g)
    if not g then return false, 'no customer' end
    if not g.pos then return false, 'no position for ' .. tostring(g.customerId) end
    local origin = rootPos()
    if origin then
        local dx, dz, dy = g.pos.X - origin.X, g.pos.Z - origin.Z, g.pos.Y - origin.Y
        local d2 = dx * dx + dz * dz
        if d2 > CONFIG.RangeXZ2 then
            return false, 'out of range d2=' .. math.floor(d2)
        end
        if math.abs(dy) > CONFIG.MaxY then
            return false, 'too high dy=' .. math.floor(dy)
        end
    end
    local ok, err = aimAt(g.pos)
    if not ok then return false, tostring(err) end
    task.wait(CONFIG.AimSettle)
    if not clickCentre() then return false, 'click failed' end
    return true, 'clicked ' .. tostring(g.groupId) .. ':' .. tostring(g.customerId)
end

