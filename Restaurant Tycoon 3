local function ready(key, gap)
    local t = nowT()
    local l = last[key]
    if l and (t - l) < gap then return false end
    last[key] = t
    return true
end

-- pack varargs so the pcall closure does not need `...` (that was the parse error)
local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(remote, ...)
    if not remote then return false end
    local a = packArgs(...)
    return (pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end))
end

local function invoke(remote, ...)
    if not remote then return false, nil end
    local a = packArgs(...)
    local ok, x, y = pcall(function() return remote:InvokeServer(unpackFn(a, 1, a.n)) end)
    if ok then return true, x, y end
    return false, nil
end

local function isValueClass(inst)
    local c = inst.ClassName
    return c == 'StringValue' or c == 'IntValue' or c == 'NumberValue' or c == 'ObjectValue'
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    local kids = ty:GetChildren()
    for i = 1, #kids do
        local p = kids[i]
        local ch = p:GetChildren()
        for j = 1, #ch do
            local c = ch[j]
            if c.ClassName == 'ObjectValue' and (c.Name == 'Owner' or c.Name == 'Player') then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    for i = 1, #kids do
        local p = kids[i]
        local ch = p:GetChildren()
        for j = 1, #ch do
            local sub = ch[j]:GetChildren()
            for k = 1, #sub do
                local c = sub[k]
                if c.ClassName == 'ObjectValue' then
                    local v
                    pcall(function() v = c.Value end)
                    if v == lp then return p end
                end
            end
        end
    end
    return nil
end

local function surfaceList(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    local ch = surface:GetChildren()
    for i = 1, #ch do out[#out + 1] = ch[i] end
    return out
end

local function surfacesWith(ty, childName)
    local out = {}
    local list = surfaceList(ty)
    for i = 1, #list do
        local m = list[i]
        local has = false
        pcall(function() has = (m:FindFirstChild(childName) ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

local function seatsOf(model)
    local out = {}
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if not ok or not desc then return out end
    for i = 1, #desc do
        if desc[i].ClassName == 'Seat' then out[#out + 1] = desc[i] end
    end
    return out
end

local function tableFree(m)
    if not m or not m.Parent then return false end
    if m:FindFirstChild('Bill') then return false end
    if m:FindFirstChild('Trash') then return false end
    local atts = { 'Occupied', 'IsOccupied', 'InUse', 'Taken' }
    for i = 1, #atts do
        local v
        pcall(function() v = m:GetAttribute(atts[i]) end)
        if v then return false end
    end
    local seats = seatsOf(m)
    for i = 1, #seats do
        local occ
        pcall(function() occ = seats[i].Occupant end)
        if occ then return false end
    end
    return true
end

local function foodFolder(ty)
    if not ty then return nil end
    local objs = ty:FindFirstChild('Objects')
    if not objs then return nil end
    return objs:FindFirstChild('Food') or objs:FindFirstChild('Foods')
end

local function attrOrChild(model, name)
    if not model then return nil end
    local v
    pcall(function() v = model:GetAttribute(name) end)
    if v ~= nil then return tostring(v) end
    local ok, c = pcall(function() return model:FindFirstChild(name) end)
    if ok and c and isValueClass(c) then
        local val
        pcall(function() val = c.Value end)
        if val ~= nil then return tostring(val) end
    end
    return nil
end

local function speechList()
    local out = {}
    local pg
    pcall(function() pg = lp:FindFirstChild('PlayerGui') end)
    if not pg then return out end
    local kids = pg:GetChildren()
    for i = 1, #kids do
        local gui = kids[i]
        if gui.Name == 'CustomerSpeechUI' then
            local adornee
            pcall(function() adornee = gui.Adornee end)
            if adornee then
                local node = adornee
                local model = nil
                for d = 1, 6 do
                    local ok, p = pcall(function() return node.Parent end)
                    if not ok or not p then break end
                    node = p
                    if node.ClassName == 'Model' then model = node break end
                end
                local grp = model and model.Parent
                if model and grp then
                    local header, text
                    pcall(function() header = gui:FindFirstChild('Header', true) end)
                    if header then pcall(function() text = header.Text end) end
                    out[#out + 1] = {
                        customerId = model.Name,
                        groupId = grp.Name,
                        waitingTable = string.find(string.lower(text or ''), 'table for', 1, true) ~= nil,
                        key = grp.Name .. ':' .. model.Name,
                    }
                end
            end
        end
    end
    return out
end

local function pick(list, idx)
    if #list == 0 then return nil, idx end
    if idx > #list then idx = 1 end
    return list[idx], idx + 1
end

local function seat(ty, entry, table)
    local tc = ev('Restaurant', 'TaskCompleted')
    if not tc or not ty or not entry or not table then return false end
    return fire(tc, { FurnitureModel = table, Tycoon = ty, Name = 'SendToTable', GroupId = entry.groupId })
end

local function takeOrder(ty, entry)
    local tc = ev('Restaurant', 'TaskCompleted')
    local ca = ev('Restaurant', 'CustomerActionReplicated')
    if not tc or not ty or not entry then return false end
    local ok = fire(tc, { GroupId = entry.groupId, Tycoon = ty, Name = 'TakeOrder', CustomerId = entry.customerId })
    if ca then pcall(function() ca:FireServer(ty, 'SetCustomerState', entry.customerId, entry.groupId, 'WaitingForDish') end) end
    if ok then stat.order = stat.order + 1 end
    return ok
end

local function serveFood(ty, food, customerId, groupId)
    local tc = ev('Restaurant', 'TaskCompleted')
    if not tc or not ty or not food then return false end
    local ok = fire(tc, { Name = 'Serve', Tycoon = ty, FoodModel = food, CustomerId = customerId, GroupId = groupId })
    if ok then stat.serve = stat.serve + 1 end
    return ok
end

local function grabFood(food)
    local gf = ev('Restaurant', 'GrabFood')
    return invoke(gf, food)
end

local function collect(ty, childName, taskName)
    local list = surfacesWith(ty, childName)
    if #list == 0 then return 0 end
    local tc = ev('Restaurant', 'TaskCompleted')
    local n = 0
    for i = 1, math.min(#list, 12) do
        if fire(tc, { Tycoon = ty, Name = taskName, FurnitureModel = list[i] }) then n = n + 1 end
    end
    return n
end

local function cook()
    local ci = ev('Cook', 'CookInputRequested')
    if not ci then return false end
    return fire(ci, 'Interact', workspace, 'Oven')
end

local function cookPrompts()
    local temp = workspace:FindFirstChild('Temp')
    if not temp then return end
    local ok, desc = pcall(function() return temp:GetDescendants() end)
    if not ok or not desc then return end
    local n = 0
    for i = 1, #desc do
        local d = desc[i]
        if d.ClassName == 'ProximityPrompt' then
            local act
            pcall(function() act = d.ActionText end)
            if act == 'Cook' then
                pcall(fireproximityprompt, d)
                n = n + 1
                if n >= 6 then break end
            end
        end
    end
end

local function calmRude(ty, entry)
    local g = ev('Restaurant', 'GetRudeCustomerDialog')
    local dc = ev('Dialog', 'DialogCompleted')
    if not g or not ty or not entry then return false end
    local ok, res = invoke(g, ty, entry.customerId, entry.groupId)
    if not ok then return false end
    local worth = false
    if type(res) == 'string' then
        local low = string.lower(res)
        worth = low ~= '' and not string.find(low, 'already', 1, true) and not string.find(low, 'not rude', 1, true)
    else
        worth = res ~= nil
    end
    if not worth then return false end
    pcall(function() g:InvokeServer(ty, entry.customerId, entry.groupId, 'We really appreciate you bringing this to our attention.') end)
    if dc then fire(dc) end
    stat.rude = stat.rude + 1
    return true
end

local function carsOf(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCars')
    if not cc then return out end
    local kids = cc:GetChildren()
    for i = 1, #kids do
        if tonumber(kids[i].Name) then out[#out + 1] = kids[i].Name end
    end
    table.sort(out, function(a, b) return tonumber(a) < tonumber(b) end)
    return out
end

local function driveThru(ty)
    local food = foodFolder(ty)
    if not food then return end
    local kids = food:GetChildren()
    if #kids == 0 then return end
    local cars = carsOf(ty)
    if #cars == 0 then return end
    local tc = ev('Restaurant', 'TaskCompleted')
    local f = kids[1]
    grabFood(f)
    local carId = attrOrChild(f, 'CarId') or cars[1]
    fire(tc, { Name = 'Serve', Tycoon = ty, FoodModel = f, CarId = carId })
    fire(tc, { Name = 'CollectDriveThruBill', Tycoon = ty, CarId = carId })
end

local function dropMoney()
    local df = workspace:FindFirstChild('DropFolder')
    if not df then return end
    local ch = df:GetChildren()
    if #ch == 0 then return end
    local c
    pcall(function() c = lp.Character end)
    if not c then return end
    local hrp = c:FindFirstChild('HumanoidRootPart')
    if not hrp then return end
    local home
    pcall(function() home = hrp.CFrame end)
    for i = 1, math.min(#ch, 8) do
        local d = ch[i]
        local pos
        pcall(function() pos = d.Position end)
        if pos then
            pcall(function() hrp.CFrame = CFrame.new(pos) end)
            task.wait(0.08)
        end
    end
    if home and CONFIG.DropReturn then pcall(function() hrp.CFrame = home end) end
end

local function safeToggle(sec, id, label, default, cb)
    local variants = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeSlider(sec, id, label, min, max, default, cb)
    local variants = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    local variants = {
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function reg(id, label, key)
    toggles[#toggles + 1] = { id = id, name = label, key = key }
end

local function report()
    local ty = findTycoon()
    local food = ty and foodFolder(ty)
    local sp = speechList()
    local line = 'tycoon=' .. tostring(ty ~= nil) ..
        ' food=' .. tostring(food and #food:GetChildren() or -1) ..
        ' bills=' .. tostring(ty and #surfacesWith(ty, 'Bill') or -1) ..
        ' trash=' .. tostring(ty and #surfacesWith(ty, 'Trash') or -1) ..
        ' speech=' .. tostring(#sp) ..
        ' cook=' .. tostring(stat.cook) ..
        ' seat=' .. tostring(stat.seat) ..
        ' order=' .. tostring(stat.order) ..
        ' serve=' .. tostring(stat.serve) ..
        ' dishes=' .. tostring(stat.dishes) ..
        ' billsDone=' .. tostring(stat.bills) ..
        ' tips=' .. tostring(stat.tips)
    print('[RT3] ' .. line)
    pcall(function() notify('RT3', line, 6) end)
end

local function teleport(where)
