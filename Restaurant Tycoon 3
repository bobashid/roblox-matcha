local NAME    = 'RestaurantTycoon3'
local VERSION = '3.1.0'
print('[Restaurant Tycoon 3] v' .. VERSION)

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local CONFIG = {
    Dish  = true,
    Seat  = true,
    Cycle = 0.4,
    SeatEvery = 2.0,
}

local running = true
local toggles = {}
local lastSeat = 0
local grabs = 0

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }

local function ev(folder, name)
    local ok, r = pcall(function()
        local f = RS:FindFirstChild('Events')
        f = f and f:FindFirstChild(folder)
        return f and f:FindFirstChild(name)
    end)
    if ok then return r end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        local ov = p:FindFirstChild('Player')
        if ov then
            local v
            pcall(function() v = ov.Value end)
            if v == lp then return p end
        end
    end
    return nil
end

local function myPrompts(ty, want)
    local out = {}
    if not ty then return out end
    local ok, desc = pcall(function() return ty:GetDescendants() end)
    if not ok or not desc then return out end
    for i = 1, #desc do
        local d = desc[i]
        if d.ClassName == 'ProximityPrompt' and d.Name == want then
            out[#out + 1] = d
        end
    end
    return out
end

local function seatFree(prompt)
    local att = prompt.Parent
    local base = att and att.Parent
    if not base then return false end
    local ok, seat = pcall(function() return base:FindFirstChildOfClass('Seat') end)
    if ok and seat then
        local occ
        pcall(function() occ = seat.Occupant end)
        if occ then return false end
    end
    return true
end

local function foodList(ty)
    local out = {}
    if not ty then return out end
    local objs = ty:FindFirstChild('Objects')
    local food = objs and objs:FindFirstChild('Food')
    if not food then return out end
    for _, c in ipairs(food:GetChildren()) do
        local taken
        pcall(function() taken = c:GetAttribute('Taken') end)
        if not taken then out[#out + 1] = c end
    end
    return out
end

local function tryGrab(model)
    local gf = ev('Restaurant', 'GrabFood')
    if not gf or not model then return false end
    local ok, res = pcall(function() return gf:InvokeServer(model) end)
    if not ok then return false end
    return (res == true or type(res) == 'table')
end

local function safeToggle(sec, id, label, default, cb)
    local variants = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeSlider(sec, id, label, min, max, default, cb)
    local variants = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    local variants = {
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function reg(id, label, key)
    toggles[#toggles + 1] = { id = id, name = label, key = key }
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Restaurant', 'Left')
            safeToggle(main, 'rt3_dish', 'Auto Pickup Dishes', CONFIG.Dish, function(v) CONFIG.Dish = v end)
            reg('rt3_dish', 'Auto Pickup Dishes', 'Dish')
            safeToggle(main, 'rt3_seat', 'Auto Seat', CONFIG.Seat, function(v) CONFIG.Seat = v end)
            reg('rt3_seat', 'Auto Seat', 'Seat')
            safeSlider(main, 'rt3_seatevery', 'Seat Every x10', 5, 60, 20, function(v) CONFIG.SeatEvery = v / 10 end)
            safeButton(main, 'Report', function()
                local ty = findTycoon()
                local f = ty and foodList(ty)
                pcall(function()
                    notify('RT3', 'food=' .. tostring(f and #f or -1) .. ' grabs=' .. tostring(grabs), 4)
                end)
                print('[RT3] food=' .. tostring(f and #f or -1) .. ' grabs=' .. tostring(grabs))
            end)
            safeButton(main, 'Stop', function() stop() end)
        end)
    end)
end

task.spawn(function()
    while running do
        for i = 1, #toggles do
            local t = toggles[i]
            local ok, v = pcall(function() return UI.GetValue(t.id) end)
            if not ok or type(v) ~= 'boolean' then
                ok, v = pcall(function() return UI.GetValue(t.name) end)
            end
            if ok and type(v) == 'boolean' then
                CONFIG[t.key] = v
            end
        end
        task.wait(0.15)
    end
end)

task.spawn(function()
    while running do
        local ty = findTycoon()

        if CONFIG.Dish and ty then
            local list = foodList(ty)
            if #list > 0 then
                if tryGrab(list[1]) then grabs = grabs + 1 end
            end
        end

        -- one seat per interval at most, so 8 free seats cannot be spammed
        if CONFIG.Seat and ty then
            local t = nowT()
            if (t - lastSeat) >= CONFIG.SeatEvery then
                local seats = myPrompts(ty, 'SeatPrompt')
                for i = 1, #seats do
                    local p = seats[i]
                    if seatFree(p) then
                        pcall(fireproximityprompt, p)
                        lastSeat = t
                        break
                    end
                end
            end
        end

        task.wait(CONFIG.Cycle)
    end
end)

print('[Restaurant Tycoon 3] running. Stop with: _G.RestaurantTycoon3.stop()')
