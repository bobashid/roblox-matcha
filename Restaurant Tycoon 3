    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local CONFIG = {
    Dish  = true,
    Serve = true,
    Seat  = true,
    Tips  = true,
    Bill  = true,
    Cycle     = 0.4,
    ServeGap  = 1.2,
    SeatGap   = 2.0,
    TipsEvery = 4.0,
    BillEvery = 2.0,
    Range     = 7.2,
}

local running = true
local toggles = {}
local tServe, tSeat, tTips, tBill = 0, 0, 0, 0
local held = nil
local guestIdx, tableIdx = 1, 1
local stat = { grabs = 0, serves = 0, seats = 0, tips = 0, bills = 0, skipped = 0 }

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }

local function ev(folder, name)
    local ok, r = pcall(function()
        local f = RS:FindFirstChild('Events')
        f = f and f:FindFirstChild(folder)
        return f and f:FindFirstChild(name)
    end)
    if ok then return r end
    return nil
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        local ov = p:FindFirstChild('Player')
        if ov then
            local v
            pcall(function() v = ov.Value end)
            if v == lp then return p end
        end
    end
    return nil
end

local function rootPos()
    local ok, c = pcall(function() return lp.Character end)
    if not ok or not c then return nil end
    local r = c:FindFirstChild('HumanoidRootPart')
    if not r then return nil end
    local ok2, p = pcall(function() return r.Position end)
    if ok2 and typeof(p) == 'Vector3' then return p end
    return nil
end

local function aPart(model)
    if not model then return nil end
    local ok, p = pcall(function() return model.PrimaryPart end)
    if ok and p then return p end
    local ok2, d = pcall(function() return model:FindFirstChildWhichIsA('BasePart', true) end)
    if ok2 and d then return d end
    return nil
end

-- distance gate: the captured payload carried Range = 7.2, so the server may validate it
local function inRange(model)
    local origin = rootPos()
    if not origin then return true end
    local part = aPart(model)
    if not part then return true end
    local ok, p = pcall(function() return part.Position end)
    if not ok or typeof(p) ~= 'Vector3' then return true end
    return (origin - p).Magnitude <= CONFIG.Range
end

local function interact(ty, model, key, promptId)
    local it = ev('Restaurant', 'Interactions')
    if not it or not ty or not model then return false end
    local part = aPart(model)
    local pos = Vector3.new(0, 0, 0)
    if part then
        local ok, p = pcall(function() return part.Position end)
        if ok and typeof(p) == 'Vector3' then pos = p end
    end
    local tbl = {
        Id = tostring(promptId or '1'),
        ActionText = '',
        WorldPosition = pos,
        GamepadKeyCode = Enum.KeyCode.Thumbstick1,
        TemporaryPart = part,
        KeyboardKeyCode = Enum.KeyCode.E,
        Range = CONFIG.Range,
        IsCustomerPrompt = true,
        Key = key,
        Model = model,
        Part = part,
        Prompt = promptId or 1,
        InteractionType = key,
        HoldDuration = 0,
    }
    return (pcall(function() it:FireServer(ty, tbl) end))
end

local function foodList(ty)
    local out = {}
    if not ty then return out end
    local objs = ty:FindFirstChild('Objects')
    local food = objs and objs:FindFirstChild('Food')
    if not food then return out end
    for _, c in ipairs(food:GetChildren()) do
        local taken
        pcall(function() taken = c:GetAttribute('Taken') end)
        if not taken then out[#out + 1] = c end
    end
    return out
end

local function tryGrab(model)
    local gf = ev('Restaurant', 'GrabFood')
    if not gf or not model then return false end
    local ok, res = pcall(function() return gf:InvokeServer(model) end)
    if not ok then return false end
    return (res == true or type(res) == 'table')
end

local function guestList(ty)
    local out = {}
    if not ty then return out end
    local cc = ty:FindFirstChild('ClientCustomers')
    if not cc then return out end
    for _, g in ipairs(cc:GetChildren()) do
        local ok, kids = pcall(function() return g:GetChildren() end)
        if ok and kids and #kids > 0 then
            local any = false
            for _, c in ipairs(kids) do
                if tonumber(c.Name) then any = true end
            end
            if any then out[#out + 1] = { GroupId = g.Name, Folder = g } end
        end
    end
    return out
end

local function customersOf(guest)
    local out = {}
    if not guest or not guest.Folder then return out end
    local ok, kids = pcall(function() return guest.Folder:GetChildren() end)
    if not ok or not kids then return out end
    for _, c in ipairs(kids) do
        if tonumber(c.Name) then out[#out + 1] = c.Name end
    end
    return out
end

local function tableList(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do
        local busy = false
        pcall(function()
            if m:FindFirstChild('Bill') then busy = true end
        end)
        if not busy then out[#out + 1] = m end
    end
    return out
end

local function seat(ty, guest, table)
    local tc = ev('Restaurant', 'TaskCompleted')
    if not tc or not ty or not guest or not table then return false end
    if not inRange(table) then stat.skipped = stat.skipped + 1 return false end
    interact(ty, table, 'SendToTable', 1)
    task.wait(0.05)
    local payload = {
        FurnitureModel = table,
        GroupId = guest.GroupId,
        Tycoon = ty,
        Name = 'SendToTable',
    }
    local ok = pcall(function() tc:FireServer(payload) end)
    if ok then stat.seats = stat.seats + 1 end
    return ok
end

local function serve(ty, guest, customerId, foodModel)
    local tc = ev('Restaurant', 'TaskCompleted')
    if not tc or not ty or not guest or not foodModel then return false end
    if not inRange(foodModel) then stat.skipped = stat.skipped + 1 return false end
    interact(ty, foodModel, 'Serve', 1)
    task.wait(0.05)
    local payload = {
        Name = 'Serve',
        Tycoon = ty,
        GroupId = guest.GroupId,
        CustomerId = customerId,
        FoodModel = foodModel,
    }
    local ok = pcall(function() tc:FireServer(payload) end)
    if ok then stat.serves = stat.serves + 1 end
    return ok
end

local function takeTips(ty)
    local tc = ev('Restaurant', 'TipsCollected')
    if not tc or not ty then return false end
    local ok = pcall(function() tc:FireServer(ty) end)
    if ok then stat.tips = stat.tips + 1 end
    return ok
end

local function billTargets(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do
        local hasBill = false
        pcall(function() hasBill = (m:FindFirstChild('Bill') ~= nil) end)
        if hasBill then out[#out + 1] = m end
    end
    return out
end

local function takeBill(ty, model)
    local tc = ev('Restaurant', 'TaskCompleted')
    if not tc or not ty or not model then return false end
    if not inRange(model) then stat.skipped = stat.skipped + 1 return false end
    interact(ty, model, 'CollectBill', 142)
    task.wait(0.05)
    local payload = { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model }
    local ok = pcall(function() tc:FireServer(payload) end)
    if ok then stat.bills = stat.bills + 1 end
    return ok
end

local function safeToggle(sec, id, label, default, cb)
    local variants = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeSlider(sec, id, label, min, max, default, cb)
    local variants = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    local variants = {
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }
    for i = 1, #variants do
        if pcall(variants[i]) then return true end
    end
    return false
end

local function reg(id, label, key)
    toggles[#toggles + 1] = { id = id, name = label, key = key }
end

local function report()
    local ty = findTycoon()
    local f = ty and foodList(ty)
    local g = ty and guestList(ty)
    local tl = ty and tableList(ty)
    local b = ty and billTargets(ty)
    local origin = rootPos()
    local line = 'counter=' .. tostring(f and #f or -1) ..
                 ' held=' .. tostring(held and held.Name or 'nil') ..
                 ' guests=' .. tostring(g and #g or -1) ..
                 ' tables=' .. tostring(tl and #tl or -1) ..
                 ' grabs=' .. tostring(stat.grabs) ..
                 ' serves=' .. tostring(stat.serves) ..
                 ' seats=' .. tostring(stat.seats) ..
                 ' tips=' .. tostring(stat.tips) ..
                 ' bills=' .. tostring(stat.bills) ..
                 ' skippedOutOfRange=' .. tostring(stat.skipped) ..
                 ' dist=' .. tostring(origin and (#b > 0 and math.floor((origin - (aPart(b[1]) and aPart(b[1]).Position or origin)).Magnitude) or 0) or -1)
    print('[RT3] ' .. line)
    pcall(function() notify('RT3', line, 6) end)
end

