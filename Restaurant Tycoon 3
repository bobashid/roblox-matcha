task.spawn(function()
    while running do
        local ty = findTycoon()

        if ty and (CONFIG.Cook or CONFIG.InstantCook) then
            if CONFIG.InstantCook then
                if ready('cook', 0.06) then cook() stat.cook = stat.cook + 1 end
            elseif CONFIG.Cook and ready('cook', 0.25) then
                cook()
                stat.cook = stat.cook + 1
                if ready('cookp', 0.5) then cookPrompts() end
            end
        end

        if ty and (CONFIG.Seat or CONFIG.TakeOrder or CONFIG.GiveFood or CONFIG.CalmRude) then
            local sp = speechList()
            if #sp > 0 then
                if CONFIG.TakeOrder and ready('order', 0.08) then
                    local e
                    e, idxOrder = pick(sp, idxOrder)
                    if e and not e.waitingTable then takeOrder(ty, e) end
                end
                if CONFIG.Seat and ready('seat', 0.3) then
                    local e
                    e, idxSeat = pick(sp, idxSeat)
                    if e and e.waitingTable then
                        local tables = surfaceList(ty)
                        local m
                        m, idxTable = pick(tables, idxTable)
                        if m and tableFree(m) then
                            if seat(ty, e, m) then stat.seat = stat.seat + 1 end
                        end
                    end
                end
                if CONFIG.GiveFood and ready('serve', 0.15) then
                    local food = foodFolder(ty)
                    local kids = food and food:GetChildren() or {}
                    local f = kids[1]
                    if f and f.Parent then
                        grabFood(f)
                        local cid = attrOrChild(f, 'CustomerId')
                        local gid = attrOrChild(f, 'GroupId')
                        if not cid then
                            local e
                            e, idxOrder = pick(sp, idxOrder)
                            if e then cid, gid = e.customerId, e.groupId end
                        end
                        if cid and gid then serveFood(ty, f, cid, gid) end
                    end
                end
                if CONFIG.CalmRude and ready('rude', 0.4) then
                    local e
                    e, idxSeat = pick(sp, idxSeat)
                    if e then calmRude(ty, e) end
                end
            end
        end

        if ty and CONFIG.Dishes and ready('dishes', 0.3) then
            stat.dishes = stat.dishes + collect(ty, 'Trash', 'CollectDishes')
        end

        if ty and CONFIG.Bills and ready('bills', 0.3) then
            stat.bills = stat.bills + collect(ty, 'Bill', 'CollectBill')
        end

        if ty and CONFIG.Tips and ready('tips', 0.5) then
            if fire(ev('Restaurant', 'TipsCollected'), ty) then stat.tips = stat.tips + 1 end
        end

        if ty and CONFIG.DriveThru and ready('drive', 0.4) then driveThru(ty) end
        if CONFIG.DropMoney and ready('drop', 4) then dropMoney() end

        task.wait(CONFIG.Cycle)
    end
end)

