local function pollToggle()
    local function getv(id, name)
        local ok, v = pcall(function() return UI.GetValue(id) end)
        if not ok or type(v) ~= 'boolean' then
            ok, v = pcall(function() return UI.GetValue(name) end)
        end
        if ok and type(v) == 'boolean' then return v end
        return nil
    end
    local s = getv('rt3_serve', 'Auto Serve Food')
    if s ~= nil then CONFIG.Serve = s end
    local st = getv('rt3_seat', 'Auto Seat Customers')
    if st ~= nil then CONFIG.Seat = st end
    local o = getv('rt3_orders', 'Auto Take Order')
    if o ~= nil then CONFIG.Orders = o end
    local b = getv('rt3_bills', 'Auto Collect Bills')
    if b ~= nil then CONFIG.Bills = b end
    local d = getv('rt3_dishes', 'Auto Pickup Dishes')
    if d ~= nil then CONFIG.Dishes = d end
    local t = getv('rt3_tips', 'Auto Collect Tips')
    if t ~= nil then CONFIG.Tips = t end
end

task.spawn(function()
    while running do
        pollToggle()
        task.wait(0.15)
    end
end)

task.spawn(function()
    local lastMsgT = 0
    while running do
        stat.passes = stat.passes + 1
        local ty = findTycoon()
        local t = nowT()

        if ty then
            if CONFIG.Serve and (t - lastServe) >= CONFIG.ServeEvery then
                lastServe = t
                local ok, d = oneServe(ty)
                if ok then
                    note('served: ' .. tostring(d))
                elseif d ~= 'no dishes on counter' and d ~= 'no customers' and (t - lastMsgT) > 12 then
                    note('serve idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Seat and (t - lastSeat) >= CONFIG.SeatEvery then
                lastSeat = t
                local ok, d = oneSeat(ty)
                if ok then
                    note('seated: ' .. tostring(d))
                elseif d ~= 'no customers' and d ~= 'no free TABLES' and (t - lastMsgT) > 12 then
                    note('seat idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Orders and (t - lastOrder) >= CONFIG.OrderEvery then
                lastOrder = t
                local ok, d = oneOrder(ty)
                if ok then
                    note('order taken')
                elseif d ~= 'no customers' and (t - lastMsgT) > 12 then
                    note('order idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Bills and (t - lastBill) >= CONFIG.BillEvery then
                lastBill = t
                local ok, d = oneBill(ty)
                if ok then
                    note('bill: ' .. tostring(d))
                elseif d ~= 'no bills' and (t - lastMsgT) > 12 then
                    note('bill idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Dishes and (t - lastDish) >= CONFIG.DishEvery then
                lastDish = t
                local ok, d = oneDish(ty)
                if ok then
                    note('dish: ' .. tostring(d))
                elseif d ~= 'no trash' and (t - lastMsgT) > 12 then
                    note('dish idle: ' .. tostring(d))
                    lastMsgT = t
                end
            end

            if CONFIG.Tips and (t - lastTips) >= CONFIG.TipsEvery then
                lastTips = t
                takeTips(ty)
            end
        else
            if (t - lastMsgT) > 12 then
                note('idle: tycoon not found')
                lastMsgT = t
            end
        end

        task.wait(CONFIG.Gap)
    end
end)

