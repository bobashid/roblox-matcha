-- Version: 6.0.0 -- AUTO MONEY ONLY (bills from tables + tips)
--
-- Built from the user's own Remote Spy captures (2026-10-27). Collecting a table bill is
-- TWO calls, in this order:
--   1) Events.Restaurant.Interactions.Interacted:FireServer(tycoon, {
--        Id="1", ActionText="", WorldPosition=<part pos>, GamepadKeyCode=1000,
--        TemporaryPart=Part, KeyboardKeyCode=101, Range=7.2, IsCustomerPrompt=true,
--        Key="CollectBill", Model=<Items.Surface.T?>, Part=Part, Prompt=1,
--        InteractionType="CollectBill", HoldDuration=0 })
--   2) Events.Restaurant.TaskCompleted:FireServer({
--        Tycoon=tycoon, Name="CollectBill", FurnitureModel=<same Surface model> })
-- Tips is a single call: Events.Restaurant.TipsCollected:FireServer(tycoon).
--
-- The bill target is the Items.Surface MODEL that contains a `Bill` child - not the Bill.
-- The first capture used Id="142"/Prompt=142, the second Id="1"/Prompt=1, so the Id is just a
-- prompt number: it is sent as captured ("1") which the second capture proves is accepted.
--
-- Upgrades excluded. No Instance.new. ClassName tests only (IsA is always true in Matcha).
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '6.0.0'
print('[Restaurant Tycoon 3] v' .. VERSION .. ' (auto money)')

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    Bills = true,
    Tips  = true,
    Gap       = 0.25,
    TipsEvery = 1.0,
    MaxBills  = 12,
}

local running = true
local stat = { bills = 0, tips = 0, passes = 0 }
local lastTips = 0

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s) print('[RT3] ' .. s) end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

-- `...` inside a nested closure is a parse error, so pack and unpack
local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(remote, ...)
    if not remote then return false, 'missing' end
    local a = packArgs(...)
    local ok, err = pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end)
    return ok, err
end

local EV = RS:FindFirstChild('Events')
local function remote(folderName, remoteName)
    if not EV then return nil end
    local f = folderName and EV:FindFirstChild(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' then
                return c
            end
        end
    end
    return f:FindFirstChild(remoteName)
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

-- first BasePart under a model, for Part / TemporaryPart / WorldPosition
local function aPart(model)
    if not model then return nil end
    local ok, p = pcall(function() return model.PrimaryPart end)
    if ok and p and p.ClassName ~= 'Model' then return p end
    local ok2, d = pcall(function() return model:FindFirstChildWhichIsA('BasePart', true) end)
    if ok2 and d then return d end
    -- fallback: scan for a Part/MeshPart/UnionOperation by ClassName
    local ok3, desc = pcall(function() return model:GetDescendants() end)
    if ok3 and desc then
        for _, x in ipairs(desc) do
            local cn = x.ClassName
            if cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation' or cn == 'WedgePart' then
                return x
            end
        end
    end
    return nil
end

-- Surface models that currently hold a Bill child
local function billTargets(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, m in ipairs(surface:GetChildren()) do
        local has = false
        pcall(function() has = (m:FindFirstChild('Bill') ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

-- the captured pair, in the captured order and shape
local function collectBill(ty, model)
    local it = remote('Restaurant', 'Interactions')
    local tc = remote('Restaurant', 'TaskCompleted')
    if not ty or not model then return false, 'missing tycoon/model' end
    if not tc then return false, 'TaskCompleted missing' end

    local part = aPart(model)
    local pos = Vector3.new(0, 0, 0)
    if part then
        local ok, p = pcall(function() return part.Position end)
        if ok and typeof(p) == 'Vector3' then pos = p end
    end

    if it then
        fire(it, ty, {
            Id = '1',
            ActionText = '',
            WorldPosition = pos,
            GamepadKeyCode = 1000,
            TemporaryPart = part,
            KeyboardKeyCode = 101,
            Range = 7.2,
            IsCustomerPrompt = true,
            Key = 'CollectBill',
            Model = model,
            Part = part,
            Prompt = 1,
            InteractionType = 'CollectBill',
            HoldDuration = 0,
        })
    end

    task.wait(0.04)

    local ok, err = fire(tc, { Tycoon = ty, Name = 'CollectBill', FurnitureModel = model })
    if ok then stat.bills = stat.bills + 1 end
    return ok, err
end

local function takeTips(ty)
    local tips = remote('Restaurant', 'TipsCollected')
    if not tips or not ty then return false, 'TipsCollected missing' end
    local ok, err = fire(tips, ty)
    if ok then stat.tips = stat.tips + 1 end
    return ok, err
end

local function collectAllBills(ty)
    local list = billTargets(ty)
    if #list == 0 then return 0 end
    local n = 0
    for i = 1, math.min(#list, CONFIG.MaxBills) do
        local ok = collectBill(ty, list[i])
        if ok then n = n + 1 end
    end
    return n
end

local function report()
    local ty = findTycoon()
    local list = ty and billTargets(ty) or {}
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('bills on tables=' .. #list)
    for i, m in ipairs(list) do
        if i <= 6 then note('  bill on ' .. m.Name) end
    end
    note('remote Interactions=' .. tostring(remote('Restaurant', 'Interactions') ~= nil))
    note('remote TaskCompleted=' .. tostring(remote('Restaurant', 'TaskCompleted') ~= nil))
    note('remote TipsCollected=' .. tostring(remote('Restaurant', 'TipsCollected') ~= nil))
    note('bills=' .. stat.bills .. ' tips=' .. stat.tips .. ' passes=' .. stat.passes)
    note('--- end ---')
end

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Auto Money', 'Left')
            safeToggle(main, 'rt3_bills', 'Auto Collect Bills', CONFIG.Bills, function(v) CONFIG.Bills = v end)
            safeToggle(main, 'rt3_tips', 'Auto Collect Tips', CONFIG.Tips, function(v) CONFIG.Tips = v end)
            safeButton(main, 'Collect Bills Now', function()
                local ty = findTycoon()
                local n = collectAllBills(ty)
                note('bills fired: ' .. n)
            end)
            safeButton(main, 'Collect Tips Now', function()
                local ty = findTycoon()
                local ok = takeTips(ty)
                note('tips fired: ' .. tostring(ok))
            end)
            safeButton(main, 'Report', function() report() end)
            safeButton(main, 'Stop', function() stop() end)
        end)
    end)
end

local function pollToggle()
    local ok, v = pcall(function() return UI.GetValue('rt3_bills') end)
    if not ok or type(v) ~= 'boolean' then
        ok, v = pcall(function() return UI.GetValue('Auto Collect Bills') end)
    end
    if ok and type(v) == 'boolean' then CONFIG.Bills = v end
    local ok2, v2 = pcall(function() return UI.GetValue('rt3_tips') end)
    if not ok2 or type(v2) ~= 'boolean' then
        ok2, v2 = pcall(function() return UI.GetValue('Auto Collect Tips') end)
    end
    if ok2 and type(v2) == 'boolean' then CONFIG.Tips = v2 end
end

task.spawn(function()
    while running do
        pollToggle()
        task.wait(0.15)
    end
end)

task.spawn(function()
    local lastMsg, lastMsgT = '', 0
    while running do
        stat.passes = stat.passes + 1
        local ty = findTycoon()
        if ty then
            if CONFIG.Bills then
                local n = collectAllBills(ty)
                if n > 0 then
                    note('bills collected: ' .. n)
                elseif (nowT() - lastMsgT) > 12 then
                    note('idle: no bills on tables')
                    lastMsgT = nowT()
                end
            end
            if CONFIG.Tips and (nowT() - lastTips) >= CONFIG.TipsEvery then
                takeTips(ty)
                lastTips = nowT()
            end
        else
            if (nowT() - lastMsgT) > 12 then
                note('idle: tycoon not found')
                lastMsgT = nowT()
            end
        end
        task.wait(CONFIG.Gap)
    end
end)

note('loaded. Collects table bills (2 calls, as captured) and tips.')
print('[Restaurant Tycoon 3] running. Stop with: _G.RestaurantTycoon3.stop()')
