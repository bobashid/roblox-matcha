-- toggle poller
task.spawn(function()
    while running do
        for _, t in ipairs(toggles) do
            local ok, v = pcall(function() return UI.GetValue(t.id) end)
            if not ok or type(v) ~= 'boolean' then
                ok, v = pcall(function() return UI.GetValue(t.name) end)
            end
            if ok and type(v) == 'boolean' then CONFIG[t.key] = v end
        end
        task.wait(0.15)
    end
end)

-- auto loop: silent until AutoRun is true
task.spawn(function()
    while running do
        if CONFIG.AutoRun then
            local ty = findTycoon()
            if ty then
                if (CONFIG.Cook or CONFIG.InstantCook) and ready('cook', 0.3) then doCook() end
                if CONFIG.Dishes and ready('dishes', 0.3) then doCollect(ty, 'Trash', 'CollectDishes', 'dishes') end
                if CONFIG.Bills and ready('bills', 0.3) then doCollect(ty, 'Bill', 'CollectBill', 'bills') end
                if CONFIG.Tips and ready('tips', 0.6) then doTips(ty) end
                if CONFIG.Seat and ready('seat', 0.4) then doSeat(ty) end
                if CONFIG.TakeOrder and ready('order', 0.3) then doOrder(ty) end
                if CONFIG.GiveFood and ready('serve', 0.4) then doServe(ty) end
            else
                if ready('noty', 5) then note('tycoon not found - retrying') end
            end
        end
        task.wait(CONFIG.Cycle)
    end
end)

