local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    AutoRun = false,          -- master: off until you have read Report once
    Cook = true, InstantCook = false, Seat = true, TakeOrder = true,
    GiveFood = true, Dishes = true, Bills = true, Tips = true,
    DriveThru = false, CalmRude = false, DropMoney = false,
    Cycle = 0.35,
}

local running = true
local toggles = {}
local last = {}
local log = {}      -- rolling action log, newest last
local stat = {}
local idxOrder, idxSeat, idxTable = 1, 1, 1

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s)
    log[#log + 1] = s
    if #log > 40 then table.remove(log, 1) end
    print('[RT3] ' .. s)
end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

local function bump(k)
    stat[k] = (stat[k] or 0) + 1
end

local function ready(key, gap)
    local t = nowT()
    local l = last[key]
    if l and (t - l) < gap then return false end
    last[key] = t
    return true
end

local function packArgs(...)
    return { n = select('#', ...), ... }
end

-- returns ok, err  -- ok is pcall success (no Lua error), NOT server acceptance
local function fire(remote, ...)
    if not remote then return false, 'remote missing' end
    local a = packArgs(...)
    local ok, err = pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end)
    return ok, err
end

local function invoke(remote, ...)
    if not remote then return false, 'remote missing', nil end
    local a = packArgs(...)
    local ok, x, y = pcall(function() return remote:InvokeServer(unpackFn(a, 1, a.n)) end)
    if ok then return true, x, y end
    return false, x, y
end

local EV = RS:FindFirstChild('Events')
local function folder(name)
    if not EV then return nil end
    if not name then return EV end
    return EV:FindFirstChild(name)
end

-- prefer a fireable class; UnreplicatedEvent cannot be fired from the client
local function remote(folderName, remoteName)
    local f = folder(folderName)
    if not f then return nil, 'folder ' .. tostring(folderName) .. ' missing' end
    local first, fireable = nil, nil
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            if not first then first = c end
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' or cn == 'RemoteFunction' then
                if not fireable then fireable = c end
            end
        end
    end
    if fireable then return fireable, 'ok(' .. fireable.ClassName .. ')' end
    if first then return first, 'WARN(' .. first.ClassName .. ')' end
    return nil, 'remote ' .. tostring(remoteName) .. ' missing'
end

local function isValueClass(inst)
    local c = inst.ClassName
    return c == 'StringValue' or c == 'IntValue' or c == 'NumberValue' or c == 'ObjectValue'
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

local function surfaceList(ty)
    local out = {}
    if not ty then return out end
    local items = ty:FindFirstChild('Items')
    local surface = items and items:FindFirstChild('Surface')
    if not surface then return out end
    for _, c in ipairs(surface:GetChildren()) do out[#out + 1] = c end
    return out
end

local function surfacesWith(ty, childName)
    local out = {}
    for _, m in ipairs(surfaceList(ty)) do
        local has = false
        pcall(function() has = (m:FindFirstChild(childName) ~= nil) end)
        if has then out[#out + 1] = m end
    end
    return out
end

local function seatsOf(model)
    local out = {}
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if not ok or not desc then return out end
    for _, d in ipairs(desc) do
        if d.ClassName == 'Seat' then out[#out + 1] = d end
    end
    return out
end

local function tableFree(m)
    if not m or not m.Parent then return false end
    if m:FindFirstChild('Bill') then return false end
    if m:FindFirstChild('Trash') then return false end
    for _, att in ipairs({ 'Occupied', 'IsOccupied', 'InUse', 'Taken' }) do
        local v
        pcall(function() v = m:GetAttribute(att) end)
        if v then return false end
    end
    for _, s in ipairs(seatsOf(m)) do
        local occ
        pcall(function() occ = s.Occupant end)
        if occ then return false end
    end
    return true
end

local function foodFolder(ty)
    if not ty then return nil end
    local objs = ty:FindFirstChild('Objects')
    if not objs then return nil end
    return objs:FindFirstChild('Food') or objs:FindFirstChild('Foods')
end

local function attrOrChild(model, name)
    if not model then return nil end
    local v
    pcall(function() v = model:GetAttribute(name) end)
    if v ~= nil then return tostring(v) end
    local ok, c = pcall(function() return model:FindFirstChild(name) end)
    if ok and c and isValueClass(c) then
        local val
        pcall(function() val = c.Value end)
        if val ~= nil then return tostring(val) end
    end
    return nil
end

local function speechList()
    local out = {}
    local pg
    pcall(function() pg = lp:FindFirstChild('PlayerGui') end)
    if not pg then return out end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui.Name == 'CustomerSpeechUI' then
            local adornee
            pcall(function() adornee = gui.Adornee end)
            if adornee then
                local node, model = adornee, nil
                for _ = 1, 6 do
                    local ok, p = pcall(function() return node.Parent end)
                    if not ok or not p then break end
                    node = p
                    if node.ClassName == 'Model' then model = node break end
                end
                local grp = model and model.Parent
                if model and grp then
                    local header, text
                    pcall(function() header = gui:FindFirstChild('Header', true) end)
                    if header then pcall(function() text = header.Text end) end
                    out[#out + 1] = {
                        customerId = model.Name,
                        groupId = grp.Name,
                        waitingTable = string.find(string.lower(text or ''), 'table for', 1, true) ~= nil,
                    }
                end
            end
        end
    end
    return out
end

local function pick(list, idx)
    if #list == 0 then return nil, idx end
    if idx > #list then idx = 1 end
    return list[idx], idx + 1
end

-- ===== actions, each returns ok, detail =====

local function doCollect(ty, childName, taskName, tag)
    local list = surfacesWith(ty, childName)
    if #list == 0 then return false, 'no ' .. childName .. ' surfaces' end
    local tc, why = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, why end
    local n, fails = 0, 0
    for i = 1, math.min(#list, 8) do
        local ok, err = fire(tc, { Tycoon = ty, Name = taskName, FurnitureModel = list[i] })
        if ok then n = n + 1 else fails = fails + 1 end
        if not ok then note(tag .. ' fire error: ' .. tostring(err)) end
    end
    bump(tag)
    return n > 0, ('fired ' .. n .. '/' .. #list .. ' fails=' .. fails .. ' (' .. why .. ')')
end

local function doTips(ty)
    local tips, why = remote('Restaurant', 'TipsCollected')
    if not tips then return false, why end
    local ok, err = fire(tips, ty)
    if ok then bump('tips') end
    return ok, tostring(why) .. (ok and ' fired' or (' error ' .. tostring(err)))
end

local function doCook()
    local ci, why = remote('Cook', 'CookInputRequested')
    if not ci then return false, why end
    local ok, err = fire(ci, 'Interact', workspace, 'Oven')
    if ok then bump('cook') end
    return ok, tostring(why) .. (ok and ' fired' or (' error ' .. tostring(err)))
end

local function doSeat(ty)
    local sp = speechList()
    if #sp == 0 then return false, 'no speech UI' end
    local entry
    entry, idxSeat = pick(sp, idxSeat)
    if not entry or not entry.waitingTable then return false, 'no guest waiting for a table' end
    local tables = surfaceList(ty)
    local m
    m, idxTable = pick(tables, idxTable)
    if not m then return false, 'no tables' end
    if not tableFree(m) then return false, 'table ' .. m.Name .. ' busy' end
    local tc, why = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, why end
    local ok, err = fire(tc, { FurnitureModel = m, Tycoon = ty, Name = 'SendToTable', GroupId = entry.groupId })
    if ok then bump('seat') end
    return ok, 'group ' .. entry.groupId .. ' -> ' .. m.Name .. ' ' .. tostring(why) .. (ok and '' or (' error ' .. tostring(err)))
end

local function doOrder(ty)
    local sp = speechList()
    if #sp == 0 then return false, 'no speech UI' end
    local entry
    entry, idxOrder = pick(sp, idxOrder)
    if not entry or entry.waitingTable then return false, 'no guest waiting to order' end
    local tc, why = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, why end
    local ok, err = fire(tc, { GroupId = entry.groupId, Tycoon = ty, Name = 'TakeOrder', CustomerId = entry.customerId })
    local ca = remote('Restaurant', 'CustomerActionReplicated')
    if ca then
        pcall(function() ca:FireServer(ty, 'SetCustomerState', entry.customerId, entry.groupId, 'WaitingForDish') end)
    end
    if ok then bump('order') end
    return ok, entry.groupId .. ':' .. entry.customerId .. ' ' .. tostring(why) .. (ok and '' or (' error ' .. tostring(err)))
end

local function doServe(ty)
    local food = foodFolder(ty)
    if not food then return false, 'no Objects.Food' end
    local kids = food:GetChildren()
    if #kids == 0 then return false, 'no dishes on counter' end
    local f = kids[1]
    local gf, gwhy = remote('Restaurant', 'GrabFood')
    local gok, gres = invoke(gf, f)
    if not gok then return false, 'grab failed ' .. gwhy end
    local cid = attrOrChild(f, 'CustomerId')
    local gid = attrOrChild(f, 'GroupId')
    if not cid then
        local sp = speechList()
        local e = sp[1]
        if e then cid, gid = e.customerId, e.groupId end
    end
    if not cid then return false, 'dish has no CustomerId and no speech UI to fall back to' end
    local tc, why = remote('Restaurant', 'TaskCompleted')
    if not tc then return false, why end
    local ok, err = fire(tc, { Name = 'Serve', Tycoon = ty, FoodModel = f, CustomerId = cid, GroupId = gid })
    if ok then bump('serve') end
    return ok, 'dish ' .. f.Name .. ' -> ' .. tostring(gid) .. ':' .. tostring(cid) .. ' (grab=' .. tostring(gres) .. ')' .. (ok and '' or (' error ' .. tostring(err)))
end

-- ===== report =====

local function report()
    local ty = findTycoon()
    local food = ty and foodFolder(ty)
    local sp = speechList()
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('surfaces=' .. #surfaceList(ty) .. ' bills=' .. #surfacesWith(ty, 'Bill') .. ' trash=' .. #surfacesWith(ty, 'Trash'))
    note('dishes=' .. tostring(food and #food:GetChildren() or -1) .. ' speech=' .. #sp)
    local waitingTable, waitingOrder = 0, 0
    for _, e in ipairs(sp) do
        if e.waitingTable then waitingTable = waitingTable + 1 else waitingOrder = waitingOrder + 1 end
    end
    note('speechSeat=' .. waitingTable .. ' speechOrder=' .. waitingOrder)
    for _, pair in ipairs({
        { 'Restaurant', 'TaskCompleted' }, { 'Restaurant', 'GrabFood' },
        { 'Restaurant', 'TipsCollected' }, { 'Restaurant', 'CustomerActionReplicated' },
        { 'Cook', 'CookInputRequested' },
    }) do
        local r, why = remote(pair[1], pair[2])
        note('remote ' .. pair[1] .. '.' .. pair[2] .. ' = ' .. tostring(r and r.ClassName or 'MISSING') .. ' [' .. tostring(why) .. ']')
    end
    local keys = {}
    for k in pairs(stat) do keys[#keys + 1] = k end
    table.sort(keys)
    local parts = {}
    for _, k in ipairs(keys) do parts[#parts + 1] = k .. '=' .. tostring(stat[k]) end
    note('counters ' .. table.concat(parts, ' '))
    note('--- end ---')
end

-- ===== menu =====

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function reg(id, label, key)
    toggles[#toggles + 1] = { id = id, name = label, key = key }
end

local function runOnce(tag, fn)
    local ty = findTycoon()
    if not ty then note(tag .. ': tycoon NOT FOUND - everything depends on this') return end
    local ok, detail = fn(ty)
    note(tag .. ': ' .. (ok and 'OK ' or 'FAIL ') .. tostring(detail))
end

