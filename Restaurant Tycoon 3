-- Restaurant Tycoon 3 (place 119048529960596) - Matcha LuauVM
-- Version: 5.1.0 -- AUTO SERVE ONLY
--
-- Why v5.0.0 picked up nothing (from the user's log, 2026-10-27):
--   guests=0 on every Report, grabs=0, passes climbing.
--   servePass() checked guests FIRST and returned before ever calling GrabFood, so the
--   grab was never attempted. "Nothing picked up" was that ordering, not a broken grab.
--
-- v5.1.0 fixes the order and keeps hands clean:
--   1. grab one dish (GrabFood:InvokeServer)
--   2. try Serve on every guest found by any known source
--   3. if no serve was accepted, CancelGrabRequested so the dish does NOT stay stuck in hand
--      (the user's complaint: "it bugs me so i cant give it to them myself")
--
-- Guest sources tried, in order, and logged with counts so the log names the live one:
--   a) Tycoon.ClientCustomers   -> folder name = GroupId, child model name = CustomerId
--   b) Tycoon descendants       -> any Model with a Humanoid that is not the local character
--   c) workspace.EatingFoods    -> children models
-- Names are opaque strings - never validated with tonumber().
--
-- Upgrades excluded. No Instance.new. ClassName tests only (IsA always true in Matcha).
-- Loader:
-- loadstring(game:HttpGet("https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/Restaurant%20Tycoon%203?v=" .. tostring(os.time()), true))()

local NAME    = 'RestaurantTycoon3'
local VERSION = '5.1.0'
print('[Restaurant Tycoon 3] v' .. VERSION .. ' (auto serve only)')

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer
local unpackFn = table.unpack or unpack

local CONFIG = {
    Serve = true,
    Gap   = 0.18,
    ServeGap = 0.25,
    MaxGuests = 8,
}

local running = true
local stat = { grabs = 0, serves = 0, passes = 0, cancels = 0 }
local lastServe = 0
local lastSrc = ''

local function nowT()
    if type(tick) == 'function' then return tick() end
    return os.clock()
end

local function note(s)
    print('[RT3] ' .. s)
end

local function stop()
    running = false
    _G[NAME] = nil
    print('[Restaurant Tycoon 3] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

local function packArgs(...)
    return { n = select('#', ...), ... }
end

local function fire(remote, ...)
    if not remote then return false, 'missing' end
    local a = packArgs(...)
    local ok, err = pcall(function() remote:FireServer(unpackFn(a, 1, a.n)) end)
    return ok, err
end

local function invoke(remote, ...)
    if not remote then return false, 'missing', nil end
    local a = packArgs(...)
    local ok, x, y = pcall(function() return remote:InvokeServer(unpackFn(a, 1, a.n)) end)
    if ok then return true, x, y end
    return false, x, y
end

local EV = RS:FindFirstChild('Events')
local function remote(folderName, remoteName)
    if not EV then return nil end
    local f = folderName and EV:FindFirstChild(folderName) or EV
    if not f then return nil end
    for _, c in ipairs(f:GetChildren()) do
        if c.Name == remoteName then
            local cn = c.ClassName
            if cn == 'RemoteEvent' or cn == 'UnreliableRemoteEvent' or cn == 'RemoteFunction' then
                return c
            end
        end
    end
    return f:FindFirstChild(remoteName)
end

local function findTycoon()
    local ty = workspace:FindFirstChild('Tycoons')
    if not ty then return nil end
    for _, p in ipairs(ty:GetChildren()) do
        for _, c in ipairs(p:GetChildren()) do
            if c.ClassName == 'ObjectValue' then
                local v
                pcall(function() v = c.Value end)
                if v == lp then return p end
            end
        end
    end
    return nil
end

local function dishList(ty)
    local out = {}
    if not ty then return out end
    local objs = ty:FindFirstChild('Objects')
    if not objs then return out end
    local food = objs:FindFirstChild('Food') or objs:FindFirstChild('Foods')
    if not food then return out end
    for _, c in ipairs(food:GetChildren()) do
        out[#out + 1] = c
    end
    return out
end

local function cancelGrab()
    local c = remote('Restaurant', 'CancelGrabRequested')
    if c then
        local ok = fire(c)
        if ok then stat.cancels = stat.cancels + 1 end
    end
end

-- all guest sources, each returning { groupId, customerId }
local function guestSources(ty)
    local sources = {}

    -- a) ClientCustomers
    local a = {}
    local cc = ty and ty:FindFirstChild('ClientCustomers')
    if cc then
        for _, g in ipairs(cc:GetChildren()) do
            for _, c in ipairs(g:GetChildren()) do
                a[#a + 1] = { groupId = g.Name, customerId = c.Name }
            end
        end
    end
    sources[#sources + 1] = { tag = 'ClientCustomers', list = a }

    -- b) tycoon descendants with a Humanoid (skip our own character)
    local b = {}
    local myChar
    pcall(function() myChar = lp.Character end)
    if ty then
        local ok, desc = pcall(function() return ty:GetDescendants() end)
        if ok and desc then
            for _, d in ipairs(desc) do
                if d.ClassName == 'Model' and d ~= myChar and not (myChar and d:IsDescendantOf(myChar)) then
                    local h
                    pcall(function() h = d:FindFirstChildOfClass('Humanoid') end)
                    if h then
                        local grp = d.Parent
                        b[#b + 1] = { groupId = grp and grp.Name or '', customerId = d.Name }
                    end
                end
            end
        end
    end
    sources[#sources + 1] = { tag = 'tycoonHumanoids', list = b }

    -- c) workspace.EatingFoods children
    local c = {}
    local ef = workspace:FindFirstChild('EatingFoods')
    if ef then
        for _, m in ipairs(ef:GetChildren()) do
            c[#c + 1] = { groupId = '', customerId = m.Name }
        end
    end
    sources[#sources + 1] = { tag = 'EatingFoods', list = c }

    return sources
end

local function bestGuestList(ty)
    local sources = guestSources(ty)
    local best, bestTag = {}, 'none'
    local parts = {}
    for _, s in ipairs(sources) do
        parts[#parts + 1] = s.tag .. '=' .. #s.list
        if #s.list > #best then
            best, bestTag = s.list, s.tag
        end
    end
    return best, bestTag, table.concat(parts, ' ')
end

-- grab one dish, offer it to each guest, clean hands if nothing accepted
local function servePass(ty)
    local dishes = dishList(ty)
    if #dishes == 0 then return false, 'no dishes on counter' end

    local gf = remote('Restaurant', 'GrabFood')
    local tc = remote('Restaurant', 'TaskCompleted')
    if not gf or not tc then return false, 'remote missing' end

    local guests, srcTag, srcCounts = bestGuestList(ty)
    lastSrc = srcCounts

    local dish = dishes[1]
    if not dish or not dish.Parent then return false, 'dish vanished' end

    local gok, gres = invoke(gf, dish)
    if not gok then return false, 'grab call errored' end
    if gres == false then return false, 'grab refused by server (dish not grabbable now)' end
    stat.grabs = stat.grabs + 1

    if #guests == 0 then
        cancelGrab()
        return false, 'grabbed ' .. dish.Name .. ' then released: no guests (' .. srcCounts .. ')'
    end

    local tried, accepted = 0, 0
    for k = 1, math.min(#guests, CONFIG.MaxGuests) do
        local t = nowT()
        if (t - lastServe) >= CONFIG.ServeGap then
            lastServe = t
            local g = guests[k]
            local ok = fire(tc, {
                Name = 'Serve',
                Tycoon = ty,
                FoodModel = dish,
                CustomerId = g.customerId,
                GroupId = g.groupId,
            })
            tried = tried + 1
            if ok then accepted = accepted + 1 end
        end
    end

    stat.serves = stat.serves + accepted

    if accepted == 0 then
        cancelGrab()
        return false, 'served 0/' .. tried .. ' via ' .. srcTag .. ' (' .. srcCounts .. ')'
    end
    return true, 'fired ' .. accepted .. '/' .. tried .. ' via ' .. srcTag
end

local function report()
    local ty = findTycoon()
    local dishes = dishList(ty)
    local guests, srcTag, srcCounts = bestGuestList(ty)
    note('--- REPORT v' .. VERSION .. ' ---')
    note('tycoon=' .. tostring(ty and ty:GetFullName() or 'NIL'))
    note('dishes=' .. #dishes .. '  guests=' .. #guests .. ' via ' .. srcTag)
    note('sources ' .. srcCounts)
    for i, g in ipairs(guests) do
        if i <= 6 then note('  guest group=' .. tostring(g.groupId) .. ' id=' .. tostring(g.customerId)) end
    end
    for i, d in ipairs(dishes) do
        if i <= 4 then note('  dish ' .. d.Name) end
    end
    note('grabs=' .. stat.grabs .. ' serves=' .. stat.serves .. ' passes=' .. stat.passes .. ' cancels=' .. stat.cancels)
    note('--- end ---')
end

local function safeToggle(sec, id, label, default, cb)
    for _, v in ipairs({
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

local function safeButton(sec, label, cb)
    for _, v in ipairs({
        function() sec:Button(label, cb) end,
        function() sec:Button(label, label, cb) end,
    }) do
        if pcall(v) then return true end
    end
    return false
end

if UI then
    pcall(function()
        UI.AddTab('Restaurant Tycoon 3', function(tab)
            local main = tab:Section('Auto Serve', 'Left')
            safeToggle(main, 'rt3_serve', 'Auto Serve', CONFIG.Serve, function(v) CONFIG.Serve = v end)
            safeButton(main, 'Unstick My Hands', function()
                cancelGrab()
                note('cancel grab sent')
            end)
            safeButton(main, 'Report', function() report() end)
            safeButton(main, 'Stop', function() stop() end)
        end)
    end)
end

cancelGrab()
note('cleared grab state')

local function pollToggle()
    local ok, v = pcall(function() return UI.GetValue('rt3_serve') end)
    if not ok or type(v) ~= 'boolean' then
        ok, v = pcall(function() return UI.GetValue('Auto Serve') end)
    end
    if ok and type(v) == 'boolean' then CONFIG.Serve = v end
end

task.spawn(function()
    while running do
        pollToggle()
        task.wait(0.15)
    end
end)

task.spawn(function()
    local lastMsg, lastMsgT = '', 0
    while running do
        if CONFIG.Serve then
            stat.passes = stat.passes + 1
            local ty = findTycoon()
            if ty then
                local ok, why = servePass(ty)
                if not ok then
                    local t = nowT()
                    if why ~= lastMsg or (t - lastMsgT) > 10 then
                        note('idle: ' .. tostring(why))
                        lastMsg, lastMsgT = why, t
                    end
                end
            else
                local t = nowT()
                if (t - lastMsgT) > 10 then
                    note('idle: tycoon not found')
                    lastMsgT = t
                end
            end
        end
        task.wait(CONFIG.Gap)
    end
end)

note('loaded. Grabs first, serves to any guest found, releases the dish if none accepts.')
print('[Restaurant Tycoon 3] running. Stop with: _G.RestaurantTycoon3.stop()')
