-- ABOVE Island Admin
-- VERSION 7.1.0
-- place 124357835578554 (game.Name reports "Ugc" - match by place id)
--
-- Gives Helper to everyone who liked your island (the guest book signatures),
-- and draws each player's ROLE only above their head.
--
-- Role call: RequestFriendAction:FireServer("SetRole", <userId>, <roleName>)
--   Roles: Visitor, Helper, Builder, TrustedBuilder. "Visitor" = no access.
--
-- v7.1.0 fixes:
--   * The auto-grant depended on a SEPARATE 3 s loop having already read the guest
--     book. If the book had not been opened yet, bookSet was empty, nothing matched,
--     nothing was granted - and because myRoles stays empty the nametags could only
--     ever read "[?]". Both symptoms were this one cause. The auto pass now rescans
--     FIRST, then grants, so it is self-sufficient.
--   * Warns once when auto is on but the guest book has never been read.
--   * Debug prints a tag summary every ~2 s: how many tags are drawn and how many
--     have a known role. That answers "is the nametag updating" directly.
--
-- Nametag roles come from what THIS script has set (myRoles). The real role list
-- only arrives through server->client events, and RemoteEvent.OnClientEvent is nil
-- in this VM, so a role set by anyone else reads as "?" rather than a guess.
--
-- The guest book list only exists in PlayerGui.AboveGuestBook, so open the book
-- once after loading. Roles only apply to players IN YOUR SERVER.

local NAME = "AboveIslandAdmin"
local VERSION = "7.1.0"

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

local ROLE = "Helper"
local BASE_ROLE = "Visitor"
local RESCAN_EVERY = 3.0
local GRANT_EVERY = 2.0
local ROLE_GAP = 0.35
local TAG_POOL = 32

-- ---- services ----

local RS = nil
local PlayersSvc = nil
local RunSvc = nil

local function resolveService(svcName)
    local ok, s = pcall(function() return game:GetService(svcName) end)
    if ok and s then return s end
    local ok2, s2 = pcall(function() return game:FindFirstChild(svcName) end)
    if ok2 and s2 then return s2 end
    local found = nil
    pcall(function()
        for _, d in ipairs(game:GetChildren()) do
            if found == nil and tostring(d.ClassName) == svcName then
                found = d
            end
        end
    end)
    return found
end

local function getRS()
    if RS and RS.Parent then return RS end
    RS = resolveService("ReplicatedStorage")
    return RS
end

local function getPlayers()
    if PlayersSvc and PlayersSvc.Parent then return PlayersSvc end
    PlayersSvc = resolveService("Players")
    return PlayersSvc
end

local function getRun()
    if RunSvc and RunSvc.Parent then return RunSvc end
    RunSvc = resolveService("RunService")
    return RunSvc
end

local function remote(remoteName)
    local r = getRS()
    if not r then return nil end
    local ok, rem = pcall(function() return r:FindFirstChild("Remotes") end)
    if not ok or not rem then return nil end
    local ok2, ev = pcall(function() return rem:FindFirstChild(remoteName) end)
    if ok2 and ev then return ev end
    return nil
end

-- ---- state ----

local CFG = { auto = false, tags = false, debug = false }

local running = true
local built = false
local granted = {}
local myRoles = {}
local bookSet = {}
local known = {}
local queued = nil
local pool = {}
local renderConn = nil
local wsWarned = false
local warnedBook = false
local lastPass = ""
local lastTagLog = 0
local tagInfo = { drawn = 0, known = 0 }

local function log(msg)
    print("[ABOVE Admin] " .. tostring(msg))
end

local function dbg(msg)
    if CFG.debug then log("[dbg] " .. tostring(msg)) end
end

-- ---- players ----

local function myUserId()
    local P = getPlayers()
    if not P then return nil end
    local lp = nil
    pcall(function() lp = P.LocalPlayer end)
    if not lp then return nil end
    local uid = nil
    pcall(function() uid = lp.UserId end)
    return uid
end

local function listPlayers()
    local out = {}
    local P = getPlayers()
    if not P then return out end
    pcall(function()
        for _, pl in ipairs(P:GetPlayers()) do
            local uid, nm, dn = nil, nil, nil
            pcall(function() uid = pl.UserId end)
            pcall(function() nm = pl.Name end)
            pcall(function() dn = pl.DisplayName end)
            if uid ~= nil and nm ~= nil then
                out[#out + 1] = { uid = uid, name = nm, display = dn, obj = pl }
            end
        end
    end)
    return out
end

-- ---- role set ----

local function setRole(roleKey, userId, label)
    local ev = remote("RequestFriendAction")
    if not ev then
        dbg("RequestFriendAction missing")
        return false
    end
    local ok = pcall(function() ev:FireServer("SetRole", userId, roleKey) end)
    if ok then
        myRoles[tostring(userId)] = roleKey
        log(roleKey .. " -> " .. tostring(label))
    end
    return ok
end

-- ---- guest book ----

local function nameFromEntry(f)
    for _, d in ipairs(f:GetChildren()) do
        if tostring(d.ClassName) == "TextLabel" then
            local t = nil
            pcall(function() t = d.Text end)
            if type(t) == "string" then
                local s = t:gsub("^%s+", ""):gsub("%s+$", "")
                if s ~= "" and not s:find("ago$") then
                    return s
                end
            end
        end
    end
    return nil
end

local function scrapeGuestBook()
    local P = getPlayers()
    if not P then return {} end
    local lp = nil
    pcall(function() lp = P.LocalPlayer end)
    if not lp then return {} end
    local pg = nil
    pcall(function() pg = lp:FindFirstChild("PlayerGui") end)
    if not pg then return {} end
    local gb = nil
    pcall(function() gb = pg:FindFirstChild("AboveGuestBook") end)
    if not gb then return {} end
    local cg = nil
    pcall(function() cg = gb:FindFirstChild("CanvasGroup") end)
    if not cg then return {} end
    local sf = nil
    pcall(function() sf = cg:FindFirstChild("ScrollingFrame") end)
    if not sf then return {} end

    local names = {}
    pcall(function()
        for _, f in ipairs(sf:GetChildren()) do
            if tostring(f.ClassName) == "Frame" then
                local nm = nameFromEntry(f)
                if nm then names[#names + 1] = nm end
            end
        end
    end)
    return names
end

local function rescan()
    local names = scrapeGuestBook()
    if #names == 0 then
        dbg("guest book not readable - open it in game")
        return 0
    end
    bookSet = {}
    for i = 1, #names do
        local k = string.lower(names[i])
        bookSet[k] = names[i]
        if not known[k] then
            known[k] = true
            log("new liker: " .. names[i])
        end
    end
    warnedBook = false
    dbg("guest book entries: " .. tostring(#names))
    return #names
end

local function isLiker(pl)
    if pl == nil then return false end
    if pl.name and bookSet[string.lower(pl.name)] then return true end
    if pl.display and bookSet[string.lower(pl.display)] then return true end
    return false
end

-- ---- actions (worker only) ----

local function grantLikers()
    -- self-sufficient: make sure the book is read before matching
    if #known == 0 then rescan() end
    if #known == 0 and not warnedBook then
        warnedBook = true
        log("auto is on but the guest book has never been read - open it once in game")
    end

    local me = myUserId()
    local list = listPlayers()
    local likers, sent = 0, 0
    for i = 1, #list do
        local pl = list[i]
        if pl.uid ~= me and isLiker(pl) then
            likers = likers + 1
            if not granted[tostring(pl.uid)] then
                granted[tostring(pl.uid)] = true
                setRole(ROLE, pl.uid, pl.name)
                sent = sent + 1
                task.wait(ROLE_GAP)
            end
        end
    end
    local pass = "server=" .. tostring(#list) .. " likers=" .. tostring(likers)
        .. " sent=" .. tostring(sent) .. " book=" .. tostring(#known)
    if pass ~= lastPass then
        lastPass = pass
        dbg(pass)
    end
end

local function giveAll()
    granted = {}
    grantLikers()
end

local function takeAll()
    local me = myUserId()
    local list = listPlayers()
    for i = 1, #list do
        local pl = list[i]
        if pl.uid ~= me then
            setRole(BASE_ROLE, pl.uid, pl.name)
            granted[tostring(pl.uid)] = nil
            task.wait(ROLE_GAP)
        end
    end
end

-- ---- role nametags ----

local function ensurePool()
    if #pool > 0 then return true end
    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
        log("Drawing unavailable - nametags off")
        return false
    end
    for i = 1, TAG_POOL do
        local ok, t = pcall(function() return Drawing.new("Text") end)
        if not ok or t == nil then
            log("Drawing.new(Text) failed - nametags off")
            return false
        end
        pcall(function()
            t.Size = 20
            t.Outline = true
            t.Center = true
            t.Visible = false
            t.Color = Color3.fromRGB(255, 255, 255)
        end)
        pool[i] = t
    end
    dbg("tag pool built: " .. tostring(#pool))
    return true
end

local function hideAll()
    for i = 1, #pool do
        pcall(function() pool[i].Visible = false end)
    end
end

local function renderTags()
    if not CFG.tags then
        hideAll()
        tagInfo.drawn = 0
        return
    end
    if not ensurePool() then return end
    local me = myUserId()
    local list = listPlayers()
    local used, offscreen, knownN = 0, 0, 0
    for i = 1, #list do
        local pl = list[i]
        if pl.uid ~= me and used < TAG_POOL then
            local ch = nil
            pcall(function() ch = pl.obj.Character end)
            local hrp = nil
            if ch then
                pcall(function() hrp = ch:FindFirstChild("HumanoidRootPart") end)
            end
            local pos = nil
            if hrp then
                pcall(function() pos = hrp.Position end)
            end
            if pos then
                local sp, onScreen = nil, false
                pcall(function()
                    local s, o = WorldToScreen(pos + Vector3.new(0, 3, 0))
                    sp, onScreen = s, o
                end)
                if onScreen and sp then
                    used = used + 1
                    local tag = pool[used]
                    local role = myRoles[tostring(pl.uid)]
                    if role ~= nil then knownN = knownN + 1 end
                    pcall(function()
                        tag.Text = "[" .. (role or "?") .. "]"
                        tag.Position = sp
                        tag.Visible = true
                        if role == ROLE then
                            tag.Color = Color3.fromRGB(120, 230, 140)
                        elseif role == BASE_ROLE then
                            tag.Color = Color3.fromRGB(200, 200, 200)
                        else
                            tag.Color = Color3.fromRGB(255, 220, 120)
                        end
                    end)
                else
                    offscreen = offscreen + 1
                end
            end
        end
    end
    for i = used + 1, #pool do
        pcall(function() pool[i].Visible = false end)
    end
    tagInfo.drawn = used
    tagInfo.known = knownN
    if used == 0 and offscreen > 0 and not wsWarned then
        wsWarned = true
        log("WorldToScreen returned nothing usable - nametags may not render")
    end
end

local function startRender()
    local run = getRun()
    if not run then
        log("RunService unavailable - nametags off")
        return
    end
    if renderConn then return end
    local ok, c = pcall(function()
        return run.RenderStepped:Connect(function()
            pcall(renderTags)
        end)
    end)
    if ok and c ~= nil then
        renderConn = c
        log("nametag renderer connected")
    else
        log("nametag renderer FAILED to connect - nametags will not draw")
    end
end

-- ---- menu ----

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    if not tab then return nil end
    local sides = { "Left", "Right" }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() return sec:Toggle(id, label, default, cb) end,
        function() return sec:Toggle(label, id, default, cb) end,
        function() return sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    return false
end

local function mkButton(sec, label, cb)
    if not sec then return false end
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. "_btn", cb) end) then return true end
    return false
end

local function printState()
    local me = myUserId()
    local list = listPlayers()
    local likers = 0
    for i = 1, #list do
        if list[i].uid ~= me and isLiker(list[i]) then likers = likers + 1 end
    end
    local roleCount = 0
    for _ in pairs(myRoles) do roleCount = roleCount + 1 end
    log("--- state ---")
    log("server players: " .. tostring(#list))
    log("guest book names: " .. tostring(#known))
    log("likers in server: " .. tostring(likers))
    log("roles set this session: " .. tostring(roleCount))
    log("tags drawn: " .. tostring(tagInfo.drawn) .. " | with known role: " .. tostring(tagInfo.known))
    log("tag pool: " .. tostring(#pool) .. " | renderer: " .. tostring(renderConn ~= nil))
    log("auto: " .. tostring(CFG.auto) .. " | tags: " .. tostring(CFG.tags))
    log("--- end ---")
end

local function buildMenu()
    local M = _G.UI
    if not M or type(M.AddTab) ~= "function" then
        log("UI not found")
        return
    end
    pcall(function()
        M.AddTab("Island Admin", function(tab)
            if built then return end
            built = true
            pcall(function()
                local sec = mkSection(tab, "Permissions")
                if sec then
                    mkToggle(sec, "Auto-grant " .. ROLE .. " to likers", "ia_auto", false, function(v)
                        CFG.auto = v
                        log("auto-grant " .. (v and "ON" or "OFF"))
                        if v then queued = { kind = "give" } end
                    end)
                    mkButton(sec, "Give " .. ROLE .. " to all liked", function()
                        queued = { kind = "give" }
                    end)
                    mkButton(sec, "Take " .. ROLE .. " (everyone to " .. BASE_ROLE .. ")", function()
                        queued = { kind = "take" }
                    end)
                end

                local vis = mkSection(tab, "Visuals")
                if vis then
                    mkToggle(vis, "Player role nametags", "ia_tags", false, function(v)
                        CFG.tags = v
                        if not v then hideAll() end
                        log("role nametags " .. (v and "ON" or "OFF"))
                    end)
                end

                local dbgSec = mkSection(tab, "Debug")
                if dbgSec then
                    mkToggle(dbgSec, "Debug logging", "ia_dbg", false, function(v)
                        CFG.debug = v
                        log("debug " .. (v and "ON" or "OFF"))
                    end)
                    mkButton(dbgSec, "Print state", function()
                        queued = { kind = "state" }
                    end)
                    mkButton(dbgSec, "Rescan guest book", function()
                        queued = { kind = "rescan" }
                    end)
                end
            end)
        end)
    end)
end

-- ---- stop ----

local function stop()
    running = false
    CFG.auto = false
    CFG.tags = false
    hideAll()
    if renderConn then
        pcall(function() renderConn:Disconnect() end)
        renderConn = nil
    end
    for i = 1, #pool do
        pcall(function() pool[i]:Remove() end)
    end
    pool = {}
    local M = _G.UI
    if M and type(M.RemoveTab) == "function" then
        pcall(function() M.RemoveTab("Island Admin") end)
    end
    _G[NAME] = nil
    log("stopped")
end

-- ---- loops ----

task.spawn(function()
    local waited = 0
    while running and not (_G.UI and _G.UI.AddTab) and waited < 15 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    buildMenu()
    startRender()
end)

task.spawn(function()
    while running do
        pcall(rescan)
        task.wait(RESCAN_EVERY)
    end
end)

-- periodic tag summary, debug only
task.spawn(function()
    while running do
        if CFG.debug and CFG.tags then
            local now = os.clock()
            if now - lastTagLog > 2 then
                lastTagLog = now
                dbg("tags drawn=" .. tostring(tagInfo.drawn)
                    .. " withRole=" .. tostring(tagInfo.known))
            end
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    while running do
        local job = queued
        if job then
            queued = nil
            if job.kind == "give" then
                pcall(giveAll)
            elseif job.kind == "take" then
                pcall(takeAll)
            elseif job.kind == "state" then
                pcall(printState)
            elseif job.kind == "rescan" then
                pcall(rescan)
            end
        elseif CFG.auto then
            pcall(grantLikers)
            task.wait(GRANT_EVERY)
        else
            task.wait(0.2)
        end
    end
end)

_G[NAME] = {
    stop = stop,
    version = VERSION,
    give = function() queued = { kind = "give" } end,
    take = function() queued = { kind = "take" } end,
    state = function() queued = { kind = "state" } end,
}
log("v" .. VERSION .. " loaded - open the guest book once so it can read your likers")
