-- ABOVE Island Admin
-- VERSION 1.2.0
-- place 124357835578554 (game.Name reports "Ugc" - match by place id, never by name)
-- also seen on place 88152437007055 (same game, different place)
--
-- Co-op island permission panel.
--
-- Role changes use the same remote and shape the game's own Friends panel uses:
--   RequestFriendAction:FireServer(<roleKey>, <userId>)
-- The role name IS the first argument. There is no "SetRole" action.
-- Owner is deliberately unclickable in the game's UI, so this never touches one.
--
-- GUEST BOOK (measured):
--   * Blocks.GuestBook is a Part with MachineId=GuestBook, CellKey=0,0,-13,
--     HP=150. The game reuses the MACHINE remotes for it, so opening it is
--     RequestLoadFuel:FireServer(<cellKey>) - confirmed firing with the cell key.
--   * GuestBookOpened is the server's reply and carries the list.
--   * Firing RequestLoadFuel from across the island produced NO GuestBookOpened,
--     so it is RANGE-CHECKED like RequestHarvest. You must be standing at the
--     book for the server to answer. Press "Capture guest book" while next to it.
--   * The like list is server data. Nothing in the workspace holds it, so it
--     cannot be read - it has to be captured from GuestBookOpened.
--
-- Other permission remotes in this build: RequestPermissionSummary,
-- PermissionSummary, RequestPermissionToggle, FriendRoleChanged, FriendList,
-- RequestFriendList, FavoriteResult, PromptFavorite.
--
-- Stop = switch the toggle off / press stop. There is no stop key.

local NAME = "AboveIslandAdmin"
local VERSION = "1.2.0"

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

-- ---- constants ----

local ROLE = "Helper"
local BASE_ROLE = "Visitor"
local AUTO_DELAY = 2.0
local GB_RANGE = 20

-- ---- lazy service resolution (never cache a nil) ----

local RS = nil
local PlayersSvc = nil

local function resolveService(svcName)
    local ok, s = pcall(function() return game:GetService(svcName) end)
    if ok and s then return s end
    local ok2, s2 = pcall(function() return game:FindFirstChild(svcName) end)
    if ok2 and s2 then return s2 end
    local found = nil
    pcall(function()
        for _, d in ipairs(game:GetChildren()) do
            if found == nil and tostring(d.ClassName) == svcName then
                found = d
            end
        end
    end)
    return found
end

local function getRS()
    if RS and RS.Parent then return RS end
    RS = resolveService("ReplicatedStorage")
    return RS
end

local function getPlayers()
    if PlayersSvc and PlayersSvc.Parent then return PlayersSvc end
    PlayersSvc = resolveService("Players")
    return PlayersSvc
end

local function remote(remoteName)
    local r = getRS()
    if not r then return nil end
    local ok, rem = pcall(function() return r:FindFirstChild("Remotes") end)
    if not ok or not rem then return nil end
    local ok2, ev = pcall(function() return rem:FindFirstChild(remoteName) end)
    if ok2 and ev then return ev end
    return nil
end

-- ---- state ----

local CFG = { auto = false }

local running = true
local built = false
local granted = {}
local guestEntries = {}
local conns = {}
local stats = { set = 0, failed = 0, gbEvents = 0 }
local warnedAction = false

local function log(msg)
    print("[ABOVE Admin] " .. tostring(msg))
end

-- ---- players ----

local function myUserId()
    local P = getPlayers()
    if not P then return nil end
    local lp = nil
    pcall(function() lp = P.LocalPlayer end)
    if not lp then return nil end
    local uid = nil
    pcall(function() uid = lp.UserId end)
    return uid
end

local function getRoot()
    local P = getPlayers()
    if not P then return nil end
    local lp = nil
    pcall(function() lp = P.LocalPlayer end)
    if not lp then return nil end
    local ch = nil
    pcall(function() ch = lp.Character end)
    if not ch then return nil end
    local rp = nil
    pcall(function() rp = ch:FindFirstChild("HumanoidRootPart") end)
    return rp
end

local function posOf(o)
    if not o then return nil end
    local ok, p = pcall(function() return o.Position end)
    if ok and p then return p end
    return nil
end

local function listPlayers()
    local out = {}
    local P = getPlayers()
    if not P then return out end
    pcall(function()
        for _, pl in ipairs(P:GetPlayers()) do
            local uid, nm = nil, nil
            pcall(function() uid = pl.UserId end)
            pcall(function() nm = pl.Name end)
            if uid ~= nil and nm ~= nil then
                out[#out + 1] = { uid = uid, name = nm }
            end
        end
    end)
    return out
end

local function getIsland()
    local found = nil
    pcall(function()
        for _, d in ipairs(workspace:GetChildren()) do
            if found == nil and string.sub(d.Name, 1, 7) == "Island_" then
                if d:FindFirstChild("Nodes") then
                    found = d
                end
            end
        end
    end)
    return found
end

-- ---- role set ----

local function setRole(roleKey, userId, label)
    local ev = remote("RequestFriendAction")
    if not ev then
        if not warnedAction then
            warnedAction = true
            log("RequestFriendAction not resolvable - will keep retrying")
        end
        return false
    end
    local ok = pcall(function() ev:FireServer(roleKey, userId) end)
    if ok then
        stats.set = stats.set + 1
        log(roleKey .. " -> " .. tostring(label) .. " (" .. tostring(userId) .. ")")
    else
        stats.failed = stats.failed + 1
        log("FAILED " .. roleKey .. " -> " .. tostring(label))
    end
    return ok
end

local function applyToAll(roleKey, onlyUngranted, force)
    local me = myUserId()
    local list = listPlayers()
    local n = 0
    for i = 1, #list do
        local pl = list[i]
        if pl.uid ~= me then
            if force or not onlyUngranted or not granted[tostring(pl.uid)] then
                granted[tostring(pl.uid)] = true
                setRole(roleKey, pl.uid, pl.name)
                n = n + 1
                task.wait(0.15)
            end
        end
    end
    log(roleKey .. " sent to " .. tostring(n) .. " of " .. tostring(#list) .. " in server")
    return n
end

local function printRoster()
    local me = myUserId()
    local list = listPlayers()
    log("in server (" .. tostring(#list) .. "):")
    for i = 1, #list do
        local pl = list[i]
        log("  " .. pl.name .. " (" .. tostring(pl.uid) .. ")"
            .. (pl.uid == me and "  <- you" or ""))
    end
end

-- ---- guest book ----

local function findGuestBook()
    local isl = getIsland()
    if not isl then return nil end
    local blocks = nil
    pcall(function() blocks = isl:FindFirstChild("Blocks") end)
    if not blocks then return nil end
    local gb = nil
    pcall(function() gb = blocks:FindFirstChild("GuestBook") end)
    return gb
end

local function guestBookDistance()
    local gb = findGuestBook()
    local rp = getRoot()
    local a, b = posOf(gb), posOf(rp)
    if not a or not b then return nil end
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- collect anything that looks like an entry out of the payload
local function harvestEntries(v, depth)
    if depth > 3 or type(v) ~= "table" then return end
    local uid = v.userId or v.UserId or v.id or v.playerId
    if type(uid) == "number" then
        guestEntries[#guestEntries + 1] = {
            uid = uid,
            name = tostring(v.name or v.displayName or v.username or uid),
        }
        return
    end
    for _, vv in pairs(v) do
        harvestEntries(vv, depth + 1)
    end
end

local function hookGuestBook()
    local ev = remote("GuestBookOpened")
    if not ev then
        log("GuestBookOpened remote not found")
        return false
    end
    local ok = pcall(function()
        local c = ev.OnClientEvent:Connect(function(...)
            stats.gbEvents = stats.gbEvents + 1
            local n = select('#', ...)
            log("GuestBookOpened, " .. tostring(n) .. " arg(s):")
            for i = 1, n do
                local v = select(i, ...)
                if type(v) == "table" then
                    local parts, cnt = {}, 0
                    for k, vv in pairs(v) do
                        cnt = cnt + 1
                        if cnt <= 25 then
                            parts[#parts + 1] = tostring(k) .. "=" .. tostring(vv)
                        end
                    end
                    log("  arg" .. tostring(i) .. " table(" .. tostring(cnt) .. "): "
                        .. table.concat(parts, ", "))
                    harvestEntries(v, 0)
                else
                    log("  arg" .. tostring(i) .. " " .. type(v) .. " = " .. tostring(v))
                end
            end
        end)
        conns[#conns + 1] = c
    end)
    if ok then log("hooked GuestBookOpened") end
    return ok
end

local function openGuestBook()
    local gb = findGuestBook()
    if not gb then
        log("Blocks.GuestBook not found")
        return false
    end
    local cell = nil
    pcall(function() cell = gb:GetAttribute("CellKey") end)
    if cell == nil then
        pcall(function() cell = gb:GetAttribute("Cells") end)
    end
    if cell == nil then
        log("GuestBook has no CellKey attribute")
        return false
    end
    local d = guestBookDistance()
    log("guest book cell=" .. tostring(cell)
        .. (d and (" dist=" .. string.format("%.1f", d)) or ""))
    if d ~= nil and d > GB_RANGE then
        log("TOO FAR - the server range-checks this. Stand at the book and press again.")
        return false
    end
    local ev = remote("RequestLoadFuel")
    if not ev then
        log("RequestLoadFuel remote not found")
        return false
    end
    local ok = pcall(function() ev:FireServer(cell) end)
    log("fired RequestLoadFuel(" .. tostring(cell) .. ") ok=" .. tostring(ok))
    return ok
end

local function captureGuestBook()
    hookGuestBook()
    openGuestBook()
end

local function printGuestBook()
    if #guestEntries == 0 then
        log("no entries captured yet - stand at the book, press 'Capture guest book', then open it")
        return
    end
    local seen = {}
    local n = 0
    log("captured entries (" .. tostring(#guestEntries) .. "):")
    for i = 1, #guestEntries do
        local e = guestEntries[i]
        local key = tostring(e.uid)
        if not seen[key] then
            seen[key] = true
            n = n + 1
            if n <= 40 then
                log("  " .. e.name .. " (" .. key .. ")")
            end
        end
    end
    log("unique=" .. tostring(n))
end

-- ---- menu ----

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    if not tab then return nil end
    local sides = { "Left", "Right" }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    warn("[ABOVE Admin] section failed: " .. tostring(name))
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() return sec:Toggle(id, label, default, cb) end,
        function() return sec:Toggle(label, id, default, cb) end,
        function() return sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[ABOVE Admin] toggle failed: " .. tostring(label))
    return false
end

local function mkButton(sec, label, cb)
    if not sec then return false end
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. "_btn", cb) end) then return true end
    warn("[ABOVE Admin] button failed: " .. tostring(label))
    return false
end

local function mkText(sec, line)
    if not sec then return end
    pcall(function() sec:Text(line) end)
end

local function buildMenu()
    local M = _G.UI
    if not M or type(M.AddTab) ~= "function" then
        log("UI not found - use the console (_G.AboveIslandAdmin)")
        return
    end
    local ok = pcall(function()
        M.AddTab("Island Admin", function(tab)
            if built then return end
            built = true
            local okb, err = pcall(function()
                local sec = mkSection(tab, "Roles")
                if sec then
                    mkButton(sec, "Give " .. ROLE .. " to everyone", function()
                        applyToAll(ROLE, false, true)
                    end)
                    mkButton(sec, "Take " .. ROLE .. " from everyone", function()
                        applyToAll(BASE_ROLE, false, true)
                    end)
                    mkToggle(sec, "Auto-grant " .. ROLE .. " on join", "ia_auto", false, function(v)
                        CFG.auto = v
                        log("auto-grant " .. (v and "ON" or "OFF"))
                    end)
                    mkButton(sec, "Print who is in server", printRoster)
                    mkButton(sec, "Reset granted list", function()
                        granted = {}
                        log("granted list cleared")
                    end)
                end

                local gb = mkSection(tab, "Guest Book")
                if gb then
                    mkButton(gb, "Capture guest book", captureGuestBook)
                    mkButton(gb, "Print captured entries", printGuestBook)
                    mkButton(gb, "Grant " .. ROLE .. " to captured entries", function()
                        local me = myUserId()
                        local n = 0
                        for i = 1, #guestEntries do
                            local e = guestEntries[i]
                            if e.uid ~= me then
                                setRole(ROLE, e.uid, e.name)
                                n = n + 1
                                task.wait(0.15)
                            end
                        end
                        log("granted " .. tostring(n) .. " captured entr(ies)")
                    end)
                    mkText(gb, "Stand AT the book - server")
                    mkText(gb, "range-checks the open call.")
                end
            end)
            if not okb then
                warn("[ABOVE Admin] build error: " .. tostring(err))
            end
            log("tab widgets built")
        end)
    end)
    if not ok then
        warn("[ABOVE Admin] AddTab failed")
    end
end

-- ---- stop ----

local function stop()
    running = false
    CFG.auto = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    local M = _G.UI
    if M and type(M.RemoveTab) == "function" then
        pcall(function() M.RemoveTab("Island Admin") end)
    end
    _G[NAME] = nil
    log("stopped")
end

-- ---- loops ----

task.spawn(function()
    local waited = 0
    while running and not (_G.UI and _G.UI.AddTab) and waited < 15 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    buildMenu()
end)

task.spawn(function()
    while running do
        if CFG.auto then
            local ok, err = pcall(applyToAll, ROLE, true, false)
            if not ok then
                log("auto pass error: " .. tostring(err))
            end
            task.wait(AUTO_DELAY)
        else
            task.wait(0.25)
        end
    end
end)

_G[NAME] = {
    stop = stop,
    version = VERSION,
    setRole = setRole,
    giveAll = function() return applyToAll(ROLE, false, true) end,
    takeAll = function() return applyToAll(BASE_ROLE, false, true) end,
    roster = printRoster,
    capture = captureGuestBook,
    book = printGuestBook,
    entries = function() return guestEntries end,
}
log("v" .. VERSION .. " loaded on place " .. tostring(game.PlaceId)
    .. " | RS=" .. tostring(getRS() ~= nil)
    .. " | players=" .. tostring(#listPlayers())
    .. " | bookDist=" .. tostring(guestBookDistance()))
