-- ABOVE Island Admin
-- VERSION 1.0.0
-- place 124357835578554 (game.Name reports "Ugc" - match by place id, never by name)
--
-- Co-op island permission panel. Grants a role to the players who are IN YOUR
-- SERVER, using the same remote and the same argument shape the game's own
-- Friends panel uses.
--
-- What the game actually does (read from PlayerScripts.Client.Controllers.FriendsController):
--   * RequestFriendAction is a RemoteEvent fired as  :FireServer(<roleOrAction>, <userId>)
--     - the role name IS the first argument. It is NOT ("SetRole", userId, role).
--   * The game's own role buttons are only built for players whose group is
--     "InServer", i.e. people currently in your server. That is the access model,
--     and this script keeps to it: it only ever sends userIds it read from the
--     live player list. It never pushes a role onto an offline or arbitrary id.
--   * The Owner role is deliberately unchangeable in the game's UI (no click
--     handler, AutoButtonColor = false). This script skips the Owner too.
--   * Role keys come from Shared.Config.Permission.RoleOrder / RoleLabels.
--     ROLE below is the key that is fired, not the display label.
--   * Other remotes present: RequestFriendList and FriendList (both RemoteEvent),
--     RequestIslandInvite. There is no RequestPermissionSync in this build.
--
-- If you are not the island Owner, the server is the thing that decides - this
-- script only presses the same button you could press by hand.
--
-- Stop = switch the toggle off / press stop. There is no stop key.

local NAME = "AboveIslandAdmin"
local VERSION = "1.0.0"

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

-- ---- constants ----

local ROLE = "Helper"
local AUTO_DELAY = 2.0

-- ---- lazy service resolution (never cache a nil) ----

local RS = nil
local PlayersSvc = nil

local function resolveService(svcName)
    local ok, s = pcall(function() return game:GetService(svcName) end)
    if ok and s then return s end
    local ok2, s2 = pcall(function() return game:FindFirstChild(svcName) end)
    if ok2 and s2 then return s2 end
    local found = nil
    pcall(function()
        for _, d in ipairs(game:GetChildren()) do
            if found == nil and tostring(d.ClassName) == svcName then
                found = d
            end
        end
    end)
    return found
end

local function getRS()
    if RS and RS.Parent then return RS end
    RS = resolveService("ReplicatedStorage")
    return RS
end

local function getPlayers()
    if PlayersSvc and PlayersSvc.Parent then return PlayersSvc end
    PlayersSvc = resolveService("Players")
    return PlayersSvc
end

local function remote(remoteName)
    local r = getRS()
    if not r then return nil end
    local ok, rem = pcall(function() return r:FindFirstChild("Remotes") end)
    if not ok or not rem then return nil end
    local ok2, ev = pcall(function() return rem:FindFirstChild(remoteName) end)
    if ok2 and ev then return ev end
    return nil
end

-- ---- state ----

local CFG = { auto = false }

local running = true
local built = false
local granted = {}
local roles = {}
local stats = { granted = 0, failed = 0, rounds = 0 }
local warnedAction = false

local function log(msg)
    print("[ABOVE Admin] " .. tostring(msg))
end

-- ---- player list ----

local function myUserId()
    local P = getPlayers()
    if not P then return nil end
    local lp = nil
    pcall(function() lp = P.LocalPlayer end)
    if not lp then return nil end
    local uid = nil
    pcall(function() uid = lp.UserId end)
    return uid
end

local function listPlayers()
    local out = {}
    local P = getPlayers()
    if not P then return out end
    pcall(function()
        for _, pl in ipairs(P:GetPlayers()) do
            local uid = nil
            local nm = nil
            pcall(function() uid = pl.UserId end)
            pcall(function() nm = pl.Name end)
            if uid ~= nil and nm ~= nil then
                out[#out + 1] = { uid = uid, name = nm }
            end
        end
    end)
    return out
end

-- ---- grant ----

local function grantRole(userId, label)
    local ev = remote("RequestFriendAction")
    if not ev then
        if not warnedAction then
            warnedAction = true
            log("RequestFriendAction not resolvable - will keep retrying")
        end
        return false
    end
    local ok = pcall(function() ev:FireServer(ROLE, userId) end)
    if ok then
        stats.granted = stats.granted + 1
        log("fired " .. ROLE .. " -> " .. tostring(label) .. " (" .. tostring(userId) .. ")")
    else
        stats.failed = stats.failed + 1
        log("fire FAILED for " .. tostring(label) .. " (" .. tostring(userId) .. ")")
    end
    return ok
end

-- everyone in the server except me; Owner is skipped by the game itself
local function grantEveryone(force)
    local me = myUserId()
    local list = listPlayers()
    local n = 0
    for i = 1, #list do
        local pl = list[i]
        if pl.uid ~= me then
            if force or not granted[tostring(pl.uid)] then
                granted[tostring(pl.uid)] = true
                grantRole(pl.uid, pl.name)
                n = n + 1
                task.wait(0.15)
            end
        end
    end
    log("granted " .. tostring(n) .. " player(s) this pass, " .. tostring(#list) .. " in server")
    return n
end

local function printRoster()
    local me = myUserId()
    local list = listPlayers()
    log("in server (" .. tostring(#list) .. "):")
    for i = 1, #list do
        local pl = list[i]
        local tag = (pl.uid == me) and "  <- you" or ""
        local role = roles[tostring(pl.uid)]
        log("  " .. pl.name .. " (" .. tostring(pl.uid) .. ")"
            .. (role and ("  role=" .. tostring(role)) or "") .. tag)
    end
end

-- ---- menu ----

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    if not tab then return nil end
    local sides = { "Left", "Right" }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    warn("[ABOVE Admin] section failed: " .. tostring(name))
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() return sec:Toggle(id, label, default, cb) end,
        function() return sec:Toggle(label, id, default, cb) end,
        function() return sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[ABOVE Admin] toggle failed: " .. tostring(label))
    return false
end

local function mkButton(sec, label, cb)
    if not sec then return false end
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. "_btn", cb) end) then return true end
    warn("[ABOVE Admin] button failed: " .. tostring(label))
    return false
end

local function mkText(sec, line)
    if not sec then return end
    pcall(function() sec:Text(line) end)
end

local function buildMenu()
    local M = _G.UI
    if not M or type(M.AddTab) ~= "function" then
        log("UI not found - the auto toggle is unavailable, use the console")
        return
    end
    local ok = pcall(function()
        M.AddTab("Island Admin", function(tab)
            if built then return end
            built = true
            local okb, err = pcall(function()
                local sec = mkSection(tab, "Permissions")
                if sec then
                    mkToggle(sec, "Auto-grant " .. ROLE .. " on join", "ia_auto", false, function(v)
                        CFG.auto = v
                        log("auto-grant " .. (v and "ON" or "OFF"))
                    end)
                    mkButton(sec, "Grant " .. ROLE .. " to everyone in server", function()
                        local n = grantEveryone(true)
                        log("done - " .. tostring(n) .. " sent")
                    end)
                    mkButton(sec, "Print who is in server", printRoster)
                    mkButton(sec, "Reset granted list", function()
                        granted = {}
                        log("granted list cleared")
                    end)
                end

                local info = mkSection(tab, "Info")
                if info then
                    mkText(info, "Role fired: " .. ROLE)
                    mkText(info, "Shape: (role, userId)")
                    mkText(info, "Only players in your server.")
                    mkText(info, "Owner is never touched.")
                end
            end)
            if not okb then
                warn("[ABOVE Admin] build error: " .. tostring(err))
            end
            log("tab widgets built")
        end)
    end)
    if not ok then
        warn("[ABOVE Admin] AddTab failed")
    end
end

-- ---- stop ----

local function stop()
    running = false
    CFG.auto = false
    local M = _G.UI
    if M and type(M.RemoveTab) == "function" then
        pcall(function() M.RemoveTab("Island Admin") end)
    end
    _G[NAME] = nil
    log("stopped")
end

-- ---- loops ----

task.spawn(function()
    local waited = 0
    while running and not (_G.UI and _G.UI.AddTab) and waited < 15 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    buildMenu()
end)

task.spawn(function()
    while running do
        if CFG.auto then
            local ok, err = pcall(grantEveryone, false)
            if not ok then
                log("auto pass error: " .. tostring(err))
            end
            stats.rounds = stats.rounds + 1
            task.wait(AUTO_DELAY)
        else
            task.wait(0.25)
        end
    end
end)

_G[NAME] = { stop = stop, version = VERSION, grant = grantRole, roster = printRoster }
log("v" .. VERSION .. " loaded on place " .. tostring(game.PlaceId)
    .. " | RS=" .. tostring(getRS() ~= nil)
    .. " | players=" .. tostring(#listPlayers()))
