-- ABOVE Island Admin
-- VERSION 2.0.0
-- place 124357835578554 (game.Name reports "Ugc" - match by place id, never by name)
-- also seen on place 88152437007055 (same game, different place)
--
-- Co-op island permission panel + guest book resolver.
--
-- HOW THE GUEST BOOK LIST IS OBTAINED (all measured):
--   * The list is NOT in the workspace. Blocks.GuestBook is 7 art meshes with no
--     attributes; an island-wide scan for Liked/UserId attributes returns zero.
--   * RemoteEvent.OnClientEvent is NIL in this VM, so server->client events cannot
--     be hooked. Capturing the payload that way is impossible - hooked=0 on every
--     attempt across 14 remotes.
--   * The list IS in PlayerGui.AboveGuestBook.CanvasGroup.ScrollingFrame: one
--     child Frame per signature, each with a TextLabel name, a TextLabel
--     "<n>h ago", and an optional " VIP " / " FRIEND " tag.
--   * Signature count == the heart count (44 entries, "44"), so the guest book
--     signatures ARE the like list.
--   * The UI exposes DISPLAY NAMES ONLY. No UserId in attributes, and
--     ImageLabel.Image reads nil so the avatar URL cannot be mined either.
--   * Players:GetUserIdFromNameAsync is NIL in this VM.
--   * httpget IS available and reaches users.roblox.com. So names are resolved to
--     ids with GET https://users.roblox.com/v1/users/search?keyword=<name>&limit=10
--     and matching the returned "name" field exactly (case-insensitive).
--
-- Role changes: RequestFriendAction:FireServer(<roleKey>, <userId>). The role name
-- IS the first argument. Owner is unclickable in the game's UI, so it is skipped.
--
-- Stop = switch the toggle off / press stop. There is no stop key.

local NAME = "AboveIslandAdmin"
local VERSION = "2.0.0"

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end

-- ---- constants ----

local ROLE = "Helper"
local BASE_ROLE = "Visitor"
local AUTO_DELAY = 2.0
local RESOLVE_GAP = 0.35
local MAX_RESOLVE = 80

-- ---- lazy service resolution (never cache a nil) ----

local RS = nil
local PlayersSvc = nil

local function resolveService(svcName)
    local ok, s = pcall(function() return game:GetService(svcName) end)
    if ok and s then return s end
    local ok2, s2 = pcall(function() return game:FindFirstChild(svcName) end)
    if ok2 and s2 then return s2 end
    local found = nil
    pcall(function()
        for _, d in ipairs(game:GetChildren()) do
            if found == nil and tostring(d.ClassName) == svcName then
                found = d
            end
        end
    end)
    return found
end

local function getRS()
    if RS and RS.Parent then return RS end
    RS = resolveService("ReplicatedStorage")
    return RS
end

local function getPlayers()
    if PlayersSvc and PlayersSvc.Parent then return PlayersSvc end
    PlayersSvc = resolveService("Players")
    return PlayersSvc
end

local function remote(remoteName)
    local r = getRS()
    if not r then return nil end
    local ok, rem = pcall(function() return r:FindFirstChild("Remotes") end)
    if not ok or not rem then return nil end
    local ok2, ev = pcall(function() return rem:FindFirstChild(remoteName) end)
    if ok2 and ev then return ev end
    return nil
end

-- ---- state ----

local CFG = { auto = false }

local running = true
local built = false
local granted = {}
local bookNames = {}
local resolved = {}
local stats = { set = 0, failed = 0, resolved = 0, unresolved = 0 }
local warnedAction = false

local function log(msg)
    print("[ABOVE Admin] " .. tostring(msg))
end

-- ---- players ----

local function myUserId()
    local P = getPlayers()
    if not P then return nil end
    local lp = nil
    pcall(function() lp = P.LocalPlayer end)
    if not lp then return nil end
    local uid = nil
    pcall(function() uid = lp.UserId end)
    return uid
end

local function listPlayers()
    local out = {}
    local P = getPlayers()
    if not P then return out end
    pcall(function()
        for _, pl in ipairs(P:GetPlayers()) do
            local uid, nm = nil, nil
            pcall(function() uid = pl.UserId end)
            pcall(function() nm = pl.Name end)
            if uid ~= nil and nm ~= nil then
                out[#out + 1] = { uid = uid, name = nm }
            end
        end
    end)
    return out
end

-- ---- role set ----

local function setRole(roleKey, userId, label)
    local ev = remote("RequestFriendAction")
    if not ev then
        if not warnedAction then
            warnedAction = true
            log("RequestFriendAction not resolvable - will keep retrying")
        end
        return false
    end
    local ok = pcall(function() ev:FireServer(roleKey, userId) end)
    if ok then
        stats.set = stats.set + 1
        log(roleKey .. " -> " .. tostring(label) .. " (" .. tostring(userId) .. ")")
    else
        stats.failed = stats.failed + 1
        log("FAILED " .. roleKey .. " -> " .. tostring(label))
    end
    return ok
end

local function applyToAll(roleKey, onlyUngranted, force)
    local me = myUserId()
    local list = listPlayers()
    local n = 0
    for i = 1, #list do
        local pl = list[i]
        if pl.uid ~= me then
            if force or not onlyUngranted or not granted[tostring(pl.uid)] then
                granted[tostring(pl.uid)] = true
                setRole(roleKey, pl.uid, pl.name)
                n = n + 1
                task.wait(0.15)
            end
        end
    end
    log(roleKey .. " sent to " .. tostring(n) .. " of " .. tostring(#list) .. " in server")
    return n
end

local function printRoster()
    local me = myUserId()
    local list = listPlayers()
    log("in server (" .. tostring(#list) .. "):")
    for i = 1, #list do
        local pl = list[i]
        log("  " .. pl.name .. " (" .. tostring(pl.uid) .. ")"
            .. (pl.uid == me and "  <- you" or ""))
    end
end

-- ---- guest book scrape (PlayerGui only - nothing in the workspace) ----

local function cleanText(t)
    if type(t) ~= "string" then return nil end
    local s = t:gsub("^%s+", ""):gsub("%s+$", "")
    if s == "" or #s < 3 or #s > 24 then return nil end
    if s:find("ago$") then return nil end
    if s == "VIP" or s == "FRIEND" then return nil end
    if s:find("^%[") then return nil end
    if s:find(" ") then return nil end
    return s
end

local function scrapeGuestBook()
    local P = getPlayers()
    if not P then return {} end
    local lp = nil
    pcall(function() lp = P.LocalPlayer end)
    if not lp then return {} end
    local pg = nil
    pcall(function() pg = lp:FindFirstChild("PlayerGui") end)
    if not pg then return {} end
    local gb = nil
    pcall(function() gb = pg:FindFirstChild("AboveGuestBook") end)
    if not gb then
        log("AboveGuestBook not open - open the book in game first")
        return {}
    end
    local cg = nil
    pcall(function() cg = gb:FindFirstChild("CanvasGroup") end)
    if not cg then return {} end
    local sf = nil
    pcall(function() sf = cg:FindFirstChild("ScrollingFrame") end)
    if not sf then return {} end

    local names, seen = {}, {}
    pcall(function()
        for _, f in ipairs(sf:GetChildren()) do
            for _, d in ipairs(f:GetChildren()) do
                local t = nil
                pcall(function() t = d.Text end)
                local nm = cleanText(t)
                if nm and not seen[nm] then
                    seen[nm] = true
                    names[#names + 1] = nm
                end
            end
        end
    end)
    return names
end

-- ---- name -> userId via httpget on users.roblox.com ----

local function urlEncode(s)
    return (tostring(s):gsub("[^%w%-%._~]", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

local function resolveName(name)
    if type(httpget) ~= "function" then return nil end
    local url = "https://users.roblox.com/v1/users/search?keyword="
        .. urlEncode(name) .. "&limit=10"
    local ok, body = pcall(function() return httpget(url) end)
    if not ok or type(body) ~= "string" or #body == 0 then return nil end
    local want = string.lower(name)
    for id, nm in body:gmatch('"id":(%d+),"name":"([^"]*)"') do
        if string.lower(nm) == want then return tonumber(id) end
    end
    for nm, id in body:gmatch('"name":"([^"]*)","displayName":"[^"]*","id":(%d+)') do
        if string.lower(nm) == want then return tonumber(id) end
    end
    return nil
end

local function resolveAll(force)
    bookNames = scrapeGuestBook()
    if #bookNames == 0 then
        log("no names scraped - open the guest book and try again")
        return 0
    end
    log("scraped " .. tostring(#bookNames) .. " name(s) from the guest book")
    resolved = {}
    local okN, badN = 0, 0
    local limit = math.min(#bookNames, MAX_RESOLVE)
    for i = 1, limit do
        local nm = bookNames[i]
        local uid = resolveName(nm)
        if uid ~= nil then
            resolved[#resolved + 1] = { name = nm, uid = uid }
            okN = okN + 1
            log("  " .. nm .. " -> " .. tostring(uid))
        else
            badN = badN + 1
            log("  " .. nm .. " -> NOT FOUND")
        end
        task.wait(RESOLVE_GAP)
    end
    stats.resolved = stats.resolved + okN
    stats.unresolved = stats.unresolved + badN
    log("resolved " .. tostring(okN) .. ", unresolved " .. tostring(badN))
    return okN
end

local function grantResolved()
    if #resolved == 0 then
        log("nothing resolved yet - press 'Resolve guest book' first")
        return 0
    end
    local me = myUserId()
    local n = 0
    for i = 1, #resolved do
        local e = resolved[i]
        if e.uid ~= me then
            setRole(ROLE, e.uid, e.name)
            n = n + 1
            task.wait(0.15)
        end
    end
    log(ROLE .. " sent to " .. tostring(n) .. " resolved player(s)")
    return n
end

local function printResolved()
    if #resolved == 0 then
        log("nothing resolved yet")
        return
    end
    log("resolved (" .. tostring(#resolved) .. "):")
    for i = 1, #resolved do
        log("  " .. resolved[i].name .. " (" .. tostring(resolved[i].uid) .. ")")
    end
end

-- ---- menu ----

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    if not tab then return nil end
    local sides = { "Left", "Right" }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    warn("[ABOVE Admin] section failed: " .. tostring(name))
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() return sec:Toggle(id, label, default, cb) end,
        function() return sec:Toggle(label, id, default, cb) end,
        function() return sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[ABOVE Admin] toggle failed: " .. tostring(label))
    return false
end

local function mkButton(sec, label, cb)
    if not sec then return false end
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. "_btn", cb) end) then return true end
    warn("[ABOVE Admin] button failed: " .. tostring(label))
    return false
end

local function mkText(sec, line)
    if not sec then return end
    pcall(function() sec:Text(line) end)
end

local function buildMenu()
    local M = _G.UI
    if not M or type(M.AddTab) ~= "function" then
        log("UI not found - use the console (_G.AboveIslandAdmin)")
        return
    end
    local ok = pcall(function()
        M.AddTab("Island Admin", function(tab)
            if built then return end
            built = true
            local okb, err = pcall(function()
                local gb = mkSection(tab, "Guest Book")
                if gb then
                    mkButton(gb, "Scrape guest book names", function()
                        bookNames = scrapeGuestBook()
                        log("scraped " .. tostring(#bookNames) .. " name(s)")
                        for i = 1, #bookNames do
                            log("  " .. bookNames[i])
                        end
                    end)
                    mkButton(gb, "Resolve names to UserIds", function()
                        resolveAll(true)
                    end)
                    mkButton(gb, "Print resolved list", printResolved)
                    mkButton(gb, "Grant " .. ROLE .. " to resolved", grantResolved)
                    mkText(gb, "Open the book in game first.")
                end

                local sec = mkSection(tab, "Roles")
                if sec then
                    mkButton(sec, "Give " .. ROLE .. " to everyone in server", function()
                        applyToAll(ROLE, false, true)
                    end)
                    mkButton(sec, "Take " .. ROLE .. " from everyone in server", function()
                        applyToAll(BASE_ROLE, false, true)
                    end)
                    mkToggle(sec, "Auto-grant " .. ROLE .. " on join", "ia_auto", false, function(v)
                        CFG.auto = v
                        log("auto-grant " .. (v and "ON" or "OFF"))
                    end)
                    mkButton(sec, "Print who is in server", printRoster)
                    mkButton(sec, "Reset granted list", function()
                        granted = {}
                        log("granted list cleared")
                    end)
                end
            end)
            if not okb then
                warn("[ABOVE Admin] build error: " .. tostring(err))
            end
            log("tab widgets built")
        end)
    end)
    if not ok then
        warn("[ABOVE Admin] AddTab failed")
    end
end

-- ---- stop ----

local function stop()
    running = false
    CFG.auto = false
    local M = _G.UI
    if M and type(M.RemoveTab) == "function" then
        pcall(function() M.RemoveTab("Island Admin") end)
    end
    _G[NAME] = nil
    log("stopped")
end

-- ---- loops ----

task.spawn(function()
    local waited = 0
    while running and not (_G.UI and _G.UI.AddTab) and waited < 15 do
        task.wait(0.5)
        waited = waited + 0.5
    end
    buildMenu()
end)

task.spawn(function()
    while running do
        if CFG.auto then
            local ok, err = pcall(applyToAll, ROLE, true, false)
            if not ok then
                log("auto pass error: " .. tostring(err))
            end
            task.wait(AUTO_DELAY)
        else
            task.wait(0.25)
        end
    end
end)

_G[NAME] = {
    stop = stop,
    version = VERSION,
    setRole = setRole,
    giveAll = function() return applyToAll(ROLE, false, true) end,
    takeAll = function() return applyToAll(BASE_ROLE, false, true) end,
    roster = printRoster,
    scrape = function() bookNames = scrapeGuestBook() return bookNames end,
    resolve = function() return resolveAll(true) end,
    grantResolved = grantResolved,
    list = function() return resolved end,
}
log("v" .. VERSION .. " loaded on place " .. tostring(game.PlaceId)
    .. " | RS=" .. tostring(getRS() ~= nil)
    .. " | httpget=" .. tostring(type(httpget) == "function"))
