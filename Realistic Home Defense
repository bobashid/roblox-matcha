--[[
  Game:       Realistic Home Defense
  Place IDs:  105527962898452
  Version:    v8.0
  Features:   infinite ammo (writes the equipped tool's RepValues and fires the Refil remote),
              plus RepValues diagnostics so the result is verifiable in the console
  Controls:   menu tab "Ammo"; one toggle, one slider, one toggle, three buttons
  Needs:      the RepValues writes need nothing; firing Refil needs hybrid mode
  Confirmed:  ACS_Engine.Modules.LockSettings recursively table.freeze()s every gun settings
              table, so ShootRate / camRecoil / MinSpread have no writable copy. That is why
              fire rate is NOT in this version - there is nothing a script can set.
  Confirmed:  ReplicatedStorage.ACS_Engine.Events.Refil is a RemoteEvent, not a frozen table,
              so the freeze cannot block it.
  Confirmed:  an equipped gun carries a RepValues folder with a BoolValue Chambered. Its
              NumberValue children are Instances, and Instance property writes are a different
              mechanism from table writes, so the freeze does not apply to them.
  UNVERIFIED: whether writing the ammo numbers keeps the gun firing (the server may re-assert
              ammo), and whether Refil:FireServer() needs arguments. The console prints every
              value before and after, so the answer is visible rather than guessed.
]]

local NAME    = 'RHD Ammo'
local VERSION = 'v8.0'
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local running = true
local conns = {}
local function track(c) conns[#conns + 1] = c; return c end

print('[' .. NAME .. '] ' .. VERSION)

-- ---- config -------------------------------------------------------------
local CFG = {}
CFG.infAmmo   = false
CFG.ammoValue = 9999
CFG.useRefil  = true

local STATS = {}
STATS.writes  = 0
STATS.refils  = 0
STATS.refilOk = 0
STATS.lastErr = 'none'

-- ---- game lookups -------------------------------------------------------
local function getTool()
    local ch = lp.Character
    if ch then
        local kids = ch:GetChildren()
        for i = 1, #kids do
            if kids[i].ClassName == 'Tool' then return kids[i] end
        end
    end
    local bp = lp:FindFirstChild('Backpack')
    if bp then
        local bk = bp:GetChildren()
        for i = 1, #bk do
            if bk[i].ClassName == 'Tool' then return bk[i] end
        end
    end
    return nil
end

local function getRefil()
    local eng = RS:FindFirstChild('ACS_Engine')
    if not eng then return nil end
    local ev = eng:FindFirstChild('Events')
    if not ev then return nil end
    return ev:FindFirstChild('Refil')
end

local function isAmmoName(n)
    local s = string.lower(tostring(n))
    if string.find(s, 'ammo', 1, true) then return true end
    if string.find(s, 'mag', 1, true) then return true end
    if string.find(s, 'clip', 1, true) then return true end
    return false
end

-- ---- RepValues ----------------------------------------------------------
local function dumpRep()
    local t = getTool()
    if t == nil then
        print('[' .. NAME .. '] no tool equipped - equip a gun first')
        return
    end
    print('[' .. NAME .. '] tool = ' .. t.Name)
    local rep = t:FindFirstChild('RepValues')
    if rep == nil then
        print('[' .. NAME .. '] RepValues missing on this tool')
        return
    end
    local kids = rep:GetChildren()
    print('[' .. NAME .. '] RepValues children = ' .. tostring(#kids))
    for i = 1, #kids do
        local c = kids[i]
        local ok, v = pcall(function() return c.Value end)
        local vs = 'nil'
        if ok and v ~= nil then vs = tostring(v) end
        print('[' .. NAME .. '] ' .. c.ClassName .. ' ' .. c.Name .. ' = ' .. vs)
    end
end

local function refillRep()
    local t = getTool()
    if t == nil then return 0 end
    local rep = t:FindFirstChild('RepValues')
    if rep == nil then return 0 end
    local n = 0
    local kids = rep:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c.ClassName == 'NumberValue' or c.ClassName == 'IntValue' then
            if isAmmoName(c.Name) then
                local ok = pcall(function() c.Value = CFG.ammoValue end)
                if ok then n = n + 1 end
            end
        end
    end
    STATS.writes = STATS.writes + n
    return n
end

-- ---- Refil remote -------------------------------------------------------
local function fireRefil()
    local r = getRefil()
    if r == nil then
        STATS.lastErr = 'Refil not found'
        return false
    end
    local ok = pcall(function() r:FireServer() end)
    STATS.refils = STATS.refils + 1
    if ok then
        STATS.refilOk = STATS.refilOk + 1
    else
        STATS.lastErr = 'Refil FireServer errored'
    end
    return ok
end

-- ---- apply loop ---------------------------------------------------------
task.spawn(function()
    while running do
        if CFG.infAmmo then
            local n = refillRep()
            if CFG.useRefil then fireRefil() end
            if n > 0 and STATS.writes % 20 == n then
                print('[' .. NAME .. '] wrote ' .. tostring(n) .. ' ammo values')
            end
        end
        task.wait(1)
    end
end)

-- ---- status -------------------------------------------------------------
local function reportStatus()
    local a = '[' .. NAME .. '] '
    local t = getTool()
    local tn = 'none'
    if t ~= nil then tn = t.Name end
    local hasRefil = 'no'
    if getRefil() ~= nil then hasRefil = 'yes' end
    print(a .. '--- status ---')
    print(a .. 'infAmmo=' .. tostring(CFG.infAmmo) .. ' value=' .. tostring(CFG.ammoValue))
    print(a .. 'useRefil=' .. tostring(CFG.useRefil) .. ' refilFound=' .. hasRefil)
    print(a .. 'tool=' .. tn)
    print(a .. 'writes=' .. tostring(STATS.writes) .. ' refils=' .. tostring(STATS.refils))
    print(a .. 'refilOk=' .. tostring(STATS.refilOk) .. ' lastErr=' .. STATS.lastErr)
    if STATS.writes == 0 and CFG.infAmmo then
        print(a .. 'writes=0 means no ammo-number child was found - press Dump RepValues')
    end
end

-- ---- UI helpers ---------------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES = {}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {}
    tries[1] = function() sec:Toggle(id, label, default, cb) end
    tries[2] = function() sec:Toggle(label, id, default, cb) end
    tries[3] = function() sec:Toggle(label, default, cb) end
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, mn, mx, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {}
    tries[1] = function() sec:SliderInt(id, label, mn, mx, default, cb) end
    tries[2] = function() sec:SliderInt(label, id, mn, mx, default, cb) end
    tries[3] = function() sec:SliderInt(label, mn, mx, default, cb) end
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function mkText(sec, s)
    pcall(function() sec:Text(s) end)
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = id }
end

-- ---- build the tab ------------------------------------------------------
local built = false

local function buildTab(tab)
    if built then return end
    built = true

    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Ammo')
        if not sec then return end

        mkToggle(sec, 'Infinite Ammo', 'rhd8_ammo', false, function(v)
            CFG.infAmmo = v
            print('[' .. NAME .. '] Infinite Ammo = ' .. tostring(v))
            if v then
                dumpRep()
                refillRep()
            end
        end)
        registerToggle('infAmmo', 'rhd8_ammo')

        mkSlider(sec, 'Ammo value', 'rhd8_val', 100, 99999, 9999, function(v)
            CFG.ammoValue = math.floor(v)
            print('[' .. NAME .. '] ammo value = ' .. tostring(CFG.ammoValue))
        end)

        mkToggle(sec, 'Also fire Refil remote', 'rhd8_refil', true, function(v)
            CFG.useRefil = v
            print('[' .. NAME .. '] use Refil = ' .. tostring(v))
        end)
        registerToggle('useRefil', 'rhd8_refil')

        mkButton(sec, 'Dump RepValues (read console)', function() dumpRep() end)
        mkButton(sec, 'Test Refil once', function() fireRefil() end)
        mkButton(sec, 'Status (read console)', function() reportStatus() end)

        mkText(sec, 'Equip a gun first, then Dump RepValues.')
        mkText(sec, 'writes=0 means no ammo number was found.')
        mkText(sec, 'Refil is a remote; the server may reject it.')
    end)

    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local okTab = pcall(function()
        UI.AddTab('Ammo', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not okTab then
        warn('[' .. NAME .. '] UI.AddTab failed')
        HAS_UI = false
    end
end

-- ---- widget poller ------------------------------------------------------
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil and CFG[t.key] ~= val then
                    CFG[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
            task.wait(0.15)
        end
    end)
end

-- ---- stop + register ----------------------------------------------------
local function stop()
    running = false
    CFG.infAmmo = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if HAS_UI then pcall(function() UI.RemoveTab('Ammo') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
pcall(notify, NAME .. ' ' .. VERSION, 'equip a gun, dump RepValues first', 4)
print('[' .. NAME .. '] loaded ' .. VERSION .. ' - no table writes, no game tables touched')

-- ---- respawn watch ------------------------------------------------------
local lastChar = lp.Character

if lp.CharacterAdded ~= nil then
    local okHook = pcall(function()
        track(lp.CharacterAdded:Connect(function()
            print('[' .. NAME .. '] respawn detected')
        end))
    end)
    if okHook then print('[' .. NAME .. '] CharacterAdded hook installed') end
end

task.spawn(function()
    while running do
        local ok, c = pcall(function() return lp.Character end)
        if ok and c ~= lastChar then
            lastChar = c
            print('[' .. NAME .. '] new character - re-dump RepValues')
        end
        task.wait(1)
    end
end)
