-- [[ Realistic Home Defense - Weapon Mods ]]  place 105527962898452
-- ACS engine. Confirmed in game: ReplicatedStorage.ACS_Engine.ToolStorage holds the
-- gun Tools (HK416, AR-15, MCX, RPG-7); an equipped gun carries ACS_Settings and a
-- RepValues folder. ACS_Settings defines ShootRate, MinSpread/MaxSpread, camRecoil,
-- gunRecoil, Ammo and AmmoInGun.
--
-- v3.0: the v2 breakage was the cache, not the idea. getgc('camRecoil') comes back
--   with ~46 hits per key - numbers, strings, functions and tables that merely carry
--   a field of the same name. applygc writes the new value into EVERY hit, so v2 was
--   pushing a recoil table into tables that never held one, and that is what broke
--   the held gun. v3 keeps only entries that actually look like the thing being
--   changed (a table containing camRecoilUp/gunRecoilUp for recoil, a plausible
--   number for spread / fire rate / ammo) and writes nothing at load.
-- v3.0 also fixes Rapid Fire: ShootRate here is rounds per minute (HK416 is 800), so
--   v2's 120 RPM slider made every gun SLOWER - which reads exactly like "no effect".
--   It now raises the rate, slider 600-3000, default 1500.
-- UNVERIFIED this round: the executor bridge left the chat, so nothing was re-probed
--   live. Writes are client-side only; server damage is untouched. Aimbot / Silent
--   Aim / Trigger Bot are Matcha built-ins and are not rebuilt here.

local NAME    = 'RHD Weapon Mods'
local VERSION = 'v3.0'
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local running = true
local conns   = {}
local function track(c) conns[#conns + 1] = c; return c end

print('[' .. NAME .. '] ' .. VERSION)

local HAS_GC = type(getgc) == 'function' and type(applygc) == 'function'
if not HAS_GC then warn('[' .. NAME .. '] getgc/applygc missing - need unsafe LuaU on') end

-- ---- config -------------------------------------------------------------
local CFG = {
    noRecoil = false,
    noSpread = false,
    rapid    = false,
    infAmmo  = false,
    rpm      = 1500,
}

-- ---- game helpers -------------------------------------------------------
local function getEquipped()
    local ch = lp.Character
    if not ch then return nil end
    local kids = ch:GetChildren()
    for i = 1, #kids do
        if kids[i].ClassName == 'Tool' then return kids[i] end
    end
    return nil
end

local function toolStorage()
    local eng = RS:FindFirstChild('ACS_Engine')
    if not eng then return nil end
    return eng:FindFirstChild('ToolStorage')
end

-- ---- GC: narrow cache per key, write only on demand ----------------------
local SLOTS = {}

local function slot(key)
    local s = SLOTS[key]
    if not s then
        s = { key = key, state = 'idle', entries = nil, origs = nil, last = nil }
        SLOTS[key] = s
    end
    return s
end

local function scan(key, accept)
    local s = slot(key)
    if s.state == 'scan' or s.state == 'ready' then return end
    s.state = 'scan'
    task.spawn(function()
        local t0 = tick()
        local ok, res = pcall(function() return getgc(key) end)
        local kept, origs = {}, {}
        if ok and type(res) == 'table' then
            for i = 1, #res do
                local e = res[i]
                local good = false
                if e.key == key then
                    local okA, keep = pcall(accept, e)
                    if okA and keep then good = true end
                end
                if good then
                    kept[#kept + 1] = e
                    origs[#origs + 1] = e.value
                end
            end
        end
        if #kept > 0 then
            s.entries, s.origs = kept, origs
            s.state = 'ready'
            s.last = nil
            print('[' .. NAME .. '] ' .. key .. ': kept ' .. tostring(#kept)
                .. ' of ' .. tostring(type(res) == 'table' and #res or 0)
                .. ' in ' .. string.format('%.1f', tick() - t0) .. 's')
        else
            s.state = 'idle'
            warn('[' .. NAME .. '] ' .. key .. ': nothing looked right, not writing')
        end
    end)
end

local function apply(key, value)
    local s = slot(key)
    if s.state ~= 'ready' or not s.entries then return false end
    if s.last == value then return true end
    local ok = pcall(applygc, s.entries, key, value)
    if ok then s.last = value end
    return ok
end

local function restore(key)
    local s = slot(key)
    if s.state ~= 'ready' or not s.entries then return end
    local n = 0
    for i = 1, #s.entries do
        if pcall(applygc, { s.entries[i] }, key, s.origs[i]) then n = n + 1 end
    end
    s.last = nil
    print('[' .. NAME .. '] restored ' .. key .. ' (' .. tostring(n) .. ' writes)')
end

-- predicates: only touch entries that are really the setting
local function acceptRecoil(e)
    if e.type ~= 'table' then return false end
    local v = e.value
    if type(v) ~= 'table' then return false end
    return v.camRecoilUp ~= nil or v.gunRecoilUp ~= nil
end

local function acceptNum(lo, hi)
    return function(e)
        if e.type ~= 'number' then return false end
        local v = e.value
        if type(v) ~= 'number' then return false end
        return v >= lo and v <= hi
    end
end

local ZERO_CAM = {
    camRecoilUp = { 0, 0 }, camRecoilTilt = { 0, 0 },
    camRecoilLeft = { 0, 0 }, camRecoilRight = { 0, 0 },
}
local ZERO_GUN = {
    gunRecoilUp = { 0, 0 }, gunRecoilTilt = { 0, 0 },
    gunRecoilLeft = { 0, 0 }, gunRecoilRight = { 0, 0 },
}

-- ---- apply loop: one gun equipped, toggles on, slow re-apply -------------
task.spawn(function()
    while running do
        if HAS_GC and getEquipped() ~= nil then
            if CFG.noRecoil then
                scan('camRecoil', acceptRecoil)
                apply('camRecoil', ZERO_CAM)
                scan('gunRecoil', acceptRecoil)
                apply('gunRecoil', ZERO_GUN)
            end
            if CFG.noSpread then
                scan('MinSpread', acceptNum(0.001, 200))
                apply('MinSpread', 0)
                scan('MaxSpread', acceptNum(1, 500))
                apply('MaxSpread', 1)
            end
            if CFG.rapid then
                scan('ShootRate', acceptNum(60, 3000))
                apply('ShootRate', CFG.rpm)
            end
            if CFG.infAmmo then
                scan('AmmoInGun', acceptNum(1, 400))
                local s = slot('AmmoInGun')
                if s.state == 'ready' and s.origs then
                    local full = 0
                    for i = 1, #s.origs do
                        local v = s.origs[i]
                        if type(v) == 'number' and v > full then full = v end
                    end
                    if full > 0 then apply('AmmoInGun', full) end
                end
            end
        end
        task.wait(1.5)
    end
end)

-- ---- weapon giver -------------------------------------------------------
local givenTools = {}

local function giveWeapon(tool)
    local bp = lp:FindFirstChild('Backpack')
    if not bp then
        warn('[' .. NAME .. '] no Backpack yet')
        return false
    end
    local clone = nil
    pcall(function() clone = tool:Clone() end)
    if clone ~= nil then
        if pcall(function() clone.Parent = bp end) then
            print('[' .. NAME .. '] ' .. tool.Name .. ' -> Backpack (copy)')
            return true
        end
    end
    givenTools[#givenTools + 1] = { tool = tool, parent = tool.Parent }
    if pcall(function() tool.Parent = bp end) then
        print('[' .. NAME .. '] ' .. tool.Name .. ' -> Backpack (moved)')
        return true
    end
    warn('[' .. NAME .. '] could not move ' .. tool.Name)
    return false
end

local function restoreTools()
    for i = 1, #givenTools do
        local e = givenTools[i]
        if e.parent ~= nil then pcall(function() e.tool.Parent = e.parent end) end
    end
    givenTools = {}
end

-- ---- UI helpers ---------------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES, getterWorks = {}, {}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, onApply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then onApply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, onApply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then onApply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function mkText(sec, s)
    pcall(function() sec:Text(s) end)
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = id }
end

-- ---- build the tab ------------------------------------------------------
local built = false
local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Weapon Mods')
        if sec then
            mkToggle(sec, 'No Recoil', 'rhd_norecoil', false, function(v)
                CFG.noRecoil = v
                print('[' .. NAME .. '] No Recoil = ' .. tostring(v))
            end)
            registerToggle('noRecoil', 'rhd_norecoil')

            mkToggle(sec, 'No Spread', 'rhd_nospread', false, function(v)
                CFG.noSpread = v
                print('[' .. NAME .. '] No Spread = ' .. tostring(v))
            end)
            registerToggle('noSpread', 'rhd_nospread')

            mkToggle(sec, 'Rapid Fire', 'rhd_rapid', false, function(v)
                CFG.rapid = v
                print('[' .. NAME .. '] Rapid Fire = ' .. tostring(v))
            end)
            registerToggle('rapid', 'rhd_rapid')

            mkSlider(sec, 'Fire Rate (RPM)', 'rhd_rpm', 600, 3000, 1500, function(v)
                CFG.rpm = math.floor(v)
                print('[' .. NAME .. '] RPM = ' .. tostring(CFG.rpm))
            end)

            mkToggle(sec, 'Infinite Ammo (client)', 'rhd_ammo', false, function(v)
                CFG.infAmmo = v
                print('[' .. NAME .. '] Infinite Ammo = ' .. tostring(v))
            end)
            registerToggle('infAmmo', 'rhd_ammo')

            mkButton(sec, 'Restore all original values', function()
                restore('camRecoil')
                restore('gunRecoil')
                restore('MinSpread')
                restore('MaxSpread')
                restore('ShootRate')
                restore('AmmoInGun')
            end)

            mkButton(sec, 'Show cache status', function()
                local keys = { 'camRecoil', 'gunRecoil', 'MinSpread', 'MaxSpread', 'ShootRate', 'AmmoInGun' }
                for i = 1, #keys do
                    local s = slot(keys[i])
                    print('[' .. NAME .. '] ' .. keys[i] .. ' = ' .. tostring(s.state)
                        .. ' kept ' .. tostring(s.entries and #s.entries or 0))
                end
            end)

            mkText(sec, 'Each toggle scans its own key once, then writes every 1.5s.')
            mkText(sec, 'Infinite Ammo refills from the mag size seen when it scanned.')
            mkText(sec, 'RPM here is rounds per minute (HK416 stock is 800).')
        end

        local sec2 = mkSection(tab, 'Give Weapon')
        if sec2 then
            local ts = toolStorage()
            if ts then
                local kids = ts:GetChildren()
                local n = 0
                for i = 1, #kids do
                    local t = kids[i]
                    if t.ClassName == 'Tool' then
                        n = n + 1
                        mkButton(sec2, t.Name, function() giveWeapon(t) end)
                    end
                end
                if n == 0 then mkText(sec2, 'ToolStorage is empty right now.') end
            else
                mkText(sec2, 'ACS_Engine.ToolStorage not found.')
            end
            mkButton(sec2, 'Put weapons back', function() restoreTools() end)
            mkText(sec2, 'Client-side only; the server may refuse to use it.')
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Weapon Mods', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- widget poller ------------------------------------------------------
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil then
                    getterWorks[t.key] = true
                    if CFG[t.key] ~= val then
                        CFG[t.key] = val
                        print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                    end
                end
            end
            local okr, vr = pcall(function() return UI.GetValue('rhd_rpm') end)
            if okr and type(vr) == 'number' then CFG.rpm = math.floor(vr) end
            task.wait(0.15)
        end
    end)
end

-- ---- go -----------------------------------------------------------------
pcall(notify, NAME .. ' ' .. VERSION, 'loaded - equip a gun, flip a toggle', 4)
print('[' .. NAME .. '] loaded ' .. VERSION .. ' - no scans and no writes yet')

local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    restore('camRecoil')
    restore('gunRecoil')
    restore('MinSpread')
    restore('MaxSpread')
    restore('ShootRate')
    restore('AmmoInGun')
    restoreTools()
    if HAS_UI then pcall(function() UI.RemoveTab('Weapon Mods') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
