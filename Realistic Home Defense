--[[
  Game:       Realistic Home Defense
  Place IDs:  105527962898452
  Version:    v6.0
  Features:   no recoil only (the four camRecoil {min,max} pairs zeroed)
  Controls:   menu tab "No Recoil"; one toggle, three buttons, nothing else
  Needs:      Matcha Pro / Allow Unsafe LuaU (getgc, applygc)
  Confirmed:  ACS_Engine.ToolStorage holds the gun Tools (HK416, AR-15, MCX, RPG-7) and
              ACS_Settings defines camRecoil = { camRecoilUp/Tilt/Left/Right = {min,max} }
  Confirmed:  require(<ModuleScript>) fails in Matcha, so the settings table cannot be read
  Confirmed:  Player.CharacterAdded is nil here; v4.0 died on that hook, so this polls
  Confirmed:  measured earlier this session: getgc('camRecoil') returned 35 entries and only
              2 of them were tables (9 functions, 20 unknown, 4 strings). So the real recoil
              data is a very small number of entries - which is exactly why this version
              targets the four inner pairs instead of replacing the whole camRecoil table.
              Replacing the table is what changed its shape; writing {0,0} into a slot that
              already holds {min,max} cannot change the shape at all.
  UNVERIFIED: whether zeroing those pairs removes the camera kick, and whether the gun must be
              re-equipped first because the settings may be copied at equip time
  UNVERIFIED: whether applygc accepts a filtered subset of the getgc cache (this build has
              never been shown to fail at it, but it has never been proven either)
]]

local NAME    = 'RHD No Recoil'
local VERSION = 'v6.0'
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players = game:GetService('Players')
local lp      = Players.LocalPlayer

local running = true
local conns   = {}
local function track(c) conns[#conns + 1] = c; return c end

print('[' .. NAME .. '] ' .. VERSION)

local HAS_GC = type(getgc) == 'function' and type(applygc) == 'function'
if not HAS_GC then
    warn('[' .. NAME .. '] getgc/applygc missing - turn on Allow Unsafe LuaU')
end

-- ---- config -------------------------------------------------------------
local CFG = {
    noRecoil = false,
    reapply  = 1.0,
}

-- each of these holds a two-number {min,max} table inside camRecoil
local RECOIL_KEYS = { 'camRecoilUp', 'camRecoilTilt', 'camRecoilLeft', 'camRecoilRight' }

local SLOTS    = {}
local scanning = false

-- ---- scan + apply -------------------------------------------------------
local function slot(key)
    local s = SLOTS[key]
    if not s then
        s = { key = key, entries = nil, orig = nil, state = 'idle' }
        SLOTS[key] = s
    end
    return s
end

local function pairPred(e)
    if e.type ~= 'table' then return false end
    local v = e.value
    if type(v) ~= 'table' then return false end
    if type(v[1]) ~= 'number' then return false end
    if type(v[2]) ~= 'number' then return false end
    return true
end

local function scanKey(key)
    local s = slot(key)
    local t0 = os.clock()
    local ok, res = pcall(function() return getgc(key) end)
    local total = 0
    local kept, origs = {}, {}
    if ok and type(res) == 'table' then
        total = #res
        for i = 1, #res do
            local e = res[i]
            if e.key == key and pairPred(e) then
                kept[#kept + 1] = e
                origs[#origs + 1] = { e.value[1], e.value[2] }
            end
        end
    end
    s.entries, s.orig = kept, origs
    s.state = (#kept > 0) and 'ready' or 'empty'
    print(string.format('[%s] %s: kept %d of %d (%.1fs)',
        NAME, key, #kept, total, os.clock() - t0))
    return #kept
end

local function anyReady()
    for i = 1, #RECOIL_KEYS do
        if slot(RECOIL_KEYS[i]).state == 'ready' then return true end
    end
    return false
end

local function scanAll()
    if not HAS_GC then
        warn('[' .. NAME .. '] cannot scan without getgc')
        return
    end
    if scanning then
        print('[' .. NAME .. '] already scanning')
        return
    end
    scanning = true
    task.spawn(function()
        print('[' .. NAME .. '] scanning 4 keys, about 20s, please wait')
        local total = 0
        for i = 1, #RECOIL_KEYS do
            total = total + scanKey(RECOIL_KEYS[i])
            task.wait(0.3)
        end
        scanning = false
        print('[' .. NAME .. '] scan done: ' .. tostring(total) .. ' entries kept')
        pcall(notify, 'Scan done: ' .. tostring(total) .. ' entries', NAME, 4)
    end)
end

local function applyAll()
    local n = 0
    for i = 1, #RECOIL_KEYS do
        local s = slot(RECOIL_KEYS[i])
        if s.state == 'ready' and s.entries then
            local ok, c = pcall(applygc, s.entries, s.key, { 0, 0 })
            if ok and type(c) == 'number' then n = n + c end
        end
    end
    return n
end

local function restoreAll()
    local n = 0
    for i = 1, #RECOIL_KEYS do
        local s = slot(RECOIL_KEYS[i])
        if s.state == 'ready' and s.entries and s.orig then
            for j = 1, #s.entries do
                local ok, c = pcall(applygc, { s.entries[j] }, s.key, s.orig[j])
                if ok and type(c) == 'number' then n = n + c end
            end
        end
    end
    print('[' .. NAME .. '] restored ' .. tostring(n) .. ' values')
    return n
end

local function reportStatus()
    print('[' .. NAME .. '] --- status ---')
    print('[' .. NAME .. '] noRecoil = ' .. tostring(CFG.noRecoil)
        .. ', scanning = ' .. tostring(scanning))
    for i = 1, #RECOIL_KEYS do
        local s = slot(RECOIL_KEYS[i])
        print('[' .. NAME .. '] ' .. RECOIL_KEYS[i] .. ' = ' .. tostring(s.state)
            .. ', entries ' .. tostring(s.entries and #s.entries or 0))
    end
end

-- ---- apply loop (writes only, never scans) ------------------------------
task.spawn(function()
    local last = 0
    while running do
        if CFG.noRecoil and HAS_GC and anyReady() then
            if os.clock() - last >= CFG.reapply then
                last = os.clock()
                applyAll()
            end
        end
        task.wait(0.2)
    end
end)

-- ---- UI helpers ---------------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES = {}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function mkText(sec, s)
    pcall(function() sec:Text(s) end)
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = id }
end

-- ---- build the tab ------------------------------------------------------
local built = false
local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'No Recoil')
        if not sec then return end

        mkButton(sec, 'Test scan (read console)', function() scanAll() end)
        mkButton(sec, 'Status (read console)', function() reportStatus() end)
        mkButton(sec, 'Restore original values', function() restoreAll() end)

        mkToggle(sec, 'No Recoil', 'rhd6_norecoil', false, function(v)
            if v == CFG.noRecoil then return end
            CFG.noRecoil = v
            print('[' .. NAME .. '] No Recoil = ' .. tostring(v))
            if v then
                if not anyReady() and not scanning then scanAll() end
            else
                restoreAll()
            end
        end)
        registerToggle('noRecoil', 'rhd6_norecoil')

        mkText(sec, 'Scan once, then flip No Recoil. Re-equip the gun if nothing changes.')
        mkText(sec, 'Only the four camRecoil {min,max} pairs are written; nothing else.')
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('No Recoil', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- widget poller ------------------------------------------------------
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil and CFG[t.key] ~= val then
                    CFG[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                    if t.key == 'noRecoil' then
                        if val then
                            if not anyReady() and not scanning then scanAll() end
                        else
                            restoreAll()
                        end
                    end
                end
            end
            task.wait(0.15)
        end
    end)
end

-- ---- stop + register (before anything optional) -------------------------
local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    restoreAll()
    if HAS_UI then pcall(function() UI.RemoveTab('No Recoil') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
pcall(notify, NAME .. ' ' .. VERSION, 'scan once, then flip No Recoil', 4)
print('[' .. NAME .. '] loaded ' .. VERSION .. ' - nothing scanned, nothing written')

-- ---- respawn watch (CharacterAdded is nil here) -------------------------
local lastChar = lp.Character

if lp.CharacterAdded ~= nil then
    local ok = pcall(function()
        track(lp.CharacterAdded:Connect(function()
            print('[' .. NAME .. '] respawn detected')
        end))
    end)
    if ok then print('[' .. NAME .. '] CharacterAdded hook installed') end
end

task.spawn(function()
    while running do
        local ok, c = pcall(function() return lp.Character end)
        if ok and c ~= lastChar then
            lastChar = c
            SLOTS = {}
            print('[' .. NAME .. '] new character - cache cleared')
            if CFG.noRecoil then scanAll() end
        end
        task.wait(1)
    end
end)
