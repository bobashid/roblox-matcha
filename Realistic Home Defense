-- [[ Realistic Home Defense - Weapon Mods ]]  place 105527962898452
-- ACS engine. Confirmed in game: ReplicatedStorage.ACS_Engine.ToolStorage holds the
-- gun Tools (HK416, AR-15, MCX, RPG-7); the equipped copy carries ACS_Settings and a
-- RepValues folder; ACS_Settings defines ShootRate, MinSpread/MaxSpread, camRecoil,
-- gunRecoil, AmmoInGun.
-- v2.0: nothing is scanned at load and nothing is written unless the matching toggle
--   is ON and a gun is actually equipped. One GC key at a time (fast) instead of the
--   old six-key sweep that lagged the client and broke the held gun. Recoil only
--   touches camRecoil, so the gun model's own kick animation is left alone.
-- UNVERIFIED since the executor bridge dropped out of the chat: these are
--   client-side writes only, server-side damage is untouched, and the values were
--   not re-probed in the live game. Aimbot / Silent Aim / Trigger Bot are Matcha
--   built-ins and are not rebuilt here.

local NAME    = 'RHD Weapon Mods'
local VERSION = 'v2.0'
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local running = true
local conns   = {}
local function track(c) conns[#conns + 1] = c; return c end

print('[' .. NAME .. '] ' .. VERSION)

-- ---- config -------------------------------------------------------------
local CFG = {
    noRecoil = false,
    noSpread = false,
    rapid    = false,
    infAmmo  = false,
    rpm      = 120,
    ammoCap  = 250,
}

-- ---- game helpers -------------------------------------------------------
local function getEquipped()
    local ch = lp.Character
    if not ch then return nil end
    local kids = ch:GetChildren()
    for i = 1, #kids do
        if kids[i].ClassName == 'Tool' then return kids[i] end
    end
    return nil
end

local function toolStorage()
    local eng = RS:FindFirstChild('ACS_Engine')
    if not eng then return nil end
    return eng:FindFirstChild('ToolStorage')
end

local function refillRep(tool)
    local rep = tool:FindFirstChild('RepValues')
    if not rep then return end
    local kids = rep:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c.ClassName == 'NumberValue' or c.ClassName == 'IntValue' then
            local n = string.lower(c.Name)
            if string.find(n, 'ammo', 1, true) or string.find(n, 'mag', 1, true) then
                pcall(function() c.Value = CFG.ammoCap end)
            end
        end
    end
end

-- ---- GC: one key at a time, only on demand ------------------------------
-- getgc on a single key returns in a few seconds; the six-key sweep the old
-- version ran at load is what made the client stutter and the held gun misbehave.
local GC = {}

local function slot(key)
    if not GC[key] then
        GC[key] = { key = key, state = 'idle', cache = nil, origNum = {}, origTab = nil, last = nil }
    end
    return GC[key]
end

local function scanKey(key)
    local g = slot(key)
    if g.state == 'scan' or g.state == 'ready' then return end
    g.state = 'scan'
    task.spawn(function()
        local t0 = tick()
        local ok, res = pcall(function() return getgc(key) end)
        if ok and type(res) == 'table' and #res > 0 then
            g.cache = res
            g.origNum = {}
            g.origTab = nil
            for i = 1, #res do
                local e = res[i]
                if e.key == key then
                    if e.type == 'number' then
                        if g.origNum[i] == nil then g.origNum[i] = e.value end
                    elseif e.type == 'table' and g.origTab == nil then
                        g.origTab = e.value
                    end
                end
            end
            g.state = 'ready'
            print('[' .. NAME .. '] ' .. key .. ' cache ready: ' .. tostring(#res)
                .. ' entries in ' .. string.format('%.1f', tick() - t0) .. 's')
        else
            g.state = 'idle'
            warn('[' .. NAME .. '] getgc(' .. key .. ') returned nothing')
        end
    end)
end

local function applyKey(key, value)
    local g = slot(key)
    if g.state ~= 'ready' or not g.cache then return false end
    if g.last == value then return true end
    local ok = pcall(applygc, g.cache, key, value)
    if ok then g.last = value end
    return ok
end

local function restoreKey(key)
    local g = slot(key)
    if g.state ~= 'ready' or not g.cache then return end
    local n = 0
    for i = 1, #g.cache do
        local e = g.cache[i]
        if e.key == key then
            if e.type == 'number' and g.origNum[i] ~= nil then
                if pcall(applygc, { e }, key, g.origNum[i]) then n = n + 1 end
            elseif e.type == 'table' and g.origTab ~= nil then
                if pcall(applygc, g.cache, key, g.origTab) then n = n + 1 end
            end
        end
    end
    g.last = nil
    print('[' .. NAME .. '] restored ' .. key .. ' (' .. tostring(n) .. ' writes)')
end

local ZERO_CAM = {
    camRecoilUp = { 0, 0 }, camRecoilTilt = { 0, 0 },
    camRecoilLeft = { 0, 0 }, camRecoilRight = { 0, 0 },
}

-- ---- apply loop ---------------------------------------------------------
task.spawn(function()
    while running do
        if getEquipped() ~= nil then
            if CFG.noRecoil then
                scanKey('camRecoil')
                applyKey('camRecoil', ZERO_CAM)
            end
            if CFG.noSpread then
                scanKey('MinSpread')
                applyKey('MinSpread', 0)
            end
            if CFG.rapid then
                scanKey('ShootRate')
                applyKey('ShootRate', CFG.rpm)
            end
            if CFG.infAmmo then
                local t = getEquipped()
                if t then refillRep(t) end
            end
        end
        task.wait(0.5)
    end
end)

-- ---- weapon giver -------------------------------------------------------
local givenTools = {}

local function giveWeapon(tool)
    local bp = lp:FindFirstChild('Backpack')
    if not bp then
        warn('[' .. NAME .. '] no Backpack yet')
        return false
    end
    local clone = nil
    pcall(function() clone = tool:Clone() end)
    if clone ~= nil then
        if pcall(function() clone.Parent = bp end) then
            print('[' .. NAME .. '] ' .. tool.Name .. ' -> Backpack (copy)')
            return true
        end
    end
    givenTools[#givenTools + 1] = { tool = tool, parent = tool.Parent }
    if pcall(function() tool.Parent = bp end) then
        print('[' .. NAME .. '] ' .. tool.Name .. ' -> Backpack (moved)')
        return true
    end
    warn('[' .. NAME .. '] could not move ' .. tool.Name)
    return false
end

local function restoreTools()
    for i = 1, #givenTools do
        local e = givenTools[i]
        if e.parent ~= nil then pcall(function() e.tool.Parent = e.parent end) end
    end
    givenTools = {}
end

-- ---- UI helpers ---------------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES, getterWorks = {}, {}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function mkText(sec, s)
    pcall(function() sec:Text(s) end)
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = id }
end

-- ---- build the tab ------------------------------------------------------
local built = false
local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Weapon Mods')
        if sec then
            mkToggle(sec, 'No Recoil', 'rhd_norecoil', false, function(v)
                CFG.noRecoil = v
                print('[' .. NAME .. '] No Recoil = ' .. tostring(v))
                if v then scanKey('camRecoil') else restoreKey('camRecoil') end
            end)
            registerToggle('noRecoil', 'rhd_norecoil')

            mkToggle(sec, 'No Spread', 'rhd_nospread', false, function(v)
                CFG.noSpread = v
                print('[' .. NAME .. '] No Spread = ' .. tostring(v))
                if v then scanKey('MinSpread') else restoreKey('MinSpread') end
            end)
            registerToggle('noSpread', 'rhd_nospread')

            mkToggle(sec, 'Rapid Fire', 'rhd_rapid', false, function(v)
                CFG.rapid = v
                print('[' .. NAME .. '] Rapid Fire = ' .. tostring(v))
                if v then scanKey('ShootRate') else restoreKey('ShootRate') end
            end)
            registerToggle('rapid', 'rhd_rapid')

            mkSlider(sec, 'Fire Rate (RPM)', 'rhd_rpm', 40, 600, 120, function(v)
                CFG.rpm = math.floor(v)
                print('[' .. NAME .. '] RPM = ' .. tostring(CFG.rpm))
            end)

            mkToggle(sec, 'Infinite Ammo (client)', 'rhd_ammo', false, function(v)
                CFG.infAmmo = v
                print('[' .. NAME .. '] Infinite Ammo = ' .. tostring(v))
            end)
            registerToggle('infAmmo', 'rhd_ammo')

            mkButton(sec, 'Restore all original values', function()
                restoreKey('camRecoil')
                restoreKey('MinSpread')
                restoreKey('ShootRate')
            end)

            mkButton(sec, 'Show cache status', function()
                local keys = { 'camRecoil', 'MinSpread', 'ShootRate' }
                for i = 1, #keys do
                    local g = slot(keys[i])
                    print('[' .. NAME .. '] ' .. keys[i] .. ' = ' .. tostring(g.state)
                        .. ' (' .. tostring(g.cache and #g.cache or 0) .. ')')
                end
            end)

            mkText(sec, 'Scans start when you flip a toggle, one key at a time.')
            mkText(sec, 'A gun must be equipped for a value to be written.')
        end

        local sec2 = mkSection(tab, 'Give Weapon')
        if sec2 then
            local ts = toolStorage()
            if ts then
                local kids = ts:GetChildren()
                local n = 0
                for i = 1, #kids do
                    local t = kids[i]
                    if t.ClassName == 'Tool' then
                        n = n + 1
                        mkButton(sec2, t.Name, function() giveWeapon(t) end)
                    end
                end
                if n == 0 then mkText(sec2, 'ToolStorage is empty right now.') end
            else
                mkText(sec2, 'ACS_Engine.ToolStorage not found.')
            end
            mkButton(sec2, 'Put weapons back', function() restoreTools() end)
            mkText(sec2, 'Client-side only; the server may refuse to use it.')
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Weapon Mods', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- widget poller ------------------------------------------------------
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil then
                    getterWorks[t.key] = true
                    if CFG[t.key] ~= val then
                        CFG[t.key] = val
                        print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                    end
                end
            end
            local okr, vr = pcall(function() return UI.GetValue('rhd_rpm') end)
            if okr and type(vr) == 'number' then CFG.rpm = math.floor(vr) end
            task.wait(0.15)
        end
    end)
end

-- ---- go -----------------------------------------------------------------
pcall(notify, NAME .. ' ' .. VERSION, 'loaded - flip a toggle to scan', 4)
print('[' .. NAME .. '] loaded ' .. VERSION .. ' - nothing scanned, no writes yet')

local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    restoreKey('camRecoil')
    restoreKey('MinSpread')
    restoreKey('ShootRate')
    restoreTools()
    if HAS_UI then pcall(function() UI.RemoveTab('Weapon Mods') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
