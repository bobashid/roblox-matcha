--[[
  Game:       Realistic Home Defense
  Place IDs:  105527962898452
  Version:    v4.1
  Features:   no recoil, no spread, rapid fire, infinite ammo (client), weapon giver, GC diagnostics
  Controls:   menu tab "Weapon Mods"; every control is a toggle, slider or button
  Needs:      Matcha Pro / Allow Unsafe LuaU (getgc, applygc)
  Confirmed:  ACS_Engine.ToolStorage holds the gun Tools (HK416, AR-15, MCX, RPG-7);
              ACS_Settings defines ShootRate (HK416 = 800 rounds per minute), MinSpread /
              MaxSpread, camRecoil, gunRecoil, Ammo / AmmoInGun / MaxStoredAmmo; an equipped
              gun carries a RepValues folder
  Confirmed:  require(<ModuleScript>) fails in Matcha, so the settings table cannot be read
              through require; getgc on the field names is the only route
  Confirmed:  Player.CharacterAdded reads nil here - v4.0 died with
              "Matcha:548: attempt to index nil with 'Connect'" on that hook, which killed
              the tail of the chunk (no loaded print, no _G registration). v4.1 polls
              lp.Character for respawns and runs the hook last, inside pcall.
  UNVERIFIED: that a getgc entry's addr is the address of the table holding the key. The
              script uses it to intersect keys so applygc only touches real settings tables;
              if that is wrong it falls back to plain value-range filtering
  UNVERIFIED: whether the server re-applies any of these values after the client writes them
]]

local NAME    = 'RHD Weapon Mods'
local VERSION = 'v4.1'
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local running = true
local conns   = {}
local function track(c) conns[#conns + 1] = c; return c end

print('[' .. NAME .. '] ' .. VERSION)

local HAS_GC = type(getgc) == 'function' and type(applygc) == 'function'
if not HAS_GC then
    warn('[' .. NAME .. '] getgc/applygc missing - turn on Allow Unsafe LuaU')
end

-- ---- config -------------------------------------------------------------
local CFG = {
    noRecoil   = false,
    noSpread   = false,
    rapid      = false,
    infAmmo    = false,
    rpm        = 1500,
    ammo       = 9999,
    autoRescan = true,
}

local STATS = { scans = 0, writes = 0, last = 'nothing scanned yet' }

-- ---- game helpers -------------------------------------------------------
local function getTool()
    local ch = lp.Character
    if ch then
        local kids = ch:GetChildren()
        for i = 1, #kids do
            if kids[i].ClassName == 'Tool' then return kids[i] end
        end
    end
    local bp = lp:FindFirstChild('Backpack')
    if bp then
        local bk = bp:GetChildren()
        for i = 1, #bk do
            if bk[i].ClassName == 'Tool' then return bk[i] end
        end
    end
    return nil
end

local function toolStorage()
    local eng = RS:FindFirstChild('ACS_Engine')
    if not eng then return nil end
    return eng:FindFirstChild('ToolStorage')
end

local function refillRep(tool)
    local rep = tool:FindFirstChild('RepValues')
    if not rep then return end
    local kids = rep:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c.ClassName == 'NumberValue' or c.ClassName == 'IntValue' then
            local n = string.lower(c.Name)
            if string.find(n, 'ammo', 1, true) or string.find(n, 'mag', 1, true) then
                pcall(function() c.Value = CFG.ammo end)
            end
        end
    end
end

-- ---- GC: find the real settings tables, write only there --------------
-- getgc(key) returns one entry per table that carries that key: `value` is the value
-- stored under the key and `addr` identifies where it lives. An entry for camRecoil
-- whose value is a recoil table is therefore inside a genuine ACS settings table, so
-- its addr marks one. Every other key is then written only at those addrs. Writing to
-- every table that happens to have a key named ShootRate or MinSpread is what broke
-- the held gun in earlier versions.

local ZERO_CAM = {
    camRecoilUp = { 0, 0 }, camRecoilTilt = { 0, 0 },
    camRecoilLeft = { 0, 0 }, camRecoilRight = { 0, 0 },
}
local ZERO_GUN = {
    gunRecoilUp = { 0, 0 }, gunRecoilTilt = { 0, 0 },
    gunRecoilLeft = { 0, 0 }, gunRecoilRight = { 0, 0 },
}

local anchorAddrs = {}
local SLOTS = {}

local function slot(key)
    local s = SLOTS[key]
    if not s then
        s = { key = key, state = 'idle', entries = nil, orig = nil, next = 0 }
        SLOTS[key] = s
    end
    return s
end

local function anchorPred(e)
    if e.type ~= 'table' then return false end
    if type(e.value) ~= 'table' then return false end
    local v = e.value
    return v.camRecoilUp ~= nil or v.gunRecoilUp ~= nil
end

local function numPred(lo, hi)
    return function(e, raw)
        if e.type ~= 'number' then return false end
        if type(e.value) ~= 'number' then return false end
        if e.value < lo or e.value > hi then return false end
        if not raw and next(anchorAddrs) ~= nil and anchorAddrs[e.addr] ~= true then
            return false
        end
        return true
    end
end

local function collect(res, key, pred, raw)
    local kept = {}
    for i = 1, #res do
        local e = res[i]
        if e.key == key then
            local okp, keep = pcall(pred, e, raw)
            if okp and keep then kept[#kept + 1] = e end
        end
    end
    return kept
end

local function scanKey(key, pred, force)
    local s = slot(key)
    if not HAS_GC then return end
    if s.state == 'scan' then return end
    if s.state == 'ready' and not force then return end
    s.state = 'scan'
    task.spawn(function()
        local t0 = os.clock()
        local ok, res = pcall(function() return getgc(key) end)
        local total = 0
        local kept = {}
        if ok and type(res) == 'table' then
            total = #res
            kept = collect(res, key, pred, false)
            if #kept == 0 then
                kept = collect(res, key, pred, true)
            end
        end
        if #kept > 0 then
            s.entries = kept
            if s.orig == nil then
                local o = {}
                for i = 1, #kept do o[i] = kept[i].value end
                s.orig = o
            end
            s.state = 'ready'
        else
            s.entries = nil
            s.state = 'idle'
        end
        if key == 'camRecoil' then
            anchorAddrs = {}
            if s.state == 'ready' then
                for i = 1, #s.entries do
                    anchorAddrs[s.entries[i].addr] = true
                end
            end
        end
        s.next = os.clock() + 8
        STATS.scans = STATS.scans + 1
        STATS.last = key .. ': kept ' .. tostring(#kept) .. ' of ' .. tostring(total)
            .. ' in ' .. string.format('%.1fs', os.clock() - t0)
        print('[' .. NAME .. '] ' .. STATS.last)
    end)
end

local function applyKey(key, value)
    local s = slot(key)
    if s.state ~= 'ready' or not s.entries then return 0 end
    local ok, n = pcall(applygc, s.entries, key, value)
    if ok and type(n) == 'number' then
        STATS.writes = STATS.writes + n
        return n
    end
    return 0
end

local function restoreKey(key)
    local s = slot(key)
    if s.state ~= 'ready' or not s.entries or not s.orig then return 0 end
    local n = 0
    for i = 1, #s.entries do
        local ok, c = pcall(applygc, { s.entries[i] }, key, s.orig[i])
        if ok and type(c) == 'number' then n = n + c end
    end
    print('[' .. NAME .. '] restored ' .. key .. ' (' .. tostring(n) .. ' writes)')
    return n
end

local ALL_KEYS = { 'camRecoil', 'gunRecoil', 'MinSpread', 'MaxSpread', 'ShootRate', 'AmmoInGun' }

local function restoreAll()
    for i = 1, #ALL_KEYS do restoreKey(ALL_KEYS[i]) end
end

local function anyOn()
    return CFG.noRecoil or CFG.noSpread or CFG.rapid or CFG.infAmmo
end

-- ---- apply loop --------------------------------------------------------
task.spawn(function()
    while running do
        if HAS_GC and anyOn() then
            local a = slot('camRecoil')
            if a.state ~= 'ready' then
                if os.clock() >= a.next then scanKey('camRecoil', anchorPred) end
            elseif CFG.autoRescan and os.clock() >= a.next then
                scanKey('camRecoil', anchorPred, true)
            end

            if a.state == 'ready' then
                if CFG.noRecoil then
                    applyKey('camRecoil', ZERO_CAM)
                    local gr = slot('gunRecoil')
                    if gr.state ~= 'ready' then
                        if os.clock() >= gr.next then scanKey('gunRecoil', anchorPred) end
                    else
                        applyKey('gunRecoil', ZERO_GUN)
                    end
                end

                if CFG.noSpread then
                    local ms = slot('MinSpread')
                    if ms.state ~= 'ready' then
                        if os.clock() >= ms.next then scanKey('MinSpread', numPred(0.0001, 60)) end
                    else
                        applyKey('MinSpread', 0)
                    end
                    local xs = slot('MaxSpread')
                    if xs.state ~= 'ready' then
                        if os.clock() >= xs.next then scanKey('MaxSpread', numPred(1, 500)) end
                    else
                        applyKey('MaxSpread', 0)
                    end
                end

                if CFG.rapid then
                    local sr = slot('ShootRate')
                    if sr.state ~= 'ready' then
                        if os.clock() >= sr.next then scanKey('ShootRate', numPred(60, 3000)) end
                    else
                        applyKey('ShootRate', CFG.rpm)
                    end
                end

                if CFG.infAmmo then
                    local am = slot('AmmoInGun')
                    if am.state ~= 'ready' then
                        if os.clock() >= am.next then scanKey('AmmoInGun', numPred(1, 500)) end
                    else
                        applyKey('AmmoInGun', CFG.ammo)
                    end
                    local t = getTool()
                    if t then refillRep(t) end
                end
            end
        end
        task.wait(1)
    end
end)

-- ---- weapon giver ------------------------------------------------------
local givenTools = {}

local function giveWeapon(tool)
    local bp = lp:FindFirstChild('Backpack')
    if not bp then
        warn('[' .. NAME .. '] no Backpack yet')
        return false
    end
    local clone = nil
    pcall(function() clone = tool:Clone() end)
    if clone ~= nil then
        if pcall(function() clone.Parent = bp end) then
            print('[' .. NAME .. '] ' .. tool.Name .. ' -> Backpack (copy)')
            return true
        end
    end
    givenTools[#givenTools + 1] = { tool = tool, parent = tool.Parent }
    if pcall(function() tool.Parent = bp end) then
        print('[' .. NAME .. '] ' .. tool.Name .. ' -> Backpack (moved)')
        return true
    end
    warn('[' .. NAME .. '] could not move ' .. tool.Name)
    return false
end

local function restoreTools()
    for i = 1, #givenTools do
        local e = givenTools[i]
        if e.parent ~= nil then pcall(function() e.tool.Parent = e.parent end) end
    end
    givenTools = {}
end

-- ---- UI helpers --------------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES = {}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function mkText(sec, s)
    pcall(function() sec:Text(s) end)
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = id }
end

local function countAddrs()
    local n = 0
    for k in pairs(anchorAddrs) do n = n + 1 end
    return n
end

local function reportStatus()
    print('[' .. NAME .. '] --- status ---')
    print('[' .. NAME .. '] scans ' .. tostring(STATS.scans) .. ', writes ' .. tostring(STATS.writes))
    print('[' .. NAME .. '] last: ' .. STATS.last)
    print('[' .. NAME .. '] anchor addrs ' .. tostring(countAddrs()))
    for i = 1, #ALL_KEYS do
        local s = slot(ALL_KEYS[i])
        print('[' .. NAME .. '] ' .. ALL_KEYS[i] .. ' = ' .. tostring(s.state)
            .. ', entries ' .. tostring(s.entries and #s.entries or 0))
    end
end

-- ---- build the tab -----------------------------------------------------
local built = false
local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Step 1 - Detect')
        if sec then
            mkButton(sec, 'Scan settings tables', function()
                print('[' .. NAME .. '] scanning, 10-20s')
                anchorAddrs = {}
                scanKey('camRecoil', anchorPred, true)
            end)
            mkButton(sec, 'Status (read the console)', function() reportStatus() end)
            mkButton(sec, 'Restore original values', function() restoreAll() end)
            mkToggle(sec, 'Auto rescan (every 8s)', 'rhd_rescan', true, function(v)
                CFG.autoRescan = v
                print('[' .. NAME .. '] auto rescan = ' .. tostring(v))
            end)
            registerToggle('autoRescan', 'rhd_rescan')
            mkText(sec, 'Scan first, then flip mods in Step 2.')
            mkText(sec, 'Only keys found inside a real settings table get written.')
        end

        local sec2 = mkSection(tab, 'Step 2 - Mods')
        if sec2 then
            mkToggle(sec2, 'No Recoil', 'rhd_norecoil', false, function(v)
                CFG.noRecoil = v
                print('[' .. NAME .. '] No Recoil = ' .. tostring(v))
            end)
            registerToggle('noRecoil', 'rhd_norecoil')

            mkToggle(sec2, 'No Spread', 'rhd_nospread', false, function(v)
                CFG.noSpread = v
                print('[' .. NAME .. '] No Spread = ' .. tostring(v))
            end)
            registerToggle('noSpread', 'rhd_nospread')

            mkToggle(sec2, 'Rapid Fire', 'rhd_rapid', false, function(v)
                CFG.rapid = v
                print('[' .. NAME .. '] Rapid Fire = ' .. tostring(v))
            end)
            registerToggle('rapid', 'rhd_rapid')

            mkSlider(sec2, 'Fire rate (RPM)', 'rhd_rpm', 600, 3000, 1500, function(v)
                CFG.rpm = math.floor(v)
                print('[' .. NAME .. '] RPM = ' .. tostring(CFG.rpm))
            end)

            mkToggle(sec2, 'Infinite Ammo (client)', 'rhd_ammo', false, function(v)
                CFG.infAmmo = v
                print('[' .. NAME .. '] Infinite Ammo = ' .. tostring(v))
            end)
            registerToggle('infAmmo', 'rhd_ammo')

            mkText(sec2, 'Stock HK416 fire rate is 800 RPM, so 1500 is faster.')
            mkText(sec2, 'If a toggle does nothing, press Status and check entries.')
        end

        local sec3 = mkSection(tab, 'Step 3 - Weapons')
        if sec3 then
            local ts = toolStorage()
            if ts then
                local kids = ts:GetChildren()
                local n = 0
                for i = 1, #kids do
                    local t = kids[i]
                    if t.ClassName == 'Tool' then
                        n = n + 1
                        mkButton(sec3, t.Name, function() giveWeapon(t) end)
                    end
                end
                if n == 0 then mkText(sec3, 'ToolStorage is empty right now.') end
            else
                mkText(sec3, 'ACS_Engine.ToolStorage not found.')
            end
            mkButton(sec3, 'Put weapons back', function() restoreTools() end)
            mkText(sec3, 'Client-side only; the server may refuse to use them.')
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Weapon Mods', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- widget poller -----------------------------------------------------
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil and CFG[t.key] ~= val then
                    CFG[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
            local okr, vr = pcall(function() return UI.GetValue('rhd_rpm') end)
            if okr and type(vr) == 'number' then CFG.rpm = math.floor(vr) end
            task.wait(0.15)
        end
    end)
end

-- ---- stop + register (before anything optional) -------------------------
local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    restoreAll()
    restoreTools()
    if HAS_UI then pcall(function() UI.RemoveTab('Weapon Mods') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
pcall(notify, NAME .. ' ' .. VERSION, 'scan in Step 1, then mods', 4)
print('[' .. NAME .. '] loaded ' .. VERSION .. ' - nothing scanned yet')

-- ---- respawn watch ------------------------------------------------------
-- Player.CharacterAdded is nil in this build (v4.0 died on it), so a hook is only
-- installed if it exists; polling lp.Character works either way.
local lastChar = lp.Character

local function onNewChar()
    print('[' .. NAME .. '] new character - clearing caches')
    anchorAddrs = {}
    SLOTS = {}
    STATS.last = 'cleared on respawn'
end

if lp.CharacterAdded ~= nil then
    local ok = pcall(function()
        track(lp.CharacterAdded:Connect(onNewChar))
    end)
    if ok then
        print('[' .. NAME .. '] CharacterAdded hook installed')
    else
        print('[' .. NAME .. '] CharacterAdded hook failed - polling instead')
    end
else
    print('[' .. NAME .. '] CharacterAdded is nil - polling for respawn')
end

task.spawn(function()
    while running do
        local ok, c = pcall(function() return lp.Character end)
        if ok and c ~= lastChar then
            lastChar = c
            onNewChar()
        end
        task.wait(1)
    end
end)
