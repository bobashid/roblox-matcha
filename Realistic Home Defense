--[[
  Game:       Realistic Home Defense
  Place IDs:  105527962898452
  Version:    v7.0
  Features:   no recoil, done at the camera (no settings writes, no getgc, no remotes)
  Controls:   menu tab "No Recoil"; one toggle, two sliders, one status button
  Needs:      nothing beyond stock Matcha
  Confirmed:  ACS_Engine.Modules.LockSettings table.freeze()s every gun settings table
              recursively, and a frozen write raises "attempt to modify a readonly table
              value" - so stat editing on weapons cannot work in this game, ever.
  Confirmed:  Camera.CFrame is writable from a RenderStepped callback in Matcha.
  UNVERIFIED: whether the per-frame kick is separable from normal mouse movement; that is
              exactly what the threshold slider exists to tune.
  Note:       nothing here touches a game table, so it cannot break the held gun.
]]

local NAME    = 'RHD No Recoil'
local VERSION = 'v7.0'
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}
local function track(c) conns[#conns + 1] = c; return c end

print('[' .. NAME .. '] ' .. VERSION)

-- ---- config -------------------------------------------------------------
local CFG = {
    on       = false,
    strength = 0.8,
    thresh   = 0.8,
    window   = 0.35,
}

local STATS = { kicks = 0, lastDeg = 0, applied = 0 }

local function deg(x) return x * 57.29577951308232 end
local function rad(x) return x * 0.017453292519943295 end

local function pitchOf(cf)
    local ok, lv = pcall(function() return cf.LookVector end)
    if not ok or lv == nil then return nil end
    local y = lv.Y
    if y > 1 then y = 1 elseif y < -1 then y = -1 end
    local ok2, p = pcall(function() return math.asin(y) end)
    if ok2 and type(p) == 'number' then return p end
    return nil
end

local function getCam()
    local ok, c = pcall(function() return workspace.CurrentCamera end)
    if ok and c ~= nil then return c end
    return nil
end

-- ---- camera compensation ------------------------------------------------
-- The kick is applied to the camera on the client. Rather than editing the frozen
-- settings, this watches the camera pitch each frame, notices the upward jump a shot
-- produces, and rotates the camera back down by a share of it.
local lastPitch, deficit, holdUntil = nil, 0, 0

local function onRender()
    if not CFG.on then
        lastPitch, deficit = nil, 0
        return
    end

    local cam = getCam()
    if cam == nil then
        lastPitch = nil
        return
    end

    local cf = nil
    pcall(function() cf = cam.CFrame end)
    if cf == nil then return end

    local p = pitchOf(cf)
    if p == nil then return end

    if lastPitch ~= nil then
        local d = p - lastPitch
        if d > rad(CFG.thresh) then
            deficit = deficit + d
            holdUntil = os.clock() + CFG.window
            STATS.kicks = STATS.kicks + 1
            STATS.lastDeg = deg(d)
        end
    end

    if deficit > 0 and os.clock() < holdUntil then
        local step = deficit * CFG.strength * 0.75
        if step > rad(0.002) then
            local ok = pcall(function()
                cam.CFrame = cam.CFrame * CFrame.Angles(-step, 0, 0)
            end)
            if ok then
                deficit = deficit - step
                STATS.applied = STATS.applied + 1
            end
        else
            deficit = 0
        end
    else
        deficit = 0
    end

    local cf2 = nil
    pcall(function() cf2 = cam.CFrame end)
    if cf2 ~= nil then
        lastPitch = pitchOf(cf2) or p
    else
        lastPitch = p
    end
end

track(RunService.RenderStepped:Connect(function()
    pcall(onRender)
end))

-- ---- UI helpers ---------------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES = {}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function mkText(sec, s)
    pcall(function() sec:Text(s) end)
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = id }
end

local function reportStatus()
    local cam = getCam()
    print('[' .. NAME .. '] --- status ---')
    print('[' .. NAME .. '] on = ' .. tostring(CFG.on)
        .. ', strength = ' .. tostring(CFG.strength)
        .. ', threshold = ' .. tostring(CFG.thresh) .. ' deg/frame')
    print('[' .. NAME .. '] camera = ' .. (cam and 'found' or 'nil'))
    print('[' .. NAME .. '] kicks detected = ' .. tostring(STATS.kicks)
        .. ', last kick = ' .. string.format('%.2f', STATS.lastDeg) .. ' deg'
        .. ', corrections = ' .. tostring(STATS.applied))
    if STATS.kicks == 0 and CFG.on then
        print('[' .. NAME .. '] no kick seen yet - fire a burst, then press Status again')
    end
end

-- ---- build the tab ------------------------------------------------------
local built = false
local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'No Recoil')
        if not sec then return end

        mkToggle(sec, 'No Recoil', 'rhd7_on', false, function(v)
            CFG.on = v
            print('[' .. NAME .. '] No Recoil = ' .. tostring(v))
        end)
        registerToggle('on', 'rhd7_on')

        mkSlider(sec, 'Strength %', 'rhd7_str', 0, 100, 80, function(v)
            CFG.strength = math.floor(v) / 100
            print('[' .. NAME .. '] strength = ' .. tostring(CFG.strength))
        end)

        mkSlider(sec, 'Kick threshold (x0.1 deg)', 'rhd7_thr', 2, 30, 8, function(v)
            CFG.thresh = math.floor(v) / 10
            print('[' .. NAME .. '] threshold = ' .. tostring(CFG.thresh) .. ' deg/frame')
        end)

        mkButton(sec, 'Status (read console)', function() reportStatus() end)

        mkText(sec, 'Turn on, fire a burst, press Status.')
        mkText(sec, '0 kicks = threshold too high, lower the slider.')
        mkText(sec, 'Aim feels dragged = strength too high, lower it.')
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('No Recoil', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- widget poller ------------------------------------------------------
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil and CFG[t.key] ~= val then
                    CFG[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
            task.wait(0.15)
        end
    end)
end

-- ---- stop + register (before anything optional) -------------------------
local function stop()
    running = false
    CFG.on = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if HAS_UI then pcall(function() UI.RemoveTab('No Recoil') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
pcall(notify, NAME .. ' ' .. VERSION, 'turn on, fire, press Status', 4)
print('[' .. NAME .. '] loaded ' .. VERSION .. ' - camera only, no game tables touched')

-- ---- respawn watch (CharacterAdded is nil here) -------------------------
local lastChar = lp.Character

if lp.CharacterAdded ~= nil then
    local ok = pcall(function()
        track(lp.CharacterAdded:Connect(function()
            print('[' .. NAME .. '] respawn detected')
            lastPitch, deficit = nil, 0
        end))
    end
    if ok then print('[' .. NAME .. '] CharacterAdded hook installed') end
end

task.spawn(function()
    while running do
        local ok, c = pcall(function() return lp.Character end)
        if ok and c ~= lastChar then
            lastChar = c
            lastPitch, deficit = nil, 0
            print('[' .. NAME .. '] new character - pitch baseline reset')
        end
        task.wait(1)
    end
end)
