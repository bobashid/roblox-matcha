--[[
  Game:       Realistic Home Defense
  Place IDs:  105527962898452
  Version:    v8.1
  Features:   infinite ammo - keeps Mag / StoredAmmo topped up and Chambered true, plus Refil
  Controls:   menu tab "Ammo"; one toggle, two sliders, one toggle, three buttons
  Needs:      hybrid mode for the Refil remote
  Confirmed:  DDM4 V7's RepValues contains exactly IntValue Mag (30), IntValue StoredAmmo (120),
              BoolValue Chambered (true). Verified by an in-game probe, 2026-10-27.
  Confirmed:  ACS_Engine.Events.Refil is a RemoteEvent.
  Confirmed:  v8.0 wrote to those values (its ammo/mag name filter matches Mag and StoredAmmo)
              but its loop ran once per second, which a ~800 rpm gun outruns instantly.
  Confirmed:  ShootRate / camRecoil / MinSpread live only in the LockSettings-frozen table,
              so fire rate is NOT in this version - there is no writable copy.
  UNVERIFIED: whether the server re-asserts Mag after each shot. If it does, this cannot hold
              and the only remaining route is firing the Atirar remote ourselves.
]]

local NAME    = 'RHD Ammo'
local VERSION = 'v8.1'
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local running = true
local conns = {}
local function track(c) conns[#conns + 1] = c; return c end

print('[' .. NAME .. '] ' .. VERSION)

-- ---- config -------------------------------------------------------------
local CFG = {}
CFG.infAmmo   = false
CFG.magValue  = 999
CFG.storeValue = 9999
CFG.useRefil  = true
CFG.writeGap  = 0.05

local STATS = {}
STATS.writes   = 0
STATS.refils   = 0
STATS.refilOk  = 0
STATS.lastErr  = 'none'
STATS.lastTool = 'none'
STATS.firstRun = false

-- ---- game lookups -------------------------------------------------------
local function getTool()
    local ch = lp.Character
    if ch then
        local kids = ch:GetChildren()
        for i = 1, #kids do
            if kids[i].ClassName == 'Tool' then return kids[i] end
        end
    end
    local bp = lp:FindFirstChild('Backpack')
    if bp then
        local bk = bp:GetChildren()
        for i = 1, #bk do
            if bk[i].ClassName == 'Tool' then return bk[i] end
        end
    end
    return nil
end

local function getRefil()
    local eng = RS:FindFirstChild('ACS_Engine')
    if not eng then return nil end
    local ev = eng:FindFirstChild('Events')
    if not ev then return nil end
    return ev:FindFirstChild('Refil')
end

local function readVal(c)
    local ok, v = pcall(function() return c.Value end)
    if ok then return v end
    return nil
end

local function dumpRep()
    local t = getTool()
    if t == nil then
        print('[' .. NAME .. '] no tool equipped - equip a gun first')
        return
    end
    print('[' .. NAME .. '] tool = ' .. t.Name)
    local rep = t:FindFirstChild('RepValues')
    if rep == nil then
        print('[' .. NAME .. '] RepValues missing on this tool')
        return
    end
    local kids = rep:GetChildren()
    print('[' .. NAME .. '] RepValues children = ' .. tostring(#kids))
    for i = 1, #kids do
        local c = kids[i]
        print('[' .. NAME .. '] ' .. c.ClassName .. ' ' .. c.Name .. ' = ' .. tostring(readVal(c)))
    end
end

-- ---- the write ----------------------------------------------------------
-- Names confirmed in game on DDM4 V7: Mag (IntValue), StoredAmmo (IntValue),
-- Chambered (BoolValue). Only write when the value actually differs, so the
-- Changed event is not spammed every tick.
local function applyAmmo()
    local t = getTool()
    if t == nil then return 0 end
    if t.Name ~= STATS.lastTool then
        STATS.lastTool = t.Name
        STATS.firstRun = false
    end
    local rep = t:FindFirstChild('RepValues')
    if rep == nil then return 0 end
    local n = 0
    local kids = rep:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        local cn = c.ClassName
        local nm = c.Name
        if cn == 'IntValue' or cn == 'NumberValue' then
            local target = nil
            if nm == 'Mag' or nm == 'AmmoInGun' or nm == 'Clip' then
                target = CFG.magValue
            elseif nm == 'StoredAmmo' or nm == 'MaxStoredAmmo' or nm == 'Ammo' then
                target = CFG.storeValue
            end
            if target ~= nil then
                local cur = readVal(c)
                if cur ~= target then
                    local ok = pcall(function() c.Value = target end)
                    if ok then
                        n = n + 1
                        if not STATS.firstRun then
                            print('[' .. NAME .. '] ' .. nm .. ' ' .. tostring(cur) .. ' -> ' .. tostring(target))
                        end
                    end
                end
            end
        elseif cn == 'BoolValue' and nm == 'Chambered' then
            local cur = readVal(c)
            if cur ~= true then
                local ok = pcall(function() c.Value = true end)
                if ok then n = n + 1 end
            end
        end
    end
    if n > 0 and not STATS.firstRun then
        STATS.firstRun = true
        print('[' .. NAME .. '] first write on ' .. t.Name .. ' complete')
    end
    STATS.writes = STATS.writes + n
    return n
end

local function fireRefil()
    local r = getRefil()
    if r == nil then
        STATS.lastErr = 'Refil not found'
        return false
    end
    local ok, err = pcall(function() r:FireServer() end)
    STATS.refils = STATS.refils + 1
    if ok then
        STATS.refilOk = STATS.refilOk + 1
    else
        STATS.lastErr = tostring(err)
    end
    return ok
end

-- ---- fast write loop ----------------------------------------------------
-- 0.05 s is 20 writes a second; an 800 rpm gun fires ~13 times a second, so this
-- can keep up where v8.0's 1 s loop could not.
task.spawn(function()
    while running do
        if CFG.infAmmo then
            pcall(applyAmmo)
        end
        task.wait(CFG.writeGap)
    end
end)

-- ---- refil loop ---------------------------------------------------------
task.spawn(function()
    while running do
        if CFG.infAmmo and CFG.useRefil then
            pcall(fireRefil)
        end
        task.wait(1)
    end
end)

-- ---- status -------------------------------------------------------------
local function reportStatus()
    local a = '[' .. NAME .. '] '
    local t = getTool()
    local tn = 'none'
    if t ~= nil then tn = t.Name end
    local hasRefil = 'no'
    if getRefil() ~= nil then hasRefil = 'yes' end
    local magNow = 'n/a'
    local storeNow = 'n/a'
    if t ~= nil then
        local rep = t:FindFirstChild('RepValues')
        if rep ~= nil then
            local m = rep:FindFirstChild('Mag')
            local s = rep:FindFirstChild('StoredAmmo')
            if m ~= nil then magNow = tostring(readVal(m)) end
            if s ~= nil then storeNow = tostring(readVal(s)) end
        end
    end
    print(a .. '--- status ---')
    print(a .. 'infAmmo=' .. tostring(CFG.infAmmo) .. ' gap=' .. tostring(CFG.writeGap))
    print(a .. 'magTarget=' .. tostring(CFG.magValue) .. ' storeTarget=' .. tostring(CFG.storeValue))
    print(a .. 'tool=' .. tn .. ' magNow=' .. magNow .. ' storeNow=' .. storeNow)
    print(a .. 'writes=' .. tostring(STATS.writes) .. ' refils=' .. tostring(STATS.refils))
    print(a .. 'refilOk=' .. tostring(STATS.refilOk) .. ' lastErr=' .. STATS.lastErr)
end

-- ---- UI helpers ---------------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES = {}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {}
    tries[1] = function() sec:Toggle(id, label, default, cb) end
    tries[2] = function() sec:Toggle(label, id, default, cb) end
    tries[3] = function() sec:Toggle(label, default, cb) end
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, mn, mx, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {}
    tries[1] = function() sec:SliderInt(id, label, mn, mx, default, cb) end
    tries[2] = function() sec:SliderInt(label, id, mn, mx, default, cb) end
    tries[3] = function() sec:SliderInt(label, mn, mx, default, cb) end
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function mkText(sec, s)
    pcall(function() sec:Text(s) end)
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = id }
end

-- ---- build the tab ------------------------------------------------------
local built = false

local function buildTab(tab)
    if built then return end
    built = true

    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Ammo')
        if not sec then return end

        mkToggle(sec, 'Infinite Ammo', 'rhd8_ammo', false, function(v)
            CFG.infAmmo = v
            STATS.firstRun = false
            print('[' .. NAME .. '] Infinite Ammo = ' .. tostring(v))
            if v then pcall(applyAmmo) end
        end)
        registerToggle('infAmmo', 'rhd8_ammo')

        mkSlider(sec, 'Mag target', 'rhd8_mag', 30, 9999, 999, function(v)
            CFG.magValue = math.floor(v)
            print('[' .. NAME .. '] Mag = ' .. tostring(CFG.magValue))
        end)

        mkSlider(sec, 'Stored ammo target', 'rhd8_store', 100, 99999, 9999, function(v)
            CFG.storeValue = math.floor(v)
            print('[' .. NAME .. '] StoredAmmo = ' .. tostring(CFG.storeValue))
        end)

        mkToggle(sec, 'Also fire Refil remote', 'rhd8_refil', true, function(v)
            CFG.useRefil = v
            print('[' .. NAME .. '] use Refil = ' .. tostring(v))
        end)
        registerToggle('useRefil', 'rhd8_refil')

        mkButton(sec, 'Dump RepValues (read console)', function() dumpRep() end)
        mkButton(sec, 'Write once now', function() applyAmmo() end)
        mkButton(sec, 'Status (read console)', function() reportStatus() end)

        mkText(sec, 'Writes 20x per second while on.')
        mkText(sec, 'Fire rate is not here - ShootRate is frozen.')
    end)

    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local okTab = pcall(function()
        UI.AddTab('Ammo', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not okTab then
        warn('[' .. NAME .. '] UI.AddTab failed')
        HAS_UI = false
    end
end

-- ---- widget poller ------------------------------------------------------
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil and CFG[t.key] ~= val then
                    CFG[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
            task.wait(0.15)
        end
    end)
end

-- ---- stop + register ----------------------------------------------------
local function stop()
    running = false
    CFG.infAmmo = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if HAS_UI then pcall(function() UI.RemoveTab('Ammo') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
pcall(notify, NAME .. ' ' .. VERSION, 'equip a gun, flip Infinite Ammo', 4)
print('[' .. NAME .. '] loaded ' .. VERSION .. ' - writes at 20 per second')

-- ---- respawn watch ------------------------------------------------------
local lastChar = lp.Character

if lp.CharacterAdded ~= nil then
    local okHook = pcall(function()
        track(lp.CharacterAdded:Connect(function()
            STATS.firstRun = false
            print('[' .. NAME .. '] respawn detected')
        end))
    end)
    if okHook then print('[' .. NAME .. '] CharacterAdded hook installed') end
end

task.spawn(function()
    while running do
        local ok, c = pcall(function() return lp.Character end)
        if ok and c ~= lastChar then
            lastChar = c
            STATS.firstRun = false
            print('[' .. NAME .. '] new character - re-applying')
        end
        task.wait(1)
    end
end)
