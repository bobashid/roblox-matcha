--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v1.4
  Features:   auto play - ONE toggle; clicks the lane the moment a tile reaches the judge
              line, learns that line from tiles that vanish, spawn-clock fallback
  Controls:   menu tab "Piano Auto" - a single toggle, everything else is automatic
  Needs:      Matcha Pro; Roblox window focused (the game reads real mouse input)
  Confirmed:  lanes at x 625/792/959/1126, width 167; tiles are Board.Tiles.Tile with
              TileIndex / ChartVersion attributes and a readable .Address
  Confirmed:  Client.Input picks a click's lane with Board.laneAt(position.X) - X only,
              so the click's Y never matters and any Y inside the window works
  Confirmed:  tiles fall DOWNWARD: earlier notes sit near the bottom (y ~ 1004), later
              notes sit up top (y ~ -194), so Y increases toward the judge line
  Confirmed:  idle tiles sit at y = 1104 and vanish at 1104; the judge line is near there
  Confirmed:  mouse1press / mouse1release / mousemoveabs exist and pcall returns ok
  Confirmed:  keypress(0x44) produced 0 InputBegan events while isrbxactive() was false
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  Confirmed:  this VM caps a chunk at 200 local variables
  UNVERIFIED: the exact judged Y (learned at runtime from tiles that vanish)
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v1.4'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- the only tunables (no menu sliders) ----

local cfg = {
    on         = true,
    offsetMs   = 0,
    approachMs = 1500,
    lineTol    = 45,
    holdMs     = 55,
    clickYpct  = 55,
    laneX      = { 625, 792, 959, 1126 },
    laneW      = 167,
}

local rec      = {}
local lineY    = nil
local chartVer = nil
local taps     = 0
local clicks   = 0
local fails    = 0
local lastErr  = ''
local movingN  = 0
local focused  = nil
local focusAt  = 0
local status   = 'starting'
local held     = false

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function laneOf(x)
    if type(x) ~= 'number' then return nil end
    for i = 1, 4 do
        if x >= cfg.laneX[i] - 12 and x < cfg.laneX[i] + cfg.laneW + 12 then
            return i
        end
    end
    return nil
end

-- ---- output: a real mouse click in the lane's column ----

local function releaseMouse()
    if not held then return end
    held = false
    pcall(function() mouse1release() end)
end

local function clickLane(lane)
    if type(mouse1press) ~= 'function' then
        fails = fails + 1
        lastErr = 'mouse1press missing'
        return false
    end
    local cx = cfg.laneX[lane] + math.floor(cfg.laneW / 2)
    local cy = 594
    local okV, vp = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    if okV and vp and type(vp.Y) == 'number' and vp.Y > 0 then
        cy = math.floor(vp.Y * (cfg.clickYpct / 100))
    end
    if held then releaseMouse() end
    local ok, err = pcall(function()
        mousemoveabs(cx, cy)
        mouse1press()
    end)
    if not ok then
        fails = fails + 1
        lastErr = 'mouse: ' .. tostring(err)
        return false
    end
    held = true
    clicks = clicks + 1
    task.delay(math.max(cfg.holdMs, 25) / 1000, function()
        releaseMouse()
    end)
    return true
end

-- ---- per frame ----

local function step()
    if not running then return end

    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local b  = sg and sg:FindFirstChild('Board')
    local holder = b and b:FindFirstChild('Tiles')
    if not holder then
        status = 'no board'
        return
    end

    local now = os.clock()
    if now - focusAt > 0.25 then
        focusAt = now
        if type(isrbxactive) == 'function' then
            local okf, act = pcall(isrbxactive)
            focused = (okf and act == true) and true or false
        end
    end

    local list = holder:GetChildren()
    local live = {}

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos and type(pos.Y) == 'number' then
                live[addr] = true
                local r = rec[addr]
                if not r then
                    local okV, cv = pcall(function() return t:GetAttribute('ChartVersion') end)
                    if okV and cv ~= nil then chartVer = cv end
                    r = { spawn = now, prevY = pos.Y, y = pos.Y, done = false, moved = false }
                    r.lane = laneOf(pos.X)
                    rec[addr] = r
                end
                if not r.lane then r.lane = laneOf(pos.X) end
                if math.abs(pos.Y - r.y) > 0.5 then
                    r.moved = true
                    movingN = movingN + 1
                end
                r.prevY = r.y
                r.y = pos.Y

                if cfg.on and not r.done and r.lane then
                    local fire = false
                    if lineY then
                        local target = lineY - cfg.lineTol
                        if r.moved and r.prevY < target and r.y >= target then
                            fire = true
                        end
                    else
                        if now >= r.spawn + (cfg.approachMs + cfg.offsetMs) / 1000 then
                            fire = true
                        end
                    end
                    if fire then
                        r.done = true
                        taps = taps + 1
                        clickLane(r.lane)
                    end
                end
            end
        end
    end

    for addr, r in pairs(rec) do
        if not live[addr] then
            if r.moved and r.y > 200 then
                if lineY == nil then
                    lineY = r.y
                else
                    lineY = lineY * 0.85 + r.y * 0.15
                end
            end
            rec[addr] = nil
        end
    end

    if not cfg.on then
        status = 'off'
    elseif fails > 0 then
        status = 'click failed - ' .. lastErr
    else
        status = string.format('%d taps | chart %s | line %s | moved %d',
            taps, tostring(chartVer),
            lineY and string.format('%.0f', lineY) or 'learning',
            movingN)
    end
end

-- ---- hud ----

local hud = nil
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
    hud.Text = '[' .. NAME .. '] starting'
end)

local hudLast = ''
local function drawHud()
    if not hud then return end
    local txt = string.format('[%s] %s | focus %s', NAME, status, tostring(focused))
    if txt ~= hudLast then
        hud.Text = txt
        hudLast = txt
    end
    hud.Visible = true
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(drawHud)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: exactly one toggle ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end
                mkToggle(sec, 'Auto Play', 'pa_on', cfg.on, function(v)
                    cfg.on = v
                    if not v then releaseMouse() end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseMouse()
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - one toggle, clicks the lane on the judge line')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
