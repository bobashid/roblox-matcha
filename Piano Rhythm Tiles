--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.4
  Features:   auto play - one toggle + one Fire Y slider; clicks at the TILE'S OWN X so the
              game resolves the lane itself, verifies the cursor actually moved before it
              presses; draws the perfect line and a dot on every note
  Controls:   menu tab "Piano Auto" - one toggle, one slider
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Why v2.4 (user: "right clicking time but wrong lane"):
    Timing is right, so the click reaches the game - it just lands in the wrong column.
    Two causes are possible and this version handles both:
      1. the click X was derived from a lane INDEX, and the index could be off;
         v2.4 clicks at the tile's own X + half a lane, so Board.laneAt(tileX) must
         resolve to that tile's lane - there is no index left to be wrong;
      2. mousemoveabs can fail silently, leaving the cursor where it was, so the
         click lands in whatever column the cursor happened to be in. v2.4 reads the
         cursor back after moving and nudges with mousemoverel until it converges,
         and only then presses.

  Overlays (your request):
    yellow line  = Fire Y, the line the script fires on (follows the slider live)
    grey line    = 1076, the board's bottom edge, for reference
    coloured dot = every live note, at its reported position: cyan = still far up,
                   white = armed, yellow = at the line, grey = already fired
    If a dot is not in the same column as its note, AbsolutePosition.X is lying and
    the dot will show it immediately.

  Confirmed:  Client.Input resolves a click with Board.laneAt(input.Position.X), X only
  Confirmed:  tiles sit at four distinct X values (630 / 798 / 965 / 1133); a tile's X
              is its lane's left edge + ~5, so tile X + half a lane = lane centre
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  board is x 625..1292 (667 wide), height ~1076, so y=1104 is BELOW the board
  Confirmed:  FIRE_Y = 950 lands hits; y >= 1034 was LATE; timing now confirmed right
  Confirmed:  the single-char TextLabels in PianoTiles are the judgement tally, not keys
  Confirmed:  mousemoveabs / mouse1press / mouse1release / keypress / isrbxactive exist
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: that mousemoveabs lands the cursor where asked while Roblox is focused

  SLIDER:  LOWER Fire Y = fires EARLIER   |   HIGHER Fire Y = fires LATER
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.4'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----

local FIRE_Y = 950

local CFG = {
    ARM_GAP   = 100,     -- tile must be seen this far above FIRE_Y before it can fire
    giveUp    = 160,     -- px past FIRE_Y before an unpressed tile is abandoned
    laneTol   = 8,       -- px tolerance when deduplicating a lane X
    tapMs     = 35,      -- how long the mouse button stays down
    clickYpct = 55,      -- click Y as % of viewport height (lane comes from X)
    fallbackW = 167,     -- lane width used before four columns are known
    boardBottom = 1076,  -- measured board bottom, drawn as the reference line
    keys      = { 0x44, 0x46, 0x4A, 0x4B },   -- D F J K, automatic fallback only
}

-- ---- state ----

local on        = true
local recs      = {}
local laneXs    = {}
local chart     = nil
local taps      = 0
local fired     = {}
local focused   = nil
local lowY      = 0
local lastAct   = '-'
local mouseBusy = false
local clickFails = 0
local useKeys   = false
local dotPool   = {}
local lineFire, lineBottom, lineLabel

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

-- injected input must be enabled once, or every click/keypress is dropped
if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

-- ---- small helpers ----

local function viewportH()
    local ok, vp = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    if ok and vp and type(vp.Y) == 'number' and vp.Y > 0 then return vp.Y end
    return 1080
end

local function mousePos()
    local ok, m = pcall(function() return lp:GetMouse() end)
    if not ok or not m then return nil, nil end
    local okx, x = pcall(function() return m.X end)
    local oky, y = pcall(function() return m.Y end)
    if okx and oky and type(x) == 'number' and type(y) == 'number' then
        return x, y
    end
    return nil, nil
end

-- Move the cursor and VERIFY it arrived. mousemoveabs can silently do nothing,
-- which leaves the press in whatever column the cursor was already in - the exact
-- "right time, wrong lane" symptom.
local function moveTo(tx, ty)
    if type(mousemoveabs) ~= 'function' then return false, 'no mousemoveabs' end
    local canCheck = mousePos() ~= nil
    for _ = 1, 3 do
        pcall(function() mousemoveabs(tx, ty) end)
        if not canCheck then return true end
        local nx, ny = mousePos()
        if not nx or not ny then return true end
        local dx, dy = tx - nx, ty - ny
        if math.abs(dx) <= 2 and math.abs(dy) <= 2 then return true end
        if type(mousemoverel) == 'function' then
            pcall(function() mousemoverel(math.floor(dx + 0.5), math.floor(dy + 0.5)) end)
        end
    end
    if not canCheck then return true end
    local fx, fy = mousePos()
    if not fx or not fy then return true end
    return (math.abs(tx - fx) <= 6 and math.abs(ty - fy) <= 6),
           string.format('cursor %d,%d want %d,%d', fx, fy, tx, ty)
end

-- ---- lane columns ----

local function noteLaneX(x)
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= CFG.laneTol then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then
        log('lanes learned: ' .. table.concat(laneXs, ', '))
    end
end

local function laneWidth()
    if #laneXs < 2 then return CFG.fallbackW end
    local w = (laneXs[#laneXs] - laneXs[1]) / (#laneXs - 1)
    if w > 40 and w < 600 then return w end
    return CFG.fallbackW
end

-- ---- overlays ----

local function setupDrawings()
    pcall(function()
        lineFire = Drawing.new('Line')
        lineFire.Color = Color3.fromRGB(255, 220, 60)
        lineFire.Thickness = 2
        lineFire.Transparency = 0
        lineFire.Visible = false

        lineBottom = Drawing.new('Line')
        lineBottom.Color = Color3.fromRGB(200, 200, 210)
        lineBottom.Thickness = 1
        lineBottom.Transparency = 0.55
        lineBottom.Visible = false

        lineLabel = Drawing.new('Text')
        lineLabel.Size = 12
        lineLabel.Outline = true
        lineLabel.Color = Color3.fromRGB(255, 220, 60)
        lineLabel.Visible = false

        for i = 1, 40 do
            local d = Drawing.new('Circle')
            d.Radius = 4
            d.NumSides = 12
            d.Filled = true
            d.Thickness = 1
            d.Color = Color3.fromRGB(120, 220, 255)
            d.Visible = false
            dotPool[i] = d
        end
    end)
end

setupDrawings()

local function dotFor(i)
    return dotPool[i]
end

-- ---- input ----

local function releaseMouse()
    if not mouseBusy then return end
    mouseBusy = false
    pcall(function() mouse1release() end)
end

-- Click at the tile's own X, centred in its lane. Board.laneAt(that X) is the
-- same call the game uses on a human click, so the lane cannot be mis-indexed.
local function pressAt(tileX, addr, now)
    local w = laneWidth()
    local tx = math.floor(tileX + w * 0.5)
    local ty = math.floor(viewportH() * (CFG.clickYpct / 100))

    if not useKeys then
        if mouseBusy then return false end
        local ok, why = moveTo(tx, ty)
        if ok then
            if pcall(function() mouse1press() end) then
                mouseBusy = true
                taps = taps + 1
                clickFails = 0
                lastAct = string.format('click %d,%d', tx, ty)
                task.delay(CFG.tapMs / 1000, releaseMouse)
                return true
            end
            why = 'mouse1press failed'
        end
        clickFails = clickFails + 1
        lastAct = 'move fail ' .. tostring(why)
        if clickFails >= 4 then
            useKeys = true
            log('cursor would not move after 4 tries - switched to keys')
        end
        return false
    end

    -- key fallback: nearest learned column, keys assumed left to right
    local lane, best = 1, math.huge
    for i = 1, #laneXs do
        local d = math.abs(laneXs[i] - tileX)
        if d < best then best, lane = d, i end
    end
    local vk = CFG.keys[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    if not pcall(keypress, vk) then return false end
    taps = taps + 1
    lastAct = 'key ' .. string.char(vk) .. ' lane ' .. lane
    task.delay(CFG.tapMs / 1000, function() pcall(keyrelease, vk) end)
    return true
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    if not on or not focused then
        releaseMouse()
    end

    local now  = os.clock()
    local list = holder:GetChildren()
    local armY = FIRE_Y - CFG.ARM_GAP

    -- new song -> forget everything, including the learned columns
    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart    = cv
                recs     = {}
                fired    = {}
                laneXs   = {}
                taps     = 0
                clickFails = 0
                releaseMouse()
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live   = {}
    local lowest = 0
    local batch  = {}
    local dotIx  = 0

    -- pass 1: read every tile, learn columns, move its dot, build the fire list
    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos
                and type(pos.Y) == 'number' and type(pos.X) == 'number' then
                live[addr] = true
                noteLaneX(pos.X)

                local r = recs[addr]
                if not r then
                    r = { armed = pos.Y < armY }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < armY then r.armed = true end
                if pos.Y > lowest then lowest = pos.Y end

                -- the dot sits where the script believes the note is
                dotIx = dotIx + 1
                local d = dotFor(dotIx)
                if d then
                    d.Position = Vector2.new(pos.X + laneWidth() * 0.5, pos.Y)
                    if fired[addr] then
                        d.Color = Color3.fromRGB(150, 150, 160)
                        d.Transparency = 0.6
                    elseif math.abs(pos.Y - FIRE_Y) <= 60 then
                        d.Color = Color3.fromRGB(255, 220, 60)
                        d.Transparency = 0
                    elseif pos.Y >= armY then
                        d.Color = Color3.fromRGB(255, 255, 255)
                        d.Transparency = 0
                    else
                        d.Color = Color3.fromRGB(120, 220, 255)
                        d.Transparency = 0.35
                    end
                    d.Visible = true
                end

                batch[#batch + 1] = { addr = addr, x = pos.X, y = pos.Y, r = r }
            end
        end
    end

    lowY = lowest

    -- hide leftover dots from tiles that are gone
    for i = dotIx + 1, #dotPool do
        local d = dotPool[i]
        if d and d.Visible then d.Visible = false end
    end

    -- the two reference lines, following the slider live
    if lineFire then
        local x1, x2 = 619, 1298
        if #laneXs >= 2 then
            x1 = laneXs[1] - 6
            x2 = laneXs[#laneXs] + laneWidth() + 6
        end
        lineFire.From = Vector2.new(x1, FIRE_Y)
        lineFire.To   = Vector2.new(x2, FIRE_Y)
        lineFire.Visible = true

        lineBottom.From = Vector2.new(x1, CFG.boardBottom)
        lineBottom.To   = Vector2.new(x2, CFG.boardBottom)
        lineBottom.Visible = true

        lineLabel.Text = string.format('FIRE %d', math.floor(FIRE_Y))
        lineLabel.Position = Vector2.new(x1 + 4, FIRE_Y - 16)
        lineLabel.Visible = true
    end

    -- pass 2: fire
    for i = 1, #batch do
        local it = batch[i]
        local r  = it.r
        if not fired[it.addr] then
            local late = it.y > FIRE_Y + CFG.giveUp
            if late then
                fired[it.addr] = true
            elseif on and focused and it.y >= FIRE_Y and r.armed then
                if pressAt(it.x, it.addr, now) then
                    fired[it.addr] = true
                end
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then
            recs[addr]  = nil
            fired[addr] = nil
        end
    end
end

-- ---- readout ----

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local function hudText()
    if not hud then return end
    local lanesTxt = #laneXs > 0 and table.concat(laneXs, '/') or 'learning'
    hud.Text = string.format('%s | on %s | focus %s | %s | taps %d | fireY %d | lanes %s | last %s | chart %s',
        VERSION, tostring(on), tostring(focused),
        useKeys and 'KEYS' or 'CLICK', taps, math.floor(FIRE_Y),
        lanesTxt, lastAct, tostring(chart))
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: one toggle + one slider ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, def, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, def, cb) end,
        function() sec:SliderInt(label, id, min, max, def, cb) end,
        function() sec:SliderInt(label, min, max, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseMouse()
                    end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)

                mkSlider(sec, 'Fire Y (lower = earlier)', 'pa_firey', 500, 1100, math.floor(FIRE_Y), function(v)
                    FIRE_Y = math.floor(v)
                    log('fireY = ' .. tostring(FIRE_Y))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseMouse()
    for i = 1, #dotPool do
        pcall(function() dotPool[i]:Remove() end)
    end
    dotPool = {}
    if lineFire then pcall(function() lineFire:Remove() end) end
    if lineBottom then pcall(function() lineBottom:Remove() end) end
    if lineLabel then pcall(function() lineLabel:Remove() end) end
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - clicks at the tile X, Fire Y ' .. tostring(FIRE_Y))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
