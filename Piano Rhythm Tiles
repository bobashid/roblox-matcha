--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.14
  Features:   auto play - ONE toggle. Fire Y fixed at 625. Keys only. Every note is held
              for 2.0 s (the game's hold range is 0.6-2.4 s) so holds can complete.
  Controls:   menu tab "Piano Auto" - one toggle. Nothing else.
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Why v2.14 - MY BUG, found by reading the game's own Config:
    v2.13 held every note for HOLD_ALL = 0.50 s. But Shared.Config says:
        HoldMinLen = 0.6      (shortest hold in the game)
        HoldMaxLen = 2.4      (longest hold)
        HoldTickRate = 8      (hold scored 8x per second)
        HoldKeepFrac = 0.82
    0.50 s is BELOW HoldMinLen, so a hold could never be completed - the key was
    released before the shortest possible hold ended. That is why "still not holding"
    happened on v2.13 despite the press path being correct.
    v2.14 holds for HOLD_ALL = 2.0 s, inside the game's range and near the top of it, so
    every hold length (0.6-2.4 s) is covered for the vast majority of its body.

  Why holding every note is still safe:
    The press path force-releases the lane immediately before each press, so a long hold
    can never swallow the next note in the same lane (SameLaneMinDt = 0.17 s). A tap is
    judged on key-down, so holding it longer does not lose the hit.

  Confirmed:  Shared.Config HoldMinLen = 0.6, HoldMaxLen = 2.4, HoldTickRate = 8,
              HoldKeepFrac = 0.82, SameLaneMinDt = 0.17  (matcha_decompile of Config)
  Confirmed:  a hold note is ONE line, not two tiles (user statement)
  Confirmed:  the tile is destroyed at the press: both Y-past-the-line (v2.10) and
              tile-still-alive (v2.11) hold detection failed, so no tile property can
              measure a hold's length - the duration must be assumed
  Confirmed:  the perfect window opens around Y = 625 (user report)
  Confirmed:  keypress / keyrelease reach the game; mouse movement does not
  Confirmed:  tiles sit at four X values: 630 / 798 / 965 / 1133 (left to right)
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  board is x 625..1292, bottom edge y ~ 1076; y = 1104 is the park spot
  Confirmed:  no hit/press remote exists - scoring is local, input is the only route
  Confirmed:  a tile can report AbsolutePosition.X = 0 (rejected below)
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: that holding 2.0 s does not cost anything on plain taps

  HOLD_ALL is the one number to change:
    holds still break  -> raise toward 2.4 (the game maximum)
    taps mis-score or  -> lower toward 1.0
    notes get skipped

  HUD:  taps, held, skipped, armed, fireY, hold ms, lane + key, lanes, chart
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.14'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

-- ---- constants ----

local FIRE_Y    = 625                          -- fixed: earliest Y that scores PERFECT
local MICRO     = 18                           -- px of jitter, positive only
local KEYS      = { 0x44, 0x46, 0x4A, 0x4B }   -- D F J K, left to right
local FALLBACK  = { 630, 798, 965, 1133 }
local HOLD_ALL  = 2.0                          -- s; game holds are 0.6-2.4 s (see header)
local HOLD_JIT  = 80                           -- ms of extra hold, random per note
local MAX_HOLD  = 3.0                          -- s absolute safety cap
local PAST      = 220
local DOT_OFF   = 83

-- ---- state ----

local running, conns = true, {}
local on      = true
local recs    = {}
local held    = {}
local laneXs  = {}
local chart   = nil
local taps, holdsN, skipped, armedN = 0, 0, 0, 0
local focused = nil
local lastLane, lastKey = 0, 0
local dots    = {}
local lineFire, lineBottom, lineLabel, hud

local function log(m) print('[' .. NAME .. '] ' .. tostring(m)) end

if type(setrobloxinput) == 'function' then pcall(setrobloxinput, true) end

-- ---- lanes ----

local function noteLaneX(x)
    if type(x) ~= 'number' or x < 560 or x > 1400 then return end
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= 8 then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then log('lanes ' .. table.concat(laneXs, '/')) end
end

local function laneOf(x)
    local cols = (#laneXs == 4) and laneXs or FALLBACK
    local best, bd = nil, math.huge
    for i = 1, 4 do
        local d = math.abs(cols[i] - x)
        if d < bd then best, bd = i, d end
    end
    if bd <= 120 then return best end
    return nil
end

-- ---- key output ----

local function releaseLane(lane)
    if not held[lane] then return end
    held[lane] = nil
    pcall(keyrelease, KEYS[lane])
end

local function releaseAll()
    for lane = 1, 4 do releaseLane(lane) end
end

-- Force a release first: InputBegan only fires on the key transition, so a key left
-- down would swallow the next note in that lane. This is what makes a long hold safe
-- even though SameLaneMinDt is only 0.17 s.
-- The field is `due`, never `until` - `until` is a reserved Lua keyword.
local function pressLane(lane, now)
    local vk = KEYS[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    releaseLane(lane)
    if not pcall(keypress, vk) then return false end
    local dur = HOLD_ALL + math.random(0, HOLD_JIT) / 1000
    held[lane] = { due = now + dur, since = now }
    taps = taps + 1
    holdsN = holdsN + 1
    lastLane, lastKey = lane, vk
    return true
end

local function serviceKeys(now)
    for lane = 1, 4 do
        local h = held[lane]
        if h then
            if now >= h.due or (now - h.since) > MAX_HOLD then
                releaseLane(lane)
            end
        end
    end
end

-- ---- overlays ----

pcall(function()
    lineFire = Drawing.new('Line')
    lineFire.Color = Color3.fromRGB(255, 220, 60)
    lineFire.Thickness = 2
    lineFire.Visible = false

    lineBottom = Drawing.new('Line')
    lineBottom.Color = Color3.fromRGB(200, 200, 210)
    lineBottom.Thickness = 1
    lineBottom.Transparency = 0.55
    lineBottom.Visible = false

    lineLabel = Drawing.new('Text')
    lineLabel.Size = 12
    lineLabel.Outline = true
    lineLabel.Color = Color3.fromRGB(255, 220, 60)
    lineLabel.Visible = false

    for i = 1, 32 do
        local d = Drawing.new('Circle')
        d.Radius = 4
        d.NumSides = 12
        d.Filled = true
        d.Thickness = 1
        d.Color = Color3.fromRGB(235, 235, 245)
        d.Visible = false
        dots[i] = d
    end

    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

-- ---- per frame ----

local function step()
    if not running then return end

    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    local holder = bd and bd:FindFirstChild('Tiles')
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    local now = os.clock()
    serviceKeys(now)
    if not on or not focused then releaseAll() end

    local list = holder:GetChildren()

    -- new song -> reset everything, including the learned columns
    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okC, cv = pcall(function() return t:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart = cv
                recs, held, laneXs = {}, {}, {}
                taps, holdsN, skipped = 0, 0, 0
                for lane = 1, 4 do pcall(keyrelease, KEYS[lane]) end
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live, batch = {}, {}
    local di, armed = 0, 0

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, p    = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and p
                and type(p.X) == 'number' and type(p.Y) == 'number' then
                live[addr] = true
                noteLaneX(p.X)

                local r = recs[addr]
                if not r then
                    if p.Y < FIRE_Y then
                        r = { armed = true, done = false, jit = math.random(0, MICRO) }
                    else
                        r = { armed = false, done = true, jit = 0 }
                        skipped = skipped + 1
                    end
                    recs[addr] = r
                elseif not r.armed and not r.done and p.Y < FIRE_Y then
                    r.armed = true
                end
                if r.armed and not r.done then armed = armed + 1 end

                di = di + 1
                local d = dots[di]
                if d then
                    d.Position = Vector2.new(p.X + DOT_OFF, p.Y)
                    if r.done then
                        d.Color = Color3.fromRGB(150, 150, 160)
                        d.Transparency = 0.6
                    elseif math.abs(p.Y - FIRE_Y) <= 60 then
                        d.Color = Color3.fromRGB(255, 220, 60)
                        d.Transparency = 0
                    else
                        d.Color = Color3.fromRGB(235, 235, 245)
                        d.Transparency = 0.25
                    end
                    d.Visible = true
                end

                batch[#batch + 1] = { addr = addr, x = p.X, y = p.Y, r = r }
            end
        end
    end

    armedN = armed

    for i = di + 1, #dots do
        local d = dots[i]
        if d and d.Visible then d.Visible = false end
    end

    if lineFire then
        local cols = (#laneXs == 4) and laneXs or FALLBACK
        local x1 = cols[1] - 10
        local x2 = cols[4] + 170
        lineFire.From = Vector2.new(x1, FIRE_Y)
        lineFire.To   = Vector2.new(x2, FIRE_Y)
        lineFire.Visible = true
        lineBottom.From = Vector2.new(x1, 1076)
        lineBottom.To   = Vector2.new(x2, 1076)
        lineBottom.Visible = true
        lineLabel.Text = 'FIRE ' .. FIRE_Y
        lineLabel.Position = Vector2.new(x1 + 4, FIRE_Y - 16)
        lineLabel.Visible = true
    end

    if on and focused then
        for i = 1, #batch do
            local it = batch[i]
            local r  = it.r
            if r.armed and not r.done then
                local fy = FIRE_Y + r.jit
                if it.y >= fy then
                    local lane = laneOf(it.x)
                    if lane then pressLane(lane, now) end
                    r.done = true
                end
            elseif not r.done and it.y > FIRE_Y + PAST then
                r.done = true
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then recs[addr] = nil end
    end
end

local function hudText()
    if not hud then return end
    local lanesTxt = (#laneXs > 0) and table.concat(laneXs, '/') or 'default'
    local keyTxt   = (lastKey > 0) and string.char(lastKey) or '-'
    hud.Text = string.format('%s | on %s | focus %s | taps %d | held %d | skipped %d | armed %d | fireY %d | hold %dms | last lane %d key %s | lanes %s | chart %s',
        VERSION, tostring(on), tostring(focused), taps, holdsN, skipped, armedN,
        FIRE_Y, math.floor(HOLD_ALL * 1000), lastLane, keyTxt, lanesTxt, tostring(chart))
end

local okRender = pcall(function()
    conns[#conns + 1] = RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end)
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: exactly ONE toggle ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function section(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function toggle(sec, label, id, def, fn)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then fn(v) end
    end
    if pcall(function() sec:Toggle(id, label, def, cb) end) then return true end
    if pcall(function() sec:Toggle(label, id, def, cb) end) then return true end
    return pcall(function() sec:Toggle(label, def, cb) end)
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = section(tab, 'Auto Play')
                if not sec then return end

                toggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseAll()
                    end
                    log('auto play ' .. (v and 'ON' or 'OFF'))
                end)
            end)
            if not okB then log('menu error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseAll()
    for lane = 1, 4 do pcall(keyrelease, KEYS[lane]) end
    for i = 1, #dots do pcall(function() dots[i]:Remove() end) end
    dots = {}
    if lineFire then pcall(function() lineFire:Remove() end) end
    if lineBottom then pcall(function() lineBottom:Remove() end) end
    if lineLabel then pcall(function() lineLabel:Remove() end) end
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - one toggle, Fire Y ' .. FIRE_Y .. ', hold ' .. math.floor(HOLD_ALL * 1000) .. 'ms')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
