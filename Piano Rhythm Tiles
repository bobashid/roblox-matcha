--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.12
  Features:   auto play - ONE toggle only. Fire Y is a constant (625). Keys only.
              Holds detected by a head+tail tile pair. Micro jitter, humanized taps.
  Controls:   menu tab "Piano Auto" - one toggle. Nothing else.
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Why v2.12:
    1. HOLDS STILL DID NOT WORK. v2.11 detected a hold by tile lifetime, which fails
       because the tile disappears at the press. A read-only probe of live tiles found
       the real signal: EVERY tile has children Corner/Grad/Edge/Spine/Dot/Ring/Shine,
       and all four Frames read Visible=false, so visibility is useless - but two tiles
       were seen at the IDENTICAL position (idx=31 x=798 y=311 and idx=32 x=798 y=311).
       Two notes sharing one screen position is a head and a tail: that is a hold.
       v2.12 therefore calls a note a hold when another live tile in the SAME LANE sits
       within HOLD_TOL px of it, and keeps the lane key down while that partner is alive.
    2. FIRE Y IS NOW FIXED AT 625 (user: "make it permanent at 625 instead of slider").
       The slider is gone; the menu is one toggle. 625 is the earliest Y that still
       scores PERFECT, so firing there can never be late.
    3. Jitter is POSITIVE ONLY (0..MICRO) so a note can never fire before 625.

  Confirmed:  every Tile carries Corner/Grad/Edge/Spine/Dot/Ring/Shine children, all
              Frames Visible=false - visibility is NOT a hold signal
  Confirmed:  two tiles can occupy the same X and Y (idx=31 and idx=32 at 798,311):
              a head+tail pair, i.e. a hold
  Confirmed:  the perfect window opens around Y = 625 (user report)
  Confirmed:  keypress / keyrelease reach the game; mouse movement does not
  Confirmed:  tiles sit at four X values: 630 / 798 / 965 / 1133 (left to right)
  Confirmed:  Shared.Config DefaultKeys = D F J K, left to right
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  board is x 625..1292, bottom edge y ~ 1076; y = 1104 is the park spot
  Confirmed:  no hit/press remote exists - scoring is local, input is the only route
  Confirmed:  a tile can report AbsolutePosition.X = 0 (rejected below)
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: that the head+tail pair is what a hold looks like here

  HUD:  taps, holds, skipped, armed, lane + key of the last press, lanes, chart
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.12'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

-- ---- constants (no menu controls for these) ----

local FIRE_Y     = 625                          -- fixed: earliest Y that scores PERFECT
local MICRO      = 18                           -- px of jitter, positive only
local KEYS       = { 0x44, 0x46, 0x4A, 0x4B }   -- D F J K, left to right
local FALLBACK   = { 630, 798, 965, 1133 }
local HOLD_TOL   = 26                           -- px: partner tile this close = a hold
local HOLD_BASE  = 0.35                         -- s a hold is held before any extension
local HOLD_STEP  = 0.05                         -- s pushed forward per frame while alive
local MAX_HOLD   = 6.0                          -- s safety cap
local TAP_MIN    = 35                           -- ms key-down range (humanized)
local TAP_MAX    = 55
local PAST       = 220
local DOT_OFF    = 83

-- ---- state ----

local running, conns = true, {}
local on      = true
local recs    = {}
local held    = {}
local laneXs  = {}
local chart   = nil
local taps, holdsN, skipped, armedN = 0, 0, 0, 0
local focused = nil
local lastLane, lastKey = 0, 0
local liveNow = {}
local dots    = {}
local lineFire, lineBottom, lineLabel, hud

local function log(m) print('[' .. NAME .. '] ' .. tostring(m)) end

if type(setrobloxinput) == 'function' then pcall(setrobloxinput, true) end

-- ---- lanes ----

local function noteLaneX(x)
    if type(x) ~= 'number' or x < 560 or x > 1400 then return end
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= 8 then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then log('lanes ' .. table.concat(laneXs, '/')) end
end

local function laneOf(x)
    local cols = (#laneXs == 4) and laneXs or FALLBACK
    local best, bd = nil, math.huge
    for i = 1, 4 do
        local d = math.abs(cols[i] - x)
        if d < bd then best, bd = i, d end
    end
    if bd <= 120 then return best end
    return nil
end

-- ---- key output ----

local function releaseLane(lane)
    if not held[lane] then return end
    held[lane] = nil
    pcall(keyrelease, KEYS[lane])
end

local function releaseAll()
    for lane = 1, 4 do releaseLane(lane) end
end

-- Force a release first: InputBegan only fires on the key transition, so a key left
-- down would silently swallow every later note in that lane.
-- The field is `due`, never `until` - `until` is a reserved Lua keyword.
local function pressLane(lane, now, addr, isHold)
    local vk = KEYS[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    if held[lane] then releaseLane(lane) end
    if not pcall(keypress, vk) then return false end
    local dur = isHold and HOLD_BASE or (math.random(TAP_MIN, TAP_MAX) / 1000)
    held[lane] = { due = now + dur, since = now, addr = addr, hold = isHold }
    taps = taps + 1
    if isHold then holdsN = holdsN + 1 end
    lastLane, lastKey = lane, vk
    return true
end

-- Deadline-driven release. A hold is extended while its partner tile is still alive,
-- which is the head+tail pair the probe found; no Y or Visible test is used.
local function serviceKeys(now)
    for lane = 1, 4 do
        local h = held[lane]
        if h then
            if h.hold and h.partner and liveNow[h.partner] then
                h.due = math.min(h.due + HOLD_STEP, now + HOLD_STEP * 2)
            end
            if now >= h.due or (now - h.since) > MAX_HOLD then
                releaseLane(lane)
            end
        end
    end
end

-- ---- overlays ----

pcall(function()
    lineFire = Drawing.new('Line')
    lineFire.Color = Color3.fromRGB(255, 220, 60)
    lineFire.Thickness = 2
    lineFire.Visible = false

    lineBottom = Drawing.new('Line')
