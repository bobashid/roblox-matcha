--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.7
  Features:   auto play - ONE toggle and ONE slider. Presses lane keys at the Fire Y line.
              Mouse output removed entirely (it never worked in this game).
  Controls:   menu tab "Piano Auto" - one toggle, one slider. Nothing else.
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Why v2.7 (user HUD: "KEYS | lanes 0/630/798/965 | cur 1919,1079"):
    1. A tile reported X = 0, so lane 1 was learned at 0. Lane width became
       (965-0)/3 = 321 instead of 167 and every target was wrong. Tile X is now
       only accepted inside 560..1400, so a parked or hidden tile cannot pollute
       the ladder.
    2. The cursor read back as 1919,1079 - the bottom-right corner of a 1920x1080
       screen - and never moved. Mouse movement does not work in this game, so
       every click fired into the corner. Mouse output is therefore GONE; v2.7
       presses keys only, which is the route that landed hits in v1.7.
    3. The menu is now exactly one toggle and one slider, as requested.

  Confirmed:  keypress / keyrelease reach the game (v1.7 landed hits with keys)
  Confirmed:  tiles sit at four X values: 630 / 798 / 965 / 1133 (left to right)
  Confirmed:  Shared.Config DefaultKeys = D F J K, left to right
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  board is x 625..1292, bottom edge y ~ 1076; y=1104 is the park spot
  Confirmed:  FIRE_Y 950 landed hits; y >= 1034 was LATE; timing is settled
  Confirmed:  no hit/press remote exists - scoring is local, input is the only route
  Confirmed:  mousemoveabs / mousemoverel do not move the cursor in this game
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: the exact FIRE_Y you settle on

  SLIDER:  LOWER Fire Y = fires EARLIER   |   HIGHER Fire Y = fires LATER
  HUD:     taps, fireY, the lane+key of the last press, lanes, chart
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.7'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

-- ---- config ----

local FIRE_Y = 950                       -- the slider writes this
local LANE_FALLBACK = { 630, 798, 965, 1133 }
local KEYS          = { 0x44, 0x46, 0x4A, 0x4B }   -- D F J K, left to right
local LANE_MIN, LANE_MAX = 560, 1400     -- reject impossible tile X values
local TAP_MS   = 45
local ARM_GAP  = 120                     -- tile must be seen this far above FIRE_Y
local GIVE_UP  = 180                     -- px past FIRE_Y before a tile is abandoned
local DOT_OFF  = 83                      -- half a lane, for the dot on each note

-- ---- state ----

local running = true
local conns   = {}
local on      = true
local recs    = {}
local fired   = {}
local laneXs  = {}
local chart   = nil
local taps    = 0
local focused = nil
local lastLane, lastKey = 0, 0
local dotPool = {}
local lineFire, lineBottom, lineLabel

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function track(c)
    conns[#conns + 1] = c
    return c
end

if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

-- ---- lanes ----

local function noteLaneX(x)
    if type(x) ~= 'number' or x < LANE_MIN or x > LANE_MAX then return end
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= 8 then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then
        log('lanes learned: ' .. table.concat(laneXs, ', '))
    end
end

local function laneOf(x)
    local cols = (#laneXs == 4) and laneXs or LANE_FALLBACK
    local best, bestD = nil, math.huge
    for i = 1, 4 do
        local d = math.abs(cols[i] - x)
        if d < bestD then best, bestD = i, d end
    end
    if bestD <= 120 then return best end
    return nil
end

-- ---- key output ----

local function tapLane(lane)
    local vk = KEYS[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    if not pcall(keypress, vk) then return false end
    taps = taps + 1
    lastLane, lastKey = lane, vk
    task.delay(TAP_MS / 1000, function() pcall(keyrelease, vk) end)
    return true
end

local function releaseAll()
    for i = 1, 4 do pcall(keyrelease, KEYS[i]) end
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- overlays ----

pcall(function()
    lineFire = Drawing.new('Line')
    lineFire.Color = Color3.fromRGB(255, 220, 60)
    lineFire.Thickness = 2
    lineFire.Visible = false

    lineBottom = Drawing.new('Line')
    lineBottom.Color = Color3.fromRGB(200, 200, 210)
    lineBottom.Thickness = 1
    lineBottom.Transparency = 0.55
    lineBottom.Visible = false

    lineLabel = Drawing.new('Text')
    lineLabel.Size = 12
    lineLabel.Outline = true
    lineLabel.Color = Color3.fromRGB(255, 220, 60)
    lineLabel.Visible = false

    for i = 1, 40 do
        local d = Drawing.new('Circle')
        d.Radius = 4
        d.NumSides = 12
        d.Filled = true
        d.Thickness = 1
        d.Color = Color3.fromRGB(120, 220, 255)
        d.Visible = false
        dotPool[i] = d
    end
end)

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    local now  = os.clock()
    local list = holder:GetChildren()
    local armY = FIRE_Y - ARM_GAP

    -- new song -> forget everything, including the learned columns
    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart  = cv
                recs   = {}
                fired  = {}
                laneXs = {}
                taps   = 0
                releaseAll()
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live  = {}
    local batch = {}
    local dotIx = 0

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos
                and type(pos.Y) == 'number' and type(pos.X) == 'number' then
                live[addr] = true
                noteLaneX(pos.X)

                local r = recs[addr]
                if not r then
                    r = { armed = pos.Y < armY }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < armY then r.armed = true end

                dotIx = dotIx + 1
                local d = dotPool[dotIx]
                if d then
                    d.Position = Vector2.new(pos.X + DOT_OFF, pos.Y)
                    if fired[addr] then
                        d.Color = Color3.fromRGB(150, 150, 160)
                        d.Transparency = 0.6
                    elseif math.abs(pos.Y - FIRE_Y) <= 60 then
                        d.Color = Color3.fromRGB(255, 220, 60)
                        d.Transparency = 0
                    elseif pos.Y >= armY then
                        d.Color = Color3.fromRGB(255, 255, 255)
                        d.Transparency = 0
                    else
                        d.Color = Color3.fromRGB(120, 220, 255)
                        d.Transparency = 0.35
                    end
                    d.Visible = true
                end

                batch[#batch + 1] = { addr = addr, x = pos.X, y = pos.Y, r = r }
            end
        end
    end

    for i = dotIx + 1, #dotPool do
        local d = dotPool[i]
        if d and d.Visible then d.Visible = false end
    end

    if lineFire then
        local cols = (#laneXs == 4) and laneXs or LANE_FALLBACK
        local x1 = cols[1] - 10
        local x2 = cols[4] + 170
        lineFire.From = Vector2.new(x1, FIRE_Y)
        lineFire.To   = Vector2.new(x2, FIRE_Y)
        lineFire.Visible = true
        lineBottom.From = Vector2.new(x1, 1076)
        lineBottom.To   = Vector2.new(x2, 1076)
        lineBottom.Visible = true
        lineLabel.Text = string.format('FIRE %d', math.floor(FIRE_Y))
        lineLabel.Position = Vector2.new(x1 + 4, FIRE_Y - 16)
        lineLabel.Visible = true
    end

    for i = 1, #batch do
        local it = batch[i]
        local r  = it.r
        if not fired[it.addr] then
            if it.y > FIRE_Y + GIVE_UP then
                fired[it.addr] = true
            elseif on and focused and r.armed and it.y >= FIRE_Y then
                local lane = laneOf(it.x)
                if lane then
                    if tapLane(lane) then fired[it.addr] = true end
                else
                    fired[it.addr] = true
                end
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then
            recs[addr]  = nil
            fired[addr] = nil
        end
    end
end

local function hudText()
    if not hud then return end
    local lanesTxt = #laneXs > 0 and table.concat(laneXs, '/') or 'default'
    local keyTxt   = lastKey > 0 and string.char(lastKey) or '-'
    hud.Text = string.format('%s | on %s | focus %s | taps %d | fireY %d | last lane %d key %s | lanes %s | chart %s',
        VERSION, tostring(on), tostring(focused), taps, math.floor(FIRE_Y),
        lastLane, keyTxt, lanesTxt, tostring(chart))
end

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: exactly one toggle + one slider ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, def, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, def, cb) end,
        function() sec:SliderInt(label, id, min, max, def, cb) end,
        function() sec:SliderInt(label, min, max, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseAll()
                    end
                    log('auto play ' .. (v and 'ON' or 'OFF'))
                end)

                mkSlider(sec, 'Fire Y (lower = earlier)', 'pa_firey', 500, 1100, math.floor(FIRE_Y), function(v)
                    FIRE_Y = math.floor(v)
                    log('fireY = ' .. tostring(FIRE_Y))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseAll()
    for i = 1, #dotPool do
        pcall(function() dotPool[i]:Remove() end)
    end
    dotPool = {}
    if lineFire then pcall(function() lineFire:Remove() end) end
    if lineBottom then pcall(function() lineBottom:Remove() end) end
    if lineLabel then pcall(function() lineLabel:Remove() end) end
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - keys only, Fire Y ' .. tostring(FIRE_Y))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
