--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.6
  Features:   auto play - one toggle, Fire Y slider, CLICK X OFFSET slider, relative mouse
              move, fire line + per-note dots
  Controls:   menu tab "Piano Auto" - one toggle, two sliders, two toggles
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Why v2.6 (click still lands in the wrong column):
    Three versions produced correct timing with the wrong column, including v2.4 which
    clicked at the tile's own X and verified the cursor with lp:GetMouse(). That means
    the lane arithmetic is NOT the fault - the click is being delivered to a different X
    than the one we aimed at (a coordinate-space difference between mousemoveabs,
    lp:GetMouse() and the Position the game reads).
    v2.6 keeps the relative move and adds the one control that fixes this by eye:
    a CLICK X OFFSET slider. The HUD prints the tile X and the click X it used, so you
    can dial the offset until the click column matches the note column, then tell me the
    number and I bake it in.

  Remotes are TELEMETRY ONLY - confirmed from the user's dump:
    Request:InvokeServer("telemetry", {event = "play_requested"})
    Request:InvokeServer("telemetry", {event = "offer", key = "practiceMode"})
    Request:InvokeServer("telemetry", {event = "frames", taps = 0, long = 0, ...})
    plus clientErrors and songVote from the decompile. There is NO hit/press/release
    remote, so hits are scored locally in Client.Engine. Input simulation is the only
    route, and holds cannot be sent remotely.

  Confirmed:  Client.Input resolves a click with Board.laneAt(input.Position.X), X only
  Confirmed:  tiles sit at four distinct X values (630 / 798 / 965 / 1133); tile X is the
              lane's left edge + ~5, so tile X + half a lane = the lane centre
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  board is x 625..1292 (667 wide), height ~1076, y=1104 is BELOW the board
  Confirmed:  FIRE_Y = 950 lands hits; y >= 1034 was LATE; timing is settled
  Confirmed:  the single-char TextLabels in PianoTiles are the judgement tally, not keys
  Confirmed:  mousemoveabs / mousemoverel / mouse1press / mouse1release all exist
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: the X offset between our click and the game's input.Position

  SLIDERS: LOWER Fire Y = fires EARLIER | HIGHER Fire Y = fires LATER
           Click X offset shifts every click right (+) or left (-) in pixels
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.6'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----

local FIRE_Y      = 950
local CLICK_X_OFF = 0      -- live value, the offset slider writes this

local CFG = {
    ARM_GAP   = 100,
    giveUp    = 160,
    laneTol   = 8,
    tapMs     = 35,
    clickYpct = 55,
    fallbackW = 167,
    boardBottom = 1076,
    keys      = { 0x44, 0x46, 0x4A, 0x4B },
}

-- ---- state ----

local on         = true
local recs       = {}
local laneXs     = {}
local chart      = nil
local taps       = 0
local fired      = {}
local focused    = nil
local lastAct    = '-'
local lastCursor = '-'
local lastTileX  = 0
local lastClickX = 0
local mouseBusy  = false
local clickFails = 0
local useKeys    = false
local useAbs     = false
local mirrored   = false
local dotPool    = {}
local lineFire, lineBottom, lineLabel

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

-- ---- helpers ----

local function viewportH()
    local ok, vp = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    if ok and vp and type(vp.Y) == 'number' and vp.Y > 0 then return vp.Y end
    return 1080
end

local function mousePos()
    local ok, m = pcall(function() return lp:GetMouse() end)
    if not ok or not m then return nil, nil end
    local okx, x = pcall(function() return m.X end)
    local oky, y = pcall(function() return m.Y end)
    if okx and oky and type(x) == 'number' and type(y) == 'number' then
        return x, y
    end
    return nil, nil
end

-- Relative movement: a DELTA is identical in every coordinate space, so window
-- offset, title bar and DPI scaling cannot skew it. Chunked because the OS clamps
-- large relative moves.
local function moveRel(tx, ty)
    if type(mousemoverel) ~= 'function' then return false, 'no mousemoverel' end
    for _ = 1, 12 do
        local cx, cy = mousePos()
        if not cx or not cy then
            pcall(function() mousemoverel(0, 0) end)
            return false, 'no cursor readback'
        end
        local dx, dy = tx - cx, ty - cy
        if math.abs(dx) <= 3 and math.abs(dy) <= 3 then return true end
        local sx = math.max(-200, math.min(200, math.floor(dx + 0.5)))
        local sy = math.max(-200, math.min(200, math.floor(dy + 0.5)))
        if sx == 0 and sy == 0 then return true end
        pcall(function() mousemoverel(sx, sy) end)
    end
    local fx, fy = mousePos()
    if not fx then return false, 'gave up' end
    return (math.abs(tx - fx) <= 8 and math.abs(ty - fy) <= 8),
           string.format('cursor %d,%d want %d,%d', fx, fy, tx, ty)
end

local function moveAbs(tx, ty)
    if type(mousemoveabs) ~= 'function' then return false, 'no mousemoveabs' end
    for _ = 1, 3 do
        pcall(function() mousemoveabs(tx, ty) end)
        local cx, cy = mousePos()
        if not cx or not cy then return true end
        if math.abs(tx - cx) <= 2 and math.abs(ty - cy) <= 2 then return true end
    end
    local fx, fy = mousePos()
    if not fx then return true end
    return (math.abs(tx - fx) <= 6 and math.abs(ty - fy) <= 6),
           string.format('cursor %d,%d want %d,%d', fx, fy, tx, ty)
end

local function moveTo(tx, ty)
    if useAbs then return moveAbs(tx, ty) end
    return moveRel(tx, ty)
end

local function noteLaneX(x)
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= CFG.laneTol then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then
        log('lanes learned: ' .. table.concat(laneXs, ', '))
    end
end

local function laneWidth()
    if #laneXs < 2 then return CFG.fallbackW end
    local w = (laneXs[#laneXs] - laneXs[1]) / (#laneXs - 1)
    if w > 40 and w < 600 then return w end
    return CFG.fallbackW
end

local function setupDrawings()
    pcall(function()
        lineFire = Drawing.new('Line')
        lineFire.Color = Color3.fromRGB(255, 220, 60)
        lineFire.Thickness = 2
        lineFire.Visible = false

        lineBottom = Drawing.new('Line')
        lineBottom.Color = Color3.fromRGB(200, 200, 210)
        lineBottom.Thickness = 1
        lineBottom.Transparency = 0.55
        lineBottom.Visible = false

        lineLabel = Drawing.new('Text')
        lineLabel.Size = 12
        lineLabel.Outline = true
        lineLabel.Color = Color3.fromRGB(255, 220, 60)
        lineLabel.Visible = false

        for i = 1, 40 do
            local d = Drawing.new('Circle')
            d.Radius = 4
            d.NumSides = 12
            d.Filled = true
            d.Thickness = 1
            d.Color = Color3.fromRGB(120, 220, 255)
            d.Visible = false
            dotPool[i] = d
        end
    end)
end

setupDrawings()

local function releaseMouse()
    if not mouseBusy then return end
    mouseBusy = false
    pcall(function() mouse1release() end)
end

-- ---- one lane press ----

local function pressAt(tileX, addr, now)
    local w = laneWidth()
    local col = 0
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - tileX) < 20 then col = i end
    end
    if mirrored and col > 0 then col = 5 - col end
    local baseX
    if col > 0 then
        baseX = laneXs[col] + w * 0.5
    else
        baseX = tileX + w * 0.5
    end
    local tx = math.floor(baseX + CLICK_X_OFF)
    local ty = math.floor(viewportH() * (CFG.clickYpct / 100))
    lastTileX  = math.floor(tileX)
    lastClickX = tx

    if not useKeys then
        if mouseBusy then return false end
        local ok, why = moveTo(tx, ty)
        local cx, cy = mousePos()
        lastCursor = cx and string.format('cur %d,%d', cx, cy) or 'cur ?'
        if ok then
            if pcall(function() mouse1press() end) then
                mouseBusy = true
                taps = taps + 1
                clickFails = 0
                lastAct = string.format('click %d,%d', tx, ty)
                task.delay(CFG.tapMs / 1000, releaseMouse)
                return true
            end
            why = 'mouse1press failed'
        end
        clickFails = clickFails + 1
        lastAct = 'move fail ' .. tostring(why)
        if clickFails >= 6 then
            useKeys = true
            log('cursor would not move after 6 tries - switched to keys')
        end
        return false
    end

    local lane, best = 1, math.huge
    for i = 1, #laneXs do
        local d = math.abs(laneXs[i] - tileX)
        if d < best then best, lane = d, i end
    end
    if mirrored then lane = 5 - lane end
    local vk = CFG.keys[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    if not pcall(keypress, vk) then return false end
    taps = taps + 1
    lastAct = 'key ' .. string.char(vk) .. ' lane ' .. lane
    task.delay(CFG.tapMs / 1000, function() pcall(keyrelease, vk) end)
    return true
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    if not on or not focused then
        releaseMouse()
    end

    local now  = os.clock()
    local list = holder:GetChildren()
    local armY = FIRE_Y - CFG.ARM_GAP

    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart      = cv
                recs       = {}
                fired      = {}
                laneXs     = {}
                taps       = 0
                clickFails = 0
                releaseMouse()
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live  = {}
    local batch = {}
    local dotIx = 0

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos
                and type(pos.Y) == 'number' and type(pos.X) == 'number' then
                live[addr] = true
                noteLaneX(pos.X)

                local r = recs[addr]
                if not r then
                    r = { armed = pos.Y < armY }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < armY then r.armed = true end

                dotIx = dotIx + 1
                local d = dotPool[dotIx]
                if d then
                    d.Position = Vector2.new(pos.X + laneWidth() * 0.5, pos.Y)
                    if fired[addr] then
                        d.Color = Color3.fromRGB(150, 150, 160)
                        d.Transparency = 0.6
                    elseif math.abs(pos.Y - FIRE_Y) <= 60 then
                        d.Color = Color3.fromRGB(255, 220, 60)
                        d.Transparency = 0
                    elseif pos.Y >= armY then
                        d.Color = Color3.fromRGB(255, 255, 255)
                        d.Transparency = 0
                    else
                        d.Color = Color3.fromRGB(120, 220, 255)
                        d.Transparency = 0.35
                    end
                    d.Visible = true
                end

                batch[#batch + 1] = { addr = addr, x = pos.X, y = pos.Y, r = r }
            end
        end
    end

    for i = dotIx + 1, #dotPool do
        local d = dotPool[i]
        if d and d.Visible then d.Visible = false end
    end

    if lineFire then
        local x1, x2 = 619, 1298
        if #laneXs >= 2 then
            x1 = laneXs[1] - 6
            x2 = laneXs[#laneXs] + laneWidth() + 6
        end
        lineFire.From = Vector2.new(x1, FIRE_Y)
        lineFire.To   = Vector2.new(x2, FIRE_Y)
        lineFire.Visible = true
        lineBottom.From = Vector2.new(x1, CFG.boardBottom)
        lineBottom.To   = Vector2.new(x2, CFG.boardBottom)
        lineBottom.Visible = true
        lineLabel.Text = string.format('FIRE %d', math.floor(FIRE_Y))
        lineLabel.Position = Vector2.new(x1 + 4, FIRE_Y - 16)
        lineLabel.Visible = true
    end

    for i = 1, #batch do
        local it = batch[i]
        local r  = it.r
        if not fired[it.addr] then
            if it.y > FIRE_Y + CFG.giveUp then
                fired[it.addr] = true
            elseif on and focused and it.y >= FIRE_Y and r.armed then
                if pressAt(it.x, it.addr, now) then
                    fired[it.addr] = true
                end
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then
            recs[addr]  = nil
            fired[addr] = nil
        end
    end
end

-- ---- readout ----

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local function hudText()
    if not hud then return end
    local lanesTxt = #laneXs > 0 and table.concat(laneXs, '/') or 'learning'
    hud.Text = string.format('%s | %s%s | focus %s | taps %d | fireY %d | off %+d | lanes %s | tile x%d -> click x%d | %s | chart %s',
        VERSION,
        useKeys and 'KEYS' or (useAbs and 'ABS' or 'REL'),
        mirrored and ' MIRROR' or '',
        tostring(focused), taps, math.floor(FIRE_Y), math.floor(CLICK_X_OFF),
        lanesTxt, lastTileX, lastClickX, lastCursor, tostring(chart))
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, def, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, def, cb) end,
        function() sec:SliderInt(label, id, min, max, def, cb) end,
        function() sec:SliderInt(label, min, max, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseMouse()
                    end
                    log('auto play ' .. (v and 'ON' or 'OFF'))
                end)

                mkSlider(sec, 'Fire Y (lower = earlier)', 'pa_firey', 500, 1100, math.floor(FIRE_Y), function(v)
                    FIRE_Y = math.floor(v)
                    log('fireY = ' .. tostring(FIRE_Y))
                end)

                mkSlider(sec, 'Click X offset px (+ = right)', 'pa_xoff', -400, 400, math.floor(CLICK_X_OFF), function(v)
                    CLICK_X_OFF = math.floor(v)
                    log('click x offset = ' .. tostring(CLICK_X_OFF))
                end)

                mkToggle(sec, 'Absolute mouse move (off = relative)', 'pa_abs', useAbs, function(v)
                    useAbs = v
                    log('mouse move ' .. (v and 'ABSOLUTE' or 'RELATIVE'))
                end)

                mkToggle(sec, 'Mirror lanes (1 <-> 4)', 'pa_mirror', mirrored, function(v)
                    mirrored = v
                    log('mirror ' .. (v and 'ON' or 'OFF'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseMouse()
    for i = 1, #dotPool do
        pcall(function() dotPool[i]:Remove() end)
    end
    dotPool = {}
    if lineFire then pcall(function() lineFire:Remove() end) end
    if lineBottom then pcall(function() lineBottom:Remove() end) end
    if lineLabel then pcall(function() lineLabel:Remove() end) end
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - Fire Y ' .. tostring(FIRE_Y) .. ', click offset ' .. tostring(CLICK_X_OFF))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
