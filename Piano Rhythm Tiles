--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v1.7
  Features:   auto play - ONE toggle; taps the lane when a tile crosses a single Y line
  Controls:   menu tab "Piano Auto" - one toggle, nothing else
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)
  Confirmed:  lanes x 625/792/959/1126, width 167; tiles are Board.Tiles.Tile with
              TileIndex / ChartVersion and a readable .Address
  Confirmed:  Client.Input picks a click's lane with Board.laneAt(position.X) - X only
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom of the screen
  Confirmed:  a live chart is a 100px ladder: idx 3 y=991 ... idx 12 y=91
  Confirmed:  idle tiles park at y = 1104, just BELOW the board, and vanish there
  Confirmed:  Board sits at (625,0) and the lanes end at 1292 -> board width 667
  Confirmed:  Shared.Config.BoardAspect = 0.62 -> board height ~1076, so the board
              occupies y 0..1076 and y=1104 is outside it (clipped away)
  Confirmed:  keypress / keyrelease / isrbxactive / setrobloxinput all exist
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  Confirmed:  a build firing at y >= 1034 scored exactly one hit, and it was LATE
  UNVERIFIED: the exact judged Y - FIRE_Y below is the one number to trim
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v1.7'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----
-- Tiles fall DOWNWARD, so a LOWER FIRE_Y fires EARLIER and a HIGHER one fires LATER.
-- A build firing at y >= 1034 was LATE, so start below it.
--   still late  -> lower FIRE_Y  (950 -> 900 -> 860)
--   too early   -> raise FIRE_Y  (950 -> 1000)

local CFG = {
    FIRE_Y = 950,
    SEEN_Y = 850,      -- a tile must be seen above this before it is armed
    tapMs  = 40,
    gapMs  = 30,
    laneX  = { 625, 792, 959, 1126 },
    laneW  = 167,
    keys   = { 0x44, 0x46, 0x4A, 0x4B },   -- D F J K
}

-- ---- state ----

local on      = true
local recs    = {}
local chart   = nil
local taps    = 0
local focused = nil
local laneAt  = { 0, 0, 0, 0 }
local lowY    = 0

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

-- injected input must be enabled once, or every keypress is silently dropped
if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

local function laneOf(x)
    if type(x) ~= 'number' then return nil end
    for i = 1, 4 do
        if x >= CFG.laneX[i] - 12 and x < CFG.laneX[i] + CFG.laneW + 12 then
            return i
        end
    end
    return nil
end

local function tap(lane, now)
    local vk = CFG.keys[lane]
    if not vk then return end
    if now - laneAt[lane] < CFG.gapMs / 1000 then return end
    laneAt[lane] = now
    if type(keypress) ~= 'function' then return end
    pcall(keypress, vk)
    taps = taps + 1
    task.delay(CFG.tapMs / 1000, function()
        pcall(keyrelease, vk)
    end)
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    local now  = os.clock()
    local list = holder:GetChildren()

    -- new song -> forget every tracked tile
    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart = cv
                recs  = {}
                taps  = 0
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live   = {}
    local lowest = 0

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos and type(pos.Y) == 'number' then
                live[addr] = true

                local r = recs[addr]
                if not r then
                    r = { lane = laneOf(pos.X), armed = pos.Y < CFG.SEEN_Y, done = false }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < CFG.SEEN_Y then r.armed = true end
                if not r.lane then r.lane = laneOf(pos.X) end

                if pos.Y > lowest then lowest = pos.Y end

                if on and focused and r.armed and not r.done and r.lane
                    and pos.Y >= CFG.FIRE_Y then
                    r.done = true
                    tap(r.lane, now)
                end
            end
        end
    end

    lowY = lowest

    for addr in pairs(recs) do
        if not live[addr] then recs[addr] = nil end
    end
end

-- ---- readout (not a control) ----

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local function hudText()
    if not hud then return end
    hud.Text = string.format('%s | on %s | focus %s | taps %d | fireY %d | low y %d | chart %s',
        VERSION, tostring(on), tostring(focused), taps, CFG.FIRE_Y,
        math.floor(lowY), tostring(chart))
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: exactly one toggle ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end
                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v and type(setrobloxinput) == 'function' then
                        pcall(setrobloxinput, true)
                    end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    for i = 1, #CFG.keys do
        pcall(function() keyrelease(CFG.keys[i]) end)
    end
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - one toggle, fire at y >= ' .. tostring(CFG.FIRE_Y))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
