--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.3
  Features:   auto play - one toggle plus one Fire Y slider; CLICKS the lane column so the
              game itself resolves the lane (no key-order guess), keys as a fallback
  Controls:   menu tab "Piano Auto" - one toggle, one slider, one output toggle
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Why v2.3 exists (lane still wrong after v2.1/v2.2):
    The four lane COLUMNS are correct (learned from tile X: 630 / 798 / 965 / 1133 and
    confirmed live as 965,511 and 1133,31). So the remaining error can only be which
    KEY the game maps to each column - that comes from the saved profile's key preset,
    not from a constant, so hardcoding D F J K was a guess.
    Instead of guessing, v2.3 clicks the lane column: Client.Input resolves a click with
    Board.laneAt(position.X), i.e. THE GAME decides the lane from the X we click. There
    is no key order to get wrong. Keys stay available as a fallback toggle.

  Confirmed:  Client.Input maps a mouse click / touch to a lane via Board.laneAt(pos.X)
  Confirmed:  Client.Input maps KeyCode -> lane from the profile's key preset
  Confirmed:  tiles sit at four distinct X values (630 / 798 / 965 / 1133)
  Confirmed:  a tile's X is its lane's left edge + ~5, so tile width = lane width
  Confirmed:  the single-char TextLabels in PianoTiles are the judgement tally
              (PERFECT/COOL/GOOD/MISS at x 641/803/965/1127), NOT key labels
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  idle tiles park at y = 1104, just BELOW the board (bottom ~1076)
  Confirmed:  FIRE_Y = 950 lands hits; y >= 1034 was LATE
  Confirmed:  mousemoveabs / mouse1press / mouse1release / keypress all exist
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: an injected mouse click reaches UserInputService with its Position
  UNVERIFIED: sustaining the press while the tile persists is enough for holds

  SLIDER:  LOWER Fire Y = fires EARLIER   |   HIGHER Fire Y = fires LATER
  HUD:     "lanes 630/798/965/1133" = learned columns | "last click lane 2 x881" = last act
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.3'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----

local FIRE_Y = 950

local CFG = {
    ARM_GAP   = 100,     -- tile must be seen this far above FIRE_Y before it can fire
    gapMs     = 30,      -- min ms between two presses in one lane
    maxHold   = 3.0,     -- safety cap on one held lane, seconds
    giveUp    = 140,     -- px past FIRE_Y before an unpressed tile is abandoned
    laneTol   = 8,       -- px tolerance when deduplicating a lane X
    clickYpct = 55,      -- click Y as % of viewport height (lane comes from X)
    keys      = { 0x44, 0x46, 0x4A, 0x4B },   -- D F J K, fallback mode only
}

-- ---- state ----

local useMouse = true
local on       = true
local recs     = {}
local laneXs   = {}
local chart    = nil
local taps     = 0
local holds    = 0
local focused  = nil
local lowY     = 0
local laneAt   = { 0, 0, 0, 0 }
local down     = {}
local lastLane = 0
local lastX    = 0
local lastAct  = '-'

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

-- injected input must be enabled once, or every keypress/click is dropped
if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

-- ---- lane discovery ----

local function noteLaneX(x)
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= CFG.laneTol then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then
        log('lanes learned: ' .. table.concat(laneXs, ', '))
    end
end

local function laneFromX(x)
    local best, bestD = nil, math.huge
    for i = 1, #laneXs do
        local d = math.abs(laneXs[i] - x)
        if d < bestD then best, bestD = i, d end
    end
    if best and bestD <= 70 then return best end
    return nil
end

local function laneWidth()
    if #laneXs < 4 then return 167 end
    local w = (laneXs[4] - laneXs[1]) / 3
    if w > 40 and w < 600 then return w end
    return 167
end

-- ---- output helpers ----

local function viewportH()
    local ok, vp = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    if ok and vp and type(vp.Y) == 'number' and vp.Y > 0 then return vp.Y end
    return 1080
end

local function mousePos()
    local ok, m = pcall(function() return lp:GetMouse() end)
    if not ok or not m then return nil, nil end
    local okx, x = pcall(function() return m.X end)
    local oky, y = pcall(function() return m.Y end)
    if okx and oky and type(x) == 'number' and type(y) == 'number' then
        return x, y
    end
    return nil, nil
end

-- Click the middle of the lane column. The game resolves the lane from this X
-- with Board.laneAt, so the key mapping never enters the picture.
local function clickLane(lane)
    if type(mousemoveabs) ~= 'function' or type(mouse1press) ~= 'function' then
        return false
    end
    local lx = laneXs[lane]
    if not lx then return false end
    local cx = math.floor(lx + laneWidth() * 0.5)
    local cy = math.floor(viewportH() * (CFG.clickYpct / 100))
    if not pcall(function() mousemoveabs(cx, cy) end) then return false end
    if not pcall(function() mouse1press() end) then return false end
    return true, cx
end

local function releaseLane(lane)
    local d = down[lane]
    if not d then return end
    down[lane] = nil
    if d.mouse then
        pcall(function() mouse1release() end)
        if d.sx and d.sy then
            task.delay(0.02, function()
                pcall(function() mousemoveabs(d.sx, d.sy) end)
            end)
        end
    else
        pcall(keyrelease, d.vk)
    end
end

local function releaseAll()
    for lane = 1, 4 do
        releaseLane(lane)
    end
end

local function press(lane, addr, now)
    if down[lane] then return false end
    if now - laneAt[lane] < CFG.gapMs / 1000 then return false end

    if useMouse then
        local sx, sy = mousePos()
        local ok, cx = clickLane(lane)
        if not ok then
            lastAct = 'click failed'
            return false
        end
        laneAt[lane] = now
        down[lane] = { addr = addr, since = now, mouse = true, sx = sx, sy = sy }
        taps = taps + 1
        lastAct = 'click lane ' .. lane .. ' x' .. tostring(cx)
        return true
    end

    local vk = CFG.keys[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    if not pcall(keypress, vk) then
        lastAct = 'keypress failed'
        return false
    end
    laneAt[lane] = now
    down[lane] = { addr = addr, since = now, vk = vk }
    taps = taps + 1
    lastAct = 'key ' .. string.char(vk) .. ' lane ' .. lane
    return true
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    if not on or not focused then
        releaseAll()
    end

    local now  = os.clock()
    local list = holder:GetChildren()
    local armY = FIRE_Y - CFG.ARM_GAP

    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart  = cv
                recs   = {}
                laneXs = {}
                taps   = 0
                holds  = 0
                releaseAll()
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live   = {}
    local lowest = 0
    local batch  = {}

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos
                and type(pos.Y) == 'number' and type(pos.X) == 'number' then
                live[addr] = true
                noteLaneX(pos.X)

                local r = recs[addr]
                if not r then
                    r = { armed = pos.Y < armY, done = false }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < armY then r.armed = true end
                if pos.Y > lowest then lowest = pos.Y end
                batch[#batch + 1] = { addr = addr, x = pos.X, y = pos.Y, r = r }
            end
        end
    end

    lowY = lowest

    for i = 1, #batch do
        local it = batch[i]
        local r  = it.r
        if r.armed and not r.done then
            if on and focused and #laneXs >= 4 and it.y >= FIRE_Y then
                local lane = laneFromX(it.x)
                if lane then
                    if press(lane, it.addr, now) then
                        r.done   = true
                        lastLane = lane
                        lastX    = it.x
                    elseif it.y > FIRE_Y + CFG.giveUp then
                        r.done = true
                    end
                end
            elseif it.y > FIRE_Y + CFG.giveUp then
                r.done = true
            end
        end
    end

    for lane = 1, 4 do
        local d = down[lane]
        if d then
            local gone = not live[d.addr]
            local dur  = now - d.since
            if gone or dur > CFG.maxHold then
                if dur > 0.12 then holds = holds + 1 end
                releaseLane(lane)
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then recs[addr] = nil end
    end
end

-- ---- readout ----

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local function hudText()
    if not hud then return end
    local lanesTxt = #laneXs > 0 and table.concat(laneXs, '/') or 'learning'
    hud.Text = string.format('%s | on %s | focus %s | %s | taps %d holds %d | fireY %d | lanes %s | last %s | chart %s',
        VERSION, tostring(on), tostring(focused),
        useMouse and 'CLICK' or 'KEYS', taps, holds, math.floor(FIRE_Y),
        lanesTxt, lastAct, tostring(chart))
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, def, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, def, cb) end,
        function() sec:SliderInt(label, id, min, max, def, cb) end,
        function() sec:SliderInt(label, min, max, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseAll()
                    end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)

                mkSlider(sec, 'Fire Y (lower = earlier)', 'pa_firey', 500, 1100, math.floor(FIRE_Y), function(v)
                    FIRE_Y = math.floor(v)
                    log('fireY = ' .. tostring(FIRE_Y))
                end)

                mkToggle(sec, 'Click lanes (off = keys D F J K)', 'pa_mouse', useMouse, function(v)
                    releaseAll()
                    useMouse = v
                    log('output ' .. (v and 'click' or 'keys'))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseAll()
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - clicks lanes, Fire Y ' .. tostring(FIRE_Y))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
