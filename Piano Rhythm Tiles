--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v1.2
  Features:   auto play - taps lanes with firetouchinterest (no window focus needed), or a
              mouse click, or keybinds; per-tile timing off spawn + chart clock; live HUD
  Controls:   menu tab "Piano Auto"
  Needs:      Matcha Pro
  Confirmed:  lanes at x 625/792/959/1126, width 167; tiles are Board.Tiles.Tile with
              TileIndex / ChartVersion attributes and a readable .Address
  Confirmed:  Client.Input picks a click's lane with Board.laneAt(position.X) - X only
  Confirmed:  mouse1press / mouse1click / mousemoveabs / firetouchinterest / keypress all
              exist and do not error when called
  Confirmed:  Shared.Config: Lanes 4, ApproachTime 1.5, LeadIn 2.4, DefaultKeys D F J K
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  Confirmed:  keypress(0x44) produced 0 InputBegan events while isrbxactive() was false
  Confirmed:  a freshly spawned tile reads y = 364 and does not move until a song runs
  UNVERIFIED: a tile is created exactly ApproachTime before its judged moment
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v1.2'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----

-- mode: 1 = touch (firetouchinterest), 2 = mouse click, 3 = keybinds
local cfg = {
    enabled    = true,
    mode       = 1,
    offsetMs   = 0,
    approachMs = 1500,
    holdMs     = 70,
    clickYpct  = 55,
    laneX      = { 625, 792, 959, 1126 },
    laneW      = 167,
    keys       = { 0x44, 0x46, 0x4A, 0x4B },
}

-- ---- state ----

local rec          = {}
local chartVersion = nil
local presses      = 0
local touchTaps    = 0
local clicks       = 0
local keyTaps      = 0
local fails        = 0
local lastErr      = ''
local focused      = nil
local focusAt      = 0
local status       = 'waiting'
local mouseHeld    = false
local laneFlash    = {}

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

-- ---- board lookup ----

local function board()
    local ok, b = pcall(function()
        local pg = lp:FindFirstChild('PlayerGui')
        local sg = pg and pg:FindFirstChild('PianoTiles')
        return sg and sg:FindFirstChild('Board')
    end)
    if ok then return b end
    return nil
end

local function laneFrame(b, lane)
    if not b then return nil end
    local ok, f = pcall(function()
        local lanes = b:FindFirstChild('Lanes')
        if not lanes then return nil end
        return lanes:FindFirstChild('Flash' .. tostring(lane))
    end)
    if ok then return f end
    return nil
end

local function laneOf(x)
    if type(x) ~= 'number' then return nil end
    for i = 1, 4 do
        if x >= cfg.laneX[i] - 12 and x < cfg.laneX[i] + cfg.laneW + 12 then
            return i
        end
    end
    return nil
end

local function viewportH()
    local ok, vp = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    if ok and vp and type(vp.Y) == 'number' and vp.Y > 0 then return vp.Y end
    return 1080
end

local function mousePos()
    local ok, m = pcall(function() return lp:GetMouse() end)
    if not ok or not m then return nil, nil end
    local okx, x = pcall(function() return m.X end)
    local oky, y = pcall(function() return m.Y end)
    if okx and oky and type(x) == 'number' and type(y) == 'number' then
        return x, y
    end
    return nil, nil
end

local function releaseMouse()
    if not mouseHeld then return end
    mouseHeld = false
    pcall(function() mouse1release() end)
end

local function noteErr(where, err)
    fails = fails + 1
    lastErr = where .. ': ' .. tostring(err)
    status = lastErr
end

-- ---- output paths: each returns true if the call was made ----

local function tapTouch(lane)
    if type(firetouchinterest) ~= 'function' then
        noteErr('touch', 'firetouchinterest missing')
        return false
    end
    local b = board()
    local char = lp.Character
    local hrp = char and char:FindFirstChild('HumanoidRootPart')
    local frame = laneFrame(b, lane)
    if not hrp or not frame then
        noteErr('touch', 'no hrp or lane frame')
        return false
    end
    local ok1, e1 = pcall(function() firetouchinterest(hrp, frame, 0) end)
    touchTaps = touchTaps + 1
    task.delay(math.max(cfg.holdMs, 30) / 1000, function()
        pcall(function() firetouchinterest(hrp, frame, 1) end)
    end)
    if not ok1 then noteErr('touch0', e1) end
    return true
end

local function tapMouse(lane)
    local cx = cfg.laneX[lane] + math.floor(cfg.laneW / 2)
    local cy = math.floor(viewportH() * (cfg.clickYpct / 100))
    local sx, sy = mousePos()
    pcall(function() mousemoveabs(cx, cy) end)
    local ok, err = pcall(function() mouse1press() end)
    if not ok then
        noteErr('mouse1press', err)
        local okc, errc = pcall(function() mouse1click() end)
        if not okc then
            noteErr('mouse1click', errc)
            return false
        end
        clicks = clicks + 1
        if sx then task.delay(0.02, function() pcall(function() mousemoveabs(sx, sy) end) end) end
        return true
    end
    mouseHeld = true
    clicks = clicks + 1
    task.delay(math.max(cfg.holdMs, 20) / 1000, function()
        releaseMouse()
        if sx then task.delay(0.02, function() pcall(function() mousemoveabs(sx, sy) end) end) end
    end)
    return true
end

local function tapKey(lane)
    local vk = cfg.keys[lane]
    if not vk or type(keypress) ~= 'function' then
        noteErr('key', 'keypress missing')
        return false
    end
    local ok, err = pcall(function() keypress(vk) end)
    if not ok then
        noteErr('keypress', err)
        return false
    end
    keyTaps = keyTaps + 1
    task.delay(math.max(cfg.holdMs, 15) / 1000, function()
        pcall(function() keyrelease(vk) end)
    end)
    return true
end

local function tap(lane)
    if not lane then return false end
    presses = presses + 1
    laneFlash[lane] = os.clock()
    if cfg.mode == 1 then
        return tapTouch(lane)
    elseif cfg.mode == 2 then
        return tapMouse(lane)
    end
    return tapKey(lane)
end

-- ---- per-frame work ----

local function refreshFocus(now)
    if now - focusAt < 0.25 then return end
    focusAt = now
    if type(isrbxactive) ~= 'function' then
        focused = nil
        return
    end
    local ok, act = pcall(isrbxactive)
    focused = (ok and act == true) and true or false
end

local function step()
    if not running then return end
    local b = board()
    if not b then
        status = 'no board'
        return
    end
    local holder = b:FindFirstChild('Tiles')
    if not holder then
        status = 'no tile holder'
        return
    end

    local now = os.clock()
    refreshFocus(now)

    local list = holder:GetChildren()
    local seen = {}

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos then
                seen[addr] = true
                local r = rec[addr]
                if not r then
                    local okV, cv = pcall(function() return t:GetAttribute('ChartVersion') end)
                    if okV and cv ~= nil then chartVersion = cv end
                    r = { spawn = now, done = false }
                    r.lane = laneOf(pos.X)
                    r.y0 = pos.Y
                    rec[addr] = r
                end
                if not r.lane then r.lane = laneOf(pos.X) end
                if cfg.enabled and not r.done and r.lane then
                    local due = r.spawn + (cfg.approachMs + cfg.offsetMs) / 1000
                    if now >= due then
                        r.done = true
                        tap(r.lane)
                    end
                end
            end
        end
    end

    for addr in pairs(rec) do
        if not seen[addr] then rec[addr] = nil end
    end

    if not cfg.enabled then
        status = 'off'
    elseif fails > 0 then
        status = 'tap failed - see lastErr'
    else
        local modeName = (cfg.mode == 1 and 'touch') or (cfg.mode == 2 and 'mouse') or 'keys'
        status = string.format('%s | %d taps (T%d C%d K%d) | chart %s | fails %d',
            modeName, presses, touchTaps, clicks, keyTaps, tostring(chartVersion), fails)
    end
end

-- ---- hud ----

local hud = nil
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
    hud.Text = '[' .. NAME .. '] starting'
end)

local hudLast = ''
local function drawHud()
    if not hud then return end
    local txt = string.format('[%s] %s | focus %s', NAME, status, tostring(focused))
    if txt ~= hudLast then
        hud.Text = txt
        hudLast = txt
    end
    hud.Visible = true
end

-- ---- renderer ----

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(drawHud)
    end))
end)
if not okRender then
    log('RenderStepped connect failed')
end

-- ---- menu helpers ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    log('button failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', cfg.enabled, function(v)
                    cfg.enabled = v
                    if not v then releaseMouse() end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)

                mkToggle(sec, 'Use touch (off = mouse click)', 'pa_touch', cfg.mode == 1, function(v)
                    cfg.mode = v and 1 or 2
                    log('mode ' .. (v and 'touch' or 'mouse click'))
                end)

                mkSlider(sec, 'Offset ms (- = earlier)', 'pa_off', -400, 400, cfg.offsetMs, function(v)
                    cfg.offsetMs = v
                end)

                mkSlider(sec, 'Approach ms', 'pa_app', 300, 3000, cfg.approachMs, function(v)
                    cfg.approachMs = v
                end)

                mkSlider(sec, 'Press hold ms', 'pa_hold', 20, 400, cfg.holdMs, function(v)
                    cfg.holdMs = v
                end)

                mkSlider(sec, 'Click Y % of screen', 'pa_cy', 10, 95, cfg.clickYpct, function(v)
                    cfg.clickYpct = v
                end)

                mkButton(sec, 'Test touch lane 1', function()
                    log('test touch lane 1')
                    tap(1)
                end)

                mkButton(sec, 'Test click lane 1', function()
                    log('test click lane 1')
                    local was = cfg.mode
                    cfg.mode = 2
                    tapMouse(1)
                    cfg.mode = was
                end)

                mkButton(sec, 'Test key lane 1', function()
                    log('test key lane 1')
                    tapKey(1)
                end)

                mkButton(sec, 'Print status', function()
                    log(string.format('presses=%d touch=%d clicks=%d keys=%d fails=%d chart=%s focus=%s mode=%d offset=%d approach=%d hold=%d',
                        presses, touchTaps, clicks, keyTaps, fails, tostring(chartVersion),
                        tostring(focused), cfg.mode, cfg.offsetMs, cfg.approachMs, cfg.holdMs))
                    if lastErr ~= '' then log('lastErr: ' .. lastErr) end
                end)

                mkButton(sec, 'Reset timing', function()
                    rec = {}
                    chartVersion = nil
                    presses = 0
                    touchTaps = 0
                    clicks = 0
                    keyTaps = 0
                    fails = 0
                    lastErr = ''
                    log('timing reset')
                end)

                mkButton(sec, 'Stop script', function()
                    if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab widgets built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseMouse()
    for i = 1, #cfg.keys do
        pcall(function() keyrelease(cfg.keys[i]) end)
    end
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then
        pcall(function() UI.RemoveTab('Piano Auto') end)
    end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - mode touch, offset ' .. tostring(cfg.offsetMs) .. ' ms')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
