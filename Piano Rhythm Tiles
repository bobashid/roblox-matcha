--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.1
  Features:   auto play - one toggle plus one Fire Y slider; lane positions are LEARNED
              from the tiles themselves instead of hardcoded pixels
  Controls:   menu tab "Piano Auto" - one toggle, one slider, one diagnostic button
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Why v2.1 exists (lane was still wrong after v2.0):
    v2.0 fixed an overlapping-range bug in laneOf, but the lane LEFT EDGES were
    hardcoded as 625 / 792 / 959 / 1127. This game lets the player change board
    width (PianoClient calls Layout.setWidthMultiplier(profile.settings.boardWidth)),
    and Board.resize() recomputes lane positions from that multiplier. So on any
    account with boardWidth ~= 1 the hardcoded pixels are simply the wrong lanes,
    no matter how correct the lookup is.
    v2.1 therefore reads the four lane X positions from the tiles at runtime:
    four distinct rounded X values = the four lanes, sorted left to right.

  Confirmed:  tiles only ever sit at four distinct X values (observed 630, 798,
              965, 1133) so lane discovery from tile X is sound
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  idle tiles park at y = 1104, just BELOW the board (bottom ~1076)
  Confirmed:  FIRE_Y = 950 lands hits; y >= 1034 was LATE
  Confirmed:  keypress / keyrelease / isrbxactive / setrobloxinput all exist
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: lane order left-to-right maps to D F J K (Shared.Config.DefaultKeys)
  UNVERIFIED: sustaining the key while the tile persists is enough for holds

  SLIDER:  LOWER Fire Y = fires EARLIER   |   HIGHER Fire Y = fires LATER
  HUD:     "lanes 630/798/965/1133" are the learned columns, left to right.
           "lane N xNNN key D" is the last press: lane, tile X, key sent.
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.1'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----

local FIRE_Y = 950     -- live value, the slider writes this

local CFG = {
    ARM_GAP = 100,     -- a tile must be seen this far above FIRE_Y before it can fire
    gapMs   = 30,      -- min ms between two presses in the same lane
    maxHold = 3.0,     -- safety cap on one held lane, seconds
    giveUp  = 140,     -- px past FIRE_Y before an unpressed tile is abandoned
    laneTol = 8,       -- px tolerance when matching a tile X to a known lane
    keys    = { 0x44, 0x46, 0x4A, 0x4B },   -- D F J K, assigned left to right
}

-- ---- state ----

local on       = true
local recs     = {}
local laneXs   = {}      -- discovered lane X positions, ascending
local chart    = nil
local taps     = 0
local holds    = 0
local focused  = nil
local lowY     = 0
local laneAt   = { 0, 0, 0, 0 }
local down     = {}      -- lane -> { addr = tile address, since = clock }
local lastLane = 0
local lastX    = 0
local lastKey  = 0

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

-- injected input must be enabled once, or every keypress is silently dropped
if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

-- ---- lane discovery ----
-- Lanes are NOT hardcoded: this game's board width is a player setting, so the
-- pixel positions differ per account. Tiles only ever occupy four distinct X
-- values, which are the four lane columns, left to right.

local function noteLaneX(x)
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= CFG.laneTol then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then
        log('lanes learned: ' .. table.concat(laneXs, ', '))
    end
end

local function laneFromX(x)
    local best, bestD = nil, math.huge
    for i = 1, #laneXs do
        local d = math.abs(laneXs[i] - x)
        if d < bestD then best, bestD = i, d end
    end
    if best and bestD <= 70 then return best end
    return nil
end

-- ---- key output ----

local function releaseLane(lane)
    if not down[lane] then return end
    down[lane] = nil
    pcall(keyrelease, CFG.keys[lane])
end

local function releaseAll()
    for lane = 1, 4 do
        releaseLane(lane)
    end
end

local function press(lane, addr, now)
    local vk = CFG.keys[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    if down[lane] then return false end
    if now - laneAt[lane] < CFG.gapMs / 1000 then return false end
    laneAt[lane] = now
    local ok = pcall(keypress, vk)
    if not ok then return false end
    down[lane] = { addr = addr, since = now }
    taps = taps + 1
    return true
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    if not on or not focused then
        releaseAll()
    end

    local now  = os.clock()
    local list = holder:GetChildren()
    local armY = FIRE_Y - CFG.ARM_GAP

    -- new song -> forget everything, including the learned lane columns
    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart  = cv
                recs   = {}
                laneXs = {}
                taps   = 0
                holds  = 0
                releaseAll()
                log('chart ' .. tostring(chart) .. ' - learning lanes')
            end
            break
        end
    end

    local live   = {}
    local lowest = 0
    local batch  = {}

    -- pass 1: read every tile, learn lane columns, build records
    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos
                and type(pos.Y) == 'number' and type(pos.X) == 'number' then
                live[addr] = true
                noteLaneX(pos.X)

                local r = recs[addr]
                if not r then
                    r = { armed = pos.Y < armY, done = false }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < armY then r.armed = true end
                if pos.Y > lowest then lowest = pos.Y end
                batch[#batch + 1] = { addr = addr, x = pos.X, y = pos.Y, r = r }
            end
        end
    end

    lowY = lowest

    -- pass 2: fire, now that all four columns are known for this frame
    for i = 1, #batch do
        local it = batch[i]
        local r  = it.r
        if r.armed and not r.done then
            if on and focused and #laneXs >= 4 and it.y >= FIRE_Y then
                local lane = laneFromX(it.x)
                if lane then
                    if press(lane, it.addr, now) then
                        r.done = true
                        lastLane = lane
                        lastX    = it.x
                        lastKey  = CFG.keys[lane]
                    elseif it.y > FIRE_Y + CFG.giveUp then
                        r.done = true
                    end
                end
            elseif it.y > FIRE_Y + CFG.giveUp then
                r.done = true
            end
        end
    end

    -- release a lane once the tile that pressed it is gone, or the cap is hit
    for lane = 1, 4 do
        local d = down[lane]
        if d then
            local gone = not live[d.addr]
            local dur  = now - d.since
            if gone or dur > CFG.maxHold then
                if dur > 0.12 then holds = holds + 1 end
                releaseLane(lane)
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then recs[addr] = nil end
    end
end

-- ---- readout (not a control) ----

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local function hudText()
    if not hud then return end
    local lanesTxt = #laneXs > 0 and table.concat(laneXs, '/') or 'learning'
    local keyTxt = lastKey > 0 and string.char(lastKey) or '-'
    hud.Text = string.format('%s | on %s | focus %s | taps %d | holds %d | fireY %d | lanes %s | last lane %d x%d key %s | chart %s',
        VERSION, tostring(on), tostring(focused), taps, holds, math.floor(FIRE_Y),
        lanesTxt, lastLane, math.floor(lastX), keyTxt, tostring(chart))
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: one toggle + one slider + one diagnostic button ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, def, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, def, cb) end,
        function() sec:SliderInt(label, id, min, max, def, cb) end,
        function() sec:SliderInt(label, min, max, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    log('button failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseAll()
                    end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)

                mkSlider(sec, 'Fire Y (lower = earlier)', 'pa_firey', 500, 1100, math.floor(FIRE_Y), function(v)
                    FIRE_Y = math.floor(v)
                    log('fireY = ' .. tostring(FIRE_Y))
                end)

                mkButton(sec, 'Print lanes and keys', function()
                    if #laneXs == 0 then
                        log('no lanes learned yet - start a song')
                        return
                    end
                    local parts = {}
                    for i = 1, #laneXs do
                        parts[#parts + 1] = string.format('lane %d x=%d key=%s',
                            i, laneXs[i], string.char(CFG.keys[i] or 63))
                    end
                    log('learned ' .. tostring(#laneXs) .. ' lanes: ' .. table.concat(parts, ' | '))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseAll()
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - lanes learned from tiles, Fire Y ' .. tostring(FIRE_Y))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
