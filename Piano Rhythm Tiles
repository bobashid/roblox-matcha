--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.0
  Features:   auto play - one toggle plus one Fire Y slider; taps on the Y line, holds the
              lane while that tile persists, LANE MATH FIXED (was off by one to the left)
  Controls:   menu tab "Piano Auto" - one toggle, one slider
  Needs:      Matcha Pro; Roblox window focused (injected input is dropped otherwise)

  Confirmed:  lanes at x 625 / 792 / 959 / 1127, width 167, SepEnd 1292
  Confirmed:  a tile's AbsolutePosition.X is its lane's left edge + ~6
              (observed tile X values: 630, 798, 965, 1133)
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  a live chart is a 100px ladder: idx 3 y=991 ... idx 12 y=91
  Confirmed:  idle tiles park at y = 1104, just BELOW the board (bottom ~1076)
  Confirmed:  FIRE_Y = 950 lands hits; y >= 1034 was LATE
  Confirmed:  timing is now correct, but the wrong key was pressed (user report)
  Confirmed:  cause: laneOf used overlapping ranges, so 798 -> lane 1, 965 -> lane 2,
              1133 -> lane 3 - every tile one lane to the left. Fixed below.
  Confirmed:  keypress / keyrelease / isrbxactive / setrobloxinput all exist
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: sustaining the key while the tile persists is enough for hold notes

  SLIDER:  LOWER Fire Y = fires EARLIER   |   HIGHER Fire Y = fires LATER
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.0'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----

local FIRE_Y = 950     -- live value, the slider writes this

local CFG = {
    ARM_GAP = 100,     -- a tile must be seen this far above FIRE_Y before it can fire
    gapMs   = 30,      -- min ms between two presses in the same lane
    maxHold = 3.0,     -- safety cap on one held lane, seconds
    laneX   = { 625, 792, 959, 1127 },   -- lane LEFT edges, ascending
    keys    = { 0x44, 0x46, 0x4A, 0x4B }, -- D F J K, left to right
}

-- ---- state ----

local on       = true
local recs     = {}
local chart    = nil
local taps     = 0
local holds    = 0
local focused  = nil
local lowY     = 0
local laneAt   = { 0, 0, 0, 0 }
local down     = {}      -- lane -> { addr = tile address, since = clock }
local lastLane = 0
local lastX    = 0

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

-- injected input must be enabled once, or every keypress is silently dropped
if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

-- FIXED: take the HIGHEST lane whose left edge is at or below x.
-- The old version tested a wide range per lane, lanes overlapped, and the loop
-- returned the lower lane for every tile (798 -> 1, 965 -> 2, 1133 -> 3).
local function laneOf(x)
    if type(x) ~= 'number' then return nil end
    for i = 4, 1, -1 do
        if x >= CFG.laneX[i] - 12 then return i end
    end
    return 1
end

-- ---- key output ----

local function releaseLane(lane)
    if not down[lane] then return end
    down[lane] = nil
    pcall(keyrelease, CFG.keys[lane])
end

local function releaseAll()
    for lane = 1, 4 do
        releaseLane(lane)
    end
end

local function press(lane, addr, now)
    if down[lane] then return end
    if now - laneAt[lane] < CFG.gapMs / 1000 then return end
    local vk = CFG.keys[lane]
    if not vk or type(keypress) ~= 'function' then return end
    laneAt[lane] = now
    pcall(keypress, vk)
    down[lane] = { addr = addr, since = now }
    taps = taps + 1
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    if not on or not focused then
        releaseAll()
    end

    local now  = os.clock()
    local list = holder:GetChildren()
    local armY = FIRE_Y - CFG.ARM_GAP

    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart = cv
                recs  = {}
                taps  = 0
                holds = 0
                releaseAll()
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live   = {}
    local lowest = 0

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos and type(pos.Y) == 'number' then
                live[addr] = true

                local r = recs[addr]
                if not r then
                    r = { lane = laneOf(pos.X), armed = pos.Y < armY, done = false }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < armY then r.armed = true end
                if not r.lane then r.lane = laneOf(pos.X) end

                if pos.Y > lowest then lowest = pos.Y end

                if on and focused and r.armed and not r.done and r.lane
                    and pos.Y >= FIRE_Y then
                    r.done = true
                    lastLane = r.lane
                    lastX    = pos.X
                    press(r.lane, addr, now)
                end
            end
        end
    end

    lowY = lowest

    -- release a lane once the tile that pressed it is gone, or the cap is hit
    for lane = 1, 4 do
        local d = down[lane]
        if d then
            local gone = not live[d.addr]
            local dur  = now - d.since
            if gone or dur > CFG.maxHold then
                if dur > 0.12 then holds = holds + 1 end
                releaseLane(lane)
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then recs[addr] = nil end
    end
end

-- ---- readout (not a control) ----

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local function hudText()
    if not hud then return end
    hud.Text = string.format('%s | on %s | focus %s | taps %d | holds %d | fireY %d | lane %d @ x %d | chart %s',
        VERSION, tostring(on), tostring(focused), taps, holds, math.floor(FIRE_Y),
        lastLane, math.floor(lastX), tostring(chart))
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: one toggle + one slider ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, def, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, def, cb) end,
        function() sec:SliderInt(label, id, min, max, def, cb) end,
        function() sec:SliderInt(label, min, max, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseAll()
                    end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)

                mkSlider(sec, 'Fire Y (lower = earlier)', 'pa_firey', 500, 1100, math.floor(FIRE_Y), function(v)
                    FIRE_Y = math.floor(v)
                    log('fireY = ' .. tostring(FIRE_Y))
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseAll()
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - lane math fixed, Fire Y ' .. tostring(FIRE_Y))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
