--[[
  Game:       Piano Rhythm Tiles
  Place IDs:  101999883467300
  Version:    v2.2
  Features:   auto play - one toggle plus one Fire Y slider; lane columns learned from the
              tiles, lane->key order learned from the game's own key labels when it can be
              found, plus a one-button key-order test
  Controls:   menu tab "Piano Auto" - one toggle, one slider, two diagnostic buttons

  Why v2.2 exists (lane still wrong after v2.1):
    v2.1 learned the four lane X columns from the tiles, so the column is right. The
    remaining unknown is which KEY the game maps to each column. The client builds that
    map from the saved profile's key preset (Shared.Config.KeyPresets), which can be
    D F J K, A S D F, 1 2 3 4 or the arrow keys - so hardcoding D F J K is a guess.
    v2.2 therefore:
      1. tries to read the on-screen key labels and derive the order automatically;
      2. if that fails, uses D F J K but gives a "Test key order" button so the user can
         press D,F,J,K in sequence, watch which column flashes, and tell us the order.

  Confirmed:  Client.Input maps KeyCode -> lane with v_u_8[KeyCode] built from the key
              preset, so the key per lane is profile data, not a constant
  Confirmed:  Client.Input also accepts a mouse click / touch, resolving the lane from
              Board.laneAt(position.X) - the game's own X math
  Confirmed:  tiles sit at four distinct X values (observed 630 / 798 / 965 / 1133)
  Confirmed:  tiles fall DOWNWARD - Y increases toward the bottom
  Confirmed:  idle tiles park at y = 1104, just BELOW the board (bottom ~1076)
  Confirmed:  FIRE_Y = 950 lands hits; y >= 1034 was LATE
  Confirmed:  keypress / keyrelease / mousemoveabs / mouse1press / mouse1release exist
  Confirmed:  RunService.PreRender is nil in this build; RenderStepped works
  UNVERIFIED: which key the game assigns to each column on this account
  UNVERIFIED: sustaining the key while the tile persists is enough for holds
]]

local NAME    = 'PianoAutoPlay'
local VERSION = 'v2.2'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

-- ---- config ----

local FIRE_Y = 950

local CFG = {
    ARM_GAP   = 100,
    gapMs     = 30,
    maxHold   = 3.0,
    giveUp    = 140,
    laneTol   = 8,
    defaultKeys = { 0x44, 0x46, 0x4A, 0x4B },   -- D F J K, fallback only
}

-- ---- state ----

local on       = true
local recs     = {}
local laneXs   = {}
local keys     = { 0x44, 0x46, 0x4A, 0x4B }
local orderAuto = false
local chart    = nil
local taps     = 0
local holds    = 0
local focused  = nil
local lowY     = 0
local laneAt   = { 0, 0, 0, 0 }
local down     = {}
local lastLane = 0
local lastX    = 0
local lastKey  = 0

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

if type(setrobloxinput) == 'function' then
    pcall(setrobloxinput, true)
end

-- ---- key order discovery ----
-- The game shows the four lane keys as single-character TextLabels somewhere in the
-- PianoTiles ScreenGui. If they can be read, sort them by X and use that order.

local LETTERS = {}
for c = 65, 90 do LETTERS[string.char(c)] = c end
for c = 48, 57 do LETTERS[string.char(c)] = c end
LETTERS[' '] = 0x20

local function scanKeyLabels()
    local sg = lp:FindFirstChild('PlayerGui')
    sg = sg and sg:FindFirstChild('PianoTiles')
    if not sg then return false end
    local found = {}
    local okD, list = pcall(function() return sg:GetDescendants() end)
    if not okD or not list then return false end
    for i = 1, #list do
        local d = list[i]
        local okC, cls = pcall(function() return d.ClassName end)
        if okC and cls == 'TextLabel' then
            local okT, txt = pcall(function() return d.Text end)
            if okT and type(txt) == 'string' then
                local up = string.upper(txt)
                if #up == 1 and LETTERS[up] then
                    local okP, p = pcall(function() return d.AbsolutePosition end)
                    if okP and p and type(p.X) == 'number' then
                        found[#found + 1] = { x = p.X, vk = LETTERS[up] }
                    end
                end
            end
        end
    end
    if #found ~= 4 then return false end
    table.sort(found, function(a, b) return a.x < b.x end)
    local out = {}
    for i = 1, 4 do
        out[i] = found[i].vk
    end
    keys = out
    orderAuto = true
    local names = {}
    for i = 1, 4 do names[i] = string.char(out[i]) end
    log('key order learned from labels: ' .. table.concat(names, ' '))
    return true
end

-- ---- lane discovery ----

local function noteLaneX(x)
    local rx = math.floor(x + 0.5)
    for i = 1, #laneXs do
        if math.abs(laneXs[i] - rx) <= CFG.laneTol then return end
    end
    if #laneXs >= 4 then return end
    laneXs[#laneXs + 1] = rx
    table.sort(laneXs)
    if #laneXs == 4 then
        log('lanes learned: ' .. table.concat(laneXs, ', '))
    end
end

local function laneFromX(x)
    local best, bestD = nil, math.huge
    for i = 1, #laneXs do
        local d = math.abs(laneXs[i] - x)
        if d < bestD then best, bestD = i, d end
    end
    if best and bestD <= 70 then return best end
    return nil
end

-- ---- key output ----

local function releaseLane(lane)
    if not down[lane] then return end
    down[lane] = nil
    pcall(keyrelease, keys[lane])
end

local function releaseAll()
    for lane = 1, 4 do
        releaseLane(lane)
    end
end

local function press(lane, addr, now)
    local vk = keys[lane]
    if not vk or type(keypress) ~= 'function' then return false end
    if down[lane] then return false end
    if now - laneAt[lane] < CFG.gapMs / 1000 then return false end
    laneAt[lane] = now
    local ok = pcall(keypress, vk)
    if not ok then return false end
    down[lane] = { addr = addr, since = now }
    taps = taps + 1
    return true
end

local function tiles()
    local pg = lp:FindFirstChild('PlayerGui')
    local sg = pg and pg:FindFirstChild('PianoTiles')
    local bd = sg and sg:FindFirstChild('Board')
    if not bd then return nil end
    return bd:FindFirstChild('Tiles')
end

-- ---- per frame ----

local function step()
    if not running then return end

    local holder = tiles()
    if not holder then return end

    if type(isrbxactive) == 'function' then
        local ok, act = pcall(isrbxactive)
        focused = (ok and act == true) or false
    else
        focused = true
    end

    if not on or not focused then
        releaseAll()
    end

    local now  = os.clock()
    local list = holder:GetChildren()
    local armY = FIRE_Y - CFG.ARM_GAP

    for i = 1, #list do
        if list[i].Name == 'Tile' then
            local okC, cv = pcall(function() return list[i]:GetAttribute('ChartVersion') end)
            if okC and cv ~= nil and cv ~= chart then
                chart  = cv
                recs   = {}
                laneXs = {}
                taps   = 0
                holds  = 0
                releaseAll()
                if not orderAuto then scanKeyLabels() end
                log('chart ' .. tostring(chart))
            end
            break
        end
    end

    local live   = {}
    local lowest = 0
    local batch  = {}

    for i = 1, #list do
        local t = list[i]
        if t.Name == 'Tile' then
            local okA, addr = pcall(function() return t.Address end)
            local okP, pos  = pcall(function() return t.AbsolutePosition end)
            if okA and addr and okP and pos
                and type(pos.Y) == 'number' and type(pos.X) == 'number' then
                live[addr] = true
                noteLaneX(pos.X)

                local r = recs[addr]
                if not r then
                    r = { armed = pos.Y < armY, done = false }
                    recs[addr] = r
                end
                if not r.armed and pos.Y < armY then r.armed = true end
                if pos.Y > lowest then lowest = pos.Y end
                batch[#batch + 1] = { addr = addr, x = pos.X, y = pos.Y, r = r }
            end
        end
    end

    lowY = lowest

    for i = 1, #batch do
        local it = batch[i]
        local r  = it.r
        if r.armed and not r.done then
            if on and focused and #laneXs >= 4 and it.y >= FIRE_Y then
                local lane = laneFromX(it.x)
                if lane then
                    if press(lane, it.addr, now) then
                        r.done = true
                        lastLane = lane
                        lastX    = it.x
                        lastKey  = keys[lane]
                    elseif it.y > FIRE_Y + CFG.giveUp then
                        r.done = true
                    end
                end
            elseif it.y > FIRE_Y + CFG.giveUp then
                r.done = true
            end
        end
    end

    for lane = 1, 4 do
        local d = down[lane]
        if d then
            local gone = not live[d.addr]
            local dur  = now - d.since
            if gone or dur > CFG.maxHold then
                if dur > 0.12 then holds = holds + 1 end
                releaseLane(lane)
            end
        end
    end

    for addr in pairs(recs) do
        if not live[addr] then recs[addr] = nil end
    end
end

-- ---- readout ----

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 40)
    hud.Visible = true
end)

local function keyNames()
    local out = {}
    for i = 1, 4 do out[i] = string.char(keys[i] or 63) end
    return table.concat(out, ' ')
end

local function hudText()
    if not hud then return end
    local lanesTxt = #laneXs > 0 and table.concat(laneXs, '/') or 'learning'
    local lastTxt = lastLane > 0 and (lastLane .. ' x' .. math.floor(lastX) .. ' ' .. string.char(lastKey or 63)) or '-'
    hud.Text = string.format('%s | on %s | focus %s | taps %d | holds %d | fireY %d | lanes %s | keys %s%s | last %s | chart %s',
        VERSION, tostring(on), tostring(focused), taps, holds, math.floor(FIRE_Y),
        lanesTxt, keyNames(), orderAuto and ' (auto)' or ' (default)', lastTxt, tostring(chart))
end

local okRender = pcall(function()
    track(RunService.RenderStepped:Connect(function()
        pcall(step)
        pcall(hudText)
    end))
end)
if not okRender then log('RenderStepped connect failed') end

-- ---- menu: one toggle, one slider, two diagnostic buttons ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, def, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, def, cb) end,
        function() sec:Toggle(label, id, def, cb) end,
        function() sec:Toggle(label, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, def, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, def, cb) end,
        function() sec:SliderInt(label, id, min, max, def, cb) end,
        function() sec:SliderInt(label, min, max, def, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    log('slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    log('button failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Piano Auto', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Auto Play')
                if not sec then return end

                mkToggle(sec, 'Auto Play', 'pa_on', on, function(v)
                    on = v
                    if v then
                        if type(setrobloxinput) == 'function' then
                            pcall(setrobloxinput, true)
                        end
                    else
                        releaseAll()
                    end
                    log('auto play ' .. (v and 'ON' or 'off'))
                end)

                mkSlider(sec, 'Fire Y (lower = earlier)', 'pa_firey', 500, 1100, math.floor(FIRE_Y), function(v)
                    FIRE_Y = math.floor(v)
                    log('fireY = ' .. tostring(FIRE_Y))
                end)

                mkButton(sec, 'Rescan key labels', function()
                    orderAuto = false
                    if scanKeyLabels() then
                        log('ok - key order now ' .. keyNames())
                    else
                        log('no 4 single-letter labels found - keeping ' .. keyNames())
                    end
                end)

                mkButton(sec, 'Test key order (D F J K)', function()
                    log('pressing D, F, J, K one at a time - watch which column flashes')
                    task.spawn(function()
                        for i = 1, 4 do
                            local vk = CFG.defaultKeys[i]
                            pcall(keypress, vk)
                            task.wait(0.25)
                            pcall(keyrelease, vk)
                            task.wait(0.45)
                        end
                        log('test done - tell me the left-to-right order you saw')
                    end)
                end)
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---- stop ----

local function stop()
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    releaseAll()
    if hud then
        pcall(function() hud:Remove() end)
        hud = nil
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Piano Auto') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
log(VERSION .. ' loaded - keys ' .. keyNames() .. ', Fire Y ' .. tostring(FIRE_Y))
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Piano Auto', 3) end)
