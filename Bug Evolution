-- game:GetService can return nil in this VM, so every service is resolved
-- defensively and Workspace falls back to the global.
local function svc(n)
    for _ = 1, 4 do
        local ok, s = pcall(function() return game:GetService(n) end)
        if ok and s then return s end
    end
    local ok2, s2 = pcall(function() return game:FindFirstChild(n) end)
    if ok2 and s2 then return s2 end
    return nil
end

local Players = svc('Players')
local RS      = svc('ReplicatedStorage')
local lp      = nil
if Players then pcall(function() lp = Players.LocalPlayer end) end
if not lp then pcall(function() lp = game.Players.LocalPlayer end) end

