-- ---------------- stop ----------------
local function stop()
    running = false
    state.running = false
    CONFIG.orbFarm, CONFIG.voidFarm = false, false
    CONFIG.mobFarm, CONFIG.playerFarm = false, false
    goHome()
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if HAS_UI then pcall(function() UI.RemoveTab('Bug Evolution') end) end
    _G[NAME] = nil
    log('stopped')
end

