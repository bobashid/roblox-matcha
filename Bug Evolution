    -- hold per target, seconds
    orbHold    = 0.11,   -- measured reliable-ish; 0.10 starts dropping
    orbSlowHold= 0.44,   -- measured 100% reliable, used for repair passes
    voidHold   = 0.16,
    mobHold    = 0.12,
    playerHold = 0.12,

    orbSettle  = 0.8,
    maxPasses  = 3,
