-- helpers -------------------------------------------------------------

local function ntf(msg)
    pcall(function() notify(msg, "Bug Farm", 3) end)
end

local function getRig()
    local char = lp.Character
    if not char then return nil, nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
end

local function posOf(inst)
    if not inst then return nil end
    local ok, p = pcall(function() return inst.Position end)
    if ok and p ~= nil then return p end
    return nil
end

-- Model-safe position: prefer Hit / Core / Shimmer, else any direct part
local function partPos(inst)
    local p = posOf(inst)
    if p then return p end
    local ok, kids = pcall(function() return inst:GetChildren() end)
    if not ok or not kids then return nil end
    local order = { "Hit", "Core", "Shimmer" }
    for i = 1, #order do
        for j = 1, #kids do
            if kids[j].Name == order[i] then
                local pp = posOf(kids[j])
                if pp then return pp end
            end
        end
    end
    for j = 1, #kids do
        local pp = posOf(kids[j])
        if pp then return pp end
    end
    return nil
end

local function firstBool(...)
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        if type(v) == "boolean" then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        if type(v) == "number" then return v end
    end
    return nil
end

-- menu helpers --------------------------------------------------------

local TOGGLES, getterWorks = {}, {}

local function mkSection(tab, name)
    local sides = { "Left", "Right" }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn("[Bug Farm] section failed: " .. name)
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[Bug Farm] toggle failed: " .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
        function() sec:Slider(id, label, min, max, default, cb) end,
        function() sec:Slider(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[Bug Farm] slider failed: " .. label)
    return false
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

-- the attack remote is resolved once and reused for kill AND eat ------

local attackRemote = nil

local function getAttackRemote()
    if attackRemote then return attackRemote end
    local r = RS:FindFirstChild("Remotes")
    attackRemote = r and r:FindFirstChild("Attack")
    return attackRemote
end

local function fireAttack(model, hum)
    local rem = getAttackRemote()
    if not rem then return false end
    local ok1 = pcall(function() rem:FireServer(hum) end)
    if not ok1 then
        pcall(function() rem:FireServer(model) end)
    end
    return true
end

-- orb cycles ----------------------------------------------------------

local function collectFrom(folderName)
    local folder = workspace:FindFirstChild(folderName)
    local out = {}
    if not folder then return out end
    local hrp = getRig()
    local my = hrp and hrp.Position or Vector3.new(0, 0, 0)
    for _, c in ipairs(folder:GetChildren()) do
        local p = partPos(c)
        if p then
            out[#out + 1] = { inst = c, pos = p, dist = (p - my).Magnitude }
        end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

local function sweep(list, hold, alive)
    local n = 0
    for i = 1, #list do
        if not alive() then break end
        local e = list[i]
        if e.inst.Parent ~= nil then
            local hrp, hum = getRig()
            if hrp and (not hum or hum.Health > 0) then
                hrp.CFrame = CFrame.new(e.pos.X, e.pos.Y, e.pos.Z)
                n = n + 1
                task.wait(hold)
            else
                task.wait(0.3)
            end
        end
    end
    return n
end

local function holdOrb(e, alive)
    local t0 = os.clock()
    while e.inst.Parent ~= nil and os.clock() - t0 < CONFIG.retryHold do
        if not alive() then return false end
        local hrp, hum = getRig()
        if not hrp or (hum and hum.Health <= 0) then return false end
        local p = partPos(e.inst) or e.pos
        hrp.CFrame = CFrame.new(p.X, p.Y, p.Z)
        task.wait()
    end
    return e.inst.Parent == nil
end

local function goHome()
    if not CONFIG.returnHome or not home then return end
    local hrp = getRig()
    if hrp then hrp.CFrame = CFrame.new(home.X, home.Y, home.Z) end
end

local function orbCycle(folderName, hold, alive)
    local list = collectFrom(folderName)
    local total = #list
    if total == 0 then return 0, 0, 0 end

    sweep(list, hold, alive)
    if not alive() then return total, 0, total end
    task.wait(CONFIG.settle)

    local gone = 0
    for i = 1, total do
        if list[i].inst.Parent == nil then gone = gone + 1 end
    end

    for round = 1, CONFIG.maxRepairs do
        if not alive() then break end
        local left = {}
        for i = 1, total do
            if list[i].inst.Parent ~= nil then left[#left + 1] = list[i] end
        end
        if #left == 0 then break end
        print("[Bug Farm] repair round", round, "left:", #left)
        for i = 1, #left do
            if not alive() then break end
            if holdOrb(left[i], alive) then gone = gone + 1 end
        end
        if not alive() then break end
        task.wait(0.3)
    end

    local left = 0
    for i = 1, total do
        if list[i].inst.Parent == nil then left = left + 1 end
    end
    return total, gone, left
end

local function mobActive()
    return flags.mobs or flags.players
end

-- orb worker ----------------------------------------------------------

task.spawn(function()
    local prevOrbs, prevVoid = false, false
    local voidIdleLogged = false

    while running do
        if flags.orbs and not prevOrbs then
            armed.orbs = true
            print("[Bug Farm] orbs armed")
        end
        if flags.voidorbs and not prevVoid then
            print("[Bug Farm] void orb loop on")
            ntf("Void orb loop on - X to stop")
        end
        if prevVoid and not flags.voidorbs then
            if not (flags.orbs or mobActive()) then pcall(goHome) end
        end
        prevOrbs, prevVoid = flags.orbs, flags.voidorbs

        if mobActive() then
            task.wait(0.2)

        elseif flags.voidorbs then
            local hrp = getRig()
            if not home and hrp then home = hrp.Position end
            local alive = function() return running and flags.voidorbs end
            local total, gone, left = orbCycle("VoidOrbs", CONFIG.voidHold, alive)
            if total == 0 then
                if not voidIdleLogged then
                    print("[Bug Farm] no void orbs right now - waiting")
                    voidIdleLogged = true
                end
                task.wait(CONFIG.voidIdle)
            else
                voidIdleLogged = false
                print("[Bug Farm] void cycle:", gone, "/", total, "left", left)
                task.wait(0.2)
            end

        elseif flags.orbs and armed.orbs then
            armed.orbs = false
            local hrp = getRig()
            if not home and hrp then home = hrp.Position end
            local alive = function() return running and flags.orbs end
            local total, gone, left = orbCycle("Orbs", CONFIG.orbHold, alive)

            if flags.orbs then
                print("[Bug Farm] orb pass:", gone, "/", total, "left", left)
                ntf("Orbs: " .. gone .. "/" .. total)
                flags.orbs = false
                orbsLatch = true
                if HAS_UI then pcall(function() UI.SetValue("be_orbs", false) end) end
                if not flags.voidorbs then pcall(goHome) end
            else
                print("[Bug Farm] orb pass cancelled:", gone, "/", total)
                if not flags.voidorbs then pcall(goHome) end
            end

        else
            task.wait(0.2)
        end
    end
end)

-- mob targets ---------------------------------------------------------

local function isPlayerModel(m)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp then
            local ch = nil
            pcall(function() ch = pl.Character end)
            if ch == m or m.Name == pl.Name then return true end
        end
    end
    return false
end

local function addCorpse(model, hum)
    for i = 1, #corpses do
        if corpses[i].model == model then return end
    end
    corpses[#corpses + 1] = { model = model, hum = hum, born = os.clock() }
end

local function consider(m, list, my)
    if not m or m == lp.Character then return end
    local h = m:FindFirstChild("Humanoid")
    if not h then return end
    local hp = 1
    local okh, hv = pcall(function() return h.Health end)
    if okh and type(hv) == "number" then hp = hv end
    if hp <= 0 then
        if flags.eat then addCorpse(m, h) end
        return
    end
    local r = m:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local p = posOf(r)
    if not p then return end
    local d = (p - my).Magnitude
    if d > CONFIG.maxRange then return end
    list[#list + 1] = { model = m, hum = h, root = r, dist = d, isPlayer = isPlayerModel(m) }
end

local function scanTargets()
    local hrp = getRig()
    local my = hrp and hrp.Position or Vector3.new(0, 0, 0)
    local list = {}

    local bugs = workspace:FindFirstChild("Bugs")
    if bugs then
        for _, c in ipairs(bugs:GetChildren()) do
            if c.ClassName == "Model" then consider(c, list, my) end
        end
    end
    for _, c in ipairs(workspace:GetChildren()) do
        if c.ClassName == "Model" then
            consider(c, list, my)
        elseif c.ClassName == "Folder" and c ~= bugs then
            for _, cc in ipairs(c:GetChildren()) do
                if cc.ClassName == "Model" then consider(cc, list, my) end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function pickTarget(list)
    for i = 1, #list do
        local t = list[i]
        if t.isPlayer then
            if flags.players then return t end
        elseif flags.mobs then
            return t
        end
    end
    return nil
end

-- anchor --------------------------------------------------------------

local function targetY(p)
    if CFG.below then return p.Y - CFG.dist end
    return p.Y + CFG.dist
end

local function anchorStep()
    if not mobActive() then return end
    local t = target
    if not t then return end
    local hrp = getRig()
    if not hrp then return end
    local p = posOf(t.root)
    if not p then return end

    hrp.CFrame = CFrame.new(p.X, targetY(p), p.Z)

    if flags.freeze then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
    end
end

do
    local connected = false
    if RunService then
        if RunService.RenderStepped then
            local ok, c = pcall(function() return RunService.RenderStepped:Connect(anchorStep) end)
            if ok and c then anchorConn = c connected = true end
        end
        if not connected and RunService.Heartbeat then
            local ok, c = pcall(function() return RunService.Heartbeat:Connect(anchorStep) end)
            if ok and c then anchorConn = c connected = true end
        end
    end
    if not connected then
        print("[Bug Farm] no RenderStepped/Heartbeat - using a task loop")
        task.spawn(function()
            while running do
                pcall(anchorStep)
                task.wait()
            end
        end)
    end
end

-- kill: attack always on while the mob farm runs ---------------------

local function attackTarget(t)
    local hum = t.hum
    if not hum or not hum.Parent then return end

    local hp = nil
    local okh, hv = pcall(function() return hum.Health end)
    if okh and type(hv) == "number" then hp = hv end

    if hp ~= nil and hp <= 0 then
        if flags.eat then addCorpse(t.model, hum) end
        return
    end

    fireAttack(t.model, hum)
end

-- eat: same remote, fired at the body ---------------------------------

local function eatBodies()
    local now = os.clock()
    local i = 1
    while i <= #corpses do
        local c = corpses[i]
        local dead = c.model == nil or c.model.Parent == nil
        local expired = (now - c.born) > CONFIG.corpseLife
        if dead or expired then
            table.remove(corpses, i)
        else
            fireAttack(c.model, c.hum)
            i = i + 1
        end
    end
end

-- scan loop -----------------------------------------------------------

task.spawn(function()
    while running do
        if mobActive() then
            local now = os.clock()
            if now - lastScan >= CONFIG.rescan or target == nil then
                target = pickTarget(scanTargets())
                lastScan = now
            end
            if target and (target.root.Parent == nil or target.hum.Parent == nil) then
                target = nil
            end
            if target and now - lastAttack >= CONFIG.attackEvery then
                lastAttack = now
                attackTarget(target)
            end
        else
            target = nil
        end
        task.wait(0.1)
    end
end)

task.spawn(function()
    while running do
        if flags.eat then
            if os.clock() - lastEat >= CONFIG.eatEvery then
                lastEat = os.clock()
                pcall(eatBodies)
            end
        else
            corpses = {}
        end
        task.wait(0.05)
    end
end)

-- getter poller with the orbs latch -----------------------------------

task.spawn(function()
    while running do
        if HAS_UI then
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == "boolean" then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == "boolean" then val = v2 end
                end
                if val ~= nil then
                    if t.key == "orbs" and orbsLatch then
                        if val == false then orbsLatch = false end
                    else
                        getterWorks[t.key] = true
                        if flags[t.key] ~= val then
                            flags[t.key] = val
                            print("[Bug Farm] " .. t.key .. " = " .. tostring(val))
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

-- stop key ------------------------------------------------------------

task.spawn(function()
    local wasDown = false
    while running do
        local down = false
        pcall(function() down = iskeypressed(CONFIG.stopKey) end)
        if down and not wasDown then
            running = false
            flags.mobs, flags.players = false, false
            flags.orbs, flags.voidorbs = false, false
            corpses = {}
            pcall(goHome)
            pcall(function() notify("Bug farm stopped", "Bug Farm", 2) end)
            print("[Bug Farm] stopped")
        end
        wasDown = down
        task.wait(0.1)
    end
end)

-- menu ----------------------------------------------------------------

local function setFlag(key)
    return function(v)
        if key == "orbs" and orbsLatch then
            if v == false then orbsLatch = false end
            return
        end
        if getterWorks[key] then return end
        flags[key] = v
        print("[Bug Farm] " .. key .. " = " .. tostring(v))
    end
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local orbSec = mkSection(tab, "Orbs")
        if orbSec then
            mkToggle(orbSec, "Orbs", "be_orbs", false, setFlag("orbs"))
            registerToggle("orbs", "be_orbs", "Orbs")
            mkToggle(orbSec, "Void Orbs (loop)", "be_voidorbs", false, setFlag("voidorbs"))
            registerToggle("voidorbs", "be_voidorbs", "Void Orbs (loop)")
            pcall(function() orbSec:Text("Orbs: one pass, then switches itself off.") end)
            pcall(function() orbSec:Text("Void orbs: repeats until switched off.") end)
        end

        local mobSec = mkSection(tab, "Mob Farm")
        if mobSec then
            mkToggle(mobSec, "Farm Mobs", "be_mobs", false, setFlag("mobs"))
            registerToggle("mobs", "be_mobs", "Farm Mobs")
            mkToggle(mobSec, "Farm Players", "be_players", false, setFlag("players"))
            registerToggle("players", "be_players", "Farm Players")

            mkSlider(mobSec, "Y Distance", "be_dist", 0, CONFIG.yMax, CFG.dist, function(v)
                CFG.dist = v
                print("[Bug Farm] yDist = " .. tostring(v))
            end)
            mkToggle(mobSec, "Below Target", "be_below", true, function(v)
                CFG.below = v
                print("[Bug Farm] below = " .. tostring(v))
            end)
            mkToggle(mobSec, "Freeze Velocity", "be_freeze", true, setFlag("freeze"))
            registerToggle("freeze", "be_freeze", "Freeze Velocity")
            pcall(function() mobSec:Text("Distance 0-15, side picks below/above.") end)
            pcall(function() mobSec:Text("Attack + eat always on with farm.") end)
        end

        local eatSec = mkSection(tab, "Kill / Eat")
        if eatSec then
            mkToggle(eatSec, "Eat Bodies", "be_eat", true, setFlag("eat"))
            registerToggle("eat", "be_eat", "Eat Bodies")
            pcall(function() eatSec:Text("Same remote as attack, fired at the body.") end)
        end

        local misc = mkSection(tab, "Misc")
        if misc then
            pcall(function() misc:Text("X = stop everything") end)
        end
    end)
    if not ok then warn("[Bug Farm] build error: " .. tostring(err)) end
    print("[Bug Farm] tab widgets built")
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab("Bug Farm", function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then warn("[Bug Farm] UI.AddTab failed: " .. tostring(err)) end
else
    print("[Bug Farm] no UI in this build - defaults only")
end

-- stop ----------------------------------------------------------------

local function stop()
    running = false
    flags.mobs, flags.players = false, false
    flags.orbs, flags.voidorbs = false, false
    corpses = {}
    if anchorConn then pcall(function() anchorConn:Disconnect() end) end
    pcall(goHome)
    if HAS_UI then pcall(function() UI.RemoveTab("Bug Farm") end) end
    _G[NAME] = nil
    print("[Bug Farm] stopped")
end

_G[NAME] = { stop = stop, version = VERSION }

print("[Bug Farm] v" .. VERSION .. " loaded - X to stop")
