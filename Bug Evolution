local UI_TOGGLES = {}

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

-- id first (the confirmed live order), then the two older ladders
local function mkToggle(sec, id, label, default, cb)
    if not sec then return nil end
    local ok, w = pcall(function() return sec:Toggle(id, label, default, cb) end)
    if ok and w ~= nil then return w end
    ok, w = pcall(function() return sec:Toggle(label, id, default, cb) end)
    if ok and w ~= nil then return w end
    ok, w = pcall(function() return sec:Toggle(label, default, cb) end)
    if ok and w ~= nil then return w end
    return nil
end

local function mkButton(sec, label, cb)
    if not sec then return end
    if pcall(function() sec:Button(label, cb) end) then return end
    pcall(function() sec:Button(label, label, cb) end)
end

local function mkSlider(sec, id, label, min, max, default, cb)
    if not sec then return end
    if pcall(function() sec:SliderInt(id, label, min, max, default, cb) end) then return end
    if pcall(function() sec:SliderInt(label, id, min, max, default, cb) end) then return end
    pcall(function() sec:SliderInt(label, min, max, default, cb) end)
end

