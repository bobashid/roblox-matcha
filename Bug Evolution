-- poller: the widget getter is authoritative once it answers
local function getBool(id, label)
    if not HAS_UI then return nil end
    local ok, v = pcall(function() return UI.GetValue(id) end)
    if ok and type(v) == 'boolean' then return v end
    ok, v = pcall(function() return UI.GetValue(label) end)
    if ok and type(v) == 'boolean' then return v end
    return nil
end

