--[[
  Game:       Bug Evolution
  Place IDs:  70650894743738
  Version:    v4.7
  Features:   orb + void orb run together under one arbiter, void first;
              orb pass is resumable (one orb per tick) so a void orb can cut
              in and the pass continues; mob/player farm resumes when idle;
              Y distance 0-15 + below/above; kill + eat via attack remote,
              both always on
  Controls:   menu tab "Bug Farm"; toggles/sliders only; X stops everything
  Confirmed:  VoidOrbs children are Models -> position from Hit/Core part
              Humanoid.Health / MaxHealth not writable, TakeDamage nil
              AssemblyLinearVelocity / Velocity writable
              Remotes.Attack is a RemoteEvent
  UNVERIFIED: the Attack payload shape - all three shapes are fired each tick
              the arbiter priority order is a user request, not a probe
]]

local VERSION = "4.7"
local NAME    = "BugEvoFarm"
if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print("[Bug Farm] v" .. VERSION)

local Players    = game:GetService("Players")
local RS         = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local lp         = Players.LocalPlayer

local CONFIG = {
    orbHold     = 0.11,
    voidHold    = 0.35,
    settle      = 0.8,
    retryHold   = 0.5,
    maxRepairs  = 2,
    stopKey     = 0x58,
    returnHome  = true,
    rescan      = 0.35,
    maxRange    = 600,
    attackEvery = 0.15,
    corpseLife  = 8,
    voidIdle    = 0.5,
    voidWatch   = 0.30,
    voidTries   = 2,
    yMax        = 15,
}

local running    = true
local home       = nil
local target     = nil
local anchorConn = nil
local built      = false
local armedOrbs  = false
local orbsLatch  = false
local mobPaused  = false
local lastScan, lastAttack = 0, 0
local corpses    = {}
local voidTried  = setmetatable({}, { __mode = "k" })
local orbList, orbIdx, orbGone, orbRound, orbTotal = {}, 1, 0, 0, 0

local function clearOrbRun()
    orbList, orbIdx, orbGone, orbRound, orbTotal = {}, 1, 0, 0, 0
end

local flags = { orbs = false, voidorbs = false, mobs = false, players = false,
                freeze = true }
local CFG   = { dist = 8, below = true }

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

-- helpers -------------------------------------------------------------

local function ntf(msg)
    pcall(function() notify(msg, "Bug Farm", 3) end)
end

local function getRig()
    local char = lp.Character
    if not char then return nil, nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
end

local function posOf(inst)
    if not inst then return nil end
    local ok, p = pcall(function() return inst.Position end)
    if ok and p ~= nil then return p end
    return nil
end

local function partPos(inst)
    local p = posOf(inst)
    if p then return p end
    local ok, kids = pcall(function() return inst:GetChildren() end)
    if not ok or not kids then return nil end
    local order = { "Hit", "Core", "Shimmer" }
    for i = 1, #order do
        for j = 1, #kids do
            if kids[j].Name == order[i] then
                local pp = posOf(kids[j])
                if pp then return pp end
            end
        end
    end
    for j = 1, #kids do
        local pp = posOf(kids[j])
        if pp then return pp end
    end
    return nil
end

local function firstBool(...)
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        if type(v) == "boolean" then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        if type(v) == "number" then return v end
    end
    return nil
end

-- menu helpers --------------------------------------------------------

local TOGGLES, getterWorks = {}, {}

local function mkSection(tab, name)
    local sides = { "Left", "Right" }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    if not sec then return false end
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
        function() sec:Slider(id, label, min, max, default, cb) end,
        function() sec:Slider(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    return false
end

local function registerToggle(key, id)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id }
end

-- attack: always on, no toggle, all three shapes ----------------------

local remotesFolder = RS:FindFirstChild("Remotes")
local attackRem = remotesFolder and remotesFolder:FindFirstChild("Attack")

local function fireAttack(model, hum, root)
    if not attackRem then return false end
    if hum then pcall(function() attackRem:FireServer(hum) end) end
    if model then pcall(function() attackRem:FireServer(model) end) end
    if root then pcall(function() attackRem:FireServer(root) end) end
    return true
end

-- targets -------------------------------------------------------------

local function collectFrom(folderName)
    local folder = workspace:FindFirstChild(folderName)
    local out = {}
    if not folder then return out end
    local hrp = getRig()
    local my = hrp and hrp.Position or Vector3.new(0, 0, 0)
    for _, c in ipairs(folder:GetChildren()) do
        local p = partPos(c)
        if p then
            out[#out + 1] = { inst = c, pos = p, dist = (p - my).Magnitude }
        end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

local function nextVoid()
    local list = collectFrom("VoidOrbs")
    for i = 1, #list do
        local e = list[i]
        if (voidTried[e.inst] or 0) < CONFIG.voidTries then return e end
    end
    return nil
end

local function goHome()
    if not CONFIG.returnHome or not home then return end
    local hrp = getRig()
    if hrp then hrp.CFrame = CFrame.new(home.X, home.Y, home.Z) end
end

local function mobActive()
    return flags.mobs or flags.players
end

-- body arbiter: VOID > ORBS > MOBS, one owner per tick ----------------

task.spawn(function()
    local prevOrbs = false
    local voidIdleLogged = false

    while running do
        if flags.orbs and not prevOrbs then
            clearOrbRun()
            orbList = collectFrom("Orbs")
            orbTotal = #orbList
            armedOrbs = (orbTotal > 0)
            print("[Bug Farm] orbs armed:", orbTotal)
        end
        if not flags.orbs then armedOrbs = false end
        prevOrbs = flags.orbs

        local ran = false

        -- 1. void orbs outrank everything, including a pass in flight
        if flags.voidorbs then
            local e = nextVoid()
            if e then
                mobPaused = true
                local hrp = getRig()
                if hrp then hrp.CFrame = CFrame.new(e.pos.X, e.pos.Y, e.pos.Z) end
                task.wait(CONFIG.voidHold)
                if e.inst.Parent ~= nil then
                    local p = partPos(e.inst) or e.pos
                    local h2 = getRig()
                    if h2 then h2.CFrame = CFrame.new(p.X, p.Y, p.Z) end
                    task.wait(CONFIG.retryHold)
                end
                voidTried[e.inst] = (voidTried[e.inst] or 0) + 1
                print("[Bug Farm] void priority:",
                      e.inst.Parent == nil and "grabbed" or "missed",
                      "tries", voidTried[e.inst])
                voidIdleLogged = false
                ran = true
            elseif not voidIdleLogged and not armedOrbs and not mobActive() then
                print("[Bug Farm] no void orbs right now - waiting")
                voidIdleLogged = true
            end
        end

        -- 2. one orb per tick from the standing pass, then repair rounds
        if not ran and armedOrbs then
            if orbIdx > #orbList then
                if orbRound >= CONFIG.maxRepairs then
                    print("[Bug Farm] orbs done:", orbGone, "/", orbTotal)
                    ntf("Orbs: " .. orbGone .. "/" .. orbTotal)
                    armedOrbs = false
                    flags.orbs = false
                    orbsLatch = true
                    if HAS_UI then pcall(function() UI.SetValue("be_orbs", false) end) end
                    clearOrbRun()
                    if not flags.voidorbs and not mobActive() then pcall(goHome) end
                else
                    orbRound = orbRound + 1
                    task.wait(CONFIG.settle)
                    local left = {}
                    for i = 1, #orbList do
                        if orbList[i].inst.Parent ~= nil then left[#left + 1] = orbList[i] end
                    end
                    orbList, orbIdx = left, 1
                    print("[Bug Farm] repair round", orbRound, "left:", #left)
                    if #left == 0 then
                        print("[Bug Farm] orbs done:", orbGone, "/", orbTotal)
                        ntf("Orbs: " .. orbGone .. "/" .. orbTotal)
                        armedOrbs = false
                        flags.orbs = false
                        orbsLatch = true
                        if HAS_UI then pcall(function() UI.SetValue("be_orbs", false) end) end
                        clearOrbRun()
                        if not flags.voidorbs and not mobActive() then pcall(goHome) end
                    end
                end
            else
                local e = orbList[orbIdx]
                orbIdx = orbIdx + 1
                if e.inst.Parent ~= nil then
                    mobPaused = true
                    local hrp, hum = getRig()
                    if hrp and (not hum or hum.Health > 0) then
                        hrp.CFrame = CFrame.new(e.pos.X, e.pos.Y, e.pos.Z)
                        task.wait(CONFIG.orbHold)
                        if e.inst.Parent == nil then orbGone = orbGone + 1 end
                    end
                else
                    orbGone = orbGone + 1
                end
                ran = true
            end
        end

        -- 3. nothing pending: hand the body back to the mob farm
        if not ran and not armedOrbs and not (flags.voidorbs and nextVoid()) then
            mobPaused = false
        end
        if not ran then task.wait(0.15) end
    end
end)

-- mob scanning --------------------------------------------------------

local function isPlayerModel(m)
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp then
            local ch = nil
            pcall(function() ch = pl.Character end)
            if ch == m or m.Name == pl.Name then return true end
        end
    end
    return false
end

local function addCorpse(model, hum, root)
    for i = 1, #corpses do
        if corpses[i].model == model then return end
    end
    corpses[#corpses + 1] = { model = model, hum = hum, root = root, born = os.clock() }
end

local function consider(m, out, my)
    if not m or m == lp.Character then return end
    local hum = m:FindFirstChild("Humanoid")
    if not hum then return end
    local root = m:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local hp = 1
    local okh, hv = pcall(function() return hum.Health end)
    if okh and type(hv) == "number" then hp = hv end

    if hp <= 0 then
        addCorpse(m, hum, root)
        return
    end

    local p = posOf(root)
    if not p then return end
    local d = (p - my).Magnitude
    if d > CONFIG.maxRange then return end
    out[#out + 1] = { model = m, hum = hum, root = root, dist = d,
                      isPlayer = isPlayerModel(m) }
end

local function scanTargets()
    local hrp = getRig()
    local my = hrp and hrp.Position or Vector3.new(0, 0, 0)
    local out = {}

    local bugs = workspace:FindFirstChild("Bugs")
    if bugs then
        for _, m in ipairs(bugs:GetChildren()) do
            if m.ClassName == "Model" then consider(m, out, my) end
        end
    end
    for _, m in ipairs(workspace:GetChildren()) do
        if m.ClassName == "Model" then consider(m, out, my) end
    end

    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end

local function pickTarget(list)
    for i = 1, #list do
        local t = list[i]
        if t.isPlayer then
            if flags.players then return t end
        elseif flags.mobs then
            return t
        end
    end
    return nil
end

-- anchor: every frame -------------------------------------------------

local function targetY(p)
    if CFG.below then return p.Y - CFG.dist end
    return p.Y + CFG.dist
end

local function anchorStep()
    if not mobActive() then return end
    if mobPaused then return end
    local t = target
    if not t then return end
    local hrp = getRig()
    if not hrp then return end
    local p = posOf(t.root)
    if not p then return end

    hrp.CFrame = CFrame.new(p.X, targetY(p), p.Z)

    if flags.freeze then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
    end
end

do
    local connected = false
    if RunService then
        if RunService.RenderStepped then
            local ok, c = pcall(function() return RunService.RenderStepped:Connect(anchorStep) end)
            if ok and c then anchorConn = c connected = true end
        end
        if not connected and RunService.Heartbeat then
            local ok, c = pcall(function() return RunService.Heartbeat:Connect(anchorStep) end)
            if ok and c then anchorConn = c connected = true end
        end
    end
    if not connected then
        print("[Bug Farm] no RenderStepped/Heartbeat - task loop instead")
        task.spawn(function()
            while running do
                pcall(anchorStep)
                task.wait()
            end
        end)
    end
end

-- main loop: target + attack (unconditional) --------------------------

task.spawn(function()
    while running do
        if mobActive() then
            local now = os.clock()

            if now - lastScan >= CONFIG.rescan or target == nil then
                target = pickTarget(scanTargets())
                lastScan = now
            end
            if target and (target.root.Parent == nil or target.hum.Parent == nil) then
                target = nil
            end

            if target and not mobPaused then
                if now - lastAttack >= CONFIG.attackEvery then
                    lastAttack = now
                    fireAttack(target.model, target.hum, target.root)
                end
                pcall(anchorStep)
            end
        else
            target = nil
        end
        task.wait(0.05)
    end
end)

-- eat: same remote, fired at the body, no toggle ----------------------

task.spawn(function()
    while running do
        if #corpses > 0 then
            local now = os.clock()
            local i = 1
            while i <= #corpses do
                local c = corpses[i]
                local gone = c.model == nil or c.model.Parent == nil
                local expired = (now - c.born) > CONFIG.corpseLife
                if gone or expired then
                    table.remove(corpses, i)
                else
                    fireAttack(c.model, c.hum, c.root)
                    i = i + 1
                end
            end
        end
        task.wait(0.25)
    end
end)

-- getter poller (with the orbs latch) ---------------------------------

task.spawn(function()
    while running do
        if HAS_UI then
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == "boolean" then val = v1 end
                if val ~= nil then
                    if t.key == "orbs" and orbsLatch then
                        if val == false then orbsLatch = false end
                    else
                        getterWorks[t.key] = true
                        if flags[t.key] ~= val then
                            flags[t.key] = val
                            print("[Bug Farm] " .. t.key .. " = " .. tostring(val))
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

-- stop key ------------------------------------------------------------

task.spawn(function()
    local wasDown = false
    while running do
        local down = false
        pcall(function() down = iskeypressed(CONFIG.stopKey) end)
        if down and not wasDown then
            running = false
            mobPaused = false
            armedOrbs = false
            clearOrbRun()
            flags.mobs, flags.players = false, false
            flags.orbs, flags.voidorbs = false, false
            corpses = {}
            pcall(goHome)
            pcall(function() notify("Bug farm stopped", "Bug Farm", 2) end)
            print("[Bug Farm] stopped")
        end
        wasDown = down
        task.wait(0.1)
    end
end)

-- menu ----------------------------------------------------------------

local function setFlag(key)
    return function(v)
        if key == "orbs" and orbsLatch then
            if v == false then orbsLatch = false end
            return
        end
        if getterWorks[key] then return end
        flags[key] = v
        print("[Bug Farm] " .. key .. " = " .. tostring(v))
    end
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local orbSec = mkSection(tab, "Orbs")
        if orbSec then
            mkToggle(orbSec, "Orbs", "be_orbs", false, setFlag("orbs"))
            registerToggle("orbs", "be_orbs")
            mkToggle(orbSec, "Void Orbs (loop)", "be_voidorbs", false, setFlag("voidorbs"))
            registerToggle("voidorbs", "be_voidorbs")
            pcall(function() orbSec:Text("Orbs: one pass, resumable, then off.") end)
            pcall(function() orbSec:Text("Void orbs: repeats, and always cut in first.") end)
            pcall(function() orbSec:Text("Both can run at once.") end)
        end

        local mobSec = mkSection(tab, "Mob Farm")
        if mobSec then
            mkToggle(mobSec, "Farm Mobs", "be_mobs", false, setFlag("mobs"))
            registerToggle("mobs", "be_mobs")
            mkToggle(mobSec, "Farm Players", "be_players", false, setFlag("players"))
            registerToggle("players", "be_players")

            mkSlider(mobSec, "Y Distance", "be_dist", 0, CONFIG.yMax, CFG.dist, function(v)
                CFG.dist = v
                print("[Bug Farm] yDist = " .. tostring(v))
            end)
            mkToggle(mobSec, "Below Target", "be_below", true, function(v)
                CFG.below = v
            end)
            mkToggle(mobSec, "Freeze Velocity", "be_freeze", true, setFlag("freeze"))
            registerToggle("freeze", "be_freeze")
            pcall(function() mobSec:Text("Distance 0-15. Attack + eat always on.") end)
            pcall(function() mobSec:Text("Pauses while orbs are pending.") end)
        end

        local misc = mkSection(tab, "Misc")
        if misc then
            pcall(function() misc:Text("X = stop everything") end)
        end
    end)
    if not ok then warn("[Bug Farm] build error: " .. tostring(err)) end
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab("Bug Farm", function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then warn("[Bug Farm] UI.AddTab failed: " .. tostring(err)) end
else
    print("[Bug Farm] no UI in this build - defaults only")
end

-- stop ----------------------------------------------------------------

local function stop()
    running = false
    mobPaused = false
    armedOrbs = false
    clearOrbRun()
    flags.mobs, flags.players = false, false
    flags.orbs, flags.voidorbs = false, false
    corpses = {}
    if anchorConn then pcall(function() anchorConn:Disconnect() end) end
    pcall(goHome)
    if HAS_UI then pcall(function() UI.RemoveTab("Bug Farm") end) end
    _G[NAME] = nil
    print("[Bug Farm] stopped")
end

_G[NAME] = { stop = stop, version = VERSION }
print("[Bug Farm] v" .. VERSION .. " loaded - X to stop")
