    stopKey    = 0x58,   -- X
    returnHome = true,
}

local state = {
    running = true,
    home    = nil,
    took    = false,
    orbDone, voidDone, mobDone, playerDone = 0, 0, 0, 0,
    silentSent, silentLanded = 0, 0,
    lastSilentReport = '',
}

local running = true
local conns   = {}
local function track(c) conns[#conns+1] = c return c end
local function log(m) print('[BE] ' .. tostring(m)) end

-- ---------------- character ----------------
local function getChar()
    if not lp then return nil end
    local c
    pcall(function() c = lp.Character end)
    return c
end

local function getRoot()
    local c = getChar()
    if not c then return nil end
    local r
    pcall(function() r = c:FindFirstChild('HumanoidRootPart') end)
    return r
end

local function getHum()
    local c = getChar()
    if not c then return nil end
    local h
    pcall(function() h = c:FindFirstChildOfClass('Humanoid') end)
    return h
end

local function alive()
    local h = getHum()
    if not h then return false end
    local hp
    pcall(function() hp = h.Health end)
    return type(hp) == 'number' and hp > 0
end

local function posOf(inst)
    if not inst then return nil end
    local p
    pcall(function() p = inst.Position end)
    if typeof(p) == 'Vector3' then return p end
    local pp
    pcall(function() pp = inst.PrimaryPart end)
    if pp then
        local p2
        pcall(function() p2 = pp.Position end)
        if typeof(p2) == 'Vector3' then return p2 end
    end
    return nil
end

-- write the body to a world position; every farm goes through here so the
-- single-driver rule cannot be broken by accident
local function goTo(p)
    local r = getRoot()
    if not r or not p then return false end
    if not state.home then
        local hp
        pcall(function() hp = r.Position end)
        if typeof(hp) == 'Vector3' then state.home = hp end
    end
    local ok = pcall(function() r.CFrame = CFrame.new(p.X, p.Y, p.Z) end)
    if ok then state.took = true end
    return ok
end

local function goHome()
    if not CONFIG.returnHome or not state.home then return end
    local r = getRoot()
    if r then pcall(function() r.CFrame = CFrame.new(state.home.X, state.home.Y, state.home.Z) end) end
end

-- ---------------- orb farm ----------------
local orbList, orbIdx, orbPass = {}, 1, 1
local orbSlow = {}          -- position key -> true, orb survived a normal hold

local function orbKey(p)
    return string.format('%.1f:%.1f:%.1f', p.X, p.Y, p.Z)
end

local function scanOrbs()
    local f
    pcall(function() f = WS:FindFirstChild('Orbs') end)
    if not f then return {} end
    local out = {}
    local ok, kids = pcall(function() return f:GetChildren() end)
    if not ok or not kids then return {} end
    local org = posOf(getRoot())
    for i = 1, #kids do
        local c = kids[i]
        local p = posOf(c)
        if p then
            local d = org and (p - org).Magnitude or 0
            out[#out + 1] = { part = c, pos = p, dist = d, key = orbKey(p) }
        end
    end
    if org then
        table.sort(out, function(a, b) return a.dist < b.dist end)
    end
    return out
end

local function orbStep()
    if #orbList == 0 or orbIdx > #orbList then
        if orbPass > 1 then
            -- a full pass finished without a single live orb: done
            local any = false
            for i = 1, #orbList do
                local o = orbList[i]
                local par
                pcall(function() par = o.part.Parent end)
                if par ~= nil then any = true break end
            end
            if not any then
                log(string.format('orbs: finished, collected %d', state.orbDone))
                CONFIG.orbFarm = false
                if UI_TOGGLES and UI_TOGGLES.orb then
                    pcall(function() UI_TOGGLES.orb:SetValue(false) end)
                end
                return
            end
            if orbPass > CONFIG.maxPasses then
                log(string.format('orbs: stopping after %d passes, collected %d', CONFIG.maxPasses, state.orbDone))
                CONFIG.orbFarm = false
                if UI_TOGGLES and UI_TOGGLES.orb then
                    pcall(function() UI_TOGGLES.orb:SetValue(false) end)
                end
                return
            end
            orbPass = orbPass + 1
            log('orbs: repair pass ' .. orbPass)
        end
        orbList = scanOrbs()
        orbIdx = 1
        if #orbList == 0 then task.wait(0.5) return end
        if orbPass == 1 then log('orbs: ' .. #orbList .. ' tracked') end
    end

    local o = orbList[orbIdx]
    orbIdx = orbIdx + 1

    local par
    pcall(function() par = o.part.Parent end)
    if par == nil then
        state.orbDone = state.orbDone + 1
        return   -- already gone, no wait needed
    end

    if not alive() then task.wait(0.3) return end
    goTo(o.pos)

    local hold = orbSlow[o.key] and CONFIG.orbSlowHold or CONFIG.orbHold
    task.wait(hold)

    pcall(function() par = o.part.Parent end)
    if par == nil then
        state.orbDone = state.orbDone + 1
    else
        orbSlow[o.key] = true
    end
end

-- ---------------- void orb farm ----------------
local voidList, voidIdx = {}, 1

local function voidPos(model)
    local p
    pcall(function() p = model:FindFirstChild('Hit') end)
    if p then local q = posOf(p) if q then return q end end
    pcall(function() p = model:FindFirstChild('Core') end)
    if p then local q = posOf(p) if q then return q end end
    pcall(function() p = model:FindFirstChild('Shimmer') end)
    if p then local q = posOf(p) if q then return q end end
    return posOf(model)
end

local function scanVoid()
    local f
    pcall(function() f = WS:FindFirstChild('VoidOrbs') end)
    if not f then return {} end
    local out = {}
    local ok, kids = pcall(function() return f:GetChildren() end)
    if not ok or not kids then return {} end
    for i = 1, #kids do
        local c = kids[i]
        local p = voidPos(c)
        if p then out[#out + 1] = { model = c, pos = p } end
    end
    return out
end

local function voidStep()
    if #voidList == 0 or voidIdx > #voidList then
        voidList = scanVoid()
        voidIdx = 1
        if #voidList == 0 then
            log('void: no VoidOrbs right now')
            task.wait(1)
            return
        end
    end
    local e = voidList[voidIdx]
    voidIdx = voidIdx + 1
    local par
    pcall(function() par = e.model.Parent end)
    if par == nil then
        state.voidDone = state.voidDone + 1
        return
    end
    if not alive() then task.wait(0.3) return end
    goTo(e.pos)
    task.wait(CONFIG.voidHold)
    pcall(function() par = e.model.Parent end)
    if par == nil then state.voidDone = state.voidDone + 1 end
end

-- ---------------- mob farm ----------------
local mobList, mobIdx, mobScanAt = {}, 1, 0

local function scanMobs()
    local f
    pcall(function() f = WS:FindFirstChild('Bugs') end)
    if not f then return {} end
    local out = {}
    local ok, kids = pcall(function() return f:GetChildren() end)
    if not ok or not kids then return {} end
    local org = posOf(getRoot())
    for i = 1, #kids do
        local m = kids[i]
        local hum, root
        pcall(function() hum = m:FindFirstChildOfClass('Humanoid') end)
        pcall(function() root = m:FindFirstChild('HumanoidRootPart') end)
        if hum and root then
            local hp, mx
            pcall(function() hp = hum.Health; mx = hum.MaxHealth end)
            if type(hp) == 'number' and hp > 0 and (type(mx) ~= 'number' or mx > 0) then
                local p
                pcall(function() p = root.Position end)
                if typeof(p) == 'Vector3' then
                    local d = org and (p - org).Magnitude or 0
                    out[#out + 1] = { model = m, hum = hum, pos = p, dist = d }
                end
            end
        end
    end
    if org then
        table.sort(out, function(a, b) return a.dist < b.dist end)
    end
    return out
end

-- UNVERIFIED: the payload of Remotes.Attack is unknown (see header). One
-- argument, the bug model, is the most common shape; the result is measured by
-- reading the bug's Health back and printing whether it moved.
local function trySilentKill(mob)
    if not CONFIG.silentKill then return end
    local rem
    pcall(function() rem = RS:FindFirstChild('Remotes') end)
    if not rem then return end
    local atk
    pcall(function() atk = rem:FindFirstChild('Attack') end)
    if not atk then return end

    local before
    pcall(function() before = mob.hum and mob.hum.Health end)
    local ok = pcall(function() atk:FireServer(mob.model) end)
    state.silentSent = state.silentSent + 1
    if not ok then return end

    task.wait(0.08)
    local after
    pcall(function() after = mob.hum and mob.hum.Health end)
    if type(before) == 'number' and type(after) == 'number' and after < before then
        state.silentLanded = state.silentLanded + 1
    end
    local rep = string.format('silent: sent %d landed %d', state.silentSent, state.silentLanded)
    if rep ~= state.lastSilentReport then
        state.lastSilentReport = rep
        log(rep)
    end
end

local function mobStep()
    local now = os.clock()
    if now >= mobScanAt or #mobList == 0 then
        mobScanAt = now + 1.0
        mobList = scanMobs()
        mobIdx = 1
        if #mobList == 0 then
            log('mobs: none alive right now')
            task.wait(0.6)
            return
        end
    end
    local e = mobList[mobIdx]
    mobIdx = mobIdx + 1
    if mobIdx > #mobList then mobIdx = 1 end

    local par, hp
    pcall(function() par = e.model.Parent end)
    pcall(function() hp = e.hum and e.hum.Health end)
    if par == nil or type(hp) ~= 'number' or hp <= 0 then return end

    if not alive() then task.wait(0.3) return end

    -- hover at the mob's feet so melee reach covers it without standing inside
    goTo(e.pos - Vector3.new(0, CONFIG.hoverY, 0))
    if CONFIG.silentKill then
        trySilentKill(e)
    else
        task.wait(CONFIG.mobHold)
    end
    state.mobDone = state.mobDone + 1
end

-- ---------------- player farm ----------------
local playerList, playerIdx, playerScanAt = {}, 1, 0

local function scanPlayers()
    if not Players then return {} end
    local out = {}
    local list
    local ok = pcall(function() list = Players:GetPlayers() end)
    if not ok or not list or #list == 0 then
        pcall(function() list = Players:GetChildren() end)
    end
    if not list then return {} end

    local myTeam
    pcall(function() myTeam = lp.Team end)
    local myTeamId
    pcall(function() myTeamId = lp:GetAttribute('TeamId') end)
    local org = posOf(getRoot())
    local myName
    pcall(function() myName = lp.Name end)

    for i = 1, #list do
        local plr = list[i]
        local nm
        pcall(function() nm = plr.Name end)
        if nm and nm ~= myName then
            local ch
            pcall(function() ch = plr.Character end)
            if ch then
                local hum, root
                pcall(function() hum = ch:FindFirstChildOfClass('Humanoid') end)
                pcall(function() root = ch:FindFirstChild('HumanoidRootPart') end)
                local sameTeam = false
                if myTeam then
                    local t
                    pcall(function() t = plr.Team end)
                    sameTeam = (t ~= nil and t == myTeam)
                elseif myTeamId ~= nil then
                    local tid
                    pcall(function() tid = plr:GetAttribute('TeamId') end)
                    sameTeam = (tid ~= nil and tid == myTeamId)
                end
                if hum and root and not sameTeam then
                    local hp
                    pcall(function() hp = hum.Health end)
                    if type(hp) == 'number' and hp > 0 then
                        local p
                        pcall(function() p = root.Position end)
                        if typeof(p) == 'Vector3' then
                            local d = org and (p - org).Magnitude or 0
                            out[#out + 1] = { plr = plr, pos = p, dist = d, name = nm }
                        end
                    end
                end
            end
        end
    end
    if org then
        table.sort(out, function(a, b) return a.dist < b.dist end)
    end
    return out
end

local function playerStep()
    local now = os.clock()
    if now >= playerScanAt or #playerList == 0 then
        playerScanAt = now + 0.6
        playerList = scanPlayers()
        playerIdx = 1
        if #playerList == 0 then
            task.wait(0.5)
            return
        end
    end
    local e = playerList[playerIdx]
    playerIdx = playerIdx + 1
    if playerIdx > #playerList then playerIdx = 1 end

    if not alive() then task.wait(0.3) return end
    goTo(e.pos - Vector3.new(0, CONFIG.hoverY, 0))
    task.wait(CONFIG.playerHold)
    state.playerDone = state.playerDone + 1
end

-- ---------------- driver (one body, one owner) ----------------
task.spawn(function()
    while running do
        if not WS then task.wait(0.5) else
            local did = false
            if CONFIG.orbFarm then
                pcall(orbStep) did = true
            elseif CONFIG.voidFarm then
                pcall(voidStep) did = true
            elseif CONFIG.mobFarm then
                pcall(mobStep) did = true
            elseif CONFIG.playerFarm then
                pcall(playerStep) did = true
            end
            if not did then task.wait(0.2) end
        end
    end
end)

