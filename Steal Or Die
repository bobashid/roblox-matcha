local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    for i = 1, #itemPool do
        pcall(function() itemPool[i].box:Remove() end)
        pcall(function() itemPool[i].txt:Remove() end)
        pcall(function() itemPool[i].dot:Remove() end)
    end
    for i = 1, #exitPool do
        pcall(function() exitPool[i].box:Remove() end)
        pcall(function() exitPool[i].txt:Remove() end)
