-- ---------------- drawing pools (created once, only mutated) ----------------
local function newSlot(withDot)
    local s = { visible = false }
    pcall(function()
        s.box = Drawing.new('Square')
        s.box.Thickness = 1
        s.box.Filled = false
        s.box.Visible = false
    end)
    pcall(function()
        s.txt = Drawing.new('Text')
        s.txt.Size = 14
        s.txt.Center = true
        s.txt.Outline = true
        s.txt.Visible = false
    end)
    if withDot then
        pcall(function()
            s.dot = Drawing.new('Circle')
            s.dot.Filled = true
            s.dot.Radius = 3
            s.dot.Visible = false
        end)
    end
    return s
end

for i = 1, 80 do itemPool[i] = newSlot(true) end
for i = 1, 12 do exitPool[i] = newSlot(false) end

local function hideSlot(s)
    if s.box then s.box.Visible = false end
    if s.txt then s.txt.Visible = false end
    if s.dot then s.dot.Visible = false end
    s.visible = false
end

-- ---------------- helpers ----------------
local function posOf(inst)
    if not inst then return nil end
    local p
    pcall(function() p = inst.Position end)
    if typeof(p) == 'Vector3' then return p end
    local pp
    pcall(function() pp = inst.PrimaryPart end)
    if pp then
        local p2
        pcall(function() p2 = pp.Position end)
        if typeof(p2) == 'Vector3' then return p2 end
    end
    local cf
    pcall(function() cf = inst.CFrame end)
    if typeof(cf) == 'CFrame' then return cf.Position end
    return nil
end

local function isPart(cls)
    if cls == 'Part' then return true end
    if cls == 'MeshPart' then return true end
    if cls == 'UnionOperation' then return true end
    if cls == 'IntersectOperation' then return true end
    if cls == 'WedgePart' then return true end
    return false
end

local function normRarity(s)
    if type(s) ~= 'string' or #s == 0 then return nil end
    local low = string.lower(s)
    for i = 1, #MATCH_ORDER do
        local r = MATCH_ORDER[i]
        if string.find(low, string.lower(r), 1, true) then return r end
    end
    return nil
end

local function attrOf(inst, key)
    if not inst then return nil end
    local ok, v = pcall(function() return inst:GetAttribute(key) end)
    if ok then return v end
    return nil
end

-- ---------------- rarity resolution ----------------
-- PRIMARY: the item's own Rarity attribute (confirmed present on MyLoot items).
local function rarityDirect(inst)
    local r = normRarity(tostring(attrOf(inst, 'Rarity') or ''))
    if r then return r end
    return nil
end

local function rarityFromAttributes(inst)
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if not ok or not attrs then return nil end
    for k, v in pairs(attrs) do
        local kl = string.lower(tostring(k))
        if string.find(kl, 'rarity', 1, true) or string.find(kl, 'tier', 1, true) then
            local r = normRarity(tostring(v))
            if r then return r end
        end
    end
    return nil
end

local function rarityFromValues(inst)
    local ok, kids = pcall(function() return inst:GetChildren() end)
    if not ok or not kids then return nil end
    for i = 1, #kids do
        local c = kids[i]
        local nm
        pcall(function() nm = c.Name end)
        if type(nm) == 'string' and string.find(string.lower(nm), 'rarity', 1, true) then
            local v
            pcall(function() v = c.Value end)
            local r = normRarity(tostring(v))
            if r then return r end
        end
    end
    return nil
end

local function rarityFromText(inst)
    local ok, desc = pcall(function() return inst:GetDescendants() end)
    if not ok or not desc then return nil end
    for i = 1, #desc do
        local d = desc[i]
        local cls
        pcall(function() cls = d.ClassName end)
        if cls == 'TextLabel' or cls == 'TextButton' then
            local t
            pcall(function() t = d.Text end)
            if type(t) == 'string' and #t > 0 then
                local r = normRarity(t)
                if r then return r end
            end
        end
    end
    return nil
end

local modelCache = {}

local function rarityOf(inst)
    if not inst then return 'Unknown' end
    local key = 'x'
    pcall(function() key = tostring(inst.Address) end)
    local c = modelCache[key]
    if c and (os.clock() - c.at) < 5 then return c.rarity end

    local r = rarityDirect(inst)
    if not r then r = rarityFromAttributes(inst) end
    if not r then
        local cur, up = inst, 0
        while not r and cur and up < 4 do
            local par
            pcall(function() par = cur.Parent end)
            cur = par
            up = up + 1
            if cur then
                r = rarityFromAttributes(cur)
                if not r then r = rarityFromValues(cur) end
            end
        end
    end
    if not r then r = rarityFromValues(inst) end
    if not r then r = rarityFromText(inst) end

    local final = r or 'Unknown'
    modelCache[key] = { rarity = final, at = os.clock() }
    return final
end

-- ---------------- item discovery ----------------
local targets = {}
local exits   = {}
local lastReport = ''

local function carryRoom()
    local cap = attrOf(lp, 'CarryCapacity')
    local used = attrOf(lp, 'CarryWeight')
    if type(cap) == 'number' and type(used) == 'number' then
        return cap - used
    end
    return math.huge
end

local function secondLifeActive()
    local sl = attrOf(lp, 'SecondLife')
    if sl == nil then return false end
    local round = RS:FindFirstChild('Round')
    if not round then return false end
    local mid = attrOf(round, 'MatchId')
    return mid ~= nil and sl == mid
end

local function collectFrom(folder, items, halve)
    local ok, kids = pcall(function() return folder:GetChildren() end)
    if not ok or not kids then return end
    for i = 1, #kids do
        local c = kids[i]
        local cls
        pcall(function() cls = c.ClassName end)

        local part = nil
        if isPart(cls) then
            part = c
        elseif cls == 'Model' then
            local named
            pcall(function() named = c:FindFirstChild('Item') end)
            if named then
                local ncls
                pcall(function() ncls = named.ClassName end)
                if isPart(ncls) then part = named end
            end
            if not part then
                local pp
                pcall(function() pp = c.PrimaryPart end)
                if pp then
                    local pcls
                    pcall(function() pcls = pp.ClassName end)
                    if isPart(pcls) then part = pp end
                end
            end
            if not part then
                local ok2, subs = pcall(function() return c:GetChildren() end)
                if ok2 and subs then
                    for j = 1, #subs do
                        local k = subs[j]
                        local kcls
                        pcall(function() kcls = k.ClassName end)
                        if isPart(kcls) then part = k break end
                    end
                end
            end
        end

        if part then
            local p = posOf(part)
            if p then
                local val = attrOf(c, 'Value')
                if type(val) ~= 'number' then val = 0 end
                if halve and attrOf(c, 'Dropped') ~= true then
                    val = math.max(1, math.floor(val / 2.5 + 0.5))
                end
                local wt = attrOf(c, 'Weight')
                if type(wt) ~= 'number' then wt = 0 end
                local key = attrOf(c, 'ItemKey')
                items[#items + 1] = {
                    pos    = p,
                    rarity = rarityOf(c),
                    label  = tostring(key or c.Name or 'Item'),
                    value  = val,
                    weight = wt,
                }
            end
        end
    end
end

local LOOT_FOLDERS = { 'MyLoot', 'LootItems', 'DroppedItems', 'Loot' }

local function refresh()
    local items, ex = {}, {}
    local halve = secondLifeActive()

    for i = 1, #LOOT_FOLDERS do
        local f
        pcall(function() f = workspace:FindFirstChild(LOOT_FOLDERS[i]) end)
        if f then
            local n = 0
            pcall(function() n = #f:GetChildren() end)
            if n > 0 and #items < 200 then collectFrom(f, items, halve) end
        end
    end

    local ok, desc = pcall(function() return workspace:GetDescendants() end)
    if ok and desc then
        local exitHits = 0
        for i = 1, #desc do
            local d = desc[i]
            local n, cls
            pcall(function() n = d.Name end)
            pcall(function() cls = d.ClassName end)
            if type(n) == 'string' and exitHits < 40 then
                local low = string.lower(n)
                if low == 'exitpoint' then
                    local p = posOf(d)
                    if p then
                        exitHits = exitHits + 1
                        ex[#ex + 1] = { pos = p }
                    end
                elseif cls == 'Model' and string.find(low, 'exit sign', 1, true) then
                    local p = posOf(d)
                    if p then
                        exitHits = exitHits + 1
                        ex[#ex + 1] = { pos = p }
                    end
                end
            end
        end
    end

    targets = items
    exits   = ex

    local tally, total = {}, 0
    for i = 1, #items do
        local r = items[i].rarity
        tally[r] = (tally[r] or 0) + 1
        total = total + items[i].value
    end
    local parts = {}
    for r, c in pairs(tally) do parts[#parts + 1] = tostring(r) .. '=' .. tostring(c) end
    table.sort(parts)
    local line = 'items=' .. tostring(#items) .. '  exits=' .. tostring(#ex) ..
                 '  value=$' .. tostring(total) .. '  [' .. table.concat(parts, ' ') .. ']'
    if line ~= lastReport then
        lastReport = line
        log(line)
    end
end

-- ---------------- origin ----------------
local function origin()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local hrp
    pcall(function() hrp = c:FindFirstChild('HumanoidRootPart') end)
    if not hrp then return nil end
    local p
    pcall(function() p = hrp.Position end)
    if typeof(p) ~= 'Vector3' then return nil end
    return p
end

-- ---------------- renderer ----------------
local function drawSlot(s, sp, dist, text, col, boxH)
    if s.box then
        s.box.Visible = true
        local w = math.clamp(1400 / math.max(dist, 20), 6, 34)
        local h = w * (boxH or 1.4)
        s.box.Size     = Vector2.new(w, h)
        s.box.Position = Vector2.new(sp.X - w * 0.5, sp.Y - h * 0.5)
        s.box.Color    = col
    end
    if s.dot then
        s.dot.Visible  = true
        s.dot.Color    = col
        s.dot.Position = Vector2.new(sp.X, sp.Y)
    end
    if s.txt then
        s.txt.Visible  = true
        s.txt.Text     = text
        s.txt.Color    = col
        s.txt.Position = Vector2.new(sp.X, sp.Y + 20)
    end
    s.visible = true
end

track(RunService.RenderStepped:Connect(function()
    if not running then return end

    local org = origin()
    local iIdx, eIdx = 0, 0
    local room = carryRoom()

    if CONFIG.Items and org then
        local cands = {}
        for i = 1, #targets do
            local t = targets[i]
            local d = (t.pos - org).Magnitude
            if d <= CONFIG.MaxDist
                and t.value >= CONFIG.MinValue
                and CONFIG.Rarity[t.rarity] then
                local sp, on = WorldToScreen(t.pos + Vector3.new(0, 1.2, 0))
                if on then cands[#cands + 1] = { t = t, sp = sp, d = d } end
            end
        end
        table.sort(cands, function(a, b) return a.t.value > b.t.value end)

        for i = 1, #cands do
            if iIdx >= CONFIG.MaxLabels then break end
            local c = cands[i]
            iIdx = iIdx + 1
            local s = itemPool[iIdx]
            if s then
                local txt = c.t.rarity .. '  ' .. tostring(c.t.label) ..
                            '  $' .. tostring(c.t.value) ..
                            '  ' .. string.format('%.1f', c.t.weight) .. 'kg' ..
                            '  [' .. string.format('%.0f', c.d) .. 'm]'
                local col = RCOL[c.t.rarity] or RCOL.Unknown
                if c.t.weight > room then
                    col = Color3.fromRGB(
                        math.floor(col.R * 255 * 0.45),
                        math.floor(col.G * 255 * 0.45),
                        math.floor(col.B * 255 * 0.45))
                end
                drawSlot(s, c.sp, c.d, txt, col, 1.4)
            end
        end
    end
    for i = iIdx + 1, #itemPool do
        if itemPool[i].visible then hideSlot(itemPool[i]) end
    end

    if CONFIG.Exit and org then
        for i = 1, #exits do
            local e = exits[i]
            local d = (e.pos - org).Magnitude
            if d <= CONFIG.MaxDist then
                local sp, on = WorldToScreen(e.pos + Vector3.new(0, 3, 0))
                if on then
                    eIdx = eIdx + 1
                    local s = exitPool[eIdx]
                    if s then
                        local txt = 'EXIT  [' .. string.format('%.0f', d) .. 'm]'
                        drawSlot(s, sp, d, txt, Color3.fromRGB(120, 255, 150), 1.8)
                    end
                end
            end
        end
    end
    for i = eIdx + 1, #exitPool do
        if exitPool[i].visible then hideSlot(exitPool[i]) end
    end
end))

-- ---------------- discovery loop ----------------
task.spawn(function()
    while running do
        pcall(refresh)
        task.wait(1.0)
    end
end)

-- ---------------- menu ----------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function safeToggle(sec, id, label, default, cb)
    if pcall(function() sec:Toggle(id, label, default, cb) end) then return true end
    if pcall(function() sec:Toggle(label, id, default, cb) end) then return true end
    if pcall(function() sec:Toggle(label, default, cb) end) then return true end
    return false
end

local function safeSlider(sec, id, label, min, max, default, cb)
    if pcall(function() sec:Slider(id, label, min, max, default, cb) end) then return true end
    if pcall(function() sec:Slider(label, min, max, default, cb) end) then return true end
    if pcall(function() sec:Slider(id, label, default, min, max, cb) end) then return true end
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Steal Or Die', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local main = mkSection(tab, 'ESP')
                if not main then return end

                safeToggle(main, 'sod_items', 'Item ESP', CONFIG.Items, function(v)
                    CONFIG.Items = v
                end)
                safeToggle(main, 'sod_exit', 'Exit ESP', CONFIG.Exit, function(v)
                    CONFIG.Exit = v
                end)
                safeSlider(main, 'sod_minval', 'Min Value ($)', 0, 500, CONFIG.MinValue,
                    function(v)
                        local n = tonumber(v)
                        if n then CONFIG.MinValue = math.floor(n) end
                    end)

                local rar = mkSection(tab, 'Rarity')
                if rar then
                    for i = 1, #RARITIES do
                        local r = RARITIES[i]
                        safeToggle(rar, 'sod_r_' .. string.lower(r), r,
                            CONFIG.Rarity[r], function(v) CONFIG.Rarity[r] = v end)
                    end
                    safeToggle(rar, 'sod_r_unknown', 'Unknown',
                        CONFIG.Rarity.Unknown, function(v) CONFIG.Rarity.Unknown = v end)
                end
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

-- ---------------- poller ----------------
local function getAny(id, label, wantType)
    if not HAS_UI then return nil end
    local ok, v = pcall(function() return UI.GetValue(id) end)
    if ok and type(v) == wantType then return v end
    ok, v = pcall(function() return UI.GetValue(label) end)
    if ok and type(v) == wantType then return v end
    return nil
end

task.spawn(function()
    while running do
        local v = getAny('sod_items', 'Item ESP', 'boolean')
        if v ~= nil then CONFIG.Items = v end
        v = getAny('sod_exit', 'Exit ESP', 'boolean')
        if v ~= nil then CONFIG.Exit = v end
        local n = getAny('sod_minval', 'Min Value ($)', 'number')
        if n ~= nil then CONFIG.MinValue = math.floor(n) end
        for i = 1, #RARITIES do
            local r = RARITIES[i]
            local b = getAny('sod_r_' .. string.lower(r), r, 'boolean')
            if b ~= nil then CONFIG.Rarity[r] = b end
        end
        local b = getAny('sod_r_unknown', 'Unknown', 'boolean')
        if b ~= nil then CONFIG.Rarity.Unknown = b end
        task.wait(0.15)
    end
end)

