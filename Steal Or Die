-- ---------------- drawing pools (created once, only mutated) ----------------
local function newSlot()
    local s = { visible = false }
    pcall(function()
        s.box = Drawing.new('Square')
        s.box.Thickness = 1
        s.box.Filled = false
        s.box.Visible = false
    end)
    pcall(function()
        s.txt = Drawing.new('Text')
        s.txt.Size = 14
        s.txt.Center = true
        s.txt.Outline = true
        s.txt.Visible = false
    end)
    return s
end

for i = 1, 56 do itemPool[i] = newSlot() end
for i = 1, 12 do exitPool[i] = newSlot() end

local function hideSlot(s)
    if s.box then s.box.Visible = false end
    if s.txt then s.txt.Visible = false end
    s.visible = false
end

-- ---------------- helpers ----------------
local function posOf(inst)
    if not inst then return nil end
    local p
    pcall(function() p = inst.Position end)
    if typeof(p) == 'Vector3' then return p end
    local pp
    pcall(function() pp = inst.PrimaryPart end)
    if pp then
        local p2
        pcall(function() p2 = pp.Position end)
        if typeof(p2) == 'Vector3' then return p2 end
    end
    local cf
    pcall(function() cf = inst.CFrame end)
    if typeof(cf) == 'CFrame' then return cf.Position end
    return nil
end

local function isPart(cls)
    if cls == 'Part' then return true end
    if cls == 'MeshPart' then return true end
    if cls == 'UnionOperation' then return true end
    if cls == 'IntersectOperation' then return true end
    if cls == 'WedgePart' then return true end
    return false
end

-- 'uncommon' contains 'common', so test in MATCH_ORDER, never in RARITIES order
local function normRarity(s)
    if type(s) ~= 'string' or #s == 0 then return nil end
    local low = string.lower(s)
    for i = 1, #MATCH_ORDER do
        local r = MATCH_ORDER[i]
        if string.find(low, string.lower(r), 1, true) then return r end
    end
    return nil
end

-- ---------------- rarity resolution ----------------
local function rarityFromAttributes(inst)
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if not ok or not attrs then return nil end
    for k, v in pairs(attrs) do
        local kl = string.lower(tostring(k))
        if string.find(kl, 'rarity', 1, true) or string.find(kl, 'tier', 1, true) then
            local r = normRarity(tostring(v))
            if r then return r end
        end
    end
    return nil
end

local function rarityFromValues(inst)
    local ok, kids = pcall(function() return inst:GetChildren() end)
    if not ok or not kids then return nil end
    for i = 1, #kids do
        local c = kids[i]
        local nm
        pcall(function() nm = c.Name end)
        if type(nm) == 'string' and string.find(string.lower(nm), 'rarity', 1, true) then
            local v
            pcall(function() v = c.Value end)
            local r = normRarity(tostring(v))
            if r then return r end
        end
    end
    return nil
end

local function rarityFromText(inst)
    local ok, desc = pcall(function() return inst:GetDescendants() end)
    if not ok or not desc then return nil end
    for i = 1, #desc do
        local d = desc[i]
        local cls
        pcall(function() cls = d.ClassName end)
        if cls == 'TextLabel' or cls == 'TextButton' then
            local t
            pcall(function() t = d.Text end)
            if type(t) == 'string' and #t > 0 then
                local r = normRarity(t)
                if r then return r end
            end
        end
    end
    return nil
end

local modelCache = {}

local function rarityOf(inst)
    if not inst then return 'Unknown' end
    local key = 'x'
    pcall(function() key = tostring(inst.Address) end)
    local c = modelCache[key]
    if c and (os.clock() - c.at) < 3 then return c.rarity end

    local r = rarityFromAttributes(inst)
    local cur = inst
    local up = 0
    while not r and cur and up < 4 do
        local par
        pcall(function() par = cur.Parent end)
        cur = par
        up = up + 1
        if cur then
            r = rarityFromAttributes(cur)
            if not r then r = rarityFromValues(cur) end
        end
    end
    if not r then r = rarityFromValues(inst) end
    if not r then r = rarityFromText(inst) end

    local final = r or 'Unknown'
    modelCache[key] = { rarity = final, at = os.clock() }
    return final
end

-- ---------------- item discovery (ACTIVE items only) ----------------
local ITEM_ROOT_NAMES = { 'LootItems', 'DroppedItems', 'Loot' }
local targets = {}
local exits   = {}
local lastReportCount = -1

local function markerPartOf(child)
    -- one part per item, never one per decorative sub-part
    local cls
    pcall(function() cls = child.ClassName end)
    if isPart(cls) then return child end
    if cls ~= 'Model' then return nil end

    local named
    pcall(function() named = child:FindFirstChild('Item') end)
    if named then
        local ncls
        pcall(function() ncls = named.ClassName end)
        if isPart(ncls) then return named end
    end

    local pp
    pcall(function() pp = child.PrimaryPart end)
    if pp then
        local pcls
        pcall(function() pcls = pp.ClassName end)
        if isPart(pcls) then return pp end
    end

    local ok, kids = pcall(function() return child:GetChildren() end)
    if ok and kids then
        for i = 1, #kids do
            local k = kids[i]
            local kcls
            pcall(function() kcls = k.ClassName end)
            if isPart(kcls) then return k end
        end
    end
    return nil
end

local function collectRoot(inst, items)
    local ok, kids = pcall(function() return inst:GetChildren() end)
    if not ok or not kids then return end
    for i = 1, #kids do
        local c = kids[i]
        local cls
        pcall(function() cls = c.ClassName end)
        if cls == 'Folder' then
            local ok2, subs = pcall(function() return c:GetChildren() end)
            if ok2 and subs then
                for j = 1, #subs do
                    local s = subs[j]
                    local part = markerPartOf(s)
                    if part then
                        local p = posOf(part)
                        if p then
                            local nm
                            pcall(function() nm = s.Name end)
                            items[#items + 1] = {
                                pos = p, rarity = rarityOf(s), label = tostring(nm or 'Item'),
                            }
                        end
                    end
                end
            end
        else
            local part = markerPartOf(c)
            if part then
                local p = posOf(part)
                if p then
                    local nm
                    pcall(function() nm = c.Name end)
                    items[#items + 1] = {
                        pos = p, rarity = rarityOf(c), label = tostring(nm or 'Item'),
                    }
                end
            end
        end
    end
end

local function activeItemRoots()
    local found, nonEmpty = {}, nil
    for i = 1, #ITEM_ROOT_NAMES do
        local f
        pcall(function() f = workspace:FindFirstChild(ITEM_ROOT_NAMES[i]) end)
        if f then
            found[#found + 1] = f
            local n = 0
            pcall(function() n = #f:GetChildren() end)
            if n > 0 and not nonEmpty then nonEmpty = f end
        end
    end
    if nonEmpty then return { nonEmpty } end
    return found
end

local function refresh()
    local items, ex = {}, {}

    local roots = activeItemRoots()
    for i = 1, #roots do
        if #items < 160 then collectRoot(roots[i], items) end
    end

    local ok, desc = pcall(function() return workspace:GetDescendants() end)
    if ok and desc then
        local exitHits = 0
        for i = 1, #desc do
            local d = desc[i]
            local n, cls
            pcall(function() n = d.Name end)
            pcall(function() cls = d.ClassName end)
            if type(n) == 'string' and exitHits < 40 then
                local low = string.lower(n)
                if low == 'exitpoint' then
                    local p = posOf(d)
                    if p then
                        exitHits = exitHits + 1
                        ex[#ex + 1] = { pos = p }
                    end
                elseif cls == 'Model' and string.find(low, 'exit sign', 1, true) then
                    local p = posOf(d)
                    if p then
                        exitHits = exitHits + 1
                        ex[#ex + 1] = { pos = p }
                    end
                end
            end
        end
    end

    targets = items
    exits   = ex

    if #items ~= lastReportCount then
        lastReportCount = #items
        local tally = {}
        for i = 1, #items do
            local r = items[i].rarity
            tally[r] = (tally[r] or 0) + 1
        end
        local parts = {}
        for r, c in pairs(tally) do parts[#parts + 1] = tostring(r) .. '=' .. tostring(c) end
        log('items=' .. tostring(#items) .. '  exits=' .. tostring(#ex) ..
            '  [' .. table.concat(parts, ' ') .. ']')
    end
end

-- ---------------- origin ----------------
local function origin()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local hrp
    pcall(function() hrp = c:FindFirstChild('HumanoidRootPart') end)
    if not hrp then return nil end
    local p
    pcall(function() p = hrp.Position end)
    if typeof(p) ~= 'Vector3' then return nil end
    return p
end

-- ---------------- renderer ----------------
local function drawSlot(s, sp, dist, text, col, boxH)
    if s.box then
        s.box.Visible = true
        local w = math.clamp(1400 / math.max(dist, 20), 6, 34)
        local h = w * (boxH or 1.4)
        s.box.Size     = Vector2.new(w, h)
        s.box.Position = Vector2.new(sp.X - w * 0.5, sp.Y - h * 0.5)
        s.box.Color    = col
    end
    if s.txt then
        s.txt.Visible  = true
        s.txt.Text     = text
        s.txt.Color    = col
        s.txt.Position = Vector2.new(sp.X, sp.Y + 20)
    end
    s.visible = true
end

track(RunService.RenderStepped:Connect(function()
    if not running then return end

    local org = origin()
    local iIdx, eIdx = 0, 0

    if CONFIG.Items and org then
        for i = 1, #targets do
            local t = targets[i]
            local d = (t.pos - org).Magnitude
            if d <= CONFIG.MaxDist and CONFIG.Rarity[t.rarity] then
                local sp, on = WorldToScreen(t.pos + Vector3.new(0, 1.2, 0))
                if on then
                    iIdx = iIdx + 1
                    local s = itemPool[iIdx]
                    if s then
                        local txt = t.rarity .. '  ' .. tostring(t.label) ..
                                    '  [' .. string.format('%.0f', d) .. 'm]'
                        drawSlot(s, sp, d, txt, RCOL[t.rarity] or RCOL.Unknown, 1.4)
                    end
                end
            end
        end
    end
    for i = iIdx + 1, #itemPool do
        if itemPool[i].visible then hideSlot(itemPool[i]) end
    end

    if CONFIG.Exit and org then
        for i = 1, #exits do
            local e = exits[i]
            local d = (e.pos - org).Magnitude
            if d <= CONFIG.MaxDist then
                local sp, on = WorldToScreen(e.pos + Vector3.new(0, 3, 0))
                if on then
                    eIdx = eIdx + 1
                    local s = exitPool[eIdx]
                    if s then
                        local txt = 'EXIT  [' .. string.format('%.0f', d) .. 'm]'
                        drawSlot(s, sp, d, txt, Color3.fromRGB(120, 255, 150), 1.8)
                    end
                end
            end
        end
    end
    for i = eIdx + 1, #exitPool do
        if exitPool[i].visible then hideSlot(exitPool[i]) end
    end
end))

