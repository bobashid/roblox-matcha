--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v6.9  -  v6.5, WITH THE LOOP ACTUALLY REPEATING
--
--  v6.5 was the right shape. What was missing is a trigger that keeps
--  firing, because everything measured here says this:
--
--      Attack remote alone ......... no damage (25 fires, HP unmoved)
--      firetouchinterest alone ..... no damage
--      a real swing ................ damage (the only thing that works)
--      reparenting the tool ........ crashes the client, never again
--
--  So each pass now does all three safe things at once, on every boss:
--
--      1. scale AttackPart so the box covers the whole map
--      2. firetouchinterest BOTH directions on the boss parts
--             (ap, part) and (part, ap)
--         because the tool's TouchTransmitter lives on AttackPart and
--         only one of those orders fires it
--      3. mouse1click + Attack remote, i.e. an actual swing
--
--  at TOUCH_RATE (0.15 s), so it keeps swinging instead of landing
--  one hit when a boss spawns. No tool is ever reparented.
--
--  It also reads each boss's Humanoid.Health. If HP has not moved for
--  a while it prints one line so you know the pass is not landing,
--  instead of silently doing nothing.
--
--  REACH
--    AttackPart is the only thing ever resized:
--        side = (farthest boss + 30) * 2      [60 .. 4000]
--    Bosses are never written to - no size, no CanCollide, no CFrame -
--    so nothing is launched into the void and the map stays solid.
--    Original size is saved per Address and restored when Reach goes
--    off or the script stops.
--
--  Keep a weapon in your hand. The script only swings what is equipped.
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v6.9"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local COLLECT_RATE = 1.5
local ATK_TTL      = 1.0

-- hit loop tuning
local TOUCH_RATE   = 0.15
local TOUCH_PARTS  = 3
local STALE_LIMIT  = 25

-- reach tuning
local REACH_PAD    = 30
local REACH_MIN    = 60
local REACH_MAX    = 4000
local BOSS_TTL     = 0.6
local PART_TTL     = 2.0

local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
    Reach       = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

local function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function sizeDiffers(a, b)
    if not a or not b then return false end
    local eps = 0.5
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    if dx < 0 then dx = -dx end
    if dy < 0 then dy = -dy end
    if dz < 0 then dz = -dz end
    return dx > eps or dy > eps or dz > eps
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes + real swing
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local okAll = true
        for i = 1, #atkCache do
            local r = atkCache[i]
            if not r or not r.Parent then okAll = false break end
        end
        if okAll then return atkCache end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swingRemote()
    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

local function swingClick()
    if type(mouse1click) ~= "function" then return false end

    if type(isrbxactive) == "function" then
        local ok, act = pcall(isrbxactive)
        if ok and act == false then return false end
    end

    return (pcall(mouse1click))
end

--------------------------------------------------------------------
-- Boss lookup (read only, strict, cached)
--------------------------------------------------------------------
local bossCache = {}
local bossStamp = 0
local partCache = {}

local function isBossModel(m)
    if not m then return false end
    if m.ClassName ~= "Model" then return false end

    local nm = m.Name
    if type(nm) ~= "string" then return false end
    if string.sub(nm, -4) ~= "Mama" then return false end

    return m:FindFirstChild("Humanoid") ~= nil
end

local function collectBosses()
    local out = {}

    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return out end

    local okA, areaKids = pcall(function() return areas:GetChildren() end)
    if not okA or not areaKids then return out end

    for i = 1, #areaKids do
        local ok, kids = pcall(function() return areaKids[i]:GetChildren() end)

        if ok and kids then
            for j = 1, #kids do
                local m = kids[j]
                if isBossModel(m) then out[#out + 1] = m end
            end
        end
    end

    return out
end

local function bossList()
    local now = tick()
    if (now - bossStamp) < BOSS_TTL then return bossCache end

    bossCache = collectBosses()
    bossStamp = now
    return bossCache
end

local function bossPosition(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local r = boss:FindFirstChild("HumanoidRootPart")
    if not r then return nil end

    local ok, p = pcall(function() return r.Position end)
    if ok and p then return p end
    return nil
end

local function bossHealth(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local h = boss:FindFirstChild("Humanoid")
    if not h then return nil end

    local okH, hp = pcall(function() return h.Health end)
    if okH and type(hp) == "number" then return hp end
    return nil
end

local function bossTouchParts(boss)
    local k   = keyOf(boss)
    local now = tick()

    local rec = k and partCache[k]
    if rec and (now - rec.stamp) < PART_TTL then return rec.parts end

    local parts = {}

    local r = boss:FindFirstChild("HumanoidRootPart")
    if r and isBasePart(r) then parts[#parts + 1] = r end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if ok and desc then
        for j = 1, #desc do
            if #parts >= TOUCH_PARTS then break end

            local d = desc[j]
            if isBasePart(d) and not SKIP_PART[d.Name] and d ~= r then
                parts[#parts + 1] = d
            end
        end
    end

    if k then
        partCache[k] = { stamp = now, parts = parts }
    end

    return parts
end

local function pruneCaches()
    local deadP = nil

    for k, rec in pairs(partCache) do
        local anyAlive = false

        for j = 1, #rec.parts do
            local p = rec.parts[j]
            local ok, parent = pcall(function() return p and p.Parent end)
            if ok and parent ~= nil then
                anyAlive = true
                break
            end
        end

        if not anyAlive then
            deadP = deadP or {}
            deadP[#deadP + 1] = k
        end
    end

    if deadP then
        for i = 1, #deadP do partCache[deadP[i]] = nil end
    end
end

--------------------------------------------------------------------
-- TOOL REACH  (AttackPart scaled around your hand)
--------------------------------------------------------------------
local apSaved = {}
local reachOn = false

local function findAttackPart()
    local c = LP.Character
    if not c then return nil end

    local kids = c:GetChildren()
    for i = 1, #kids do
        local t = kids[i]
        if t.ClassName == "Tool" then
            local p = t:FindFirstChild("AttackPart")
            if p and isBasePart(p) then return p end

            local ok, desc = pcall(function() return t:GetDescendants() end)
            if ok and desc then
                for j = 1, #desc do
                    local d = desc[j]
                    if isBasePart(d) and d.Name == "AttackPart" then return d end
                end
            end
        end
    end

    return nil
end

local function farthestBoss(myPos)
    local list = bossList()
    local far  = 0
    local seen = 0

    for i = 1, #list do
        local bp = bossPosition(list[i])
        if bp then
            local ok, d = pcall(function() return (bp - myPos).Magnitude end)
            if ok and type(d) == "number" then
                seen = seen + 1
                if d > far then far = d end
            end
        end
    end

    return far, seen
end

local function scaleAttackPart(ap)
    local hrp = rootPart()
    if not hrp then return 0 end

    local okM, myPos = pcall(function() return hrp.Position end)
    if not okM or not myPos then return 0 end

    local far, seen = farthestBoss(myPos)

    local side = (far + REACH_PAD) * 2
    if side < REACH_MIN then side = REACH_MIN end
    if side > REACH_MAX then side = REACH_MAX end

    local k = keyOf(ap)
    if k == nil then return seen end

    local e = apSaved[k]
    if e == nil then
        local okS, s = pcall(function() return ap.Size end)
        if not okS or not s then return seen end
        e = { part = ap, size = s }
        apSaved[k] = e
    end

    local target = Vector3.new(side, side, side)

    local okCur, cur = pcall(function() return ap.Size end)
    if not okCur or not cur or sizeDiffers(cur, target) then
        pcall(function() ap.Size = target end)
    end

    return seen
end

local function restoreAttackParts()
    local n = 0

    for k, e in pairs(apSaved) do
        local p = e.part
        if p then
            pcall(function() p.Size = e.size end)
            n = n + 1
        end
    end

    apSaved = {}

    if reachOn then
        print("[" .. NAME .. "] AttackPart restored on " .. tostring(n))
    end
    reachOn = false
    return n
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Reach (hit every boss anywhere)", "fam_reach", "Reach", false)
            addToggle(combat, "Auto Hit (repeat hits)", "fam_farm", "Farm", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- HIT LOOP  (touch both ways + real swing, every pass)
--------------------------------------------------------------------
task.spawn(function()
    local hasTouch = (type(firetouchinterest) == "function")
    local hasClick = (type(mouse1click) == "function")

    local wasOn     = false
    local warnedAp  = false
    local warnedBoss = false
    local staleWarn = false

    local lastTotal = nil
    local stale     = 0

    if not hasTouch then
        print("[" .. NAME .. "] firetouchinterest missing - swing only")
    end
    if not hasClick then
        print("[" .. NAME .. "] mouse1click missing - remote only")
    end

    while running do
        if Config.Farm and alive() then
            local ap = findAttackPart()

            if not ap then
                if not warnedAp then
                    warnedAp = true
                    print("[" .. NAME .. "] auto hit: equip a weapon")
                end
                task.wait(0.2)
            else
                warnedAp = false

                if not wasOn then
                    wasOn = true
                    print("[" .. NAME .. "] auto hit on (touch + swing loop)")
                end

                if Config.Reach then
                    scaleAttackPart(ap)
                    reachOn = true
                end

                pruneCaches()

                local list = bossList()
                local hits = 0
                local total = 0

                for i = 1, #list do
                    local boss = list[i]
                    local hp   = bossHealth(boss)

                    if hp and hp > 0 then
                        total = total + hp

                        if hasTouch then
                            local parts = bossTouchParts(boss)

                            for j = 1, #parts do
                                local part = parts[j]

                                pcall(function() firetouchinterest(ap, part, 0) end)
                                pcall(function() firetouchinterest(ap, part, 1) end)
                                pcall(function() firetouchinterest(part, ap, 0) end)
                                pcall(function() firetouchinterest(part, ap, 1) end)

                                hits = hits + 1
                            end
                        end
                    end
                end

                swingClick()
                swingRemote()

                if hits > 0 then
                    warnedBoss = false
                elseif not warnedBoss then
                    warnedBoss = true
                    print("[" .. NAME .. "] auto hit: no boss spawned right now")
                end

                if lastTotal and total > 0 and total >= lastTotal then
                    stale = stale + 1

                    if stale >= STALE_LIMIT and not staleWarn then
                        staleWarn = true
                        print("[" .. NAME .. "] boss HP not dropping - hits are not landing")
                    end
                else
                    stale     = 0
                    staleWarn = false
                end

                if total > 0 then lastTotal = total end

                task.wait(TOUCH_RATE)
            end
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto hit off")
            end

            warnedAp  = false
            warnedBoss = false
            stale     = 0
            staleWarn = false
            lastTotal = nil

            if reachOn then
                restoreAttackParts()
            end

            task.wait(0.1)
        end
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(restoreAttackParts)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache  = nil
    bossCache = {}
    bossStamp = 0
    partCache = {}
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - repeated hits, no equip spam", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
