--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v3.4
--
--  BOSS SELECT (toggles, not buttons)
--    One toggle per boss type under "Boss Select". Switching one ON
--    selects that boss and teleports you onto it immediately.
--    Switching it OFF clears the selection.
--    Matcha cannot untick a widget from script, so if you leave two on,
--    the most recently switched ON one wins - it is the one that took
--    you there last. Turn the previous one off to keep it tidy.
--
--  KILL AURA
--    Swings every pass. With a boss selected it moves onto that boss
--    and keeps hitting it. With nothing selected it targets the
--    nearest boss model. With no boss model anywhere it just swings
--    where you stand instead of walking to an empty arena.
--
--  WHAT THE GAME HAS (read live)
--    Workspace.SpawnAreas.<Type>Area holds:
--      Area        Part   - the arena floor (the standing spot)
--      ChaseArea   Part   - a trigger volume ~14 studs UP, never used
--      <boss>Mama  Model  - the boss itself
--    Common    -> MosquitoMama   (0, 0, -75)
--    Uncommon  -> UncommonMama   (0, -1, -145)
--    Rare      -> RareMama       (0, 0, -215)
--    Epic      -> EpicMama       (0, 0, -290)
--    Legendary -> LegendaryMama  (0, -1, -375)
--    Mythical / Divine / Secret hold only Walls and eggs, so those
--    three land on the Area floor part.
--
--  Sections
--    Main          Always Heal, Auto Collect
--    Combat        Kill Aura
--    Boss Select   one toggle per type
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v3.4"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local HP_LOG_RATE  = 5.0
local COLLECT_RATE = 1.5
local AURA_RATE    = 0.2
local ATK_TTL      = 0.5
local MOVE_EPS2    = 1

local BOSS_TYPES = {
    "Common", "Uncommon", "Rare", "Legendary",
    "Mythical", "Divine", "Secret", "Epic",
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Aura        = false,
}

local TOGGLES     = {}
local getterWorks = {}

local selectedBoss = nil

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") or nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function fmt(p)
    return tostring(math.floor(p.X)) .. ","
        .. tostring(math.floor(p.Y)) .. ","
        .. tostring(math.floor(p.Z))
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--   Tool_Character_<userId>_<n>_<m>.Events.Attack
--   <n> changes on a weapon upgrade, so the cache expires and the
--   cached remote must still have a live parent chain.
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local first = atkCache[1]
        local p1 = first and first.Parent
        local p2 = p1 and p1.Parent
        if p1 and p2 then
            return atkCache
        end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- Area / boss lookup
--------------------------------------------------------------------
local function areaModel(bossType)
    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return nil end
    return areas:FindFirstChild(bossType .. "Area")
end

local function modelPoint(model)
    if not model then return nil, nil end

    local pp = model.PrimaryPart
    if pp then
        local ok, p = pcall(function() return pp.Position end)
        if ok and p then return p, pp.Name end
    end

    local names = { "Head", "HumanoidRootPart", "Root" }
    for i = 1, #names do
        local part = model:FindFirstChild(names[i])
        if part then
            local ok, p = pcall(function() return part.Position end)
            if ok and p then return p, part.Name end
        end
    end

    return nil, nil
end

local function bossModelIn(area)
    if not area then return nil end

    local kids = area:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c.ClassName == "Model" and string.find(c.Name, "Mama", 1, true) then
            return c
        end
    end
    return nil
end

local function spotFor(bossType)
    local area = areaModel(bossType)
    if not area then return nil, "no area" end

    local boss = bossModelIn(area)
    local pos, partName = modelPoint(boss)
    if pos then
        return pos, boss.Name .. "." .. tostring(partName)
    end

    local floor = area:FindFirstChild("Area")
    if floor then
        local ok, p = pcall(function() return floor.Position end)
        if ok and p then return p, "Area floor" end
    end

    return nil, "no part"
end

local function nearestBoss(myPos)
    local bestPos, bestLabel, bestD = nil, nil, 1e9

    for i = 1, #BOSS_TYPES do
        local t    = BOSS_TYPES[i]
        local area = areaModel(t)
        local boss = bossModelIn(area)
        local pos, partName = modelPoint(boss)
        if pos then
            local d = (pos - myPos).Magnitude
            if d < bestD then
                bestD     = d
                bestPos   = pos
                bestLabel = boss.Name .. "." .. tostring(partName)
            end
        end
    end

    return bestPos, bestLabel
end

local function moveTo(hrp, pos)
    if not hrp or not hrp.Parent or not pos then return false end
    if not alive() then return false end

    local p  = hrp.Position
    local dx = p.X - pos.X
    local dy = p.Y - pos.Y
    local dz = p.Z - pos.Z

    if (dx * dx + dy * dy + dz * dz) <= MOVE_EPS2 then return false end

    pcall(function() hrp.CFrame = CFrame.new(pos.X, pos.Y, pos.Z) end)
    return true
end

-- called when a boss toggle flips ON
local function selectBoss(bossType)
    selectedBoss = bossType

    local hrp = rootPart()
    if not hrp or not alive() then
        print("[" .. NAME .. "] selected " .. bossType .. " (no character)")
        notifyUser("Selected " .. bossType, 2)
        return
    end

    local pos, label = spotFor(bossType)
    if not pos then
        print("[" .. NAME .. "] selected " .. bossType
            .. " but no spot: " .. tostring(label))
        notifyUser("Selected " .. bossType .. " (no spot)", 3)
        return
    end

    pcall(function() hrp.CFrame = CFrame.new(pos.X, pos.Y, pos.Z) end)
    print("[" .. NAME .. "] go " .. bossType .. " via " .. label
        .. " " .. fmt(pos))
    notifyUser("Go " .. bossType, 2)
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name, boss)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name, boss = boss }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default, boss)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label, boss)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Kill Aura", "fam_aura", "Aura", false)
        end

        local pick = makeSection(tab, "Boss Select", "Right")
        if pick then
            for i = 1, #BOSS_TYPES do
                local t   = BOSS_TYPES[i]
                local key = "Sel" .. t
                local id  = "fam_go_" .. string.lower(t)
                addToggle(pick, "Go " .. t, id, key, false, t)
            end
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--   Rising edge on a boss toggle selects and teleports.
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true

                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))

                    if t.boss then
                        if val then
                            selectBoss(t.boss)
                        elseif selectedBoss == t.boss then
                            selectedBoss = nil
                            print("[" .. NAME .. "] selection cleared")
                        end
                    end
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0
    local lastLog     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                local max = math.floor(hum.MaxHealth)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax
                        and (now - lastLog) >= HP_LOG_RATE then
                        print("[" .. NAME .. "] max health " .. tostring(max))
                        lastLog = now
                    end
                    lastMax = max
                end

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL AURA
--   Swings every pass. Uses the selected boss if there is one,
--   otherwise the nearest boss model, otherwise just swings here.
--------------------------------------------------------------------
task.spawn(function()
    local lastLabel = nil

    while running do
        if Config.Aura then
            local hrp = rootPart()
            if hrp and alive() then
                local pos, label

                if selectedBoss then
                    pos, label = spotFor(selectedBoss)
                    if pos then
                        label = selectedBoss .. " (" .. tostring(label) .. ")"
                    end
                end

                if not pos then
                    pos, label = nearestBoss(hrp.Position)
                end

                if pos then
                    moveTo(hrp, pos)
                    if label ~= lastLabel then
                        lastLabel = label
                        print("[" .. NAME .. "] aura -> " .. tostring(label))
                    end
                else
                    lastLabel = nil
                end

                swing()
            end
        end
        task.wait(AURA_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache = nil
    selectedBoss = nil
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - pick a boss under Boss Select", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
