local function needsWeaponRaw()
    local c = LP.Character
    if not c then return false end

    local ok, kids = pcall(function() return c:GetChildren() end)
    if not ok or not kids then return false end

    for i = 1, #kids do
        local t = kids[i]
        if t.ClassName == 'Tool' then
            if attackPartOf(t) then return false end
            if itemTypeOf(t) == 'Egg' then return false end
        end
    end

    return true
end

local function backpackHasWeaponRaw()
    local bp = LP:FindFirstChild('Backpack')
    if not bp then return false end

    local ok, kids = pcall(function() return bp:GetChildren() end)
    if not ok or not kids then return false end

    for i = 1, #kids do
        local t = kids[i]
        if t.ClassName == 'Tool' and attackPartOf(t) then return true end
    end

    return false
end

local function weaponState()
    local now = tick()

    if wepMemo and (now - wepMemoAt) < MEMO_WEP then
        return wepMemo.needs, wepMemo.has
    end

    local needs = needsWeaponRaw()
    local has   = backpackHasWeaponRaw()

    wepMemo   = { needs = needs, has = has }
    wepMemoAt = now

    return needs, has
end

local function handSignature()
    local c = LP.Character
    if not c then return '' end

    local ok, kids = pcall(function() return c:GetChildren() end)
    if not ok or not kids then return '' end

    local s = ''

    for i = 1, #kids do
        if kids[i].ClassName == 'Tool' then
            s = s .. kids[i].Name .. '|'
        end
    end

    return s
end

local function killCharacter()
    if type(memory_write) ~= 'function' then return false, 'no memory_write' end

    local hum = humanoid()
    if not hum then return false, 'no humanoid' end

    local okA, addr = pcall(function() return hum.Address end)
    if not okA or type(addr) ~= 'number' then return false, 'no Address' end

    local ok = pcall(function()
        memory_write('float', addr + healthOffset, -10)
    end)

    if not ok then return false, 'write failed' end
    return true, nil
end

local function myBasePartRaw()
    local ok, desc = pcall(function() return WS:GetDescendants() end)
    if not ok or not desc then return nil end

    local best     = nil
    local bestArea = -1

    for i = 1, #desc do
        local d = desc[i]

        if d.Name == 'BasePart' then
            local cur    = d
            local mine   = false
            local isBase = false

            for lvl = 1, 3 do
                cur = cur.Parent
                if not cur then break end

                if string.find(cur.Name, 'Base', 1, true) then isBase = true end

                local pl = cur:FindFirstChild('Player')
                if pl then
                    local okV, v = pcall(function() return pl.Value end)
                    if okV and v == LP then mine = true end
                    break
                end
            end

            if mine and isBase then
                local okS, sz = pcall(function() return d.Size end)
                local area = 0

                if okS and sz and type(sz.X) == 'number' and type(sz.Z) == 'number' then
                    area = sz.X * sz.Z
                end

                if area > bestArea then
                    bestArea = area
                    best     = d
                end
            end
        end
    end

    return best
end

local function myBasePart()
    local now = tick()
    if baseMemo and (now - baseMemoAt) < MEMO_BASE then return baseMemo end

    baseMemoAt = now
    baseMemo   = myBasePartRaw()

    return baseMemo
end

local function memoPrune()
    local now = tick()

    for k, v in pairs(apMemo) do
        if (now - v.at) > 10 then apMemo[k] = nil end
    end

    for k, v in pairs(toolMemo) do
        if (now - v.at) > 10 then toolMemo[k] = nil end
    end

    for k, v in pairs(hpMemo) do
        if (now - v.at) > 10 then hpMemo[k] = nil end
    end

    for k, v in pairs(promptMemo) do
        if (now - v.at) > 10 then promptMemo[k] = nil end
    end
end

--------------------------------------------------------------------
-- HIDE UNDER FARM  (sticky anchored float)
--------------------------------------------------------------------
local function unanchorAll()
    for i = 1, #anchored do
        local e = anchored[i]
        if e.part then pcall(function() e.part.Anchored = e.was end) end
    end

    anchored = {}
end

local function anchorAll()
    local c = LP.Character
    if not c then return end

    local ok, desc = pcall(function() return c:GetDescendants() end)
    if not ok or not desc then return end

    for i = 1, #desc do
        local d = desc[i]

        if isBasePart(d) then
            local okA, was = pcall(function() return d.Anchored end)
            anchored[#anchored + 1] = { part = d, was = (okA and was == true) }
            pcall(function() d.Anchored = true end)
        end
    end
end

local function computeSpots()
    local part = myBasePart()
    if not part then return nil, nil end

    local okP, pos = pcall(function() return part.Position end)
    if not okP or not pos then return nil, nil end

    local hide = CFrame.new(pos.X, pos.Y - HIDE_DEPTH, pos.Z)
    local surf = CFrame.new(pos.X, pos.Y + HIDE_LIFT, pos.Z)

    return hide, surf
end

local function stopHideLoop()
    if hideConn then
        pcall(function() hideConn:Disconnect() end)
        hideConn = nil
    end
end

local function surfaceNow()
    local hrp = rootPart()
    if not hrp or not hideSurface then return end

    pcall(function()
        hrp.CFrame = hideSurface
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
end

local function bailHide(why)
    stopHideLoop()
    surfaceNow()
    unanchorAll()

    hideLocked     = true
    hideDeaths     = 0
    hideDeathAt    = {}
    hideHP0        = nil
    hideFallFrames = 0
    hideResetAt    = nil
    hideWarned     = false
    hideRoot       = nil

    print('[' .. NAME .. '] hide under farm off: ' .. why)
    notifyUser('Hide stopped - flip the toggle off and on to retry', 6)
end

local function holdAt(spot)
    local hrp = rootPart()
    if not hrp or not spot then return false end

    if hideRoot ~= hrp then
        hideRoot = hrp
        unanchorAll()
        pcall(function() hrp.CFrame = spot end)
        anchorAll()
    end

    pcall(function()
        hrp.CFrame                  = spot
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)

    return true
end

local function hideFrame()
    if not running or not Config.HideUnder or hideLocked then return end

    if pickingNow then
        if (tick() - pickStartedAt) > TP_MAX then
            pickingNow = false
        else
            return
        end
    end

    if not alive() then
        hideRoot = nil
        unanchorAll()
        return
    end

    local hrp = rootPart()
    if not hrp then return end

    if LP.Character ~= hideChar then
        local ownReset = hideResetAt ~= nil and (tick() - hideResetAt) < RESET_MAX_WAIT

        hideChar       = LP.Character
        hideHP0        = nil
        hideFallFrames = 0
        hideWarned     = false
        hideRoot       = nil
        unanchorAll()

        if ownReset then
            hideResetAt = nil
        else
            local now  = tick()
            local keep = {}

            for i = 1, #hideDeathAt do
                if (now - hideDeathAt[i]) < HIDE_DEATH_W then
                    keep[#keep + 1] = hideDeathAt[i]
                end
            end

            keep[#keep + 1] = now
            hideDeathAt    = keep
            hideDeaths     = #keep

            if hideDeaths >= HIDE_DEATHS then
                bailHide('you died down there ' .. tostring(HIDE_DEATHS)
                    .. ' times in ' .. tostring(math.floor(HIDE_DEATH_W)) .. 's')
                return
            end
        end
    end

    if not hideSpot then
        local now = tick()

        if (now - hideRetryAt) > 1.0 then
            hideRetryAt = now
            hideSpot, hideSurface = computeSpots()
        end

        if not hideSpot then return end
    end

    local hum = humanoid()

    if hum then
        if hideHP0 == nil then hideHP0 = hum.Health end

        if hideHP0 and hideHP0 > 0 and hum.Health < hideHP0 * HIDE_BAIL_HP then
            bailHide('health fell below ' .. tostring(math.floor(HIDE_BAIL_HP * 100)) .. '%')
            return
        end
    end

    holdAt(hideSpot)

    local okP, pos = pcall(function() return hrp.Position end)

    if okP and pos then
        local drift = hideSpot.Position.Y - pos.Y

        if drift > HIDE_TOL then
            hideFallFrames = hideFallFrames + 1

            if hideFallFrames == 60 and not hideWarned then
                hideWarned = true
                print('[' .. NAME .. '] hide: the game keeps moving you - re-writing every frame')
            end
        else
            hideFallFrames = 0
            hideWarned     = false
        end
    end
end

local function startHideLoop()
    if hideConn then return end

    hideConn = RunService.RenderStepped:Connect(function()
        pcall(hideFrame)
    end)
end

local function leaveHide()
    stopHideLoop()
    surfaceNow()
    unanchorAll()

    hideSpot       = nil
    hideSurface    = nil
    hideChar       = nil
    hideRoot       = nil
    hideDeaths     = 0
    hideDeathAt    = {}
    hideHP0        = nil
    hideFallFrames = 0
    hideResetAt    = nil
    hideRetryAt    = 0
    hideWarned     = false

    print('[' .. NAME .. '] hide under farm off (put back on the surface)')
end

--------------------------------------------------------------------
-- HUD  (writes only what changed, never unknown properties)
--------------------------------------------------------------------
local hudPool   = {}
local panelBack = nil
local hudConn   = nil

local function buildHud()
    if #hudPool > 0 then return end

    panelBack = Drawing.new('Square')
    panelBack.Filled       = true
    panelBack.Thickness    = 0
    panelBack.Color        = COL_BACK
    panelBack.Transparency = 0.1
    panelBack.Visible      = false

    for i = 1, PANEL_ROWS do
        local nameTag = Drawing.new('Text')
        nameTag.Text     = ''
        nameTag.Size     = 14
        nameTag.Font     = 2
        nameTag.Center   = false
        nameTag.Outline  = true
        nameTag.Color    = COL_NAME
        nameTag.Visible  = false

        local hpTag = Drawing.new('Text')
        hpTag.Text       = ''
        hpTag.Size       = 13
        hpTag.Font       = 2
        hpTag.Center     = false
        hpTag.Outline    = true
        hpTag.Color      = COL_HP
        hpTag.Visible    = false

        local back = Drawing.new('Square')
        back.Filled      = true
        back.Thickness   = 0
        back.Color       = COL_BAR_BG
        back.Visible     = false

        local fill = Drawing.new('Square')
        fill.Filled      = true
        fill.Thickness   = 0
        fill.Color       = COL_FILL
        fill.Visible     = false

        hudPool[i] = {
            nameTag = nameTag,
            hpTag   = hpTag,
            back    = back,
            fill    = fill,
            shown   = false,
        }
    end
end

local function hideSlot(slot)
    if not slot.shown then return end

    slot.shown           = false
    slot.rowY            = nil
    slot.name            = nil
    slot.hp              = nil
    slot.w               = nil
    slot.nameTag.Visible = false
    slot.hpTag.Visible   = false
    slot.back.Visible    = false
    slot.fill.Visible    = false
end

local function viewportHeight()
    local cam = WS:FindFirstChild('Camera')
    if cam then
        local okV, vp = pcall(function() return cam.ViewportSize end)
        if okV and vp and type(vp.Y) == 'number' and vp.Y > 0 then return vp.Y end
    end
    return 1080
end

local function startHud()
    if hudConn then return end

    buildHud()

    local vpH, vpAt = 1080, 0
    local pbY, pbH  = nil, nil
    local pbOn      = false

    hudConn = RunService.RenderStepped:Connect(function()
        pcall(function()
            local now = tick()

            if (now - vpAt) > 1.0 then
                vpAt = now
                vpH  = viewportHeight()
            end

            local baseY = vpH - PANEL_LIFT
            local list  = bossList()
            local n     = 0

            for i = 1, #list do
                if n >= PANEL_ROWS then break end

                local boss = list[i]
                local hp   = bossHealth(boss)

                if hp and hp > 0 then
                    local maxHp = bossMaxHealth(boss)
                    local frac  = hp / maxHp

                    if frac < 0 then frac = 0 end
                    if frac > 1 then frac = 1 end

                    n = n + 1

                    local slot = hudPool[n]
                    local rowY = baseY - (n - 1) * ROW_H

                    if not slot.shown then
                        slot.shown           = true
                        slot.rowY            = nil
                        slot.name            = nil
                        slot.hp              = nil
                        slot.w               = nil
                        slot.nameTag.Visible = true
                        slot.back.Visible    = true
                        slot.fill.Visible    = true
                        slot.hpTag.Visible   = true
                        slot.back.Size       = Vector2.new(PANEL_BAR_W, PANEL_BAR_H)
                    end

                    if slot.rowY ~= rowY then
                        slot.rowY             = rowY
                        slot.nameTag.Position = Vector2.new(PANEL_X, rowY)
                        slot.back.Position    = Vector2.new(PANEL_X, rowY + 19)
                        slot.fill.Position    = Vector2.new(PANEL_X, rowY + 19)
                        slot.hpTag.Position   = Vector2.new(PANEL_X + PANEL_BAR_W + 10, rowY + 2)
                    end

                    if slot.name ~= boss.Name then
                        slot.name         = boss.Name
                        slot.nameTag.Text = boss.Name
                    end

                    local w = PANEL_BAR_W * frac
                    if slot.w ~= w then
                        slot.w         = w
                        slot.fill.Size = Vector2.new(w, PANEL_BAR_H)
                    end

                    local label = tostring(math.floor(hp))
                        .. ' / ' .. tostring(math.floor(maxHp))

                    if slot.hp ~= label then
                        slot.hp         = label
                        slot.hpTag.Text = label
                    end
                end
            end

            for i = n + 1, PANEL_ROWS do
                local slot = hudPool[i]
                if slot then hideSlot(slot) end
            end

            if not panelBack then return end

            if n > 0 then
                local topY   = baseY - (n - 1) * ROW_H - PAD_TOP
                local height = (n - 1) * ROW_H + ROW_H + PAD_TOP + PAD_BOTTOM

                if not pbOn then
                    pbOn              = true
                    panelBack.Visible = true
                end

                if pbY ~= topY or pbH ~= height then
                    pbY                = topY
                    pbH                = height
                    panelBack.Position = Vector2.new(PANEL_X - PAD_X, topY)
                    panelBack.Size     = Vector2.new(PANEL_W, height)
                end
            elseif pbOn then
                pbOn              = false
                pbY               = nil
                pbH               = nil
                panelBack.Visible = false
            end
        end)
    end)
end

local function stopHud()
    if hudConn then
        pcall(function() hudConn:Disconnect() end)
        hudConn = nil
    end

    for i = 1, #hudPool do
        local slot = hudPool[i]
        pcall(function() slot.nameTag:Remove() end)
        pcall(function() slot.hpTag:Remove() end)
        pcall(function() slot.back:Remove() end)
        pcall(function() slot.fill:Remove() end)
    end

    if panelBack then
        pcall(function() panelBack:Remove() end)
        panelBack = nil
    end

    hudPool = {}
end

startHud()

