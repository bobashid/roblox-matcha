local function readyPrompt(model)
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if not ok or not desc then return nil end

    for i = 1, #desc do
        local d = desc[i]

        if d.ClassName == 'ProximityPrompt' and d.Name ~= 'CarryPrompt' then
            local okA, act = pcall(function() return d.ActionText end)

            if not (okA and act == 'Skip') then
                local okE, en = pcall(function() return d.Enabled end)
                if not okE or en ~= false then return d end
            end
        end
    end

    return nil
end

local function hatchReadyEggs()
    local eggs  = eggList()
    local now   = tick()
    local fired = 0
    local total = 0

    for i = 1, #eggs do
        local m = eggs[i].model
        local k = keyOf(m)

        if k ~= nil then
            local last = hatchFired[k]

            if last == nil or (now - last) >= HATCH_COOLDOWN then
                local prompt = readyPrompt(m)

                if prompt then
                    total = total + 1

                    if pcall(function() fireproximityprompt(prompt) end) then
                        hatchFired[k] = now
                        fired = fired + 1

                        if HATCH_GAP > 0 then task.wait(HATCH_GAP) end
                    end
                end
            end
        end
    end

    return fired, total
end

task.spawn(function()
    local wasOn   = false
    local lastSay = false

    while running do
        if Config.AutoHatch then
            local fired, ready = hatchReadyEggs()

            if fired > 0 then
                if not wasOn then
                    wasOn = true
                    print('[' .. NAME .. '] auto hatch on (' .. tostring(ready) .. ' eggs ready)')
                end
                lastSay = false
            elseif not lastSay then
                lastSay = true
                print('[' .. NAME .. '] auto hatch: waiting for eggs to show a Hatch prompt')
            end

            task.wait(HATCH_RATE)
        else
            if wasOn then
                wasOn = false
                print('[' .. NAME .. '] auto hatch off')
            end

            hatchFired = {}
            lastSay    = false
            task.wait(0.2)
        end
    end
end)

