-- Egg lookup
--------------------------------------------------------------------
local eggCache = {}
local eggStamp = 0

local function collectEggs()
    local out = {}

    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return out end

    local okA, areaKids = pcall(function() return areas:GetChildren() end)
    if not okA or not areaKids then return out end

    for i = 1, #areaKids do
        local area = areaKids[i]
        local ok, kids = pcall(function() return area:GetChildren() end)

        if ok and kids then
            for j = 1, #kids do
                local m = kids[j]

                if m.ClassName == "Model" and string.find(string.lower(m.Name), "egg", 1, true) then
                    local rarity = billboardRarity(m) or areaRarity(area.Name)
                    local id     = mosquitoId(m.Name)
                    local price  = nil

                    if id then price = EGG_PRICE[id] end

                    out[#out + 1] = {
                        model  = m,
                        name   = m.Name,
                        rarity = rarity,
                        price  = price,
                    }
                end
            end
        end
    end

    return out
end

local function eggList()
    local now = tick()
    if (now - eggStamp) < EGG_TTL then return eggCache end

    eggCache = collectEggs()
    eggStamp = now
    return eggCache
end

local function bossPosition(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local r = boss:FindFirstChild("HumanoidRootPart")
    if not r then return nil end

    local ok, p = pcall(function() return r.Position end)
    if ok and p then return p end
    return nil
end

local function bossHealth(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local h = boss:FindFirstChild("Humanoid")
    if not h then return nil end

    local okH, hp = pcall(function() return h.Health end)
    if okH and type(hp) == "number" then return hp end
    return nil
end

local function bossMaxHealth(boss)
    if not boss then return 1 end

    local h = boss:FindFirstChild("Humanoid")
    if not h then return 1 end

    local okM, mv = pcall(function() return h.MaxHealth end)
    if okM and type(mv) == "number" and mv > 0 then return mv end
    return 1
end

local function bossParts(boss)
    local k   = keyOf(boss)
    local now = tick()

    local rec = k and partCache[k]
    if rec and (now - rec.stamp) < PART_TTL then return rec.parts end

    local parts = {}
    local r = boss:FindFirstChild("HumanoidRootPart")

    if r and isBasePart(r) then parts[#parts + 1] = r end

    local ok, desc = pcall(function() return boss:GetDescendants() end)

    if ok and desc then
        for j = 1, #desc do
            if #parts >= TOUCH_PARTS then break end

            local d = desc[j]
            if isBasePart(d) and not SKIP_PART[d.Name] and d ~= r then
                parts[#parts + 1] = d
            end
        end
    end

    if k then partCache[k] = { stamp = now, parts = parts } end
    return parts
end

local function pruneParts()
    local dead = nil

    for k, rec in pairs(partCache) do
        local anyAlive = false

        for j = 1, #rec.parts do
            local p = rec.parts[j]
            local ok, parent = pcall(function() return p and p.Parent end)
            if ok and parent ~= nil then
                anyAlive = true
                break
            end
        end

        if not anyAlive then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do partCache[dead[i]] = nil end
    end
end

local function farthestBoss(myPos)
    local list = bossList()
    local far  = 0
    local seen = 0

    for i = 1, #list do
        local bp = bossPosition(list[i])
        if bp then
            local ok, d = pcall(function() return (bp - myPos).Magnitude end)
            if ok and type(d) == "number" then
                seen = seen + 1
                if d > far then far = d end
            end
        end
    end

    return far, seen
end

--------------------------------------------------------------------
-- ATTACKPART  (the only thing ever written on the tool)
--------------------------------------------------------------------
local apSaved = {}
local reachOn = false

local function attackPartOf(tool)
    if not tool then return nil end

    local ap = tool:FindFirstChild("AttackPart")
    if ap and isBasePart(ap) then return ap end

    local ok, desc = pcall(function() return tool:GetDescendants() end)

    if ok and desc then
        for j = 1, #desc do
            local d = desc[j]
            if isBasePart(d) and d.Name == "AttackPart" then return d end
        end
    end

    return nil
end

local function mapSize()
    local hrp = rootPart()
    if not hrp then return nil, 0 end

    local okM, myPos = pcall(function() return hrp.Position end)
    if not okM or not myPos then return nil, 0 end

    local far, seen = farthestBoss(myPos)

    local side = (far + REACH_PAD) * 2
    if side < REACH_MIN then side = REACH_MIN end
    if side > REACH_MAX then side = REACH_MAX end

    return Vector3.new(side, side, side), seen
end

local function rememberPart(ap)
    local k = keyOf(ap)
    if k == nil then return end

    if apSaved[k] == nil then
        local okS, s = pcall(function() return ap.Size end)
        if okS and s then
            apSaved[k] = { part = ap, size = s }
        end
    end
end

local function restoreAttackParts()
    local n = 0

    for k, e in pairs(apSaved) do
        local p = e.part
        if p then
            pcall(function() p.Size = e.size end)
            n = n + 1
        end
    end

    apSaved = {}

    if reachOn then
        print("[" .. NAME .. "] AttackPart restored on " .. tostring(n))
    end
    reachOn = false
    return n
end

-- any Tool at all in the Character: a weapon, a mosquito, or an egg
-- being carried. The respawn must see none of these.
local function anythingInHand()
    local c = LP.Character
    if not c then return true end

    local ok, kids = pcall(function() return c:GetChildren() end)
    if not ok or not kids then return true end

    for i = 1, #kids do
        if kids[i].ClassName == "Tool" then return true end
    end

    return false
end

-- writes -10 into the health field itself, which is the one thing that
-- actually kills here. Humanoid.Health = 0 and BreakJoints were both
-- measured as no-ops because the server re-syncs the property.
local function killCharacter()
    if type(memory_write) ~= "function" then return false, "no memory_write" end

    local hum = humanoid()
    if not hum then return false, "no humanoid" end

    local okA, addr = pcall(function() return hum.Address end)
    if not okA or type(addr) ~= "number" then return false, "no Address" end

    local ok = pcall(function()
        memory_write("float", addr + healthOffset, -10)
    end)

    if not ok then return false, "write failed" end
    return true, nil
end

