-- AUTO HEALTH
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0

    while running do
        if Config.Heal then
            local hum = humanoid()

            if hum then
                local now = tick()

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent('TransfuseBlood') then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent('StopTransfuseBlood')
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

