--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v4.5
--
--  THE FLOOR WAS BEING GROWN  (why it flung you and why only 3 worked)
--    Workspace.SpawnAreas.<Type>Area is itself a Model. v4.3/v4.4 added
--    every Model under SpawnAreas as a "boss", so each area container
--    was treated as a boss too. That pulled in its Area part (the
--    arena FLOOR) and ChaseArea, grew them x8 and - in v4.4 - turned
--    their CanCollide off. An x8 floor with no collision is exactly
--    the drop/glitch/fling you saw, and the container being handled
--    first is why only the first few areas looked like they worked.
--
--  WHAT COUNTS AS A BOSS NOW
--    A Model is only grown if it looks like a boss itself:
--      - its name contains "Mama", or
--      - it has a DIRECT child Humanoid (the area container only has
--        one deeper down, so it no longer matches)
--    The scan walks every descendant of SpawnAreas, so bosses nested
--    at any depth are found. If SpawnAreas yields nothing it falls
--    back to every "Mama" model in Workspace.
--    Parts named "Area" and "ChaseArea" are never touched, ever.
--
--  HITBOX
--    size = first-seen size * multiplier (x8, x16 with Huge).
--    CanCollide is off while a part is grown so it cannot shove you,
--    and both size and CanCollide go back exactly as they were when
--    Auto Farm goes off or the script stops.
--
--  AUTO SWING
--    Stand still, Attack remote fired every SWING_RATE. No CFrame
--    writes anywhere, no teleports.
--
--  MAIN
--    Always Heal, Auto Collect.
--
--  The boss list is printed whenever it changes, so you can see in the
--  console exactly which models are being expanded.
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v4.5"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local HP_LOG_RATE  = 5.0
local COLLECT_RATE = 1.5
local SWING_RATE   = 0.1
local ATK_TTL      = 1.0
local HB_RATE      = 0.5
local BOSS_TTL     = 2.0

-- hitbox multipliers (plain multiply, no cap)
local HB_MULT      = 8
local HB_MULT_BIG  = 16

-- parts that must never be resized
local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
    HitboxBig   = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

-- a model that has a Humanoid as one of its OWN children
local function hasDirectHumanoid(m)
    local h = m:FindFirstChild("Humanoid")
    return h ~= nil and h.ClassName == "Humanoid"
end

-- a boss, not the area container that holds it
local function looksLikeBoss(m)
    if m.ClassName ~= "Model" then return false end
    if string.find(m.Name, "Mama", 1, true) then return true end
    return hasDirectHumanoid(m)
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes (re-scanned when stale)
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local okAll = true
        for i = 1, #atkCache do
            local r = atkCache[i]
            if not r or not r.Parent then okAll = false break end
        end
        if okAll then return atkCache end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- BOSS SCAN  (boss models only, area containers excluded)
--------------------------------------------------------------------
local bossList  = {}
local bossStamp = 0
local bossKey   = ""

local function addBoss(out, m)
    if not looksLikeBoss(m) then return end
    for i = 1, #out do
        if out[i] == m then return end
    end
    out[#out + 1] = m
end

local function scanBosses()
    local out = {}

    local areas = WS:FindFirstChild("SpawnAreas")
    if areas then
        local ok, desc = pcall(function() return areas:GetDescendants() end)
        if ok and desc then
            for i = 1, #desc do addBoss(out, desc[i]) end
        end
    end

    -- fallback: nothing found under SpawnAreas, look for Mama models anywhere
    if #out == 0 then
        local ok, desc = pcall(function() return WS:GetDescendants() end)
        if ok and desc then
            for i = 1, #desc do
                local d = desc[i]
                if d.ClassName == "Model" and string.find(d.Name, "Mama", 1, true) then
                    addBoss(out, d)
                end
            end
        end
    end

    bossList  = out
    bossStamp = tick()

    local names = {}
    for i = 1, #out do names[i] = out[i].Name end
    local key = table.concat(names, ",")

    if key ~= bossKey then
        bossKey = key
        if #out > 0 then
            print("[" .. NAME .. "] bosses found (" .. tostring(#out) .. "): " .. key)
        else
            print("[" .. NAME .. "] no boss models found")
        end
    end

    return out
end

local function bosses()
    if #bossList > 0 and (tick() - bossStamp) < BOSS_TTL then return bossList end
    return scanBosses()
end

--------------------------------------------------------------------
-- BOSS HITBOX EXPANDER
--   size = first-seen size * multiplier, CanCollide off while grown.
--------------------------------------------------------------------
local hbSaved   = {}   -- part -> original Size
local hbCollide = {}   -- part -> original CanCollide
local hbApplied = 0

local function hbFactor()
    if not Config.Farm then return 0 end
    if Config.HitboxBig then return HB_MULT_BIG end
    return HB_MULT
end

-- forget parts that no longer exist so respawned bosses start clean
local function pruneSaved()
    local dead = nil
    for part in pairs(hbSaved) do
        if not part or not part.Parent then
            dead = dead or {}
            dead[#dead + 1] = part
        end
    end
    if dead then
        for i = 1, #dead do
            hbSaved[dead[i]]   = nil
            hbCollide[dead[i]] = nil
        end
    end
    return dead and #dead or 0
end

local function growPart(d, mult)
    if SKIP_PART[d.Name] then return false end

    local base = hbSaved[d]

    if base == nil then
        -- save size and collision exactly once, before we change them
        local okS, s = pcall(function() return d.Size end)
        if not okS or not s then return false end
        base = s
        hbSaved[d] = s

        local okC, c = pcall(function() return d.CanCollide end)
        hbCollide[d] = (okC and c) and true or false
    end

    pcall(function()
        d.Size = Vector3.new(base.X * mult, base.Y * mult, base.Z * mult)
    end)

    -- a grown part must not shove the player around
    pcall(function() d.CanCollide = false end)

    return true
end

local function applyHitbox(mult)
    local touched = 0
    local list = bosses()

    for i = 1, #list do
        local boss = list[i]
        local okD, desc = pcall(function() return boss:GetDescendants() end)
        if okD and desc then
            for j = 1, #desc do
                local d = desc[j]
                if isBasePart(d) and growPart(d, mult) then
                    touched = touched + 1
                end
            end
        end
    end

    return touched
end

local function restoreHitbox()
    local n = 0

    for part, size in pairs(hbSaved) do
        if part and part.Parent then
            pcall(function() part.Size = size end)

            local c = hbCollide[part]
            if c ~= nil then
                pcall(function() part.CanCollide = c end)
            end
            n = n + 1
        end
    end

    hbSaved   = {}
    hbCollide = {}

    if hbApplied ~= 0 then
        print("[" .. NAME .. "] hitbox restored on " .. tostring(n) .. " parts")
    end
    hbApplied = 0
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Auto Farm (hitbox + swing)", "fam_farm", "Farm", false)
            addToggle(combat, "Huge Hitbox (x16)", "fam_hitbox_big", "HitboxBig", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- HITBOX LOOP  (follows Auto Farm)
--------------------------------------------------------------------
task.spawn(function()
    while running do
        local mult = hbFactor()

        if mult > 0 then
            pruneSaved()
            local n = applyHitbox(mult)
            if n > 0 and hbApplied ~= mult then
                hbApplied = mult
                print("[" .. NAME .. "] hitbox x" .. tostring(mult)
                    .. " on " .. tostring(n) .. " parts (no collide, local)")
            end
        elseif hbApplied ~= 0 then
            restoreHitbox()
        end

        task.wait(HB_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO SWING  (stand still, fire Attack)
--------------------------------------------------------------------
task.spawn(function()
    local wasOn = false
    local warned = false

    while running do
        if Config.Farm then
            if not wasOn then
                wasOn = true
                warned = false
                print("[" .. NAME .. "] auto farm on (swinging)")
            end

            if not swing() and not warned then
                warned = true
                print("[" .. NAME .. "] no Attack remote - equip a weapon")
            end

            task.wait(SWING_RATE)
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto farm off")
            end
            task.wait(0.2)
        end
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0
    local lastLog     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                local max = math.floor(hum.MaxHealth)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax
                        and (now - lastLog) >= HP_LOG_RATE then
                        print("[" .. NAME .. "] max health " .. tostring(max))
                        lastLog = now
                    end
                    lastMax = max
                end

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() restoreHitbox() end)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache = nil
    bossList = {}
    bossKey  = ""
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - Auto Farm: bosses only, no floor", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
