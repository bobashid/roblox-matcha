--------------------------------------------------------------------
local function mosquitoSignature()
    local bp = LP:FindFirstChild('Backpack')
    if not bp then return '' end

    local ok, kids = pcall(function() return bp:GetChildren() end)
    if not ok or not kids then return '' end

    local s = ''

    for i = 1, #kids do
        local t = kids[i]
        if t.ClassName == 'Tool' and itemTypeOf(t) == 'Mosquito' then
            s = s .. t.Name .. '|'
        end
    end

    return s
end

task.spawn(function()
    local wasOn    = false
    local warned   = false
    local lastSig  = nil
    local lastFire = 0

    while running do
        if Config.BestEquip and alive() then
            local now = tick()
            local sig = mosquitoSignature()

            local should = (lastSig == nil)
                or (sig ~= lastSig)
                or ((now - lastFire) >= 30)

            if should then
                lastSig = sig

                if placeBest() then
                    lastFire = now

                    if not wasOn then
                        print('[' .. NAME .. '] auto equip best on (fires when your mosquito list changes)')
                    end

                    wasOn  = true
                    warned = false
                elseif not warned then
                    warned = true
                    print('[' .. NAME .. '] auto equip best: PlaceBest remote not found')
                end
            end

            task.wait(0.5)
        else
            if wasOn then
                wasOn = false
                print('[' .. NAME .. '] auto equip best off')
            end

            warned   = false
            lastSig  = nil
            lastFire = 0
            task.wait(0.2)
        end
    end
end)

