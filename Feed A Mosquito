--==================================================================
--  Feed A Mosquito  |  Chair Health Bonus  (no sitting)
--  Matcha LuaVM  -  built-in menu tab (UI.AddTab)
--
--  FINDINGS
--    Humanoid.Health / MaxHealth are READ-ONLY in Matcha - writing
--    them throws "Unknown property: Health". The chair models carry
--    no health data at all; they are blood-transfusion chairs (a
--    Blood model full of Nozzle parts inside the BeanbagChair).
--    Firing the player's TransfuseBlood remote was measured live:
--    MaxHealth 2999 -> 3029 -> 3079 -> 3089 while standing, with no
--    seat involved.
--
--    So the chair bonus IS the transfusion, and it is a MAX HEALTH
--    gain that keeps stacking while the transfusion runs. A heal
--    that stops at full never earns the bonus - which is why the
--    previous version looked like it did nothing.
--
--  THIS SCRIPT
--    Health Bonus (no sit) : keeps TransfuseBlood running so max HP
--                            keeps climbing. Turning it off fires
--                            StopTransfuseBlood.
--    Stop at Full HP       : optional; pauses while HP is full.
--    Heal Now              : one short transfusion burst.
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v1.3"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local LOOP_RATE = 0.2    -- control loop rate
local POLL_RATE = 0.1    -- toggle poller rate
local REFIRE    = 0.5    -- re-fire if the server drops it

local Config = {
    Bonus    = false,
    StopFull = false,
    Force    = false,
}

local TOGGLES     = {}
local getterWorks = {}

local transfusing = false
local lastFire    = 0

-- remotes, resolved lazily and cached per UserId
local remotes    = nil
local remotesFor = nil

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") or nil
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function getRemotes()
    if remotes and remotesFor == LP.UserId then return remotes end

    local runtime = RS:FindFirstChild("Runtime")
    local actors  = runtime and runtime:FindFirstChild("Actors")
    if not actors then return nil end

    local actor  = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    local events = actor and actor:FindFirstChild("Events")
    if not events then return nil end

    local startR = events:FindFirstChild("TransfuseBlood")
    local stopR  = events:FindFirstChild("StopTransfuseBlood")
    if not startR or not stopR then return nil end

    remotes    = { start = startR, stop = stopR }
    remotesFor = LP.UserId
    return remotes
end

local function fireStart()
    local r = getRemotes()
    if not r then return false end
    return (pcall(function() r.start:FireServer() end))
end

local function fireStop()
    local r = getRemotes()
    if not r then return end
    pcall(function() r.stop:FireServer() end)
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local n = select("#", ...)
        for i = 1, n do
            local v = select(i, ...)
            if type(v) == "boolean" then
                Config[key] = v
                return
            end
        end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function safeButton(sec, name, cb)
    local tries = {
        function() sec:Button(name, cb) end,
        function() sec:Button(name, name .. "_btn", cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Button failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local sec = makeSection(tab, "Chair", "Left")
        if sec then
            if safeToggle(sec, "Health Bonus (no sit)", "fam_bonus",
                false, applyBool("Bonus")) then
                registerToggle("Bonus", "fam_bonus", "Health Bonus (no sit)")
            end
            if safeToggle(sec, "Stop at Full HP", "fam_stopfull",
                false, applyBool("StopFull")) then
                registerToggle("StopFull", "fam_stopfull", "Stop at Full HP")
            end
        end

        local tools = makeSection(tab, "Tools", "Right")
        if tools then
            safeButton(tools, "Heal Now", function()
                print("[" .. NAME .. "] heal now pressed")
                Config.Force = true
            end)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER - single source of truth
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- TRANSFUSION LOOP
--   The bonus is max HP gained while the transfusion runs, so the
--   default keeps it running. Health stays full on its own because
--   the server raises MaxHealth and Health together.
--------------------------------------------------------------------
task.spawn(function()
    local lastMax = 0

    while running do
        local active   = Config.Bonus or Config.Force
        local stopFull = Config.StopFull or Config.Force

        if active then
            local hum = humanoid()
            if hum then
                local hp   = hum.Health
                local max  = hum.MaxHealth
                local full = (max > 0 and hp >= max)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax then
                        print("[" .. NAME .. "] max health "
                            .. tostring(math.floor(lastMax)) .. " -> "
                            .. tostring(math.floor(max)))
                    end
                    lastMax = max
                end

                if stopFull and full then
                    if transfusing then
                        fireStop()
                        transfusing = false
                        print("[" .. NAME .. "] full - paused")
                    end
                    if Config.Force then Config.Force = false end
                else
                    local now = tick()
                    if not transfusing or (now - lastFire) >= REFIRE then
                        if fireStart() then
                            if not transfusing then
                                print("[" .. NAME .. "] transfusion on (max "
                                    .. tostring(math.floor(max)) .. ")")
                            end
                            transfusing = true
                            lastFire    = now
                        end
                    end
                end
            end
        elseif transfusing then
            fireStop()
            transfusing = false
            print("[" .. NAME .. "] transfusion off")
        end

        task.wait(LOOP_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    if transfusing then
        fireStop()
        transfusing = false
    end
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - toggle Health Bonus (no sit)", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
