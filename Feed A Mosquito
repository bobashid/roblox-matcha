--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v5.6  -  "BRING THE HITBOX TO ME"
--
--  Scaling parts at the boss only helps if the swing is resolved
--  against something that actually reaches you. So now one part per
--  boss is turned into a big box AND moved onto your position every
--  pass - the hit target is literally where you are standing.
--
--  "Bring Hitbox To Me" toggle
--    For each boss it picks the largest growable body part, sets it to
--    an absolute BRING_SIZE cube (60 studs), turns its collision off
--    and writes its CFrame to your HumanoidRootPart position. The
--    original CFrame is saved once per part and restored when the
--    toggle goes off or the script stops.
--    If the game drives that part through a joint, the CFrame write is
--    simply overwritten and you still keep the huge size - so this can
--    only help, it cannot make the reach worse.
--
--  "Auto Farm" still grows every body part x100 (x200 with Huge
--  Hitbox), so both routes are active at once.
--
--  WHY THE FLOOR IS SAFE
--    HumanoidRootPart is never grown or moved (it sits on the arena
--    floor and at x100 it swallows it - that was the floor bug), and
--    parts named Area / ChaseArea are skipped by name. Original sizes
--    and CFrames are stored by Address, so nothing is ever applied
--    twice.
--
--  Stand still, Attack fired every 0.1 s, no teleports of your own
--  character, everything restored on toggle off / stop.
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v5.6"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local HP_LOG_RATE  = 5.0
local COLLECT_RATE = 1.5
local SWING_RATE   = 0.1
local ATK_TTL      = 1.0
local HB_RATE      = 0.35

-- hitbox multipliers
local HB_MULT      = 100
local HB_MULT_BIG  = 200
local HB_SKIP_SIZE = 40    -- original axis this big -> scenery, never touched
local BRING_SIZE   = 60    -- absolute size of the box carried to the player

local BOSS_TYPES = {
    "Common", "Uncommon", "Rare", "Legendary",
    "Mythical", "Divine", "Secret", "Epic",
}

-- parts that must never be resized or moved
local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
    HitboxBig   = false,
    Bring       = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

-- Matcha hands back a new proxy for the same part on every scan, so the
-- instance cannot be a table key. Address is stable.
local function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function isGrowable(d)
    if not isBasePart(d) then return false end
    if SKIP_PART[d.Name] then return false end
    if d.Name == "HumanoidRootPart" then return false end
    local okS, s = pcall(function() return d.Size end)
    if not okS or not s then return false end
    if s.X >= HB_SKIP_SIZE or s.Y >= HB_SKIP_SIZE or s.Z >= HB_SKIP_SIZE then
        return false
    end
    return true, s
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes (re-scanned when stale)
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local okAll = true
        for i = 1, #atkCache do
            local r = atkCache[i]
            if not r or not r.Parent then okAll = false break end
        end
        if okAll then return atkCache end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- Boss lookup  (v4.2 area list)
--------------------------------------------------------------------
local function areaModel(bossType)
    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return nil end
    return areas:FindFirstChild(bossType .. "Area")
end

local function bossModelIn(area)
    if not area then return nil end

    local kids = area:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c.ClassName == "Model" and string.find(c.Name, "Mama", 1, true) then
            return c
        end
    end
    return nil
end

local function bossOf(bossType)
    return bossModelIn(areaModel(bossType))
end

--------------------------------------------------------------------
-- BOSS HITBOX EXPANDER
--   size = first-seen size * multiplier, saved once per Address.
--   Root part and arena parts are never touched.
--------------------------------------------------------------------
local hbSaved   = {}   -- address -> { part, size, collide }
local hbApplied = 0

local function hbFactor()
    if not Config.Farm then return 0 end
    if Config.HitboxBig then return HB_MULT_BIG end
    return HB_MULT
end

-- forget parts that no longer exist so respawned bosses start clean
local function pruneSaved()
    local dead = nil
    for k, e in pairs(hbSaved) do
        local gone = false

        if not e.part then
            gone = true
        else
            local ok, parent = pcall(function() return e.part.Parent end)
            if not ok or parent == nil then gone = true end
        end

        if gone then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do hbSaved[dead[i]] = nil end
    end
end

local function growPart(d, mult)
    local okG, s = isGrowable(d)
    if not okG then return false end

    local k = keyOf(d)
    if k == nil then return false end

    local e = hbSaved[k]

    if e == nil then
        -- save the ORIGINAL size exactly once, before anything changes
        local okS, size = pcall(function() return d.Size end)
        if not okS or not size then return false end

        local okC, c = pcall(function() return d.CanCollide end)

        e = {
            part    = d,
            size    = size,
            collide = (okC and c) and true or false,
        }
        hbSaved[k] = e
    end

    pcall(function()
        d.Size = Vector3.new(
            e.size.X * mult,
            e.size.Y * mult,
            e.size.Z * mult
        )
    end)

    -- a grown part must not shove the player around
    pcall(function() d.CanCollide = false end)

    return true
end

local function applyHitbox(mult)
    local touched = 0

    for i = 1, #BOSS_TYPES do
        local boss = bossOf(BOSS_TYPES[i])
        if boss then
            local okD, desc = pcall(function() return boss:GetDescendants() end)
            if okD and desc then
                for j = 1, #desc do
                    local d = desc[j]
                    if growPart(d, mult) then
                        touched = touched + 1
                    end
                end
            end
        end
    end

    return touched
end

local function restoreHitbox()
    local n = 0

    for k, e in pairs(hbSaved) do
        local p = e.part
        if p then
            local ok, parent = pcall(function() return p.Parent end)
            if ok and parent ~= nil then
                pcall(function() p.Size = e.size end)
                pcall(function() p.CanCollide = e.collide end)
                n = n + 1
            end
        end
    end

    hbSaved = {}

    if hbApplied ~= 0 then
        print("[" .. NAME .. "] hitbox restored on " .. tostring(n) .. " parts")
    end
    hbApplied = 0
end

--------------------------------------------------------------------
-- BRING HITBOX TO ME
--   One part per boss becomes a BRING_SIZE cube sitting on the player.
--------------------------------------------------------------------
local bringSaved   = {}   -- address -> { part, cframe }
local bringApplied = false

local function pruneBring()
    local dead = nil
    for k, e in pairs(bringSaved) do
        local gone = false
        if not e.part then
            gone = true
        else
            local ok, parent = pcall(function() return e.part.Parent end)
            if not ok or parent == nil then gone = true end
        end
        if gone then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end
    if dead then
        for i = 1, #dead do bringSaved[dead[i]] = nil end
    end
end

-- biggest growable part of one boss
local function pickCarrier(boss)
    local pick, pickVol = nil, -1

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if not ok or not desc then return nil end

    for j = 1, #desc do
        local d = desc[j]
        local okG, s = isGrowable(d)
        if okG and s then
            local vol = s.X * s.Y * s.Z
            if vol > pickVol then
                pickVol = vol
                pick = d
            end
        end
    end

    return pick
end

local function applyBring()
    local hrp = rootPart()
    if not hrp then return 0 end

    local pos = hrp.Position
    if not pos then return 0 end

    local moved = 0

    for i = 1, #BOSS_TYPES do
        local boss = bossOf(BOSS_TYPES[i])
        if boss then
            local pick = pickCarrier(boss)
            if pick then
                local k = keyOf(pick)
                if k then
                    if bringSaved[k] == nil then
                        local okC, cf = pcall(function() return pick.CFrame end)
                        if okC and cf then
                            bringSaved[k] = { part = pick, cframe = cf }
                        end
                    end

                    pcall(function()
                        pick.Size = Vector3.new(BRING_SIZE, BRING_SIZE, BRING_SIZE)
                        pick.CanCollide = false
                        pick.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
                    end)

                    moved = moved + 1
                end
            end
        end
    end

    return moved
end

local function restoreBring()
    local n = 0

    for k, e in pairs(bringSaved) do
        local p = e.part
        if p then
            local ok, parent = pcall(function() return p.Parent end)
            if ok and parent ~= nil then
                pcall(function() p.CFrame = e.cframe end)
                n = n + 1
            end
        end
    end

    bringSaved = {}

    if bringApplied then
        print("[" .. NAME .. "] carried hitbox returned on " .. tostring(n) .. " parts")
    end
    bringApplied = false
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Auto Farm (hitbox x100 + swing)", "fam_farm", "Farm", false)
            addToggle(combat, "Bring Hitbox To Me", "fam_bring", "Bring", false)
            addToggle(combat, "Huge Hitbox (x200)", "fam_hitbox_big", "HitboxBig", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- HITBOX LOOP  (growth + carried hitbox)
--------------------------------------------------------------------
task.spawn(function()
    while running do
        local mult = hbFactor()

        if mult > 0 then
            pruneSaved()
            local n = applyHitbox(mult)
            if n > 0 and hbApplied ~= mult then
                hbApplied = mult
                print("[" .. NAME .. "] hitbox x" .. tostring(mult)
                    .. " on " .. tostring(n) .. " parts (root skipped, local)")
            end

            if Config.Bring then
                pruneBring()
                local moved = applyBring()
                if moved > 0 and not bringApplied then
                    bringApplied = true
                    print("[" .. NAME .. "] carried hitbox x" .. tostring(moved)
                        .. " boss(es) onto you")
                end
            elseif bringApplied then
                restoreBring()
            end
        elseif hbApplied ~= 0 or bringApplied then
            restoreBring()
            restoreHitbox()
        end

        task.wait(HB_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO SWING  (stand still, fire Attack)
--------------------------------------------------------------------
task.spawn(function()
    local wasOn  = false
    local warned = false

    while running do
        if Config.Farm then
            if not wasOn then
                wasOn  = true
                warned = false
                print("[" .. NAME .. "] auto farm on (swinging)")
            end

            if not swing() and not warned then
                warned = true
                print("[" .. NAME .. "] no Attack remote - equip a weapon")
            end

            task.wait(SWING_RATE)
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto farm off")
            end
            task.wait(0.2)
        end
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0
    local lastLog     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                local max = math.floor(hum.MaxHealth)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax
                        and (now - lastLog) >= HP_LOG_RATE then
                        print("[" .. NAME .. "] max health " .. tostring(max))
                        lastLog = now
                    end
                    lastMax = max
                end

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() restoreBring() end)
    pcall(function() restoreHitbox() end)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache = nil
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - Auto Farm + Bring Hitbox", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
