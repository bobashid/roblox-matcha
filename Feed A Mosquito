--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v7.7  -  COMBINED: BOSS HITBOX + LIVE ACTOR BURST + REACH
--
--  Digging back through the history, the version that reliably landed
--  repeated hits was the boss-hitbox build (v5.7 / v6.1). Later builds
--  dropped it in favour of only scaling AttackPart, and that is when
--  hits started needing a manual swing. So this version runs all three
--  of the pieces that each worked on their own, at the same time:
--
--    1. BOSS BODY GROWTH  (the v5.7 piece)
--         Every body part of every spawned boss is grown so the box
--         spans from the boss to you:
--             mult = (dist + 25) / largestHalf * 1.15   [2 .. 2000]
--         As the boss animates, its grown parts sweep through the tool
--         and each pass over it is a NEW physics contact - which is
--         exactly the thing that fires a hit. HumanoidRootPart is
--         skipped (scaling it is what launched bosses into the void),
--         Area / ChaseArea are skipped, and CanCollide is NEVER
--         written, so walls and floors keep colliding.
--         Sizes are saved per Address and restored on toggle off.
--         A boss is only accepted if its name ends in "Mama" AND it
--         has a Humanoid - no fallback, so Walls is never touched.
--
--    2. LIVE ACTOR BURST  (the v5.7 spam piece, done correctly)
--         PlaySound("SwingSound") + Attack fired BURST times per pass
--         on the tool actor named by the tool's ActorId StringValue.
--         Name-prefix matching picks a dead copy (every equip leaves
--         one behind), which is why earlier remote loops did nothing.
--
--    3. ATTACKPART REACH  (the v6.4 piece)
--         AttackPart scaled to the farthest boss so the tool itself
--         spans the map. Original size restored on toggle off.
--
--  Plus the contact alternation: touch state flips every pass, so
--  every second pass is a brand new contact instead of a repeat the
--  engine ignores.
--
--  NO MOUSE INPUT AT ALL. No click, no press, no PlayAnim, no equip
--  or unequip, nothing reparented - so nothing can crash.
--
--  TOGGLES
--      Auto Health   - TransfuseBlood loop
--      Auto Collect  - CollectIncome / ClaimOfflineIncome
--      Kill Farm     - all three pieces above, every 0.12 s
--
--  Boss HP is summed each pass; one line prints if it stops dropping.
--  Keep a weapon equipped. All toggles start OFF.
--  Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v7.7"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local COLLECT_RATE = 1.5
local HIT_RATE     = 0.12
local TOUCH_PARTS  = 6
local ATK_BURST    = 4
local STALE_LIMIT  = 40

-- boss hitbox tuning
local HB_PAD       = 25
local HB_MULT_MIN  = 2
local HB_MULT_MAX  = 2000
local HB_MAX_AXIS  = 3000

-- attackpart reach tuning
local REACH_PAD    = 30
local REACH_MIN    = 60
local REACH_MAX    = 4000
local BOSS_TTL     = 0.6

local SKIP_PART = {
    Area             = true,
    ChaseArea        = true,
    HumanoidRootPart = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

local function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function sizeDiffers(a, b)
    if not a or not b then return false end
    local eps = 0.5
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    if dx < 0 then dx = -dx end
    if dy < 0 then dy = -dy end
    if dz < 0 then dz = -dz end
    return dx > eps or dy > eps or dz > eps
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- LIVE TOOL ACTOR (resolved through the tool's ActorId)
--------------------------------------------------------------------
local function equippedTool()
    local c = LP.Character
    if not c then return nil end

    local kids = c:GetChildren()
    for i = 1, #kids do
        local t = kids[i]
        if t.ClassName == "Tool" then
            if t:FindFirstChild("ActorId") then return t end
        end
    end

    return nil
end

local function actorIdOf(tool)
    if not tool then return nil end

    local idv = tool:FindFirstChild("ActorId")
    if not idv then return nil end

    local ok, id = pcall(function() return idv.Value end)
    if ok and type(id) == "string" then return id end
    return nil
end

local function remotesOfActor(name)
    if not name then return nil, nil end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil, nil end

    local a = actors:FindFirstChild(name)
    if not a then return nil, nil end

    local ev = a:FindFirstChild("Events")
    if not ev then return nil, nil end

    return ev:FindFirstChild("Attack"), ev:FindFirstChild("PlaySound")
end

local function burst(atk, ps, n)
    if not atk then return end

    for i = 1, n do
        if ps then pcall(function() ps:FireServer("SwingSound") end) end
        pcall(function() atk:FireServer() end)
    end
end

--------------------------------------------------------------------
-- Boss lookup (read only, strict, cached)
--------------------------------------------------------------------
local bossCache = {}
local bossStamp = 0

local function isBossModel(m)
    if not m then return false end
    if m.ClassName ~= "Model" then return false end

    local nm = m.Name
    if type(nm) ~= "string" then return false end
    if string.sub(nm, -4) ~= "Mama" then return false end

    return m:FindFirstChild("Humanoid") ~= nil
end

local function collectBosses()
    local out = {}

    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return out end

    local okA, areaKids = pcall(function() return areas:GetChildren() end)
    if not okA or not areaKids then return out end

    for i = 1, #areaKids do
        local ok, kids = pcall(function() return areaKids[i]:GetChildren() end)

        if ok and kids then
            for j = 1, #kids do
                local m = kids[j]
                if isBossModel(m) then out[#out + 1] = m end
            end
        end
    end

    return out
end

local function bossList()
    local now = tick()
    if (now - bossStamp) < BOSS_TTL then return bossCache end

    bossCache = collectBosses()
    bossStamp = now
    return bossCache
end

local function bossPosition(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local r = boss:FindFirstChild("HumanoidRootPart")
    if not r then return nil end

    local ok, p = pcall(function() return r.Position end)
    if ok and p then return p end
    return nil
end

local function bossHealth(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local h = boss:FindFirstChild("Humanoid")
    if not h then return nil end

    local okH, hp = pcall(function() return h.Health end)
    if okH and type(hp) == "number" then return hp end
    return nil
end

local function farthestBoss(myPos)
    local list = bossList()
    local far  = 0
    local seen = 0

    for i = 1, #list do
        local bp = bossPosition(list[i])
        if bp then
            local ok, d = pcall(function() return (bp - myPos).Magnitude end)
            if ok and type(d) == "number" then
                seen = seen + 1
                if d > far then far = d end
            end
        end
    end

    return far, seen
end

--------------------------------------------------------------------
-- BOSS BODY GROWTH  (the piece that actually lands hits)
--------------------------------------------------------------------
local hbSaved = {}   -- part address -> { part, size, boss }

local function pruneHb()
    local dead = nil

    for k, e in pairs(hbSaved) do
        local gone = false

        if not e.part then
            gone = true
        else
            local ok, parent = pcall(function() return e.part.Parent end)
            if not ok or parent == nil then gone = true end
        end

        if gone then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do hbSaved[dead[i]] = nil end
    end
end

local function restoreHitbox()
    local n = 0

    for k, e in pairs(hbSaved) do
        local p = e.part
        if p then
            local ok, parent = pcall(function() return p.Parent end)
            if ok and parent ~= nil then
                pcall(function() p.Size = e.size end)
                n = n + 1
            end
        end
    end

    hbSaved = {}
    return n
end

local function multFor(dist, maxHalf)
    if maxHalf < 0.5 then maxHalf = 0.5 end

    local m = ((dist + HB_PAD) / maxHalf) * 1.15

    if m < HB_MULT_MIN then m = HB_MULT_MIN end
    if m > HB_MULT_MAX then m = HB_MULT_MAX end

    local cap = HB_MAX_AXIS / (maxHalf * 2)
    if m > cap then m = cap end
    if m < 1 then m = 1 end

    return m
end

-- grows one boss; returns parts touched
local function growBoss(boss, myPos)
    local center = bossPosition(boss)
    if not center then return 0 end

    local okD, dist = pcall(function() return (center - myPos).Magnitude end)
    if not okD or type(dist) ~= "number" then return 0 end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if not ok or not desc then return 0 end

    local entries = {}
    local maxHalf = 0.5

    for j = 1, #desc do
        local d = desc[j]

        if isBasePart(d) and not SKIP_PART[d.Name] then
            local k = keyOf(d)

            if k ~= nil then
                local e = hbSaved[k]

                if e == nil then
                    local okS, s = pcall(function() return d.Size end)
                    if okS and s then
                        e = { part = d, size = s }
                        hbSaved[k] = e
                    end
                end

                if e then
                    entries[#entries + 1] = e

                    local half = math.max(e.size.X, e.size.Y, e.size.Z) * 0.5
                    if half > maxHalf then maxHalf = half end
                end
            end
        end
    end

    if #entries == 0 then return 0 end

    local mult    = multFor(dist, maxHalf)
    local touched = 0

    for j = 1, #entries do
        local e = entries[j]

        local target = Vector3.new(
            e.size.X * mult,
            e.size.Y * mult,
            e.size.Z * mult
        )

        local okCur, cur = pcall(function() return e.part.Size end)

        if not okCur or not cur or sizeDiffers(cur, target) then
            pcall(function() e.part.Size = target end)
        end

        touched = touched + 1
    end

    return touched
end

--------------------------------------------------------------------
-- ATTACKPART REACH
--------------------------------------------------------------------
local apSaved = {}

local function attackPartOf(tool)
    if not tool then return nil end

    local ap = tool:FindFirstChild("AttackPart")
    if ap and isBasePart(ap) then return ap end

    local ok, desc = pcall(function() return tool:GetDescendants() end)
    if ok and desc then
        for j = 1, #desc do
            local d = desc[j]
            if isBasePart(d) and d.Name == "AttackPart" then return d end
        end
    end

    return nil
end

local function scaleAttackPart(ap)
    local hrp = rootPart()
    if not hrp then return end

    local okM, myPos = pcall(function() return hrp.Position end)
    if not okM or not myPos then return end

    local far = farthestBoss(myPos)

    local side = (far + REACH_PAD) * 2
    if side < REACH_MIN then side = REACH_MIN end
    if side > REACH_MAX then side = REACH_MAX end

    local k = keyOf(ap)
    if k == nil then return end

    local e = apSaved[k]
    if e == nil then
        local okS, s = pcall(function() return ap.Size end)
        if not okS or not s then return end
        e = { part = ap, size = s }
        apSaved[k] = e
    end

    local target = Vector3.new(side, side, side)

    local okCur, cur = pcall(function() return ap.Size end)
    if not okCur or not cur or sizeDiffers(cur, target) then
        pcall(function() ap.Size = target end)
    end
end

local function restoreAttackParts()
    local n = 0

    for k, e in pairs(apSaved) do
        local p = e.part
        if p then
            pcall(function() p.Size = e.size end)
            n = n + 1
        end
    end

    apSaved = {}
    return n
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Auto Health", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Kill Farm (hitbox + burst)", "fam_farm", "Farm", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL FARM  (boss hitbox + live actor burst + reach, one pass)
--------------------------------------------------------------------
task.spawn(function()
    local wasOn      = false
    local warnedTool = false
    local warnedAct  = false
    local staleWarn  = false

    local lastSum  = nil
    local stale    = 0
    local cachedId = nil
    local cachedAtk, cachedPs = nil, nil

    while running do
        if Config.Farm and alive() then
            local tool = equippedTool()

            if not tool then
                if not warnedTool then
                    warnedTool = true
                    print("[" .. NAME .. "] kill farm: equip a weapon")
                end
                cachedId, cachedAtk, cachedPs = nil, nil, nil
                task.wait(0.25)
            else
                warnedTool = false

                local id = actorIdOf(tool)

                if id ~= cachedId then
                    cachedId = id
                    cachedAtk, cachedPs = remotesOfActor(id)

                    if cachedAtk then
                        print("[" .. NAME .. "] live actor " .. tostring(id))
                    end
                end

                if not cachedAtk then
                    if not warnedAct then
                        warnedAct = true
                        print("[" .. NAME .. "] kill farm: actor not ready")
                    end
                    cachedId = nil
                    task.wait(0.25)
                else
                    warnedAct = false

                    if not wasOn then
                        wasOn = true
                        print("[" .. NAME .. "] kill farm on (hitbox + burst)")
                    end

                    -- 1. reach on the tool
                    local ap = attackPartOf(tool)
                    if ap then scaleAttackPart(ap) end

                    -- 2. grow every boss body so its parts sweep the tool
                    local hrp = rootPart()
                    local myPos = nil

                    if hrp then
                        local okM, mp = pcall(function() return hrp.Position end)
                        if okM then myPos = mp end
                    end

                    local list  = bossList()
                    local grown = 0
                    local sum   = 0
                    local live  = 0

                    if myPos then
                        pruneHb()

                        for i = 1, #list do
                            local boss = list[i]
                            local hp   = bossHealth(boss)

                            if hp and hp > 0 then
                                sum  = sum + hp
                                live = live + 1
                                grown = grown + growBoss(boss, myPos)
                            end
                        end
                    end

                    -- 3. burst the live actor's own remotes
                    burst(cachedAtk, cachedPs, ATK_BURST)

                    if live == 0 then
                        stale = 0
                        staleWarn = false
                        lastSum = nil
                    elseif lastSum and sum >= lastSum then
                        stale = stale + 1

                        if stale >= STALE_LIMIT and not staleWarn then
                            staleWarn = true
                            print("[" .. NAME .. "] boss HP not dropping - hits not landing")
                        end
                    else
                        stale = 0
                        staleWarn = false
                    end

                    if live > 0 then lastSum = sum end

                    if grown > 0 and not wasOn then
                        print("[" .. NAME .. "] grown parts: " .. tostring(grown))
                    end

                    task.wait(HIT_RATE)
                end
            end
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] kill farm off")
            end

            warnedTool = false
            warnedAct  = false
            stale      = 0
            staleWarn  = false
            lastSum    = nil
            cachedId, cachedAtk, cachedPs = nil, nil, nil

            local n = restoreHitbox()
            local m = restoreAttackParts()

            if n > 0 or m > 0 then
                print("[" .. NAME .. "] restored " .. tostring(n)
                    .. " boss parts, " .. tostring(m) .. " tool parts")
            end

            task.wait(0.1)
        end
    end
end)

--------------------------------------------------------------------
-- AUTO HEALTH
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(restoreHitbox)
    pcall(restoreAttackParts)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    bossCache = {}
    bossStamp = 0
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - hitbox + burst, no mouse input", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
