task.spawn(function()
    local hasPrompt = (type(fireproximityprompt) == "function")

    local warned = false
    local wasOn  = false
    local taken  = 0
    local lastAt = {}
    local diag   = false

    if not hasPrompt then
        print("[" .. NAME .. "] fireproximityprompt missing - re-run the Matcha loader")
    end

    while running do
        if Config.Pickup and hasPrompt and alive() then
            local eggs = eggList()
            local now  = tick()
            local done = false

            for i = 1, #eggs do
                if done then break end

                local egg = eggs[i]

                if PickCfg[egg.rarity] == true then
                    local okP, parent = pcall(function() return egg.model.Parent end)

                    if okP and parent ~= nil then
                        local k = keyOf(egg.model)
                        local ready = true

                        if k ~= nil and lastAt[k] ~= nil then
                            if (now - lastAt[k]) < PICK_COOLDOWN then
                                ready = false
                            end
                        end

                        if ready then
                            local prompt = eggPrompt(egg.model)

                            if prompt then
                                if Config.TPPickup then
                                    local epos = eggPosition(egg.model)
                                    local hrp  = rootPart()

                                    if epos and hrp then
                                        local okH, home = pcall(function() return hrp.CFrame end)

                                        if okH and home then
                                            tpHome = home
                                            tpAway = true

                                            -- the floor was resolving the
                                            -- character back up; with the
                                            -- character's own collision off
                                            -- the write actually holds
                                            noClipOn()

                                            pcall(function()
                                                hrp.CFrame = CFrame.new(
                                                    epos.X,
                                                    epos.Y - TP_DEPTH,
                                                    epos.Z
                                                )
                                            end)

                                            task.wait(TP_SETTLE)

                                            if running and Config.Pickup then
                                                pcall(function()
                                                    fireproximityprompt(prompt)
                                                end)
                                            end

                                            task.wait(TP_HOLD)

                                            local okR, hrp2 = pcall(function() return rootPart() end)
                                            local back = (okR and hrp2) or hrp

                                            pcall(function() back.CFrame = home end)

                                            noClipOff()

                                            tpAway = false
                                            tpHome = nil

                                            done = true
                                            taken = taken + 1
                                            lastPickupAt = tick()

                                            if k ~= nil then lastAt[k] = tick() end

                                            if not diag then
                                                diag = true

                                                local dist = 0
                                                local okD, d = pcall(function()
                                                    return (home.Position - epos).Magnitude
                                                end)
                                                if okD and type(d) == "number" then dist = d end

                                                print("[" .. NAME .. "] tp pickup on "
                                                    .. tostring(egg.name)
                                                    .. "  was " .. tostring(math.floor(dist))
                                                    .. " away")
                                            end
                                        end
                                    end
                                else
                                    pcall(function() fireproximityprompt(prompt) end)
                                    done = true
                                    taken = taken + 1
                                    lastPickupAt = tick()

                                    if k ~= nil then lastAt[k] = tick() end
                                end
                            end
                        end
                    end
                end
            end

            if done then
                warned = false

                if not wasOn then
                    wasOn = true
                    print("[" .. NAME .. "] auto pickup on ("
                        .. (Config.TPPickup and "tp under egg" or "prompt")
                        .. ")")
                end
            elseif not warned then
                warned = true
                print("[" .. NAME .. "] auto pickup: no egg matched an enabled rarity")
            end

            task.wait(PICK_RATE)
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto pickup off (" .. tostring(taken) .. " eggs)")
            end

            pcall(restoreHome)
            pcall(noClipOff)
            task.wait(0.2)
        end
    end
end)

--------------------------------------------------------------------
-- FAST RESPAWN  (memory write, then back to your spot)
--------------------------------------------------------------------
-- Humanoid.Health = 0 and BreakJoints were both measured as no-ops in
-- this game. Writing the health field in memory does work:
--     memory_write("float", hum.Address + 0x184, -10)
--     health 17116448 -> -10, alive false
-- This resets the character the same way dying does, so the game runs
-- its own respawn equip, and then puts you back on the saved CFrame.
--
-- Fires when Farm Kill is on, you are alive, and the Character holds
-- NO Tool at all (no weapon, no carried egg). After FAST_SETTLE of an
-- empty hand, at most once every FAST_COOLDOWN. As soon as the game
-- puts a weapon back in your hand it stops.
task.spawn(function()
    local lastKill   = 0
    local emptySince = nil
    local lastChar   = nil
    local watching   = false

    while running do
        if Config.Farm and alive() then
            if LP.Character ~= lastChar then
                lastChar   = LP.Character
                emptySince = nil
            end

            local now = tick()

            if anythingInHand() then
                emptySince = nil
            else
                if emptySince == nil then emptySince = now end

                if (now - emptySince) >= FAST_SETTLE
                    and (now - lastKill) >= FAST_COOLDOWN
                    and not watching then
                    local hrp = rootPart()
                    local home = nil

                    if hrp then
                        local ok, cf = pcall(function() return hrp.CFrame end)
                        if ok and cf then home = cf end
                    end

                    local okKill, why = killCharacter()

                    if okKill then
                        lastKill   = now
                        emptySince = nil
                        watching   = true

                        print("[" .. NAME .. "] no weapon in hand: resetting")

                        task.spawn(function()
                            local waited = 0

                            while running and waited < FAST_MAX_WAIT do
                                task.wait(0.05)
                                waited = waited + 0.05

                                local c = LP.Character
                                local h = c and c:FindFirstChildOfClass("Humanoid")

                                if c and h and h.Health > 0 then
                                    local r = c:FindFirstChild("HumanoidRootPart")

                                    if r and home then
                                        pcall(function() r.CFrame = home end)
                                    end

                                    print("[" .. NAME .. "] respawned"
                                        .. (home and " - put back on your spot" or ""))

                                    watching = false
                                    return
                                end
                            end

                            if running then
                                print("[" .. NAME .. "] still no new character after "
                                    .. tostring(FAST_MAX_WAIT) .. "s - reset once by hand")
                            end

                            watching = false
                        end)
                    else
                        lastKill = now
                        print("[" .. NAME .. "] reset failed: " .. tostring(why))
                    end
                end
            end
        else
            emptySince = nil
            lastChar   = nil
        end

        task.wait(0.2)
    end
end)

