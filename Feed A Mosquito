local function equippedTool()
    local c = LP.Character
    if not c then return nil end

    local ok, kids = pcall(function() return c:GetChildren() end)
    if not ok or not kids then return nil end

    local anyTool   = nil
    local actorTool = nil

    for i = 1, #kids do
        local t = kids[i]

        if t.ClassName == 'Tool' then
            if attackPartOf(t) then return t end

            if actorTool == nil and t:FindFirstChild('ActorId') then
                actorTool = t
            end

            if anyTool == nil and itemTypeOf(t) ~= 'Egg' then
                anyTool = t
            end
        end
    end

    return actorTool or anyTool
end

local function actorIdOf(tool)
    if not tool then return nil end
    local idv = tool:FindFirstChild('ActorId')
    if not idv then return nil end
    local ok, id = pcall(function() return idv.Value end)
    if ok and type(id) == 'string' then return id end
    return nil
end

local function remotesOfActor(name)
    if not name then return nil, nil end

    local actors = child(RS, 'Runtime', 'Actors')
    if not actors then return nil, nil end

    local a = actors:FindFirstChild(name)
    if not a then return nil, nil end

    local ev = a:FindFirstChild('Events')
    if not ev then return nil, nil end

    return ev:FindFirstChild('Attack'), ev:FindFirstChild('PlaySound')
end

local function actorInfo(tool)
    if not tool then return nil, nil, nil end

    local k   = keyOf(tool)
    local now = tick()

    local rec = k and toolMemo[k]

    if rec then
        local life = rec.atk and MEMO_TOOL or MEMO_FAIL
        if (now - rec.at) < life then return rec.id, rec.atk, rec.ps end
    end

    local id      = actorIdOf(tool)
    local atk, ps = remotesOfActor(id)

    if k then
        toolMemo[k] = { at = now, id = id, atk = atk, ps = ps }
    end

    return id, atk, ps
end

