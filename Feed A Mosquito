local function readToggle(t)
    local form = KEY_FORM[t.key]

    if form == 'id' then
        local ok, v = pcall(function() return UI.GetValue(t.id) end)
        if ok and type(v) == 'boolean' then return v end
        KEY_FORM[t.key] = nil
    elseif form == 'name' then
        local ok, v = pcall(function() return UI.GetValue(t.name) end)
        if ok and type(v) == 'boolean' then return v end
        KEY_FORM[t.key] = nil
    end

    local ok, v = pcall(function() return UI.GetValue(t.id) end)
    if ok and type(v) == 'boolean' then
        KEY_FORM[t.key] = 'id'
        return v
    end

    ok, v = pcall(function() return UI.GetValue(t.name) end)
    if ok and type(v) == 'boolean' then
        KEY_FORM[t.key] = 'name'
        return v
    end

    return nil
end

task.spawn(function()
    local hideWas = false

    while running do
        for i = 1, #TOGGLES do
            local t   = TOGGLES[i]
            local val = readToggle(t)

            if val ~= nil then
                getterWorks[t.key] = true

                if t.key == 'HideUnder' and hideLocked then
                    if val == false then hideLocked = false end
                    val = false
                end

                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print('[' .. NAME .. '] ' .. t.name .. ' = ' .. tostring(val))
                end
            end
        end

        if Config.HideUnder ~= hideWas then
            hideWas = Config.HideUnder

            if Config.HideUnder then
                stopHideLoop()
                unanchorAll()

                baseMemo       = nil
                baseMemoAt     = 0
                hideSpot, hideSurface = computeSpots()

                hideChar       = LP.Character
                hideRoot       = nil
                hideDeaths     = 0
                hideDeathAt    = {}
                hideHP0        = nil
                hideFallFrames = 0
                hideResetAt    = nil
                hideRetryAt    = 0
                hideWarned     = false

                startHideLoop()
            elseif hideLocked then
                stopHideLoop()
                unanchorAll()
            else
                leaveHide()
            end
        end

        for i = 1, #RARITY_IDS do
            local r   = RARITY_IDS[i]
            local val = readToggle(r)

            if val ~= nil then
                getterWorks[r.rarity] = true

                if PickCfg[r.rarity] ~= val then
                    PickCfg[r.rarity] = val
                    print('[' .. NAME .. '] rarity ' .. r.name .. ' = ' .. tostring(val))
                end
            end
        end

        task.wait(POLL_RATE)
    end
end)

