local function noClipOn()
    tpSaved = {}

    local c = LP.Character
    if not c then return end

    local ok, desc = pcall(function() return c:GetDescendants() end)
    if not ok or not desc then return end

    for i = 1, #desc do
        local d  = desc[i]
        local cn = d.ClassName

        if cn == 'Part' or cn == 'MeshPart' then
            local okC, col = pcall(function() return d.CanCollide end)

            if okC and col == true then
                tpSaved[#tpSaved + 1] = { part = d, collide = col }
                pcall(function() d.CanCollide = false end)
            end
        end
    end
end

local function noClipOff()
    for i = 1, #tpSaved do
        local e = tpSaved[i]
        if e.part then pcall(function() e.part.CanCollide = e.collide end) end
    end

    tpSaved = {}
end

local function restoreHome()
    if tpAway and tpHome then
        local hrp = rootPart()
        if hrp then pcall(function() hrp.CFrame = tpHome end) end
    end

    tpAway = false
    tpHome = nil
    pickingNow = false
end

