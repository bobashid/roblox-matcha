-- FARM KILL
--------------------------------------------------------------------
task.spawn(function()
    local hasTouch = (type(firetouchinterest) == "function")

    local wasOn      = false
    local warnedTool = false
    local warnedAct  = false
    local staleWarn  = false
    local noBossWarn = false

    local lastSum  = nil
    local stale    = 0
    local cachedId = nil
    local cachedAtk, cachedPs = nil, nil

    while running do
        if Config.Farm and alive() then
            local tool = equippedTool()

            if not tool then
                if not warnedTool then
                    warnedTool = true
                    print("[" .. NAME .. "] farm kill: equip a weapon")
                end
                cachedId, cachedAtk, cachedPs = nil, nil, nil
                task.wait(0.25)
            else
                warnedTool = false

                local id = actorIdOf(tool)

                if id ~= cachedId then
                    cachedId = id
                    cachedAtk, cachedPs = remotesOfActor(id)

                    if cachedAtk then
                        print("[" .. NAME .. "] live actor " .. tostring(id))
                    end
                end

                local ap = attackPartOf(tool)

                if not ap then
                    if not warnedAct then
                        warnedAct = true
                        print("[" .. NAME .. "] farm kill: no AttackPart on this tool")
                    end
                    cachedId = nil
                    task.wait(0.25)
                else
                    warnedAct = false

                    if not wasOn then
                        wasOn = true
                        print("[" .. NAME .. "] farm kill on (size cycle per pass)")
                    end

                    rememberPart(ap)

                    local big, seen = mapSize()

                    pcall(function()
                        ap.Size = Vector3.new(AP_SMALL, AP_SMALL, AP_SMALL)
                    end)

                    task.wait(AP_HOLD)

                    if big then
                        pcall(function() ap.Size = big end)
                        reachOn = true
                    end

                    local list = bossList()

                    if seen > 0 then
                        noBossWarn = false

                        if hasTouch then
                            pruneParts()

                            for i = 1, #list do
                                local boss = list[i]
                                local hp   = bossHealth(boss)

                                if hp and hp > 0 then
                                    local parts = bossParts(boss)

                                    for j = 1, #parts do
                                        local part = parts[j]
                                        pcall(function()
                                            firetouchinterest(ap, part, 0)
                                        end)
                                    end
                                end
                            end
                        end
                    elseif not noBossWarn then
                        noBossWarn = true
                        print("[" .. NAME .. "] no boss spawned - box kept at minimum")
                    end

                    if cachedAtk then
                        for b = 1, ATK_BURST do
                            if cachedPs then
                                pcall(function() cachedPs:FireServer("SwingSound") end)
                            end
                            pcall(function() cachedAtk:FireServer() end)
                        end
                    end

                    local sum  = 0
                    local live = 0

                    for i = 1, #list do
                        local hp = bossHealth(list[i])
                        if hp and hp > 0 then
                            sum  = sum + hp
                            live = live + 1
                        end
                    end

                    if live == 0 then
                        stale = 0
                        staleWarn = false
                        lastSum = nil
                    elseif lastSum and sum >= lastSum then
                        stale = stale + 1

                        if stale >= STALE_LIMIT and not staleWarn then
                            staleWarn = true
                            print("[" .. NAME .. "] boss HP not dropping - hits not landing")
                        end
                    else
                        stale = 0
                        staleWarn = false
                    end

                    if live > 0 then lastSum = sum end

                    task.wait(HIT_RATE)
                end
            end
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] farm kill off")
            end

            warnedTool = false
            warnedAct  = false
            stale      = 0
            staleWarn  = false
            noBossWarn = false
            lastSum    = nil
            cachedId, cachedAtk, cachedPs = nil, nil, nil

            if reachOn then
                restoreAttackParts()
            end

            task.wait(0.1)
        end
    end
end)

