--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  Always Heal
--    Keeps TransfuseBlood running. Measured live: MaxHealth climbed
--    2999 -> 3029 -> 3079 -> 3089 while standing, no seat involved.
--    Humanoid.Health is READ-ONLY in Matcha (a write throws), so the
--    server remote is the only heal path.
--
--  Auto Feed
--    Each mosquito model carries FeedProgress / Feeding / ActorId and
--    owns a FeedMosquito remote under Runtime.Actors. Fires it for any
--    mosquito below full that is not already feeding. Main income.
--
--  Auto Collect
--    Fires CollectIncome and ClaimOfflineIncome. The server decides
--    what is ready, so a slow loop is enough.
--
--  Auto Upgrade
--    Fires UpgradeSpeed / UpgradeDamage / UpgradeBase. The server
--    rejects anything you cannot afford, so this cannot overspend.
--
--  Auto Sell
--    SellAllEggs / SellAllMosquitoes are RemoteFunctions, invoked on
--    the economy tick. Default off.
--
--  Auto Attack
--    SlapActor fires its Attack remote with no arguments on the tool
--    actor (Tool_Character_<userId>_*). This scans those actors and
--    fires Attack when an enemy model is within range.
--
--  NO VARARGS ANYWHERE - this VM rejects '...' in nested closures.
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v1.8"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1    -- toggle poller
local HEAL_RATE    = 0.2    -- transfusion control
local FEED_RATE    = 0.3    -- mosquito feed pass
local COLLECT_RATE = 1.5    -- income collection
local UPGRADE_RATE = 1.0    -- upgrades
local SELL_RATE    = 5.0    -- selling
local ATTACK_RATE  = 0.25   -- weapon attacks
local ATTACK_RANGE = 60

local Config = {
    Heal        = false,
    AutoFeed    = false,
    AutoCollect = false,
    AutoUpgrade = false,
    AutoSell    = false,
    AutoAttack  = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--   child(a, b, c) replaces any vararg path helper on purpose.
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") or nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

--------------------------------------------------------------------
-- Player actor remotes (Events / Functions)
--   No varargs: none of these remotes take arguments from the client.
--------------------------------------------------------------------
local pEvents = nil
local pFuncs  = nil
local pFor    = nil

local function playerRemotes()
    if pFor == LP.UserId and pEvents then return pEvents, pFuncs end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil, nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil, nil end

    pEvents = actor:FindFirstChild("Events")
    pFuncs  = actor:FindFirstChild("Functions")
    pFor    = LP.UserId

    return pEvents, pFuncs
end

local function fireEvent(name)
    local events = playerRemotes()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

local function invokeFunc(name)
    local _, funcs = playerRemotes()
    local f = funcs and funcs:FindFirstChild(name)
    if not f then return false end
    return (pcall(function() f:InvokeServer() end))
end

--------------------------------------------------------------------
-- My base: the Base<N> whose ActorId mentions my UserId
--------------------------------------------------------------------
local function myBase()
    local bases = child(WS, "SafeZone", "Bases")
    if not bases then return nil end

    local tag = tostring(LP.UserId)
    local kids = bases:GetChildren()
    for i = 1, #kids do
        local b = kids[i]
        local aid = b:FindFirstChild("ActorId")
        local val = aid and aid.Value
        if type(val) == "string" and string.find(val, tag, 1, true) then
            return b
        end
    end
    return nil
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local n = select("#", ...)
        for i = 1, n do
            local v = select(i, ...)
            if type(v) == "boolean" then
                Config[key] = v
                return
            end
        end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Feed", "fam_feed", "AutoFeed", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local econ = makeSection(tab, "Economy", "Left")
        if econ then
            addToggle(econ, "Auto Upgrade", "fam_upgrade", "AutoUpgrade", false)
            addToggle(econ, "Auto Sell", "fam_sell", "AutoSell", false)
        end

        local combat = makeSection(tab, "Combat", "Right")
        if combat then
            addToggle(combat, "Auto Attack", "fam_attack", "AutoAttack", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER - single source of truth
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                if hum.MaxHealth ~= lastMax then
                    if lastMax ~= 0 and hum.MaxHealth > lastMax then
                        print("[" .. NAME .. "] max health "
                            .. tostring(math.floor(lastMax)) .. " -> "
                            .. tostring(math.floor(hum.MaxHealth)))
                    end
                    lastMax = hum.MaxHealth
                end

                local now = tick()
                if not transfusing or (now - lastFire) >= 0.5 then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO FEED
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoFeed then
            local base   = myBase()
            local folder = base and base:FindFirstChild("Mosquitoes")
            if folder then
                local actors = child(RS, "Runtime", "Actors")
                local kids   = folder:GetChildren()

                for i = 1, #kids do
                    local m    = kids[i]
                    local fp   = m:FindFirstChild("FeedProgress")
                    local fg   = m:FindFirstChild("Feeding")
                    local prog = (fp and tonumber(fp.Value)) or 1
                    local busy = (fg and fg.Value) or false

                    if prog < 0.99 and not busy then
                        local aid   = m:FindFirstChild("ActorId")
                        local id    = aid and aid.Value
                        local actor = id and actors
                            and actors:FindFirstChild(tostring(id))
                        local ev    = actor and actor:FindFirstChild("Events")
                        local rem   = ev and ev:FindFirstChild("FeedMosquito")
                        if rem then
                            pcall(function() rem:FireServer() end)
                        end
                    end
                end
            end
        end
        task.wait(FEED_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO UPGRADE
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoUpgrade then
            fireEvent("UpgradeSpeed")
            fireEvent("UpgradeDamage")
            fireEvent("UpgradeBase")
        end
        task.wait(UPGRADE_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO SELL
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoSell then
            invokeFunc("SellAllEggs")
            invokeFunc("SellAllMosquitoes")
        end
        task.wait(SELL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO ATTACK
--   Tool actors are named Tool_Character_<userId>_<n>_<m>. SlapActor
--   fires its Attack remote with no arguments, so do the same.
--------------------------------------------------------------------
task.spawn(function()
    local function attackRemotes()
        local actors = child(RS, "Runtime", "Actors")
        if not actors then return nil end

        local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
        local plen   = #prefix
        local out    = {}
        local kids   = actors:GetChildren()

        for i = 1, #kids do
            local a = kids[i]
            if string.sub(a.Name, 1, plen) == prefix then
                local ev  = a:FindFirstChild("Events")
                local atk = ev and ev:FindFirstChild("Attack")
                if atk then out[#out + 1] = atk end
            end
        end

        return out
    end

    while running do
        if Config.AutoAttack then
            local me = rootPart()
            if me then
                local target = nil
                local best   = ATTACK_RANGE
                local kids   = WS:GetChildren()

                for i = 1, #kids do
                    local d = kids[i]
                    if string.find(d.Name, "Enemy", 1, true) then
                        local part = d:FindFirstChild("HumanoidRootPart")
                            or d:FindFirstChild("Head")
                            or d.PrimaryPart
                        if part then
                            local dist = (part.Position - me.Position).Magnitude
                            if dist <= best then
                                best   = dist
                                target = d
                            end
                        end
                    end
                end

                if target then
                    local list = attackRemotes()
                    if list then
                        for i = 1, #list do
                            pcall(function() list[i]:FireServer() end)
                        end
                    end
                end
            end
        end
        task.wait(ATTACK_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() fireEvent("StopTransfuseBlood") end)
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - all toggles start OFF", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
