--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v4.8
--
--  READ YOUR OWN LOG
--    20:55:49  bosses found (5): Uncommon,Legendary,Rare,Epic,Mosquito
--    20:55:54  bosses found (1): LegendaryMama
--    20:56:09  bosses found (3): Uncommon,Legendary,Mosquito
--    20:56:48    LegendaryMama  parts=0  hp=350000
--    Two separate things are going on:
--    1. The boss list keeps collapsing to one or three. That is the
--       scan only ever seeing what is in the world RIGHT NOW, so
--       every pass threw away the models it had and rebuilt the list
--       from scratch. A boss that streamed out for one second lost
--       its growth until it streamed back in.
--    2. LegendaryMama reports parts=0 with hp=350000. Its body is not
--       on the client at all - the model holds an AnimSaves, a
--       Configuration, a Humanoid, an Animations folder, an ActorId and
--       a Highlight, and nothing else. No local part exists, so there
--       is nothing to grow and nothing for a client-side swing to
--       touch. That one cannot be fixed from here without standing
--       next to it.
--
--  WHAT CHANGED
--    - Boss memory: a model seen once is remembered for 15 seconds.
--      The scan no longer rebuilds from nothing, so a boss that is
--      briefly out of view keeps its grown size and is picked up
--      again the moment its parts return.
--    - Growth re-applied every 0.2s instead of 0.5s, so freshly
--      streamed parts are grown almost immediately.
--    - Damage readout: each boss's health is watched, and the console
--      prints "<boss> -<damage> (<hp>)" whenever a swing lands. That
--      tells you boss by boss which ones are actually being hit,
--      instead of guessing from the kill count.
--
--  EVERYTHING ELSE
--    - size = first-seen size * distance multiplier (x8 base, +1 per
--      12 studs, capped x40; x16 base with Huge Hitbox)
--    - root part grown to at least 14 studs
--    - Area / ChaseArea never resized (that was the floor)
--    - eggs and player characters never touched
--    - CanCollide off while grown, restored with the size
--    - stand still, Attack fired every 0.1s, no CFrame writes
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v4.8"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local HP_LOG_RATE  = 5.0
local COLLECT_RATE = 1.5
local SWING_RATE   = 0.1
local ATK_TTL      = 1.0
local HB_RATE      = 0.2
local BOSS_TTL     = 1.0
local BOSS_MEMORY  = 15.0

-- hitbox tuning
local HB_MULT      = 8
local HB_MULT_BIG  = 16
local HB_MAX       = 40
local HB_PER_STUD  = 12
local HB_ROOT_MIN  = 14

-- parts that must never be resized
local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
    HitboxBig   = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

local function countParts(m)
    local n = 0
    local ok, desc = pcall(function() return m:GetDescendants() end)
    if not ok or not desc then return 0 end
    for i = 1, #desc do
        if isBasePart(desc[i]) then n = n + 1 end
    end
    return n
end

local function isPlayerChar(m)
    if m == LP.Character then return true end
    local ok, plr = pcall(function() return Players:GetPlayerFromCharacter(m) end)
    return ok and plr ~= nil
end

local function hasDirectHumanoid(m)
    local h = m:FindFirstChild("Humanoid")
    return h ~= nil and h.ClassName == "Humanoid"
end

local function looksLikeBoss(m)
    if m.ClassName ~= "Model" then return false end
    if isPlayerChar(m) then return false end
    if string.find(m.Name, "Mama", 1, true) then return true end
    if string.find(m.Name, "Egg", 1, true) then return false end
    return hasDirectHumanoid(m)
end

local function bossHumanoid(m)
    local h = m:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes (re-scanned when stale)
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local okAll = true
        for i = 1, #atkCache do
            local r = atkCache[i]
            if not r or not r.Parent then okAll = false break end
        end
        if okAll then return atkCache end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- BOSS SCAN  (with memory, so the list never collapses)
--------------------------------------------------------------------
local bossSeen = {}   -- model -> last time the scan saw it
local bossStamp = 0
local bossKey   = ""

local function pruneBosses()
    local now = tick()
    for m, t in pairs(bossSeen) do
        if not m or not m.Parent then
            bossSeen[m] = nil
        elseif (now - t) > BOSS_MEMORY then
            bossSeen[m] = nil
        end
    end
end

local function scanBosses()
    local now = tick()
    local areas = WS:FindFirstChild("SpawnAreas")

    if areas then
        local ok, desc = pcall(function() return areas:GetDescendants() end)
        if ok and desc then
            for i = 1, #desc do
                local d = desc[i]
                if looksLikeBoss(d) then bossSeen[d] = now end
            end
        end
    end

    -- nothing ever seen: last resort, Mama models anywhere
    local any = false
    for m in pairs(bossSeen) do any = true break end

    if not any then
        local ok, desc = pcall(function() return WS:GetDescendants() end)
        if ok and desc then
            for i = 1, #desc do
                local d = desc[i]
                if d.ClassName == "Model" and string.find(d.Name, "Mama", 1, true)
                    and not isPlayerChar(d) then
                    bossSeen[d] = now
                end
            end
        end
    end

    pruneBosses()
    bossStamp = now

    local out = {}
    local names = {}
    for m in pairs(bossSeen) do
        out[#out + 1] = m
        names[#names + 1] = m.Name
    end
    table.sort(names)

    local key = table.concat(names, ",")
    if key ~= bossKey then
        bossKey = key
        print("[" .. NAME .. "] bosses tracked (" .. tostring(#out) .. "): " .. key)
    end

    return out
end

local function bosses()
    if (tick() - bossStamp) < BOSS_TTL and bossKey ~= "" then
        local out = {}
        for m in pairs(bossSeen) do out[#out + 1] = m end
        return out
    end
    return scanBosses()
end

local function bossCenter(boss)
    local r = boss:FindFirstChild("HumanoidRootPart")
    if r and r.ClassName == "Part" then
        local ok, p = pcall(function() return r.Position end)
        if ok and p then return p end
    end

    local pp = boss.PrimaryPart
    if pp then
        local ok, p = pcall(function() return pp.Position end)
        if ok and p then return p end
    end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if ok and desc then
        for i = 1, #desc do
            local d = desc[i]
            if isBasePart(d) then
                local okP, p = pcall(function() return d.Position end)
                if okP and p then return p end
            end
        end
    end

    return nil
end

local function multFor(boss)
    local base = HB_MULT
    if Config.HitboxBig then base = HB_MULT_BIG end

    local hrp = rootPart()
    local c   = bossCenter(boss)
    if not hrp or not c then return base end

    local d = (c - hrp.Position).Magnitude
    local m = base + math.floor(d / HB_PER_STUD)
    if m > HB_MAX then m = HB_MAX end
    if m < base then m = base end
    return m
end

local function reportBosses()
    local list = scanBosses()
    print("[" .. NAME .. "] boss report (" .. tostring(#list) .. ")")

    for i = 1, #list do
        local m  = list[i]
        local hp = "?"

        local h = bossHumanoid(m)
        if h then
            local okH, v = pcall(function() return h.Health end)
            if okH and type(v) == "number" then hp = tostring(math.floor(v)) end
        end

        local parts = countParts(m)
        local note  = ""
        if parts == 0 then note = "  (no parts on client - cannot grow)" end

        print("  " .. m.Name .. "  parts=" .. tostring(parts)
            .. "  hp=" .. hp .. "  mult=x" .. tostring(multFor(m)) .. note)
    end
end

--------------------------------------------------------------------
-- BOSS HITBOX EXPANDER
--------------------------------------------------------------------
local hbSaved   = {}
local hbCollide = {}
local hbApplied = 0

local function hbFactor()
    if not Config.Farm then return 0 end
    if Config.HitboxBig then return HB_MULT_BIG end
    return HB_MULT
end

local function pruneSaved()
    local dead = nil
    for part in pairs(hbSaved) do
        if not part or not part.Parent then
            dead = dead or {}
            dead[#dead + 1] = part
        end
    end
    if dead then
        for i = 1, #dead do
            hbSaved[dead[i]]   = nil
            hbCollide[dead[i]] = nil
        end
    end
end

local function growPart(d, mult, isRoot)
    if SKIP_PART[d.Name] then return false end

    local base = hbSaved[d]

    if base == nil then
        local okS, s = pcall(function() return d.Size end)
        if not okS or not s then return false end
        base = s
        hbSaved[d] = s

        local okC, c = pcall(function() return d.CanCollide end)
        hbCollide[d] = (okC and c) and true or false
    end

    local nx = base.X * mult
    local ny = base.Y * mult
    local nz = base.Z * mult

    if isRoot then
        if nx < HB_ROOT_MIN then nx = HB_ROOT_MIN end
        if ny < HB_ROOT_MIN then ny = HB_ROOT_MIN end
        if nz < HB_ROOT_MIN then nz = HB_ROOT_MIN end
    end

    pcall(function()
        d.Size = Vector3.new(nx, ny, nz)
    end)

    pcall(function() d.CanCollide = false end)

    return true
end

local function applyHitbox()
    local touched = 0
    local list = bosses()

    for i = 1, #list do
        local boss = list[i]
        if boss and boss.Parent then
            local mult = multFor(boss)

            local okD, desc = pcall(function() return boss:GetDescendants() end)
            if okD and desc then
                for j = 1, #desc do
                    local d = desc[j]
                    if isBasePart(d) then
                        local isRoot = (d.Name == "HumanoidRootPart") or (boss.PrimaryPart == d)
                        if growPart(d, mult, isRoot) then touched = touched + 1 end
                    end
                end
            end
        end
    end

    return touched
end

local function restoreHitbox()
    local n = 0

    for part, size in pairs(hbSaved) do
        if part and part.Parent then
            pcall(function() part.Size = size end)

            local c = hbCollide[part]
            if c ~= nil then
                pcall(function() part.CanCollide = c end)
            end
            n = n + 1
        end
    end

    hbSaved   = {}
    hbCollide = {}

    if hbApplied ~= 0 then
        print("[" .. NAME .. "] hitbox restored on " .. tostring(n) .. " parts")
    end
    hbApplied = 0
end

--------------------------------------------------------------------
-- DAMAGE WATCH  (tells you which bosses swings actually land on)
--------------------------------------------------------------------
local lastHp = {}

local function watchDamage()
    for m in pairs(bossSeen) do
        if m and m.Parent then
            local h = bossHumanoid(m)
            if h then
                local ok, v = pcall(function() return h.Health end)
                if ok and type(v) == "number" then
                    local prev = lastHp[m]
                    if prev and v < prev - 0.5 then
                        print("[" .. NAME .. "] " .. m.Name .. " -"
                            .. tostring(math.floor(prev - v))
                            .. " (" .. tostring(math.floor(v)) .. ")")
                    end
                    lastHp[m] = v
                end
            end
        else
            lastHp[m] = nil
        end
    end
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function safeButton(sec, name, id, cb)
    local tries = {
        function() sec:Button(name, cb) end,
        function() sec:Button(name, id, cb) end,
        function() sec:Button(id, name, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Button failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Auto Farm (hitbox + swing)", "fam_farm", "Farm", false)
            addToggle(combat, "Huge Hitbox (x16 base)", "fam_hitbox_big", "HitboxBig", false)
            safeButton(combat, "Print Boss List", "fam_bosslist", function()
                reportBosses()
                notifyUser("Boss list printed to console", 4)
            end)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- HITBOX LOOP
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if hbFactor() > 0 then
            pruneSaved()
            local n = applyHitbox()
            if n > 0 and hbApplied == 0 then
                hbApplied = 1
                print("[" .. NAME .. "] hitbox on " .. tostring(n)
                    .. " parts (distance scaled, no collide, local)")
            end
        elseif hbApplied ~= 0 then
            restoreHitbox()
        end

        task.wait(HB_RATE)
    end
end)

--------------------------------------------------------------------
-- DAMAGE WATCH LOOP
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Farm then watchDamage() end
        task.wait(0.25)
    end
end)

--------------------------------------------------------------------
-- AUTO SWING
--------------------------------------------------------------------
task.spawn(function()
    local wasOn = false
    local warned = false

    while running do
        if Config.Farm then
            if not wasOn then
                wasOn = true
                warned = false
                print("[" .. NAME .. "] auto farm on (swinging)")
            end

            if not swing() and not warned then
                warned = true
                print("[" .. NAME .. "] no Attack remote - equip a weapon")
            end

            task.wait(SWING_RATE)
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto farm off")
            end
            task.wait(0.2)
        end
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0
    local lastLog     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                local max = math.floor(hum.MaxHealth)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax
                        and (now - lastLog) >= HP_LOG_RATE then
                        print("[" .. NAME .. "] max health " .. tostring(max))
                        lastLog = now
                    end
                    lastMax = max
                end

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() restoreHitbox() end)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache  = nil
    bossSeen  = {}
    lastHp    = {}
    bossKey   = ""
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - Auto Farm + damage readout", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
