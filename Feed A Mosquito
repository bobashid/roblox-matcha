--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v2.6  MINIMAL MENU - four toggles, no sliders
--
--    Always Heal   TransfuseBlood remote. Humanoid.Health is
--                  READ-ONLY in Matcha (a write throws), so the
--                  server remote is the only heal path.
--    Auto Collect  CollectIncome + ClaimOfflineIncome.
--    Auto Farm     Swings on a cadence, no target needed.
--    Kill Aura     Finds the nearest enemy anywhere on the map, moves
--                  to the slot under it, swings, repeats.
--
--  Swing
--    Fires Runtime.Actors.Tool_Character_<userId>_*..Events.Attack.
--    Attack takes no arguments, the server resolves the hit from the
--    character position, so there is no client-side hitbox to grow.
--    The remote cache expires every 0.5s and the cached remote must
--    still have a live parent chain, so a weapon upgrade is picked up.
--
--  Fixed values (no UI on purpose)
--    AURA_DEPTH = 8   studs below the target, so you swing from under
--                     the map. Edit the constant to change it.
--    MOVE_EPS2  = 4   only write CFrame when more than 2 studs away.
--    No CFrame writes while Health is 0.
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v2.6"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1    -- toggle poller
local HEAL_RATE    = 0.25   -- transfusion control loop
local HEAL_REFIRE  = 1.0    -- seconds between TransfuseBlood fires
local COLLECT_RATE = 1.5    -- income collection
local FARM_RATE    = 0.3    -- auto farm swing cadence
local AURA_RATE    = 0.25   -- kill aura pass
local ATK_TTL      = 0.5    -- attack remote cache lifetime
local MOVE_EPS2    = 4      -- 2 studs squared
local AURA_DEPTH   = 8      -- studs below the target
local AURA_MAX     = 1000000 -- reaches the whole map

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
    Aura        = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") or nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--   Tool_Character_<userId>_<n>_<m>.Events.Attack
--   <n> changes on a weapon upgrade, so the cache expires and the
--   cached remote must still have a live parent chain.
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local first = atkCache[1]
        local p1 = first and first.Parent
        local p2 = p1 and p1.Parent
        if p1 and p2 then
            return atkCache
        end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- Nearest enemy
--   Models are named <Area>Area_Enemy_<n>, e.g. CommonArea_Enemy_129,
--   Egg_EpicArea_Enemy_132_0, DivineArea_Enemy_9.
--------------------------------------------------------------------
local function enemyPart(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Head")
        or model.PrimaryPart
end

local function nearestEnemy(fromPos, maxDist)
    local best, bestDist, bestPos = nil, maxDist, nil
    local kids = WS:GetChildren()

    for i = 1, #kids do
        local d = kids[i]
        if string.find(d.Name, "Area_Enemy", 1, true) then
            local part = enemyPart(d)
            if part then
                local pos  = part.Position
                local dist = (pos - fromPos).Magnitude
                if dist <= bestDist then
                    best, bestDist, bestPos = d, dist, pos
                end
            end
        end
    end

    return best, bestPos
end

local function moveTo(hrp, x, y, z)
    if not hrp or not hrp.Parent then return false end
    if not alive() then return false end

    local p  = hrp.Position
    local dx = p.X - x
    local dy = p.Y - y
    local dz = p.Z - z

    if (dx * dx + dy * dy + dz * dz) <= MOVE_EPS2 then
        return false
    end

    pcall(function() hrp.CFrame = CFrame.new(x, y, z) end)
    return true
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Auto Farm", "fam_farm", "Farm", false)
            addToggle(combat, "Kill Aura", "fam_aura", "Aura", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                if hum.MaxHealth ~= lastMax then
                    if lastMax ~= 0 and hum.MaxHealth > lastMax then
                        print("[" .. NAME .. "] max health "
                            .. tostring(math.floor(lastMax)) .. " -> "
                            .. tostring(math.floor(hum.MaxHealth)))
                    end
                    lastMax = hum.MaxHealth
                end

                local now = tick()
                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO FARM
--   Fixed cadence, no target required.
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Farm then
            swing()
        end
        task.wait(FARM_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL AURA
--   Nearest enemy anywhere on the map, sit AURA_DEPTH below it, swing.
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Aura then
            local hrp = rootPart()
            if hrp and alive() then
                local target, pos = nearestEnemy(hrp.Position, AURA_MAX)
                if target and pos then
                    moveTo(hrp, pos.X, pos.Y - AURA_DEPTH, pos.Z)
                    swing()
                end
            end
        end
        task.wait(AURA_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache = nil
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - all toggles start OFF", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
