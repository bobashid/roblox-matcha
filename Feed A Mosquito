--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  Always Heal
--    Keeps TransfuseBlood running. Humanoid.Health is READ-ONLY in
--    Matcha (a write throws), so the server remote is the only path.
--    Refire slowed to 1s to cut remote volume.
--
--  Auto Feed
--    FeedMosquito remote per mosquito model, skipped when full/busy.
--
--  Auto Collect
--    CollectIncome + ClaimOfflineIncome.
--
--  Auto Attack
--    Fires the tool actor's Attack remote:
--      Runtime.Actors.Tool_Character_<userId>_<n>_<m>.Events.Attack
--    Attack takes NO arguments, the server resolves the hit.
--
--  WEAPON SWAP FIX (v2.3)
--    The old build cached the Attack remote list forever. Upgrading a
--    weapon destroys the old Tool_Character_<id>_<n>_<m> actor and
--    creates a new one, so the cache kept firing a dead remote and
--    auto kill silently stopped. The cache now expires every 0.75s and
--    is also dropped when the equipped tool name changes.
--
--  CRASH MITIGATION (v2.3)
--    - CFrame is only written when you are more than 2 studs from the
--      target slot, instead of every pass. CFrame writes are the
--      expensive operation here (thousands of internal writes each).
--    - No CFrame writes while Health is 0 (dead / respawning).
--    - All remote and position calls stay inside pcall.
--    - Swing rates reduced (0.3s normal, 0.25s kill, 1s heal refire).
--    - Actor folder is scanned at most every 0.75s, not per swing.
--
--  Auto Kill
--    Stays attached to the chosen boss, swings, restores your CFrame
--    when switched off.
--
--  Under Map
--    Places you Depth studs BELOW the boss. Depth 0 = level with it.
--
--  Bosses
--    One toggle per area prefix (Common, Uncommon, Rare, Legendary,
--    Mythical, Divine, Secret, Epic).
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v2.3"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1    -- toggle poller
local HEAL_RATE    = 0.25   -- transfusion control loop
local HEAL_REFIRE  = 1.0    -- seconds between TransfuseBlood fires
local FEED_RATE    = 0.35   -- mosquito feed pass
local COLLECT_RATE = 1.5    -- income collection
local ATTACK_RATE  = 0.3    -- normal weapon swings
local AFAR_RATE    = 0.7    -- touch-and-return pass
local KILL_RATE    = 0.25   -- stay-attached kill pass
local ATK_TTL      = 0.75   -- attack remote cache lifetime
local MOVE_EPS2    = 4      -- 2 studs squared

local BOSS_NAMES = {
    "Common", "Uncommon", "Rare", "Legendary",
    "Mythical", "Divine", "Secret", "Epic",
}

local Config = {
    Heal        = false,
    AutoFeed    = false,
    AutoCollect = false,
    AutoAttack  = false,
    Afar        = false,
    AfarRange   = 300,
    Kill        = false,
    Under       = true,
    Depth       = 8,
    KillRange   = 1500,

    BossCommon    = true,
    BossUncommon  = true,
    BossRare      = true,
    BossLegendary = true,
    BossMythical  = true,
    BossDivine    = true,
    BossSecret    = true,
    BossEpic      = true,
}

local TOGGLES     = {}
local getterWorks = {}

local savedCF = nil
local killing = false

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") or nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

-- alive check: blocks position writes while dead or respawning
local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

--------------------------------------------------------------------
-- Player actor remotes (Events / Functions)
--------------------------------------------------------------------
local pEvents = nil
local pFuncs  = nil
local pFor    = nil

local function playerRemotes()
    if pFor == LP.UserId and pEvents then return pEvents, pFuncs end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil, nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil, nil end

    pEvents = actor:FindFirstChild("Events")
    pFuncs  = actor:FindFirstChild("Functions")
    pFor    = LP.UserId

    return pEvents, pFuncs
end

local function fireEvent(name)
    local events = playerRemotes()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- My base: the Base<N> whose ActorId mentions my UserId
--------------------------------------------------------------------
local function myBase()
    local bases = child(WS, "SafeZone", "Bases")
    if not bases then return nil end

    local tag = tostring(LP.UserId)
    local kids = bases:GetChildren()
    for i = 1, #kids do
        local b = kids[i]
        local aid = b:FindFirstChild("ActorId")
        local val = aid and aid.Value
        if type(val) == "string" and string.find(val, tag, 1, true) then
            return b
        end
    end
    return nil
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--   Tool_Character_<userId>_<n>_<m>.Events.Attack
--   The <n> changes when you upgrade a weapon, so this list EXPIRES.
--------------------------------------------------------------------
local atkCache = nil
local atkFor   = nil
local atkStamp = 0
local atkTool  = nil

local function equippedToolName()
    local c = LP.Character
    local t = c and c:FindFirstChildOfClass("Tool")
    return t and t.Name or nil
end

local function attackRemotes()
    local now  = tick()
    local tool = equippedToolName()

    local fresh = atkCache
        and atkFor == LP.UserId
        and #atkCache > 0
        and (now - atkStamp) < ATK_TTL
        and tool == atkTool

    if fresh then return atkCache end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkFor   = LP.UserId
    atkStamp = now
    atkTool  = tool
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- Enemy lookup
--   Names seen live: CommonArea_Enemy_129, RareArea_Enemy_114,
--   LegendaryArea_Enemy_99, MythicalArea_Enemy_21,
--   DivineArea_Enemy_9, SecretArea_Enemy_4,
--   Egg_EpicArea_Enemy_132_0, UncommonArea_Enemy_126.
--------------------------------------------------------------------
local function enemyPart(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Head")
        or model.PrimaryPart
end

local function enabledPrefixes()
    local out = {}
    for i = 1, #BOSS_NAMES do
        local n = BOSS_NAMES[i]
        if Config["Boss" .. n] then out[#out + 1] = n end
    end
    return out
end

local function nearestEnemyOf(fromPos, prefixes, maxDist)
    if not prefixes or #prefixes == 0 then return nil, nil end

    local best, bestDist, bestPos = nil, maxDist, nil
    local kids = WS:GetChildren()

    for i = 1, #kids do
        local d  = kids[i]
        local nm = d.Name

        if string.find(nm, "Area_Enemy", 1, true) then
            local picked = false
            for j = 1, #prefixes do
                if string.find(nm, prefixes[j] .. "Area_Enemy", 1, true) then
                    picked = true
                    break
                end
            end

            if picked then
                local part = enemyPart(d)
                if part then
                    local pos  = part.Position
                    local dist = (pos - fromPos).Magnitude
                    if dist <= bestDist then
                        best, bestDist, bestPos = d, dist, pos
                    end
                end
            end
        end
    end

    return best, bestPos
end

-- moves only if further than 2 studs from the slot, returns the delta
local function moveTo(hrp, x, y, z)
    if not hrp or not hrp.Parent then return false end
    if not alive() then return false end

    local p  = hrp.Position
    local dx = p.X - x
    local dy = p.Y - y
    local dz = p.Z - z

    if (dx * dx + dy * dy + dz * dz) <= MOVE_EPS2 then
        return false
    end

    pcall(function() hrp.CFrame = CFrame.new(x, y, z) end)
    return true
end

--------------------------------------------------------------------
-- Toggle / slider plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function safeSlider(sec, name, id, min, max, default, cb)
    local tries = {
        function() sec:SliderInt(name, id, min, max, default, cb) end,
        function() sec:SliderInt(id, name, min, max, default, cb) end,
        function() sec:SliderInt(name, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Slider failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Feed", "fam_feed", "AutoFeed", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Right")
        if combat then
            addToggle(combat, "Auto Attack", "fam_attack", "AutoAttack", false)
            addToggle(combat, "Attack From Afar", "fam_afar", "Afar", false)
            safeSlider(combat, "Afar Range", "fam_afarrange", 50, 2000, 300,
                function(v)
                    if type(v) == "number" then Config.AfarRange = v end
                end)
        end

        local kill = makeSection(tab, "Auto Kill", "Left")
        if kill then
            addToggle(kill, "Auto Kill", "fam_kill", "Kill", false)
            addToggle(kill, "Under Map", "fam_under", "Under", true)
            safeSlider(kill, "Depth", "fam_depth", 0, 40, 8,
                function(v)
                    if type(v) == "number" then Config.Depth = v end
                end)
            safeSlider(kill, "Kill Range", "fam_killrange", 50, 5000, 1500,
                function(v)
                    if type(v) == "number" then Config.KillRange = v end
                end)
        end

        local bosses = makeSection(tab, "Bosses", "Right")
        if bosses then
            for i = 1, #BOSS_NAMES do
                local n = BOSS_NAMES[i]
                local id = "fam_boss_" .. string.lower(n)
                addToggle(bosses, n, id, "Boss" .. n, true)
            end
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER - single source of truth
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                if hum.MaxHealth ~= lastMax then
                    if lastMax ~= 0 and hum.MaxHealth > lastMax then
                        print("[" .. NAME .. "] max health "
                            .. tostring(math.floor(lastMax)) .. " -> "
                            .. tostring(math.floor(hum.MaxHealth)))
                    end
                    lastMax = hum.MaxHealth
                end

                local now = tick()
                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO FEED
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoFeed then
            local base   = myBase()
            local folder = base and base:FindFirstChild("Mosquitoes")
            if folder then
                local actors = child(RS, "Runtime", "Actors")
                local kids   = folder:GetChildren()

                for i = 1, #kids do
                    local m    = kids[i]
                    local fp   = m:FindFirstChild("FeedProgress")
                    local fg   = m:FindFirstChild("Feeding")
                    local prog = (fp and tonumber(fp.Value)) or 1
                    local busy = (fg and fg.Value) or false

                    if prog < 0.99 and not busy then
                        local aid   = m:FindFirstChild("ActorId")
                        local id    = aid and aid.Value
                        local actor = id and actors
                            and actors:FindFirstChild(tostring(id))
                        local ev    = actor and actor:FindFirstChild("Events")
                        local rem   = ev and ev:FindFirstChild("FeedMosquito")
                        if rem then
                            pcall(function() rem:FireServer() end)
                        end
                    end
                end
            end
        end
        task.wait(FEED_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO ATTACK  (normal reach)
--   Skipped while Afar or Auto Kill owns the movement.
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoAttack and not Config.Afar and not Config.Kill then
            swing()
        end
        task.wait(ATTACK_RATE)
    end
end)

--------------------------------------------------------------------
-- ATTACK FROM AFAR  (touch and return)
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoAttack and Config.Afar and not Config.Kill then
            local hrp = rootPart()
            if hrp and alive() then
                local range = tonumber(Config.AfarRange) or 300
                local target, pos = nearestEnemyOf(hrp.Position,
                    enabledPrefixes(), range)

                if target and pos then
                    local back  = hrp.CFrame
                    local depth = tonumber(Config.Depth) or 8
                    local ty    = pos.Y + 3
                    if Config.Under then ty = pos.Y - depth end

                    if moveTo(hrp, pos.X, ty, pos.Z) then
                        task.wait(0.06)
                        swing()
                        task.wait(0.06)
                        pcall(function()
                            if hrp and hrp.Parent then hrp.CFrame = back end
                        end)
                    else
                        swing()
                    end
                end
            end
        end
        task.wait(AFAR_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO KILL  (stay attached to the chosen boss)
--   First pass saves your CFrame; switching the toggle off puts you
--   back. Position is only written when you drift more than 2 studs,
--   which keeps the expensive CFrame writes rare.
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Kill then
            local hrp = rootPart()
            if hrp and alive() then
                local range = tonumber(Config.KillRange) or 1500
                local target, pos = nearestEnemyOf(hrp.Position,
                    enabledPrefixes(), range)

                if target and pos then
                    if not killing then
                        savedCF = hrp.CFrame
                        killing = true
                        print("[" .. NAME .. "] auto kill on " .. target.Name)
                    end

                    local depth = tonumber(Config.Depth) or 8
                    local ty    = pos.Y + 3
                    if Config.Under then ty = pos.Y - depth end

                    moveTo(hrp, pos.X, ty, pos.Z)
                    swing()
                elseif killing then
                    if savedCF then
                        pcall(function() hrp.CFrame = savedCF end)
                    end
                    killing = false
                    print("[" .. NAME .. "] no target in range")
                end
            end
        elseif killing then
            if savedCF then
                pcall(function()
                    local hrp = rootPart()
                    if hrp and hrp.Parent then hrp.CFrame = savedCF end
                end)
            end
            killing = false
        end
        task.wait(KILL_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() fireEvent("StopTransfuseBlood") end)

    if killing and savedCF then
        pcall(function()
            local hrp = rootPart()
            if hrp and hrp.Parent then hrp.CFrame = savedCF end
        end)
    end
    killing = false
    atkCache = nil

    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - all toggles start OFF", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
