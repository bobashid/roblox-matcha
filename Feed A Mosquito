-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function areaRarity(areaName)
    if type(areaName) ~= "string" then return "Common" end
    if string.sub(areaName, -4) == "Area" then
        return string.sub(areaName, 1, #areaName - 4)
    end
    return areaName
end

local function billboardRarity(model)
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if not ok or not desc then return nil end

    for i = 1, #desc do
        local d = desc[i]

        if d.ClassName == "TextLabel" and d.Name == "Rarity" then
            local okT, t = pcall(function() return d.Text end)

            if okT and type(t) == "string" and #t > 0 then
                return t
            end
        end
    end

    return nil
end

local function mosquitoId(eggName)
    if type(eggName) ~= "string" then return nil end
    if string.sub(eggName, -3) == "Egg" then
        return string.sub(eggName, 1, #eggName - 3)
    end
    return eggName
end

local function eggPrompt(model)
    local ok, desc = pcall(function() return model:GetDescendants() end)
    if not ok or not desc then return nil end

    local first = nil

    for i = 1, #desc do
        local d = desc[i]

        if d.ClassName == "ProximityPrompt" then
            if d.Name == "CarryPrompt" then return d end
            if first == nil then first = d end
        end
    end

    return first
end

local function eggPosition(model)
    if not model then return nil end

    local r = model:FindFirstChild("HumanoidRootPart")
    if not r then return nil end

    local ok, p = pcall(function() return r.Position end)
    if ok and p then return p end
    return nil
end

