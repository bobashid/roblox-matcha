--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v2.9
--
--  TOGGLE NAMES describe exactly what they do:
--    Always Heal   TransfuseBlood remote. Keeps max HP climbing.
--    Auto Collect  CollectIncome + ClaimOfflineIncome.
--    Spam Swing    Fires Attack on a cadence wherever you stand.
--                  No target, no movement. (was "Auto Farm")
--    Kill Aura     Moves to the nearest boss and swings. (was
--                  "Auto Kill")
--
--  KILL AURA FIX
--    v2.8 scanned only Workspace:GetChildren(). The bosses are Actors
--    under PlayerScripts.Runtime.Actors (Egg_RareArea_Enemy_140_4 and
--    friends), and their models sit under Workspace.SpawnAreas, so the
--    scan returned nothing and the toggle never fired a swing.
--    The scan now walks Workspace children AND every descendant of
--    Workspace.SpawnAreas.
--    It also stands 2 studs ABOVE the target root instead of under the
--    map, and waits 0.1s after moving so the server resolves the hit
--    from the new position.
--
--  BOSS TELEPORT
--    Workspace.SpawnAreas.<Type>Area holds the real coordinates. Each
--    button reads that model at click time and uses the first part
--    that is not at the origin. If the area model has no usable part,
--    it falls back to the nearest live boss of that type.
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v2.9"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local HP_LOG_RATE  = 5.0
local COLLECT_RATE = 1.5
local SWING_RATE   = 0.3
local AURA_RATE    = 0.3
local ATK_TTL      = 0.5
local MOVE_EPS2    = 4
local AURA_UP      = 2
local AURA_MAX     = 1000000

local BOSS_TYPES = {
    "Common", "Uncommon", "Rare", "Legendary",
    "Mythical", "Divine", "Secret", "Epic",
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    SpamSwing   = false,
    Aura        = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    return c and c:FindFirstChild("Humanoid") or nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function mag2(p)
    return p.X * p.X + p.Y * p.Y + p.Z * p.Z
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local first = atkCache[1]
        local p1 = first and first.Parent
        local p2 = p1 and p1.Parent
        if p1 and p2 then
            return atkCache
        end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- Boss scan
--   Boss models are named <Type>Area_Enemy_<n> or
--   Egg_<Type>Area_Enemy_<n>. They are not always direct children of
--   Workspace - the live ones sit under Workspace.SpawnAreas - so the
--   scan walks both.
--------------------------------------------------------------------
local function modelPart(model)
    local p = model:FindFirstChild("HumanoidRootPart")
    if p then return p end
    p = model:FindFirstChild("Head")
    if p then return p end
    return model.PrimaryPart
end

local function collectBosses()
    local out = {}

    local function consider(m)
        if not m or not m.Name then return end
        if not string.find(m.Name, "Area_Enemy", 1, true) then return end
        local part = modelPart(m)
        if not part then return end
        local ok, pos = pcall(function() return part.Position end)
        if ok and pos then
            out[#out + 1] = { model = m, pos = pos }
        end
    end

    local kids = WS:GetChildren()
    for i = 1, #kids do consider(kids[i]) end

    local areas = WS:FindFirstChild("SpawnAreas")
    if areas then
        local okD, desc = pcall(function() return areas:GetDescendants() end)
        if okD and desc then
            for i = 1, #desc do consider(desc[i]) end
        end
    end

    return out
end

local function matchesType(nm, bossType)
    return string.find(nm, bossType .. "Area_Enemy", 1, true) ~= nil
end

local function nearestOf(list, fromPos, bossType)
    local best, bestDist, bestPos = nil, AURA_MAX, nil

    for i = 1, #list do
        local e = list[i]
        if bossType == nil or matchesType(e.model.Name, bossType) then
            local d = (e.pos - fromPos).Magnitude
            if d <= bestDist then
                best, bestDist, bestPos = e.model, d, e.pos
            end
        end
    end

    return best, bestPos
end

-- real coordinates for an area, read from Workspace.SpawnAreas
local function areaPos(bossType)
    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return nil end

    local m = areas:FindFirstChild(bossType .. "Area")
    if not m then return nil end

    local okD, desc = pcall(function() return m:GetDescendants() end)
    if not okD or not desc then return nil end

    for i = 1, #desc do
        local c = desc[i]
        local cn = c.ClassName
        if cn == "Part" or cn == "MeshPart"
            or cn == "UnionOperation" or cn == "SpawnLocation" then
            local ok, p = pcall(function() return c.Position end)
            if ok and p and mag2(p) > 1 then return p end
        end
    end

    return nil
end

local function moveTo(hrp, x, y, z)
    if not hrp or not hrp.Parent then return false end
    if not alive() then return false end

    local p  = hrp.Position
    local dx = p.X - x
    local dy = p.Y - y
    local dz = p.Z - z

    if (dx * dx + dy * dy + dz * dz) <= MOVE_EPS2 then
        return false
    end

    pcall(function() hrp.CFrame = CFrame.new(x, y, z) end)
    return true
end

--------------------------------------------------------------------
-- Toggle / button plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function safeButton(sec, name, cb)
    local tries = {
        function() sec:Button(name, cb) end,
        function() sec:Button(name, name .. "_btn", cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Button failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Spam Swing", "fam_swing", "SpamSwing", false)
            addToggle(combat, "Kill Aura", "fam_aura", "Aura", false)
        end

        local tp = makeSection(tab, "Boss Teleport", "Right")
        if tp then
            for i = 1, #BOSS_TYPES do
                local bossType = BOSS_TYPES[i]
                safeButton(tp, "TP " .. bossType, function()
                    local hrp = rootPart()
                    if not hrp or not alive() then
                        notifyUser("No character", 3)
                        return
                    end

                    local pos   = areaPos(bossType)
                    local label = "area"

                    if not pos then
                        local list = collectBosses()
                        local target, bpos = nearestOf(list, hrp.Position, bossType)
                        if bpos then
                            pos   = bpos
                            label = target.Name
                        end
                    end

                    if not pos then
                        print("[" .. NAME .. "] no " .. bossType
                            .. " position (no area part, no boss)")
                        notifyUser("No " .. bossType .. " spot", 3)
                        return
                    end

                    pcall(function()
                        hrp.CFrame = CFrame.new(pos.X, pos.Y + AURA_UP, pos.Z)
                    end)

                    print("[" .. NAME .. "] tp " .. bossType .. " via " .. label
                        .. " " .. tostring(math.floor(pos.X)) .. ","
                        .. tostring(math.floor(pos.Y)) .. ","
                        .. tostring(math.floor(pos.Z)))
                    notifyUser("TP " .. bossType, 2)
                end)
            end
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            if built then return end
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0
    local lastLog     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                local max = math.floor(hum.MaxHealth)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax
                        and (now - lastLog) >= HP_LOG_RATE then
                        print("[" .. NAME .. "] max health " .. tostring(max))
                        lastLog = now
                    end
                    lastMax = max
                end

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
-- SPAM SWING
--   Swings wherever you stand, no target needed.
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.SpamSwing then
            swing()
        end
        task.wait(SWING_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL AURA
--   Scans Workspace plus Workspace.SpawnAreas, stands above the
--   nearest boss, swings.
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Aura then
            local hrp = rootPart()
            if hrp and alive() then
                local list = collectBosses()
                local target, pos = nearestOf(list, hrp.Position, nil)
                if target and pos then
                    moveTo(hrp, pos.X, pos.Y + AURA_UP, pos.Z)
                    task.wait(0.1)
                    swing()
                end
            end
        end
        task.wait(AURA_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache = nil
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - all toggles start OFF", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
