-- EGG PICKUP
--------------------------------------------------------------------
local function noClipOn()
    tpSaved = {}

    local c = LP.Character
    if not c then return end

    local ok, desc = pcall(function() return c:GetDescendants() end)
    if not ok or not desc then return end

    for i = 1, #desc do
        local d  = desc[i]
        local cn = d.ClassName

        if cn == 'Part' or cn == 'MeshPart' then
            local okC, col = pcall(function() return d.CanCollide end)

            if okC and col == true then
                tpSaved[#tpSaved + 1] = { part = d, collide = col }
                pcall(function() d.CanCollide = false end)
            end
        end
    end
end

local function noClipOff()
    for i = 1, #tpSaved do
        local e = tpSaved[i]
        if e.part then pcall(function() e.part.CanCollide = e.collide end) end
    end

    tpSaved = {}
end

local function restoreHome()
    if tpAway and tpHome then
        local hrp = rootPart()
        if hrp then pcall(function() hrp.CFrame = tpHome end) end
    end

    tpAway = false
    tpHome = nil
    pickingNow = false
end

local function anyRarityOn()
    for i = 1, #RARITIES do
        if PickCfg[RARITIES[i]] then return true end
    end
    return false
end

task.spawn(function()
    local hasPrompt = (type(fireproximityprompt) == 'function')

    local warned = false
    local wasOn  = false
    local taken  = 0
    local lastAt = {}
    local diag   = false

    if not hasPrompt then
        print('[' .. NAME .. '] fireproximityprompt missing - re-run the Matcha loader')
    end

    while running do
        if Config.Pickup and hasPrompt and alive() and anyRarityOn() then
            local eggs = eggList()
            local now  = tick()
            local done = false

            for i = 1, #eggs do
                if done then break end

                local egg = eggs[i]

                if PickCfg[egg.rarity] == true then
                    local okP, parent = pcall(function() return egg.model.Parent end)

                    if okP and parent ~= nil then
                        local k     = keyOf(egg.model)
                        local ready = true

                        if k ~= nil and lastAt[k] ~= nil then
                            if (now - lastAt[k]) < PICK_COOLDOWN then ready = false end
                        end

                        if ready then
                            local prompt = eggPrompt(egg.model)

                            if prompt then
                                if Config.TPPickup then
                                    local epos = eggPosition(egg.model)
                                    local hrp  = rootPart()

                                    if epos and hrp then
                                        local hidden = (Config.HideUnder and hideSpot ~= nil)
                                        local home   = nil

                                        if hidden then
                                            home = hideSpot
                                        else
                                            local okH, cf = pcall(function() return hrp.CFrame end)
                                            if okH and cf then home = cf end
                                        end

                                        if home then
                                            pickingNow    = true
                                            pickStartedAt = tick()
                                            tpHome        = home
                                            tpAway        = true

                                            if not hidden then noClipOn() end

                                            pcall(function()
                                                hrp.CFrame = CFrame.new(epos.X, epos.Y - TP_DEPTH, epos.Z)
                                            end)

                                            task.wait(TP_SETTLE)

                                            if running and Config.Pickup then
                                                pcall(function() fireproximityprompt(prompt) end)
                                                task.wait(TP_FIRE_GAP)
                                                pcall(function() fireproximityprompt(prompt) end)
                                            end

                                            local back = rootPart() or hrp
                                            pcall(function() back.CFrame = home end)

                                            if not hidden then noClipOff() end

                                            tpAway     = false
                                            tpHome     = nil
                                            pickingNow = false

                                            done         = true
                                            taken        = taken + 1
                                            lastPickupAt = tick()

                                            if k ~= nil then lastAt[k] = tick() end

                                            if not diag then
                                                diag = true

                                                local dist = 0
                                                local okD, d = pcall(function()
                                                    return (home.Position - epos).Magnitude
                                                end)
                                                if okD and type(d) == 'number' then dist = d end

                                                print('[' .. NAME .. '] tp pickup on ' .. tostring(egg.name)
                                                    .. '  was ' .. tostring(math.floor(dist)) .. ' away'
                                                    .. (hidden and '  (hidden hop)' or ''))
                                            end
                                        end
                                    end
                                else
                                    pcall(function() fireproximityprompt(prompt) end)

                                    done         = true
                                    taken        = taken + 1
                                    lastPickupAt = tick()

                                    if k ~= nil then lastAt[k] = tick() end
                                end
                            end
                        end
                    end
                end
            end

            if done then
                warned = false

                if not wasOn then
                    wasOn = true
                    print('[' .. NAME .. '] auto pickup on ('
                        .. (Config.TPPickup and 'tp under egg' or 'prompt') .. ')')
                end
            elseif not warned then
                warned = true
                print('[' .. NAME .. '] auto pickup: no egg matched an enabled rarity')
            end

            task.wait(PICK_RATE)
        else
            if wasOn then
                wasOn = false
                print('[' .. NAME .. '] auto pickup off (' .. tostring(taken) .. ' eggs)')
            end

            pcall(restoreHome)
            pcall(noClipOff)
            pickingNow = false
            task.wait(0.25)
        end
    end
end)

--------------------------------------------------------------------
-- AUTO RESET  (only from the Auto Reset toggle)
--------------------------------------------------------------------
task.spawn(function()
    local lastKill   = 0
    local emptySince = nil
    local lastChar   = nil
    local lastSig    = nil
    local watching   = false

    while running do
        local canRestore = (not Config.HideUnder) or (hideSpot ~= nil)

        if Config.AutoReset and canRestore and alive() and not watching then
            if LP.Character ~= lastChar then
                lastChar   = LP.Character
                emptySince = nil
                lastSig    = nil
            end

            local now = tick()
            local sig = handSignature()

            if sig ~= lastSig then
                lastSig    = sig
                emptySince = nil
            end

            local needs, has = weaponState()

            if needs and has then
                if emptySince == nil then emptySince = now end

                if (now - emptySince) >= RESET_AFTER
                    and (now - lastKill) >= RESET_COOLDOWN then
                    local okKill, why = killCharacter()

                    if okKill then
                        lastKill   = now
                        emptySince = nil
                        watching   = true

                        local restoring = (Config.HideUnder and hideSpot ~= nil)
                        if restoring then hideResetAt = now end

                        print('[' .. NAME .. '] no weapon for '
                            .. tostring(math.floor(RESET_AFTER)) .. 's: resetting'
                            .. (restoring and ' (going straight back under)' or ''))

                        task.spawn(function()
                            local waited = 0

                            while running and waited < RESET_MAX_WAIT do
                                task.wait(0.05)
                                waited = waited + 0.05

                                local c = LP.Character
                                local h = c and c:FindFirstChildOfClass('Humanoid')

                                if c and h and h.Health > 0 then
                                    if restoring and Config.HideUnder and hideSpot then
                                        hideChar       = c
                                        hideHP0        = h.Health
                                        hideFallFrames = 0
                                        hideResetAt    = nil
                                        hideRoot       = nil
                                        unanchorAll()
                                        holdAt(hideSpot)
                                    end

                                    print('[' .. NAME .. '] respawned')
                                    watching = false
                                    return
                                end
                            end

                            if running then
                                print('[' .. NAME .. '] still no new character after '
                                    .. tostring(RESET_MAX_WAIT) .. 's - reset once by hand')
                            end

                            hideResetAt = nil
                            watching    = false
                        end)
                    else
                        lastKill = now
                        print('[' .. NAME .. '] reset failed: ' .. tostring(why))
                    end
                end
            else
                emptySince = nil
            end
        else
            emptySince = nil
            lastChar   = nil
            lastSig    = nil
        end

        task.wait(0.2)
    end
end)

--------------------------------------------------------------------
-- FARM KILL  (no reset here, reports what it sees)
--------------------------------------------------------------------
task.spawn(function()
    local hasTouch = (type(firetouchinterest) == 'function')

    local wasOn      = false
    local warnedTool = false
    local warnedAct  = false
    local warnedRmt  = false
    local staleWarn  = false
    local noBossWarn = false

    local lastSum  = nil
    local stale    = 0
    local cachedId = nil
    local cachedAtk, cachedPs = nil, nil

    while running do
        if Config.Farm and alive() then
            local tool = equippedTool()

            if not tool then
                if not warnedTool then
                    warnedTool = true
                    print('[' .. NAME .. '] farm kill: no weapon in hand - equip one')
                end

                cachedId, cachedAtk, cachedPs = nil, nil, nil
                task.wait(0.25)
            else
                warnedTool = false

                local ap = attackPartOf(tool)

                if not ap then
                    if not warnedAct then
                        warnedAct = true
                        print('[' .. NAME .. '] farm kill: ' .. tostring(tool.Name)
                            .. ' has no AttackPart. children: ' .. namesOf(tool, 12))
                    end

                    cachedId, cachedAtk, cachedPs = nil, nil, nil
                    task.wait(0.25)
                else
                    warnedAct = false

                    local id, atk, ps = actorInfo(tool)

                    if id ~= cachedId or atk ~= cachedAtk then
                        cachedId, cachedAtk, cachedPs = id, atk, ps
                        warnedRmt = false
                    end

                    if not wasOn then
                        wasOn = true
                        print('[' .. NAME .. '] farm kill on: ' .. tostring(tool.Name)
                            .. ' / ' .. tostring(ap.Name)
                            .. ' / touch=' .. tostring(hasTouch)
                            .. ' / burst=' .. tostring(cachedAtk ~= nil))
                    end

                    if not cachedAtk and not warnedRmt then
                        warnedRmt = true
                        print('[' .. NAME .. '] no actor Attack remote for '
                            .. tostring(id) .. ' - touch only')
                    end

                    rememberPart(ap)

                    local big, seen = mapSize()

                    pcall(function() ap.Size = Vector3.new(AP_SMALL, AP_SMALL, AP_SMALL) end)
                    task.wait(AP_HOLD)

                    if big then
                        pcall(function() ap.Size = big end)
                        reachOn = true
                    end

                    local list = bossList()

                    if seen > 0 then
                        noBossWarn = false

                        if hasTouch then
                            pruneParts()

                            for i = 1, #list do
                                local boss = list[i]
                                local hp   = bossHealth(boss)

                                if hp and hp > 0 then
                                    local parts = bossParts(boss)

                                    for j = 1, #parts do
                                        local part = parts[j]
                                        pcall(function() firetouchinterest(ap, part, 0) end)
                                    end
                                end
                            end
                        end
                    elseif not noBossWarn then
                        noBossWarn = true
                        print('[' .. NAME .. '] no boss spawned - box kept at minimum')
                    end

                    if cachedAtk then
                        for b = 1, ATK_BURST do
                            if cachedPs then
                                pcall(function() cachedPs:FireServer('SwingSound') end)
                            end
                            pcall(function() cachedAtk:FireServer() end)
                        end
                    end

                    local sum  = 0
                    local live = 0

                    for i = 1, #list do
                        local hp = bossHealth(list[i])
                        if hp and hp > 0 then
                            sum  = sum + hp
                            live = live + 1
                        end
                    end

                    if live == 0 then
                        stale     = 0
                        staleWarn = false
                        lastSum   = nil
                    elseif lastSum and sum >= lastSum then
                        stale = stale + 1

                        if stale >= STALE_LIMIT and not staleWarn then
                            staleWarn = true
                            print('[' .. NAME .. '] boss HP not dropping - hits not landing')
                        end
                    else
                        stale     = 0
                        staleWarn = false
                    end

                    if live > 0 then lastSum = sum end

                    task.wait(HIT_RATE)
                end
            end
        else
            if wasOn then
                wasOn = false
                print('[' .. NAME .. '] farm kill off')
            end

            warnedTool = false
            warnedAct  = false
            warnedRmt  = false
            stale      = 0
            staleWarn  = false
            noBossWarn = false
            lastSum    = nil
            cachedId, cachedAtk, cachedPs = nil, nil, nil

            if reachOn then restoreAttackParts() end

            task.wait(0.1)
        end
    end
end)

