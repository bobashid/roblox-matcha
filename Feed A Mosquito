local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == 'boolean' then Config[key] = a return end
        if type(b) == 'boolean' then Config[key] = b return end
        if type(c) == 'boolean' then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }

    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end

    warn('[' .. NAME .. '] Toggle failed: ' .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == 'table' then return sec end

    ok, sec = pcall(function() tab:Section(name) end)
    if ok and type(sec) == 'table' then return sec end

    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

local function addRarity(sec, rarity)
    local id = 'rarity_' .. string.lower(rarity)

    local cb = function(a, b, c)
        if getterWorks[rarity] then return end
        if type(a) == 'boolean' then PickCfg[rarity] = a return end
        if type(b) == 'boolean' then PickCfg[rarity] = b return end
        if type(c) == 'boolean' then PickCfg[rarity] = c return end
    end

    if safeToggle(sec, rarity, id, false, cb) then
        RARITY_IDS[#RARITY_IDS + 1] = { rarity = rarity, id = id, name = rarity }
    end
end

local function buildTab(tab)
    if built then return end
    if type(tab) ~= 'table' then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, 'Main', 'Left')
        if main then
            addToggle(main, 'Auto Health', 'auto_health', 'Heal', false)
            addToggle(main, 'Auto Collect', 'auto_collect', 'AutoCollect', false)
        end

        local farm = makeSection(tab, 'Farm', 'Left')
        if farm then
            addToggle(farm, 'Farm Kill', 'farm_kill', 'Farm', false)
            addToggle(farm, 'Auto Hatch', 'auto_hatch', 'AutoHatch', false)
            addToggle(farm, 'Auto Equip Best', 'auto_equip_best', 'BestEquip', false)
            addToggle(farm, 'Hide Under Farm', 'hide_under_farm', 'HideUnder', false)
        end

        local pick = makeSection(tab, 'Egg Pickup', 'Left')
        if pick then
            addToggle(pick, 'Auto Pickup', 'auto_pickup', 'Pickup', false)
            addToggle(pick, 'TP Pickup (under egg)', 'tp_pickup', 'TPPickup', false)

            for i = 1, #RARITIES do
                addRarity(pick, RARITIES[i])
            end
        end
    end)

    if not ok then
        warn('[' .. NAME .. '] build error: ' .. tostring(err))
    end

    print('[' .. NAME .. '] tab widgets built')
end

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

if HAS_UI then
