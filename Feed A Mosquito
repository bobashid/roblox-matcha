--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v5.0  -  SCALE OFF THE HUMANOIDS, NOT A NAME LIST
--
--  WHY THIS IS SIMPLER AND WORKS ON ALL OF THEM
--    There is no single "boss folder". SpawnAreas holds one area
--    model per type, and the boss sits inside it - but the same
--    <Type>Mama model is not always there (it cycles), and eggs, rigs
--    and other humanoids live in the same tree. Matching on the name
--    "Mama" was the thing that kept missing bosses.
--    Every hit target in this game is a Model with a Humanoid. So the
--    scan now just walks Workspace, finds every Humanoid, and takes
--    its parent Model. No name list, no area list, no distance maths.
--
--  MULTIPLIER IS FIXED AT MAX (x40)
--    Every BasePart of every target is set to its first-seen size
--    times 40, once. No distance scaling, no second multiplier, no
--    compounding. The Huge Hitbox toggle is gone because there is
--    nothing left to scale up to.
--
--  WHAT IS NEVER TOUCHED
--    - your own character, and any other player's character
--    - Models named "Rig" (animation rigs, not enemies)
--    - parts named Area / ChaseArea (that was the floor being grown
--      and flinging you in earlier versions)
--    - anything with no BasePart at all (nothing to resize)
--
--  TABLES KEYED BY Address
--    Matcha hands back a fresh proxy for the same part on every scan,
--    so a table keyed by the instance re-saved and re-multiplied the
--    same part over and over (x40, x1600, x64000...) until the client
--    choked. Both tables are keyed by Address now, the original size
--    is saved exactly once, and a part is only re-sized when its
--    multiplier actually changes.
--
--  AUTO SWING
--    Stand still, Attack remote fired every SWING_RATE. No CFrame
--    writes anywhere, no teleports.
--
--  Everything restores exactly when Auto Farm goes off or you stop:
--  original size and original CanCollide on every part touched.
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v5.0"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local HP_LOG_RATE  = 5.0
local COLLECT_RATE = 1.5
local SWING_RATE   = 0.1
local ATK_TTL      = 1.0
local HB_RATE      = 0.25
local SCAN_TTL     = 2.0
local TARGET_MEMORY = 20.0
local TARGET_CAP   = 250
local TRACK_LOG    = 5.0

-- one multiplier: max
local HB_MULT      = 40
local HB_ROOT_MIN  = 14

-- parts that must never be resized
local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
}

-- models that are never a hit target
local SKIP_MODEL = {
    Rig = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

-- Stable identity: Matcha returns fresh proxies, so the instance is
-- useless as a table key and Address is not.
local function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function countParts(m)
    local n = 0
    local ok, desc = pcall(function() return m:GetDescendants() end)
    if not ok or not desc then return 0 end
    for i = 1, #desc do
        if isBasePart(desc[i]) then n = n + 1 end
    end
    return n
end

local function isPlayerChar(m)
    if m == LP.Character then return true end
    local ok, plr = pcall(function() return Players:GetPlayerFromCharacter(m) end)
    return ok and plr ~= nil
end

local function bossHumanoid(m)
    local h = m:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

-- any Model with a Humanoid that is not a player and not a rig
local function looksLikeTarget(m)
    if m.ClassName ~= "Model" then return false end
    if SKIP_MODEL[m.Name] then return false end
    if isPlayerChar(m) then return false end
    return bossHumanoid(m) ~= nil
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local okAll = true
        for i = 1, #atkCache do
            local r = atkCache[i]
            if not r or not r.Parent then okAll = false break end
        end
        if okAll then return atkCache end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- TARGET SCAN  (every Humanoid model in Workspace)
--------------------------------------------------------------------
local targets     = {}   -- address -> { model, t }
local targetStamp = 0
local trackCount  = -1
local trackLogged = 0

local function targetCount()
    local n = 0
    for k in pairs(targets) do n = n + 1 end
    return n
end

local function pruneTargets()
    local now  = tick()
    local dead = nil

    for k, e in pairs(targets) do
        local gone = false

        if not e.model then
            gone = true
        else
            local ok, parent = pcall(function() return e.model.Parent end)
            if not ok or parent == nil then gone = true end
        end

        if not gone and (now - e.t) > TARGET_MEMORY then gone = true end

        if gone then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do targets[dead[i]] = nil end
    end

    local n = targetCount()
    if n > TARGET_CAP then
        local arr = {}
        for k, e in pairs(targets) do arr[#arr + 1] = { k = k, t = e.t } end
        table.sort(arr, function(a, b) return a.t < b.t end)

        local extra = n - TARGET_CAP
        for i = 1, extra do
            if arr[i] then targets[arr[i].k] = nil end
        end
    end
end

local function remember(m, now)
    local k = keyOf(m)
    if k == nil then return end

    local e = targets[k]
    if e then
        e.model = m
        e.t     = now
    else
        targets[k] = { model = m, t = now }
    end
end

local function scanTargets()
    local now = tick()

    local ok, desc = pcall(function() return WS:GetDescendants() end)
    if ok and desc then
        for i = 1, #desc do
            local d = desc[i]
            if d.ClassName == "Humanoid" then
                local m = d.Parent
                if m and looksLikeTarget(m) then remember(m, now) end
            end
        end
    end

    pruneTargets()
    targetStamp = now

    local out   = {}
    local names = {}

    for k, e in pairs(targets) do
        if e.model then
            out[#out + 1]     = e.model
            names[#names + 1] = e.model.Name
        end
    end

    local n = #out
    if n ~= trackCount and (now - trackLogged) >= TRACK_LOG then
        trackCount  = n
        trackLogged = now

        table.sort(names)
        local shown = table.concat(names, ",")
        if #shown > 220 then shown = string.sub(shown, 1, 220) .. "..." end
        print("[" .. NAME .. "] targets " .. tostring(n) .. ": " .. shown)
    end

    return out
end

local function allTargets()
    if (tick() - targetStamp) < SCAN_TTL and targetCount() > 0 then
        local out = {}
        for k, e in pairs(targets) do
            if e.model then out[#out + 1] = e.model end
        end
        return out
    end
    return scanTargets()
end

local function reportTargets()
    local list = scanTargets()

    local seen  = {}
    local order = {}

    for i = 1, #list do
        local m  = list[i]
        local hp = "?"

        local h = bossHumanoid(m)
        if h then
            local okH, v = pcall(function() return h.Health end)
            if okH and type(v) == "number" then hp = tostring(math.floor(v)) end
        end

        local k = m.Name .. "|" .. hp
        if not seen[k] then
            seen[k] = true
            order[#order + 1] = { m = m, hp = hp }
        end
    end

    print("[" .. NAME .. "] target report (" .. tostring(#order)
        .. " distinct, " .. tostring(#list) .. " tracked)")

    local cap = #order
    if cap > 25 then cap = 25 end

    for i = 1, cap do
        local m     = order[i].m
        local parts = countParts(m)
        local note  = ""
        if parts == 0 then note = "  (no parts on client - cannot grow)" end

        print("  " .. m.Name .. "  parts=" .. tostring(parts)
            .. "  hp=" .. order[i].hp .. "  mult=x" .. tostring(HB_MULT) .. note)
    end
end

--------------------------------------------------------------------
-- HITBOX EXPANDER  (Address keyed, saved once per part)
--------------------------------------------------------------------
local hbSaved   = {}   -- address -> { part, size, collide, mult }
local hbApplied = false

local function pruneSaved()
    local dead = nil
    for k, e in pairs(hbSaved) do
        local gone = false

        if not e.part then
            gone = true
        else
            local ok, parent = pcall(function() return e.part.Parent end)
            if not ok or parent == nil then gone = true end
        end

        if gone then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do hbSaved[dead[i]] = nil end
    end
end

local function growPart(d, mult, isRoot)
    if SKIP_PART[d.Name] then return false end

    local k = keyOf(d)
    if k == nil then return false end

    local e = hbSaved[k]

    if e == nil then
        local okS, s = pcall(function() return d.Size end)
        if not okS or not s then return false end

        local okC, c = pcall(function() return d.CanCollide end)

        e = {
            part    = d,
            size    = s,
            collide = (okC and c) and true or false,
            mult    = 0,
        }
        hbSaved[k] = e
    end

    if e.mult ~= mult then
        local nx = e.size.X * mult
        local ny = e.size.Y * mult
        local nz = e.size.Z * mult

        if isRoot then
            if nx < HB_ROOT_MIN then nx = HB_ROOT_MIN end
            if ny < HB_ROOT_MIN then ny = HB_ROOT_MIN end
            if nz < HB_ROOT_MIN then nz = HB_ROOT_MIN end
        end

        pcall(function() d.Size = Vector3.new(nx, ny, nz) end)
        pcall(function() d.CanCollide = false end)

        e.mult = mult
    end

    return true
end

local function applyHitbox()
    local touched = 0
    local list    = allTargets()

    for i = 1, #list do
        local boss = list[i]
        if boss and boss.Parent then
            local okD, desc = pcall(function() return boss:GetDescendants() end)
            if okD and desc then
                for j = 1, #desc do
                    local d = desc[j]
                    if isBasePart(d) then
                        local isRoot = false
                        if d.Name == "HumanoidRootPart" then
                            isRoot = true
                        else
                            local okP, pp = pcall(function() return boss.PrimaryPart end)
                            if okP and pp ~= nil then
                                local okE, same = pcall(function() return pp == d end)
                                if okE and same then isRoot = true end
                            end
                        end

                        if growPart(d, HB_MULT, isRoot) then touched = touched + 1 end
                    end
                end
            end
        end
    end

    return touched
end

local function restoreHitbox()
    local n = 0

    for k, e in pairs(hbSaved) do
        local p = e.part
        if p then
            local ok, parent = pcall(function() return p.Parent end)
            if ok and parent ~= nil then
                pcall(function() p.Size = e.size end)
                pcall(function() p.CanCollide = e.collide end)
                n = n + 1
            end
        end
    end

    hbSaved = {}

    if hbApplied then
        print("[" .. NAME .. "] hitbox restored on " .. tostring(n) .. " parts")
    end
    hbApplied = false
end

--------------------------------------------------------------------
-- DAMAGE WATCH
--------------------------------------------------------------------
local lastHp = {}

local function watchDamage()
    for k, e in pairs(targets) do
        local m = e.model
        if m then
            local h = bossHumanoid(m)
            if h then
                local ok, v = pcall(function() return h.Health end)
                if ok and type(v) == "number" then
                    local prev = lastHp[k]
                    if prev and v < prev - 0.5 then
                        print("[" .. NAME .. "] " .. m.Name .. " -"
                            .. tostring(math.floor(prev - v))
                            .. " (" .. tostring(math.floor(v)) .. ")")
                    end
                    lastHp[k] = v
                end
            end
        else
            lastHp[k] = nil
        end
    end
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function safeButton(sec, name, id, cb)
    local tries = {
        function() sec:Button(name, cb) end,
        function() sec:Button(name, id, cb) end,
        function() sec:Button(id, name, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Button failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Auto Farm (x40 + swing)", "fam_farm", "Farm", false)
            safeButton(combat, "Print Target List", "fam_targets", function()
                reportTargets()
                notifyUser("Target list printed to console", 4)
            end)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- HITBOX LOOP
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Farm then
            pruneSaved()
            local n = applyHitbox()
            if n > 0 and not hbApplied then
                hbApplied = true
                print("[" .. NAME .. "] hitbox x" .. tostring(HB_MULT)
                    .. " on " .. tostring(n) .. " parts (no collide, local)")
            end
        elseif hbApplied then
            restoreHitbox()
        end

        task.wait(HB_RATE)
    end
end)

--------------------------------------------------------------------
-- DAMAGE WATCH LOOP
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Farm then watchDamage() end
        task.wait(0.3)
    end
end)

--------------------------------------------------------------------
-- AUTO SWING
--------------------------------------------------------------------
task.spawn(function()
    local wasOn = false
    local warned = false

    while running do
        if Config.Farm then
            if not wasOn then
                wasOn = true
                warned = false
                print("[" .. NAME .. "] auto farm on (swinging)")
            end

            if not swing() and not warned then
                warned = true
                print("[" .. NAME .. "] no Attack remote - equip a weapon")
            end

            task.wait(SWING_RATE)
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto farm off")
            end
            task.wait(0.2)
        end
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0
    local lastLog     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                local max = math.floor(hum.MaxHealth)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax
                        and (now - lastLog) >= HP_LOG_RATE then
                        print("[" .. NAME .. "] max health " .. tostring(max))
                        lastLog = now
                    end
                    lastMax = max
                end

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() restoreHitbox() end)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache = nil
    targets  = {}
    lastHp   = {}
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - Auto Farm x40, no name list", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
