--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v3.8
--
--  WHAT CHANGED
--
--  HP SORT (why v3.7 still came out alphabetical)
--    v3.7 read MaxHealth through
--    boss:FindFirstChildOfClass("Humanoid"). Matcha's IsA() always
--    returns true, so a class lookup can hand back any child and the
--    health reads came back nil - every boss tied at 0 and the sort
--    fell through to the name. The Humanoid is now found by walking
--    the children and comparing ClassName == "Humanoid", with an
--    attribute fallback (Health/MaxHealth, HP/MaxHP) in case the
--    game stops using a Humanoid.
--    The tab still waits until at least two bosses report a max
--    health before building (or 15 seconds), sorts by max health
--    descending, prints the order it used, and each toggle label
--    shows the max HP it was sorted by.
--
--  BOSS HITBOX
--    Two toggles in Combat:
--      Boss Hitbox Expander   x3
--      Bigger Hitbox          x6 (only matters while the expander is on)
--    Every BasePart of every boss model is scaled around its own
--    centre, capped at 24 studs per axis (a part is never made
--    smaller than it already is). Original sizes are remembered the
--    first time a part is seen and put back when the toggle goes off
--    or the script stops.
--    This is a LOCAL change. The client sees a bigger boss, the
--    server does not. The Attack remote is fired with no arguments,
--    so the server resolves the hit from your character position -
--    that part is what Far Hit handles. The expander helps when the
--    hit test runs on your client (mouse/raycast based) and makes a
--    boss easy to see and click either way.
--
--  FAR HIT
--    Remembers where you were, teleports to the selected boss feet,
--    swings, then teleports straight back. You keep your position and
--    the hit resolves from on top of the boss. Throttled to
--    FARHIT_RATE.
--
--  KILL AURA
--    Multi-select, dead bosses skipped, healthiest living selected
--    boss wins. Teleports only on target change or if you drift more
--    than 12 studs. Skipped while Far Hit is on so the two do not
--    fight over your position.
--
--  NO SELECTION = NO MOVEMENT
--
--  WHAT THE GAME HAS (read live)
--    Workspace.SpawnAreas.<Type>Area holds:
--      Area        Part   - arena floor
--      ChaseArea   Part   - trigger volume ~14 studs up, never used
--      <boss>Mama  Model  - the boss, with a Humanoid
--    UncommonMama's parts span Y 3 to Y 12, so the landing point is
--    the model bounding box: centre X/Z, lowest part Y + 1 (the feet).
--    Common -> MosquitoMama, Uncommon -> UncommonMama,
--    Rare -> RareMama, Epic -> EpicMama, Legendary -> LegendaryMama.
--    Mythical / Divine / Secret have no boss model.
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v3.8"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false
local buildTries = 0

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local HP_LOG_RATE  = 5.0
local COLLECT_RATE = 1.5
local AURA_RATE    = 0.2
local FARHIT_RATE  = 0.5
local ATK_TTL      = 0.5
local MOVE_EPS2    = 1
local FOOT_LIFT    = 1
local STRAY_D2     = 144
local BUILD_WAIT   = 900
local HB_RATE      = 0.4

-- hitbox tuning
local HB_MULT_SMALL = 3
local HB_MULT_BIG   = 6
local HB_AXIS_CAP   = 24

local BOSS_TYPES = {
    "Common", "Uncommon", "Rare", "Legendary",
    "Mythical", "Divine", "Secret", "Epic",
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Aura        = false,
    FarHit      = false,
    Hitbox      = false,
    HitboxBig   = false,
}

local TOGGLES     = {}
local getterWorks = {}

local selected   = {}
local holdPos    = nil
local holdTarget = nil

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function fmt(p)
    return tostring(math.floor(p.X)) .. ","
        .. tostring(math.floor(p.Y)) .. ","
        .. tostring(math.floor(p.Z))
end

local function dist2(a, b)
    local dx = a.X - b.X
    local dy = a.Y - b.Y
    local dz = a.Z - b.Z
    return dx * dx + dy * dy + dz * dz
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local first = atkCache[1]
        local p1 = first and first.Parent
        local p2 = p1 and p1.Parent
        if p1 and p2 then
            return atkCache
        end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swing()
    if not alive() then return false end

    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- Area / boss lookup
--------------------------------------------------------------------
local function areaModel(bossType)
    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return nil end
    return areas:FindFirstChild(bossType .. "Area")
end

local function bossModelIn(area)
    if not area then return nil end

    local kids = area:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if c.ClassName == "Model" and string.find(c.Name, "Mama", 1, true) then
            return c
        end
    end
    return nil
end

local function bossOf(bossType)
    return bossModelIn(areaModel(bossType))
end

-- ClassName walk, because IsA() is always true here and
-- FindFirstChildOfClass can return the wrong child.
local function findHumanoid(boss)
    if not boss then return nil end

    local direct = boss:FindFirstChild("Humanoid")
    if direct and direct.ClassName == "Humanoid" then return direct end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if not ok or not desc then return nil end

    for i = 1, #desc do
        if desc[i].ClassName == "Humanoid" then return desc[i] end
    end
    return nil
end

-- returns current health, max health; both nil when not readable
local function bossHealth(bossType)
    local boss = bossOf(bossType)
    if not boss then return nil, nil end

    local hum = findHumanoid(boss)
    if hum then
        local okH, hp = pcall(function() return hum.Health end)
        if okH and type(hp) == "number" then
            local okM, mx = pcall(function() return hum.MaxHealth end)
            if not okM or type(mx) ~= "number" or mx <= 0 then mx = hp end
            return hp, mx
        end
    end

    local pairsToTry = {
        { "Health", "MaxHealth" },
        { "HP",     "MaxHP" },
        { "Hp",     "MaxHp" },
    }

    for i = 1, #pairsToTry do
        local okA, hp = pcall(function()
            return boss:GetAttribute(pairsToTry[i][1])
        end)
        if okA and type(hp) == "number" then
            local okB, mx = pcall(function()
                return boss:GetAttribute(pairsToTry[i][2])
            end)
            if not okB or type(mx) ~= "number" or mx <= 0 then mx = hp end
            return hp, mx
        end
    end

    return nil, nil
end

-- landing point at the boss FEET: centre X/Z, lowest part Y + FOOT_LIFT
local function bossFeet(bossType)
    local boss = bossOf(bossType)
    if not boss then return nil, "no boss" end

    local hp = bossHealth(bossType)
    if hp and hp <= 0 then return nil, "dead" end

    local okD, desc = pcall(function() return boss:GetDescendants() end)
    if not okD or not desc then return nil, "no parts" end

    local minX, maxX = 1e9, -1e9
    local minY = 1e9
    local minZ, maxZ = 1e9, -1e9
    local n = 0

    for i = 1, #desc do
        local d  = desc[i]
        if isBasePart(d) then
            local okP, p = pcall(function() return d.Position end)
            if okP and p then
                n = n + 1
                if p.X < minX then minX = p.X end
                if p.X > maxX then maxX = p.X end
                if p.Y < minY then minY = p.Y end
                if p.Z < minZ then minZ = p.Z end
                if p.Z > maxZ then maxZ = p.Z end
            end
        end
    end

    if n == 0 then return nil, "no parts" end

    local pos = Vector3.new(
        (minX + maxX) * 0.5,
        minY + FOOT_LIFT,
        (minZ + maxZ) * 0.5
    )

    return pos, boss.Name .. " feet"
end

local function healthReady()
    local n = 0
    for i = 1, #BOSS_TYPES do
        local _, mx = bossHealth(BOSS_TYPES[i])
        if mx then n = n + 1 end
    end
    return n >= 2
end

-- sorted by MAX health descending; unreadable bosses last, name order
local function orderedTypes()
    local arr = {}
    for i = 1, #BOSS_TYPES do arr[i] = BOSS_TYPES[i] end

    table.sort(arr, function(a, b)
        local _, ma = bossHealth(a)
        local _, mb = bossHealth(b)
        ma = ma or 0
        mb = mb or 0
        if ma ~= mb then return ma > mb end
        return a < b
    end)

    return arr
end

-- healthiest LIVING selected boss
local function pickTarget()
    local bestType, bestHp, bestPos, bestLabel = nil, -1, nil, nil

    for t, on in pairs(selected) do
        if on then
            local hp = bossHealth(t)
            if hp and hp > 0 then
                local pos, label = bossFeet(t)
                if pos and hp > bestHp then
                    bestType  = t
                    bestHp    = hp
                    bestPos   = pos
                    bestLabel = t .. " " .. tostring(label)
                end
            end
        end
    end

    return bestType, bestPos, bestLabel
end

local function moveTo(hrp, pos)
    if not hrp or not hrp.Parent or not pos then return false end
    if not alive() then return false end
    if dist2(hrp.Position, pos) <= MOVE_EPS2 then return false end

    pcall(function() hrp.CFrame = CFrame.new(pos.X, pos.Y, pos.Z) end)
    return true
end

local function selectBoss(bossType)
    selected[bossType] = true

    local hrp = rootPart()
    if not hrp or not alive() then
        print("[" .. NAME .. "] selected " .. bossType .. " (no character)")
        notifyUser("Selected " .. bossType, 2)
        return
    end

    local pos, label = bossFeet(bossType)
    if not pos then
        print("[" .. NAME .. "] selected " .. bossType
            .. " but not moving: " .. tostring(label))
        notifyUser("Selected " .. bossType .. " (" .. tostring(label) .. ")", 3)
        return
    end

    pcall(function() hrp.CFrame = CFrame.new(pos.X, pos.Y, pos.Z) end)
    holdPos    = pos
    holdTarget = bossType

    print("[" .. NAME .. "] go " .. bossType .. " via " .. tostring(label)
        .. " " .. fmt(pos))
    notifyUser("Go " .. bossType, 2)
end

--------------------------------------------------------------------
-- BOSS HITBOX EXPANDER
--   Local scale only. Saved sizes go back on toggle off / stop.
--------------------------------------------------------------------
local hbSaved = {}
local hbApplied = false

local function hbFactor()
    if Config.HitboxBig then return HB_MULT_BIG end
    return HB_MULT_SMALL
end

local function scaleAxis(v, f)
    local n = v * f
    if n > HB_AXIS_CAP and v < HB_AXIS_CAP then n = HB_AXIS_CAP end
    if n < v then n = v end
    return n
end

local function applyHitbox()
    local f = hbFactor()
    local touched = 0

    for i = 1, #BOSS_TYPES do
        local boss = bossOf(BOSS_TYPES[i])
        if boss then
            local okD, desc = pcall(function() return boss:GetDescendants() end)
            if okD and desc then
                for j = 1, #desc do
                    local d = desc[j]
                    if isBasePart(d) then
                        local base = hbSaved[d]
                        if base == nil then
                            local okS, s = pcall(function() return d.Size end)
                            if okS and s then
                                base = s
                                hbSaved[d] = s
                            end
                        end
                        if base then
                            local nx = scaleAxis(base.X, f)
                            local ny = scaleAxis(base.Y, f)
                            local nz = scaleAxis(base.Z, f)
                            pcall(function()
                                d.Size = Vector3.new(nx, ny, nz)
                            end)
                            touched = touched + 1
                        end
                    end
                end
            end
        end
    end

    return touched
end

local function restoreHitbox()
    local n = 0
    for part, size in pairs(hbSaved) do
        if part and part.Parent then
            pcall(function() part.Size = size end)
            n = n + 1
        end
    end
    hbSaved = {}
    if hbApplied then
        print("[" .. NAME .. "] hitbox restored on " .. tostring(n) .. " parts")
    end
    hbApplied = false
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name, boss)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name, boss = boss }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default, boss)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label, boss)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Kill Aura", "fam_aura", "Aura", false)
            addToggle(combat, "Far Hit", "fam_farhit", "FarHit", false)
            addToggle(combat, "Boss Hitbox Expander", "fam_hitbox", "Hitbox", false)
            addToggle(combat, "Bigger Hitbox (x6)", "fam_hitbox_big", "HitboxBig", false)
        end

        local pick = makeSection(tab, "Boss Select", "Right")
        if pick then
            local ordered = orderedTypes()
            local shown   = {}

            for i = 1, #ordered do
                local t   = ordered[i]
                local key = "Sel" .. t
                local id  = "fam_go_" .. string.lower(t)
                local hp, mx = bossHealth(t)

                local label = "Go " .. t
                if mx then
                    label = label .. " (" .. tostring(math.floor(mx)) .. ")"
                end

                addToggle(pick, label, id, key, false, t)
                shown[#shown + 1] = t .. "="
                    .. tostring(mx and math.floor(mx) or 0)
            end

            print("[" .. NAME .. "] boss order: " .. table.concat(shown, ", "))
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            if built then return end
            if type(tab) ~= "table" then return end

            buildTries = buildTries + 1

            -- wait for boss Health to be readable, or give up waiting
            if not healthReady() and buildTries < BUILD_WAIT then
                return
            end

            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true

                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))

                    if t.boss then
                        if val then
                            selectBoss(t.boss)
                        else
                            selected[t.boss] = nil
                            if holdTarget == t.boss then
                                holdTarget = nil
                                holdPos    = nil
                            end
                            print("[" .. NAME .. "] deselected " .. t.boss)
                        end
                    end
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- BOSS HITBOX LOOP
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Hitbox then
            local n = applyHitbox()
            if n > 0 and not hbApplied then
                hbApplied = true
                print("[" .. NAME .. "] hitbox x" .. tostring(hbFactor())
                    .. " on " .. tostring(n) .. " parts (local)")
            end
        elseif hbApplied then
            restoreHitbox()
        end
        task.wait(HB_RATE)
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0
    local lastMax     = 0
    local lastLog     = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                local max = math.floor(hum.MaxHealth)

                if max ~= lastMax then
                    if lastMax ~= 0 and max > lastMax
                        and (now - lastLog) >= HP_LOG_RATE then
                        print("[" .. NAME .. "] max health " .. tostring(max))
                        lastLog = now
                    end
                    lastMax = max
                end

                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL AURA  (hold position)
--   Skipped while Far Hit is on so they never fight over your CFrame.
--------------------------------------------------------------------
task.spawn(function()
    local lastLabel = nil

    while running do
        if Config.Aura and not Config.FarHit then
            local hrp = rootPart()
            if hrp and alive() then
                local targetType, pos, label = pickTarget()

                if pos then
                    local moved = false

                    if holdTarget ~= targetType or not holdPos
                        or dist2(hrp.Position, holdPos) > STRAY_D2 then
                        moved = moveTo(hrp, pos)
                        holdPos    = pos
                        holdTarget = targetType
                    end

                    if label ~= lastLabel then
                        lastLabel = label
                        print("[" .. NAME .. "] aura -> " .. tostring(label)
                            .. (moved and " (moved)" or " (holding)"))
                    end

                    swing()
                else
                    if lastLabel ~= "none" then
                        lastLabel = "none"
                        print("[" .. NAME .. "] no living selected boss")
                    end
                    holdPos    = nil
                    holdTarget = nil
                    swing()
                end
            end
        end
        task.wait(AURA_RATE)
    end
end)

--------------------------------------------------------------------
-- FAR HIT
--   In, swing, straight back. The server resolves the hit from the
--   character position at the moment of the swing.
--------------------------------------------------------------------
task.spawn(function()
    local lastLabel = nil

    while running do
        if Config.FarHit then
            local hrp = rootPart()
            if hrp and alive() then
                local targetType, pos, label = pickTarget()

                if pos then
                    local back = hrp.CFrame

                    pcall(function()
                        hrp.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
                    end)
                    swing()
                    pcall(function()
                        if hrp and hrp.Parent then hrp.CFrame = back end
                    end)

                    if label ~= lastLabel then
                        lastLabel = label
                        print("[" .. NAME .. "] far hit -> " .. tostring(label))
                    end
                elseif lastLabel ~= "none" then
                    lastLabel = "none"
                    print("[" .. NAME .. "] far hit: no living selected boss")
                end
            end
        end
        task.wait(FARHIT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() restoreHitbox() end)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache   = nil
    holdPos    = nil
    holdTarget = nil
    selected   = {}
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - pick bosses under Boss Select", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
