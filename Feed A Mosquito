--------------------------------------------------------------------
-- HEALTH OFFSET
--------------------------------------------------------------------
-- Verified this session: writing a float of -10 at
-- Humanoid.Address + 0x184 took health from 17116448 to -10 and the
-- character died. A scan of Address + 0..4096 found the health float
-- at offset 388 = 0x184, so the constant and theo's offsets agree.
-- Offsets move with Roblox updates, so fetch first, fall back after.
local OFFSETS_URL      = "https://offsets.imtheo.lol/version-9ac8595712b447a7/offsets.hpp"
local HEALTH_FALLBACK  = 0x184

local healthOffset       = HEALTH_FALLBACK
local healthOffsetSource = "fallback"

do
    local ok, res = pcall(function() return game:HttpGet(OFFSETS_URL) end)

    if ok and type(res) == "string" then
        local hex = res:match("Health%s*=%s*(0x%x+)")
        local n   = hex and tonumber(hex)

        if n and n > 0 then
            healthOffset       = n
            healthOffsetSource = "fetched"
        end
    end
end

print("[" .. NAME .. "] health offset " .. string.format("0x%X", healthOffset)
    .. " (" .. healthOffsetSource .. ")")

local respawnTime = nil

pcall(function()
    local rt = Players.RespawnTime
    if type(rt) == "number" then respawnTime = rt end
end)

if respawnTime then
    print("[" .. NAME .. "] game respawn time " .. tostring(respawnTime) .. "s (server-side)")
end

