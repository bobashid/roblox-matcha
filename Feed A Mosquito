local function stop()
    running = false

    pcall(stopHideLoop)
    pcall(unanchorHide)
    pcall(noClipOff)
    pcall(stopHud)
    pcall(restoreAttackParts)
    pcall(function() fireEvent('StopTransfuseBlood') end)

    bossCache      = {}
    bossStamp      = 0
    eggCache       = {}
    eggStamp       = 0
    partCache      = {}
    hatchFired     = {}
    hideSpot       = nil
    hideSurface    = nil
    hideLocked     = false
    hideResetAt    = nil
    pickingNow     = false
    tpAway         = false
    tpHome         = nil

    _G.FeedAMosquito = nil

    print('[' .. NAME .. '] stopped')
end

