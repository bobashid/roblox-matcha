--------------------------------------------------------------------
-- AUTO HATCH  (every Egg_<uuid> actor's Hatch remote)
--------------------------------------------------------------------
local function hatchAll()
    local actors = child(RS, "Runtime", "Actors")
    if not actors then return 0 end

    local ok, kids = pcall(function() return actors:GetChildren() end)
    if not ok or not kids then return 0 end

    local fired = 0

    for i = 1, #kids do
        local a = kids[i]
        local nm = a.Name

        if type(nm) == "string"
            and string.sub(nm, 1, 4) == "Egg_"
            and string.find(nm, "-", 1, true) then
            local ev = a:FindFirstChild("Events")
            local h  = ev and ev:FindFirstChild("Hatch")

            if h then
                if pcall(function() h:FireServer() end) then
                    fired = fired + 1
                end
            end
        end
    end

    return fired
end

