--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v6.3  -  FASTER SCAN, ALL BOSSES AT ONCE
--
--  Still no teleport. Nothing writes your CFrame.
--
--  WHY THE SCAN WAS SLOW
--    Every pass used to walk the whole tree: FindFirstChild SpawnAreas,
--    then 8 x FindFirstChild "<Type>Area", then GetChildren on each,
--    then GetDescendants on every boss, then read every part's Size.
--    That is hundreds of tree lookups every 0.3 s, and it ran again
--    from scratch even when nothing had changed.
--
--    Now there are two caches:
--      boss list   rebuilt every 0.6 s  (one GetChildren per area)
--      boss parts  rebuilt every 2.0 s  per boss (Address keyed)
--    A pass just reads the cached part references and compares sizes,
--    so steady state is a handful of reads with no writes at all.
--    The scan also no longer uses a fixed list of 8 type names - it
--    takes every Model in SpawnAreas whose name ends in "Mama" and
--    that has a Humanoid, so a new boss type is picked up for free.
--
--  ALL BOSSES AT ONCE
--    Each pass grows EVERY boss that is currently spawned, not one per
--    pass, and the reach pad is wider (40 studs past you), so all of
--    their boxes overlap your position in the same frame. One swing
--    then has every boss's body under it instead of only the closest,
--    and the farm volleys keep landing across all of them.
--
--  SIZES ARE STILL THE ONLY THING WRITTEN
--    CanCollide is never touched, so walls and floors keep colliding.
--    A boss must be a Model ending in "Mama" WITH a Humanoid - there is
--    no fallback, so Walls/grass/water/House are never resized.
--    Original sizes are saved once per Address and restored the moment
--    the toggle goes off or the script stops.
--
--  Auto Farm / Always Heal / Auto Collect unchanged.
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v6.3"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local COLLECT_RATE = 1.5
local SWING_RATE   = 0.06
local SWING_BURST  = 3
local BURST_GAP    = 0.015
local ATK_TTL      = 1.0

-- cache + hitbox tuning
local HB_RATE      = 0.25
local BOSS_TTL     = 0.6
local PART_TTL     = 2.0
local HB_PAD       = 40
local HB_MULT_MIN  = 2
local HB_MULT_MAX  = 2000
local HB_MAX_AXIS  = 3000

-- parts inside a boss model that must never be grown
local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
    Hitbox      = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

local function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function sizeDiffers(a, b)
    if not a or not b then return false end
    local eps = 0.5
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    if dx < 0 then dx = -dx end
    if dy < 0 then dy = -dy end
    if dz < 0 then dz = -dz end
    return dx > eps or dy > eps or dz > eps
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local okAll = true
        for i = 1, #atkCache do
            local r = atkCache[i]
            if not r or not r.Parent then okAll = false break end
        end
        if okAll then return atkCache end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swingOnce()
    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

--------------------------------------------------------------------
-- Boss lookup (strict, no fallback) + caches
--------------------------------------------------------------------
local bossCache = {}
local bossStamp = 0
local partCache = {}   -- boss address -> { stamp, entries, maxHalf, centerPart }
local hbSaved   = {}   -- part address -> { part, size }
local hbApplied = false

local function isBossModel(m)
    if not m then return false end
    if m.ClassName ~= "Model" then return false end

    local nm = m.Name
    if type(nm) ~= "string" then return false end
    if string.sub(nm, -4) ~= "Mama" then return false end

    return m:FindFirstChild("Humanoid") ~= nil
end

local function collectBosses()
    local out = {}

    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return out end

    local okA, areaKids = pcall(function() return areas:GetChildren() end)
    if not okA or not areaKids then return out end

    for i = 1, #areaKids do
        local area = areaKids[i]
        local ok, kids = pcall(function() return area:GetChildren() end)

        if ok and kids then
            for j = 1, #kids do
                local m = kids[j]
                if isBossModel(m) then
                    out[#out + 1] = m
                end
            end
        end
    end

    return out
end

local function bossList()
    local now = tick()
    if (now - bossStamp) < BOSS_TTL then return bossCache end

    bossCache = collectBosses()
    bossStamp = now
    return bossCache
end

local function buildParts(boss)
    local entries   = {}
    local maxHalf   = 0.5
    local centerPart = nil

    local r = boss:FindFirstChild("HumanoidRootPart")
    if r and r.ClassName == "Part" then centerPart = r end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if not ok or not desc then
        return { entries = entries, maxHalf = maxHalf, centerPart = centerPart }
    end

    for j = 1, #desc do
        local d = desc[j]

        if isBasePart(d) and not SKIP_PART[d.Name] then
            local okS, s = pcall(function() return d.Size end)

            if okS and s then
                local pk = keyOf(d)

                if pk ~= nil then
                    local e = hbSaved[pk]

                    if e == nil then
                        e = { part = d, size = s }
                        hbSaved[pk] = e
                    end

                    entries[#entries + 1] = e

                    local half = math.max(e.size.X, e.size.Y, e.size.Z) * 0.5
                    if half > maxHalf then maxHalf = half end

                    if centerPart == nil then centerPart = d end
                end
            end
        end
    end

    return { entries = entries, maxHalf = maxHalf, centerPart = centerPart }
end

local function bossParts(boss)
    local k   = keyOf(boss)
    local now = tick()

    local rec = k and partCache[k]
    if rec and (now - rec.stamp) < PART_TTL then return rec end

    local fresh = buildParts(boss)
    fresh.stamp = now

    if k then partCache[k] = fresh end
    return fresh
end

--------------------------------------------------------------------
-- CROSS-MAP HITBOX (every boss, Size writes only)
--------------------------------------------------------------------
local function pruneCaches()
    local dead = nil

    for k, e in pairs(hbSaved) do
        local gone = false

        if not e.part then
            gone = true
        else
            local ok, parent = pcall(function() return e.part.Parent end)
            if not ok or parent == nil then gone = true end
        end

        if gone then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do hbSaved[dead[i]] = nil end
    end

    local deadP = nil

    for k, rec in pairs(partCache) do
        local anyAlive = false

        for j = 1, #rec.entries do
            local p = rec.entries[j].part
            local ok, parent = pcall(function() return p and p.Parent end)
            if ok and parent ~= nil then
                anyAlive = true
                break
            end
        end

        if not anyAlive then
            deadP = deadP or {}
            deadP[#deadP + 1] = k
        end
    end

    if deadP then
        for i = 1, #deadP do partCache[deadP[i]] = nil end
    end
end

local function restoreHitbox()
    local n = 0

    for k, e in pairs(hbSaved) do
        local p = e.part
        if p then
            local ok, parent = pcall(function() return p.Parent end)
            if ok and parent ~= nil then
                pcall(function() p.Size = e.size end)
                n = n + 1
            end
        end
    end

    hbSaved   = {}
    partCache = {}

    if hbApplied then
        print("[" .. NAME .. "] hitbox restored on " .. tostring(n) .. " parts")
    end
    hbApplied = false
end

local function multForDistance(dist, maxHalf)
    if maxHalf < 0.5 then maxHalf = 0.5 end

    local m = ((dist + HB_PAD) / maxHalf) * 1.15

    if m < HB_MULT_MIN then m = HB_MULT_MIN end
    if m > HB_MULT_MAX then m = HB_MULT_MAX end

    local cap = HB_MAX_AXIS / (maxHalf * 2)
    if m > cap then m = cap end
    if m < 1 then m = 1 end

    return m
end

local function growBoss(boss, myPos)
    local rec = bossParts(boss)
    if #rec.entries == 0 then return 0 end

    local cp = rec.centerPart
    if not cp then return 0 end

    local okP, center = pcall(function() return cp.Position end)
    if not okP or not center then return 0 end

    local okD, dist = pcall(function() return (center - myPos).Magnitude end)
    if not okD or type(dist) ~= "number" then return 0 end

    local mult    = multForDistance(dist, rec.maxHalf)
    local touched = 0

    for j = 1, #rec.entries do
        local e = rec.entries[j]

        local target = Vector3.new(
            e.size.X * mult,
            e.size.Y * mult,
            e.size.Z * mult
        )

        local okCur, cur = pcall(function() return e.part.Size end)

        if not okCur or not cur or sizeDiffers(cur, target) then
            pcall(function() e.part.Size = target end)
        end

        touched = touched + 1
    end

    return touched
end

local function applyHitbox()
    local hrp = rootPart()
    if not hrp then return 0, 0 end

    local okM, myPos = pcall(function() return hrp.Position end)
    if not okM or not myPos then return 0, 0 end

    local list = bossList()
    local parts  = 0
    local bosses = 0

    for i = 1, #list do
        local n = growBoss(list[i], myPos)
        if n > 0 then
            parts = parts + n
            bosses = bosses + 1
        end
    end

    return parts, bosses
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Cross-Map Hitbox (all bosses)", "fam_hitbox", "Hitbox", false)
            addToggle(combat, "Auto Farm (spam attack)", "fam_farm", "Farm", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- HITBOX LOOP (all bosses every pass, cached scan)
--------------------------------------------------------------------
task.spawn(function()
    local warned = false

    while running do
        if Config.Hitbox then
            pruneCaches()

            local parts, bosses = applyHitbox()

            if parts > 0 then
                warned = false
                if not hbApplied then
                    hbApplied = true
                    print("[" .. NAME .. "] cross-map hitbox on "
                        .. tostring(bosses) .. " bosses, "
                        .. tostring(parts) .. " parts")
                end
            elseif not warned then
                warned = true
                print("[" .. NAME .. "] no boss spawned right now")
            end
        elseif hbApplied then
            restoreHitbox()
        end

        task.wait(HB_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO SWING
--------------------------------------------------------------------
task.spawn(function()
    local wasOn  = false
    local warned = false

    while running do
        if Config.Farm and alive() then
            if not wasOn then
                wasOn  = true
                warned = false
                print("[" .. NAME .. "] auto farm on")
            end

            if not swingOnce() then
                if not warned then
                    warned = true
                    print("[" .. NAME .. "] no Attack remote - equip a weapon")
                end
            else
                for b = 2, SWING_BURST do
                    task.wait(BURST_GAP)
                    if not running or not Config.Farm then break end
                    swingOnce()
                end
            end

            task.wait(SWING_RATE)
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto farm off")
            end
            task.wait(0.1)
        end
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(function() restoreHitbox() end)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    atkCache  = nil
    bossCache = {}
    bossStamp = 0
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - cached scan, all bosses at once", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
