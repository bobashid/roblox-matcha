--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v8.2  -  BOSS GROWTH IS GONE FOR GOOD
--
--  WHY v8.1 BROKE AFTER THE FIRST RUN
--    Boss growth saved a part's size the first time it saw it. On the
--    next run those parts were still grown (or had been grown by the
--    previous run), so the grown size was saved as the "original" and
--    multiplied again. Each reload made the bosses bigger, until the
--    physics gave out and it stopped working. That is the "worked
--    once then broke" you saw.
--
--    So nothing on a boss is written any more. No size, no CanCollide,
--    no CFrame. The boss models are only ever READ.
--
--  WHAT RESTARTS THE CONTACT INSTEAD
--    Only our own AttackPart is touched, which is why it cannot
--    compound and cannot break anything:
--
--        Size = 2 studs      -> every contact with every boss ends
--        (one frame)
--        Size = map size     -> every boss part is a NEW contact and
--                               the tool's TouchTransmitter fires
--
--    One pair per pass at 0.12 s = one fresh hit per boss per pass.
--    The map size is recomputed from the farthest spawned boss:
--        side = (farthest + 30) * 2      [60 .. 4000]
--    Original size saved per Address and restored on toggle off.
--
--  Everything else is v7.6, which you said was right:
--    - touch signals on the boss parts every pass
--    - PlaySound("SwingSound") + Attack fired on the LIVE tool actor,
--      resolved from the tool's ActorId value (name matching picks a
--      dead copy, because every equip leaves one behind)
--    - no mouse input of any kind, no click, no press, no PlayAnim, no
--      equip or unequip, nothing reparented, so nothing can crash
--
--  TOGGLES
--      Auto Health   - TransfuseBlood loop
--      Auto Collect  - CollectIncome / ClaimOfflineIncome
--      Kill Farm     - the size cycle + touch + burst above
--
--  Boss HP is summed each pass; one line prints if it stops dropping.
--  Keep a weapon equipped. All toggles start OFF.
--  Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v8.2"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local COLLECT_RATE = 1.5
local HIT_RATE     = 0.12
local TOUCH_PARTS  = 4
local ATK_BURST    = 2
local STALE_LIMIT  = 40

-- size cycle tuning
local AP_SMALL     = 2      -- studs; small enough that no contact remains
local AP_HOLD      = 0.03   -- one frame between the two writes
local REACH_PAD    = 30
local REACH_MIN    = 60
local REACH_MAX    = 4000
local BOSS_TTL     = 0.6
local PART_TTL     = 2.0

local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

local function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function sizeDiffers(a, b)
    if not a or not b then return false end
    local eps = 0.5
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    if dx < 0 then dx = -dx end
    if dy < 0 then dy = -dy end
    if dz < 0 then dz = -dz end
    return dx > eps or dy > eps or dz > eps
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- LIVE TOOL ACTOR (resolved through the tool's ActorId)
--------------------------------------------------------------------
local function equippedTool()
    local c = LP.Character
    if not c then return nil end

    local kids = c:GetChildren()
    for i = 1, #kids do
        local t = kids[i]
        if t.ClassName == "Tool" then
            if t:FindFirstChild("ActorId") then return t end
        end
    end

    return nil
end

local function actorIdOf(tool)
    if not tool then return nil end

    local idv = tool:FindFirstChild("ActorId")
    if not idv then return nil end

    local ok, id = pcall(function() return idv.Value end)
    if ok and type(id) == "string" then return id end
    return nil
end

local function remotesOfActor(name)
    if not name then return nil, nil end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil, nil end

    local a = actors:FindFirstChild(name)
    if not a then return nil, nil end

    local ev = a:FindFirstChild("Events")
    if not ev then return nil, nil end

    return ev:FindFirstChild("Attack"), ev:FindFirstChild("PlaySound")
end

--------------------------------------------------------------------
-- Boss lookup (READ ONLY, strict, cached)
--------------------------------------------------------------------
local bossCache = {}
local bossStamp = 0
local partCache = {}

local function isBossModel(m)
    if not m then return false end
    if m.ClassName ~= "Model" then return false end

    local nm = m.Name
    if type(nm) ~= "string" then return false end
    if string.sub(nm, -4) ~= "Mama" then return false end

    return m:FindFirstChild("Humanoid") ~= nil
end

local function collectBosses()
    local out = {}

    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return out end

    local okA, areaKids = pcall(function() return areas:GetChildren() end)
    if not okA or not areaKids then return out end

    for i = 1, #areaKids do
        local ok, kids = pcall(function() return areaKids[i]:GetChildren() end)

        if ok and kids then
            for j = 1, #kids do
                local m = kids[j]
                if isBossModel(m) then out[#out + 1] = m end
            end
        end
    end

    return out
end

local function bossList()
    local now = tick()
    if (now - bossStamp) < BOSS_TTL then return bossCache end

    bossCache = collectBosses()
    bossStamp = now
    return bossCache
end

local function bossPosition(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local r = boss:FindFirstChild("HumanoidRootPart")
    if not r then return nil end

    local ok, p = pcall(function() return r.Position end)
    if ok and p then return p end
    return nil
end

local function bossHealth(boss)
    if not boss then return nil end

    local okP, parent = pcall(function() return boss.Parent end)
    if not okP or parent == nil then return nil end

    local h = boss:FindFirstChild("Humanoid")
    if not h then return nil end

    local okH, hp = pcall(function() return h.Health end)
    if okH and type(hp) == "number" then return hp end
    return nil
end

local function bossParts(boss)
    local k   = keyOf(boss)
    local now = tick()

    local rec = k and partCache[k]
    if rec and (now - rec.stamp) < PART_TTL then return rec.parts end

    local parts = {}

    local r = boss:FindFirstChild("HumanoidRootPart")
    if r and isBasePart(r) then parts[#parts + 1] = r end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if ok and desc then
        for j = 1, #desc do
            if #parts >= TOUCH_PARTS then break end

            local d = desc[j]
            if isBasePart(d) and not SKIP_PART[d.Name] and d ~= r then
                parts[#parts + 1] = d
            end
        end
    end

    if k then partCache[k] = { stamp = now, parts = parts } end
    return parts
end

local function pruneParts()
    local dead = nil

    for k, rec in pairs(partCache) do
        local anyAlive = false

        for j = 1, #rec.parts do
            local p = rec.parts[j]
            local ok, parent = pcall(function() return p and p.Parent end)
            if ok and parent ~= nil then
                anyAlive = true
                break
            end
        end

        if not anyAlive then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do partCache[dead[i]] = nil end
    end
end

local function farthestBoss(myPos)
    local list = bossList()
    local far  = 0
    local seen = 0

    for i = 1, #list do
        local bp = bossPosition(list[i])
        if bp then
            local ok, d = pcall(function() return (bp - myPos).Magnitude end)
            if ok and type(d) == "number" then
                seen = seen + 1
                if d > far then far = d end
            end
        end
    end

    return far, seen
end

--------------------------------------------------------------------
-- ATTACKPART  (the only thing ever written)
--------------------------------------------------------------------
local apSaved = {}
local reachOn = false

local function attackPartOf(tool)
    if not tool then return nil end

    local ap = tool:FindFirstChild("AttackPart")
    if ap and isBasePart(ap) then return ap end

    local ok, desc = pcall(function() return tool:GetDescendants() end)
    if ok and desc then
        for j = 1, #desc do
            local d = desc[j]
            if isBasePart(d) and d.Name == "AttackPart" then return d end
        end
    end

    return nil
end

local function mapSize()
    local hrp = rootPart()
    if not hrp then return nil, 0 end

    local okM, myPos = pcall(function() return hrp.Position end)
    if not okM or not myPos then return nil, 0 end

    local far, seen = farthestBoss(myPos)

    local side = (far + REACH_PAD) * 2
    if side < REACH_MIN then side = REACH_MIN end
    if side > REACH_MAX then side = REACH_MAX end

    return Vector3.new(side, side, side), seen
end

local function rememberPart(ap)
    local k = keyOf(ap)
    if k == nil then return end

    if apSaved[k] == nil then
        local okS, s = pcall(function() return ap.Size end)
        if okS and s then
            apSaved[k] = { part = ap, size = s }
        end
    end
end

local function restoreAttackParts()
    local n = 0

    for k, e in pairs(apSaved) do
        local p = e.part
        if p then
            pcall(function() p.Size = e.size end)
            n = n + 1
        end
    end

    apSaved = {}

    if reachOn then
        print("[" .. NAME .. "] AttackPart restored on " .. tostring(n))
    end
    reachOn = false
    return n
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Auto Health", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Kill Farm (repeat hits)", "fam_farm", "Farm", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL FARM  (size cycle + touch signals + live actor burst)
--------------------------------------------------------------------
task.spawn(function()
    local hasTouch = (type(firetouchinterest) == "function")

    local wasOn      = false
    local warnedTool = false
    local warnedAct  = false
    local staleWarn  = false
    local noBossWarn = false

    local lastSum  = nil
    local stale    = 0
    local cachedId = nil
    local cachedAtk, cachedPs = nil, nil

    if not hasTouch then
        print("[" .. NAME .. "] firetouchinterest missing - size cycle only")
    end

    while running do
        if Config.Farm and alive() then
            local tool = equippedTool()

            if not tool then
                if not warnedTool then
                    warnedTool = true
                    print("[" .. NAME .. "] kill farm: equip a weapon")
                end
                cachedId, cachedAtk, cachedPs = nil, nil, nil
                task.wait(0.25)
            else
                warnedTool = false

                local id = actorIdOf(tool)

                if id ~= cachedId then
                    cachedId = id
                    cachedAtk, cachedPs = remotesOfActor(id)

                    if cachedAtk then
                        print("[" .. NAME .. "] live actor " .. tostring(id))
                    end
                end

                local ap = attackPartOf(tool)

                if not ap then
                    if not warnedAct then
                        warnedAct = true
                        print("[" .. NAME .. "] kill farm: no AttackPart on this tool")
                    end
                    cachedId = nil
                    task.wait(0.25)
                else
                    warnedAct = false

                    if not wasOn then
                        wasOn = true
                        print("[" .. NAME .. "] kill farm on (size cycle per pass)")
                    end

                    rememberPart(ap)

                    local big, seen = mapSize()

                    -- 1. shrink: every contact with every boss ends
                    pcall(function()
                        ap.Size = Vector3.new(AP_SMALL, AP_SMALL, AP_SMALL)
                    end)

                    task.wait(AP_HOLD)

                    -- 2. grow back: every boss part is a brand new contact
                    if big then
                        pcall(function() ap.Size = big end)
                        reachOn = true
                    end

                    local list = bossList()

                    if seen > 0 then
                        noBossWarn = false

                        if hasTouch then
                            pruneParts()

                            for i = 1, #list do
                                local boss = list[i]
                                local hp   = bossHealth(boss)

                                if hp and hp > 0 then
                                    local parts = bossParts(boss)

                                    for j = 1, #parts do
                                        local part = parts[j]
                                        pcall(function()
                                            firetouchinterest(ap, part, 0)
                                        end)
                                    end
                                end
                            end
                        end
                    elseif not noBossWarn then
                        noBossWarn = true
                        print("[" .. NAME .. "] no boss spawned - box kept at minimum")
                    end

                    if cachedAtk then
                        for b = 1, ATK_BURST do
                            if cachedPs then
                                pcall(function() cachedPs:FireServer("SwingSound") end)
                            end
                            pcall(function() cachedAtk:FireServer() end)
                        end
                    end

                    local sum  = 0
                    local live = 0

                    for i = 1, #list do
                        local hp = bossHealth(list[i])
                        if hp and hp > 0 then
                            sum  = sum + hp
                            live = live + 1
                        end
                    end

                    if live == 0 then
                        stale = 0
                        staleWarn = false
                        lastSum = nil
                    elseif lastSum and sum >= lastSum then
                        stale = stale + 1

                        if stale >= STALE_LIMIT and not staleWarn then
                            staleWarn = true
                            print("[" .. NAME .. "] boss HP not dropping - hits not landing")
                        end
                    else
                        stale = 0
                        staleWarn = false
                    end

                    if live > 0 then lastSum = sum end

                    task.wait(HIT_RATE)
                end
            end
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] kill farm off")
            end

            warnedTool = false
            warnedAct  = false
            stale      = 0
            staleWarn  = false
            noBossWarn = false
            lastSum    = nil
            cachedId, cachedAtk, cachedPs = nil, nil, nil

            if reachOn then
                restoreAttackParts()
            end

            task.wait(0.1)
        end
    end
end)

--------------------------------------------------------------------
-- AUTO HEALTH
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

--------------------------------------------------------------------
-- AUTO COLLECT
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.AutoCollect then
            fireEvent("CollectIncome")
            fireEvent("ClaimOfflineIncome")
        end
        task.wait(COLLECT_RATE)
    end
end)

--------------------------------------------------------------------
local function stop()
    running = false
    pcall(restoreAttackParts)
    pcall(function() fireEvent("StopTransfuseBlood") end)
    bossCache = {}
    bossStamp = 0
    partCache = {}
    _G.FeedAMosquito = nil
    print("[" .. NAME .. "] stopped")
end

_G.FeedAMosquito = { stop = stop, version = VERSION }

notifyUser("Loaded - no boss writes, size cycle hits", 5)
print("[" .. NAME .. "] " .. VERSION .. " loaded | menu=" .. tostring(HAS_UI))
