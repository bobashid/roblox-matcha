--==================================================================
--  Feed A Mosquito  |  Matcha LuaVM menu tab (UI.AddTab)
--
--  v6.1
--
--  WHAT BROKE THE GAME (found by probing the real tree)
--    SpawnAreas/<Type>Area does NOT hold only the boss. It holds:
--
--        Walls   (Model, 120x27 stud parts, windows, beams)
--        grass1 / water1 / ice / sand / House / tu1 / tu2
--        <Type>Mama   <- the actual boss, has a Humanoid
--
--    The old lookup took "first Model whose name contains Mama", and
--    when no boss was spawned it FELL BACK to the first Model in the
--    area. That fallback was Walls. The expander then resized walls,
--    windows and beams and switched their CanCollide off - which is
--    exactly the "no collision walls / broken map" you saw.
--
--  THE FIX
--    A boss is now only accepted when BOTH are true:
--        name ends with "Mama"   AND   it has a Humanoid
--    There is no fallback any more. If no boss is spawned in an area,
--    that area is skipped - nothing else in it is ever written to.
--
--  WHY HITS WERE MISSING
--    The old pass pushed a size write to every part of every boss every
--    0.2 s (8 bosses x ~25 parts, hundreds of writes) plus a CanCollide
--    write each time. That is the expensive path in this VM and it was
--    fighting the game's own resets, so the box often was not where the
--    swing was when it landed.
--    Now only the HB_PARTS (6) largest body parts per boss are grown,
--    the size is compared before writing, and CanCollide is written
--    once when the part first changes - not every pass.
--
--  BOSS HITBOX (own toggle)
--    Grows those 6 parts so the biggest one spans from the boss to you:
--        mult = (dist + PAD) / largestHalf * 1.15      [50..1500]
--    Original size and CanCollide are saved once per Address and put
--    back when the toggle goes off or the script stops. HumanoidRootPart
--    is skipped (it lies on the arena floor) and anything already 40+
--    studs on an axis is treated as scenery and never touched.
--
--  KILL EVERYTHING / CROSS-MAP HIT
--    Standoff teleport: jump to a point just OUTSIDE the boss body, fire
--    the Attack volley there, come straight back. Never inside the
--    model, so contact damage does not fire. Now uses the same strict
--    boss lookup, so it stops chasing walls too.
--
--  Always Heal / Auto Collect / Auto Farm unchanged.
--
--  All toggles start OFF. Stop with _G.FeedAMosquito.stop().
--==================================================================
local Players = game:GetService("Players")
local RS      = game:GetService("ReplicatedStorage")
local WS      = game:GetService("Workspace")

local LP = Players.LocalPlayer

local NAME    = "Feed A Mosquito"
local VERSION = "v6.1"

if _G.FeedAMosquito and _G.FeedAMosquito.stop then
    pcall(_G.FeedAMosquito.stop)
end
print("[" .. NAME .. "] " .. VERSION)

local running = true
local built   = false

-- fixed tuning
local POLL_RATE    = 0.1
local HEAL_RATE    = 0.25
local HEAL_REFIRE  = 1.0
local COLLECT_RATE = 1.5
local SWING_RATE   = 0.06
local SWING_BURST  = 3
local BURST_GAP    = 0.015
local ATK_TTL      = 1.0
local HB_RATE      = 0.25
local REACH_RATE   = 0.12
local REACH_HEIGHT = 2.0

-- standoff tuning
local STANDOFF_PAD = 8
local STANDOFF_MIN = 10
local ATTACK_BURST = 10

-- hitbox tuning
local HB_PARTS      = 6      -- largest body parts grown per boss
local HB_PAD        = 25
local HB_MULT_MIN   = 50
local HB_MULT_MAX   = 1500
local HB_SKIP_SIZE  = 40     -- original axis this big -> scenery
local HB_MAX_AXIS   = 6000   -- never write a part bigger than this

local BOSS_TYPES = {
    "Common", "Uncommon", "Rare", "Legendary",
    "Mythical", "Divine", "Secret", "Epic",
}

local SKIP_PART = {
    Area      = true,
    ChaseArea = true,
    HumanoidRootPart = true,
}

local Config = {
    Heal        = false,
    AutoCollect = false,
    Farm        = false,
    Reach       = false,
    KillAll     = false,
    Hitbox      = false,
}

local TOGGLES     = {}
local getterWorks = {}

_G.FeedAMosquito = { stop = function() running = false end }

--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function humanoid()
    local c = LP.Character
    if not c then return nil end
    local h = c:FindFirstChild("Humanoid")
    if h and h.ClassName == "Humanoid" then return h end
    return nil
end

local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function alive()
    local hum = humanoid()
    return hum ~= nil and hum.Health > 0
end

local function notifyUser(msg, dur)
    pcall(function() notify(NAME, msg, dur or 3) end)
end

local function child(a, b, c)
    if not a or not b then return nil end
    local n1 = a:FindFirstChild(b)
    if not n1 or not c then return n1 end
    return n1:FindFirstChild(c)
end

local function isBasePart(p)
    local cn = p.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation"
        or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
        or cn == "SpawnLocation" or cn == "Seat" or cn == "VehicleSeat"
end

local function keyOf(inst)
    if inst == nil then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and a ~= nil then return a end
    return inst
end

local function sizeDiffers(a, b)
    if not a or not b then return false end
    local eps = 0.5
    local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
    if dx < 0 then dx = -dx end
    if dy < 0 then dy = -dy end
    if dz < 0 then dz = -dz end
    return dx > eps or dy > eps or dz > eps
end

--------------------------------------------------------------------
-- Player actor remotes
--------------------------------------------------------------------
local pEvents = nil
local pFor    = nil

local function playerEvents()
    if pFor == LP.UserId and pEvents then return pEvents end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local actor = actors:FindFirstChild("Player_" .. tostring(LP.UserId))
    if not actor then return nil end

    pEvents = actor:FindFirstChild("Events")
    pFor    = LP.UserId
    return pEvents
end

local function fireEvent(name)
    local events = playerEvents()
    local r = events and events:FindFirstChild(name)
    if not r then return false end
    return (pcall(function() r:FireServer() end))
end

--------------------------------------------------------------------
-- Tool actor Attack remotes
--------------------------------------------------------------------
local atkCache = nil
local atkStamp = 0

local function attackRemotes()
    local now = tick()

    if atkCache and #atkCache > 0 and (now - atkStamp) < ATK_TTL then
        local okAll = true
        for i = 1, #atkCache do
            local r = atkCache[i]
            if not r or not r.Parent then okAll = false break end
        end
        if okAll then return atkCache end
        atkCache = nil
    end

    local actors = child(RS, "Runtime", "Actors")
    if not actors then return nil end

    local prefix = "Tool_Character_" .. tostring(LP.UserId) .. "_"
    local plen   = #prefix
    local out    = {}
    local kids   = actors:GetChildren()

    for i = 1, #kids do
        local a = kids[i]
        if string.sub(a.Name, 1, plen) == prefix then
            local ev  = a:FindFirstChild("Events")
            local atk = ev and ev:FindFirstChild("Attack")
            if atk then out[#out + 1] = atk end
        end
    end

    if #out == 0 then
        atkCache = nil
        return nil
    end

    atkCache = out
    atkStamp = now
    return out
end

local function swingOnce()
    local list = attackRemotes()
    if not list then return false end

    for i = 1, #list do
        pcall(function() list[i]:FireServer() end)
    end
    return true
end

local function swingBurst(n)
    local any = false
    for i = 1, n do
        if swingOnce() then any = true end
    end
    return any
end

--------------------------------------------------------------------
-- Boss lookup (STRICT - no fallback, ever)
--------------------------------------------------------------------
local function areaModel(bossType)
    local areas = WS:FindFirstChild("SpawnAreas")
    if not areas then return nil end
    return areas:FindFirstChild(bossType .. "Area")
end

-- a boss is a Model whose name ends in "Mama" AND that has a Humanoid
local function isBossModel(m)
    if not m then return false end
    if m.ClassName ~= "Model" then return false end

    local nm = m.Name
    if type(nm) ~= "string" then return false end
    if string.sub(nm, -4) ~= "Mama" then return false end

    local h = m:FindFirstChild("Humanoid")
    return h ~= nil
end

local function bossOf(bossType)
    local area = areaModel(bossType)
    if not area then return nil end

    local kids = area:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        if isBossModel(c) then return c end
    end

    return nil
end

local function bossCenter(boss)
    local r = boss:FindFirstChild("HumanoidRootPart")
    if r and r.ClassName == "Part" then
        local ok, p = pcall(function() return r.Position end)
        if ok and p then return p end
    end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if ok and desc then
        for i = 1, #desc do
            local d = desc[i]
            if isBasePart(d) and d.Name ~= "HumanoidRootPart" then
                local okP, p = pcall(function() return d.Position end)
                if okP and p then return p end
            end
        end
    end

    return nil
end

local radiusCache = {}

local function bossRadius(boss)
    local k = keyOf(boss)
    if k and radiusCache[k] then return radiusCache[k] end

    local rad = STANDOFF_MIN
    local r = boss:FindFirstChild("HumanoidRootPart")

    if r then
        local ok, s = pcall(function() return r.Size end)
        if ok and s then
            rad = math.max(s.X, s.Y, s.Z) * 0.5 + STANDOFF_PAD
        end
    end

    if rad < STANDOFF_MIN then rad = STANDOFF_MIN end
    if k then radiusCache[k] = rad end
    return rad
end

--------------------------------------------------------------------
-- STANDOFF POINT (outside the body, inside attack range)
--------------------------------------------------------------------
local function standoffPoint(center, basePos, radius)
    local dx = basePos.X - center.X
    local dz = basePos.Z - center.Z
    local len = math.sqrt(dx * dx + dz * dz)

    if len < 0.5 then
        dx, dz, len = 1, 0, 1
    end

    local ux = dx / len
    local uz = dz / len

    return Vector3.new(
        center.X + ux * radius,
        center.Y + REACH_HEIGHT,
        center.Z + uz * radius
    )
end

--------------------------------------------------------------------
-- CROSS-MAP HIT (single boss per pass)
--------------------------------------------------------------------
local reachIndex = 0
local reachHome  = nil
local reachAway  = false

local function reachBack()
    if reachAway and reachHome then
        local hrp = rootPart()
        if hrp then
            pcall(function() hrp.CFrame = reachHome end)
        end
    end
    reachAway = false
    reachHome = nil
end

local function reachPass()
    local hrp = rootPart()
    if not hrp then return nil end

    local okH, home = pcall(function() return hrp.CFrame end)
    if not okH or not home then return nil end

    local total = #BOSS_TYPES
    local boss  = nil

    for i = 1, total do
        reachIndex = (reachIndex % total) + 1
        local b = bossOf(BOSS_TYPES[reachIndex])
        if b then boss = b break end
    end

    if not boss then return nil end

    local center = bossCenter(boss)
    if not center then return nil end

    local spot = standoffPoint(center, home.Position, bossRadius(boss))

    reachHome = home
    reachAway = true

    pcall(function() hrp.CFrame = CFrame.new(spot) end)
    swingBurst(ATTACK_BURST)

    local okR, hrp2 = pcall(function() return rootPart() end)
    local back = (okR and hrp2) or hrp
    pcall(function() back.CFrame = home end)

    reachAway = false
    reachHome = nil
    return BOSS_TYPES[reachIndex]
end

--------------------------------------------------------------------
-- KILL EVERYTHING (all bosses, standoff, no body contact)
--------------------------------------------------------------------
local function killAllPass()
    local hrp = rootPart()
    if not hrp then return 0 end

    local okH, home = pcall(function() return hrp.CFrame end)
    if not okH or not home then return 0 end

    local basePos = home.Position
    local done    = 0

    for i = 1, #BOSS_TYPES do
        local boss = bossOf(BOSS_TYPES[i])
        if boss then
            local center = bossCenter(boss)
            if center then
                local spot = standoffPoint(center, basePos, bossRadius(boss))
                pcall(function() hrp.CFrame = CFrame.new(spot) end)
                swingBurst(ATTACK_BURST)
                done = done + 1
            end
        end
    end

    pcall(function() hrp.CFrame = home end)
    return done
end

--------------------------------------------------------------------
-- BOSS HITBOX (boss models only, saved once per Address)
--------------------------------------------------------------------
local hbSaved   = {}   -- address -> { part, size, collide, grown }
local hbApplied = false

local function pruneSaved()
    local dead = nil
    for k, e in pairs(hbSaved) do
        local gone = false

        if not e.part then
            gone = true
        else
            local ok, parent = pcall(function() return e.part.Parent end)
            if not ok or parent == nil then gone = true end
        end

        if gone then
            dead = dead or {}
            dead[#dead + 1] = k
        end
    end

    if dead then
        for i = 1, #dead do hbSaved[dead[i]] = nil end
    end
end

local function restoreHitbox()
    local n = 0

    for k, e in pairs(hbSaved) do
        local p = e.part
        if p then
            local ok, parent = pcall(function() return p.Parent end)
            if ok and parent ~= nil then
                pcall(function() p.Size = e.size end)
                pcall(function() p.CanCollide = e.collide end)
                n = n + 1
            end
        end
    end

    hbSaved = {}

    if hbApplied then
        print("[" .. NAME .. "] hitbox restored on " .. tostring(n) .. " parts")
    end
    hbApplied = false
end

local function multForDistance(dist, maxHalf)
    if maxHalf < 0.5 then maxHalf = 0.5 end
    local m = ((dist + HB_PAD) / maxHalf) * 1.15
    if m < HB_MULT_MIN then m = HB_MULT_MIN end
    if m > HB_MULT_MAX then m = HB_MULT_MAX end
    return m
end

-- returns parts touched; ONLY called with a verified boss model
local function growBoss(boss, myPos)
    local center = bossCenter(boss)
    if not center then return 0 end

    local okD, dist = pcall(function() return (center - myPos).Magnitude end)
    if not okD or type(dist) ~= "number" then return 0 end

    local ok, desc = pcall(function() return boss:GetDescendants() end)
    if not ok or not desc then return 0 end

    -- collect the biggest body parts only
    local picks = {}

    for j = 1, #desc do
        local d = desc[j]
        if isBasePart(d) and not SKIP_PART[d.Name] then
            local okS, s = pcall(function() return d.Size end)
            if okS and s then
                if not (s.X >= HB_SKIP_SIZE or s.Y >= HB_SKIP_SIZE or s.Z >= HB_SKIP_SIZE) then
                    local k = keyOf(d)
                    if k ~= nil then
                        local e = hbSaved[k]
                        if e == nil then
                            local okC, c = pcall(function() return d.CanCollide end)
                            e = {
                                part    = d,
                                size    = s,
                                collide = (okC and c) and true or false,
                                grown   = false,
                            }
                            hbSaved[k] = e
                        end
                        if e then
                            local half = math.max(e.size.X, e.size.Y, e.size.Z) * 0.5
                            picks[#picks + 1] = { e = e, half = half }
                        end
                    end
                end
            end
        end
    end

    if #picks == 0 then return 0 end

    table.sort(picks, function(a, b) return a.half > b.half end)

    local maxHalf = picks[1].half
    local mult    = multForDistance(dist, maxHalf)
    local count   = math.min(#picks, HB_PARTS)
    local touched = 0

    for j = 1, count do
        local e = picks[j].e
        local target = Vector3.new(
            e.size.X * mult,
            e.size.Y * mult,
            e.size.Z * mult
        )

        local biggest = math.max(target.X, target.Y, target.Z)
        if biggest <= HB_MAX_AXIS then
            local okCur, cur = pcall(function() return e.part.Size end)
            if not okCur or not cur or sizeDiffers(cur, target) then
                if e.grown then
                    pcall(function() e.part.CanCollide = false end)
                else
                    pcall(function() e.part.CanCollide = false end)
                    e.grown = true
                end
                pcall(function() e.part.Size = target end)
            end
            touched = touched + 1
        end
    end

    return touched
end

local function applyHitbox()
    local hrp = rootPart()
    if not hrp then return 0 end

    local myPos = hrp.Position
    if not myPos then return 0 end

    local touched = 0

    for i = 1, #BOSS_TYPES do
        local boss = bossOf(BOSS_TYPES[i])
        if boss then
            touched = touched + growBoss(boss, myPos)
        end
    end

    return touched
end

--------------------------------------------------------------------
-- Toggle plumbing
--------------------------------------------------------------------
local function applyBool(key)
    return function(a, b, c)
        if getterWorks[key] then return end
        if type(a) == "boolean" then Config[key] = a return end
        if type(b) == "boolean" then Config[key] = b return end
        if type(c) == "boolean" then Config[key] = c return end
    end
end

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function safeToggle(sec, name, id, default, cb)
    local tries = {
        function() sec:Toggle(name, id, default, cb) end,
        function() sec:Toggle(id, name, default, cb) end,
        function() sec:Toggle(name, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn("[" .. NAME .. "] Toggle failed: " .. tostring(name))
    return false
end

local function makeSection(tab, name, side)
    local ok, sec = pcall(function() return tab:Section(name, side) end)
    if ok and type(sec) == "table" then return sec end
    ok, sec = pcall(function() return tab:Section(name) end)
    if ok and type(sec) == "table" then return sec end
    return nil
end

local function addToggle(sec, label, id, key, default)
    if safeToggle(sec, label, id, default, applyBool(key)) then
        registerToggle(key, id, label)
    end
end

--------------------------------------------------------------------
-- Menu
--------------------------------------------------------------------
local function buildTab(tab)
    if built then return end
    if type(tab) ~= "table" then return end
    built = true

    local ok, err = pcall(function()
        local main = makeSection(tab, "Main", "Left")
        if main then
            addToggle(main, "Always Heal", "fam_heal", "Heal", false)
            addToggle(main, "Auto Collect", "fam_collect", "AutoCollect", false)
        end

        local combat = makeSection(tab, "Combat", "Left")
        if combat then
            addToggle(combat, "Boss Hitbox (bosses only)", "fam_hitbox", "Hitbox", false)
            addToggle(combat, "Kill Everything (standoff)", "fam_killall", "KillAll", false)
            addToggle(combat, "Cross-Map Hit (one boss)", "fam_reach", "Reach", false)
            addToggle(combat, "Auto Farm (spam attack)", "fam_farm", "Farm", false)
        end
    end)

    if not ok then
        warn("[" .. NAME .. "] build error: " .. tostring(err))
    end
    print("[" .. NAME .. "] tab widgets built")
end

local HAS_UI = type(UI) == "table" and type(UI.AddTab) == "function"

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab(NAME, function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn("[" .. NAME .. "] UI.AddTab failed: " .. tostring(err))
        HAS_UI = false
    end
else
    warn("[" .. NAME .. "] no UI table - menu unavailable")
end

--------------------------------------------------------------------
-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- HITBOX LOOP
--------------------------------------------------------------------
task.spawn(function()
    while running do
        if Config.Hitbox then
            pruneSaved()
            local n = applyHitbox()
            if n > 0 and not hbApplied then
                hbApplied = true
                print("[" .. NAME .. "] hitbox on " .. tostring(n)
                    .. " boss parts (boss models only)")
            end
        elseif hbApplied then
            restoreHitbox()
        end

        task.wait(HB_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL EVERYTHING LOOP
--------------------------------------------------------------------
task.spawn(function()
    local wasOn  = false
    local warned = false

    while running do
        if Config.KillAll and alive() then
            if not wasOn then
                wasOn  = true
                warned = false
                print("[" .. NAME .. "] kill everything on (standoff)")
            end

            local n = killAllPass()

            if n == 0 and not warned then
                warned = true
                print("[" .. NAME .. "] no bosses spawned right now")
            end

            task.wait(REACH_RATE)
        else
            if wasOn then
                wasOn = false
                pcall(reachBack)
                print("[" .. NAME .. "] kill everything off")
            end
            task.wait(0.1)
        end
    end
end)

--------------------------------------------------------------------
-- CROSS-MAP REACH LOOP (skipped while KillAll runs)
--------------------------------------------------------------------
task.spawn(function()
    local wasOn  = false
    local warned = false

    while running do
        if Config.Reach and not Config.KillAll and alive() then
            if not wasOn then
                wasOn  = true
                warned = false
                print("[" .. NAME .. "] cross-map reach on")
            end

            local used = reachPass()
            if not used and not warned then
                warned = true
                print("[" .. NAME .. "] reach: no boss spawned right now")
            end

            task.wait(REACH_RATE)
        else
            if wasOn then
                wasOn = false
                pcall(reachBack)
                print("[" .. NAME .. "] cross-map reach off")
            end
            task.wait(0.1)
        end
    end
end)

--------------------------------------------------------------------
-- AUTO SWING (plain auto farm only)
--------------------------------------------------------------------
task.spawn(function()
    local wasOn  = false
    local warned = false

    while running do
        if Config.Farm and not Config.Reach and not Config.KillAll and alive() then
            if not wasOn then
                wasOn  = true
                warned = false
                print("[" .. NAME .. "] auto farm on (burst spam)")
            end

            if not swingOnce() then
                if not warned then
                    warned = true
                    print("[" .. NAME .. "] no Attack remote - equip a weapon")
                end
            else
                for b = 2, SWING_BURST do
                    task.wait(BURST_GAP)
                    if not running or not Config.Farm then break end
                    if Config.Reach or Config.KillAll then break end
                    swingOnce()
                end
            end

            task.wait(SWING_RATE)
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] auto farm off")
            end
            task.wait(0.1)
        end
    end
end)

--------------------------------------------------------------------
-- ALWAYS HEAL
--------------------------------------------------------------------
task.spawn(function()
    local transfusing = false
    local lastFire    = 0

    while running do
        if Config.Heal then
            local hum = humanoid()
            if hum then
                local now = tick()
                if not transfusing or (now - lastFire) >= HEAL_REFIRE then
                    if fireEvent("TransfuseBlood") then
                        transfusing = true
                        lastFire    = now
                    end
                end
            end
        elseif transfusing then
            fireEvent("StopTransfuseBlood")
            transfusing = false
        end

        task.wait(HEAL_RATE)
    end
end)

