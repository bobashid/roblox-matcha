-- TOGGLE POLLER
--------------------------------------------------------------------
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil

            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == "boolean" then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == "boolean" then val = v2 end
            end

            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print("[" .. NAME .. "] " .. t.key .. " = " .. tostring(val))
                end
            end
        end
        task.wait(POLL_RATE)
    end
end)

--------------------------------------------------------------------
-- KILL FARM
--------------------------------------------------------------------
task.spawn(function()
    local hasTouch = (type(firetouchinterest) == "function")

    local wasOn      = false
    local warnedTool = false
    local warnedAct  = false
    local staleWarn  = false
    local growWarn   = false

    local lastSum  = nil
    local stale    = 0
    local cachedId = nil
    local cachedAtk, cachedPs = nil, nil

    local touching = false

    if not hasTouch then
        print("[" .. NAME .. "] firetouchinterest missing - remotes only")
    end

    while running do
        if Config.Farm and alive() then
            local tool = equippedTool()

            if not tool then
                if not warnedTool then
                    warnedTool = true
                    print("[" .. NAME .. "] kill farm: equip a weapon")
                end
                cachedId, cachedAtk, cachedPs = nil, nil, nil
                task.wait(0.25)
            else
                warnedTool = false

                local id = actorIdOf(tool)

                if id ~= cachedId then
                    cachedId = id
                    cachedAtk, cachedPs = remotesOfActor(id)

                    if cachedAtk then
                        print("[" .. NAME .. "] live actor " .. tostring(id))
                    end
                end

                local ap = attackPartOf(tool)

                if not ap then
                    if not warnedAct then
                        warnedAct = true
                        print("[" .. NAME .. "] kill farm: no AttackPart on this tool")
                    end
                    cachedId = nil
                    task.wait(0.25)
                else
                    warnedAct = false

                    if not wasOn then
                        wasOn = true
                        print("[" .. NAME .. "] kill farm on (growth + contact cycle)")
                    end

                    local hrp = rootPart()
                    local myPos = nil

                    if hrp then
                        local okM, mp = pcall(function() return hrp.Position end)
                        if okM then myPos = mp end
                    end

                    scaleAttackPart(ap)
                    reachOn = true

                    local list = bossList()

                    -- moving surfaces: grown boss parts sweep through the tool
                    if Config.Growth and myPos then
                        pruneHb()

                        local grown = 0

                        for i = 1, #list do
                            local hp = bossHealth(list[i])
                            if hp and hp > 0 then
                                grown = grown + growBoss(list[i], myPos)
                            end
                        end

                        if grown == 0 and not growWarn then
                            growWarn = true
                            print("[" .. NAME .. "] growth: no boss parts to grow")
                        elseif grown > 0 then
                            growWarn = false
                        end
                    end

                    -- contact cycle, flipped once per pass as in v7.6
                    if hasTouch then
                        pruneParts()
                        touching = not touching

                        for i = 1, #list do
                            local boss = list[i]
                            local hp   = bossHealth(boss)

                            if hp and hp > 0 then
                                local parts = bossParts(boss)

                                for j = 1, #parts do
                                    local part = parts[j]

                                    if touching then
                                        pcall(function() firetouchinterest(ap, part, 0) end)
                                    else
                                        pcall(function() firetouchinterest(ap, part, 1) end)
                                    end
                                end
                            end
                        end
                    end

                    if cachedAtk then
                        for b = 1, ATK_BURST do
                            if cachedPs then
                                pcall(function() cachedPs:FireServer("SwingSound") end)
                            end
                            pcall(function() cachedAtk:FireServer() end)
                        end
                    end

                    local sum  = 0
                    local live = 0

                    for i = 1, #list do
                        local hp = bossHealth(list[i])
                        if hp and hp > 0 then
                            sum  = sum + hp
                            live = live + 1
                        end
                    end

                    if live == 0 then
                        stale = 0
                        staleWarn = false
                        lastSum = nil
                    elseif lastSum and sum >= lastSum then
                        stale = stale + 1

                        if stale >= STALE_LIMIT and not staleWarn then
                            staleWarn = true
                            print("[" .. NAME .. "] boss HP not dropping - hits not landing")
                        end
                    else
                        stale = 0
                        staleWarn = false
                    end

                    if live > 0 then lastSum = sum end

                    task.wait(HIT_RATE)
                end
            end
        else
            if wasOn then
                wasOn = false
                print("[" .. NAME .. "] kill farm off")
            end

            warnedTool = false
            warnedAct  = false
            stale      = 0
            staleWarn  = false
            lastSum    = nil
            touching   = false
            growWarn   = false
            cachedId, cachedAtk, cachedPs = nil, nil, nil

            local g = restoreGrowth()
            local m = restoreAttackParts()

            if g > 0 or m > 0 then
                print("[" .. NAME .. "] restored " .. tostring(g)
                    .. " boss parts, " .. tostring(m) .. " tool parts")
            end

            task.wait(0.1)
        end
    end
end)

