-- +1 Upgrade Per Kill - crit kill aura + health bars - Matcha LuauVM
-- v4.2 - fixes taken from a live diagnostic run on a second account:
--   1. Players:GetPlayerFromCharacter DOES NOT EXIST on this Matcha build.
--      It errors with "attempt to call missing method 'GetPlayerFromCharacter'
--      of Instance". It was used to tell a player character apart from an NPC,
--      so every player model was ALSO scanned as a bot and the local player
--      ended up in the target list as an NPC. Replaced with an Address set
--      rebuilt each collector tick (no GetPlayerFromCharacter anywhere).
--   2. RANGE was 30 studs. A live snapshot showed every other player 120-300
--      studs away, so the aura had literally nobody in range. RANGE is 250
--      now; lower it if the server starts rejecting swings.
--   3. New "Test Swing" button: fires one swing at the nearest target and
--      prints its health before, +0.4 s and +1.0 s. That answers "does the
--      server accept my swing" per account, in one click.
-- Payload: { crit, sprint, charge, vt, dir, eye, t } (confirmed in game).
-- No Instance.new, no hooks, no input simulation.

local NAME    = 'HitEveryone'
local VERSION = 'v4.2'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RS         = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local remotes = RS:FindFirstChild('Remotes')
local Attack  = remotes and remotes:FindFirstChild('Attack')
if not Attack then
    warn('[' .. NAME .. '] Remotes.Attack not found - script idle')
end

local RANGE         = 250     -- reach, studs (was 30; the arena is bigger)
local POOL          = 32      -- max simultaneous health bars
local SMOOTH_RATE   = 90      -- higher = snappier tracking
local SNAP_PX       = 10      -- snap onto the target past this jump, px
local COLLECT_EVERY = 0.35    -- re-resolve characters (3 Hz)
local HEALTH_EVERY  = 0.1     -- refresh cached health (10 Hz)
local FORGET_AFTER  = 3.0     -- drop a cached bar not seen for this long
local SWING_WAIT    = 0.04    -- 25 swings/s = Config.Combat.MaxAttacksPerSecond
local HURT_WINDOW   = 1.0     -- HurtResistantTicks 20 at 20 tps
local VERIFY_AFTER  = 0.12    -- wait this long before judging a swing
local MAX_BAR_DIST  = 400     -- do not draw bars past this many studs

-- jump assist (Crit Only mode). One impulse per JUMP_COOLDOWN; a velocity
-- write is expensive, so it never happens per frame.
local JUMP_VEL      = 26      -- upward studs/s
local JUMP_COOLDOWN = 0.45    -- seconds between auto jumps
local CRIT_VEL_Y    = -1.5    -- falling faster than this counts as airborne
local CRIT_STALL    = 1.5     -- no crit window for this long -> swing anyway

local HEAD_OFFSET = Vector3.new(0, 2.6, 0)
local FEET_OFFSET = Vector3.new(0, 2.4, 0)
local EYE_OFFSET  = Vector3.new(0, 1.5, 0)

-- Only the local player is excluded automatically (by UserId). Add lowercase
-- names here if you ever want to skip someone specific:  ['name'] = true
local EXCLUDE = {}

local NPC_FOLDERS = { 'Bots', 'NPCs', 'Npcs', 'Enemies', 'Dummies', 'AI' }

local running  = true
local built    = false
local targets  = {}
local lastHit  = {}
local pending  = {}
local lastJump = 0
local lastCrit = 0

local statTargets, statZoneSkip, statSwings, statConfirms = 0, 0, 0, 0

local cfg = {
    aura     = true,
    bars     = true,
    critMode = true,
    autoJump = true,
    debug    = false,
}

local conns    = {}
local drawings = {}

local function trackConn(c)
    conns[#conns + 1] = c
    return c
end

local function trackDraw(d)
    drawings[#drawings + 1] = d
    return d
end

local function setBool(key, v)
    if cfg[key] ~= v then
        cfg[key] = v
        print('[' .. NAME .. '] ' .. key .. ' = ' .. tostring(v))
    end
end

local function myRoot()
    local c = lp.Character
    if not c then return nil end
    return c:FindFirstChild('HumanoidRootPart')
end

local function myZone()
    local c = lp.Character
    if not c then return 'none' end
    local ok, v = pcall(function() return c:GetAttribute('Zone') end)
    if ok then return tostring(v) end
    return 'nil'
end

-- true while actually falling, which is what the server checks for a crit
local function falling(root)
    if not root then return false end
    local v = root.AssemblyLinearVelocity
    if typeof(v) ~= 'Vector3' then return false end
    return v.Y < CRIT_VEL_Y
end

-- one throttled upward impulse so the falling check opens
local function tryJump(root, now)
    if now - lastJump < JUMP_COOLDOWN then return end
    local v = root.AssemblyLinearVelocity
    if typeof(v) ~= 'Vector3' then return end
    if v.Y > 5 then return end
    lastJump = now
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(v.X, JUMP_VEL, v.Z)
    end)
end

-- health bar pool -----------------------------------------------------

local pool     = {}
local entryKey = {}

local function newEntry(key)
    if #pool >= POOL then return nil end

    local bg = trackDraw(Drawing.new('Square'))
    bg.Filled       = true
    bg.Thickness    = 1
    bg.Color        = Color3.fromRGB(15, 15, 15)
    bg.Transparency = 0.3
    bg.Visible      = false

    local fill = trackDraw(Drawing.new('Square'))
    fill.Filled    = true
    fill.Thickness = 1
    fill.Color     = Color3.fromRGB(90, 220, 120)
    fill.Visible   = false

    local label = trackDraw(Drawing.new('Text'))
    label.Size    = 13
    label.Center  = true
    label.Outline = true
    label.Color   = Color3.fromRGB(255, 255, 255)
    label.Visible = false

    local e = {
        bg = bg, fill = fill, label = label,
        key = key, lastText = '',
        x = nil, y = nil, w = nil, h = nil,
        lastSeen = 0, used = false, target = nil,
    }
    pool[#pool + 1] = e
    entryKey[key] = e
    return e
end

local function acquire(key, now)
    local e = entryKey[key]
    if e then
        e.lastSeen = now
        return e
    end

    e = newEntry(key)
    if e then
        e.lastSeen = now
        return e
    end

    local oldest, oldestT = nil, math.huge
    for i = 1, #pool do
        local p = pool[i]
        if not p.used and p.lastSeen < oldestT then
            oldest, oldestT = p, p.lastSeen
        end
    end
    if not oldest then return nil end

    if oldest.key and entryKey[oldest.key] == oldest then
        entryKey[oldest.key] = nil
    end
    oldest.key      = key
    oldest.lastText = ''
    oldest.x, oldest.y, oldest.w, oldest.h = nil, nil, nil, nil
    oldest.lastSeen = now
    oldest.target   = nil
    entryKey[key]   = oldest
    return oldest
end

-- targeting -----------------------------------------------------------

local function excluded(name)
    if type(name) ~= 'string' then return false end
    return EXCLUDE[string.lower(name)] == true
end

local function addrOf(inst)
    if not inst then return nil end
    local ok, a = pcall(function() return inst.Address end)
    if ok and type(a) == 'number' then return a end
    return nil
end

-- Address -> true for every player character. Replaces
-- Players:GetPlayerFromCharacter, which is missing on this build.
local function playerCharSet()
    local set = {}
    local plist = Players:GetPlayers()
    for i = 1, #plist do
        local a = addrOf(plist[i].Character)
        if a then set[a] = true end
    end
    return set
end

local function hpOf(model)
    if not model then return nil end
    local h = model:GetAttribute('Health')
    if type(h) ~= 'number' then
        local hum = model:FindFirstChild('Humanoid')
        if hum then h = hum.Health end
    end
    return h
end

local function maxHpOf(model)
    local mh = model:GetAttribute('MaxHealth')
    if type(mh) ~= 'number' or mh <= 0 then
        local hum = model:FindFirstChild('Humanoid')
        if hum then mh = hum.MaxHealth end
    end
    if type(mh) ~= 'number' or mh <= 0 then mh = 20 end
    return mh
end

local function buildTarget(model, key, plr)
    if not model then return nil end
    if excluded(model.Name) then return nil end
    if model:GetAttribute('CombatantId') == nil then return nil end
    if model:GetAttribute('Zone') == 'Dead' then return nil end
    local root = model:FindFirstChild('HumanoidRootPart')
    if not root then return nil end
    local hp = hpOf(model)
    if type(hp) ~= 'number' or hp <= 0 then return nil end
    return {
        model = model,
        root  = root,
        key   = key,
        plr   = plr,
        hp    = hp,
        maxhp = maxHpOf(model),
    }
end

local function scanNPCs(out, charSet)
    local kids = workspace:GetChildren()
    for i = 1, #kids do
        local inst = kids[i]
        local cls = inst.ClassName
        if cls == 'Model' then
            -- skip anything that is a player character, by Address
            if not charSet[addrOf(inst)] then
                local t = buildTarget(inst, 'n' .. tostring(inst.Address), nil)
                if t and inst:GetAttribute('Zone') ~= 'Lobby' then out[#out + 1] = t end
            end
        elseif cls == 'Folder' then
            local wanted = false
            for k = 1, #NPC_FOLDERS do
                if inst.Name == NPC_FOLDERS[k] then wanted = true break end
            end
            if wanted then
                local sub = inst:GetChildren()
                for j = 1, #sub do
                    local m = sub[j]
                    if m.ClassName == 'Model' and not charSet[addrOf(m)] then
                        local t = buildTarget(m, 'n' .. tostring(m.Address), nil)
                        if t then out[#out + 1] = t end
                    end
                end
            end
        end
    end
end

-- swinging ------------------------------------------------------------

-- Mirrors the real client payload exactly:
--   Attack:FireServer(characterModel, { crit, sprint, charge, vt, dir, eye, t })
local function fireAt(model, eye, targetPos)
    local delta = targetPos - eye
    local dir
    if delta.Magnitude < 0.001 then
        dir = Vector3.new(0, -1, 0)
    else
        dir = delta.Unit
    end
    local payload = {
        crit   = true,
        sprint = false,
        charge = 1,
        vt     = os.time(),
        dir    = dir,
        eye    = eye,
        t      = os.clock(),
    }
    pcall(function()
        Attack:FireServer(model, payload)
    end)
end

-- one click test: swing at the nearest target and report its health ----

local function testSwing()
    if not Attack then
        print('[' .. NAME .. '] test: Remotes.Attack missing')
        return
    end
    local root = myRoot()
    if not root then
        print('[' .. NAME .. '] test: no HumanoidRootPart')
        return
    end

    local myPos = root.Position
    local best, bestD
    local list = targets
    for i = 1, #list do
        local tr = list[i].root
        if tr and tr.Parent then
            local d = (tr.Position - myPos).Magnitude
            if not bestD or d < bestD then
                best, bestD = list[i], d
            end
        end
    end

    if not best then
        print('[' .. NAME .. '] test: no target in the list (targets=' .. tostring(#list) .. ')')
        return
    end

    local before = hpOf(best.model)
    fireAt(best.model, myPos + EYE_OFFSET, best.root.Position)
    print('[' .. NAME .. '] test swing at ' .. tostring(best.model.Name) ..
          ' dist=' .. string.format('%.1f', bestD) ..
          ' hp=' .. tostring(before))

    task.spawn(function()
        task.wait(0.4)
        print('[' .. NAME .. '] test hp @0.4s = ' .. tostring(hpOf(best.model)))
        task.wait(0.6)
        print('[' .. NAME .. '] test hp @1.0s = ' .. tostring(hpOf(best.model)) ..
              ' (unchanged = server rejected the swing)')
    end)
end

-- menu ----------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Kill Aura')
        if not sec then return end
        mkToggle(sec, 'Kill Aura',   'aura',      true,  function(v) setBool('aura', v) end)
        mkToggle(sec, 'Crit Only',   'crit_mode', true,  function(v) setBool('critMode', v) end)
        mkToggle(sec, 'Auto Jump',   'auto_jump', true,  function(v) setBool('autoJump', v) end)
        mkToggle(sec, 'Health Bars', 'bars',      true,  function(v) setBool('bars', v) end)
        mkToggle(sec, 'Debug',       'debug',     false, function(v) setBool('debug', v) end)
        mkButton(sec, 'Test Swing', function()
            print('[' .. NAME .. '] test button pressed')
            pcall(testSwing)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] build error: ' .. tostring(err))
    end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Kill Aura', function(tab)
            if built then return end
            print('[' .. NAME .. '] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- poll the menu -------------------------------------------------------

task.spawn(function()
    while running do
        if HAS_UI and type(UI.GetValue) == 'function' then
            pcall(function()
                local v = UI.GetValue('aura')
                if type(v) ~= 'boolean' then v = UI.GetValue('Kill Aura') end
                if type(v) == 'boolean' then cfg.aura = v end

                local b = UI.GetValue('bars')
                if type(b) ~= 'boolean' then b = UI.GetValue('Health Bars') end
                if type(b) == 'boolean' then cfg.bars = b end

                local c = UI.GetValue('crit_mode')
                if type(c) ~= 'boolean' then c = UI.GetValue('Crit Only') end
                if type(c) == 'boolean' then cfg.critMode = c end

                local j = UI.GetValue('auto_jump')
                if type(j) ~= 'boolean' then j = UI.GetValue('Auto Jump') end
                if type(j) == 'boolean' then cfg.autoJump = j end

                local d = UI.GetValue('debug')
                if type(d) ~= 'boolean' then d = UI.GetValue('Debug') end
                if type(d) == 'boolean' then cfg.debug = d end
            end)
        end
        task.wait(0.1)
    end
end)

-- COLLECTOR: players + NPCs, player characters told apart by Address --

task.spawn(function()
    while running do
        local out = {}
        local skipped = 0
        local charSet = playerCharSet()
        local plist = Players:GetPlayers()

        for i = 1, #plist do
            local plr = plist[i]
            local isSelf = (plr.UserId == lp.UserId)
            if not isSelf and not excluded(plr.Name) then
                local c = plr.Character
                if c then
                    if c:GetAttribute('Zone') == 'Arena' then
                        local t = buildTarget(c, 'p' .. tostring(plr.UserId), plr)
                        if t then out[#out + 1] = t end
                    else
                        skipped = skipped + 1
                    end
                end
            end
        end

        pcall(scanNPCs, out, charSet)

        targets      = out
        statTargets  = #out
        statZoneSkip = skipped
        task.wait(COLLECT_EVERY)
    end
end)

-- HEALTH + VERIFY: 10 Hz ---------------------------------------------

task.spawn(function()
    while running do
        local now  = os.clock()
        local list = targets

        for i = 1, #list do
            local t = list[i]
            local h = hpOf(t.model)
            if type(h) == 'number' then t.hp = h end
        end

        -- a swing only becomes a confirmed hit (and starts the hurt window)
        -- when the target's health actually dropped
        for key, p in pairs(pending) do
            if (now - p.t) >= VERIFY_AFTER then
                pending[key] = nil
                local cur = nil
                local e = entryKey[key]
                if e and e.target then cur = e.target.hp end
                if cur == nil then
                    for i = 1, #list do
                        if list[i].key == key then cur = list[i].hp break end
                    end
                end
                if cur ~= nil and cur < p.hp - 0.01 then
                    lastHit[key] = p.t
                    statConfirms = statConfirms + 1
                end
            end
        end

        task.wait(HEALTH_EVERY)
    end
end)

-- DEBUG: one line every 5 s, only when the Debug toggle is on ---------

task.spawn(function()
    while running do
        task.wait(5)
        if cfg.debug then
            local inRange = 0
            local root = myRoot()
            if root then
                local myPos = root.Position
                local list  = targets
                for i = 1, #list do
                    local tr = list[i].root
                    if tr and tr.Parent and (tr.Position - myPos).Magnitude <= RANGE then
                        inRange = inRange + 1
                    end
                end
            end
            print('[' .. NAME .. '] targets=' .. statTargets ..
                  ' skippedZone=' .. statZoneSkip ..
                  ' inRange=' .. inRange ..
                  ' swings=' .. statSwings ..
                  ' confirms=' .. statConfirms ..
                  ' zone=' .. myZone() ..
                  ' crit=' .. tostring(falling(root)))
        end
    end
end)

-- kill aura: Crit Only self-jumps, and never goes fully silent ---------

task.spawn(function()
    local idx = 0
    while running do
        if cfg.aura and Attack then
            local root = myRoot()
            local fired = false

            if root then
                local now      = os.clock()
                local airborne = falling(root)
                local swingOk  = true

                if cfg.critMode then
                    if airborne then
                        lastCrit = now
                    elseif cfg.autoJump then
                        tryJump(root, now)
                    end
                    -- if no crit window has opened for CRIT_STALL seconds,
                    -- swing anyway: a dead aura is worse than a missed crit
                    swingOk = airborne or (now - lastCrit) >= CRIT_STALL
                end

                if swingOk then
                    local myPos = root.Position
                    local eye   = myPos + EYE_OFFSET
                    local list  = targets
                    local total = #list

                    if total > 0 then
                        local checked = 0
                        while checked < total do
                            idx = idx % total + 1
                            checked = checked + 1

                            local t  = list[idx]
                            local ok = true
                            local lh = lastHit[t.key]

                            if lh and (now - lh) < HURT_WINDOW then ok = false end
                            if ok and cfg.critMode and pending[t.key] ~= nil then ok = false end

                            if ok then
                                local tr = t.root
                                if tr and tr.Parent then
                                    local pos = tr.Position
                                    if (pos - myPos).Magnitude <= RANGE then
                                        local hpBefore = t.hp
                                        fireAt(t.model, eye, pos)
                                        pending[t.key] = { t = now, hp = hpBefore }
                                        statSwings = statSwings + 1
                                        fired = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end

            if fired then
                task.wait(SWING_WAIT)
            else
                task.wait(0.02)
            end
        else
            task.wait(0.05)
        end
    end
end)

-- RENDERER: cached refs only, one Position read and one projection pair

trackConn(RunService.RenderStepped:Connect(function(dt)
    local now = os.clock()

    if not cfg.bars then
        for i = 1, #pool do
            local e = pool[i]
            e.used = false
            e.bg.Visible    = false
            e.fill.Visible  = false
            e.label.Visible = false
        end
        return
    end

    local alpha = 1 - math.exp(-SMOOTH_RATE * (dt or 0.016))
    if alpha > 1 then alpha = 1 end
    if alpha < 0.35 then alpha = 0.35 end

    local snapSq  = SNAP_PX * SNAP_PX
    local list    = targets
    local cam     = workspace.CurrentCamera
    local camPos  = cam and cam.CFrame.Position or nil
    local maxDist = MAX_BAR_DIST

    for i = 1, #list do
        local t    = list[i]
        local root = t.root

        if root and root.Parent then
            local pos = root.Position
            local near = true
            if camPos and (pos - camPos).Magnitude > maxDist then
                near = false
            end

            if near then
                local top, v1 = WorldToScreen(pos + HEAD_OFFSET)
                local bot, v2 = WorldToScreen(pos - FEET_OFFSET)

                if v1 and v2 then
                    local hgt = bot.Y - top.Y
                    if hgt > 8 then
                        local e = acquire(t.key, now)
                        if e then
                            e.target = t
                            local w = hgt * 0.55
                            if w < 16 then w = 16 end

                            local tx = top.X
                            local ty = top.Y

                            if e.x == nil then
                                e.x, e.y, e.w, e.h = tx, ty, w, hgt
                            else
                                local dx = tx - e.x
                                local dy = ty - e.y
                                if (dx * dx + dy * dy) > snapSq then
                                    e.x, e.y = tx, ty
                                else
                                    e.x = e.x + dx * alpha
                                    e.y = e.y + dy * alpha
                                end
                                e.w = e.w + (w   - e.w) * alpha
                                e.h = e.h + (hgt - e.h) * alpha
                            end

                            local maxhp = t.maxhp
                            if type(maxhp) ~= 'number' or maxhp <= 0 then maxhp = 20 end
                            local hp   = t.hp or maxhp
                            local frac = hp / maxhp
                            if frac < 0 then frac = 0 end
                            if frac > 1 then frac = 1 end

                            local barH  = 4
                            local barY  = e.y - 10
                            local leftX = e.x - e.w * 0.5

                            e.bg.Position = Vector2.new(leftX, barY)
                            e.bg.Size     = Vector2.new(e.w, barH)
                            e.bg.Visible  = true

                            local fillW = e.w * frac
                            e.fill.Position = Vector2.new(leftX, barY)
                            e.fill.Size     = Vector2.new(fillW, barH)
                            e.fill.Color    = Color3.fromRGB(math.floor(255 * (1 - frac)) + 20, math.floor(200 * frac) + 30, 60)
                            e.fill.Visible  = fillW > 0.5

                            local txt = math.floor(hp) .. '/' .. math.floor(maxhp)
                            if e.lastText ~= txt then
                                e.label.Text = txt
                                e.lastText   = txt
                            end
                            e.label.Position = Vector2.new(e.x, barY - 16)
                            e.label.Visible  = true

                            e.used = true
                        end
                    end
                end
            end
        end
    end

    for i = 1, #pool do
        local e = pool[i]
        if not e.used then
            e.bg.Visible    = false
            e.fill.Visible  = false
            e.label.Visible = false
            e.target = nil
            if e.key and (now - e.lastSeen) > FORGET_AFTER then
                if entryKey[e.key] == e then entryKey[e.key] = nil end
                e.key = nil
                e.x, e.y, e.w, e.h = nil, nil, nil, nil
            end
        end
        e.used = false
    end
end))

-- stop ----------------------------------------------------------------

local function stop()
    running = false
    cfg.aura = false
    cfg.bars = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    for i = 1, #drawings do
        pcall(function() drawings[i]:Remove() end)
    end
    drawings = {}
    pool     = {}
    entryKey = {}
    lastHit  = {}
    pending  = {}
    if HAS_UI then
        pcall(function() UI.RemoveTab('Kill Aura') end)
    end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI) .. ' - open the Kill Aura tab')
