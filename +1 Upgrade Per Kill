-- +1 Upgrade Per Kill - crit kill aura + health bars - Matcha LuauVM
-- Every swing is sent with crit = true, continuously. In this game a crit can
-- land while grounded, so the aura does NOT wait for a jump or a fall; the
-- falling-window check is kept only as an optional toggle, default off.
-- Health bars: health only, no names, keyed per combatant, snapped on big
-- movement so they never trail.
-- No Instance.new, no hooks, no input simulation.

local NAME    = 'HitEveryone'
local VERSION = 'v3.4'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RS         = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local remotes = RS:FindFirstChild('Remotes')
local Attack  = remotes and remotes:FindFirstChild('Attack')
if not Attack then
    warn('[' .. NAME .. '] Remotes.Attack not found - script idle')
end

local RANGE         = 30      -- maxed reach, studs
local POOL          = 40      -- max simultaneous health bars
local SMOOTH_RATE   = 90      -- higher = snappier tracking
local SNAP_PX       = 10      -- snap onto the target past this jump, px
local COLLECT_EVERY = 0.1     -- target list refresh, seconds
local FORGET_AFTER  = 2.0     -- drop a bar key not seen for this long
local CRIT_VEL_Y    = -1.5    -- falling faster than this = falling window

local EXCLUDE = {
    ['o_csf']        = true,
    ['fakeaimboton'] = true,
}

local NPC_FOLDERS = { 'Bots', 'NPCs', 'Npcs', 'Enemies', 'Dummies', 'AI' }

local running = true
local built   = false
local targets = {}

local cfg = {
    aura      = true,
    bars      = true,
    critOnly  = false,   -- false: swing always, crit = true on every swing
    critInd   = true,
}

local conns    = {}
local drawings = {}

local function trackConn(c)
    conns[#conns + 1] = c
    return c
end

local function trackDraw(d)
    drawings[#drawings + 1] = d
    return d
end

local function setBool(key, v)
    if cfg[key] ~= v then
        cfg[key] = v
        print('[' .. NAME .. '] ' .. key .. ' = ' .. tostring(v))
    end
end

-- falling window (optional gate only) --------------------------------

local function myRoot()
    local c = lp.Character
    if not c then return nil end
    return c:FindFirstChild('HumanoidRootPart')
end

local function falling(root)
    if not root then return false end
    local v = root.AssemblyLinearVelocity
    if typeof(v) ~= 'Vector3' then return false end
    return v.Y < CRIT_VEL_Y
end

-- health bar pool -----------------------------------------------------

local pool     = {}
local entryKey = {}

local function newEntry(key)
    if #pool >= POOL then return nil end

    local bg = trackDraw(Drawing.new('Square'))
    bg.Filled       = true
    bg.Thickness    = 1
    bg.Color        = Color3.fromRGB(15, 15, 15)
    bg.Transparency = 0.3
    bg.Visible      = false

    local fill = trackDraw(Drawing.new('Square'))
    fill.Filled    = true
    fill.Thickness = 1
    fill.Color     = Color3.fromRGB(90, 220, 120)
    fill.Visible   = false

    local label = trackDraw(Drawing.new('Text'))
    label.Size    = 13
    label.Center  = true
    label.Outline = true
    label.Color   = Color3.fromRGB(255, 255, 255)
    label.Visible = false

    local e = {
        bg = bg, fill = fill, label = label,
        key = key, lastText = '',
        x = nil, y = nil, w = nil, h = nil,
        lastSeen = 0, used = false,
    }
    pool[#pool + 1] = e
    entryKey[key] = e
    return e
end

local function acquire(key, now)
    local e = entryKey[key]
    if e then
        e.lastSeen = now
        return e
    end

    e = newEntry(key)
    if e then
        e.lastSeen = now
        return e
    end

    local oldest, oldestT = nil, math.huge
    for i = 1, #pool do
        local p = pool[i]
        if not p.used and p.lastSeen < oldestT then
            oldest, oldestT = p, p.lastSeen
        end
    end
    if not oldest then return nil end

    if oldest.key and entryKey[oldest.key] == oldest then
        entryKey[oldest.key] = nil
    end
    oldest.key      = key
    oldest.lastText = ''
    oldest.x, oldest.y, oldest.w, oldest.h = nil, nil, nil, nil
    oldest.lastSeen = now
    entryKey[key]   = oldest
    return oldest
end

-- crit indicator ------------------------------------------------------

local critText = trackDraw(Drawing.new('Text'))
critText.Size    = 18
critText.Center  = true
critText.Outline = true
critText.Color   = Color3.fromRGB(255, 210, 90)
critText.Text    = 'CRIT'
critText.Visible = false

-- targeting -----------------------------------------------------------

local function excluded(name)
    if type(name) ~= 'string' then return false end
    return EXCLUDE[string.lower(name)] == true
end

local function hpOf(model)
    local h = model:GetAttribute('Health')
    if type(h) ~= 'number' then
        local hum = model:FindFirstChild('Humanoid')
        if hum then h = hum.Health end
    end
    return h
end

local function maxHpOf(model)
    local mh = model:GetAttribute('MaxHealth')
    if type(mh) ~= 'number' or mh <= 0 then
        local hum = model:FindFirstChild('Humanoid')
        if hum then mh = hum.MaxHealth end
    end
    if type(mh) ~= 'number' or mh <= 0 then mh = 20 end
    return mh
end

local function playerTarget(plr)
    if plr == lp then return nil end
    if excluded(plr.Name) then return nil end
    local c = plr.Character
    if not c then return nil end
    if c:GetAttribute('CombatantId') == nil then return nil end
    if c:GetAttribute('Zone') ~= 'Arena' then return nil end
    local hp = hpOf(c)
    if type(hp) ~= 'number' or hp <= 0 then return nil end
    return { plr = plr, model = c, key = 'p' .. tostring(plr.UserId), maxhp = maxHpOf(c) }
end

local function npcTarget(model)
    if excluded(model.Name) then return nil end
    if model:GetAttribute('CombatantId') == nil then return nil end
    if model:GetAttribute('Zone') == 'Dead' then return nil end
    local hp = hpOf(model)
    if type(hp) ~= 'number' or hp <= 0 then return nil end
    if not model:FindFirstChild('HumanoidRootPart') then return nil end
    return { model = model, key = 'n' .. tostring(model.Address), maxhp = maxHpOf(model) }
end

local function scanNPCs(out)
    local kids = workspace:GetChildren()
    for i = 1, #kids do
        local inst = kids[i]
        if inst.ClassName == 'Model' then
            local t = npcTarget(inst)
            if t then out[#out + 1] = t end
        elseif inst.ClassName == 'Folder' then
            local wanted = false
            for k = 1, #NPC_FOLDERS do
                if inst.Name == NPC_FOLDERS[k] then wanted = true break end
            end
            if wanted then
                local sub = inst:GetChildren()
                for j = 1, #sub do
                    local m = sub[j]
                    if m.ClassName == 'Model' then
                        local t = npcTarget(m)
                        if t then out[#out + 1] = t end
                    end
                end
            end
        end
    end
end

-- swinging ------------------------------------------------------------

local function fireAt(model, eye, targetPos)
    local dir = targetPos - eye
    if dir.Magnitude < 0.001 then
        dir = Vector3.new(0, -1, 0)
    else
        dir = dir.Unit
    end
    local payload = {
        sprint = false,
        crit   = true,          -- every swing asks for a crit
        eye    = eye,
        dir    = dir,
        block  = false,
        charge = 1,
        t      = os.clock(),
        vt     = nil,
    }
    pcall(function()
        Attack:FireServer(model, payload)
    end)
end

-- menu ----------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Kill Aura')
        if not sec then return end
        mkToggle(sec, 'Kill Aura',      'aura',      true,  function(v) setBool('aura', v) end)
        mkToggle(sec, 'Health Bars',    'bars',      true,  function(v) setBool('bars', v) end)
        mkToggle(sec, 'Crit Indicator', 'crit_ind',  true,  function(v) setBool('critInd', v) end)
        mkToggle(sec, 'Falling Only',   'crit_only', false, function(v) setBool('critOnly', v) end)
    end)
    if not ok then
        warn('[' .. NAME .. '] build error: ' .. tostring(err))
    end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Kill Aura', function(tab)
            if built then return end
            print('[' .. NAME .. '] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- poll the menu -------------------------------------------------------

task.spawn(function()
    while running do
        if HAS_UI and type(UI.GetValue) == 'function' then
            pcall(function()
                local v = UI.GetValue('aura')
                if type(v) ~= 'boolean' then v = UI.GetValue('Kill Aura') end
                if type(v) == 'boolean' then cfg.aura = v end

                local b = UI.GetValue('bars')
                if type(b) ~= 'boolean' then b = UI.GetValue('Health Bars') end
                if type(b) == 'boolean' then cfg.bars = b end

                local co = UI.GetValue('crit_only')
                if type(co) ~= 'boolean' then co = UI.GetValue('Falling Only') end
                if type(co) == 'boolean' then cfg.critOnly = co end

                local ci = UI.GetValue('crit_ind')
                if type(ci) ~= 'boolean' then ci = UI.GetValue('Crit Indicator') end
                if type(ci) == 'boolean' then cfg.critInd = ci end
            end)
        end
        task.wait(0.1)
    end
end)

-- collector: membership only, 10 times a second ----------------------

task.spawn(function()
    while running do
        local out = {}
        local plist = Players:GetPlayers()
        for i = 1, #plist do
            local t = playerTarget(plist[i])
            if t then out[#out + 1] = t end
        end
        pcall(scanNPCs, out)
        targets = out
        task.wait(COLLECT_EVERY)
    end
end)

-- kill aura: every swing carries crit = true -------------------------

task.spawn(function()
    while running do
        if cfg.aura and Attack then
            local root = myRoot()
            if root then
                -- Falling Only is off by default: swing whether or not we are
                -- airborne, because crits land on the ground in this game.
                local swing = true
                if cfg.critOnly then
                    swing = falling(root)
                end

                if swing then
                    local myPos = root.Position
                    local eye = myPos + Vector3.new(0, 1.5, 0)
                    local list = targets
                    for i = 1, #list do
                        if not running or not cfg.aura then break end
                        local t = list[i]
                        local tr
                        if t.plr then
                            local ch = t.plr.Character
                            tr = ch and ch:FindFirstChild('HumanoidRootPart')
                        else
                            tr = t.model:FindFirstChild('HumanoidRootPart')
                        end
                        if tr and tr.Parent then
                            local pos = tr.Position
                            if (pos - myPos).Magnitude <= RANGE then
                                fireAt(t.model, eye, pos)
                            end
                        end
                    end
                end
            end
            task.wait(0.01)
        else
            task.wait(0.1)
        end
    end
end)

-- health bars + falling indicator, every frame -----------------------

trackConn(RunService.RenderStepped:Connect(function(dt)
    local now = os.clock()

    if cfg.critInd then
        local root = myRoot()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize
        if falling(root) and vp then
            critText.Position = Vector2.new(vp.X * 0.5, vp.Y - 130)
            critText.Visible  = true
        else
            critText.Visible  = false
        end
    else
        critText.Visible = false
    end

    if not cfg.bars then
        for i = 1, #pool do
            local e = pool[i]
            e.used = false
            e.bg.Visible    = false
            e.fill.Visible  = false
            e.label.Visible = false
        end
        return
    end

    local alpha = 1 - math.exp(-SMOOTH_RATE * (dt or 0.016))
    if alpha > 1 then alpha = 1 end
    if alpha < 0.35 then alpha = 0.35 end

    local snapSq = SNAP_PX * SNAP_PX
    local list   = targets

    for i = 1, #list do
        local t = list[i]

        local model, root
        if t.plr then
            model = t.plr.Character
            root  = model and model:FindFirstChild('HumanoidRootPart')
        else
            model = t.model
            root  = model and model:FindFirstChild('HumanoidRootPart')
        end

        if model and root and root.Parent then
            local hp = hpOf(model)
            if type(hp) == 'number' and hp > 0 then
                local pos = root.Position
                local top, v1 = WorldToScreen(pos + Vector3.new(0, 2.6, 0))
                local bot, v2 = WorldToScreen(pos - Vector3.new(0, 2.4, 0))

                if v1 and v2 then
                    local hgt = bot.Y - top.Y
                    if hgt > 8 then
                        local e = acquire(t.key, now)
                        if e then
                            local w = hgt * 0.55
                            if w < 16 then w = 16 end

                            local tx = top.X
                            local ty = top.Y

                            if e.x == nil then
                                e.x, e.y, e.w, e.h = tx, ty, w, hgt
                            else
                                local dx = tx - e.x
                                local dy = ty - e.y
                                if (dx * dx + dy * dy) > snapSq then
                                    e.x, e.y = tx, ty
                                else
                                    e.x = e.x + dx * alpha
                                    e.y = e.y + dy * alpha
                                end
                                e.w = e.w + (w   - e.w) * alpha
                                e.h = e.h + (hgt - e.h) * alpha
                            end

                            local maxhp = t.maxhp
                            if type(maxhp) ~= 'number' or maxhp <= 0 then maxhp = 20 end
                            local frac = hp / maxhp
                            if frac < 0 then frac = 0 end
                            if frac > 1 then frac = 1 end

                            local barH  = 4
                            local barY  = e.y - 10
                            local leftX = e.x - e.w * 0.5

                            e.bg.Position = Vector2.new(leftX, barY)
                            e.bg.Size     = Vector2.new(e.w, barH)
                            e.bg.Visible  = true

                            local fillW = e.w * frac
                            e.fill.Position = Vector2.new(leftX, barY)
                            e.fill.Size     = Vector2.new(fillW, barH)
                            e.fill.Color    = Color3.fromRGB(math.floor(255 * (1 - frac)) + 20, math.floor(200 * frac) + 30, 60)
                            e.fill.Visible  = fillW > 0.5

                            local txt = math.floor(hp) .. '/' .. math.floor(maxhp)
                            if e.lastText ~= txt then
                                e.label.Text = txt
                                e.lastText   = txt
                            end
                            e.label.Position = Vector2.new(e.x, barY - 16)
                            e.label.Visible  = true

                            e.used = true
                        end
                    end
                end
            end
        end
    end

    for i = 1, #pool do
        local e = pool[i]
        if not e.used then
            e.bg.Visible    = false
            e.fill.Visible  = false
            e.label.Visible = false
            if e.key and (now - e.lastSeen) > FORGET_AFTER then
                if entryKey[e.key] == e then entryKey[e.key] = nil end
                e.key = nil
                e.x, e.y, e.w, e.h = nil, nil, nil, nil
            end
        end
        e.used = false
    end
end))

-- stop ----------------------------------------------------------------

local function stop()
    running = false
    cfg.aura = false
    cfg.bars = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    for i = 1, #drawings do
        pcall(function() drawings[i]:Remove() end)
    end
    drawings = {}
    pool     = {}
    entryKey = {}
    if HAS_UI then
        pcall(function() UI.RemoveTab('Kill Aura') end)
    end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI) .. ' - open the Kill Aura tab')
