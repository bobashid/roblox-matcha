        poll()
        if CONFIG.Enabled then
            if not busy then
                busy = true
                local ok, err = pcall(actionCycle)
                if not ok then stat.lastErr = tostring(err) end
                busy = false
            end
            task.wait(CONFIG.ActionEvery)
        else
            task.wait(0.25)
        end
    end
end)

task.spawn(function()
    while running do
        if CONFIG.Pickup and CONFIG.Enabled then
            local ok, err = pcall(pickupPass)
            if not ok then stat.lastErr = tostring(err) end
            task.wait(CONFIG.PickupEvery)
        else
            task.wait(0.3)
        end
    end
end)

