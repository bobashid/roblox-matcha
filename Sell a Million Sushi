-- ======================= readers =======================

function getHrp()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local r
    pcall(function() r = c:FindFirstChild('HumanoidRootPart') end)
    return r
end

function getHum()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local h
    pcall(function() h = c:FindFirstChildOfClass('Humanoid') end)
    return h
end

function numAttr(n)
    local v
    pcall(function() v = lp:GetAttribute(n) end)
    if type(v) == 'number' then return v end
    return nil
end

-- "$2.6M" -> 2600000.  Handles $, commas, K/M/B/T.
function parseMoney(s)
    if type(s) == 'number' then return s end
    if type(s) ~= 'string' then return nil end
    local clean = string.gsub(s, ',', '')
    local num, suf = string.match(clean, '([%d%.]+)%s*([KkMmBbTt]?)')
    if not num then return nil end
    local n = tonumber(num)
    if not n then return nil end
    suf = (suf or ''):upper()
    if suf == 'K' then return n * 1e3 end
    if suf == 'M' then return n * 1e6 end
    if suf == 'B' then return n * 1e9 end
    if suf == 'T' then return n * 1e12 end
    return n
end

function moneyOf()
    local raw
    pcall(function() raw = lp:GetAttribute('NetWorth') end)
    return parseMoney(raw), raw
end

function myPlot()
    local n
    pcall(function() n = lp:GetAttribute('assignedPlot') end)
    if type(n) ~= 'string' or n == '' then return nil end
    local plots = workspace:FindFirstChild('Plots')
    if plots then
        local p = plots:FindFirstChild(n)
        if p then return p end
    end
    return workspace:FindFirstChild(n)
end

-- MarketBoard lives at Plot.Restaurant.Interior.KitchenBoard.MarketBoard
function marketValue()
    local plot = myPlot()
    if not plot then return nil end
    local board
    local rest = plot:FindFirstChild('Restaurant')
    local interior = rest and rest:FindFirstChild('Interior')
    local kb = interior and interior:FindFirstChild('KitchenBoard')
    if kb then board = kb:FindFirstChild('MarketBoard') end
    if not board then
        local ok, desc = pcall(function() return plot:GetDescendants() end)
        if ok and desc then
            for i = 1, #desc do
                if desc[i].Name == 'MarketBoard' then board = desc[i]; break end
            end
        end
    end
    if not board then return nil end
    local ok2, kids = pcall(function() return board:GetDescendants() end)
    if not ok2 or not kids then return nil end
    for i = 1, #kids do
        local d = kids[i]
        if d.Name == 'Price' then
            local t
            pcall(function() t = d.Text end)
            if type(t) == 'string' then
                local m = string.match(t, '(%d+%.?%d*)%s*[xX]')
                if m then return tonumber(m) end
            end
        end
    end
    return nil
end

-- Price printed on a button's BillboardGui, if it has one.
local function priceOf(model)
    if not model then return nil end
    local bb = model:FindFirstChildOfClass('BillboardGui')
    if not bb then return nil end
    local ok, desc = pcall(function() return bb:GetDescendants() end)
    if not ok or not desc then return nil end
    for i = 1, #desc do
        local d = desc[i]
        local t
        pcall(function() t = d.Text end)
        if type(t) == 'string' then
            local num, suf = string.match(t, '%$([%d%.]+)%s*([KkMmBbTt]?)')
            if num then return parseMoney(num .. (suf or '')) end
        end
    end
    return nil
end

-- ======================= buttons =======================

local function buttonPart(model)
    if not model or not model.Parent then return nil end
    local p = model:FindFirstChild('Button')
    if p and p:IsA('BasePart') then return p end
    return nil
end

local function plotChild(plot, folderName, childName)
    local f = plot and plot:FindFirstChild(folderName)
    if not f then return nil end
    return f:FindFirstChild(childName)
end

-- Affordable = price readable and <= money, OR price unreadable (attempt anyway).
-- The v2.3.0 lesson: an unreadable number must never silently block an action.
local function affordable(model)
    local price = priceOf(model)
    local cash = moneyOf()
    if price == nil or cash == nil then return true, nil end
    return (cash >= price), price
end

local function standOn(part, label)
    if not part then return false end
    local hrp = getHrp()
    if not hrp then return false end
    if not savedCF then pcall(function() savedCF = hrp.CFrame end) end
    if CONFIG.Teleport then
        local p
        pcall(function() p = part.Position end)
        if typeof(p) == 'Vector3' then
            pcall(function() hrp.CFrame = CFrame.new(p.X, p.Y + 3, p.Z) end)
            task.wait(CONFIG.StandTime)
        end
    end
    if CONFIG.UseTouch and type(firetouchinterest) == 'function' then
        pcall(firetouchinterest, hrp, part, 0)
        task.wait(0.04)
        pcall(firetouchinterest, hrp, part, 1)
    end
    task.wait(0.10)
    if savedCF then pcall(function() hrp.CFrame = savedCF end) end
    stat.actions = stat.actions + 1
    stat.lastAction = label
    return true
end

-- ======================= priority queue =======================
-- Order the user asked for: chef upgrade first, then collect, then merge, then hire.
-- Deposit is last and only when the market is at/above MinMarket.

local function collectTargets(plot)
    local out = {}
    local a = plotChild(plot, 'Sell', 'CollectButton')
    if a then out[#out + 1] = a end
    local g = plot and plot:FindFirstChild('GroupReward')
    local b = g and g:FindFirstChild('CollectButton')
    if b then out[#out + 1] = b end
    return out
end

-- Highest affordable hire button: 100 > 25 > 5 > 1.
local function bestHire(plot)
    local names = { 'ButtonBuy100', 'ButtonBuy25', 'ButtonBuy5', 'ButtonBuy1' }
    for i = 1, #names do
        local m = plotChild(plot, 'Buttons', names[i])
        if m and buttonPart(m) then
            local ok = affordable(m)
            if ok then return m, names[i] end
        end
    end
    return nil
end

-- Returns model, label, statKey
local function nextAction()
    local plot = myPlot()
    if not plot then return nil end
    local cash = moneyOf()

    if CONFIG.AutoChef then
        local m = plotChild(plot, 'Sell', 'UpgradeButton')
        if m and buttonPart(m) and affordable(m) then
            return m, 'ChefUpgrade', 'chef'
        end
    end

    if CONFIG.AutoCollect then
        local list = collectTargets(plot)
        for i = 1, #list do
            if buttonPart(list[i]) then
                return list[i], 'Collect' .. i, 'collect'
            end
        end
    end

    if CONFIG.AutoMerge then
        local m = plotChild(plot, 'Buttons', 'ButtonMerge')
        if m and buttonPart(m) and affordable(m) then
            return m, 'Merge', 'merge'
        end
    end

    if CONFIG.AutoHire then
        local m, nm = bestHire(plot)
        if m then return m, nm, 'hire' end
    end

    if CONFIG.AutoDeposit then
        local mv = marketValue()
        -- unreadable market => do not deposit, because the whole point is the threshold
        if mv and mv >= CONFIG.MinMarket then
            local m = plotChild(plot, 'Sell', 'DepositButton')
            if m and buttonPart(m) then
                return m, 'Deposit@' .. string.format('%.2f', mv) .. 'x', 'deposit'
            end
        end
    end

    return nil
end

local function actionCycle()
    local done = 0
    local guard = 0
    while running and CONFIG.Enabled and guard < 8 do
        guard = guard + 1
        local model, label, key = nextAction()
        if not model then break end
        local part = buttonPart(model)
        if not part then break end
        if standOn(part, label) then
            stat[key] = (stat[key] or 0) + 1
            done = done + 1
        end
        if CONFIG.OneAtATime then break end
        task.wait(0.06)
    end
    if done == 0 then stat.skipped = stat.skipped + 1 end
    return done
end

-- ======================= pickup =======================

local function lootFolders()
    local all = {}
    local plots = workspace:FindFirstChild('Plots')
    if plots then
        local i = 1
        local kids = plots:GetChildren()
        for i = 1, #kids do
            local f = kids[i]:FindFirstChild('LootSpawned')
            if f then all[#all + 1] = f end
        end
    end
    if not CONFIG.OwnPlotOnly then return all end
    local mine, keep = myPlot(), {}
    for i = 1, #all do
        if all[i].Parent == mine then keep[#keep + 1] = all[i] end
    end
    return keep
end

-- Name first, attribute second. The LootTier attribute does not exist in this game.
local function tierOf(inst)
    if not inst then return nil end
    local t
    pcall(function() t = inst:GetAttribute('LootTier') end)
    if type(t) == 'number' then return t end
    local m
    pcall(function() m = string.match(inst.Name, '^Loot(%d+)$') end)
    if m then return tonumber(m) end
    return nil
end

local function lootList()
    local out = {}
    local folders = lootFolders()
    for f = 1, #folders do
        local kids = folders[f]:GetChildren()
        for i = 1, #kids do
            local c = kids[i]
            local part, tier = c, tierOf(c)
            if not tier and c.ClassName == 'Model' then
                local ok, desc = pcall(function() return c:GetDescendants() end)
                if ok and desc then
                    for j = 1, #desc do
                        local t2 = tierOf(desc[j])
                        if t2 then tier = t2; part = desc[j]; break end
                    end
                end
            end
            if tier and part and part.Parent then
                out[#out + 1] = { part = part, tier = tier }
            end
        end
    end
    return out
end

local function fireLoot(tiers)
    local re = RS:FindFirstChild('RemoteEvents')
    if not re then return false, 'RemoteEvents missing' end
    local r = re:FindFirstChild('LootPickup')
    if not r then return false, 'LootPickup missing' end
    return (pcall(function() r:FireServer(tiers, false) end))
end

local function pickupPass()
    local list = lootList()
    if #list == 0 then return 0 end
    local tiers = {}
    local limit = math.min(#list, CONFIG.PerPass)
    for i = 1, limit do
        local e = list[i]
        if e.part and e.part.Parent then tiers[#tiers + 1] = e.tier end
    end
    if #tiers == 0 then return 0 end
    local before = numAttr('CurrentCount')
    local ok, err = fireLoot(tiers)
    if ok then
        stat.pickupSent = stat.pickupSent + #tiers
    else
        stat.lastErr = tostring(err)
    end
    task.wait(0.18)
    local after = numAttr('CurrentCount')
    if type(before) == 'number' and type(after) == 'number' and after > before then
        stat.pickupLanded = stat.pickupLanded + 1
    end
    stat.pickupPasses = stat.pickupPasses + 1
    return #tiers
end

-- ======================= report =======================

local function report()
    local mv = marketValue()
    local cash, raw = moneyOf()
    local cc = numAttr('CurrentCount')
    stat.market, stat.money, stat.count = mv, cash, cc

    note('--- REPORT v' .. VERSION .. ' ---')
    note('plot=' .. tostring(myPlot() and myPlot().Name or 'NIL'))
    note('market=' .. tostring(mv) .. 'x (raw Price label)  minMarket=' .. CONFIG.MinMarket .. 'x')
    note('money=' .. tostring(raw) .. ' -> parsed ' .. tostring(cash) ..
         '  fish=' .. tostring(cc))

    local plot = myPlot()
    local names = { 'ButtonBuy1', 'ButtonBuy5', 'ButtonBuy25', 'ButtonBuy100', 'ButtonMerge' }
    for i = 1, #names do
        local m = plotChild(plot, 'Buttons', names[i])
        if m then
            local pr = priceOf(m)
            local bp = buttonPart(m)
            note('  ' .. names[i] .. ' price=' .. tostring(pr) ..
                 ' buttonPart=' .. tostring(bp ~= nil))
        else
            note('  ' .. names[i] .. ' MISSING')
        end
    end
    local up = plotChild(plot, 'Sell', 'UpgradeButton')
    note('  UpgradeButton=' .. tostring(up ~= nil) .. ' price=' ..
         tostring(priceOf(up)))

    note('pickup: passes=' .. stat.pickupPasses .. ' tiersSent=' .. stat.pickupSent ..
         ' landedPasses=' .. stat.pickupLanded)
    note('actions=' .. stat.actions .. ' chef=' .. stat.chef .. ' collect=' .. stat.collect ..
         ' merge=' .. stat.merge .. ' hire=' .. stat.hire .. ' deposit=' .. stat.deposit)
    note('skippedCycles=' .. stat.skipped .. ' lastAction=' .. tostring(stat.lastAction) ..
         ' lastErr=' .. tostring(stat.lastErr))

    if stat.actions == 0 then
        note('VERDICT: no button was pressed yet. If prices read as nil that is fine -')
        note('         an unreadable price counts as affordable and still attempts.')
    else
        note('VERDICT: pressed ' .. stat.actions .. ' buttons. Compare fish/money above')
        note('         against the last report to see if they took effect.')
    end
    if mv == nil then
        note('NOTE: market value unreadable - deposit is skipped by design (threshold).')
    end
    note('--- end ---')
end

