-- Sell a Million Sushi (place 125866884667103) - Matcha LuauVM
-- Version: 2.8.0 -- three toggles in one section, one slider. Nothing else.
--
-- v2.8.0 changes ONLY the deposit slider range: 1.0 .. 1.5 (was 1.0 .. 2.0),
-- still snapped to 0.1 steps. Behaviour is identical to v2.7.0.
--
-- Menu:
--   * Auto Fish Pickup   -> toggle
--   * Auto Deposit Fish  -> toggle  +  Deposit At (x) slider (1.0 .. 1.5)
--   * Fish Value Overlay -> toggle
-- Turning all three off leaves the script loaded but idle; re-run the Hub to unload.
--
-- CONFIRMED (probed 2026-11-02):
--   Market value is readable text on Plot.Restaurant.Interior.KitchenBoard.MarketBoard:
--       Price = "Fish Value: 1.4x"   -> parse (%d+%.?%d*)x
--       Next  = "Updating in 9s"
--   Deposit target: Workspace.Plots.<plot>.Sell.DepositButton.Button
--   CurrentCount = LocalPlayer:GetAttribute("CurrentCount") (number)
--   NetWorth     = LocalPlayer:GetAttribute("NetWorth") (STRING like "$2.6M")
--   Drawing.new supports Text/Square/Line/Circle/Quad/Triangle/Image
--
-- UNVERIFIED: firetouchinterest on DepositButton has never been confirmed to work
--   here. The deposit therefore measures CurrentCount before and after instead of
--   assuming it worked; the result is printed to the console, not to a menu.

local NAME    = 'SellAMillionSushi'
local VERSION = '2.8.0'
print('[Sell a Million Sushi] v' .. VERSION)

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end

local Players    = game:GetService('Players')
local RS         = game:GetService('ReplicatedStorage')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local CONFIG = {
    -- pickup
    Enabled     = false,
    PerPass     = 8,
    BatchSize   = 8,
    PassCooldown = 0.22,
    OwnPlotOnly = true,
    TryWalk     = false,
    WalkEvery   = 6,

    -- overlay
    ShowMarket  = true,
    OverlayX    = 24,
    OverlayY    = 120,
    OverlaySize = 22,

    -- deposit
    AutoDeposit  = true,
    DepositAt    = 1.5,    -- slider: 1.0 .. 1.5 in 0.1 steps
    DepositStand = 0.18,
    DepositGap   = 3.0,
    VerifyWait   = 0.45,
}

local SLIDER_MIN, SLIDER_MAX = 1.0, 1.5

local running  = true
local busy     = false
local depositArmed = true
local lastDepositT = 0

local stat = {
    passes=0, landed=0, missed=0, tiersSent=0, walks=0,
    lastDelta=0, lastErr='none', lastLanded='none',
    totalCount=0, nearestDist=-1,
    startCount=nil, lastCount=nil,
    deposits=0, lastDeposit='none', market=nil,
}

local getHrp, getHum, myPlot, readMarket, overlayLbl, overlaySub

local function note(s) print('[SMS] ' .. s) end

local function stop()
    running = false
    local hum = getHum and getHum()
    if hum then
        local c = hum.Parent
        local hrp = c and c:FindFirstChild('HumanoidRootPart')
        if hrp then pcall(function() hum:MoveTo(hrp.Position) end) end
    end
    if overlayLbl then pcall(function() overlayLbl:Remove() end) end
    if overlaySub then pcall(function() overlaySub:Remove() end) end
    _G[NAME] = nil
    print('[Sell a Million Sushi] stopped')
end
_G[NAME] = { stop = stop, version = VERSION }

-- ---------------- readers ----------------
local function numAttr(n)
    local v
    pcall(function() v = lp:GetAttribute(n) end)
    if type(v) == 'number' then return v end
    return nil
end

function getHrp()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local r
    pcall(function() r = c:FindFirstChild('HumanoidRootPart') end)
    return r
end

function getHum()
    local c
    pcall(function() c = lp.Character end)
    if not c then return nil end
    local h
    pcall(function() h = c:FindFirstChildOfClass('Humanoid') end)
    return h
end

local function origin()
    local hrp = getHrp()
    if not hrp then return nil end
    local p
    pcall(function() p = hrp.Position end)
    if typeof(p) ~= 'Vector3' then return nil end
    if p.X == 0 and p.Y == 0 and p.Z == 0 then return nil end
    return p
end

function myPlot()
    local n
    pcall(function() n = lp:GetAttribute('assignedPlot') end)
    if type(n) ~= 'string' or n == '' then return nil end
    local plots = workspace:FindFirstChild('Plots')
    if plots then
        local p = plots:FindFirstChild(n)
        if p then return p end
    end
    return workspace:FindFirstChild(n)
end

local function lootFolders()
    local all = {}
    local plots = workspace:FindFirstChild('Plots')
    if plots then
        for _, p in ipairs(plots:GetChildren()) do
            local f = p:FindFirstChild('LootSpawned')
            if f then all[#all + 1] = f end
        end
    end
    if not CONFIG.OwnPlotOnly then return all end
    local mine, keep = myPlot(), {}
    for _, f in ipairs(all) do
        if f.Parent == mine then keep[#keep + 1] = f end
    end
    return keep
end

local function tierOf(inst)
    if not inst then return nil end
    local t
    pcall(function() t = inst:GetAttribute('LootTier') end)
    if type(t) == 'number' then return t end
    local m
    pcall(function() m = string.match(inst.Name, '^Loot(%d+)$') end)
    if m then return tonumber(m) end
    return nil
end

local function posOf(inst)
    if not inst then return nil end
    local p
    pcall(function() p = inst.Position end)
    if typeof(p) == 'Vector3' then return p end
    pcall(function() p = inst.PrimaryPart and inst.PrimaryPart.Position end)
    if typeof(p) == 'Vector3' then return p end
    return nil
end

local function lootList()
    local out = {}
    local org = origin()
    for _, ff in ipairs(lootFolders()) do
        for _, c in ipairs(ff:GetChildren()) do
            local part, tier = c, tierOf(c)
            if not tier and c.ClassName == 'Model' then
                local ok, desc = pcall(function() return c:GetDescendants() end)
                if ok and desc then
                    for j = 1, #desc do
                        local t2 = tierOf(desc[j])
                        if t2 then tier = t2; part = desc[j]; break end
                    end
                end
            end
            if tier and part and part.Parent then
                local p = posOf(part)
                local d = -1
                if org and p then d = (p - org).Magnitude end
                out[#out + 1] = { part = part, tier = tier, dist = d, pos = p }
            end
        end
    end
    if org then
        table.sort(out, function(a, b)
            if a.dist < 0 then return false end
            if b.dist < 0 then return true end
            return a.dist < b.dist
        end)
    end
    return out
end

-- ---------------- market reader ----------------
function readMarket()
    local plot = myPlot()
    if not plot then return nil, nil end
    local board
    local rest = plot:FindFirstChild('Restaurant')
    local interior = rest and rest:FindFirstChild('Interior')
    local kb = interior and interior:FindFirstChild('KitchenBoard')
    if kb then board = kb:FindFirstChild('MarketBoard') end
    if not board then return nil, nil end

    local mult, nextTxt
    local ok, desc = pcall(function() return board:GetDescendants() end)
    if not ok or not desc then return nil, nil end
    for i = 1, #desc do
        local d = desc[i]
        if d.Name == 'Price' then
            local t
            pcall(function() t = d.Text end)
            if type(t) == 'string' then
                local m = string.match(t, '(%d+%.?%d*)%s*[xX]')
                if m then mult = tonumber(m) end
            end
        elseif d.Name == 'Next' then
            local t
            pcall(function() t = d.Text end)
            if type(t) == 'string' and #t > 0 then nextTxt = t end
        end
    end
    return mult, nextTxt
end

-- ---------------- overlay ----------------
if Drawing then
    pcall(function()
        overlayLbl = Drawing.new('Text')
        overlayLbl.Size = CONFIG.OverlaySize
        overlayLbl.Center = false
        overlayLbl.Outline = true
        overlayLbl.Visible = false
        overlayLbl.Color = Color3.fromRGB(255, 225, 90)
        overlayLbl.Position = Vector2.new(CONFIG.OverlayX, CONFIG.OverlayY)

        overlaySub = Drawing.new('Text')
        overlaySub.Size = CONFIG.OverlaySize - 8
        overlaySub.Center = false
        overlaySub.Outline = true
        overlaySub.Visible = false
        overlaySub.Color = Color3.fromRGB(190, 190, 190)
        overlaySub.Position = Vector2.new(CONFIG.OverlayX, CONFIG.OverlayY + CONFIG.OverlaySize + 4)
    end)
end

local function overlayColor(mult)
    if mult >= CONFIG.DepositAt then
        return Color3.fromRGB(120, 255, 140)
    elseif mult >= 1.0 then
        return Color3.fromRGB(255, 225, 90)
    else
        return Color3.fromRGB(255, 130, 110)
    end
end

local function renderOverlay()
    if not overlayLbl then return end
    if not CONFIG.ShowMarket then
        overlayLbl.Visible = false
        if overlaySub then overlaySub.Visible = false end
        return
    end
    local mult, nextTxt = readMarket()
    stat.market = mult
    if mult then
        overlayLbl.Visible = true
        local tag = ''
        if CONFIG.AutoDeposit then
            tag = depositArmed and '  [DEPOSIT READY]' or '  [latched]'
        end
        overlayLbl.Text = string.format('Fish Value: %.2fx  (dep at %.1fx)%s',
            mult, CONFIG.DepositAt, tag)
        overlayLbl.Color = overlayColor(mult)
        if overlaySub then
            overlaySub.Visible = (nextTxt ~= nil)
            if nextTxt then overlaySub.Text = nextTxt end
        end
    else
        overlayLbl.Visible = true
        overlayLbl.Text = 'Fish Value: ?'
        overlayLbl.Color = Color3.fromRGB(170, 170, 170)
        if overlaySub then overlaySub.Visible = false end
    end
end

task.spawn(function()
    local acc = 0
    pcall(function()
        RunService.RenderStepped:Connect(function(dt)
            if not running then return end
            acc = acc + dt
            if acc < 0.15 then return end
            acc = 0
            pcall(renderOverlay)
        end)
    end)
end)

-- ---------------- pickup ----------------
local function fireLoot(tiers)
    local re = RS:FindFirstChild('RemoteEvents')
    if not re then return false, 'RemoteEvents missing' end
    local r = re:FindFirstChild('LootPickup')
    if not r then return false, 'LootPickup missing' end
    local ok, err = pcall(function() r:FireServer(tiers, false) end)
    return ok, err
end

local function buildBatch(list, limit)
    local tiers = {}
    for i = 1, math.min(#list, limit) do
        local e = list[i]
        if e.part and e.part.Parent then
            tiers[#tiers + 1] = e.tier
        end
    end
    return tiers
end

local function tryWalk(targetPos)
    local hum = getHum()
    if not hum or not targetPos then return end
    stat.walks = stat.walks + 1
    if type(hum.MoveTo) == 'function' then
        pcall(function() hum:MoveTo(targetPos) end)
    else
        pcall(function() hum.WalkToPoint = targetPos end)
    end
end

local function pass()
    if busy then return end
    busy = true
    local before = numAttr('CurrentCount')
    local ok, err = pcall(function()
        local list = lootList()
        stat.totalCount = #list
        stat.nearestDist = (#list > 0) and list[1].dist or -1
        if #list == 0 then return end
        if CONFIG.TryWalk and stat.passes % CONFIG.WalkEvery == 0 then
            tryWalk(list[1].pos)
        end
        local tiers = buildBatch(list, CONFIG.PerPass)
        if #tiers == 0 then return end
        local sent, serr = fireLoot(tiers)
        if sent then
            stat.tiersSent = stat.tiersSent + #tiers
            stat.lastErr = 'none'
        else
            stat.lastErr = tostring(serr)
        end
    end)
    if not ok then stat.lastErr = tostring(err) end

    task.wait(0.25)
    local after = numAttr('CurrentCount')
    if type(before) == 'number' and type(after) == 'number' then
        local d = after - before
        stat.lastDelta = d
        stat.lastCount = after
        if d > 0 then
            stat.landed = stat.landed + 1
            stat.lastLanded = '+' .. d
        else
            stat.missed = stat.missed + 1
        end
    end
    stat.passes = stat.passes + 1
    busy = false
end

-- ---------------- deposit ----------------
local function depositPart()
    local plot = myPlot()
    if not plot then return nil end
    local sell = plot:FindFirstChild('Sell')
    local model = sell and sell:FindFirstChild('DepositButton')
    if not model then return nil end
    local part = model:FindFirstChild('Button')
    if part and part:IsA('BasePart') then return part end
    return nil
end

local function depositOnce()
    local part = depositPart()
    if not part then return false, 'DepositButton.Button missing' end
    local hrp = getHrp()
    if not hrp then return false, 'no HumanoidRootPart' end
    local saved
    pcall(function() saved = hrp.CFrame end)
    local p
    pcall(function() p = part.Position end)
    if typeof(p) ~= 'Vector3' then return false, 'no button position' end

    pcall(function() hrp.CFrame = CFrame.new(p.X, p.Y + 3, p.Z) end)
    task.wait(CONFIG.DepositStand)

    if type(firetouchinterest) == 'function' then
        pcall(firetouchinterest, hrp, part, 0)
        task.wait(0.05)
        pcall(firetouchinterest, hrp, part, 1)
    end
    task.wait(0.12)

    if saved then pcall(function() hrp.CFrame = saved end) end
    return true, 'touched'
end

local function tryDeposit(mult)
    local t = os.clock()
    if (t - lastDepositT) < CONFIG.DepositGap then return end
    lastDepositT = t

    local before = numAttr('CurrentCount')
    local ok, detail = depositOnce()
    if not ok then
        stat.lastDeposit = 'FAILED: ' .. tostring(detail)
        note('deposit attempt failed: ' .. tostring(detail))
        return
    end

    task.wait(CONFIG.VerifyWait)
    local after = numAttr('CurrentCount')
    if type(before) == 'number' and type(after) == 'number' then
        if after < before then
            stat.deposits = stat.deposits + 1
            stat.lastDeposit = 'took ' .. (before - after) ..
                ' fish @ ' .. string.format('%.2f', mult or 0) .. 'x'
            note('deposited: ' .. stat.lastDeposit)
        else
            stat.lastDeposit = 'no change (button may need real contact)'
            note('deposit: no change in CurrentCount')
        end
    else
        stat.lastDeposit = 'unreadable CurrentCount'
    end
end

-- Own loop. Latches after one attempt; re-arms only when the value falls BELOW the
-- threshold, which is exactly "once when it hits".
task.spawn(function()
    while running do
        if CONFIG.AutoDeposit then
            local mult = readMarket()
            stat.market = mult
            if mult then
                if mult >= CONFIG.DepositAt then
                    if depositArmed then
                        depositArmed = false
                        tryDeposit(mult)
                    end
                else
                    if not depositArmed then
                        depositArmed = true
                        note('re-armed at ' .. string.format('%.2f', mult) .. 'x')
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

-- ---------------- menu: three toggles, one slider ----------------
local function safeToggle(sec, id, label, default, cb)
    if pcall(function() sec:Toggle(id, label, default, cb) end) then return true end
    if pcall(function() sec:Toggle(label, id, default, cb) end) then return true end
    if pcall(function() sec:Toggle(label, default, cb) end) then return true end
    return false
end

local function clampRound(v)
    local n = tonumber(v)
    if not n then return nil end
    n = math.floor(n * 10 + 0.5) / 10
    if n < SLIDER_MIN then n = SLIDER_MIN end
    if n > SLIDER_MAX then n = SLIDER_MAX end
    return n
end

local function safeSlider(sec, id, label, min, max, default, cb)
    if pcall(function() sec:Slider(id, label, min, max, default, cb) end) then return true end
    if pcall(function() sec:Slider(label, min, max, default, cb) end) then return true end
    if pcall(function() sec:Slider(id, label, default, min, max, cb) end) then return true end
    return false
end

local function arm()
    stat.startCount = numAttr('CurrentCount')
    stat.landed, stat.missed, stat.passes = 0, 0, 0
    stat.tiersSent, stat.walks, stat.lastDelta = 0, 0, 0
    stat.lastLanded, stat.lastErr = 'none', 'none'
    stat.deposits, stat.lastDeposit = 0, 'none'
    depositArmed = true
end

if UI then
    pcall(function()
        UI.AddTab('Sell a Million Sushi', function(tab)
            local main = tab:Section('Auto', 'Left')
            safeToggle(main, 'sms_on', 'Auto Fish Pickup', CONFIG.Enabled, function(v)
                CONFIG.Enabled = v
                if v then arm() end
            end)
            safeToggle(main, 'sms_dep', 'Auto Deposit Fish', CONFIG.AutoDeposit,
                function(v) CONFIG.AutoDeposit = v end)
            safeSlider(main, 'sms_dep_at', 'Deposit At (x)', SLIDER_MIN, SLIDER_MAX,
                CONFIG.DepositAt, function(v)
                    local n = clampRound(v)
                    if n then CONFIG.DepositAt = n end
                end)
            safeToggle(main, 'sms_market', 'Fish Value Overlay', CONFIG.ShowMarket,
                function(v) CONFIG.ShowMarket = v end)
        end)
    end)
end

local function poll()
    local function getv(id, name)
        local ok, v = pcall(function() return UI.GetValue(id) end)
        if not ok or type(v) ~= 'boolean' then
            ok, v = pcall(function() return UI.GetValue(name) end)
        end
        if ok and type(v) == 'boolean' then return v end
        return nil
    end
    local o = getv('sms_on', 'Auto Fish Pickup')
    if o ~= nil and o ~= CONFIG.Enabled then
        CONFIG.Enabled = o
        if o then arm() end
    end
    local d = getv('sms_dep', 'Auto Deposit Fish')
    if d ~= nil then CONFIG.AutoDeposit = d end
    local m = getv('sms_market', 'Fish Value Overlay')
    if m ~= nil then CONFIG.ShowMarket = m end

    local okn, v = pcall(function() return UI.GetValue('sms_dep_at') end)
    if not okn or type(v) ~= 'number' then
        local okn2, v2 = pcall(function() return UI.GetValue('Deposit At (x)') end)
        if okn2 then v = v2 end
    end
    if type(v) == 'number' then
        local n = clampRound(v)
        if n and n ~= CONFIG.DepositAt then CONFIG.DepositAt = n end
    end
end

task.spawn(function()
    while running do
        poll()
        if CONFIG.Enabled then
            pass()
            task.wait(CONFIG.PassCooldown)
        else
            task.wait(0.25)
        end
    end
end)

arm()
local m0, n0 = readMarket()
note('loaded. plot=' .. tostring(myPlot() and myPlot().Name or 'NIL') ..
     '  loot=' .. #lootList() .. '  count=' .. tostring(stat.startCount))
note('market=' .. tostring(m0) .. 'x  next=' .. tostring(n0) ..
     '  depositAt=' .. string.format('%.1f', CONFIG.DepositAt) .. 'x' ..
     '  depositPart=' .. tostring(depositPart() ~= nil))
print('[Sell a Million Sushi] running. Turn the three toggles off to idle it.')
