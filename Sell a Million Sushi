local function poll()
    local function getv(id, name)
        local ok, v = pcall(function() return UI.GetValue(id) end)
        if not ok or type(v) ~= 'boolean' then
            ok, v = pcall(function() return UI.GetValue(name) end)
        end
        if ok and type(v) == 'boolean' then return v end
        return nil
    end
    local map = {
        { 'sms_on',      'Auto Everything',        'Enabled' },
        { 'sms_one',     'One Action At A Time',   'OneAtATime' },
        { 'sms_chef',    'Auto Upgrade Chef (priority)', 'AutoChef' },
        { 'sms_collect', 'Auto Collect Money',     'AutoCollect' },
        { 'sms_merge',   'Auto Merge',             'AutoMerge' },
        { 'sms_hire',    'Auto Hire Fishermen',    'AutoHire' },
        { 'sms_dep',     'Auto Deposit Fish',      'AutoDeposit' },
        { 'sms_pick',    'Auto Fish Pickup',       'Pickup' },
    }
    for i = 1, #map do
        local row = map[i]
        local v = getv(row[1], row[2])
        if v ~= nil then
            local was = CONFIG[row[3]]
            CONFIG[row[3]] = v
            if row[3] == 'Enabled' and v and not was then arm() end
        end
    end
end

