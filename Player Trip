--[[
  Player Trip (universal) - Matcha LuauVM
  Version: v2.0
  Rebindable key fires the trip. Tap Space to recover early.

  WHY v2.0 - "yours didnt feel good", "it should ragdoll me"
  v1.x rotated the HumanoidRootPart only. In this VM that is all a root
  rotation does: the welds carry the limbs with it, so the character tilts as
  one rigid board. Stiff, not a tumble.

  PROBED this session, which is what makes v2.0 possible:
    char children: Head, Torso, Left Arm, Right Arm, Left Leg, Right Leg,
                   HumanoidRootPart   (R6)
    Torso holds SIX Motor6D joints: Neck, Left Shoulder, Right Shoulder,
                   Left Hip, Right Hip, RootJoint
    motor.C0  read  -> ok=true, userdata
    motor.C0  WRITE -> ok=true, err=nil, and the value STICKS on read-back
  So the joints are writable here. A ragdoll flop is therefore real: throw
  each limb out by rotating its Motor6D C0, not just the root.

  HOW THE TRIP WORKS NOW
    1. rotate the root so the body pitches face-down along travel (as before)
    2. THROW THE LIMBS: each Motor6D gets a C0 offset with a random flail, so
       arms and legs splay and swing instead of staying in the walk pose
    3. push Velocity along travel and let physics slide you
    4. recover: joints ease back to their captured rest C0, root eases upright
  Joint rest poses are CAPTURED on first trip, not hardcoded, so the character
  returns to exactly its own original pose and a custom rig is not broken.

  STILL TRUE: there is no Humanoid state machine in this VM (ChangeState,
  GetState, SetStateEnabled, GetStateEnabled, PlayEmote, LoadAnimation all
  nil, Enum.HumanoidStateType nil). So the game's own ragdoll ANIMATION cannot
  play - what you get is a joint-driven flop, which is physical, not animated.

  v1.1 FEATURES KEPT
    - REBINDABLE KEY, default G. Click "Rebind key", press the key you want.
      InputBegan gives a Roblox KeyCode here, so it is mapped to a Windows VK
      through the same table the bundled Matcha ImGui uses.
    - SPACE RECOVERS EARLY on a rising edge, instead of waiting out duration.

  THE CONSTANTS TO TUNE
    CFG.speed    = 30   studs/s of slide
    CFG.duration = 0.75 s face-down (longer than v1.x, the flop reads better)
    CFG.settle   = 0.22 s to ease joints and root back
    CFG.flail    = 0.85 rad maximum limb throw
    CFG.keyVK    = 0x47 the trip key (G)

  Cost: one root CFrame write and up to six C0 writes per physics step, only
  while a trip is running. C0 is a joint property, not a part transform, so it
  does not pay the full part-write cost.

  _G.PlayerTrip.trip() / .stop() / .state() / .bind('G') / .flail(0.85)
]]

local NAME    = 'PlayerTrip'
local VERSION = 'v2.0'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local UIS        = game:GetService('UserInputService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local CFG = {
    speed    = 30,
    duration = 0.75,
    settle   = 0.22,
    flail    = 0.85,
    keyVK    = 0x47,
    keyName  = 'G',
    recoverVK = 0x20,
}

-- Roblox KeyCode -> Windows virtual-key code, same mapping the bundled
-- Matcha ImGui uses: InputBegan delivers a KeyCode, iskeypressed wants a VK.
local VK_OF_CODE = {
    [8] = 0x08, [9] = 0x09, [13] = 0x0D, [27] = 0x1B, [32] = 0x20,
    [39] = 0xDE, [44] = 0xBC, [45] = 0xBD, [46] = 0xBE, [47] = 0xBF,
    [59] = 0xBA, [61] = 0xBB, [91] = 0xDB, [92] = 0xDC, [93] = 0xDD, [96] = 0xC0,
    [127] = 0x2E,
    [273] = 0x26, [274] = 0x28, [275] = 0x27, [276] = 0x25,
    [277] = 0x2D, [278] = 0x24, [279] = 0x23, [280] = 0x21, [281] = 0x22,
}
for code = 48, 57 do VK_OF_CODE[code] = code end
for code = 97, 122 do VK_OF_CODE[code] = code - 32 end
for code = 282, 296 do VK_OF_CODE[code] = 0x70 + code - 282 end

local NAME_OF_VK = {}
for code, vk in pairs(VK_OF_CODE) do
    if NAME_OF_VK[vk] == nil then
        if (vk >= 0x41 and vk <= 0x5A) or (vk >= 0x30 and vk <= 0x39) then
            NAME_OF_VK[vk] = string.char(vk)
        elseif vk >= 0x70 and vk <= 0x7B then
            NAME_OF_VK[vk] = 'F' .. tostring(vk - 0x6F)
        end
    end
end
NAME_OF_VK[0x20] = 'Space'
NAME_OF_VK[0x0D] = 'Enter'
NAME_OF_VK[0x09] = 'Tab'
NAME_OF_VK[0x1B] = 'Esc'
NAME_OF_VK[0x08] = 'Backspace'
NAME_OF_VK[0x26] = 'Up'
NAME_OF_VK[0x28] = 'Down'
NAME_OF_VK[0x25] = 'Left'
NAME_OF_VK[0x27] = 'Right'

local state   = 'idle'
local untilAt = 0
local basis   = nil
local travel  = nil
local binding = false
local lastTripKey = false
local lastSpace   = false
local motors  = {}   -- { motor = Motor6D, rest = CFrame, throw = CFrame }
local captured = false

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function rootOf(char)
    if not char then return nil end
    local ok, r = pcall(function()
        return char:FindFirstChild('HumanoidRootPart')
            or char:FindFirstChild('Torso')
            or char:FindFirstChild('UpperTorso')
    end)
    if ok then return r end
    return nil
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

local function makeCFrame(pos, right, up, back)
    return CFrame.new(
        pos.X, pos.Y, pos.Z,
        right.X, up.X, back.X,
        right.Y, up.Y, back.Y,
        right.Z, up.Z, back.Z
    )
end

local function uprightBasis(look)
    local up    = Vector3.new(0, 1, 0)
    local back  = -look
    local right = up:Cross(back)
    if right.Magnitude < 1e-3 then
        right = Vector3.new(1, 0, 0)
    else
        right = right.Unit
    end
    return right, up, back
end

local function flatBasis(dir)
    local up    = dir
    local front = Vector3.new(0, -1, 0)
    local back  = -front
    local right = up:Cross(back)
    if right.Magnitude < 1e-3 then return nil end
    return right.Unit, up, back
end

-- Capture each joint's rest pose once, and roll a throw per joint. Capturing
-- rather than hardcoding means the character returns to exactly its own pose
-- and a custom rig is not broken by the trip.
local function captureJoints(char)
    motors = {}
    local torso = char and (char:FindFirstChild('Torso') or char:FindFirstChild('UpperTorso'))
    if not torso then return 0 end
    local kids = torso:GetChildren()
    for i = 1, #kids do
        local m = kids[i]
        if m.ClassName == 'Motor6D' then
            local ok, c0 = pcall(function() return m.C0 end)
            if ok and c0 and type(c0) == 'userdata' then
                local mag = CFG.flail * (0.5 + math.random())
                local ax  = (math.random() - 0.5) * 2
                local ay  = (math.random() - 0.5) * 2
                local az  = (math.random() - 0.5) * 2
                motors[#motors + 1] = {
                    motor = m,
                    rest  = c0,
                    throw = CFrame.Angles(ax * mag, ay * mag, az * mag),
                }
            end
        end
    end
    captured = true
    return #motors
end

local function setJoints(amount)
    for i = 1, #motors do
        local e = motors[i]
        local target
        if amount <= 0 then
            target = e.rest
        else
            target = e.rest * CFrame.new(0, 0, 0):Lerp(e.throw, amount)
        end
        pcall(function() e.motor.C0 = target end)
    end
end

local function trip()
    if state ~= 'idle' then return false end

    local char = lp.Character
    local root = rootOf(char)
    if not root then log('no character'); return false end

    local okCf, cf = pcall(function() return root.CFrame end)
    if not okCf or not cf then log('no CFrame'); return false end

    if not captured then
        local n = captureJoints(char)
        log('joints captured: ' .. tostring(n))
    end

    local look = cf.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 1e-3 then
        flat = Vector3.new(0, 0, -1)
    else
        flat = flat.Unit
    end

    local r, u, b = flatBasis(flat)
    if not r then log('bad basis'); return false end

    basis  = { right = r, up = u, back = b }
    travel = flat
    state  = 'tripping'
    untilAt = os.clock() + CFG.duration

    setJoints(1)

    pcall(function()
        root.Velocity = flat * CFG.speed + Vector3.new(0, 6, 0)
    end)

    log('trip fired, ' .. string.format('%.0f', CFG.speed) .. ' studs/s')
    return true
end

local function beginSettle(root, now)
    local r, u, b = uprightBasis(travel or Vector3.new(0, 0, -1))
    basis  = { right = r, up = u, back = b }
    state  = 'settling'
    untilAt = now + CFG.settle
    setJoints(0)
    if root then
        pcall(function() root.Velocity = Vector3.new(0, 0, 0) end)
    end
end

local function onInputBegan(e)
    if not binding then return end
    if type(e) ~= 'table' then return end
    local code = e.KeyCode
    if type(code) ~= 'number' then return end
    local vk = VK_OF_CODE[code]
    if not vk then return end
    if vk == CFG.recoverVK then
        log('space is reserved for recover - pick another key')
        return
    end
    CFG.keyVK   = vk
    CFG.keyName = NAME_OF_VK[vk] or ('VK ' .. tostring(vk))
    binding     = false
    log('trip key bound to ' .. CFG.keyName)
end

track(UIS.InputBegan:Connect(function(e)
    pcall(onInputBegan, e)
end))

track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local char = lp.Character
    local root = rootOf(char)
    local now  = os.clock()

    local tripDown = (not binding) and held(CFG.keyVK)
    local tripEdge = tripDown and not lastTripKey
    lastTripKey = tripDown
    if tripEdge and state == 'idle' then
        trip()
    end

    local spaceDown = held(CFG.recoverVK)
    local spaceEdge = spaceDown and not lastSpace
    lastSpace = spaceDown
    if spaceEdge and state == 'tripping' then
        if root then beginSettle(root, now) else state = 'idle' end
        log('recovered early (space)')
        return
    end

    if state == 'idle' then return end

    if not root or not basis then
        state, basis, travel = 'idle', nil, nil
        return
    end

    local okP, p = pcall(function() return root.Position end)
    if not okP or not p then
        state, basis, travel = 'idle', nil, nil
        return
    end

    if state == 'tripping' then
        if now >= untilAt then
            beginSettle(root, now)
        else
            pcall(function()
                root.CFrame = makeCFrame(p, basis.right, basis.up, basis.back)
            end)
        end
    elseif state == 'settling' then
        pcall(function()
            root.CFrame = makeCFrame(p, basis.right, basis.up, basis.back)
        end)
        if now >= untilAt then
            state, basis, travel = 'idle', nil, nil
            log('recovered')
        end
    end
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    local k = binding and 'press a key...' or CFG.keyName
    hud.Text = string.format('[%s] %s | trip key: %s | space = recover | joints %d',
        VERSION, state, k, #motors)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    log('button failed: ' .. label)
    return false
end

local keyText = nil
local function refreshKeyText()
    if not keyText then return end
    local v = binding and 'press a key...' or CFG.keyName
    pcall(function() keyText:SetText('Trip key: ' .. v) end)
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Player Trip', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Trip')
                if not sec then return end

                mkButton(sec, 'Trip', function()
                    if not trip() then log('trip did nothing - see the line above') end
                end)

                mkButton(sec, 'Rebind key', function()
                    binding = true
                    log('press the key you want for the trip')
                    refreshKeyText()
                end)

                mkButton(sec, 'Re-roll flail', function()
                    captured = false
                    local char = lp.Character
                    if char then log('flail re-rolled: ' .. tostring(captureJoints(char)) .. ' joints') end
                end)

                local okT, t = pcall(function() return sec:Text('Trip key: ' .. CFG.keyName) end)
                if okT then keyText = t end
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    state, basis, travel, binding = 'idle', nil, nil, false
    setJoints(0)
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Player Trip') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = {
    stop    = stop,
    trip    = trip,
    version = VERSION,
    state   = function() return state end,
    flail   = function(v)
        if type(v) == 'number' and v > 0 and v < 2 then CFG.flail = v captured = false end
    end,
    bind    = function(name)
        local up = string.upper(tostring(name or ''))
        if #up == 1 then
            local b = string.byte(up)
            if (b >= 65 and b <= 90) or (b >= 48 and b <= 57) then
                CFG.keyVK = b
                CFG.keyName = up
                refreshKeyText()
                return true
            end
        end
        if up == 'SPACE' then
            CFG.keyVK = 0x20
            CFG.keyName = 'Space'
            refreshKeyText()
            return true
        end
        return false
    end,
}
log(VERSION .. ' loaded - trip key ' .. CFG.keyName .. ', space recovers, joint flop enabled')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Player Trip', 3) end)
