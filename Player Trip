--[[
  Player Trip (universal) - Matcha LuauVM
  Version: v2.5.0
  ONE PRESS, ONE FALL, NO GET-UP.

  v2.5.0 - "just one time click to fall no get up" (user picked option 1:
  strict one-shot)

  EVERY recovery path is deleted, not disabled:
    - beginRise()                  gone from the file entirely
    - the 'rising' state           gone
    - the Space edge in Heartbeat  gone (space is not special any more)
    - trip() while down            returns false, does nothing
    - the 'Get up' menu button     gone
  After the topple finishes the script writes NOTHING: state is 'lying', the
  Heartbeat returns immediately every frame, no CFrame, no velocity, no timer.

  THE HONEST CONSEQUENCE, stated before the push and again here: a rotated
  root CFrame PERSISTS across physics steps in this VM (probed 2026-10-30: an
  up vector of (1,0,0) was still (1,0,0) 0.1 s later; the humanoid does not
  snap you upright). So once you are down you stay down until you rejoin.
  _G.PlayerTrip.stop() does NOT stand you up either - stop() only disconnects
  and removes the HUD, it never restores the pose. Rejoining is the exit.
  That is the requested behaviour, not a bug to be fixed later.

  HOW THE FALL WORKS (unchanged from v2.4.0, which fixed the flung feeling)
    root.CFrame = CFrame.new(pivot) * tilt * CFrame.new(-pivot) * baseCF
  The pivot is the root position dropped by CFG.pivotDrop studs, i.e. at the
  feet, so the body tips over the feet like a felled tree instead of spinning
  about a point in mid-air (which is what v2.3.0 and earlier did, and why it
  read as a fling).
    - baseCF is CAPTURED at trip time and rebuilt from every step. Composing a
      fixed-pivot rotation onto the LIVE CFrame would re-apply the rotation
      each frame and compound it.
    - curve t*t*(2-t): slow lean, fast overbalance, slight bleed at the end.
    - NO velocity write anywhere. Gravity does the falling.

  PROBED THIS SESSION (why a true ragdoll is not available here):
    Motor6D.C0 / Part0 / Part1 / Enabled -> nil / Unknown property
    Humanoid.PlatformStand               -> Unknown property
    Humanoid:ChangeState + Enum.HumanoidStateType -> nil
    AssemblyAngularVelocity / AngularVelocity / RotVelocity -> nil
    Instance.new                         -> nil (no BallSocketConstraint)
  Rotation is the only lever.

  THE CONSTANTS TO TUNE
    CFG.ramp      = 0.65 s topple (lower = snappier)
    CFG.pivotDrop = 2.5 studs below the root centre = pivot at the feet
    CFG.roll      = 0.30 max side roll in rad (0 = dead straight forward)
    CFG.flail     = 0.85 rad limb throw, only if joints are readable (usually 0)
    CFG.keyVK     = 0x47 the trip key (G)

  UNVERIFIED: how it LOOKS in game.

  _G.PlayerTrip.trip() / .stop() / .state() / .bind('G')
]]

local NAME    = 'PlayerTrip'
local VERSION = 'v2.5.0'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local UIS        = game:GetService('UserInputService')
local lp         = Players.LocalPlayer

local HALF_PI = math.pi / 2

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local CFG = {
    ramp      = 0.65,
    roll      = 0.30,
    pivotDrop = 2.5,
    flail     = 0.85,
    keyVK     = 0x47,
    keyName   = 'G',
}

-- Roblox KeyCode -> Windows virtual-key code, same mapping the bundled
-- Matcha ImGui uses: InputBegan delivers a KeyCode, iskeypressed wants a VK.
local VK_OF_CODE = {
    [8] = 0x08, [9] = 0x09, [13] = 0x0D, [27] = 0x1B, [32] = 0x20,
    [39] = 0xDE, [44] = 0xBC, [45] = 0xBD, [46] = 0xBE, [47] = 0xBF,
    [59] = 0xBA, [61] = 0xBB, [91] = 0xDB, [92] = 0xDC, [93] = 0xDD, [96] = 0xC0,
    [127] = 0x2E,
    [273] = 0x26, [274] = 0x28, [275] = 0x27, [276] = 0x25,
    [277] = 0x2D, [278] = 0x24, [279] = 0x23, [280] = 0x21, [281] = 0x22,
}
for code = 48, 57 do VK_OF_CODE[code] = code end
for code = 97, 122 do VK_OF_CODE[code] = code - 32 end
for code = 282, 296 do VK_OF_CODE[code] = 0x70 + code - 282 end

local NAME_OF_VK = {}
for code, vk in pairs(VK_OF_CODE) do
    if NAME_OF_VK[vk] == nil then
        if (vk >= 0x41 and vk <= 0x5A) or (vk >= 0x30 and vk <= 0x39) then
            NAME_OF_VK[vk] = string.char(vk)
        elseif vk >= 0x70 and vk <= 0x7B then
            NAME_OF_VK[vk] = 'F' .. tostring(vk - 0x6F)
        end
    end
end
NAME_OF_VK[0x20] = 'Space'
NAME_OF_VK[0x0D] = 'Enter'
NAME_OF_VK[0x09] = 'Tab'
NAME_OF_VK[0x1B] = 'Esc'
NAME_OF_VK[0x08] = 'Backspace'
NAME_OF_VK[0x26] = 'Up'
NAME_OF_VK[0x28] = 'Down'
NAME_OF_VK[0x25] = 'Left'
NAME_OF_VK[0x27] = 'Right'

local state    = 'idle'   -- idle | toppling | lying   (no 'rising' any more)
local phaseAt  = 0
local baseCF   = nil      -- full CFrame captured at trip time
local pivot    = nil      -- world point at the feet
local rollNow  = 0
local binding  = false
local lastTripKey = false
local motors   = {}
local captured = false

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function rootOf(char)
    if not char then return nil end
    local ok, r = pcall(function()
        return char:FindFirstChild('HumanoidRootPart')
            or char:FindFirstChild('Torso')
            or char:FindFirstChild('UpperTorso')
    end)
    if ok then return r end
    return nil
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

-- Rotation about a WORLD POINT, applied to a captured CFrame.
-- T(p) * R * T(-p) * cf  ==  rotation of cf about p.
-- The pivot is the feet, so the body tips over them instead of spinning
-- about its own middle.
local function applyTilt(root, theta)
    if not root or not baseCF or not pivot then return end
    local roll = rollNow * (theta / HALF_PI)
    local tilt = CFrame.Angles(theta, 0, roll)
    local ok = pcall(function()
        root.CFrame = CFrame.new(pivot.X, pivot.Y, pivot.Z)
            * tilt
            * CFrame.new(-pivot.X, -pivot.Y, -pivot.Z)
            * baseCF
    end)
    return ok
end

-- Slow lean, fast overbalance, slight bleed off the last degrees.
local function curve(t)
    if t <= 0 then return 0 end
    if t >= 1 then return 1 end
    return t * t * (2 - t)
end

-- Optional limb flop. C0 reads nil on this build, so the capture simply finds
-- nothing and the flop never runs. It cannot error.
local function captureJoints(char)
    motors = {}
    local torso = char and (char:FindFirstChild('Torso') or char:FindFirstChild('UpperTorso'))
    if not torso then return 0 end
    local ok, kids = pcall(function() return torso:GetChildren() end)
    if not ok or not kids then return 0 end
    for i = 1, #kids do
        local m = kids[i]
        if m.ClassName == 'Motor6D' then
            local okc, c0 = pcall(function() return m.C0 end)
            if okc and c0 and type(c0) == 'userdata' then
                local mag = CFG.flail * (0.5 + math.random())
                motors[#motors + 1] = {
                    motor = m,
                    rest  = c0,
                    ax    = (math.random() - 0.5) * 2 * mag,
                    ay    = (math.random() - 0.5) * 2 * mag,
                    az    = (math.random() - 0.5) * 2 * mag,
                }
            end
        end
    end
    captured = true
    return #motors
end

local function setJoints(amount)
    for i = 1, #motors do
        local e = motors[i]
        local target
        if amount <= 0 then
            target = e.rest
        else
            target = e.rest * CFrame.Angles(e.ax * amount, e.ay * amount, e.az * amount)
        end
        pcall(function() e.motor.C0 = target end)
    end
end

-- One shot. If we are not idle, this does NOTHING - there is no get-up path.
local function trip()
    if state ~= 'idle' then
        return false
    end

    local char = lp.Character
    local root = rootOf(char)
    if not root then log('no character'); return false end

    local okCf, cf = pcall(function() return root.CFrame end)
    if not okCf or not cf then log('no CFrame'); return false end

    local okP, p0 = pcall(function() return cf.Position end)
    if not okP or not p0 then
        okP, p0 = pcall(function() return root.Position end)
    end
    if not okP or not p0 then log('no position'); return false end

    if not captured then
        local n = captureJoints(char)
        log('joints captured: ' .. tostring(n))
    end

    rollNow = (math.random() * 2 - 1) * CFG.roll

    baseCF  = cf
    pivot   = Vector3.new(p0.X, p0.Y - CFG.pivotDrop, p0.Z)
    state   = 'toppling'
    phaseAt = os.clock()

    setJoints(1)
    log(string.format('tripping about the feet (roll %+.2f rad, %.2fs) - no get-up',
        rollNow, CFG.ramp))
    return true
end

local function onInputBegan(e)
    if not binding then return end
    if type(e) ~= 'table' then return end
    local code = e.KeyCode
    if type(code) ~= 'number' then return end
    local vk = VK_OF_CODE[code]
    if not vk then return end
    CFG.keyVK   = vk
    CFG.keyName = NAME_OF_VK[vk] or ('VK ' .. tostring(vk))
    binding     = false
    log('trip key bound to ' .. CFG.keyName)
end

track(UIS.InputBegan:Connect(function(e)
    pcall(onInputBegan, e)
end))

track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local now = os.clock()

    local tripDown = (not binding) and held(CFG.keyVK)
    local tripEdge = tripDown and not lastTripKey
    lastTripKey = tripDown
    if tripEdge then
        trip()
    end

    if state == 'idle' then return end

    -- LYING: permanently silent. No CFrame writes, no velocity writes, no
    -- timer, no get-up. The body is yours to rejoin out of.
    if state == 'lying' then return end

    local char = lp.Character
    local root = rootOf(char)
    if not root or not baseCF then
        state, baseCF, pivot = 'idle', nil, nil
        return
    end

    local t = (now - phaseAt) / CFG.ramp
    if t >= 1 then
        applyTilt(root, HALF_PI)
        state = 'lying'
        log('down - script is idle for good, rejoin to stand up')
    else
        applyTilt(root, HALF_PI * curve(t))
    end
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    local k = binding and 'press a key...' or CFG.keyName
    hud.Text = string.format('[%s] %s | trip key: %s | one shot | joints %d',
        VERSION, state, k, #motors)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    log('button failed: ' .. label)
    return false
end

local keyText = nil
local function refreshKeyText()
    if not keyText then return end
    local v = binding and 'press a key...' or CFG.keyName
    pcall(function() keyText:SetText('Trip key: ' .. v) end)
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Player Trip', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Trip')
                if not sec then return end

                mkButton(sec, 'Trip (one shot)', function()
                    if not trip() then log('already down - no get-up in this build') end
                end)

                mkButton(sec, 'Rebind key', function()
                    binding = true
                    log('press the key you want for the trip')
                    refreshKeyText()
                end)

                local okT, t = pcall(function() return sec:Text('Trip key: ' .. CFG.keyName) end)
                if okT then keyText = t end
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    state, baseCF, pivot, binding, rollNow = 'idle', nil, nil, false, 0
    setJoints(0)
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Player Trip') end) end
    _G[NAME] = nil
    log('stopped (pose is NOT restored - rejoin if you are down)')
end

_G[NAME] = {
    stop    = stop,
    trip    = trip,
    version = VERSION,
    state   = function() return state end,
    bind    = function(name)
        local up = string.upper(tostring(name or ''))
        if #up == 1 then
            local b = string.byte(up)
            if (b >= 65 and b <= 90) or (b >= 48 and b <= 57) then
                CFG.keyVK = b
                CFG.keyName = up
                refreshKeyText()
                return true
            end
        end
        if up == 'SPACE' then
            CFG.keyVK = 0x20
            CFG.keyName = 'Space'
            refreshKeyText()
            return true
        end
        return false
    end,
}
log(VERSION .. ' loaded - trip key ' .. CFG.keyName .. ', ONE SHOT, no get-up')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Player Trip', 3) end)
