--[[
  Player Trip (universal) - Matcha LuauVM
  Version: v1.1
  Rebindable key fires the trip. Tap Space to recover early.

  THE ORIGINAL SCRIPT DOES NOT PORT
  It is two lines:
      hum:ChangeState(0)                       -- FallingDown
      root.Velocity = root.CFrame.LookVector * 30
  PROBED: there is no Humanoid state machine in this VM.
      hum:ChangeState          -> nil
      hum:SetStateEnabled      -> nil
      hum:GetStateEnabled      -> nil
      hum:GetState             -> nil  (calling it raised 'attempt to call
                                        missing method GetState of Instance')
      hum.PlayEmote            -> nil
      hum.LoadAnimation        -> nil
      Enum.HumanoidStateType   -> nil, so FallingDown cannot even be named
  What IS writable, from the same probe: root.CFrame and root.Velocity, both
  userdata. So the trip is faked from those two.

  HOW THE TRIP WORKS
    1. write a basis with the character's up axis lying HORIZONTAL along the
       direction of travel and its front pointing at the floor (a faceplant),
    2. push Velocity along that travel direction, and let physics carry it.
  Each physics step during the trip the CFrame is rewritten at the position
  physics produced, so the rotation holds while the velocity keeps sliding the
  character. Then the basis eases back upright and Velocity is zeroed.

  v1.1 ADDS
    - REBINDABLE KEY. Default G. Click "Rebind key" in the menu, then press the
      key you want. The capture uses UserInputService.InputBegan, which in this
      VM hands back a table with a .KeyCode field, and maps it to a Windows
      virtual-key code through the same table the bundled Matcha ImGui uses.
    - SPACE TO RECOVER. Tapping Space during a trip ends it immediately and
      eases you upright over CFG.settle, instead of waiting out CFG.duration.
      Space is checked as a rising edge, so holding it does nothing extra.

  THE HONEST LIMITS, unchanged
    - No ragdoll pose plays. The FallingDown animation is driven by the animate
      script on entering that state, and the state machine is absent. The
      character rotates and slides, but its limbs stay in the walk/idle pose.
    - Movement input is still accepted mid-trip, because there is no state to
      block it. CFG.duration and the Space recovery are the mitigations.
    - It is local: your own character rotates, so other players see a slide.

  THE CONSTANTS TO TUNE
    CFG.speed    = 30   studs/s of slide, same as the original.
    CFG.duration = 0.55 s face-down before standing back up.
    CFG.settle   = 0.18 s to ease upright afterwards.
    CFG.keyVK    = 0x47 the trip key (G). Change it with the Rebind button.

  Cost: one CFrame write per physics step, only while a trip is running.
  _G.PlayerTrip.trip() / .stop() / .state() / .bind('G')
]]

local NAME    = 'PlayerTrip'
local VERSION = 'v1.1'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local UIS        = game:GetService('UserInputService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local CFG = {
    speed    = 30,
    duration = 0.55,
    settle   = 0.18,
    keyVK    = 0x47,   -- G
    keyName  = 'G',
    recoverVK = 0x20,  -- Space
}

-- Roblox KeyCode -> Windows virtual-key code. This is the same mapping the
-- bundled Matcha ImGui uses in its MATCHA_KEYS table: InputBegan delivers a
-- Roblox KeyCode, but iskeypressed/keypress want a Windows VK.
local VK_OF_CODE = {
    [8] = 0x08, [9] = 0x09, [13] = 0x0D, [27] = 0x1B, [32] = 0x20,
    [39] = 0xDE, [44] = 0xBC, [45] = 0xBD, [46] = 0xBE, [47] = 0xBF,
    [59] = 0xBA, [61] = 0xBB, [91] = 0xDB, [92] = 0xDC, [93] = 0xDD, [96] = 0xC0,
    [127] = 0x2E,
    [273] = 0x26, [274] = 0x28, [275] = 0x27, [276] = 0x25,
    [277] = 0x2D, [278] = 0x24, [279] = 0x23, [280] = 0x21, [281] = 0x22,
}
for code = 48, 57 do VK_OF_CODE[code] = code end          -- 0-9
for code = 97, 122 do VK_OF_CODE[code] = code - 32 end    -- A-Z
for code = 282, 296 do VK_OF_CODE[code] = 0x70 + code - 282 end -- F1-F12

-- VK -> a short readable name, for the menu and the HUD
local NAME_OF_VK = {}
for code, vk in pairs(VK_OF_CODE) do
    if NAME_OF_VK[vk] == nil then
        if vk >= 0x41 and vk <= 0x5A then
            NAME_OF_VK[vk] = string.char(vk)
        elseif vk >= 0x30 and vk <= 0x39 then
            NAME_OF_VK[vk] = string.char(vk)
        elseif vk >= 0x70 and vk <= 0x7B then
            NAME_OF_VK[vk] = 'F' .. tostring(vk - 0x6F)
        end
    end
end
NAME_OF_VK[0x20] = 'Space'
NAME_OF_VK[0x0D] = 'Enter'
NAME_OF_VK[0x09] = 'Tab'
NAME_OF_VK[0x1B] = 'Esc'
NAME_OF_VK[0x08] = 'Backspace'
NAME_OF_VK[0x26] = 'Up'
NAME_OF_VK[0x28] = 'Down'
NAME_OF_VK[0x25] = 'Left'
NAME_OF_VK[0x27] = 'Right'

local state   = 'idle'
local untilAt = 0
local basis   = nil
local travel  = nil
local binding = false
local lastTripKey = false
local lastSpace   = false

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function rootOf(char)
    if not char then return nil end
    local ok, r = pcall(function()
        return char:FindFirstChild('HumanoidRootPart')
            or char:FindFirstChild('Torso')
            or char:FindFirstChild('UpperTorso')
    end)
    if ok then return r end
    return nil
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

-- The only constructor here that builds an arbitrary orientation.
-- Columns are right, up, back.
local function makeCFrame(pos, right, up, back)
    return CFrame.new(
        pos.X, pos.Y, pos.Z,
        right.X, up.X, back.X,
        right.Y, up.Y, back.Y,
        right.Z, up.Z, back.Z
    )
end

local function uprightBasis(look)
    local up    = Vector3.new(0, 1, 0)
    local back  = -look
    local right = up:Cross(back)
    if right.Magnitude < 1e-3 then
        right = Vector3.new(1, 0, 0)
    else
        right = right.Unit
    end
    return right, up, back
end

-- up = travel direction (feet behind, head forward), front = floor.
local function flatBasis(dir)
    local up    = dir
    local front = Vector3.new(0, -1, 0)
    local back  = -front
    local right = up:Cross(back)
    if right.Magnitude < 1e-3 then return nil end
    return right.Unit, up, back
end

local function trip()
    if state ~= 'idle' then return false end

    local char = lp.Character
    local root = rootOf(char)
    if not root then log('no character'); return false end

    local okCf, cf = pcall(function() return root.CFrame end)
    if not okCf or not cf then log('no CFrame'); return false end

    local look = cf.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 1e-3 then
        flat = Vector3.new(0, 0, -1)
    else
        flat = flat.Unit
    end

    local r, u, b = flatBasis(flat)
    if not r then log('bad basis'); return false end

    basis  = { right = r, up = u, back = b }
    travel = flat
    state  = 'tripping'
    untilAt = os.clock() + CFG.duration

    pcall(function()
        root.Velocity = flat * CFG.speed + Vector3.new(0, 6, 0)
    end)

    log('trip fired, ' .. string.format('%.0f', CFG.speed) .. ' studs/s')
    return true
end

-- end the trip now and ease upright
local function beginSettle(root, now)
    local r, u, b = uprightBasis(travel or Vector3.new(0, 0, -1))
    basis  = { right = r, up = u, back = b }
    state  = 'settling'
    untilAt = now + CFG.settle
    if root then
        pcall(function() root.Velocity = Vector3.new(0, 0, 0) end)
    end
end

-- rebind capture: InputBegan carries a KeyCode in this VM
local function onInputBegan(e)
    if not binding then return end
    if type(e) ~= 'table' then return end
    local code = e.KeyCode
    if type(code) ~= 'number' then return end
    local vk = VK_OF_CODE[code]
    if not vk then return end
    CFG.keyVK   = vk
    CFG.keyName = NAME_OF_VK[vk] or ('VK ' .. tostring(vk))
    binding     = false
    log('trip key bound to ' .. CFG.keyName)
end

track(UIS.InputBegan:Connect(function(e)
    pcall(onInputBegan, e)
end))

track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local char = lp.Character
    local root = rootOf(char)
    local now  = os.clock()

    -- trip key: rising edge only, and never while the menu is waiting for a bind
    local tripDown = (not binding) and held(CFG.keyVK)
    local tripEdge = tripDown and not lastTripKey
    lastTripKey = tripDown
    if tripEdge and state == 'idle' then
        trip()
    end

    -- Space recovers early, also on a rising edge
    local spaceDown = held(CFG.recoverVK)
    local spaceEdge = spaceDown and not lastSpace
    lastSpace = spaceDown
    if spaceEdge and state == 'tripping' then
        if root then beginSettle(root, now) else state = 'idle' end
        log('recovered early (space)')
        return
    end

    if state == 'idle' then return end

    if not root or not basis then
        state, basis, travel = 'idle', nil, nil
        return
    end

    local okP, p = pcall(function() return root.Position end)
    if not okP or not p then
        state, basis, travel = 'idle', nil, nil
        return
    end

    if state == 'tripping' then
        if now >= untilAt then
            beginSettle(root, now)
        else
            -- rotate only; position comes from physics so the velocity push
            -- still slides the character
            pcall(function()
                root.CFrame = makeCFrame(p, basis.right, basis.up, basis.back)
            end)
        end
    elseif state == 'settling' then
        pcall(function()
            root.CFrame = makeCFrame(p, basis.right, basis.up, basis.back)
        end)
        if now >= untilAt then
            state, basis, travel = 'idle', nil, nil
            log('recovered')
        end
    end
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    local k = binding and 'press a key...' or CFG.keyName
    hud.Text = string.format('[%s] %s | trip key: %s | space = recover', VERSION, state, k)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    log('button failed: ' .. label)
    return false
end

local keyText = nil
local function refreshKeyText()
    if not keyText then return end
    local v = binding and 'press a key...' or CFG.keyName
    pcall(function() keyText:SetText('Trip key: ' .. v) end)
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Player Trip', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Trip')
                if not sec then return end

                mkButton(sec, 'Trip', function()
                    if not trip() then log('trip did nothing - see the line above') end
                end)

                mkButton(sec, 'Rebind key', function()
                    binding = true
                    log('press the key you want for the trip')
                    refreshKeyText()
                end)

                local okT, t = pcall(function() return sec:Text('Trip key: ' .. CFG.keyName) end)
                if okT then keyText = t end
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    state, basis, travel, binding = 'idle', nil, nil, false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Player Trip') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = {
    stop  = stop,
    trip  = trip,
    version = VERSION,
    state = function() return state end,
    bind  = function(name)
        local up = string.upper(tostring(name or ''))
        if #up == 1 then
            local b = string.byte(up)
            if (b >= 65 and b <= 90) or (b >= 48 and b <= 57) then
                CFG.keyVK = b
                CFG.keyName = up
                refreshKeyText()
                return true
            end
        end
        if up == 'SPACE' then CFG.keyVK = 0x20 CFG.keyName = 'Space' refreshKeyText() return true end
        return false
    end,
}
log(VERSION .. ' loaded - trip key ' .. CFG.keyName .. ', space recovers')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Player Trip', 3) end)
