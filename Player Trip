--[[
  Player Trip (universal) - Matcha LuauVM
  Version: v2.2.0
  Rebindable key fires the trip. Tap Space to get up yourself.

  v2.2.0 - "dont make it auto bring me back up let roblox naturally do"
  v2.1.0 still had two scripted recoveries: a CFG.down timer that fired
  beginRise() on its own, and a rising phase that eased the body back upright.
  Both are gone.

  Now the trip has exactly two moments:
    1. TOPPLE  - theta ramps 0 -> 90 degrees on a t*t curve over CFG.ramp s
    2. RELEASE - one final write at 90 degrees, then the script stops writing
                 entirely. State becomes 'lying'. No timer, no auto-stand, no
                 velocity. Whatever Roblox does with the body from there is
                 what you get.
  Space (or the trip key again) gets you up manually; that is the only write
  after the release, and only because you asked for it.

  There is no velocity write anywhere in this file. Gravity does the falling.

  PROBED THIS SESSION, and it is why a true ragdoll is not available:
    Motor6D.Part0 / Part1 / Enabled   -> Unknown property (reads nil, writes error)
    Motor6D.C0                        -> reads nil, write errors
                                         ("CFrameMeta expected, got nil")
    Humanoid.PlatformStand            -> Unknown property
    AssemblyAngularVelocity / AngularVelocity / RotVelocity -> nil, writes error
    AssemblyLinearVelocity / Velocity -> readable Vector3 (NOT used here)
    Instance.new                      -> nil, so no BallSocketConstraint can be
                                         created to let the limbs actually flop
  A real physics ragdoll needs ONE of: joints disabled, PlatformStand, a
  constraint instance, or angular velocity. All four are absent in this VM.

  KNOWN CONSEQUENCE OF NOT AUTO-RISING: a rotated root CFrame write PERSISTS
  across physics steps in this VM - the humanoid does not snap the character
  upright (probed 2026-10-30: up=(1,0,0) still (1,0,0) 0.1 s later). So if the
  game does not stand you up itself, you will stay down until you press Space.
  That is the behaviour this version asks for; the console line says which
  state you are in.

  THE CONSTANTS TO TUNE
    CFG.ramp   = 0.45 s to fall over (lower = snappier topple)
    CFG.settle = 0.30 s to stand up when YOU ask for it
    CFG.flail  = 0.85 rad limb throw, only if joints are readable (usually 0)
    CFG.keyVK  = 0x47 the trip key (G)

  UNVERIFIED: how it LOOKS in game.

  _G.PlayerTrip.trip() / .stop() / .state() / .bind('G')
]]

local NAME    = 'PlayerTrip'
local VERSION = 'v2.2.0'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local UIS        = game:GetService('UserInputService')
local lp         = Players.LocalPlayer

local HALF_PI = math.pi / 2

local running = true
local conns   = {}

local function track(c)
    conns[#conns + 1] = c
    return c
end

local CFG = {
    ramp      = 0.45,
    settle    = 0.30,
    flail     = 0.85,
    keyVK     = 0x47,
    keyName   = 'G',
    recoverVK = 0x20,
}

-- Roblox KeyCode -> Windows virtual-key code, same mapping the bundled
-- Matcha ImGui uses: InputBegan delivers a KeyCode, iskeypressed wants a VK.
local VK_OF_CODE = {
    [8] = 0x08, [9] = 0x09, [13] = 0x0D, [27] = 0x1B, [32] = 0x20,
    [39] = 0xDE, [44] = 0xBC, [45] = 0xBD, [46] = 0xBE, [47] = 0xBF,
    [59] = 0xBA, [61] = 0xBB, [91] = 0xDB, [92] = 0xDC, [93] = 0xDD, [96] = 0xC0,
    [127] = 0x2E,
    [273] = 0x26, [274] = 0x28, [275] = 0x27, [276] = 0x25,
    [277] = 0x2D, [278] = 0x24, [279] = 0x23, [280] = 0x21, [281] = 0x22,
}
for code = 48, 57 do VK_OF_CODE[code] = code end
for code = 97, 122 do VK_OF_CODE[code] = code - 32 end
for code = 282, 296 do VK_OF_CODE[code] = 0x70 + code - 282 end

local NAME_OF_VK = {}
for code, vk in pairs(VK_OF_CODE) do
    if NAME_OF_VK[vk] == nil then
        if (vk >= 0x41 and vk <= 0x5A) or (vk >= 0x30 and vk <= 0x39) then
            NAME_OF_VK[vk] = string.char(vk)
        elseif vk >= 0x70 and vk <= 0x7B then
            NAME_OF_VK[vk] = 'F' .. tostring(vk - 0x6F)
        end
    end
end
NAME_OF_VK[0x20] = 'Space'
NAME_OF_VK[0x0D] = 'Enter'
NAME_OF_VK[0x09] = 'Tab'
NAME_OF_VK[0x1B] = 'Esc'
NAME_OF_VK[0x08] = 'Backspace'
NAME_OF_VK[0x26] = 'Up'
NAME_OF_VK[0x28] = 'Down'
NAME_OF_VK[0x25] = 'Left'
NAME_OF_VK[0x27] = 'Right'

local state    = 'idle'   -- idle | toppling | lying | rising
local phaseAt  = 0
local baseRot  = nil
local binding  = false
local lastTripKey = false
local lastSpace   = false
local motors   = {}
local captured = false

local function log(m)
    print('[' .. NAME .. '] ' .. tostring(m))
end

local function rootOf(char)
    if not char then return nil end
    local ok, r = pcall(function()
        return char:FindFirstChild('HumanoidRootPart')
            or char:FindFirstChild('Torso')
            or char:FindFirstChild('UpperTorso')
    end)
    if ok then return r end
    return nil
end

local function held(vk)
    if type(iskeypressed) ~= 'function' then return false end
    local ok, v = pcall(iskeypressed, vk)
    return ok and v == true
end

-- Rotation only, positioned at the origin. Built with the 12-number form
-- because CFrame.new(Vector3) errors and fromMatrix/fromAxisAngle are nil here.
local function rotOf(cf)
    local ok, r, u, b
    ok = pcall(function()
        r = cf.RightVector
        u = cf.UpVector
        b = cf.LookVector * -1
    end)
    if not ok or not r or not u or not b then return nil end
    return CFrame.new(0, 0, 0,
        r.X, u.X, b.X,
        r.Y, u.Y, b.Y,
        r.Z, u.Z, b.Z)
end

-- Write rotation about the LIVE position. Position is never restored from a
-- stored value, so gravity keeps whatever it has already done.
local function applyTilt(root, theta)
    if not root or not baseRot then return end
    local ok, p = pcall(function() return root.Position end)
    if not ok or not p then return end
    local ok2 = pcall(function()
        root.CFrame = CFrame.new(p.X, p.Y, p.Z) * (baseRot * CFrame.Angles(theta, 0, 0))
    end)
    return ok2
end

-- Optional limb flop. C0 reads nil on this build, so the capture simply finds
-- nothing and the flop never runs. It cannot error.
local function captureJoints(char)
    motors = {}
    local torso = char and (char:FindFirstChild('Torso') or char:FindFirstChild('UpperTorso'))
    if not torso then return 0 end
    local ok, kids = pcall(function() return torso:GetChildren() end)
    if not ok or not kids then return 0 end
    for i = 1, #kids do
        local m = kids[i]
        if m.ClassName == 'Motor6D' then
            local okc, c0 = pcall(function() return m.C0 end)
            if okc and c0 and type(c0) == 'userdata' then
                local mag = CFG.flail * (0.5 + math.random())
                motors[#motors + 1] = {
                    motor = m,
                    rest  = c0,
                    ax    = (math.random() - 0.5) * 2 * mag,
                    ay    = (math.random() - 0.5) * 2 * mag,
                    az    = (math.random() - 0.5) * 2 * mag,
                }
            end
        end
    end
    captured = true
    return #motors
end

local function setJoints(amount)
    for i = 1, #motors do
        local e = motors[i]
        local target
        if amount <= 0 then
            target = e.rest
        else
            target = e.rest * CFrame.Angles(e.ax * amount, e.ay * amount, e.az * amount)
        end
        pcall(function() e.motor.C0 = target end)
    end
end

local function beginRise()
    if state ~= 'toppling' and state ~= 'lying' then return false end
    state   = 'rising'
    phaseAt = os.clock()
    setJoints(0)
    log('getting up (you asked)')
    return true
end

local function trip()
    if state ~= 'idle' then
        -- while down, the trip key doubles as "get up"
        if state == 'lying' or state == 'toppling' then return beginRise() end
        return false
    end

    local char = lp.Character
    local root = rootOf(char)
    if not root then log('no character'); return false end

    local okCf, cf = pcall(function() return root.CFrame end)
    if not okCf or not cf then log('no CFrame'); return false end

    local rot = rotOf(cf)
    if not rot then log('could not read rotation'); return false end

    if not captured then
        local n = captureJoints(char)
        log('joints captured: ' .. tostring(n))
    end

    baseRot = rot
    state   = 'toppling'
    phaseAt = os.clock()

    setJoints(1)
    log('tripping (gravity fall, no push, no auto get-up)')
    return true
end

local function onInputBegan(e)
    if not binding then return end
    if type(e) ~= 'table' then return end
    local code = e.KeyCode
    if type(code) ~= 'number' then return end
    local vk = VK_OF_CODE[code]
    if not vk then return end
    if vk == CFG.recoverVK then
        log('space is reserved for getting up - pick another key')
        return
    end
    CFG.keyVK   = vk
    CFG.keyName = NAME_OF_VK[vk] or ('VK ' .. tostring(vk))
    binding     = false
    log('trip key bound to ' .. CFG.keyName)
end

track(UIS.InputBegan:Connect(function(e)
    pcall(onInputBegan, e)
end))

track(RunService.Heartbeat:Connect(function(dt)
    if not running then return end
    if dt <= 0 or dt > 0.5 then dt = 1/60 end

    local char = lp.Character
    local root = rootOf(char)
    local now  = os.clock()

    local tripDown = (not binding) and held(CFG.keyVK)
    local tripEdge = tripDown and not lastTripKey
    lastTripKey = tripDown
    if tripEdge then
        trip()
    end

    local spaceDown = held(CFG.recoverVK)
    local spaceEdge = spaceDown and not lastSpace
    lastSpace = spaceDown
    if spaceEdge and (state == 'toppling' or state == 'lying') then
        beginRise()
        return
    end

    if state == 'idle' then return end

    if not root or not baseRot then
        state, baseRot = 'idle', nil
        return
    end

    -- LYING: deliberately silent. No CFrame writes, no velocity writes, no
    -- timer. Roblox owns the body from the moment the topple finishes.
    if state == 'lying' then return end

    if state == 'toppling' then
        local t = (now - phaseAt) / CFG.ramp
        if t >= 1 then
            applyTilt(root, HALF_PI)
            state = 'lying'
            log('down - script is idle, move or press space to get up')
        else
            -- t*t: slow start, fast finish. This is the whole "fall" curve.
            applyTilt(root, HALF_PI * t * t)
        end

    elseif state == 'rising' then
        local t = (now - phaseAt) / CFG.settle
        if t >= 1 then
            applyTilt(root, 0)
            state, baseRot = 'idle', nil
        else
            local e = 1 - t
            applyTilt(root, HALF_PI * e * e)
        end
    end
end))

local hud
pcall(function()
    hud = Drawing.new('Text')
    hud.Size = 14
    hud.Outline = true
    hud.Color = Color3.fromRGB(235, 235, 245)
    hud.Position = Vector2.new(12, 60)
    hud.Visible = true
end)

track(RunService.RenderStepped:Connect(function()
    if not hud then return end
    local k = binding and 'press a key...' or CFG.keyName
    hud.Text = string.format('[%s] %s | trip key: %s | space = get up | joints %d',
        VERSION, state, k, #motors)
end))

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built  = false

local function mkSection(tab, name)
    for _, side in ipairs({ 'Left', 'Right' }) do
        local ok, sec = pcall(function() return tab:Section(name, side) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    log('button failed: ' .. label)
    return false
end

local keyText = nil
local function refreshKeyText()
    if not keyText then return end
    local v = binding and 'press a key...' or CFG.keyName
    pcall(function() keyText:SetText('Trip key: ' .. v) end)
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Player Trip', function(tab)
            if built then return end
            built = true
            local okB, errB = pcall(function()
                local sec = mkSection(tab, 'Trip')
                if not sec then return end

                mkButton(sec, 'Trip', function()
                    if not trip() then log('trip did nothing - see the line above') end
                end)

                mkButton(sec, 'Get up', function()
                    if not beginRise() then log('not down right now') end
                end)

                mkButton(sec, 'Rebind key', function()
                    binding = true
                    log('press the key you want for the trip')
                    refreshKeyText()
                end)

                local okT, t = pcall(function() return sec:Text('Trip key: ' .. CFG.keyName) end)
                if okT then keyText = t end
            end)
            if not okB then log('menu build error: ' .. tostring(errB)) end
            log('tab built')
        end)
    end)
    if not ok then
        HAS_UI = false
        log('UI.AddTab failed: ' .. tostring(err))
    end
end

local function stop()
    running = false
    state, baseRot, binding = 'idle', nil, false
    setJoints(0)
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if hud then pcall(function() hud:Remove() end); hud = nil end
    if HAS_UI then pcall(function() UI.RemoveTab('Player Trip') end) end
    _G[NAME] = nil
    log('stopped')
end

_G[NAME] = {
    stop    = stop,
    trip    = trip,
    getUp   = beginRise,
    version = VERSION,
    state   = function() return state end,
    bind    = function(name)
        local up = string.upper(tostring(name or ''))
        if #up == 1 then
            local b = string.byte(up)
            if (b >= 65 and b <= 90) or (b >= 48 and b <= 57) then
                CFG.keyVK = b
                CFG.keyName = up
                refreshKeyText()
                return true
            end
        end
        if up == 'SPACE' then
            CFG.keyVK = 0x20
            CFG.keyName = 'Space'
            refreshKeyText()
            return true
        end
        return false
    end,
}
log(VERSION .. ' loaded - trip key ' .. CFG.keyName .. ', no auto get-up')
pcall(function() notify(NAME .. ' ' .. VERSION .. ' loaded', 'Player Trip', 3) end)
