-- Gladiator Life (place 136567192786299) - combat tools - Matcha LuauVM
--
-- v2.0: all ESP removed. This build is energy only.
-- getgc never runs at load - press Scan once while you are in a fight.
-- Energy lives in the duel state table (keys en / maxEnergy), not on a
-- property, so it is written through applygc. The server may re-sync it
-- after a turn; if the number snaps back, that is the server, not the script.

local NAME    = 'GladiatorCombat'
local VERSION = 'v2.0'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local running  = true
local built    = false
local cache    = nil
local scanning = false
local nHits    = 0
local warned   = false

local cfg = {
    energy = false,
    engVal = 500,
    warn   = true,
    warnAt = 20,
}

local ENERGY_KEYS = { 'en', 'maxEnergy' }

-- scan ---------------------------------------------------------------

local function scan()
    if scanning then return end
    scanning = true
    print('[' .. NAME .. '] scanning, about 10-20s')
    local ok, res = pcall(getgc, ENERGY_KEYS)
    if ok and type(res) == 'table' and #res > 0 then
        cache = res
        nHits = #res
    else
        cache = nil
        nHits = 0
    end
    print('[' .. NAME .. '] scan done: ' .. nHits .. ' hits')
    if nHits == 0 then
        pcall(notify, 'Gladiator', 'no energy fields found - press Scan during a fight', 4)
    end
    scanning = false
end

-- apply / watch loop -------------------------------------------------

task.spawn(function()
    while running do
        if cache then
            if cfg.energy then
                for k, key in ipairs(ENERGY_KEYS) do
                    pcall(applygc, cache, key, cfg.engVal)
                end
                warned = false
            elseif cfg.warn then
                local low = false
                for k, e in ipairs(cache) do
                    if e.key == 'en' and type(e.value) == 'number' then
                        if e.value <= cfg.warnAt then low = true end
                    end
                end
                if low and not warned then
                    warned = true
                    pcall(notify, 'Gladiator', 'energy low', 2)
                elseif not low then
                    warned = false
                end
            end
        end
        task.wait(0.5)
    end
end)

-- menu ---------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local en = mkSection(tab, 'Energy')
        if en then
            mkToggle(en, 'Inf Energy', 'gc_energy', false, function(v) cfg.energy = v end)
            mkSlider(en, 'Energy Value', 'gc_engval', 100, 2000, 500, function(v) cfg.engVal = v end)
            mkButton(en, 'Scan for energy', function()
                print('[' .. NAME .. '] scan pressed')
                task.spawn(scan)
            end)
        end
        local ex = mkSection(tab, 'Extras')
        if ex then
            mkToggle(ex, 'Low energy warning', 'gc_warn', true, function(v) cfg.warn = v end)
            mkSlider(ex, 'Warn below', 'gc_warnat', 1, 200, 20, function(v) cfg.warnAt = v end)
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Gladiator', function(tab)
            if built then return end
            print('[' .. NAME .. '] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- boot ---------------------------------------------------------------

print('[' .. NAME .. '] ready. Open the Gladiator tab, press Scan for energy during a fight, then toggle Inf Energy.')

local function stop()
    running = false
    if HAS_UI then pcall(function() UI.RemoveTab('Gladiator') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, scan = scan, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI))
