-- Gladiator Life (place 136567192786299) - ESP + manual stat scan - Matcha LuauVM
--
-- v1.1 SAFE MODE: getgc does NOT run at load. It only runs when you press Scan,
-- because a heap scan at boot is the most likely cause of the last crash.
-- ESP uses the two-loop pattern: a slow collector and a per-frame renderer.

local NAME    = 'GladiatorLife'
local VERSION = 'v1.1'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local ws         = game:GetService('Workspace')
local lp         = Players.LocalPlayer

local running  = true
local built    = false
local cache    = nil
local scanning = false
local conn     = nil
local nHits    = 0

local cfg = {
    plr    = true,
    npc    = true,
    speed  = false,
    energy = false,
    spdVal = 60,
    engVal = 500,
}

-- field names taken from the decompiled duel state: maxHp, maxEnergy, en, down
local SCAN_KEYS   = { 'WalkSpeed', 'maxEnergy', 'Stamina', 'Energy' }
local SPEED_KEYS  = { 'WalkSpeed' }
local ENERGY_KEYS = { 'maxEnergy', 'Stamina', 'Energy' }

-- esp pool -----------------------------------------------------------

local POOL    = 24
local targets = {}
local pool    = {}

for i = 1, POOL do
    local box = Drawing.new('Square')
    box.Thickness = 1
    box.Filled    = false
    box.Color     = Color3.fromRGB(255, 80, 80)
    box.Visible   = false
    local tag = Drawing.new('Text')
    tag.Size    = 13
    tag.Center  = true
    tag.Outline = true
    tag.Color   = Color3.fromRGB(255, 255, 255)
    tag.Visible = false
    pool[i] = { box = box, tag = tag }
end

local function collect()
    local out = {}
    if cfg.plr then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp then
                local char = plr.Character
                local root = char and char:FindFirstChild('HumanoidRootPart')
                local head = char and char:FindFirstChild('Head')
                if root and head then
                    out[#out + 1] = { name = plr.Name, head = head, root = root }
                end
            end
        end
    end
    if cfg.npc then
        local folders = { ws:FindFirstChild('Arena'), ws:FindFirstChild('Figures') }
        for _, f in ipairs(folders) do
            if f then
                for _, m in ipairs(f:GetChildren()) do
                    local root = m:FindFirstChild('HumanoidRootPart')
                    local hum  = m:FindFirstChildOfClass('Humanoid')
                    if root and hum then
                        out[#out + 1] = { name = m.Name, head = root, root = root }
                    end
                end
            end
        end
    end
    targets = out
end

task.spawn(function()
    while running do
        pcall(collect)
        task.wait(0.5)
    end
end)

-- renderer -----------------------------------------------------------

conn = RunService.RenderStepped:Connect(function()
    local list = targets
    local n = 0
    for i = 1, #list do
        if n >= POOL then break end
        local t = list[i]
        local top, v1 = WorldToScreen(t.head.Position + Vector3.new(0, 0.8, 0))
        local bot, v2 = WorldToScreen(t.root.Position - Vector3.new(0, 3.0, 0))
        if v1 and v2 then
            n = n + 1
            local e = pool[n]
            local h = bot.Y - top.Y
            if h < 4 then h = 4 end
            local w = h * 0.5
            e.box.Position = Vector2.new(top.X - w * 0.5, top.Y)
            e.box.Size = Vector2.new(w, h)
            e.box.Visible = true
            e.tag.Text = t.name
            e.tag.Position = Vector2.new(top.X, top.Y - 16)
            e.tag.Visible = true
        end
    end
    for i = n + 1, POOL do
        pool[i].box.Visible = false
        pool[i].tag.Visible = false
    end
end)

-- gc scan: MANUAL ONLY ------------------------------------------------

local function scan()
    if scanning then return end
    scanning = true
    print('[' .. NAME .. '] scanning, this can take 10-20s and may hitch')
    local ok, res = pcall(getgc, SCAN_KEYS)
    if ok and type(res) == 'table' and #res > 0 then
        cache = res
        nHits = #res
    else
        nHits = 0
    end
    print('[' .. NAME .. '] scan done: ' .. nHits .. ' hits')
    if nHits == 0 then
        pcall(notify, 'Gladiator', 'scan found nothing - press Scan during a battle', 4)
    end
    scanning = false
end

-- apply loop ---------------------------------------------------------

task.spawn(function()
    while running do
        if cache then
            if cfg.speed then
                for _, k in ipairs(SPEED_KEYS) do
                    pcall(applygc, cache, k, cfg.spdVal)
                end
            end
            if cfg.energy then
                for _, k in ipairs(ENERGY_KEYS) do
                    pcall(applygc, cache, k, cfg.engVal)
                end
            end
        end
        task.wait(0.5)
    end
end)

-- menu ---------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local vis = mkSection(tab, 'Visuals')
        if vis then
            mkToggle(vis, 'Player ESP', 'gl_plr', true, function(v) cfg.plr = v end)
            mkToggle(vis, 'NPC ESP',    'gl_npc', true, function(v) cfg.npc = v end)
        end
        local st = mkSection(tab, 'Stats')
        if st then
            mkToggle(st, 'Speed',        'gl_speed',  false, function(v) cfg.speed = v end)
            mkSlider(st, 'Speed Value',  'gl_spdval', 16, 200, 60,  function(v) cfg.spdVal = v end)
            mkToggle(st, 'Energy',       'gl_energy', false, function(v) cfg.energy = v end)
            mkSlider(st, 'Energy Value', 'gl_engval', 100, 2000, 500, function(v) cfg.engVal = v end)
            mkButton(st, 'Scan (slow)', function()
                print('[' .. NAME .. '] scan pressed')
                task.spawn(scan)
            end)
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Gladiator', function(tab)
            if built then return end
            print('[' .. NAME .. '] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- boot: nothing expensive here ---------------------------------------

print('[' .. NAME .. '] ESP active. Scan is manual - open the Gladiator tab, press Scan during a battle.')

local function stop()
    running = false
    if conn then pcall(function() conn:Disconnect() end) end
    for i = 1, POOL do
        pcall(function() pool[i].box:Remove() end)
        pcall(function() pool[i].tag:Remove() end)
    end
    if HAS_UI then pcall(function() UI.RemoveTab('Gladiator') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, scan = scan, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI))
