-- Gladiator Life (place 136567192786299) - combat - Matcha LuauVM
--
-- v3.0: the gc scan is gone. Energy is not a client number in this game
-- (29 hits for en/maxEnergy, zero numeric), so an inf-energy toggle cannot
-- work from the client. What does work is the game's own remote:
--   SS.Remote:InvokeServer("DuelAct", { id = <action> })
-- with "Action" as the fallback name. Action ids come from the game's own
-- pose table: quick, normal, power, charge, shove, throw, taunt, rest.

local NAME    = 'GladiatorCombat'
local VERSION = 'v3.0'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local SS     = game:GetService('ReplicatedStorage'):FindFirstChild('SS')
local Remote = SS and SS:FindFirstChild('Remote')

local running = true
local built   = false

local cfg = {
    auto   = false,
    action = 'power',
    delay  = 0.8,
}

local ACTIONS = { 'quick', 'normal', 'power', 'charge', 'shove', 'throw', 'taunt', 'rest' }

-- remote -------------------------------------------------------------

local function send(name, payload)
    if not Remote then return false, 'no remote' end
    local ok, res = pcall(function()
        return Remote:InvokeServer(name, payload)
    end)
    if not ok then return false, res end
    return true, res
end

local function act(id)
    if not Remote then
        print('[' .. NAME .. '] no SS.Remote found')
        return false
    end
    local ok1, res1 = send('DuelAct', { id = id })
    if ok1 and type(res1) == 'table' and res1.ok then
        print('[' .. NAME .. '] ' .. id .. ' sent via DuelAct')
        return true
    end
    local ok2, res2 = send('Action', { id = id })
    if ok2 and type(res2) == 'table' and res2.ok then
        print('[' .. NAME .. '] ' .. id .. ' sent via Action')
        return true
    end
    print('[' .. NAME .. '] ' .. id .. ' failed: ' .. tostring(res2 or res1))
    return false
end

task.spawn(function()
    while running do
        if cfg.auto then
            act(cfg.action)
            task.wait(cfg.delay)
        else
            task.wait(0.2)
        end
    end
end)

-- menu ---------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function setAction(id)
    cfg.action = id
    print('[' .. NAME .. '] action set to ' .. id)
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local c = mkSection(tab, 'Combat')
        if c then
            mkToggle(c, 'Auto Attack', 'gc_auto', false, function(v) cfg.auto = v end)
            mkSlider(c, 'Delay (ms)', 'gc_delay', 200, 2000, 800, function(v) cfg.delay = v / 1000 end)
            mkButton(c, 'Use Quick', function() setAction('quick') end)
            mkButton(c, 'Use Normal', function() setAction('normal') end)
            mkButton(c, 'Use Power', function() setAction('power') end)
            mkButton(c, 'Use Charge', function() setAction('charge') end)
        end
        local a = mkSection(tab, 'Actions')
        if a then
            mkButton(a, 'Use Shove', function() setAction('shove') end)
            mkButton(a, 'Use Throw', function() setAction('throw') end)
            mkButton(a, 'Use Taunt', function() setAction('taunt') end)
            mkButton(a, 'Use Rest', function() setAction('rest') end)
            mkButton(a, 'Send Action Once', function()
                print('[' .. NAME .. '] sending ' .. cfg.action)
                act(cfg.action)
            end)
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Gladiator', function(tab)
            if built then return end
            print('[' .. NAME .. '] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- boot ---------------------------------------------------------------

if not Remote then
    warn('[' .. NAME .. '] SS.Remote not found - combat buttons will do nothing')
end
print('[' .. NAME .. '] ready. Combat tab: pick an action, then Auto Attack. Remote found=' .. tostring(Remote ~= nil))

local function stop()
    running = false
    cfg.auto = false
    if HAS_UI then pcall(function() UI.RemoveTab('Gladiator') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, act = act, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI))
