-- Gladiator Life (place 136567192786299) - ESP + stat tools - Matcha LuauVM
--
-- v1.2: no player has a Character in this game (turn-based). The fighters are
-- custom rigs in workspace.FightView and workspace.Figures, so ESP targets those.
-- getgc runs only when you press Scan, never at load.

local NAME    = 'GladiatorLife'
local VERSION = 'v1.2'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local ws         = game:GetService('Workspace')
local cam        = ws:FindFirstChild('Camera')

local running  = true
local built    = false
local cache    = nil
local scanning = false
local conn     = nil
local nHits    = 0

local cfg = {
    fighters = true,
    npcs     = false,
    names    = true,
    dist     = true,
    speed    = false,
    energy   = false,
    spdVal   = 60,
    engVal   = 500,
}

local SPEED_KEYS  = { 'WalkSpeed' }
local ENERGY_KEYS = { 'maxEnergy', 'Stamina', 'Energy' }
local SCAN_KEYS   = { 'WalkSpeed', 'maxEnergy', 'Stamina', 'Energy' }

-- drawing pool -------------------------------------------------------

local POOL    = 32
local targets = {}
local pool    = {}

for i = 1, POOL do
    local box = Drawing.new('Square')
    box.Thickness = 1
    box.Filled    = false
    box.Color     = Color3.fromRGB(255, 90, 90)
    box.Visible   = false
    local tag = Drawing.new('Text')
    tag.Size    = 13
    tag.Center  = true
    tag.Outline = true
    tag.Color   = Color3.fromRGB(255, 255, 255)
    tag.Visible = false
    local info = Drawing.new('Text')
    info.Size    = 12
    info.Center  = true
    info.Outline = true
    info.Color   = Color3.fromRGB(200, 230, 255)
    info.Visible = false
    pool[i] = { box = box, tag = tag, info = info }
end

-- collector ----------------------------------------------------------

local function rigParts(m)
    local root = m:FindFirstChild('HumanoidRootPart')
    if not root then root = m:FindFirstChild('Torso') end
    if not root then root = m:FindFirstChild('Head') end
    if not root then return nil, nil end
    local head = m:FindFirstChild('Head')
    if not head then head = root end
    return head, root
end

local function addRig(out, m)
    if m.ClassName ~= 'Model' then return end
    local head, root = rigParts(m)
    if not head or not root then return end
    local hum = m:FindFirstChildOfClass('Humanoid')
    if not hum then return end
    local hp = hum.Health or 0
    if hp <= 0 then return end
    out[#out + 1] = { name = m.Name, head = head, root = root }
end

local function collect()
    local out = {}
    if cfg.fighters then
        local fv = ws:FindFirstChild('FightView')
        if fv then
            for k, m in ipairs(fv:GetChildren()) do
                addRig(out, m)
            end
        end
    end
    if cfg.npcs then
        local fg = ws:FindFirstChild('Figures')
        if fg then
            for k, m in ipairs(fg:GetChildren()) do
                addRig(out, m)
            end
        end
    end
    targets = out
end

task.spawn(function()
    while running do
        pcall(collect)
        task.wait(0.5)
    end
end)

-- renderer -----------------------------------------------------------

conn = RunService.RenderStepped:Connect(function()
    local ok, err = pcall(function()
        local list = targets
        local camPos = cam and cam.Position or Vector3.new(0, 0, 0)
        local n = 0
        for i = 1, #list do
            if n >= POOL then break end
            local t = list[i]
            local top, v1 = WorldToScreen(t.head.Position + Vector3.new(0, 0.9, 0))
            local bot, v2 = WorldToScreen(t.root.Position - Vector3.new(0, 2.8, 0))
            if v1 and v2 then
                n = n + 1
                local e = pool[n]
                local h = bot.Y - top.Y
                if h < 6 then h = 6 end
                local w = h * 0.45
                e.box.Position = Vector2.new(top.X - w * 0.5, top.Y)
                e.box.Size = Vector2.new(w, h)
                e.box.Visible = true
                if cfg.names then
                    e.tag.Text = t.name
                    e.tag.Position = Vector2.new(top.X, top.Y - 16)
                    e.tag.Visible = true
                else
                    e.tag.Visible = false
                end
                if cfg.dist then
                    local d = math.floor((t.root.Position - camPos).Magnitude)
                    e.info.Text = tostring(d) .. 'm'
                    e.info.Position = Vector2.new(top.X, bot.Y + 2)
                    e.info.Visible = true
                else
                    e.info.Visible = false
                end
            end
        end
        for i = n + 1, POOL do
            pool[i].box.Visible = false
            pool[i].tag.Visible = false
            pool[i].info.Visible = false
        end
    end)
    if not ok then warn('[' .. NAME .. '] draw: ' .. tostring(err)) end
end)

-- gc scan: manual only -----------------------------------------------

local function scan()
    if scanning then return end
    scanning = true
    print('[' .. NAME .. '] scanning, this can take 10-20s and may hitch')
    local ok, res = pcall(getgc, SCAN_KEYS)
    if ok and type(res) == 'table' and #res > 0 then
        cache = res
        nHits = #res
    else
        cache = nil
        nHits = 0
    end
    print('[' .. NAME .. '] scan done: ' .. nHits .. ' hits')
    if nHits == 0 then
        pcall(notify, 'Gladiator', 'scan found nothing - press Scan during a fight', 4)
    end
    scanning = false
end

-- apply loop ---------------------------------------------------------

task.spawn(function()
    while running do
        if cache then
            if cfg.speed then
                for k, key in ipairs(SPEED_KEYS) do
                    pcall(applygc, cache, key, cfg.spdVal)
                end
            end
            if cfg.energy then
                for k, key in ipairs(ENERGY_KEYS) do
                    pcall(applygc, cache, key, cfg.engVal)
                end
            end
        end
        task.wait(0.5)
    end
end)

-- menu ---------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local vis = mkSection(tab, 'ESP')
        if vis then
            mkToggle(vis, 'Fighters (FightView)', 'gl_fighters', true,  function(v) cfg.fighters = v end)
            mkToggle(vis, 'Town NPCs (Figures)',  'gl_npcs',     false, function(v) cfg.npcs = v end)
            mkToggle(vis, 'Names',                'gl_names',    true,  function(v) cfg.names = v end)
            mkToggle(vis, 'Distance',             'gl_dist',     true,  function(v) cfg.dist = v end)
        end
        local st = mkSection(tab, 'Stats')
        if st then
            mkToggle(st, 'Speed',        'gl_speed',  false, function(v) cfg.speed = v end)
            mkSlider(st, 'Speed Value',  'gl_spdval', 16, 200, 60,  function(v) cfg.spdVal = v end)
            mkToggle(st, 'Energy',       'gl_energy', false, function(v) cfg.energy = v end)
            mkSlider(st, 'Energy Value', 'gl_engval', 100, 2000, 500, function(v) cfg.engVal = v end)
            mkButton(st, 'Scan for stats', function()
                print('[' .. NAME .. '] scan pressed')
                task.spawn(scan)
            end)
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Gladiator', function(tab)
            if built then return end
            print('[' .. NAME .. '] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- boot ---------------------------------------------------------------

print('[' .. NAME .. '] ESP is on for FightView fighters. Open the Gladiator tab for options.')

local function stop()
    running = false
    if conn then pcall(function() conn:Disconnect() end) end
    for i = 1, POOL do
        pcall(function() pool[i].box:Remove() end)
        pcall(function() pool[i].tag:Remove() end)
        pcall(function() pool[i].info:Remove() end)
    end
    pool = {}
    targets = {}
    if HAS_UI then pcall(function() UI.RemoveTab('Gladiator') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, scan = scan, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI))
