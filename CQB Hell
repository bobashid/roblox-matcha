-- CQB Hell (place 98689921952741) - Weapon Mods - Matcha LuauVM
--
-- ONE menu tab, ONE section: Weapon. No ESP, no Drawing, no render loop.
--
-- Confirmed in game (probes 2026-10-27):
--   <gun>.Settings.<Weapon>.Firerate      is a NumberValue (values 0.1, 0.15, 0.2, 0.4, 1)
--   <gun>.Settings.<Weapon>.ReloadDelay   is a NumberValue (value 0.2)
--   seen on EnemyShotgun_Corpse / Tec9_Corpse / PKM_Corpse under Workspace.
--   -> plain writable instances: no getgc, no applygc, no frozen table.
--      (Realistic Home Defense freezes these via LockSettings; this game does not.)
--   LocalPlayer.Character is intermittent here, so the character is resolved as
--     workspace[LocalPlayer.Name]   (probe: 'CHAR true name=FakeAimbotON')
-- UNVERIFIED:
--   the ammo field name inside a live gun (no gun was equipped while probing).
--     Inf Ammo writes any NumberValue under your character containing 'ammo' but
--     not 'max', and also refills the Tool's Local_CurrentAmmo / Ammo attributes.
--   whether the server honours client-side Firerate / ReloadDelay writes, or
--     recomputes them on its own tick. If shots do not speed up, that is why.
--
-- v3.0: ESP removed entirely (user request). Weapon mods only.
--       Original Firerate / ReloadDelay are captured BEFORE the first write and
--       restored by Reset or by stop(), so a toggle never leaves the gun broken.
--       Fire rate is clamped to 0.01 so a slider left at 0 cannot write Firerate 0.

local NAME    = 'CQBHellWeapon'
local VERSION = 'v3.0'

-- kill the previous weapon build AND the old ESP build, whichever is loaded
if _G.CQBHellESP and _G.CQBHellESP.stop then
    pcall(_G.CQBHellESP.stop)
end
if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local Players = game:GetService('Players')
local running = true

local cfg = {
    infAmmo    = false,
    fastReload = false,
    rapidFire  = false,
    fireVal    = 0.05,
    reloadVal  = 0,
}

-- originals captured so Reset / stop can put the gun back the way it was
local originals = {}

-- ---- helpers ----

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function myCharacter()
    local myName = nil
    pcall(function() myName = Players.LocalPlayer.Name end)
    if myName == nil then return nil end
    local ch = nil
    pcall(function() ch = workspace:FindFirstChild(myName) end)
    return ch
end

-- ---- the gun's own values ----

-- Firerate / ReloadDelay / ammo live as NumberValues under the equipped gun.
-- Only the LOCAL character is walked, so a corpse on the floor is never touched.
local fireVals, reloadVals, ammoVals = {}, {}, {}

local function collectWeaponValues()
    local fires, reloads, ammos = {}, {}, {}
    local ch = myCharacter()
    if ch == nil then return fires, reloads, ammos end
    local ok, d = pcall(function() return ch:GetDescendants() end)
    if not ok then return fires, reloads, ammos end
    for i = 1, #d do
        local v = d[i]
        if v.ClassName == 'NumberValue' then
            local low = string.lower(v.Name)
            if low == 'firerate' then
                fires[#fires + 1] = v
            elseif low == 'reloaddelay' then
                reloads[#reloads + 1] = v
            elseif string.find(low, 'ammo', 1, true) ~= nil
                and string.find(low, 'max', 1, true) == nil then
                ammos[#ammos + 1] = v
            end
        end
    end
    return fires, reloads, ammos
end

-- Record the pre-write value the first time an instance is seen. Called before
-- applyWeapon in the same iteration, so the captured number is the game's own.
local function captureOriginals(list)
    for i = 1, #list do
        local v = list[i]
        if originals[v] == nil then
            local ok, cur = pcall(function() return v.Value end)
            if ok and type(cur) == 'number' then
                originals[v] = cur
            end
        end
    end
end

local function restoreOriginals()
    local n = 0
    for v, val in pairs(originals) do
        local ok = pcall(function() v.Value = val end)
        if ok then n = n + 1 end
    end
    originals = {}
    if n > 0 then print('[' .. NAME .. '] restored ' .. tostring(n) .. ' value(s)') end
    return n
end

-- Refill the Tool's own ammo attributes when the game exposes them.
local function refillAmmoAttrs()
    local ch = myCharacter()
    if ch == nil then return end
    local ok, d = pcall(function() return ch:GetDescendants() end)
    if not ok then return end
    for i = 1, #d do
        local v = d[i]
        if v.ClassName == 'Tool' then
            local mx = nil
            pcall(function() mx = v:GetAttribute('MaxAmmo') end)
            if type(mx) == 'number' then
                pcall(function() v:SetAttribute('Local_CurrentAmmo', mx) end)
                pcall(function() v:SetAttribute('Ammo', mx) end)
            end
        end
    end
end

local function applyWeapon()
    if cfg.rapidFire then
        local fv = cfg.fireVal
        if type(fv) ~= 'number' or fv < 0.01 then fv = 0.01 end
        for i = 1, #fireVals do
            pcall(function() fireVals[i].Value = fv end)
        end
    end
    if cfg.fastReload then
        local rv = cfg.reloadVal
        if type(rv) ~= 'number' or rv < 0 then rv = 0 end
        for i = 1, #reloadVals do
            pcall(function() reloadVals[i].Value = rv end)
        end
    end
    if cfg.infAmmo then
        for i = 1, #ammoVals do
            pcall(function()
                local v = ammoVals[i]
                local mx = v:FindFirstChild('Max' .. v.Name)
                if mx ~= nil and type(mx.Value) == 'number' then
                    v.Value = mx.Value
                else
                    v.Value = 9999
                end
            end)
        end
        refillAmmoAttrs()
    end
end

-- ---- menu ----

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local built = false

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, label, id, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] slider failed: ' .. label)
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_b', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. label)
    return false
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local w = mkSection(tab, 'Weapon')
        if w == nil then return end

        mkToggle(w, 'Inf Ammo', 'cqb_infammo', false, function(v) cfg.infAmmo = v end)

        mkToggle(w, 'Faster Reload', 'cqb_fastreload', false, function(v) cfg.fastReload = v end)
        mkSlider(w, 'Reload Delay (x100)', 'cqb_reloadval', 0, 100, 0, function(v) cfg.reloadVal = v / 100 end)

        mkToggle(w, 'Rapid Fire', 'cqb_rapid', false, function(v) cfg.rapidFire = v end)
        mkSlider(w, 'Fire Rate (x100)', 'cqb_fireval', 1, 100, 5, function(v) cfg.fireVal = v / 100 end)

        mkButton(w, 'Refill Ammo Now', function()
            print('[' .. NAME .. '] refill pressed')
            pcall(refillAmmoAttrs)
            if #ammoVals > 0 then
                local was = cfg.infAmmo
                cfg.infAmmo = true
                pcall(applyWeapon)
                cfg.infAmmo = was
            end
        end)
        mkButton(w, 'Reset Gun Values', function()
            print('[' .. NAME .. '] reset pressed')
            cfg.rapidFire = false
            cfg.fastReload = false
            pcall(restoreOriginals)
        end)
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('CQB Hell', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- ---- loop ----

task.spawn(function()
    while running do
        local okF, f, rl, am = pcall(collectWeaponValues)
        if okF then
            fireVals, reloadVals, ammoVals = f, rl, am
            -- capture BEFORE writing, so the first number seen is the game's own
            pcall(captureOriginals, fireVals)
            pcall(captureOriginals, reloadVals)
        end
        if cfg.infAmmo or cfg.fastReload or cfg.rapidFire then
            pcall(applyWeapon)
        end
        task.wait(0.2)
    end
end)

-- ---- stop ----

local function stop()
    running = false
    cfg.rapidFire = false
    cfg.fastReload = false
    cfg.infAmmo = false
    pcall(restoreOriginals)
    if HAS_UI then pcall(function() UI.RemoveTab('CQB Hell') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI))
pcall(notify, 'CQB Hell', 'weapon mods ' .. VERSION, 4)
