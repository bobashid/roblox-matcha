-- Build And Kill Zombies - Auto Roll both rollers - Matcha LuauVM
-- place 105011592530400
--
-- v31 rewrite. What was wrong in v30:
--   1. keypress(Enum.KeyCode.E): keypress takes a Windows VK integer (E = 69),
--      so every press was a no-op and the roll never fired.
--   2. the mouse path only ran if a prompt button already had a size, and the
--      pass gave up whenever anything sat on ItemPlace.
--   3. it never checked which roller the on-screen prompt belonged to, so a
--      press could land on the wrong roller.
--
-- How this version presses:
--   * WorldToScreen inside RenderStepped keeps the screen point of each
--     roller's Roll part and of its ItemPlace part.
--   * the prompt's own on-screen button nearest that point is clicked with
--     mousemoveabs + mouse1press / mouse1release.
--   * if no button is drawn, keypress(69) / keyrelease(69) is sent.
--   * after either, the roller text and ItemPlace model are re-read; no
--     change means the press was ignored.
--
-- no Instance.new, no hooks, no getconnections, no teleports.

local NAME    = 'RollerMods'
local VERSION = 'v31.0'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local ws         = game:GetService('Workspace')
local lp         = Players.LocalPlayer

local alive    = true
local running  = false
local autoBoth = false
local buyFirst = true
local delay    = 0.4
local VK_E     = 69

local conns = {}
local function track(c)
    conns[#conns + 1] = c
    return c
end

local cur    = { weapons = nil, blocks = nil }
local screen = {}

-- reads ----------------------------------------------------------------

local function myPlot()
    local g = ws:FindFirstChild('Game')
    local l = g and g:FindFirstChild('Lobby')
    local pf = l and l:FindFirstChild('Plots')
    if not pf then return nil end
    for _, p in ipairs(pf:GetChildren()) do
        local ok, owner = pcall(function() return p:GetAttribute('OwnerUserId') end)
        if ok and owner == lp.UserId then return p end
    end
    return nil
end

local function rollers()
    local p = myPlot()
    local rolls = p and p:FindFirstChild('Rolls')
    if not rolls then return nil, nil end
    return rolls:FindFirstChild('RollWeapons'), rolls:FindFirstChild('RollBlocks')
end

local function text(roller, field)
    local info = roller and roller:FindFirstChild('Info')
    local lbl  = info and info:FindFirstChild(field)
    if not lbl then return nil end
    local ok, v = pcall(function() return lbl.Text end)
    if ok then return v end
    return nil
end

local function itemModel(roller)
    local ip = roller and roller:FindFirstChild('ItemPlace')
    if not ip then return nil end
    for _, c in ipairs(ip:GetChildren()) do
        if c.ClassName == 'Model' then return c.Name end
    end
    return nil
end

local function sig(roller)
    return tostring(text(roller, 'ItemName')) .. '|' .. tostring(itemModel(roller))
end

-- prompt clicking ------------------------------------------------------

local function promptButtons()
    local pg = lp:FindFirstChild('PlayerGui')
    local pp = pg and pg:FindFirstChild('ProximityPrompts')
    local out = {}
    if not pp then return out end
    for _, d in ipairs(pp:GetDescendants()) do
        local cn = d.ClassName
        if cn == 'TextButton' or cn == 'ImageButton' then
            local okS, s = pcall(function() return d.AbsoluteSize end)
            local okP, p = pcall(function() return d.AbsolutePosition end)
            if okS and okP and s and p and s.X > 2 and s.Y > 2 then
                out[#out + 1] = { x = p.X + s.X * 0.5, y = p.Y + s.Y * 0.5 }
            end
        end
    end
    return out
end

local function clickAt(target, maxDist)
    local pick, pickD = nil, maxDist * maxDist
    for _, b in ipairs(promptButtons()) do
        local d = (b.x - target.x) * (b.x - target.x) + (b.y - target.y) * (b.y - target.y)
        if d < pickD then pick, pickD = b, d end
    end
    if not pick then return false end
    pcall(mousemoveabs, pick.x, pick.y)
    task.wait(0.06)
    pcall(mouse1press)
    task.wait(0.1)
    pcall(mouse1release)
    return true
end

local function clickPromptFor(key)
    local pt = screen[key]
    if pt and clickAt(pt, 170) then return true end
    local list = promptButtons()
    if #list == 1 then return clickAt(list[1], 10000) end
    return false
end

local function pressE(hold)
    pcall(keypress, VK_E)
    task.wait(hold or 0.12)
    pcall(keyrelease, VK_E)
    task.wait(0.04)
    pcall(keyrelease, VK_E)
end

-- actions --------------------------------------------------------------

local function activate(roller, key, tag)
    local before = sig(roller)
    for attempt = 1, 3 do
        if not alive then return false end
        local clicked = clickPromptFor(key)
        task.wait(0.45)
        if sig(roller) ~= before then
            print('[' .. NAME .. '] ' .. tag .. ' -> ' .. tostring(text(roller, 'ItemName')) .. ' via click try ' .. attempt)
            return true
        end
        pressE(0.12)
        task.wait(0.45)
        if sig(roller) ~= before then
            print('[' .. NAME .. '] ' .. tag .. ' -> ' .. tostring(text(roller, 'ItemName')) .. ' via E try ' .. attempt)
            return true
        end
        print('[' .. NAME .. '] ' .. tag .. ' no change try ' .. attempt .. ' (clicked=' .. tostring(clicked) .. ')')
        task.wait(delay)
    end
    return false
end

local function buyItem(roller, key, tag)
    local before = itemModel(roller)
    if not before then return false end
    clickPromptFor(key .. ':buy')
    task.wait(0.9)
    local now = itemModel(roller)
    if now ~= before then
        print('[' .. NAME .. '] ' .. tag .. ' bought ' .. tostring(before))
        return true
    end
    print('[' .. NAME .. '] ' .. tag .. ' buy ignored, still ' .. tostring(now))
    return false
end

-- screen tracking ------------------------------------------------------

local function project(roller, key)
    if not roller then
        screen[key] = nil
        screen[key .. ':buy'] = nil
        return
    end
    local roll = roller:FindFirstChild('Roll')
    if roll then
        local ok, sp, on = pcall(WorldToScreen, roll.Position)
        if ok and on and sp then screen[key] = { x = sp.X, y = sp.Y } else screen[key] = nil end
    else
        screen[key] = nil
    end
    local ip = roller:FindFirstChild('ItemPlace')
    if ip then
        local ok2, sp2, on2 = pcall(WorldToScreen, ip.Position)
        if ok2 and on2 and sp2 then screen[key .. ':buy'] = { x = sp2.X, y = sp2.Y } else screen[key .. ':buy'] = nil end
    else
        screen[key .. ':buy'] = nil
    end
end

track(RunService.RenderStepped:Connect(function()
    pcall(project, cur.weapons, 'RollWeapons')
    pcall(project, cur.blocks, 'RollBlocks')
end))

-- roller discovery, once a second --------------------------------------

task.spawn(function()
    while alive do
        local w, b = rollers()
        cur.weapons, cur.blocks = w, b
        task.wait(1)
    end
end)

-- main loop ------------------------------------------------------------

task.spawn(function()
    while alive do
        if running and autoBoth then
            local w, b = cur.weapons, cur.blocks
            local got = false
            if w then
                if buyFirst then buyItem(w, 'RollWeapons', 'weapons') end
                if activate(w, 'RollWeapons', 'weapons') then got = true end
            end
            if alive and b then
                if buyFirst then buyItem(b, 'RollBlocks', 'blocks') end
                if activate(b, 'RollBlocks', 'blocks') then got = true end
            end
            if not w and not b then
                print('[' .. NAME .. '] no plot or no Rolls folder yet')
            end
            task.wait(got and 1.2 or 3)
        else
            task.wait(0.5)
        end
    end
end)

-- menu ----------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkToggle(sec, label, id, default, setter)
    local cb = function(...)
        local v = firstBool(...)
        if v == nil then return end
        setter(v)
        print('[' .. NAME .. '] ' .. label .. ' = ' .. tostring(v))
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    print('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Rollers', function(tab)
            local ok2, sec = pcall(function() return tab:Section('Roll') end)
            if not ok2 or not sec then
                print('[' .. NAME .. '] section failed')
                return
            end
            mkToggle(sec, 'Enabled', 'rm_on', false, function(v) running = v end)
            mkToggle(sec, 'Auto Roll Both', 'rm_both', false, function(v) autoBoth = v end)
            mkToggle(sec, 'Buy item first', 'rm_buy', true, function(v) buyFirst = v end)
        end)
    end)
    if not ok then print('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err)) end
else
    print('[' .. NAME .. '] no UI table - menu unavailable')
end

-- status ---------------------------------------------------------------

task.spawn(function()
    local p = myPlot()
    if not p then
        print('[' .. NAME .. '] no plot with your OwnerUserId (' .. tostring(lp.UserId) .. ')')
        return
    end
    local w, b = rollers()
    print('[' .. NAME .. '] plot ' .. p.Name)
    print('[' .. NAME .. '] weapons ' .. tostring(text(w, 'ItemName')) .. ' (' .. tostring(text(w, 'Rarity')) .. ') item=' .. tostring(itemModel(w)))
    print('[' .. NAME .. '] blocks  ' .. tostring(text(b, 'ItemName')) .. ' (' .. tostring(text(b, 'Rarity')) .. ') item=' .. tostring(itemModel(b)))
end)

-- stop ----------------------------------------------------------------

local function stop()
    alive    = false
    running  = false
    autoBoth = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    pcall(keyrelease, VK_E)
    pcall(mouse1release)
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded - open the Rollers tab, menu=' .. tostring(HAS_UI))
