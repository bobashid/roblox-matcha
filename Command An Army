-- Command An Army (place 101770480176177) - Matcha LuauVM
-- Thin loader, renamed by game. The actual ESP source is still the repo file
-- 'BBC ESP' (obfuscated); this file just loads it so the file name matches
-- the game and the Hub has one clean name to point at.
-- Loading this is identical to loading 'BBC ESP' directly.

local NAME    = 'CommandAnArmy'
local VERSION = 'v1.0'
local TARGET  = 'BBC ESP'
local BASE    = 'https://raw.githubusercontent.com/bobashid/roblox-matcha/refs/heads/main/'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION .. ' -> ' .. TARGET)

local function enc(s)
    local e = string.gsub(tostring(s), '%+', '%%2B')
    return (string.gsub(e, ' ', '%%20'))
end

local function stop()
    local env = getgenv and getgenv() or _G
    if env.SquadESP_Cleanup then
        pcall(env.SquadESP_Cleanup)
        env.SquadESP_Cleanup = nil
    end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }

local ok, err = pcall(function()
    local src = game:HttpGet(BASE .. enc(TARGET), true)
    local fn = loadstring(src)
    if not fn then error('compile failed') end
    fn()
end)

if not ok then
    warn('[' .. NAME .. '] load failed for ' .. TARGET .. ': ' .. tostring(err))
end
