-- ---- menu ----
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES = {}
local getterWorks = {}

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[PlunderESP] section failed: ' .. name)
    return nil
end

local function mkToggle(sec, id, label, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[PlunderESP] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, id, label, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[PlunderESP] slider failed: ' .. label)
    return false
end

local function registerToggle(key, id, label)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = label }
end

local built = false
local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Players')
        if sec == nil then return end
        mkToggle(sec, 'pl_players', 'Player ESP', CFG.players, function(v) CFG.players = v end)
        registerToggle('players', 'pl_players', 'Player ESP')
        mkToggle(sec, 'pl_self', 'Show Self', CFG.selfEsp, function(v) CFG.selfEsp = v end)
        registerToggle('selfEsp', 'pl_self', 'Show Self')
        mkToggle(sec, 'pl_names', 'Names', CFG.showName, function(v) CFG.showName = v end)
        registerToggle('showName', 'pl_names', 'Names')
        mkToggle(sec, 'pl_dist', 'Distance', CFG.showDist, function(v) CFG.showDist = v end)
        registerToggle('showDist', 'pl_dist', 'Distance')

        local sec2 = mkSection(tab, 'Objects')
        if sec2 then
            mkToggle(sec2, 'pl_items', 'Item ESP', CFG.items, function(v) CFG.items = v end)
            registerToggle('items', 'pl_items', 'Item ESP')
            mkToggle(sec2, 'pl_cont', 'Containers / Safes', CFG.containers, function(v) CFG.containers = v end)
            registerToggle('containers', 'pl_cont', 'Containers / Safes')
            mkToggle(sec2, 'pl_safes', 'Safes Only', CFG.safesOnly, function(v) CFG.safesOnly = v end)
            registerToggle('safesOnly', 'pl_safes', 'Safes Only')
            mkSlider(sec2, 'pl_maxd', 'Max Distance', 50, 2000, CFG.maxDist, function(v) CFG.maxDist = v end)
            mkSlider(sec2, 'pl_trans', 'Transparency', 0, 90, math.floor(CFG.trans * 100), function(v) CFG.trans = v / 100 end)
        end
    end)
    if not ok then warn('[PlunderESP] build error: ' .. tostring(err)) end
    print('[PlunderESP] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Plunder PVP', function(tab)
            print('[PlunderESP] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[PlunderESP] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil then
                    getterWorks[t.key] = true
                    if CFG[t.key] ~= val then
                        CFG[t.key] = val
                        print('[PlunderESP] ' .. t.key .. ' = ' .. tostring(val))
                    end
                end
            end
            task.wait(0.15)
        end
    end)
end

-- ---- stop ----
local function stop()
    if not running then return end
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    for i = 1, #boxPool do
        local e = boxPool[i]
        pcall(function() e.sq:Remove() end)
        pcall(function() e.txt:Remove() end)
        pcall(function() e.dst:Remove() end)
    end
    for i = 1, #markPool do
        pcall(function() markPool[i].txt:Remove() end)
    end
    boxPool, markPool = {}, {}
    if HAS_UI then pcall(function() UI.RemoveTab('Plunder PVP') end) end
    _G[NAME] = nil
    print('[PlunderESP] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }

pcall(function() notify('Plunder PVP', 'v' .. VERSION .. ' loaded', 4) end)
print('[PlunderESP] running - players, items (coins skipped), containers')
