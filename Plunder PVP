local NAME    = 'PlunderESP'
local VERSION = 'v1.3'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[PlunderESP] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}
local function track(c)
    conns[#conns + 1] = c
    return c
end

local myId = nil
pcall(function() myId = lp.UserId end)

-- ---- config ----
local CFG = {
    players    = true,
    selfEsp    = false,
    showName   = true,
    showDist   = true,
    items      = true,
    containers = true,
    safesOnly  = false,
    maxDist    = 400,
    trans      = 0.2,
}

local CONT_MAX = 60

-- ---- helpers ----
local function rgb(r, g, b)
    local ok, c = pcall(function() return Color3.fromRGB(r, g, b) end)
    if ok then return c end
    return nil
end

local COL_BOX   = rgb(0, 255, 140)
local COL_SELF  = rgb(255, 170, 0)
local COL_ITEM  = rgb(255, 210, 0)
local COL_CONT  = rgb(120, 200, 255)
local COL_LOCK  = rgb(255, 90, 90)

local function setCol(obj, c)
    if c ~= nil then pcall(function() obj.Color = c end) end
end

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

local function getAttr(inst, key)
    local ok, v = pcall(function() return inst:GetAttribute(key) end)
    if ok then return v end
    return nil
end

-- ---- name cleaning (world items have no replicated name) ----
local JUNK = {
    handle = true, part = true, meshpart = true, union = true, unionoperation = true,
    cbox = true, door = true, root = true, item = true, model = true, tool = true,
    worlditem = true, coll = true, collision = true, hitbox = true, main = true,
}

-- items the user does not want drawn at all (checked against the resolved label)
local SKIP_LABEL = {
    coin = true, coins = true, ccoin = true, ccoins = true,
    money = true, cash = true, token = true, tokens = true,
}

local function skipLabel(n)
    if n == nil then return false end
    local ln = string.lower(tostring(n))
    if SKIP_LABEL[ln] then return true end
    if string.find(ln, 'coin', 1, true) then return true end
    return false
end

local function isJunk(n)
    if n == nil then return true end
    if type(n) ~= 'string' then return true end
    local ln = string.lower(n)
    if #ln < 2 then return true end
    if JUNK[ln] then return true end
    if string.match(ln, '^%d+$') then return true end
    if string.find(ln, 'tripo_node', 1, true) then return true end
    if string.find(ln, 'worlditem', 1, true) then return true end
    if string.find(ln, 'cbox', 1, true) then return true end
    if string.match(ln, '^%x+$') and #ln >= 6 then return true end
    return false
end

local function cleanName(inst)
    local ok, d = pcall(function() return inst:GetDescendants() end)
    if ok and d then
        for i = 1, #d do
            local x = d[i]
            local cn = x.ClassName
            if cn == 'MeshPart' or cn == 'Part' or cn == 'UnionOperation' then
                if not isJunk(x.Name) then return x.Name end
            end
        end
    end
    if not isJunk(inst.Name) then return inst.Name end
    if inst.ClassName == 'Tool' then return 'Tool' end
    return 'Loot'
end

-- ---- drawing pools (created once, never inside a loop) ----
local HAS_DRAW = type(Drawing) == 'table' and type(Drawing.new) == 'function'
local POOL_BOX, POOL_MARK = 24, 96
local boxPool, markPool = {}, {}

local function hideBox(e)
    if e.sq.Visible then e.sq.Visible = false end
    if e.txt.Visible then e.txt.Visible = false end
    if e.dst.Visible then e.dst.Visible = false end
end

if HAS_DRAW then
    local ok = pcall(function()
        for i = 1, POOL_BOX do
            local e = {}
            e.sq = Drawing.new('Square')
            e.sq.Thickness = 1
            e.sq.Filled = false
            e.sq.Visible = false
            e.txt = Drawing.new('Text')
            e.txt.Size = 14
            e.txt.Center = false
            e.txt.Outline = true
            e.txt.Visible = false
            e.dst = Drawing.new('Text')
            e.dst.Size = 12
            e.dst.Center = true
            e.dst.Outline = true
            e.dst.Visible = false
            boxPool[i] = e
        end
        for i = 1, POOL_MARK do
            local e = {}
            e.txt = Drawing.new('Text')
            e.txt.Size = 13
            e.txt.Center = true
            e.txt.Outline = true
            e.txt.Visible = false
            markPool[i] = e
        end
    end)
    if not ok then
        HAS_DRAW = false
        warn('[PlunderESP] Drawing pool failed - ESP disabled')
    end
end

-- ---- caches ----
local playerList = {}
local itemList   = {}
local contList   = {}

local function scanPlayers()
    local out = {}
    local ids = {}
    local plrs = Players:GetPlayers()
    for i = 1, #plrs do
        local p = plrs[i]
        local uid = nil
        pcall(function() uid = p.UserId end)
        if uid then ids[uid] = p.Name end
    end
    local kids = workspace:GetChildren()
    for i = 1, #kids do
        local m = kids[i]
        if m.ClassName == 'Model' then
            local uid = getAttr(m, 'userid')
            if uid ~= nil then
                local nm = ids[uid]
                if nm then
                    out[#out + 1] = { model = m, name = nm, isSelf = (uid == myId) }
                end
            end
        end
    end
    playerList = out
end

local function firstPart(inst)
    local ok, d = pcall(function() return inst:GetDescendants() end)
    if not ok or not d then return nil end
    local fallback = nil
    for i = 1, #d do
        local x = d[i]
        if x.ClassName == 'MeshPart' or x.ClassName == 'Part' then
            if x.Name ~= 'Handle' then return x end
            if fallback == nil then fallback = x end
        end
    end
    return fallback
end

-- cheap anchor: PrimaryPart, then the interaction attachment, then a Part, then a walk
local function anchorOf(inst)
    local pp = nil
    pcall(function() pp = inst.PrimaryPart end)
    if pp then
        local ok, p = pcall(function() return pp.Position end)
        if ok and p then return p end
    end
    local okA, a = pcall(function() return inst:FindFirstChild('ContainerInteractionPoint') end)
    if okA and a then
        local okW, w = pcall(function() return a.WorldPosition end)
        if okW and w then return w end
    end
    local okB, p2 = pcall(function() return inst:FindFirstChild('Part') end)
    if okB and p2 then
        local ok2, pos = pcall(function() return p2.Position end)
        if ok2 and pos then return pos end
    end
    local bp = firstPart(inst)
    if bp then
        local ok3, p3 = pcall(function() return bp.Position end)
        if ok3 and p3 then return p3 end
    end
    return nil
end

local function scanItems()
    local out = {}
    local gs = workspace:FindFirstChild('GameSystem')
    local wi = gs and gs:FindFirstChild('WorldItem')
    if wi then
        local kids = wi:GetChildren()
        for i = 1, #kids do
            local c = kids[i]
            local pos = anchorOf(c)
            if pos then
                local lbl = cleanName(c)
                if not skipLabel(lbl) then
                    out[#out + 1] = { pos = pos, label = lbl }
                end
            end
        end
    end
    itemList = out
end

-- containers: Workspace.GameArea.SpaceCenter.Container (160 children, 20 kinds)
local contFolder = nil
local function findContainerFolder()
    local ga = workspace:FindFirstChild('GameArea')
    local sc = ga and ga:FindFirstChild('SpaceCenter')
    local c = sc and sc:FindFirstChild('Container')
    if c then return c end
    local ok, d = pcall(function() return workspace:GetDescendants() end)
    if ok and d then
        for i = 1, #d do
            local x = d[i]
            if x.ClassName == 'Folder' and x.Name == 'Container' and #x:GetChildren() > 20 then
                return x
            end
        end
    end
    return nil
end

local function scanContainers()
    local out = {}
    if contFolder == nil or contFolder.Parent == nil then
        contFolder = findContainerFolder()
    end
    if contFolder == nil then
        contList = out
        return
    end
    local ref = nil
    pcall(function()
        local ch = lp.Character
        local hrp = ch and ch:FindFirstChild('HumanoidRootPart')
        if hrp then ref = hrp.Position end
    end)
    local kids = contFolder:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        local nm = c.Name
        if (not CFG.safesOnly) or string.find(string.lower(nm), 'safe', 1, true) then
            local pos = anchorOf(c)
            if pos then
                local d2 = 0
                if ref then
                    local dx, dy, dz = pos.X - ref.X, pos.Y - ref.Y, pos.Z - ref.Z
                    d2 = dx * dx + dy * dy + dz * dz
                end
                out[#out + 1] = {
                    pos = pos,
                    name = nm,
                    locked = getAttr(c, 'SafeLocked'),
                    opened = getAttr(c, 'ContainerOpened'),
                    d2 = d2,
                }
            end
        end
    end
    table.sort(out, function(a, b) return a.d2 < b.d2 end)
    while #out > CONT_MAX do
        table.remove(out)
    end
    contList = out
end

-- ---- renderer (reads caches only) ----
local function camPos()
    local p = nil
    pcall(function() p = workspace.CurrentCamera.CFrame.Position end)
    return p
end

local function drawPlayers()
    local used = 0
    local cp = camPos()
    if cp == nil then return end
    local maxD = CFG.maxDist
    for i = 1, #playerList do
        if used >= POOL_BOX then break end
        local t = playerList[i]
        if CFG.players and (CFG.selfEsp or t.isSelf ~= true) then
            local head, hrp = nil, nil
            pcall(function()
                head = t.model:FindFirstChild('Head')
                hrp = t.model:FindFirstChild('HumanoidRootPart')
            end)
            if head and hrp then
                local hp, hs, rp = nil, nil, nil
                pcall(function() hp = head.Position end)
                pcall(function() hs = head.Size end)
                pcall(function() rp = hrp.Position end)
                if hp and hs and rp then
                    local mid = Vector3.new(rp.X, (hp.Y + rp.Y) / 2, rp.Z)
                    local top = Vector3.new(hp.X, hp.Y + hs.Y / 2, hp.Z)
                    local bot = Vector3.new(rp.X, rp.Y - 2.2, rp.Z)
                    local d = 0
                    pcall(function() d = (mid - cp).Magnitude end)
                    if d <= maxD then
                        local okA, sc, onA = pcall(function() return WorldToScreen(mid) end)
                        local okB, st, onB = pcall(function() return WorldToScreen(top) end)
                        local okC, sb, onC = pcall(function() return WorldToScreen(bot) end)
                        if onA and onB and onC and sc and st and sb then
                            local h = sb.Y - st.Y
                            if h >= 4 and h <= 2000 then
                                local w = h * 0.55
                                used = used + 1
                                local e = boxPool[used]
                                local x = sc.X - w / 2
                                local y = st.Y
                                local col = (t.isSelf and COL_SELF) or COL_BOX
                                e.sq.Visible = true
                                e.sq.Position = Vector2.new(x, y)
                                e.sq.Size = Vector2.new(w, h)
                                e.sq.Transparency = CFG.trans
                                setCol(e.sq, col)
                                e.txt.Visible = CFG.showName
                                if CFG.showName then
                                    e.txt.Text = t.name
                                    e.txt.Position = Vector2.new(x, y - 18)
                                    e.txt.Transparency = CFG.trans
                                    setCol(e.txt, col)
                                end
                                e.dst.Visible = CFG.showDist
                                if CFG.showDist then
                                    e.dst.Text = tostring(math.floor(d)) .. 'm'
                                    e.dst.Position = Vector2.new(sc.X, y + h + 2)
                                    e.dst.Transparency = CFG.trans
                                    setCol(e.dst, col)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    for i = used + 1, POOL_BOX do hideBox(boxPool[i]) end
end

local function drawMarks()
    local used = 0
    local cp = camPos()
    if cp == nil then return end

    if CFG.items then
        for i = 1, #itemList do
            if used >= POOL_MARK then break end
            local t = itemList[i]
            local d = 0
            pcall(function() d = (t.pos - cp).Magnitude end)
            if d <= CFG.maxDist then
                local ok, sp, on = pcall(function() return WorldToScreen(t.pos) end)
                if on and sp then
                    used = used + 1
                    local e = markPool[used]
                    e.txt.Visible = true
                    e.txt.Text = t.label .. ' [' .. tostring(math.floor(d)) .. 'm]'
                    e.txt.Position = Vector2.new(sp.X, sp.Y)
                    e.txt.Transparency = CFG.trans
                    setCol(e.txt, COL_ITEM)
                end
            end
        end
    end

    if CFG.containers then
        for i = 1, #contList do
            if used >= POOL_MARK then break end
            local t = contList[i]
            local d = 0
            pcall(function() d = (t.pos - cp).Magnitude end)
            if d <= CFG.maxDist then
                local ok, sp, on = pcall(function() return WorldToScreen(t.pos) end)
                if on and sp then
                    used = used + 1
                    local e = markPool[used]
                    local label = t.name .. ' [' .. tostring(math.floor(d)) .. 'm]'
                    local col = COL_CONT
                    if t.locked == true then
                        label = label .. ' LOCKED'
                        col = COL_LOCK
                    end
                    e.txt.Visible = true
                    e.txt.Text = label
                    e.txt.Position = Vector2.new(sp.X, sp.Y)
                    e.txt.Transparency = CFG.trans
                    setCol(e.txt, col)
                end
            end
        end
    end

    for i = used + 1, POOL_MARK do
        local e = markPool[i]
        if e.txt.Visible then e.txt.Visible = false end
    end
end

