--[[
  Game:       Plunder [PVP]          (game.Name reports 'Ugc'; title supplied by the user)
  Place IDs:  85646026816836
  Version:    v1.1
  Features:   player ESP (box, name, distance), item ESP, loot container ESP
  Controls:   menu tab "Plunder PVP"; toggles plus two sliders
  Needs:      Matcha Pro (UI + Drawing)
  Confirmed:  players are Workspace Models named R15Rig carrying a numeric 'userid' attribute
  Confirmed:  local UserId is 2251313101; NPC rigs carry a negative 'userid'
  Confirmed:  Model:GetBoundingBox and GetExtentsSize are nil here, so the box is built from Head + HumanoidRootPart
  Confirmed:  items live in Workspace.GameSystem.WorldItem (42 children, Tools and Models)
  Confirmed:  loot containers live in Workspace.GameScene.Container (113 children)
  UNVERIFIED: item display names - the WorldItem tools have no ItemName child, so a part or instance name is shown
  Renamed:    was 'Pulse Fitness Club' v1.0; logic unchanged, names and tab updated
]]

local NAME    = 'PlunderESP'
local VERSION = 'v1.1'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[PlunderESP] ' .. VERSION)

local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local lp         = Players.LocalPlayer

local running = true
local conns   = {}
local function track(c)
    conns[#conns + 1] = c
    return c
end

local myId = nil
pcall(function() myId = lp.UserId end)

-- ---- config ----
local CFG = {
    players    = true,
    selfEsp    = false,
    showName   = true,
    showDist   = true,
    items      = true,
    containers = false,
    maxDist    = 400,
    trans      = 0.2,
}

-- ---- helpers ----
local function rgb(r, g, b)
    local ok, c = pcall(function() return Color3.fromRGB(r, g, b) end)
    if ok then return c end
    return nil
end

local COL_BOX  = rgb(0, 255, 140)
local COL_SELF = rgb(255, 170, 0)
local COL_ITEM = rgb(255, 210, 0)
local COL_CONT = rgb(120, 200, 255)

local function setCol(obj, c)
    if c ~= nil then pcall(function() obj.Color = c end) end
end

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function firstNumber(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'number' then return v end
    end
    return nil
end

-- ---- drawing pools (created once, never inside a loop) ----
local HAS_DRAW = type(Drawing) == 'table' and type(Drawing.new) == 'function'
local POOL_BOX, POOL_ITEM = 24, 40
local boxPool, itemPool = {}, {}

local function hideBox(e)
    if e.sq.Visible then e.sq.Visible = false end
    if e.txt.Visible then e.txt.Visible = false end
    if e.dst.Visible then e.dst.Visible = false end
end

if HAS_DRAW then
    local ok = pcall(function()
        for i = 1, POOL_BOX do
            local e = {}
            e.sq = Drawing.new('Square')
            e.sq.Thickness = 1
            e.sq.Filled = false
            e.sq.Visible = false
            e.txt = Drawing.new('Text')
            e.txt.Size = 14
            e.txt.Center = false
            e.txt.Outline = true
            e.txt.Visible = false
            e.dst = Drawing.new('Text')
            e.dst.Size = 12
            e.dst.Center = true
            e.dst.Outline = true
            e.dst.Visible = false
            boxPool[i] = e
        end
        for i = 1, POOL_ITEM do
            local e = {}
            e.txt = Drawing.new('Text')
            e.txt.Size = 13
            e.txt.Center = true
            e.txt.Outline = true
            e.txt.Visible = false
            itemPool[i] = e
        end
    end)
    if not ok then
        HAS_DRAW = false
        warn('[PlunderESP] Drawing pool failed - ESP disabled')
    end
end

-- ---- caches ----
local playerList = {}
local itemList   = {}
local contList   = {}

local function scanPlayers()
    local out = {}
    local ids = {}
    local plrs = Players:GetPlayers()
    for i = 1, #plrs do
        local p = plrs[i]
        local uid = nil
        pcall(function() uid = p.UserId end)
        if uid then ids[uid] = p.Name end
    end
    local kids = workspace:GetChildren()
    for i = 1, #kids do
        local m = kids[i]
        if m.ClassName == 'Model' then
            local uid = nil
            pcall(function() uid = m:GetAttribute('userid') end)
            if uid ~= nil then
                local nm = ids[uid]
                if nm then
                    out[#out + 1] = { model = m, name = nm, isSelf = (uid == myId) }
                end
            end
        end
    end
    playerList = out
end

local function firstPart(inst)
    local ok, d = pcall(function() return inst:GetDescendants() end)
    if not ok or not d then return nil end
    local fallback = nil
    for i = 1, #d do
        local x = d[i]
        if x.ClassName == 'MeshPart' or x.ClassName == 'Part' then
            if x.Name ~= 'Handle' then return x end
            if fallback == nil then fallback = x end
        end
    end
    return fallback
end

local function labelFor(inst, part)
    if part ~= nil then
        local n = part.Name
        if n ~= nil and n ~= '' and n ~= 'Handle' and n ~= 'Root' then
            if not string.match(n, '^%d+$') then return n end
        end
    end
    return inst.Name
end

local function scanItems()
    local out = {}
    local gs = workspace:FindFirstChild('GameSystem')
    local wi = gs and gs:FindFirstChild('WorldItem')
    if wi then
        local kids = wi:GetChildren()
        for i = 1, #kids do
            local c = kids[i]
            local part = firstPart(c)
            if part then
                local pos = nil
                pcall(function() pos = part.Position end)
                if pos then
                    out[#out + 1] = { pos = pos, label = labelFor(c, part) }
                end
            end
        end
    end
    itemList = out
end

local function scanContainers()
    local out = {}
    local gsc = workspace:FindFirstChild('GameScene')
    local cont = gsc and gsc:FindFirstChild('Container')
    if cont then
        local kids = cont:GetChildren()
        for i = 1, #kids do
            local c = kids[i]
            local part = firstPart(c)
            if part then
                local pos = nil
                pcall(function() pos = part.Position end)
                if pos then out[#out + 1] = { pos = pos, label = c.Name } end
            end
        end
    end
    contList = out
end

-- ---- renderer (reads caches only) ----
local function drawPlayers()
    local used = 0
    local camPos = nil
    pcall(function() camPos = workspace.CurrentCamera.CFrame.Position end)
    if camPos == nil then return end
    local maxD = CFG.maxDist
    for i = 1, #playerList do
        if used >= POOL_BOX then break end
        local t = playerList[i]
        if CFG.players and (CFG.selfEsp or t.isSelf ~= true) then
            local head, hrp = nil, nil
            pcall(function()
                head = t.model:FindFirstChild('Head')
                hrp = t.model:FindFirstChild('HumanoidRootPart')
            end)
            if head and hrp then
                local hp, hs, rp = nil, nil, nil
                pcall(function() hp = head.Position end)
                pcall(function() hs = head.Size end)
                pcall(function() rp = hrp.Position end)
                if hp and hs and rp then
                    local mid = Vector3.new(rp.X, (hp.Y + rp.Y) / 2, rp.Z)
                    local top = Vector3.new(hp.X, hp.Y + hs.Y / 2, hp.Z)
                    local bot = Vector3.new(rp.X, rp.Y - 2.2, rp.Z)
                    local d = 0
                    pcall(function() d = (mid - camPos).Magnitude end)
                    if d <= maxD then
                        local okA, sc, onA = pcall(function() return WorldToScreen(mid) end)
                        local okB, st, onB = pcall(function() return WorldToScreen(top) end)
                        local okC, sb, onC = pcall(function() return WorldToScreen(bot) end)
                        if onA and onB and onC and sc and st and sb then
                            local h = sb.Y - st.Y
                            if h >= 4 and h <= 2000 then
                                local w = h * 0.55
                                used = used + 1
                                local e = boxPool[used]
                                local x = sc.X - w / 2
                                local y = st.Y
                                e.sq.Visible = true
                                e.sq.Position = Vector2.new(x, y)
                                e.sq.Size = Vector2.new(w, h)
                                e.sq.Transparency = CFG.trans
                                setCol(e.sq, (t.isSelf and COL_SELF) or COL_BOX)
                                e.txt.Visible = CFG.showName
                                if CFG.showName then
                                    e.txt.Text = t.name
                                    e.txt.Position = Vector2.new(x, y - 18)
                                    e.txt.Transparency = CFG.trans
                                    setCol(e.txt, (t.isSelf and COL_SELF) or COL_BOX)
                                end
                                e.dst.Visible = CFG.showDist
                                if CFG.showDist then
                                    e.dst.Text = tostring(math.floor(d)) .. 'm'
                                    e.dst.Position = Vector2.new(sc.X, y + h + 2)
                                    e.dst.Transparency = CFG.trans
                                    setCol(e.dst, (t.isSelf and COL_SELF) or COL_BOX)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    for i = used + 1, POOL_BOX do hideBox(boxPool[i]) end
end

local function drawMarks()
    local used = 0
    local camPos = nil
    pcall(function() camPos = workspace.CurrentCamera.CFrame.Position end)
    if camPos == nil then return end

    local function pass(list, flag, col)
        if not flag then return end
        for i = 1, #list do
            if used >= POOL_ITEM then return end
            local t = list[i]
            local p = t.pos
            if p then
                local d = 0
                pcall(function() d = (p - camPos).Magnitude end)
                if d <= CFG.maxDist then
                    local ok, sp, on = pcall(function() return WorldToScreen(p) end)
                    if on and sp then
                        used = used + 1
                        local e = itemPool[used]
                        e.txt.Visible = true
                        e.txt.Text = t.label .. ' [' .. tostring(math.floor(d)) .. 'm]'
                        e.txt.Position = Vector2.new(sp.X, sp.Y)
                        e.txt.Transparency = CFG.trans
                        setCol(e.txt, col)
                    end
                end
            end
        end
    end

    pass(itemList, CFG.items, COL_ITEM)
    pass(contList, CFG.containers, COL_CONT)

    for i = used + 1, POOL_ITEM do
        local e = itemPool[i]
        if e.txt.Visible then e.txt.Visible = false end
    end
end

-- ---- scanners ----
task.spawn(function()
    while running do
        pcall(scanPlayers)
        if CFG.items then pcall(scanItems) end
        if CFG.containers then pcall(scanContainers) end
        task.wait(0.5)
    end
end)

if HAS_DRAW then
    track(RunService.RenderStepped:Connect(function()
        if not running then return end
        pcall(drawPlayers)
        pcall(drawMarks)
    end))
end

-- ---- menu ----
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local TOGGLES = {}
local getterWorks = {}

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    warn('[PlunderESP] section failed: ' .. name)
    return nil
end

local function mkToggle(sec, id, label, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[PlunderESP] toggle failed: ' .. label)
    return false
end

local function mkSlider(sec, id, label, min, max, default, apply)
    local cb = function(...)
        local v = firstNumber(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:SliderInt(id, label, min, max, default, cb) end,
        function() sec:SliderInt(label, id, min, max, default, cb) end,
        function() sec:SliderInt(label, min, max, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[PlunderESP] slider failed: ' .. label)
    return false
end

local function registerToggle(key, id, label)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = label }
end

local built = false
local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Players')
        if sec == nil then return end
        mkToggle(sec, 'pl_players', 'Player ESP', CFG.players, function(v) CFG.players = v end)
        registerToggle('players', 'pl_players', 'Player ESP')
        mkToggle(sec, 'pl_self', 'Show Self', CFG.selfEsp, function(v) CFG.selfEsp = v end)
        registerToggle('selfEsp', 'pl_self', 'Show Self')
        mkToggle(sec, 'pl_names', 'Names', CFG.showName, function(v) CFG.showName = v end)
        registerToggle('showName', 'pl_names', 'Names')
        mkToggle(sec, 'pl_dist', 'Distance', CFG.showDist, function(v) CFG.showDist = v end)
        registerToggle('showDist', 'pl_dist', 'Distance')

        local sec2 = mkSection(tab, 'Objects')
        if sec2 then
            mkToggle(sec2, 'pl_items', 'Item ESP', CFG.items, function(v) CFG.items = v end)
            registerToggle('items', 'pl_items', 'Item ESP')
            mkToggle(sec2, 'pl_cont', 'Loot Containers', CFG.containers, function(v) CFG.containers = v end)
            registerToggle('containers', 'pl_cont', 'Loot Containers')
            mkSlider(sec2, 'pl_maxd', 'Max Distance', 50, 2000, CFG.maxDist, function(v) CFG.maxDist = v end)
            mkSlider(sec2, 'pl_trans', 'Transparency', 0, 90, math.floor(CFG.trans * 100), function(v) CFG.trans = v / 100 end)
        end
    end)
    if not ok then warn('[PlunderESP] build error: ' .. tostring(err)) end
    print('[PlunderESP] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Plunder PVP', function(tab)
            print('[PlunderESP] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[PlunderESP] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil then
                    getterWorks[t.key] = true
                    if CFG[t.key] ~= val then
                        CFG[t.key] = val
                        print('[PlunderESP] ' .. t.key .. ' = ' .. tostring(val))
                    end
                end
            end
            task.wait(0.15)
        end
    end)
end

-- ---- stop ----
local function stop()
    if not running then return end
    running = false
    for i = 1, #conns do
        pcall(function() conns[i]:Disconnect() end)
    end
    conns = {}
    for i = 1, #boxPool do
        local e = boxPool[i]
        pcall(function() e.sq:Remove() end)
        pcall(function() e.txt:Remove() end)
        pcall(function() e.dst:Remove() end)
    end
    for i = 1, #itemPool do
        pcall(function() itemPool[i].txt:Remove() end)
    end
    boxPool, itemPool = {}, {}
    if HAS_UI then pcall(function() UI.RemoveTab('Plunder PVP') end) end
    _G[NAME] = nil
    print('[PlunderESP] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }

pcall(function() notify('Plunder PVP', 'v' .. VERSION .. ' loaded', 4) end)
print('[PlunderESP] running - player ESP and item ESP')
