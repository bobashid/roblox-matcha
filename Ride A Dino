--==================================================================
--  Ride A Dino  |  one toggle: Auto Gain Energy (hold still)
--  Matcha LuaVM  -  built-in Matcha menu tab (UI.AddTab)
--
--  Same idea as the seat trick in Feed A Mosquito: the game only
--  pays out energy while you are stationary, so this simply holds
--  you exactly where you are.
--
--  WHAT THE TOGGLE DOES
--    On:  saves your HumanoidRootPart CFrame, then every render
--         frame writes it back and zeroes both velocities, so the
--         game keeps seeing you standing still and energy ticks.
--    Off: stops writing, you move normally again. Nothing else is
--         touched - no deposit, no teleport, no remotes.
--    Respawn: the spot is re-captured where the new character
--         spawns, so it keeps working without a re-toggle.
--
--  Checked this session (place 93523763376122):
--   - Workspace has no Seat / VehicleSeat, and Humanoid.Sit and
--     Humanoid.SeatPart both read nil, so there is no seat to sit
--     in - holding the root CFrame is the equivalent.
--
--  Stop with _G.RideADino.stop().
--==================================================================
local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')

local LP      = Players.LocalPlayer
local NAME    = 'RideADino'
local VERSION = 'v1.2'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local running = true
local conns   = {}

local function track(c) conns[#conns + 1] = c return c end

local Config = { Still = true }

local spot     = nil
local heldChar = nil
local holding  = false

-- ---- ui helpers -------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local TOGGLES = {}
local getterWorks = {}

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local v = firstBool(...)
        if v ~= nil then Config[key] = v end
    end
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

-- ---- hold still -------------------------------------------------
local function rootPart()
    local char = LP.Character
    return char and char:FindFirstChild('HumanoidRootPart') or nil
end

local function captureSpot()
    local hrp = rootPart()
    if not hrp then return false end
    local ok, cf = pcall(function() return hrp.CFrame end)
    if not ok or cf == nil then return false end
    spot     = cf
    heldChar = LP.Character
    return true
end

local function releaseSpot()
    spot     = nil
    heldChar = nil
    holding  = false
end

track(RunService.RenderStepped:Connect(function()
    if not running or not Config.Still then return end

    local hrp = rootPart()
    if not hrp then return end

    -- new character: grab the spot it spawned at instead of yanking
    -- it back to where the last life was standing
    if LP.Character ~= heldChar then
        local ok, cf = pcall(function() return hrp.CFrame end)
        if ok and cf ~= nil then spot = cf end
        heldChar = LP.Character
        holding  = false
        return
    end

    if not spot then
        if captureSpot() then
            print('[' .. NAME .. '] holding position (energy)')
        end
        return
    end

    local ok = pcall(function()
        hrp.CFrame                  = spot
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)

    if ok and not holding then
        holding = true
        print('[' .. NAME .. '] holding still - energy should tick')
    end
end))

-- ---- menu -------------------------------------------------------
local tabBuilt = false

local function buildTab(tab)
    if tabBuilt then return end
    tabBuilt = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Farm')
        if not sec then return end
        if mkToggle(sec, 'Auto Gain Energy (hold still)', 'rad_still', true, applyBool('Still')) then
            registerToggle('Still', 'rad_still', 'Auto Gain Energy (hold still)')
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Ride a Dino', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- toggle poller ----------------------------------------------
task.spawn(function()
    local was = Config.Still

    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil
            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == 'boolean' then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == 'boolean' then val = v2 end
            end
            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
        end

        if Config.Still ~= was then
            was = Config.Still
            if Config.Still then
                if captureSpot() then
                    print('[' .. NAME .. '] energy hold on (spot saved)')
                else
                    print('[' .. NAME .. '] energy hold on - waiting for a character')
                end
            else
                releaseSpot()
                print('[' .. NAME .. '] energy hold off')
            end
        end

        task.wait(0.15)
    end
end)

-- ---- stop -------------------------------------------------------
local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    releaseSpot()
    if HAS_UI then pcall(function() UI.RemoveTab('Ride a Dino') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] loaded ' .. VERSION)
pcall(function() notify('Ride a Dino', 'Loaded ' .. VERSION, 4) end)
