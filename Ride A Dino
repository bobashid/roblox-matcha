--==================================================================
--  Ride A Dino  |  one toggle: Auto Gain Energy
--  Matcha LuaVM  -  built-in Matcha menu tab (UI.AddTab)
--
--  Confirmed in game this session (place 93523763376122):
--   - Own plot: Workspace.Pens.<Plot> where
--       plot:GetAttribute('Owner') == LocalPlayer.UserId
--     (read from the game's own HUD.Deposit module)
--   - Deposit prompt: plot.Sign.PenDepositPrompt
--   - Pen floor:      plot.Floor   (used for the fallback hop)
--   - Carried dino:   character child named 'CarriedDino'
--     (the game checks exactly this name before depositing)
--
--  WHAT THE TOGGLE DOES
--    While you carry a dino it fires your pen's deposit prompt so the
--    pen income keeps ticking. If two prompt fires do not take it, it
--    hops to the pen, fires again, and puts you straight back where
--    you were.
--
--  Stop with _G.RideADino.stop().
--==================================================================
local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')
local WS         = game:GetService('Workspace')

local LP      = Players.LocalPlayer
local NAME    = 'RideADino'
local VERSION = 'v1.1'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local running  = true
local conns    = {}
local drawings = {}

local function track(c) conns[#conns + 1] = c return c end

local Config = { Gain = true }

local DEPOSIT_COOLDOWN = 1.0
local TP_HOVER         = 4

-- ---- ui helpers -------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local TOGGLES = {}
local getterWorks = {}

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local v = firstBool(...)
        if v ~= nil then Config[key] = v end
    end
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

-- ---- game helpers ----------------------------------------------
local warnedPrompt = false

local function firePrompt(prompt)
    if not prompt then return false end
    if type(fireproximityprompt) ~= 'function' then
        if not warnedPrompt then
            warnedPrompt = true
            warn('[' .. NAME .. '] fireproximityprompt missing - re-run the Matcha loader')
        end
        return false
    end
    local ok = pcall(fireproximityprompt, prompt)
    return ok
end

local function myPlot()
    local pens = WS:FindFirstChild('Pens')
    if not pens then return nil end
    local kids = pens:GetChildren()
    for i = 1, #kids do
        local plot = kids[i]
        local ok, owner = pcall(function() return plot:GetAttribute('Owner') end)
        if ok and owner ~= nil and owner == LP.UserId then return plot end
    end
    return nil
end

local function depositPrompt(plot)
    if not plot then return nil end
    local sign = plot:FindFirstChild('Sign')
    if not sign then return nil end
    return sign:FindFirstChild('PenDepositPrompt')
end

local function carryingDino()
    local char = LP.Character
    if not char then return false end
    local ok, c = pcall(function() return char:FindFirstChild('CarriedDino') end)
    return ok and c ~= nil
end

local function rootPart()
    local char = LP.Character
    return char and char:FindFirstChild('HumanoidRootPart') or nil
end

local function deposit()
    local plot   = myPlot()
    local prompt = depositPrompt(plot)
    if not prompt then return false end

    firePrompt(prompt)
    task.wait(0.20)
    if not carryingDino() then return true end

    firePrompt(prompt)
    task.wait(0.25)
    if not carryingDino() then return true end

    -- still carrying: hop to the pen, fire, hop back
    local hrp   = rootPart()
    local floor = plot:FindFirstChild('Floor')
    if not (hrp and floor) then return false end

    local okPos, fp = pcall(function() return floor.Position end)
    if not okPos or not fp then return false end

    local home = hrp.CFrame
    pcall(function() hrp.CFrame = CFrame.new(fp.X, fp.Y + TP_HOVER, fp.Z) end)
    task.wait(0.20)
    firePrompt(prompt)
    task.wait(0.15)
    firePrompt(prompt)
    task.wait(0.12)
    pcall(function() hrp.CFrame = home end)

    print('[' .. NAME .. '] deposit hop used (back at start)')
    return true
end

-- ---- menu ------------------------------------------------------
local tabBuilt = false

local function buildTab(tab)
    if tabBuilt then return end
    tabBuilt = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Farm')
        if not sec then return end
        if mkToggle(sec, 'Auto Gain Energy', 'rad_gain', true, applyBool('Gain')) then
            registerToggle('Gain', 'rad_gain', 'Auto Gain Energy')
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Ride a Dino', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- toggle poller (getter is authoritative once it answers) ----
task.spawn(function()
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil
            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == 'boolean' then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == 'boolean' then val = v2 end
            end
            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
        end
        task.wait(0.15)
    end
end)

-- ---- the one loop ----------------------------------------------
task.spawn(function()
    local lastAt  = 0
    local wasOn   = false
    local saidNone = false
    while running do
        if Config.Gain then
            local now = os.clock()
            if carryingDino() then
                saidNone = false
                if (now - lastAt) >= DEPOSIT_COOLDOWN then
                    lastAt = now
                    if not wasOn then
                        wasOn = true
                        print('[' .. NAME .. '] auto gain energy on')
                    end
                    local okd = deposit()
                    if not okd then
                        print('[' .. NAME .. '] deposit prompt not found on your plot')
                    end
                end
            elseif not saidNone then
                saidNone = true
                print('[' .. NAME .. '] waiting for a dino in hand')
            end
        else
            if wasOn then
                wasOn = false
                print('[' .. NAME .. '] auto gain energy off')
            end
            lastAt   = 0
            saidNone = false
        end
        task.wait(0.25)
    end
end)

-- ---- stop ------------------------------------------------------
local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    for i = 1, #drawings do pcall(function() drawings[i]:Remove() end) end
    drawings = {}
    if HAS_UI then pcall(function() UI.RemoveTab('Ride a Dino') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] loaded ' .. VERSION)
pcall(function() notify('Ride a Dino', 'Loaded ' .. VERSION, 4) end)
