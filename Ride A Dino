--==================================================================
--  Ride A Dino  |  one toggle: Always Gain Stamina
--  Matcha LuaVM  -  built-in Matcha menu tab (UI.AddTab)
--
--  Same method as Feed A Mosquito's "Hide Under Farm":
--    - anchor every BasePart of your character
--    - rewrite HumanoidRootPart.CFrame every render frame
--    - zero both velocities every frame
--  The game then always sees you at rest / seated, so the stamina
--  that the saddle seat gives you keeps regenerating from anywhere.
--
--  Checked this session (place 93523763376122):
--   - The "seat" is a dino saddle (MountSeat / SeatSurface Attachments).
--     There is no real Seat/VehicleSeat and Humanoid.Sit reads nil, so
--     physically sitting is not how we reproduce it.
--   - Stamina/grip is server-pushed through the Net "Stats" channel;
--     there is no client-readable stamina value and no client function
--     that grants it. That is why the at-rest hold is the working route
--     (client memory / applygc would only change the local copy).
--
--  Nothing else is touched: no deposit, no remotes, no teleport.
--  Stop with _G.RideADino.stop().
--==================================================================
local Players    = game:GetService('Players')
local RunService = game:GetService('RunService')

local LP      = Players.LocalPlayer
local NAME    = 'RideADino'
local VERSION = 'v1.3'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local running = true
local conns   = {}

local function track(c) conns[#conns + 1] = c return c end

local Config = { Gain = true }

local spot     = nil
local heldChar = nil
local anchored = {}
local saidOn   = false

-- ---- ui helpers -------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local TOGGLES = {}
local getterWorks = {}

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local v = firstBool(...)
        if v ~= nil then Config[key] = v end
    end
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

-- ---- at-rest hold (Feed A Mosquito method) ----------------------
local function rootPart()
    local c = LP.Character
    return c and c:FindFirstChild('HumanoidRootPart') or nil
end

local function isPart(p)
    local cn = p.ClassName
    return cn == 'Part' or cn == 'MeshPart' or cn == 'UnionOperation'
        or cn == 'WedgePart' or cn == 'CornerWedgePart' or cn == 'TrussPart'
        or cn == 'SpawnLocation'
end

local function unanchorAll()
    for i = 1, #anchored do
        local e = anchored[i]
        if e.part then pcall(function() e.part.Anchored = e.was end) end
    end
    anchored = {}
end

local function anchorAll(char)
    if not char then return end
    local ok, desc = pcall(function() return char:GetDescendants() end)
    if not ok or not desc then return end
    for i = 1, #desc do
        local d = desc[i]
        if isPart(d) then
            local okA, was = pcall(function() return d.Anchored end)
            anchored[#anchored + 1] = { part = d, was = (okA and was == true) }
            pcall(function() d.Anchored = true end)
        end
    end
end

local function captureSpot()
    local hrp = rootPart()
    if not hrp then return false end
    local ok, cf = pcall(function() return hrp.CFrame end)
    if not ok or cf == nil then return false end
    spot     = cf
    heldChar = LP.Character
    return true
end

local function releaseHold()
    unanchorAll()
    spot     = nil
    heldChar = nil
    saidOn   = false
end

track(RunService.RenderStepped:Connect(function()
    if not running or not Config.Gain then return end

    local char = LP.Character
    local hrp  = rootPart()

    if not (char and hrp) then
        if heldChar then unanchorAll() end
        heldChar = nil
        spot     = nil
        return
    end

    -- new life: drop the old anchors, grab where we spawned, re-anchor
    if char ~= heldChar then
        unanchorAll()
        local ok, cf = pcall(function() return hrp.CFrame end)
        if ok and cf ~= nil then spot = cf end
        heldChar = char
        anchorAll(char)
        return
    end

    if not spot then
        if captureSpot() then anchorAll(char) end
        return
    end

    pcall(function()
        hrp.CFrame                  = spot
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)

    if not saidOn then
        saidOn = true
        print('[' .. NAME .. '] holding still - stamina should regen')
    end
end))

-- ---- menu -------------------------------------------------------
local tabBuilt = false

local function buildTab(tab)
    if tabBuilt then return end
    tabBuilt = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Stamina')
        if not sec then return end
        if mkToggle(sec, 'Always Gain Stamina', 'rad_gain', true, applyBool('Gain')) then
            registerToggle('Gain', 'rad_gain', 'Always Gain Stamina')
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Ride a Dino', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- toggle poller ----------------------------------------------
task.spawn(function()
    local was = Config.Gain

    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil
            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == 'boolean' then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == 'boolean' then val = v2 end
            end
            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
        end

        if Config.Gain ~= was then
            was = Config.Gain
            if Config.Gain then
                if captureSpot() then
                    anchorAll(LP.Character)
                    print('[' .. NAME .. '] stamina hold on (spot saved, anchored)')
                else
                    print('[' .. NAME .. '] stamina hold on - waiting for a character')
                end
            else
                releaseHold()
                print('[' .. NAME .. '] stamina hold off')
            end
        end

        task.wait(0.15)
    end
end)

-- ---- stop -------------------------------------------------------
local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    releaseHold()
    if HAS_UI then pcall(function() UI.RemoveTab('Ride a Dino') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] loaded ' .. VERSION)
pcall(function() notify('Ride a Dino', 'Loaded ' .. VERSION, 4) end)
