--==================================================================
--  Ride A Dino  |  one toggle: Always Gain Stamina
--  Matcha LuaVM  -  built-in Matcha menu tab (UI.AddTab)
--
--  HOW IT WORKS  (same route as Feed A Mosquito)
--    Feed A Mosquito worked by firing the game's OWN interaction
--    (fireproximityprompt / firetouchinterest), not by faking physics.
--    In Ride A Dino the interaction that grants stamina is the dino's
--    saddle: the MountDinosaur ProximityPrompt on your plot's dino.
--
--    Toggle on  -> find a MountDinosaur prompt on your own plot and
--                  fire it with fireproximityprompt (Pro, bypasses
--                  range, so it works from anywhere on the map).
--    Every 1 s  -> re-fire ONLY if you look unmounted. It never fires
--                  while you are mounted, so it cannot dismount you.
--    Toggle off -> stops firing. Nothing else happens: no dismount, no
--                  teleport, no remote, no CFrame writes.
--
--  Checked this session (place 93523763376122):
--   - Own plot: Workspace.Pens.<Plot> with
--       plot:GetAttribute('Owner') == LocalPlayer.UserId  (Plot1 here)
--   - Prompt:  plot.Dinos.Slot_XX.Root.MountInteraction.MountDinosaur
--   - fireproximityprompt exists and returns true on that prompt.
--   - The "seat" is a saddle (MountSeat / SeatSurface Attachments);
--     there is no Seat/VehicleSeat and Humanoid.Sit reads nil, so
--     mounted is detected by the mount prompt's own child disappearing
--     and by a CarriedDino / seat weld under the character.
--
--  Stop with _G.RideADino.stop().
--==================================================================
local Players    = game:GetService('Players')

local LP      = Players.LocalPlayer
local NAME    = 'RideADino'
local VERSION = 'v1.4'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local running = true
local conns   = {}

local function track(c) conns[#conns + 1] = c return c end

local Config = { Gain = true }

local REFIRE_GAP = 1.0

-- ---- ui helpers -------------------------------------------------
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local TOGGLES = {}
local getterWorks = {}

local function registerToggle(key, id, name)
    TOGGLES[#TOGGLES + 1] = { key = key, id = id, name = name }
end

local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local v = firstBool(...)
        if v ~= nil then Config[key] = v end
    end
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(name) end)
    if ok and sec ~= nil then return sec end
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

-- ---- game helpers ----------------------------------------------
local WS = game:GetService('Workspace')

local warnedPrompt = false

local function firePrompt(prompt)
    if not prompt then return false end
    if type(fireproximityprompt) ~= 'function' then
        if not warnedPrompt then
            warnedPrompt = true
            warn('[' .. NAME .. '] fireproximityprompt missing - re-run the Matcha loader')
        end
        return false
    end
    local ok = pcall(fireproximityprompt, prompt)
    return ok
end

local function myPlot()
    local pens = WS:FindFirstChild('Pens')
    if not pens then return nil end
    for _, plot in ipairs(pens:GetChildren()) do
        local ok, owner = pcall(function() return plot:GetAttribute('Owner') end)
        if ok and owner ~= nil and owner == LP.UserId then return plot end
    end
    return nil
end

-- first MountDinosaur prompt anywhere on the plot's dinos
local function mountPrompt(plot)
    if not plot then return nil end
    local dinos = plot:FindFirstChild('Dinos')
    if not dinos then return nil end
    for _, slot in ipairs(dinos:GetChildren()) do
        local ok, desc = pcall(function() return slot:GetDescendants() end)
        if ok and desc then
            for _, d in ipairs(desc) do
                if d.ClassName == 'ProximityPrompt' and d.Name == 'MountDinosaur' then
                    return d
                end
            end
        end
    end
    return nil
end

-- mounted if a CarriedDino exists, or the character has a seat weld,
-- or Humanoid.Sit is true (each may be nil in this VM, so all are tried)
local function mounted()
    local ch = LP.Character
    if not ch then return false end

    local okC, carried = pcall(function() return ch:FindFirstChild('CarriedDino') end)
    if okC and carried ~= nil then return true end

    local hum = ch:FindFirstChildOfClass('Humanoid')
    if hum then
        local okS, sit = pcall(function() return hum.Sit end)
        if okS and sit == true then return true end
    end

    local okD, desc = pcall(function() return ch:GetDescendants() end)
    if okD and desc then
        for _, d in ipairs(desc) do
            local cn = d.ClassName
            if cn == 'Seat' or cn == 'VehicleSeat' or cn == 'Weld' then
                local nm = string.lower(tostring(d.Name))
                if string.find(nm, 'seat', 1, true) or string.find(nm, 'mount', 1, true) or string.find(nm, 'saddle', 1, true) then
                    return true
                end
            end
        end
    end

    return false
end

-- ---- menu -------------------------------------------------------
local tabBuilt = false

local function buildTab(tab)
    if tabBuilt then return end
    tabBuilt = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Stamina')
        if not sec then return end
        if mkToggle(sec, 'Always Gain Stamina', 'rad_gain', true, applyBool('Gain')) then
            registerToggle('Gain', 'rad_gain', 'Always Gain Stamina')
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Ride a Dino', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
end

-- ---- toggle poller ----------------------------------------------
task.spawn(function()
    local was = Config.Gain
    while running do
        for i = 1, #TOGGLES do
            local t = TOGGLES[i]
            local val = nil
            local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
            if ok1 and type(v1) == 'boolean' then
                val = v1
            else
                local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                if ok2 and type(v2) == 'boolean' then val = v2 end
            end
            if val ~= nil then
                getterWorks[t.key] = true
                if Config[t.key] ~= val then
                    Config[t.key] = val
                    print('[' .. NAME .. '] ' .. t.key .. ' = ' .. tostring(val))
                end
            end
        end
        if Config.Gain ~= was then
            was = Config.Gain
            print('[' .. NAME .. '] stamina toggle ' .. (Config.Gain and 'on' or 'off'))
        end
        task.wait(0.15)
    end
end)

-- ---- mount loop ------------------------------------------------
task.spawn(function()
    local lastFire = 0
    local saidOn   = false
    local saidNoPlot = false
    while running do
        if Config.Gain then
            local now = os.clock()
            if (now - lastFire) >= REFIRE_GAP then
                if mounted() then
                    saidOn = false
                else
                    local plot = myPlot()
                    if plot then
                        saidNoPlot = false
                        local prompt = mountPrompt(plot)
                        if prompt then
                            lastFire = now
                            if firePrompt(prompt) then
                                if not saidOn then
                                    saidOn = true
                                    print('[' .. NAME .. '] mounting via MountDinosaur prompt - stamina should tick')
                                end
                            end
                        end
                    elseif not saidNoPlot then
                        saidNoPlot = true
                        print('[' .. NAME .. '] no owned plot found yet')
                    end
                end
            end
        else
            lastFire = 0
            saidOn   = false
        end
        task.wait(0.25)
    end
end)

-- ---- stop -------------------------------------------------------
local function stop()
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    if HAS_UI then pcall(function() UI.RemoveTab('Ride a Dino') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] loaded ' .. VERSION)
pcall(function() notify('Ride a Dino', 'Loaded ' .. VERSION, 4) end)
