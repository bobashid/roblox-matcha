task.spawn(function()
    local warned = false

    while running do
        local ok, err = pcall(function()
            local level  = lp:GetAttribute('Level')
            local streak = lp:GetAttribute('Streak')
            local best   = lp:GetAttribute('BestStreak')

            setText(hudWin, CFG.hud, 'WIN: ' .. tostring(winState.text))

            local g = tostring(winState.goalText or '')
            if g == '' then g = 'no position goal this round' end
            if winState.disaster and winState.disaster ~= '' then
                g = g .. '   [' .. tostring(winState.disaster) .. ']'
            end
            setText(hudGoal, CFG.hud, g)

            local scanStr
            if not CFG.mapScan then
                scanStr = 'map scan off'
            elseif scan.running then
                local pct = 0
                if scan.total > 0 then pct = math.floor(scan.seen / scan.total * 100) end
                scanStr = 'scanning map ' .. tostring(pct) .. '%'
            elseif scan.result then
                local m = scan.resultMeta or {}
                scanStr = string.format('best spot: height %.0f, threat %.0f, %s',
                    m.height or 0, m.tdist or 0, m.indoors and 'indoors' or 'open')
            else
                scanStr = 'scan idle'
            end
            setText(hudScan, CFG.hud, scanStr)

            setText(hudInfo, CFG.hud,
                'Lv ' .. tostring(level) .. '   Streak ' .. tostring(streak) ..
                '   Best ' .. tostring(best))

            setText(hudDown, CFG.hud, downState and 'DOWN - getting up' or 'up')
        end)
        if not ok and not warned then
            warned = true
            warn('[' .. NAME .. '] hud error: ' .. tostring(err))
        end
        task.wait(0.2)
    end
end)

-- ---- stop ----
local function stop()
    if not running then return end
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    for i = 1, #draws do pcall(function() draws[i]:Remove() end) end
    draws = {}
    if HAS_UI then pcall(function() UI.RemoveTab('What If Disasters') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

