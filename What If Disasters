--   LocalPlayer attributes: InRound, GoalSafe, GoalShift, Level, Streak,
--     BestStreak, Equipment (string), Title, Spectators.
--   ReplicatedStorage.Remotes includes Revive, Impact, BloomCure, RoundResults,
--     Narrative, RequestEquip, SetAFK, Spectating, Watching.
--   Decompiled Players.<local>.PlayerScripts.Client.ReviveController:
--       Remotes.Revive:FireServer(true)    -- the "Get Up" button
--       Remotes.Revive:FireServer("reset") -- give-up path (NOT used here)
-- v1.2: this build rejected a Drawing Text property at load
--   ("Matcha:67: Unknown property FontSize") and the error killed the script
--   before any menu or HUD existed. Every Drawing property write now goes
--   through a pcall, and the font size is attempted under both FontSize and
--   TextSize so whichever this build supports is the one that sticks.
-- UNVERIFIED: meaning/units of GoalShift (numeric); printed raw only.
-- UNVERIFIED: server acceptance of Revive(true) without the local button press;
--   the auto get-up toggle re-checks state and backs off on repeats.
-- No teleport, no input simulation, no stat writes.

local NAME    = 'WhatIfDisasters'
local VERSION = 'v1.2'

if _G[NAME] and _G[NAME].stop then pcall(_G[NAME].stop) end
print('[' .. NAME .. '] ' .. VERSION)

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local running = true
local conns, draws = {}, {}

local function track(c) conns[#conns + 1] = c return c end
local function trackD(d) draws[#draws + 1] = d return d end

-- One unsupported property on a Drawing object throws, and a bare assignment
-- at load time kills the whole chunk. Every write goes through here.
local function sset(obj, prop, val)
    pcall(function() obj[prop] = val end)
end

-- ---- remotes (resolved once, guarded at call time) ----
local Remotes = RS:FindFirstChild('Remotes')
local Revive  = Remotes and Remotes:FindFirstChild('Revive')
if not Revive then
    warn('[' .. NAME .. '] Remotes.Revive not found - auto get-up idle')
end

-- ---- config ----
local CFG = {
    roundHud   = true,
    safeHud    = true,
    statsHud   = true,
    downedHud  = true,
    alerts     = true,
    autoRevive = true,
}

local function setBool(key, v)
    if CFG[key] == v then return end
    CFG[key] = v
    print('[' .. NAME .. '] ' .. tostring(key) .. ' = ' .. tostring(v))
end

-- ---- hud drawings (created once, pooled) ----
local FONT = 2
if Drawing.Fonts ~= nil and Drawing.Fonts.SystemBold ~= nil then FONT = Drawing.Fonts.SystemBold end

local function mkText(y, r, g, b)
    local t = trackD(Drawing.new('Text'))
    sset(t, 'Text', '')
    sset(t, 'Color', Color3.fromRGB(r, g, b))
    sset(t, 'Outline', true)
    sset(t, 'Center', false)
    sset(t, 'Font', FONT)
    pcall(function() t.FontSize = 16 end)
    pcall(function() t.TextSize = 16 end)
    sset(t, 'Transparency', 1)
    sset(t, 'Position', Vector2.new(20, y))
    sset(t, 'Visible', false)
    return t
end

local hudRound = mkText(120, 120, 220, 255)
local hudSafe  = mkText(142, 120, 255, 160)
local hudStats = mkText(164, 255, 220, 120)
local hudDown  = mkText(186, 255, 140, 140)

local function setText(obj, on, s)
    pcall(function()
        if on and s ~= '' then
            if obj.Text ~= s then obj.Text = s end
            if not obj.Visible then obj.Visible = true end
        elseif obj.Visible then
            obj.Visible = false
        end
    end)
end

-- ---- revive ----
local downState = false

local function fireRevive(tag)
    if not Revive then return false end
    local ok, err = pcall(function() Revive:FireServer(true) end)
    if ok then
        print('[' .. NAME .. '] Revive(true) fired (' .. tostring(tag) .. ')')
    else
        warn('[' .. NAME .. '] Revive fire failed (' .. tostring(tag) .. '): ' .. tostring(err))
    end
    return ok
end

-- The game builds a "GetUp" button only while you are down; visible == down.
local function isDowned()
    local pg = lp:FindFirstChild('PlayerGui')
    if not pg then return false end
    local ok, list = pcall(function() return pg:GetDescendants() end)
    if not ok or type(list) ~= 'table' then return false end
    local cap = #list
    if cap > 600 then cap = 600 end
    for i = 1, cap do
        local d = list[i]
        if d.Name == 'GetUp' then
            local vis = true
            pcall(function() if d.Visible == false then vis = false end end)
            if vis then return true end
        end
    end
    return false
end

-- ---- menu ----
local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'
local getterWorks = {}

local TOGGLES = {
    { key = 'autoRevive', id = 'wid_revive', name = 'Auto get up' },
    { key = 'downedHud',  id = 'wid_downed', name = 'Downed indicator' },
    { key = 'roundHud',   id = 'wid_round',  name = 'Round status' },
    { key = 'safeHud',    id = 'wid_safe',   name = 'Safe indicator' },
    { key = 'statsHud',   id = 'wid_stats',  name = 'Player stats' },
    { key = 'alerts',     id = 'wid_alerts', name = 'Alerts' },
}

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function applyBool(key)
    return function(...)
        if getterWorks[key] then return end
        local v = firstBool(...)
        if v ~= nil then setBool(key, v) end
    end
end

local function mkSection(tab, nm)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(nm, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok, sec = pcall(function() return tab:Section(nm) end)
    if ok and sec ~= nil then return sec end
    warn('[' .. NAME .. '] section ' .. tostring(nm) .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, cb)
    local tries = {
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. tostring(label))
    return false
end

local function mkButton(sec, label, cb)
    if pcall(function() sec:Button(label, cb) end) then return true end
    if pcall(function() sec:Button(label, label .. '_btn', cb) end) then return true end
    warn('[' .. NAME .. '] button failed: ' .. tostring(label))
    return false
end

local built = false

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Revive')
        if sec then
            mkToggle(sec, 'Auto get up', 'wid_revive', true, applyBool('autoRevive'))
            mkToggle(sec, 'Downed indicator', 'wid_downed', true, applyBool('downedHud'))
            mkButton(sec, 'Test: fire get up now', function()
                print('[' .. NAME .. '] manual get-up test')
                local d = isDowned()
                print('[' .. NAME .. '] downed = ' .. tostring(d))
                fireRevive('manual')
            end)
        end

        local hsec = mkSection(tab, 'HUD')
        if hsec then
            mkToggle(hsec, 'Round status', 'wid_round', true, applyBool('roundHud'))
            mkToggle(hsec, 'Safe indicator', 'wid_safe', true, applyBool('safeHud'))
            mkToggle(hsec, 'Player stats', 'wid_stats', true, applyBool('statsHud'))
            mkToggle(hsec, 'Alerts', 'wid_alerts', true, applyBool('alerts'))
        end
    end)
    if not ok then warn('[' .. NAME .. '] build error: ' .. tostring(err)) end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('What If Disasters', function(tab)
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    print('[' .. NAME .. '] no UI, running with defaults')
end

-- ---- toggle poller: getter is authoritative once it answers ----
if HAS_UI then
    task.spawn(function()
        while running do
            for i = 1, #TOGGLES do
                local t = TOGGLES[i]
                local val = nil
                local ok1, v1 = pcall(function() return UI.GetValue(t.id) end)
                if ok1 and type(v1) == 'boolean' then
                    val = v1
                else
                    local ok2, v2 = pcall(function() return UI.GetValue(t.name) end)
                    if ok2 and type(v2) == 'boolean' then val = v2 end
                end
                if val ~= nil then
                    getterWorks[t.key] = true
                    setBool(t.key, val)
                end
            end
            task.wait(0.15)
        end
    end)
end

-- ---- revive loop ----
local DOWN_POLL   = 0.25
local REVIVE_GAP  = 1.0
local MAX_TRIES   = 5
local BACKOFF     = 15

task.spawn(function()
    local wasDown, warnedNoRemote = false, false
    local nextTry, tries, pausedUntil = 0, 0, 0

    while running do
        local ok, err = pcall(function()
            local down = isDowned()
            downState = down

            if down ~= wasDown then
                wasDown = down
                print('[' .. NAME .. '] downed = ' .. tostring(down))
                if down then tries = 0 end
                if CFG.alerts then
                    pcall(notify, down and 'You are down' or 'You are up', NAME, 3)
                end
            end

            if down and CFG.autoRevive then
                if not Revive then
                    if not warnedNoRemote then
                        warnedNoRemote = true
                        warn('[' .. NAME .. '] auto get-up idle: Remotes.Revive missing')
                    end
                elseif os.clock() >= pausedUntil and os.clock() >= nextTry then
                    tries = tries + 1
                    local fok = fireRevive('auto#' .. tostring(tries))
                    nextTry = os.clock() + REVIVE_GAP
                    if not fok then
                        pausedUntil = os.clock() + BACKOFF
                    elseif tries >= MAX_TRIES then
                        tries = 0
                        pausedUntil = os.clock() + BACKOFF
                        print('[' .. NAME .. '] revive backed off ' .. tostring(BACKOFF) .. 's')
                    end
                end
            end
        end)
        if not ok then warn('[' .. NAME .. '] revive loop: ' .. tostring(err)) end
        task.wait(DOWN_POLL)
    end
end)

-- ---- hud loop ----
task.spawn(function()
    local warned = false
    local prevRound, prevSafe = nil, nil

    while running do
        local ok, err = pcall(function()
            local inRound  = lp:GetAttribute('InRound')
            local goalSafe = lp:GetAttribute('GoalSafe')
            local shift    = lp:GetAttribute('GoalShift')
            local level    = lp:GetAttribute('Level')
            local streak   = lp:GetAttribute('Streak')
            local best     = lp:GetAttribute('BestStreak')
            local eq       = lp:GetAttribute('Equipment')

            setText(hudRound, CFG.roundHud, 'Round: ' .. ((inRound == true) and 'ACTIVE' or 'idle'))

            local safeStr = (goalSafe == true) and 'YES' or 'NO'
            if type(shift) == 'number' then
                safeStr = safeStr .. '   shift ' .. string.format('%.1f', shift)
            end
            setText(hudSafe, CFG.safeHud, 'Safe: ' .. safeStr)

            local eqStr = (type(eq) == 'string' and eq ~= '') and ('   ' .. eq) or ''
            setText(hudStats, CFG.statsHud,
                'Lv ' .. tostring(level) .. '   Streak ' .. tostring(streak) ..
                '   Best ' .. tostring(best) .. eqStr)

            setText(hudDown, CFG.downedHud, downState and 'DOWN - getting up' or 'up')

            if CFG.alerts then
                if prevRound ~= nil and inRound ~= prevRound then
                    pcall(notify, inRound and 'Round started' or 'Round ended', NAME, 3)
                end
                if prevSafe ~= nil and goalSafe ~= prevSafe then
                    pcall(notify, (goalSafe == true) and 'You are safe' or 'You are NOT safe', NAME, 3)
                end
            end
            prevRound, prevSafe = inRound, goalSafe
        end)
        if not ok and not warned then
            warned = true
            warn('[' .. NAME .. '] hud error: ' .. tostring(err))
        end
        task.wait(0.2)
    end
end)

-- ---- stop ----
local function stop()
    if not running then return end
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    for i = 1, #draws do pcall(function() draws[i]:Remove() end) end
    draws = {}
    if HAS_UI then pcall(function() UI.RemoveTab('What If Disasters') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] loaded ' .. VERSION)
pcall(notify, 'What If Disasters loaded', NAME, 4)
