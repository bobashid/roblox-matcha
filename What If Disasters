local function mapBounds()
    local map = workspace:FindFirstChild('Map')
    local b = map and map:FindFirstChild('Bounds')
    local c, s = nil, nil
    if b then
        pcall(function() c = b.Position end)
        pcall(function() s = b.Size end)
    end
    if typeof(c) == 'Vector3' and typeof(s) == 'Vector3' and s.X > 1 and s.Z > 1 then
        return c, s
    end
    local rstr = RS:FindFirstChild('RoundState')
    if rstr then
        local mc = vecAttr(rstr, 'MapCenter')
        local ms = vecAttr(rstr, 'MapSize')
        if mc and ms and ms.X > 1 and ms.Z > 1 then return mc, ms end
    end
    return nil, nil
end

local function groundAt(x, z, yTop)
    local hit = rc(Vector3.new(x, yTop, z), Vector3.new(0, -1, 0) * 600, prmMap)
    if not hit then return nil end
    local y = yTop - hit.Distance
    return Vector3.new(x, y + 3, z)
end

-- where the disaster is coming from (whichever of these the round exposes)
local function threatPoint(ds)
    if not ds then return nil end
    local v = vecAttr(ds, 'PullOrigin')
    if v then return v end
    v = vecAttr(ds, 'WaveOrigin')
    if v then return v end
    v = vecAttr(ds, 'RiftStart')
    if v then return v end
    return nil
end

-- per-disaster scoring weights
local function weightsFor(ds)
    local w = { dist = 0.5, height = 1.0, indoor = 60 }
    if not ds then return w end
    local wave = boolAttr(ds, 'WaveActive')
    local water = numAttr(ds, 'WaterLevel')
    if wave or water then
        w.height = 3.0
        w.indoor = 15
    end
    local pull = numAttr(ds, 'PullStrength')
    if pull and pull > 0 then
        w.dist = 2.2
    end
    return w
end

local function scoreSpot(pos, goals, player, threat, baseY, w)
    local meta = { indoors = false, tdist = 0, height = pos.Y - baseY }
    meta.indoors = rc(pos + Vector3.new(0, 2, 0), Vector3.new(0, 160, 0), prmInc) ~= nil
    if threat then
        meta.tdist = Vector3.new(pos.X - threat.X, 0, pos.Z - threat.Z).Magnitude
    end

    if goals then
        if not evalGoals(goals, pos, player) then
            return -math.huge, meta
        end
    end

    local s = 0
    s = s + math.min(meta.tdist, 320) * w.dist
    s = s + math.max(0, meta.height) * w.height
    if meta.indoors then s = s + w.indoor end
    if goals then s = s + 1000 end
    return s, meta
end

-- =====================================================================
-- the sweep: whole map, a small batch per tick so it never stalls
-- =====================================================================
local SCAN_STEP  = 26
local SCAN_BATCH = 12
local RESCAN_GAP = 3.0

local scan = {
    running = false,
    done    = false,
    cx = 0, cz = 0,
    minX = 0, maxX = 0, minZ = 0, maxZ = 0,
    baseY = 0, yTop = 0,
    best = nil, bestScore = -math.huge, bestMeta = nil,
    result = nil, resultMeta = nil,
    total = 0, seen = 0,
}

local function scanReset()
    local c, s = mapBounds()
    if not c or not s then
        scan.running = false
        return false
    end
    local hx = math.min(s.X * 0.5, 280)
    local hz = math.min(s.Z * 0.5, 280)
    scan.minX, scan.maxX = c.X - hx, c.X + hx
    scan.minZ, scan.maxZ = c.Z - hz, c.Z + hz
    scan.baseY = c.Y - s.Y * 0.5
    scan.yTop  = c.Y + s.Y * 0.5 + 60
    scan.cx, scan.cz = scan.minX, scan.minZ
    scan.best, scan.bestScore, scan.bestMeta = nil, -math.huge, nil
    scan.running = true
    scan.done = false
    scan.seen = 0
    scan.total = math.max(1, math.floor((scan.maxX - scan.minX) / SCAN_STEP + 1) *
                             math.floor((scan.maxZ - scan.minZ) / SCAN_STEP + 1))
    return true
end

local function scanStep(goals, player, threat, w)
    if not scan.running then return end
    local n = 0
    while n < SCAN_BATCH do
        if scan.cx > scan.maxX then
            scan.running = false
            scan.done = true
            return
        end
        local g = groundAt(scan.cx, scan.cz, scan.yTop)
        if g and not isBad(g) then
            local s, meta = scoreSpot(g, goals, player, threat, scan.baseY, w)
            if s > scan.bestScore then
                scan.best, scan.bestScore, scan.bestMeta = g, s, meta
            end
        end
        n = n + 1
        scan.seen = scan.seen + 1
        scan.cz = scan.cz + SCAN_STEP
        if scan.cz > scan.maxZ then
            scan.cz = scan.minZ
            scan.cx = scan.cx + SCAN_STEP
        end
    end
end

-- 5x5 step-8 refinement around the coarse winner
local function refineAround(centre, goals, player, threat, w, yTop, baseY)
    local best, bestScore, bestMeta = centre, -math.huge, nil
    for dx = -16, 16, 8 do
        for dz = -16, 16, 8 do
            local g = groundAt(centre.X + dx, centre.Z + dz, yTop)
            if g and not isBad(g) then
                local s, meta = scoreSpot(g, goals, player, threat, baseY, w)
                if s > bestScore then best, bestScore, bestMeta = g, s, meta end
            end
        end
    end
    return best, bestScore, bestMeta
end

-- ---- spawn points, last resort only ----
local spawnCache = { mapName = nil, points = {} }

local function collectSpawns()
    local rstr = RS:FindFirstChild('RoundState')
    local mapName = ''
    if rstr then pcall(function() mapName = tostring(rstr:GetAttribute('MapName') or '') end) end

    if spawnCache.mapName == mapName and #spawnCache.points > 0 then
        return spawnCache.points
    end

    spawnCache.mapName = mapName
    spawnCache.points = {}

    local map = workspace:FindFirstChild('Map')
    local folder = map and map:FindFirstChild('Spawns')
    if folder then
        local ok, desc = pcall(function() return folder:GetDescendants() end)
        if ok and type(desc) == 'table' then
            for i = 1, #desc do
                local o = desc[i]
                local okp, p = pcall(function() return o.Position end)
                if okp and typeof(p) == 'Vector3' then
                    spawnCache.points[#spawnCache.points + 1] = p + Vector3.new(0, 3, 0)
                end
            end
        end
    end
    print('[' .. NAME .. '] spawns cached: ' .. tostring(#spawnCache.points) .. ' on map ' .. mapName)
    return spawnCache.points
end

local function nearestOf(list, origin)
    local best, bestD = nil, math.huge
    for i = 1, #list do
        local d = (list[i] - origin).Magnitude
        if d < bestD then best, bestD = list[i], d end
    end
    return best, bestD
end

-- ring search kept as a fallback when the sweep has not finished yet
local function findRingSpot(goals, origin, player)
    pruneBad()
    if goals and evalGoals(goals, origin, player) then return origin, 0 end
    local radii = { 10, 20, 34, 50, 70 }
    for ri = 1, #radii do
        local rad = radii[ri]
        local best, bestD = nil, math.huge
        for ai = 0, 11 do
            local a = ai * math.pi / 6
            local g = groundAt(origin.X + math.cos(a) * rad, origin.Z + math.sin(a) * rad, origin.Y + 40)
            if g and not isBad(g) and evalGoals(goals, g, player) then
                local d = (g - origin).Magnitude
                if d < bestD then best, bestD = g, d end
            end
        end
        if best then return best, bestD end
    end
    return nil, nil
end

local function writeTp(hrp, spot)
    return pcall(function()
        hrp.CFrame = CFrame.new(spot.X, spot.Y + 3, spot.Z)
    end)
end

