local SHELTER_RAY = 50

local CollectionService = nil
pcall(function() CollectionService = game:GetService('CollectionService') end)

local prmInc = RaycastParams.new()
local prmMap = RaycastParams.new()
pcall(function() prmInc.FilterType = Enum.RaycastFilterType.Include end)
pcall(function() prmMap.FilterType = Enum.RaycastFilterType.Include end)

local filtersReady = false

local function refreshFilters()
    local map = workspace:FindFirstChild('Map')
    if not map then
        filtersReady = false
        return false
    end
    local fx = workspace:FindFirstChild('Effects')
    pcall(function() prmInc.FilterDescendantsInstances = fx and { map, fx } or { map } end)
    pcall(function() prmMap.FilterDescendantsInstances = { map } end)
    filtersReady = true
    return true
end

local function rc(origin, dir, prm)
    local ok, r = pcall(function() return workspace:Raycast(origin, dir, prm) end)
    if ok then return r end
    return nil
end

-- how many distinct vertical wall faces surround this point (max 2)
local function wallCount(pos)
    local dirs = {}
    for i = 0, 7 do
        local a = i * math.pi / 4
        local r = rc(pos, Vector3.new(math.cos(a), 0, math.sin(a)) * 5, prmMap)
        if r then
            local n = r.Normal
            local collide = false
            pcall(function() collide = r.Instance.CanCollide end)
            if math.abs(n.Y) < 0.5 and collide then
                local h = Vector3.new(n.X, 0, n.Z)
                if h.Magnitude > 0.001 then
                    h = h.Unit
                    local dup = false
                    for k = 1, #dirs do
                        if dirs[k]:Dot(h) > 0.5 then
                            dup = true
                            break
                        end
                    end
                    if not dup then
                        dirs[#dirs + 1] = h
                        if #dirs >= 2 then return 2 end
                    end
                end
            end
        end
    end
    return #dirs
end

-- any CollectionService "HeatSource" part with Active + radius covering pos
local function nearHeat(pos)
    if not CollectionService then return false end
    local ok, list = pcall(function() return CollectionService:GetTagged('HeatSource') end)
    if not ok or type(list) ~= 'table' then return false end
    for i = 1, #list do
        local p = list[i]
        local good, hit = pcall(function()
            if p.Size == nil then return false end
            if p:GetAttribute('Active') ~= true then return false end
            if not p:IsDescendantOf(workspace) then return false end
            local rad = tonumber(p:GetAttribute('HeatRadius')) or 12
            return (p.Position - pos).Magnitude <= rad
        end)
        if good and hit then return true end
    end
    return false
end

-- distance to the nearest shelter in `dir`, sampling at foot and chest height
local function coverDist(pos, dir)
    if typeof(dir) ~= 'Vector3' or dir.Magnitude < 0.001 then return nil end
    local best = nil
    local offs = { 0, 1.5 }
    for i = 1, #offs do
        local r = rc(pos + Vector3.new(0, offs[i], 0), dir.Unit * SHELTER_RAY, prmInc)
        if r and (best == nil or r.Distance < best) then best = r.Distance end
    end
    return best
end

local evalNode

evalNode = function(node, pos, player)
    if type(node) ~= 'table' then return false end
    local k = node.k

    if k == 'Clean' then
        if player == nil then return false end
        local ok, v = pcall(function() return player:GetAttribute('Infected') end)
        if not ok then return false end
        return not v

    elseif k == 'Indoors' then
        return rc(pos + Vector3.new(0, 2, 0), Vector3.new(0, 160, 0), prmInc) ~= nil

    elseif k == 'Sealed' then
        if rc(pos + Vector3.new(0, 2, 0), Vector3.new(0, 160, 0), prmInc) == nil then return false end
        for i = 0, 7 do
            local a = i * math.pi / 4
            if rc(pos, Vector3.new(math.cos(a), 0, math.sin(a)) * 70, prmInc) == nil then return false end
        end
        return true

    elseif k == 'Warm' then
        return nearHeat(pos) or wallCount(pos) >= 2

    elseif k == 'Walls' then
        return wallCount(pos) >= (tonumber(node.n) or 1)

    elseif k == 'Above' then
        return pos.Y > (tonumber(node.y) or 0)

    elseif k == 'Below' then
        return pos.Y < (tonumber(node.y) or 0)

    elseif k == 'Away' then
        local at = node.at
        if typeof(at) ~= 'Vector3' then return false end
        return Vector3.new(pos.X - at.X, 0, pos.Z - at.Z).Magnitude > (tonumber(node.r) or 0)

    elseif k == 'From' then
        local at = node.at
        if typeof(at) ~= 'Vector3' then return false end
        local d = at - pos
        if d.Magnitude < 1 then return false end
        local dist = math.min(d.Magnitude, tonumber(node.d) or SHELTER_RAY)
        return rc(pos, d.Unit * dist, prmInc) ~= nil

    elseif k == 'Ray' then
        local dir = node.dir
        if typeof(dir) ~= 'Vector3' or dir.Magnitude < 0.001 then return false end
        return rc(pos, dir.Unit * (tonumber(node.len) or SHELTER_RAY), prmInc) ~= nil

    elseif k == 'Cover' then
        local dir = node.dir
        if typeof(dir) ~= 'Vector3' then return false end
        local c = coverDist(pos, dir)
        if c == nil then return false end
        return c <= (tonumber(node.d) or SHELTER_RAY)

    elseif k == 'Any' then
        local of = node.of
        if type(of) ~= 'table' then return false end
        for i = 1, #of do
            if evalNode(of[i], pos, player) then return true end
        end
        return false
    end

    return false
end

local function evalGoals(goals, pos, player)
    if type(goals) ~= 'table' or #goals == 0 then return false end
    if not filtersReady and not refreshFilters() then return false end
    for i = 1, #goals do
        if not evalNode(goals[i], pos, player) then return false end
    end
    return true
end

local HttpService = game:GetService('HttpService')

local function decodeGoals(s)
    if type(s) ~= 'string' or s == '' then return nil end
    local ok, t = pcall(function() return HttpService:JSONDecode(s) end)
    if not ok or type(t) ~= 'table' then return nil end
    if #t == 0 then return nil end
    for i = 1, #t do
        local node = t[i]
        if type(node) == 'table' then
            local keys = { 'at', 'dir' }
            for k = 1, #keys do
                local v = node[keys[k]]
                if type(v) == 'table' then
                    node[keys[k]] = Vector3.new(tonumber(v[1]) or 0, tonumber(v[2]) or 0, tonumber(v[3]) or 0)
                end
            end
        end
    end
    return t
end

-- ---- spots that were tried and did not help (20 s ban) ----
local badSpots = {}

local function pruneBad()
    local now = os.clock()
    for i = #badSpots, 1, -1 do
        if badSpots[i].until <= now then table.remove(badSpots, i) end
    end
end

local function isBad(pos)
    for i = 1, #badSpots do
        if (badSpots[i].pos - pos).Magnitude < 8 then return true end
    end
    return false
end

local function markBad(pos)
    pruneBad()
    badSpots[#badSpots + 1] = { pos = pos, until = os.clock() + 20 }
    print('[' .. NAME .. '] spot marked bad for 20s')
end

-- spiral outward from the player; nearest passing ring wins
local function findSafeSpot(goals, origin, player)
    pruneBad()
    if evalGoals(goals, origin, player) then return origin, 0 end

    local radii = { 8, 16, 26, 38, 52, 70, 95 }
    for ri = 1, #radii do
        local rad = radii[ri]
        local best, bestD = nil, math.huge
        for ai = 0, 11 do
            local a = ai * math.pi / 6
            local cand = Vector3.new(origin.X + math.cos(a) * rad, origin.Y, origin.Z + math.sin(a) * rad)
            -- drop to the ground under the candidate (RaycastResult.Position is not
            -- relied on; Distance is the field the game's own module uses)
            local hit = rc(cand + Vector3.new(0, 6, 0), Vector3.new(0, -1, 0) * 40, prmMap)
            if hit then
                cand = cand + Vector3.new(0, 6 - hit.Distance, 0)
                cand = cand + Vector3.new(0, 3, 0)
                if not isBad(cand) and evalGoals(goals, cand, player) then
                    local d = (cand - origin).Magnitude
                    if d < bestD then
                        best, bestD = cand, d
                    end
                end
            end
        end
        if best then return best, bestD end
    end
    return nil, nil
end

-- ---- spawn points (Workspace.Map.Spawns) ----
local spawnCache = { mapName = nil, points = {} }

local function collectSpawns()
    local rstr = RS:FindFirstChild('RoundState')
    local mapName = ''
    pcall(function() mapName = tostring(rstr:GetAttribute('MapName') or '') end)

    if spawnCache.mapName == mapName and #spawnCache.points > 0 then
        return spawnCache.points
    end

    spawnCache.mapName = mapName
    spawnCache.points = {}

    local map = workspace:FindFirstChild('Map')
    local folder = map and map:FindFirstChild('Spawns')
    if folder then
        local ok, desc = pcall(function() return folder:GetDescendants() end)
        if ok and type(desc) == 'table' then
            for i = 1, #desc do
                local o = desc[i]
                local okp, p = pcall(function() return o.Position end)
                if okp and typeof(p) == 'Vector3' then
                    spawnCache.points[#spawnCache.points + 1] = p + Vector3.new(0, 3, 0)
                end
            end
        end
    end
    print('[' .. NAME .. '] spawns cached: ' .. tostring(#spawnCache.points) .. ' on map ' .. mapName)
    return spawnCache.points
end

-- returns spot, dist, passesGoal
local function findSpawn(goals, origin, player)
    local list = collectSpawns()
    if #list == 0 then return nil, nil, false end

    if goals then
        local best, bestD = nil, math.huge
        for i = 1, #list do
            local cand = list[i]
            if not isBad(cand) and evalGoals(goals, cand, player) then
                local d = (cand - origin).Magnitude
                if d < bestD then best, bestD = cand, d end
            end
        end
        if best then return best, bestD, true end
    end

    -- no spawn satisfies the goal (or there is no goal): nearest spawn anyway
    local best, bestD = nil, math.huge
    for i = 1, #list do
        local cand = list[i]
        if not isBad(cand) then
            local d = (cand - origin).Magnitude
            if d < bestD then best, bestD = cand, d end
        end
    end
    if best then return best, bestD, false end

    -- everything is banned: fall back to the plain nearest spawn
    best, bestD = nil, math.huge
    for i = 1, #list do
        local d = (list[i] - origin).Magnitude
        if d < bestD then best, bestD = list[i], d end
    end
    return best, bestD, false
end

