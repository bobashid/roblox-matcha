-- =====================================================================
-- auto win loop
-- =====================================================================
local TP_GAP        = 1.2
local TP_MAX_ERRORS = 6
local LANDED        = 6
local HOLD_GAP      = 3.0

task.spawn(function()
    local prevSafe  = nil
    local tpNext    = 0
    local tpErrors  = 0
    local lastSpot  = nil
    local lastPhase = nil
    local nextScan  = 0

    while running do
        local ok, err = pcall(function()
            refreshFilters()

            local ds       = RS:FindFirstChild('DisasterState')
            local rstr     = RS:FindFirstChild('RoundState')
            local goalAttr = ds and ds:GetAttribute('GoalCheck')
            local goalText = (ds and ds:GetAttribute('GoalText')) or ''
            local phase    = rstr and rstr:GetAttribute('Phase')
            local disaster = (rstr and rstr:GetAttribute('DisasterId')) or ''

            if phase ~= lastPhase then
                lastPhase = phase
                tpErrors  = 0
                lastSpot  = nil
                scan.result, scan.resultMeta = nil, nil
                scan.done = false
                scan.running = false
                nextScan = 0
            end

            local ch  = lp.Character
            local hrp = ch and ch:FindFirstChild('HumanoidRootPart')
            local hum = ch and ch:FindFirstChildOfClass('Humanoid')

            if not hrp or not hum then
                winState.text = 'no character'
                winState.safe = false
                winState.spot = nil
                tpErrors, lastSpot = 0, nil
                return
            end

            local pos = hrp.Position
            winState.disaster = disaster
            winState.goalText = goalText
            winState.inRound  = lp:GetAttribute('InRound') == true
            winState.down     = downState

            local goals  = decodeGoals(goalAttr)
            local threat = threatPoint(ds)
            local w      = weightsFor(ds)

            -- ---- run the sweep in the background ----
            if CFG.mapScan then
                if not scan.running and not scan.done and os.clock() >= nextScan then
                    scanReset()
                end
                if scan.running then
                    scanStep(goals, lp, threat, w)
                end
                if scan.done then
                    scan.done = false
                    local b, bs, bm = scan.best, scan.bestScore, scan.bestMeta
                    if b and bs > -math.huge then
                        b, bs, bm = refineAround(b, goals, lp, threat, w, scan.yTop, scan.baseY)
                    end
                    scan.result, scan.resultMeta = b, bm
                    nextScan = os.clock() + RESCAN_GAP
                    if b then
                        print('[' .. NAME .. '] sweep done: ' .. tostring(b) .. ' score ' .. string.format('%.0f', bs))
                    else
                        print('[' .. NAME .. '] sweep done: nothing usable')
                    end
                end
            else
                scan.running, scan.done = false, false
            end

            if winState.inRound ~= true then
                winState.text = 'waiting (' .. tostring(phase) .. ')'
                winState.safe = false
                winState.spot = nil
                tpErrors, lastSpot = 0, nil
                return
            end

            if downState then
                winState.text = 'down - getting up'
                return
            end

            -- ---- is the player already fine? ----
            local safeNow = false
            if goals then
                safeNow = evalGoals(goals, pos, lp)
            else
                safeNow = lp:GetAttribute('GoalSafe') == true
            end
            winState.safe = safeNow

            if CFG.alerts and prevSafe ~= nil and safeNow ~= prevSafe then
                pcall(notify, safeNow and 'Safe' or 'Not safe', NAME, 3)
            end
            prevSafe = safeNow

            if safeNow then
                winState.text = 'SAFE - holding position'
                winState.spot = nil
                lastSpot = nil
                tpErrors = 0
                return
            end

            if not CFG.autoWin then
                winState.text = 'unsafe (auto win off)'
                return
            end

            -- ---- the spot the last teleport landed on did not help ----
            if goals and lastSpot and (lastSpot - pos).Magnitude <= LANDED then
                markBad(lastSpot)
                lastSpot = nil
                scan.result = nil
                nextScan = 0
            end

            -- ---- choose a target ----
            local target, kind = nil, ''

            if CFG.mapScan and scan.result then
                target, kind = scan.result, 'map'
            end

            if not target and goals then
                local r, d = findRingSpot(goals, pos, lp)
                if r then target, kind = r, 'ring' end
            end

            if not target and CFG.spawnLast then
                local list = collectSpawns()
                local s, sd = nearestOf(list, pos)
                if s then target, kind = s, 'spawn' end
            end

            if not target then
                winState.text = 'no safe spot found yet'
                winState.spot = nil
                return
            end

            winState.spot = target
            winState.kind = kind

            -- ---- go there ----
            if CFG.teleport and tpErrors < TP_MAX_ERRORS then
                if os.clock() >= tpNext then
                    tpNext = os.clock() + TP_GAP
                    if writeTp(hrp, target) then
                        tpErrors = 0
                        lastSpot = target
                        local d = (target - pos).Magnitude
                        winState.text = string.format('tp to %s (%.0f studs)', kind, d)
                        print('[' .. NAME .. '] ' .. winState.text)
                    else
                        tpErrors = tpErrors + 1
                        winState.text = 'tp write failed'
                        warn('[' .. NAME .. '] teleport CFrame write failed')
                    end
                else
                    winState.text = 'tp cooling down'
                end
            else
                if tpErrors >= TP_MAX_ERRORS then
                    winState.text = 'tp failing - walking'
                else
                    local d = (target - pos).Magnitude
                    winState.text = string.format('walking to %s (%.0f studs)', kind, d)
                end
                pcall(function() hum:MoveTo(target) end)
            end
        end)
        if not ok then
            winState.text = 'error'
        end
        task.wait(0.3)
    end
end)

-- =====================================================================
-- revive loop
-- =====================================================================
local DOWN_POLL  = 0.25
local REVIVE_GAP = 1.0
local MAX_TRIES  = 5
local BACKOFF    = 15

task.spawn(function()
    local wasDown, warnedNoRemote = false, false
    local nextTry, tries, pausedUntil = 0, 0, 0

    while running do
        local ok, err = pcall(function()
            local down = isDowned()
            downState = down

            if down ~= wasDown then
                wasDown = down
                print('[' .. NAME .. '] downed = ' .. tostring(down))
                if down then tries = 0 end
                if CFG.alerts then
                    pcall(notify, down and 'You are down' or 'You are up', NAME, 3)
                end
            end

            if down and CFG.autoRevive then
                if not Revive then
                    if not warnedNoRemote then
                        warnedNoRemote = true
                        warn('[' .. NAME .. '] auto get-up idle: Remotes.Revive missing')
                    end
                elseif os.clock() >= pausedUntil and os.clock() >= nextTry then
                    tries = tries + 1
                    local fok = fireRevive('auto#' .. tostring(tries))
                    nextTry = os.clock() + REVIVE_GAP
                    if not fok then
                        pausedUntil = os.clock() + BACKOFF
                    elseif tries >= MAX_TRIES then
                        tries = 0
                        pausedUntil = os.clock() + BACKOFF
                        print('[' .. NAME .. '] revive backed off ' .. tostring(BACKOFF) .. 's')
                    end
                end
            end
        end)
        if not ok then warn('[' .. NAME .. '] revive loop: ' .. tostring(err)) end
        task.wait(DOWN_POLL)
    end
end)

