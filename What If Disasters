-- =====================================================================
-- auto win loop
--   1. goal predicate present -> nearest passing spot, else a spawn that
--      passes the predicate, else nearest spawn
--   2. no goal predicate (the usual case) -> teleport to a spawn point and
--      keep checking; the server owns the verdict there
-- =====================================================================
local SEARCH_INTERVAL = 0.6
local SPAWN_RETRY     = 3.0
local TP_GAP          = 1.2
local TP_MAX_ERRORS   = 6
local LANDED          = 6

task.spawn(function()
    local next      = 0
    local prevSafe  = nil
    local tpNext    = 0
    local tpErrors  = 0
    local lastSpot  = nil
    local lastPhase = nil
    local lastSpawn = nil

    while running do
        local ok, err = pcall(function()
            refreshFilters()

            local ds       = RS:FindFirstChild('DisasterState')
            local rstr     = RS:FindFirstChild('RoundState')
            local goalAttr = ds and ds:GetAttribute('GoalCheck')
            local goalText = (ds and ds:GetAttribute('GoalText')) or ''
            local phase    = rstr and rstr:GetAttribute('Phase')
            local disaster = (rstr and rstr:GetAttribute('DisasterId')) or ''

            if phase ~= lastPhase then
                lastPhase = phase
                tpErrors  = 0
                lastSpot  = nil
                winState.spot = nil
            end

            local ch  = lp.Character
            local hrp = ch and ch:FindFirstChild('HumanoidRootPart')
            local hum = ch and ch:FindFirstChildOfClass('Humanoid')

            if not hrp or not hum then
                winState.text = 'no character'
                winState.safe = false
                winState.spot = nil
                tpErrors, lastSpot = 0, nil
            elseif lp:GetAttribute('InRound') ~= true then
                winState.text = 'waiting (' .. tostring(phase) .. ')'
                winState.safe = false
                winState.spot = nil
                tpErrors, lastSpot = 0, nil
            elseif downState then
                winState.text = 'down - getting up'
            else
                local goals = decodeGoals(goalAttr)
                local pos = hrp.Position
                winState.disaster = disaster
                winState.goalText = goalText

                if goals then
                    local safeNow = evalGoals(goals, pos, lp)
                    winState.safe = safeNow

                    if safeNow then
                        winState.text = 'GOAL PASSES - holding position'
                        winState.spot = nil
                        lastSpot = nil
                        tpErrors = 0
                    elseif CFG.autoWin then
                        -- landed on a spot and the goal still fails: that spot is
                        -- no good, ban it and look again right away.
                        if lastSpot and (lastSpot - pos).Magnitude <= LANDED then
                            markBad(lastSpot)
                            lastSpot = nil
                            next = 0
                        end

                        if os.clock() >= next then
                            next = os.clock() + SEARCH_INTERVAL

                            local spot, dist = findSafeSpot(goals, pos, lp)
                            local viaSpawn = false
                            if not spot and CFG.spawnFallback then
                                local passes
                                spot, dist, passes = findSpawn(goals, pos, lp)
                                viaSpawn = true
                                winState.spawnPasses = passes
                            end
                            winState.spot = spot

                            if not spot then
                                winState.text = 'no safe spot and no spawn'
                            elseif CFG.teleport and tpErrors < TP_MAX_ERRORS then
                                if os.clock() >= tpNext then
                                    tpNext = os.clock() + TP_GAP
                                    if writeTp(hrp, spot) then
                                        tpErrors = 0
                                        lastSpot = spot
                                        if viaSpawn then
                                            winState.text = string.format('tp to spawn (%.0f studs)', dist or 0)
                                        else
                                            winState.text = string.format('tp to safe spot (%.0f studs)', dist or 0)
                                        end
                                        print('[' .. NAME .. '] ' .. winState.text)
                                    else
                                        tpErrors = tpErrors + 1
                                        winState.text = 'tp write failed'
                                        warn('[' .. NAME .. '] teleport CFrame write failed')
                                    end
                                else
                                    winState.text = 'tp cooling down'
                                end
                            else
                                if tpErrors >= TP_MAX_ERRORS then
                                    winState.text = 'tp failing - walking'
                                else
                                    winState.text = string.format('walking to safe spot (%.0f studs)', dist or 0)
                                end
                                pcall(function() hum:MoveTo(spot) end)
                            end
                        elseif winState.spot and not CFG.teleport then
                            pcall(function() hum:MoveTo(winState.spot) end)
                        elseif not winState.spot then
                            winState.text = 'unsafe - searching'
                        end
                    else
                        winState.text = 'unsafe (auto win off)'
                    end
                else
                    -- No position predicate this round: the server owns the verdict.
                    -- Nothing client-side can flip GoalSafe, so the best available
                    -- action is to sit on a spawn point and wait it out.
                    local gs = lp:GetAttribute('GoalSafe') == true
                    winState.safe = gs
                    winState.spot = nil

                    if gs then
                        winState.text = 'server goal: SAFE'
                        lastSpot = nil
                    elseif CFG.autoWin and CFG.spawnFallback then
                        if os.clock() >= next then
                            next = os.clock() + SPAWN_RETRY
                            local sp, sd = findSpawn(nil, pos, lp)
                            if not sp then
                                winState.text = 'no goal - no spawn found'
                            elseif CFG.teleport and os.clock() >= tpNext then
                                tpNext = os.clock() + TP_GAP
                                if writeTp(hrp, sp) then
                                    lastSpawn = sp
                                    winState.text = string.format('no goal - tp to spawn (%.0f studs)', sd or 0)
                                    print('[' .. NAME .. '] ' .. winState.text)
                                else
                                    winState.text = 'no goal - tp to spawn failed'
                                end
                            elseif CFG.teleport then
                                winState.text = 'no goal - spawn tp cooldown'
                            else
                                lastSpawn = sp
                                winState.text = 'no goal - walking to spawn'
                                pcall(function() hum:MoveTo(sp) end)
                            end
                        elseif lastSpawn and not CFG.teleport then
                            pcall(function() hum:MoveTo(lastSpawn) end)
                        else
                            winState.text = 'server goal: UNSAFE'
                        end
                    else
                        winState.text = 'server goal: UNSAFE (spawn off)'
                    end
                end

                if CFG.alerts and prevSafe ~= nil and winState.safe ~= prevSafe and goals then
                    pcall(notify, winState.safe and 'Goal now passes' or 'Goal no longer passes', NAME, 3)
                end
                prevSafe = winState.safe
            end
        end)
        if not ok then
            winState.text = 'error'
        end
        task.wait(0.35)
    end
end)

-- =====================================================================
-- revive loop
-- =====================================================================
local DOWN_POLL  = 0.25
local REVIVE_GAP = 1.0
local MAX_TRIES  = 5
local BACKOFF    = 15

task.spawn(function()
    local wasDown, warnedNoRemote = false, false
    local nextTry, tries, pausedUntil = 0, 0, 0

    while running do
        local ok, err = pcall(function()
            local down = isDowned()
            downState = down

            if down ~= wasDown then
                wasDown = down
                print('[' .. NAME .. '] downed = ' .. tostring(down))
                if down then tries = 0 end
                if CFG.alerts then
                    pcall(notify, down and 'You are down' or 'You are up', NAME, 3)
                end
            end

            if down and CFG.autoRevive then
                if not Revive then
                    if not warnedNoRemote then
                        warnedNoRemote = true
                        warn('[' .. NAME .. '] auto get-up idle: Remotes.Revive missing')
                    end
                elseif os.clock() >= pausedUntil and os.clock() >= nextTry then
                    tries = tries + 1
                    local fok = fireRevive('auto#' .. tostring(tries))
                    nextTry = os.clock() + REVIVE_GAP
                    if not fok then
                        pausedUntil = os.clock() + BACKOFF
                    elseif tries >= MAX_TRIES then
                        tries = 0
                        pausedUntil = os.clock() + BACKOFF
                        print('[' .. NAME .. '] revive backed off ' .. tostring(BACKOFF) .. 's')
                    end
                end
            end
        end)
        if not ok then warn('[' .. NAME .. '] revive loop: ' .. tostring(err)) end
        task.wait(DOWN_POLL)
    end
end)

-- =====================================================================
-- hud loop
-- =====================================================================
task.spawn(function()
    local warned = false

    while running do
        local ok, err = pcall(function()
            local level  = lp:GetAttribute('Level')
            local streak = lp:GetAttribute('Streak')
            local best   = lp:GetAttribute('BestStreak')
            local shift  = lp:GetAttribute('GoalShift')

            setText(hudWin, CFG.hud, 'WIN: ' .. tostring(winState.text))

            local g = tostring(winState.goalText or '')
            if g == '' then g = 'no position goal this round' end
            if winState.disaster and winState.disaster ~= '' then
                g = g .. '   [' .. tostring(winState.disaster) .. ']'
            end
            setText(hudGoal, CFG.hud, g)

            local shiftStr = ''
            if type(shift) == 'number' then shiftStr = string.format('   shift %.1f', shift) end
            setText(hudInfo, CFG.hud,
                'Lv ' .. tostring(level) .. '   Streak ' .. tostring(streak) ..
                '   Best ' .. tostring(best) .. shiftStr)

            setText(hudDown, CFG.hud, downState and 'DOWN - getting up' or 'up')
        end)
        if not ok and not warned then
            warned = true
            warn('[' .. NAME .. '] hud error: ' .. tostring(err))
        end
        task.wait(0.2)
    end
end)

-- ---- stop ----
local function stop()
    if not running then return end
    running = false
    for i = 1, #conns do pcall(function() conns[i]:Disconnect() end) end
    conns = {}
    for i = 1, #draws do pcall(function() draws[i]:Remove() end) end
    draws = {}
    if HAS_UI then pcall(function() UI.RemoveTab('What If Disasters') end) end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] loaded ' .. VERSION)
pcall(notify, 'What If Disasters loaded', NAME, 4)
