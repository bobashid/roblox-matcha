-- KEY INPUT
-- ============================================================
local latch, wasDown, lastFire = {}, {}, {}

local function trigger(action)
    if capture then return end
    if action == "reload" then
        if not S.reloadAll then return end
        pendingReload = true
        return
    end
    if reloading then return end
    local now = os.clock()
    if lastFire[action] and (now - lastFire[action]) < 0.2 then return end
    lastFire[action] = now
    if action == "lock" then
        local t, d = pickByMouse()
        applyLock(t, "mouse", d)
    elseif action == "unlock" then
        doUnlock()
    end
end

local function pollDown(raw)
    if not raw then return false end
    local d = false
    pcall(function() d = UIS:IsKeyDown(raw) end)
    if d == true then return true end
    pcall(function() d = iskeypressed(raw) end)
    return d == true
end

pcall(function()
    connBegan = UIS.InputBegan:Connect(function(input)
        local code
        pcall(function() code = input.KeyCode end)
        if type(code) ~= "number" then return end
        if capture then
            local act = capture
            capture = nil
            uiSet("rebind_" .. act, false)
            setBind(act, code)
            return
        end
        if code == RELOAD_KEY then latch.reload = true; return end
        if reloading then return end
        for _, act in ipairs(ACTIONS) do
            if binds[act] == code then latch[act] = true end
        end
    end)
end)

task.spawn(function()
    while running do
        pcall(function()
            for _, act in ipairs(ACTIONS) do
                local raw = binds[act]
                local down = pollDown(raw)
                if down and not wasDown[act] then
                    if not reloading then trigger(act) end
                end
                wasDown[act] = down
            end
            local rdown = pollDown(RELOAD_KEY)
            if rdown and not wasDown.reload then trigger("reload") end
            wasDown.reload = rdown

            if latch.reload then latch.reload = nil; trigger("reload") end
            for _, act in ipairs(ACTIONS) do
                if latch[act] then
                    latch[act] = nil
                    if not reloading then trigger(act) end
                end
            end
        end)
        task.wait(0.02)
    end
end)

