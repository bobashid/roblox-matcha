local RELOAD_KEY = 82               -- R, the in-game reload

-- reload timing: one frame per step, same cadence as the firing loop
local RL_TAP     = 0.01     -- key down -> up
local RL_GAP     = 0.01     -- between the two taps
local RL_SETTLE  = 0.03     -- after reload tap before next slot

