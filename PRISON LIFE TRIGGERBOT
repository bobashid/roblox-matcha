local lastDbg, flagCache = {}, {}
local function detectInmateState(ch, uid, pname, now)
    local fc = flagCache[uid]
    if fc and fc.ch == ch and (now - fc.t) < FLAG_REFRESH then
        return fc.aggro, fc.arrest, fc.viaHighlight
    end
    local aggro = flagOn(ch, FLAG_AGGRO)
    local viaHL = hasArrestHighlight(ch)
    local arrest = viaHL or flagOn(ch, FLAG_ARREST)
    flagCache[uid] = { ch=ch, t=now, aggro=aggro, arrest=arrest, viaHighlight=viaHL }
    if DEBUG_FLAGS then
        local key = tostring(aggro).."|"..tostring(arrest).."|"..tostring(viaHL)
        if lastDbg[uid] ~= key then
            lastDbg[uid] = key
            log(string.format("%s aggro=%s arrest=%s viaHL=%s",
                tostring(pname), tostring(aggro), tostring(arrest), tostring(viaHL)))
        end
    end
    return aggro, arrest, viaHL
end

