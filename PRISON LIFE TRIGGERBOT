local function setRight(obj, vpX, y, str)
    obj.Text = str
    local w
    local ok, b = pcall(function() return obj.TextBounds end)
    if ok and b then
        local okx, bx = pcall(function() return b.X end)
        if okx and type(bx) == "number" and bx > 0 then w = bx end
    end
    if not w then w = #str * (obj.Size * 0.52) end
    obj.Position = Vector2.new(vpX - w - 14, y)
end

local COL_FIRE    = Color3.fromRGB(80, 255, 80)
local COL_WAIT    = Color3.fromRGB(255, 140, 0)
local COL_IDLE    = Color3.fromRGB(150, 150, 150)
local COL_PAUSE   = Color3.fromRGB(255, 70, 70)
local COL_SETTLE  = Color3.fromRGB(120, 180, 255)

local cycIndex, cycStage = 1, 0
local lastShot = 0

local function releaseCycle()
    if cycStage == 1 then
        local code = cycleKeys[cycIndex]
        if code then pcall(function() keyrelease(code) end) end
    end
    cycStage, cycIndex = 0, 1
end

connRender = RunService.RenderStepped:Connect(function()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local vpX, vpY = vp.X, vp.Y
    local now = os.clock()

    local camPos
    pcall(function() camPos = cam.CFrame.Position end)

    if testImg and testImg.Visible then
        testImg.Position = Vector2.new(vpX / 2 - 48, vpY / 2 - 48)
    end

    local mx, my = vpX / 2, vpY / 2
    pcall(function()
        local m = lp:GetMouse()
        if m then
            local x, y = m.X, m.Y
            if type(x) == "number" and type(y) == "number" then mx, my = x, y end
        end
    end)

    local md = {}
    for _, t in ipairs(targets) do
        local bestD = math.huge
        local onScr = false
        local pts = {}
        if t.head then pts[#pts + 1] = t.head end
        if t.root then pts[#pts + 1] = t.root end
        for i = 1, #pts do
            local okp, p = pcall(function() return pts[i].Position end)
            if okp and p then
                local sp, vis = WorldToScreen(p)
                if vis and sp then
                    if sp.X >= 0 and sp.X <= vpX and sp.Y >= 0 and sp.Y <= vpY then
                        onScr = true
                    end
                    local dx, dy = sp.X - mx, sp.Y - my
                    local d = math.sqrt(dx * dx + dy * dy)
                    if d < bestD then bestD = d end
                end
            end
        end
        md[t.uid] = { d = bestD, on = onScr }
    end
    mdist = md

    local t = lockedUid and targetByUid[lockedUid] or nil

    -- Target gone (died / left / filtered out)
    if lockedUid and not t then
        lostSince = lostSince or now
        if (not S.retarget) and (now - lostSince) > DEATH_GRACE then
            doUnlock()   -- retarget OFF: drop the lock, don't re-lock on respawn
        end
    elseif t then
        lostSince = nil
    end

    local onScreen = (t and md[t.uid] and md[t.uid].on) or false
    local los = true
    if S.requireLOS and t then
        if visState.uid == lockedUid then los = visState.vis else los = true end
    end

    local settling = t and (now - lastLockAt) < SETTLE

    local state = "IDLE"
    if not S.enabled then
        state = "PAUSED"
    elseif lockedUid and not t then
        state = "LOST"
    elseif t then
        if settling then
            state = "SETTLING"
        elseif not onScreen then
            state = "OFF SCREEN"
        elseif not los then
            state = "NO LOS"
        else
            state = "FIRING"
        end
    end

    if reloading then state = "RELOADING" end

    if state == "FIRING" then
        if (now - lastShot) >= RATE then
            lastShot = now
            if S.cycle then
                local code = cycleKeys[cycIndex]
                if code then
                    if cycStage == 0 then
                        pcall(function() keypress(code) end)
                        cycStage = 1
                    else
                        pcall(function() keyrelease(code) end)
                        cycStage = 0
                        cycIndex = cycIndex + 1
                        if cycIndex > #cycleKeys then cycIndex = 1 end
                    end
                end
            end
            pcall(function() mouse1click() end)
        end
    else
        releaseCycle()
    end

    -- AIM ASSIST
    if S.aim and t and S.enabled and not reloading and not capture then
        local active = true
        pcall(function() active = isrbxactive() end)

        if active then
            local part = t.root
            if S.aimIdx == 0 then part = t.head or t.root end

            if part then
                local okp, pos = pcall(function() return part.Position end)
                if okp and pos then
                    if S.predict then
                        local okv, vel = pcall(function() return part.Velocity end)
                        if okv and vel then
                            pos = pos + Vector3.new(vel.X, 0, vel.Z) * LEAD_TIME
                        end
                    end

                    local sp, vis = WorldToScreen(pos)
                    if vis and sp then
                        local dx, dy = sp.X - mx, sp.Y - my
                        local dist = math.sqrt(dx * dx + dy * dy)
                        if dist > AIM_DEADZONE then
                            local k = (S.aimStr or 40) / 100
                            local stepX = math.max(-AIM_MAX_STEP, math.min(AIM_MAX_STEP, dx * k))
                            local stepY = math.max(-AIM_MAX_STEP, math.min(AIM_MAX_STEP, dy * k))
                            local ix = math.floor(stepX + (stepX >= 0 and 0.5 or -0.5))
                            local iy = math.floor(stepY + (stepY >= 0 and 0.5 or -0.5))
                            if ix ~= 0 or iy ~= 0 then
                                pcall(function() mousemoverel(ix, iy) end)
                            end
                        end
                    end
                end
            end
        end
    end

    local y = 12
    if capture then
        ovText.Color = COL_SETTLE
        setRight(ovText, vpX, y, "REBIND " .. capture:upper() .. ": press a key now")
    elseif state == "RELOADING" then
        ovText.Color = COL_SETTLE
        setRight(ovText, vpX, y, "RELOADING ALL...")
    elseif state == "PAUSED" then
        ovText.Color = COL_PAUSE
        setRight(ovText, vpX, y, "TRIGGER PAUSED  (enable toggle in menu)")
    elseif lockedUid then
        local dtxt = (t and t.dist < math.huge) and string.format("  %.0f st", t.dist) or ""
        local ttxt = (t and t.team) and ("  [" .. t.team .. "]") or ""
        local atxt = (S.aim and t) and "  +AIM" or ""
        local htxt = (t and t.hostileInmate) and "  [FLAGGED]" or ""
        if state == "FIRING" then
            ovText.Color = COL_FIRE
        elseif state == "SETTLING" then
            ovText.Color = COL_SETTLE
        else
            ovText.Color = COL_WAIT
        end
        setRight(ovText, vpX, y, "LOCKED: " .. tostring(lockedName) .. dtxt .. ttxt .. atxt .. htxt .. "  [" .. state .. "]")
    else
        ovText.Color = COL_IDLE
        setRight(ovText, vpX, y, "UNLOCKED  " .. #targets .. " targets")
    end
    ovText.Visible = true

    -- LOCKED TARGET BOX
    if S.esp and t and t.root and not capture and not reloading then
        local headPart = t.head or t.root
        local okh, hp = pcall(function() return headPart.Position end)
        local okr, rp = pcall(function() return t.root.Position end)
        if okh and okr and hp and rp then
            local top, v1 = WorldToScreen(hp + Vector3.new(0, 0.7, 0))
            local bot, v2 = WorldToScreen(rp - Vector3.new(0, 3.2, 0))
            if v1 and v2 and top and bot then
                local h = bot.Y - top.Y
                if h > 2 then
                    local w = h * 0.5
                    box.Position = Vector2.new(top.X - w * 0.5, top.Y)
                    box.Size = Vector2.new(w, h)
                    if state == "FIRING" then
                        box.Color = COL_FIRE
                    elseif state == "SETTLING" then
                        box.Color = COL_SETTLE
                    else
                        box.Color = COL_WAIT
                    end
                    box.Visible = true
                else
                    box.Visible = false
                end
            else
                box.Visible = false
            end
        else
            box.Visible = false
        end
    else
        box.Visible = false
    end

    -- ========================================================
    -- INMATE IMAGE ESP  (EXACTLY ONE icon, or none)
    --   Trespassing == true          -> cuffs
    --   Hostile == true (not arrest) -> angry face
    --   neither                      -> nothing
    -- Icon size scales with distance from the camera:
    --   size = base * REF_DIST / distance   (clamped)
    -- ========================================================
    local inmateIdx = 0
    if S.inmateESP and not capture and not reloading then
        local baseSize = S.markerSize
        local minSize  = baseSize * MARKER_MIN_FACTOR
        local maxSize  = baseSize * MARKER_MAX_FACTOR

        for _, inmate in ipairs(inmates) do
            if inmateIdx >= INMATE_POOL then break end

            local showArrest = inmate.arrest == true
            local showAggro  = (inmate.aggro == true) and not showArrest

            if inmate.head and (showAggro or showArrest) then
                local okh2, hp2 = pcall(function() return inmate.head.Position end)
                if okh2 and hp2 then
                    local sp, vis = WorldToScreen(hp2 + Vector3.new(0, 2.2, 0))
                    if vis and sp then
                        inmateIdx = inmateIdx + 1
                        local slot = inmatePool[inmateIdx]

                        -- distance-based size
                        local sz = baseSize
                        if S.scaleMarkers and camPos then
                            local d = (hp2 - camPos).Magnitude
                            sz = baseSize * MARKER_REF_DIST / math.max(d, 1)
                            sz = math.max(minSize, math.min(maxSize, sz))
                        end
                        sz = math.floor(sz + 0.5)
                        local half = sz / 2

                        if showArrest then
                            if USE_TEXT_ARREST_FALLBACK then
                                slot.arrest.Size = math.max(10, math.floor(sz * 0.6))
                                slot.arrest.Position = Vector2.new(sp.X, sp.Y - sz * 0.3)
                            else
                                slot.arrest.Size = Vector2.new(sz, sz)
                                slot.arrest.Position = Vector2.new(sp.X - half, sp.Y - half)
                            end
                            slot.arrest.Visible = true
                            slot.aggro.Visible  = false
                        else
                            slot.aggro.Size = Vector2.new(sz, sz)
                            slot.aggro.Position = Vector2.new(sp.X - half, sp.Y - half)
                            slot.aggro.Visible  = true
                            slot.arrest.Visible = false
                        end
                    end
                end
            end
        end
    end

    for i = inmateIdx + 1, INMATE_POOL do
        inmatePool[i].aggro.Visible  = false
        inmatePool[i].arrest.Visible = false
    end
end)

