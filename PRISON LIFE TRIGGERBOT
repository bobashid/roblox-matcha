local function isSeeThrough(inst)
    if not inst then return true end
    local tr, ltm, cq, cc, mat, nm
    pcall(function() tr = inst.Transparency end)
    pcall(function() ltm = inst.LocalTransparencyModifier end)
    pcall(function() cq = inst.CanQuery end)
    pcall(function() cc = inst.CanCollide end)
    if type(tr) == "number" and tr >= 0.95 then return true end
    if type(ltm) == "number" and ltm >= 0.8 then return true end
    if cq == false then return true end
    if cc == false then return true end
    pcall(function() nm = inst.Name end)
    if type(nm) == "string" then
        local s = nm:lower()
        if s:find("glass",1,true) or s:find("window",1,true) or s:find("windshield",1,true)
            or s:find("screen",1,true) or s:find("visor",1,true) then
            return true
        end
    end
    pcall(function() mat = inst.Material end)
    if mat ~= nil then
        local ok, mn = pcall(function() return mat.Name end)
        if ok and type(mn) == "string" and mn:lower():find("glass",1,true) then return true end
    end
    if type(tr) == "number" and tr >= 0.8 then return true end
    return false
end

local charPartSet = {}
local function rebuildCharPartSet(chars)
    local s = {}
    for ch in pairs(chars) do
        local ok, desc = pcall(function() return ch:GetDescendants() end)
        if ok and desc then
            for i = 1, #desc do
                local d = desc[i]
                local okB, isB = pcall(function() return d:IsA("BasePart") end)
                if okB and isB then s[d] = true end
            end
        end
    end
    return s
end
local function isOtherPlayerPart(inst)
    return inst ~= nil and charPartSet[inst] == true
end

local function traceRay(origin, goal, targetChar, localChar)
    if not origin or not goal then return false, goal, nil end
    local o = origin
    for _ = 1, RAY_MAX_BOUNCE do
        local diff = goal - o
        local dist = diff.Magnitude
        if dist < RAY_GAP then return true, goal, nil end
        local dir = diff.Unit
        local ok, res = pcall(function() return Workspace:Raycast(o, diff, shotParams) end)
        if not ok then return false, goal, nil end
        if not res or not res.Instance then return true, goal, nil end
        local inst = res.Instance
        local rd = res.Distance or 0
        if (dist - rd) < RAY_GAP then return true, res.Position, inst end

        if targetChar and isDescendantOf(inst, targetChar) then
            return true, res.Position, inst
        elseif localChar and isDescendantOf(inst, localChar) then
            o = res.Position + dir * RAY_GAP
        elseif isOtherPlayerPart(inst) then
            o = res.Position + dir * RAY_GAP
        elseif isSeeThrough(inst) then
            o = res.Position + dir * RAY_GAP
        else
            return false, res.Position, inst
        end
    end
    return false, goal, nil
end

