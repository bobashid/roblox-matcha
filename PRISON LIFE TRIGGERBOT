-- ============================================================
-- TRIGGER BOT v16  (fast Reload All)
-- Lock:  closest to mouse cursor, within 100 px
-- Settle: 0.15 s after a lock/switch before firing
-- Fire rate: max (every frame)
-- On screen is ALWAYS required. Own team targetable via toggles.
-- Rebind: flip the Rebind toggle, then press the key you want.
-- Reload All: press the bound key to reload every gun slot fast.
-- STOP:  _G.__TRIGGER_STOP()   (or kill the script)
-- ============================================================
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")
