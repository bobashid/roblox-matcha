-- RELOAD ALL
-- ============================================================
local function tap(code, hold)
    pcall(function() keypress(code) end)
    task.wait(hold or RL_TAP)
    pcall(function() keyrelease(code) end)
end

local function doReloadAll()
    if reloading then return end
    reloading = true
    local slots = cycleKeys
    pcall(function() notify("Reloading all", "Trigger", 1) end)
    log("reload all -> slots 1.." .. #slots .. " (0.01)")

    task.spawn(function()
        for i = 1, #slots do
            tap(slots[i], RL_TAP)
            task.wait(RL_GAP)
            tap(RELOAD_KEY, RL_TAP)
            task.wait(RL_SETTLE)
        end

        tap(slots[1], RL_TAP)
        pcall(function() keyrelease(RELOAD_KEY) end)

        reloading = false
        log("reload all done")
    end)
end

