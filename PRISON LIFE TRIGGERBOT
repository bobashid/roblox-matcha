-- ============================================================
-- DOT ENGINE
-- ============================================================
local offsetCache = {}
local function offsetsFor(sx, sy, sz)
    local key = math.floor(sx*10+0.5) .. "_" .. math.floor(sy*10+0.5) .. "_" .. math.floor(sz*10+0.5)
    local c = offsetCache[key]
    if c then return c end
    local hx, hy, hz = sx*0.5*SAMPLE_INSET, sy*0.5*SAMPLE_INSET, sz*0.5*SAMPLE_INSET
    c = {
        { hx,  hy,  hz}, { hx,  hy, -hz},
        { hx, -hy,  hz}, { hx, -hy, -hz},
        {-hx,  hy,  hz}, {-hx,  hy, -hz},
        {-hx, -hy,  hz}, {-hx, -hy, -hz},
        { hx, 0, 0}, {-hx, 0, 0},
        { 0,  hy, 0}, { 0, -hy, 0},
        { 0, 0,  hz}, { 0, 0, -hz},
    }
    offsetCache[key] = c
    return c
end

local samples = {}
local samplesChar = nil
local scanCursor = 0

local function buildSamples(t)
    local fresh = {}
    if t and t.parts then
        for _, part in ipairs(t.parts) do
            local size = sizeOf(part)
            if size then
                local offs = offsetsFor(size.X, size.Y, size.Z)
                local vis, world = {}, {}
                for k = 1, #offs do
                    vis[k] = false
                    world[k] = Vector3.new(0, 0, 0)
                end
                fresh[#fresh + 1] = { part = part, offs = offs, vis = vis, world = world, anyVis = false }
            end
        end
    end
    samples = fresh
    samplesChar = t and t.char or nil
    scanCursor = 0
end

local function scanSome(origin, targetChar, localChar)
    if not origin then return end
    local list = samples
    local n = #list
    if n == 0 then return end

    local limit
    if S.fullScan then limit = n
    else limit = math.min(PARTS_PER_SCAN, n) end

    for _ = 1, limit do
        if list ~= samples then return end
        scanCursor = scanCursor + 1
        if scanCursor > n then scanCursor = 1 end
        local s = list[scanCursor]
        if s and s.part then
            local pos, R, U, L = frameOf(s.part)
            if pos then
                local offs = s.offs
                local odx, ody, odz = origin.X - pos.X, origin.Y - pos.Y, origin.Z - pos.Z
                local any = false
                for k = 1, #offs do
                    local o = offs[k]
                    local wx = R.X*o[1] + U.X*o[2] + L.X*o[3]
                    local wy = R.Y*o[1] + U.Y*o[2] + L.Y*o[3]
                    local wz = R.Z*o[1] + U.Z*o[2] + L.Z*o[3]
                    if (odx*wx + ody*wy + odz*wz) <= 0 then
                        s.vis[k] = false
                    else
                        local goal = Vector3.new(pos.X + wx, pos.Y + wy, pos.Z + wz)
                        local reached = traceRay(origin, goal, targetChar, localChar)
                        s.vis[k] = reached
                        if reached then any = true end
                    end
                end
                s.anyVis = any
            else
                s.anyVis = false
            end
        end
    end
end

-- ============================================================
-- LOCK
-- ============================================================
local curMX, curMY, curVX, curVY = 0, 0, 1920, 1080
local lockedUid, lockedName = nil, nil
local lostSince = nil
local lastVirtual = false

local function applyLock(t, how, value)
    if not t then
        pcall(function() notify("No valid target", "Trigger", 1) end)
        return
    end
    if lockedUid == t.uid then return end
    local switched = lockedUid ~= nil
    lockedUid, lockedName, lostSince = t.uid, t.name, nil
    buildSamples(t)
    local extra = ""
    if how == "mouse" and value then extra = string.format(" (%.0f px)", value) end
    if t.team then extra = extra .. " [" .. t.team .. "]" end
    if t.hostileInmate then extra = extra .. " [FLAGGED]" end
    log((switched and "Switched -> " or "Locked -> ") .. t.name .. extra)
    pcall(function() notify((switched and "Switched: " or "Locked: ") .. t.name, "Trigger", 1) end)
end

local function screenInfo(t)
    local bestD, onScr = math.huge, false
    for i = 1, 2 do
        local part = (i == 1) and t.head or t.root
        if part then
            local okp, p = pcall(function() return part.Position end)
            if okp and p then
                local sp, vis = WorldToScreen(p)
                if vis and sp then
                    if sp.X >= 0 and sp.X <= curVX and sp.Y >= 0 and sp.Y <= curVY then onScr = true end
                    local dx, dy = sp.X - curMX, sp.Y - curMY
                    local d = math.sqrt(dx*dx + dy*dy)
                    if d < bestD then bestD = d end
                end
            end
        end
    end
    return bestD, onScr
end

local function pickByMouse()
    local best, bestD = nil, math.huge
    for _, t in ipairs(targets) do
        local d, on = screenInfo(t)
        if on and d < bestD then bestD, best = d, t end
    end
    if best and (S.lockRadius <= 0 or bestD <= S.lockRadius) then return best, bestD end
    return nil
end

local function doUnlock()
    if lockedUid then
        log("Unlocked " .. tostring(lockedName))
        pcall(function() notify("Unlocked", "Trigger", 1) end)
    end
    lockedUid, lockedName, lostSince = nil, nil, nil
    buildSamples(nil)
end

-- ============================================================
-- FAST, CONSISTENT RELOAD ALL
--   Sequence per slot: select slot -> tap R -> next.
--   Between actions we use task.wait() with NO argument, which is
--   a plain scheduler yield (~16us), NOT the ms timer. The ms
--   timer (task.wait(0.001)) is what was stretching under load
--   and making the sequence feel slow and inconsistent.
--   Set RELOAD_USE_YIELD = false to fire every key in one frame.
-- ============================================================
local function doReloadAll()
    if reloadInFlight then return end
    reloadInFlight = true
    reloading = true
    local slots = cycleKeys
    local n = #slots
    pcall(function() notify("Reloading all", "Trigger", 1) end)
    task.spawn(function()
        local t0 = os.clock()
        local ok, err = pcall(function()
            if n < 1 then return end
            for i = 1, n do
                local code = slots[i]
                pcall(function() keypress(code) end)
                pcall(function() keyrelease(code) end)
                if RELOAD_USE_YIELD then task.wait() end

                pcall(function() keypress(RELOAD_KEY) end)
                pcall(function() keyrelease(RELOAD_KEY) end)
                if RELOAD_USE_YIELD then task.wait() end
            end
            -- ensure we end on slot 1
            pcall(function() keypress(slots[1]) end)
            pcall(function() keyrelease(slots[1]) end)
        end)
        local total = os.clock() - t0
        reloading = false
        reloadInFlight = false
        if not ok then log("reload error: " .. tostring(err)) end
        if RELOAD_LOG and n >= 1 then
            log(string.format("reload all: %d slots in %.3fs (%.2fms/slot)",
                n, total, (total / n) * 1000))
        end
    end)
end

task.spawn(function()
    while running do
        if pendingReload and not reloadInFlight then
            pendingReload = false
            doReloadAll()
        end
        task.wait(0.01)
    end
end)

