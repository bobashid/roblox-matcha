-- FAST HELPERS (no closures in hot paths)
-- ============================================================
local function readFrame(part)
    local cf = part.CFrame
    return cf.Position, cf.RightVector, cf.UpVector, cf.LookVector
end

local function readPos(part) return part.Position end
local function readSize(part) return part.Size end
local function readParent(inst) return inst.Parent end
local function readBounds(obj) return obj.TextBounds end

local function partPos(p)
    if not p then return nil end
    local ok, pos = pcall(readPos, p)
    if ok and pos then return pos end
    return nil
end

local function frameOf(part)
    if not part then return nil end
    local ok, pos, R, U, L = pcall(readFrame, part)
    if ok and pos then return pos, R, U, L end
    return nil
end

local function sizeOf(part)
    if not part then return nil end
    local ok, s = pcall(readSize, part)
    if ok and s then return s end
    return nil
end

local function isDescendantOf(inst, ancestor)
    if not inst or not ancestor then return false end
    local cur = inst
    local depth = 0
    while cur and depth < DESCEND_DEPTH do
        if cur == ancestor then return true end
        local ok, p = pcall(readParent, cur)
        if not ok then return false end
        cur = p
        depth = depth + 1
    end
    return false
end

local function underCharacter(inst, ch) return isDescendantOf(inst, ch) end

local function partIsHead(part, headRef)
    if not part then return false end
    if headRef and part == headRef then return true end
    local nm
    pcall(function() nm = part.Name end)
    if type(nm) ~= "string" then return false end
    return HEAD_NAMES[nm] == true
end

