    .. keyName(binds.unlock) .. "=unlock  " .. keyName(binds.reload) .. "=reload all")
log("lock radius 100 px | settle 0.15 s | fire rate max | reload fast")
log("teams: " .. table.concat(TEAM_LIST, ", "))
