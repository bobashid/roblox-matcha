local MUZZLE_NAMES = { "Muzzle", "MuzzleFlash", "Barrel", "Tip", "FirePoint", "GunTip", "Nozzle" }

local function partPos(p)
    local ok, pos = pcall(function() return p.Position end)
    if ok and pos then return pos end
    return nil
end

-- Walk up from a part to see whether it still lives under the
-- character. An unequipped Tool sits in Backpack, so its Parent
-- is still non-nil and the old "alive" test wrongly passed.
local function underCharacter(inst, ch)
    if not inst or not ch then return false end
    local cur = inst
    local depth = 0
    while cur and depth < DESCEND_DEPTH do
        if cur == ch then return true end
        local ok, p = pcall(function() return cur.Parent end)
        if not ok then return false end
        cur = p
        depth = depth + 1
    end
    return false
end

local lastGunChar = nil
local cachedMuzzle = nil

local function scanForGunPart(ch)
    local okc, kids = pcall(function() return ch:GetChildren() end)
    if not okc or not kids then return nil end
    for i = 1, #kids do
        local tool = kids[i]
        local cls
        pcall(function() cls = tool.ClassName end)
        if cls == "Tool" then
            local okd, desc = pcall(function() return tool:GetDescendants() end)
            if okd and desc then
                for _, nm in ipairs(MUZZLE_NAMES) do
                    for j = 1, #desc do
                        local d = desc[j]
                        local dn
                        pcall(function() dn = d.Name end)
                        if dn == nm then return d end
                    end
                end
            end
            local h
            pcall(function() h = tool:FindFirstChild("Handle") end)
            if h then return h end
        end
    end
    return nil
end

local function getRealGunOrigin()
    local ch = lp.Character
    if not ch then
        lastGunChar, cachedMuzzle = nil, nil
        return nil
    end
    if ch ~= lastGunChar then
        lastGunChar = ch
        cachedMuzzle = scanForGunPart(ch)
    end

    -- Cache is only trusted while the tool is actually equipped
    -- on the character. Unequipped tools live in Backpack.
    if cachedMuzzle and underCharacter(cachedMuzzle, ch) then
        return partPos(cachedMuzzle)
    end

    -- Rescan: picks up a newly equipped gun, returns nil while unarmed.
    cachedMuzzle = scanForGunPart(ch)
    if cachedMuzzle and underCharacter(cachedMuzzle, ch) then
        return partPos(cachedMuzzle)
    end
    cachedMuzzle = nil
    return nil
end

-- cached by the collector
local cachedMyRoot, cachedMyHead = nil, nil

local function getCharFacing()
    local root = cachedMyRoot
    if not root then
        local ch = lp.Character
        if ch then
            root = ch:FindFirstChild("HumanoidRootPart")
                or ch:FindFirstChild("UpperTorso")
                or ch:FindFirstChild("Torso")
        end
    end
    if root then
        local ok, cf = pcall(function() return root.CFrame end)
        if ok and cf then return cf.LookVector end
    end
    local cam = Workspace.CurrentCamera
    if cam then
        local ok, look = pcall(function() return cam.CFrame.LookVector end)
        if ok and look then return look end
    end
    return Vector3.new(0, 0, -1)
end

local function getAimDir()
    local cam = Workspace.CurrentCamera
    if cam then
        local ok, look = pcall(function() return cam.CFrame.LookVector end)
        if ok and look then return look end
    end
    return getCharFacing()
end

local function getCharRight()
    local root = cachedMyRoot
    if not root then
        local ch = lp.Character
        if ch then
            root = ch:FindFirstChild("HumanoidRootPart")
                or ch:FindFirstChild("UpperTorso")
                or ch:FindFirstChild("Torso")
                or ch:FindFirstChild("Head")
        end
    end
    if root then
        local ok, cf = pcall(function() return root.CFrame end)
        if ok and cf then return cf.RightVector end
    end
    local cam = Workspace.CurrentCamera
    if cam then
        local ok, cf = pcall(function() return cam.CFrame end)
        if ok and cf then return cf.RightVector end
    end
    return Vector3.new(1, 0, 0)
end

local function getVirtualGunOrigin()
    local head = cachedMyHead
    if not head then
        local ch = lp.Character
        if ch then head = ch:FindFirstChild("Head") end
    end
    local headPos = head and partPos(head) or nil
    local right = getCharRight()
    local fwd   = getAimDir()

    if headPos then
        return headPos
            + right * VGUN_RIGHT
            + fwd   * VGUN_FORWARD
            - Vector3.new(0, VGUN_DOWN, 0)
    end

    local cam = Workspace.CurrentCamera
    if cam then
        local cpos, clook, cright
        pcall(function() cpos  = cam.CFrame.Position end)
        pcall(function() clook = cam.CFrame.LookVector end)
        pcall(function() cright = cam.CFrame.RightVector end)
        if cpos and clook then
            cright = cright or Vector3.new(1,0,0)
            return cpos + cright * VGUN_RIGHT + clook * (VGUN_FORWARD + 0.5)
                - Vector3.new(0, VGUN_DOWN, 0)
        end
    end
    return nil
end

local function getShotOrigin()
    local real = getRealGunOrigin()
    if real then return real, false end
    if S.simGun then
        return getVirtualGunOrigin(), true
    end
    return nil, false
end

