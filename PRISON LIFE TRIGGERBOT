-- ============================================================
-- TARGET COLLECTOR (30 Hz, cached body parts)
-- ============================================================
local AIM_NAMES = {
    "Head", "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart",
    "RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm",
    "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg",
    "RightHand", "LeftHand", "Right Arm", "Left Arm", "Right Leg", "Left Leg",
}
local ROOT_NAMES = { "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head" }
local LOS_NAMES  = { Head=true, UpperTorso=true, HumanoidRootPart=true, Torso=true, LowerTorso=true }
local PART_CLASS = {
    Part = true, MeshPart = true, UnionOperation = true, WedgePart = true,
    TrussPart = true, CornerWedgePart = true, Seat = true, VehicleSeat = true,
    SpawnLocation = true,
}

local targets     = {}
local targetByUid = {}
local cache       = {}

local wallParams = RaycastParams.new()
pcall(function() wallParams.FilterType = Enum.RaycastFilterType.Exclude end)
pcall(function() wallParams.IgnoreWater = true end)
pcall(function() wallParams.RespectCanCollide = false end)
pcall(function() wallParams.FilterDescendantsInstances = {} end)

local function resolveBody(ch)
    local parts, losParts = {}, {}
    for _, nm in ipairs(AIM_NAMES) do
        local part = ch:FindFirstChild(nm)
        if part then
            local ok, cls = pcall(function() return part.ClassName end)
            if ok and PART_CLASS[cls] then
                parts[#parts + 1] = part
                if LOS_NAMES[nm] then losParts[#losParts + 1] = part end
            end
        end
    end
    local head = ch:FindFirstChild("Head")
    local root
    for _, nm in ipairs(ROOT_NAMES) do
        root = ch:FindFirstChild(nm)
        if root then break end
    end
    if not head then head = root end
    if #parts == 0 and root then parts[1] = root end
    if #losParts == 0 then losParts = parts end
    return parts, root, head, losParts
end

task.spawn(function()
    while running do
        local now = os.clock()
        pcall(function() myTeamName = (lp.Team and lp.Team.Name) or nil end)

        local myPos
        local myChar = lp.Character
        if myChar then
            for _, nm in ipairs(ROOT_NAMES) do
                local r = myChar:FindFirstChild(nm)
                if r then
                    pcall(function() myPos = r.Position end)
                    break
                end
            end
        end

        local out, byUid, seen, filter = {}, {}, {}, {}
        for _, p in ipairs(Players:GetPlayers()) do
            local ch = p.Character
            if ch then filter[#filter + 1] = ch end

            local uid = p.UserId
            if uid ~= myUserId and ch then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local alive = false
                if hum then
                    local okh, hp = pcall(function() return hum.Health end)
                    alive = okh and type(hp) == "number" and hp > 0
                end
                if alive then
                    local tName
                    pcall(function() tName = (p.Team and p.Team.Name) or nil end)
                    if tName and TEAM_TARGET[tName] == nil then
                        TEAM_TARGET[tName] = true
                        log("new team seen: " .. tName)
                    end
                    if isHostile(tName) then
                        local addr
                        pcall(function() addr = ch.Address end)
                        local c = cache[uid]
                        if not c or c.addr ~= addr or (now - c.t) > 1.5 then
                            local parts, root, head, losParts = resolveBody(ch)
                            c = { addr = addr, t = now, parts = parts, root = root, head = head, los = losParts }
                            cache[uid] = c
                        end
                        if c.root and #c.parts > 0 then
                            local dist
                            if myPos then
                                local ok2, rp = pcall(function() return c.root.Position end)
                                if ok2 and rp then dist = (rp - myPos).Magnitude end
                            end
                            local t = { uid = uid, name = p.Name, team = tName,
                                        parts = c.parts, los = c.los, root = c.root, head = c.head,
                                        dist = dist or math.huge }
                            out[#out + 1] = t
                            byUid[uid] = t
                            seen[uid] = true
                        end
                    end
                end
            end
        end
        for uid in pairs(cache) do
            if not seen[uid] then cache[uid] = nil end
        end

        targets, targetByUid = out, byUid
        pcall(function() wallParams.FilterDescendantsInstances = filter end)
        task.wait(0.033)
    end
end)

-- ============================================================
-- LINE OF SIGHT
-- ============================================================
local lastBlocker = nil
local SAMPLE_OFFSETS = {
    Vector3.new(0, 0, 0),
    Vector3.new(0, 0.6, 0),
    Vector3.new(0, -0.6, 0),
    Vector3.new(0.6, 0, 0),
    Vector3.new(-0.6, 0, 0),
}

local function castClear(origin, goal)
    local o = origin
    for _ = 1, 6 do
        local dir = goal - o
        local dist = dir.Magnitude
        if dist < 0.3 then return true end
        local ok, res = pcall(function() return Workspace:Raycast(o, dir, wallParams) end)
        if not ok or not res then return true end
        local inst = res.Instance
        if not inst then return true end

        local rd = nil
        pcall(function() rd = res.Distance end)
        if type(rd) == "number" and (dist - rd) < 1.0 then return true end

        local pass = false
        pcall(function()
            local tr = inst.Transparency
            if type(tr) == "number" and tr >= 0.8 then pass = true end
        end)
        if not pass then
            pcall(function() if inst.CanCollide == false then pass = true end end)
        end
        if not pass then
            local okn, nm = pcall(function() return inst:GetFullName() end)
            lastBlocker = okn and nm or "?"
            return false
        end
        o = res.Position + dir.Unit * 0.1
    end
    return false
end

local function canSee(losParts, origins)
    for i = 1, #losParts do
        local ok, base = pcall(function() return losParts[i].Position end)
        if ok and base then
            for _, off in ipairs(SAMPLE_OFFSETS) do
                local pt = base + off
                for _, o in ipairs(origins) do
                    if castClear(o, pt) then return true end
                end
            end
        end
    end
    return false
end

local function getOrigins()
    local origins = {}
    local ch = lp.Character
    if ch then
        for _, tool in ipairs(ch:GetChildren()) do
            if tool.ClassName == "Tool" then
                local h = tool:FindFirstChild("Handle")
                if h then
                    local ok, p = pcall(function() return h.Position end)
                    if ok and p then origins[#origins + 1] = p end
                end
            end
        end
        for _, nm in ipairs({ "RightHand", "Right Arm", "Head" }) do
            local part = ch:FindFirstChild(nm)
            if part then
                local ok, p = pcall(function() return part.Position end)
                if ok and p then origins[#origins + 1] = p break end
            end
        end
    end
    local cam = Workspace.CurrentCamera
    if cam then
        local ok, p = pcall(function() return cam.CFrame.Position end)
        if ok and p then origins[#origins + 1] = p end
    end
    return origins
end

-- ============================================================
-- LOCK STATE
-- ============================================================
local lockedUid, lockedName = nil, nil
local lostSince = nil
local visState = { uid = nil, vis = true }
local mdist = {}
local lastLockAt = 0

local function applyLock(t, how, value)
    if not t then
        pcall(function() notify("No valid target", "Trigger", 1) end)
        return
    end
    if lockedUid == t.uid then return end
    local switched = lockedUid ~= nil
    lockedUid, lockedName, lostSince = t.uid, t.name, nil
    visState.uid, visState.vis = nil, true
    lastLockAt = os.clock()
    local extra = ""
    if how == "mouse" and value then
        extra = string.format(" (%.0f px)", value)
    end
    if t.team then extra = extra .. " [" .. t.team .. "]" end
    log((switched and "Switched -> " or "Locked -> ") .. t.name .. extra)
    pcall(function() notify((switched and "Switched: " or "Locked: ") .. t.name, "Trigger", 1) end)
end

local function pickByMouse()
    local best, bestD = nil, math.huge
    for _, t in ipairs(targets) do
        local m = mdist[t.uid]
        if m and m.d < bestD then bestD, best = m.d, t end
    end
    if best and bestD <= LOCK_RADIUS then return best, bestD end
    return nil
end

local function doUnlock()
    if lockedUid then
        log("Unlocked " .. tostring(lockedName))
        pcall(function() notify("Unlocked", "Trigger", 1) end)
    end
    lockedUid, lockedName, lostSince = nil, nil, nil
end

-- ============================================================
-- RELOAD ALL  (fast - one frame per step, like the fire loop)
-- ============================================================
local function tap(code, hold)
    pcall(function() keypress(code) end)
    task.wait(hold or RL_TAP)
    pcall(function() keyrelease(code) end)
end

local function doReloadAll()
    if reloading then return end
    reloading = true
    pcall(function() notify("Reloading all", "Trigger", 1) end)
    log("reload all -> fast cycle")

    task.spawn(function()
        for _, slot in ipairs(CYCLE_KEYS) do
            tap(slot, RL_TAP)
            task.wait(RL_GAP)
            tap(binds.reload, RL_TAP)
            task.wait(RL_SETTLE)
        end

        -- back to slot 1 so the trigger bot keeps firing the first gun
        tap(CYCLE_KEYS[1], RL_TAP)

        -- make sure no reload key is stuck down
        pcall(function() keyrelease(binds.reload) end)

        reloading = false
        log("reload all done")
    end)
end

-- ============================================================
-- WALL CHECK LOOP
-- ============================================================
task.spawn(function()
    local blockStreak = 0
    local lastCheckUid = nil
    while running do
        local uid = lockedUid
        local t = uid and targetByUid[uid]
        if t and t.los then
            if uid ~= lastCheckUid then
                blockStreak = 0
                lastCheckUid = uid
            end
            local origins = getOrigins()
            if #origins > 0 then
                lastBlocker = nil
                local vis = canSee(t.los, origins)
                if vis then
                    blockStreak = 0
                    visState.uid, visState.vis = uid, true
                else
                    blockStreak = blockStreak + 1
                    if blockStreak >= 3 then
                        visState.uid, visState.vis = uid, false
                    end
                end
            end
        else
            lastCheckUid = uid
            blockStreak = 0
        end
        task.wait(0.02)
    end
end)

-- ============================================================
-- KEY INPUT
-- ============================================================
local latch, wasDown, lastFire = {}, {}, {}

local function trigger(action)
    if capture then return end
    if action == "reload" and not S.reloadAll then return end
    if reloading and action ~= "reload" then return end

    local now = os.clock()
    if lastFire[action] and (now - lastFire[action]) < 0.2 then return end
    lastFire[action] = now

    if action == "lock" then
        local t, d = pickByMouse()
        applyLock(t, "mouse", d)
    elseif action == "unlock" then
        doUnlock()
    elseif action == "reload" then
        doReloadAll()
    end
end

local function pollDown(raw)
    if not raw then return false end
    local d = false
    pcall(function() d = UIS:IsKeyDown(raw) end)
    if d == true then return true end
    pcall(function() d = iskeypressed(raw) end)
    return d == true
end

pcall(function()
    connBegan = UIS.InputBegan:Connect(function(input)
        local code
        pcall(function() code = input.KeyCode end)
        if type(code) ~= "number" then return end

        if capture then
            local act = capture
            capture = nil
            pcall(function() UI.SetValue("rebind_" .. act, false) end)
            setBind(act, code, "capture")
            return
        end

        if reloading then return end

        for _, act in ipairs(ACTIONS) do
            if binds[act] == code then latch[act] = true end
        end
    end)
end)

task.spawn(function()
    while running do
        for _, act in ipairs(ACTIONS) do
            if reloading then break end
            local raw = binds[act]
            local down = pollDown(raw)
            if down and not wasDown[act] then trigger(act) end
            wasDown[act] = down
            if latch[act] then
                latch[act] = nil
                trigger(act)
            end
        end
        task.wait(0.01)
    end
end)

