local function renderFrame()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local vpX, vpY = vp.X, vp.Y
    local now = os.clock()

    local myRootP = nil
    do
        local r = getMyRoot()
        if r then myRootP = partPos(r) end
    end

    if testImg and testImg.Visible then
        testImg.Position = Vector2.new(vpX / 2 - 48, vpY / 2 - 48)
    end

    local mx, my = vpX / 2, vpY / 2
    pcall(function()
        local m = lp:GetMouse()
        if m then
            local x, y = m.X, m.Y
            if type(x) == "number" and type(y) == "number" then mx, my = x, y end
        end
    end)
    curMX, curMY, curVX, curVY = mx, my, vpX, vpY

    local t = lockedUid and targetByUid[lockedUid] or nil

    if lockedUid and not t then
        lostSince = lostSince or now
        if (not S.retarget) and (now - lostSince) > DEATH_GRACE then
            doUnlock()
        end
    elseif t then
        lostSince = nil
    end

    local dotsDrawn = 0
    local greenTotal = 0
    local headAim, headAimD = nil, math.huge
    local bodyAim, bodyAimD = nil, math.huge
    local headRef = t and t.head or nil

    local shotOrigin, isVirtual = getShotOrigin()
    local beamOriginS, beamOriginV = nil, false
    if shotOrigin then beamOriginS, beamOriginV = WorldToScreen(shotOrigin) end

    local list = samples
    local sn = #list

    local wantAim = S.aim and S.enabled
    local needDots = (S.showDots and t) or (wantAim and t)

    if needDots and sn > 0 and not capture and not reloading then
        for i = 1, sn do
            if dotsDrawn >= DOT_POOL then break end
            local s = list[i]
            if s and s.part then
                local pos, R, U, L = frameOf(s.part)
                if pos then
                    local offs = s.offs
                    local isHeadPart = partIsHead(s.part, headRef)
                    for k = 1, #offs do
                        if dotsDrawn >= DOT_POOL then break end
                        local o = offs[k]
                        local wx = R.X*o[1] + U.X*o[2] + L.X*o[3]
                        local wy = R.Y*o[1] + U.Y*o[2] + L.Y*o[3]
                        local wz = R.Z*o[1] + U.Z*o[2] + L.Z*o[3]
                        local world = Vector3.new(pos.X + wx, pos.Y + wy, pos.Z + wz)
                        s.world[k] = world
                        dotsDrawn = dotsDrawn + 1
                        local d = dotPool[dotsDrawn]
                        local beam = beamPool[dotsDrawn]
                        local vis = s.vis[k]

                        if vis then greenTotal = greenTotal + 1 end

                        local sp, on = WorldToScreen(world)
                        if on and sp then
                            if S.showDots then
                                d.Position = Vector2.new(sp.X, sp.Y)
                                d.Color = vis and COL_DOT_OK or COL_DOT_BAD
                                d.Visible = true
                                if S.showDotBeams and beamOriginV and beam then
                                    beam.From = Vector2.new(beamOriginS.X, beamOriginS.Y)
                                    beam.To   = Vector2.new(sp.X, sp.Y)
                                    beam.Color = vis and COL_BEAM_OK or COL_BEAM_BAD
                                    beam.Visible = true
                                elseif beam then
                                    beam.Visible = false
                                end
                            else
                                d.Visible = false
                                if beam then beam.Visible = false end
                            end

                            if wantAim and vis and not capture and not reloading then
                                local dx, dy = sp.X - mx, sp.Y - my
                                local dist = math.sqrt(dx*dx + dy*dy)
                                if dist <= AIM_FOV_INTERNAL then
                                    if isHeadPart then
                                        if dist < headAimD then
                                            headAimD = dist
                                            headAim = sp
                                        end
                                    else
                                        if dist < bodyAimD then
                                            bodyAimD = dist
                                            bodyAim = sp
                                        end
                                    end
                                end
                            end
                        else
                            d.Visible = false
                            if beam then beam.Visible = false end
                        end
                    end
                end
            end
        end
    end
    for i = dotsDrawn + 1, DOT_POOL do
        dotPool[i].Visible = false
        beamPool[i].Visible = false
    end

    if not needDots and t then
        for i = 1, sn do
            local s = list[i]
            if s then
                local vis = s.vis
                for k = 1, #vis do
                    if vis[k] then greenTotal = greenTotal + 1 end
                end
            end
        end
    end

    local aimDot = headAim or bodyAim

    local fireOk = false
    if t and S.enabled and not reloading and not capture then
        if greenTotal >= MIN_GREEN_FIXED then fireOk = true end
    end

    local state = "IDLE"
    if not S.enabled then state = "PAUSED"
    elseif lockedUid and not t then state = "LOST"
    elseif t then
        if greenTotal == 0 then state = "NO LOS"
        else state = "FIRING" end
    end
    if reloading then state = "RELOADING" end

    if fireOk then
        if (now - lastShot) >= RATE then
            lastShot = now
            if S.cycle then
                local code = cycleKeys[cycIndex]
                if code then
                    if cycStage == 0 then
                        pcall(function() keypress(code) end)
                        cycStage = 1
                    else
                        pcall(function() keyrelease(code) end)
                        cycStage = 0
                        cycIndex = cycIndex + 1
                        if cycIndex > #cycleKeys then cycIndex = 1 end
                    end
                end
            end
            pcall(function() mouse1click() end)
        end
    else
        releaseCycle()
    end

    -- ============================================================
    -- AIM: cursor lock via mousemoveabs (fallback mousemoverel)
    -- ============================================================
    if wantAim and t and not reloading and not capture and aimDot then
        local tx, ty = aimDot.X, aimDot.Y
        local strength = S.aimStr or 100
        if strength < 100 then
            local f = strength / 100
            tx = mx + (tx - mx) * f
            ty = my + (ty - my) * f
        end
        tx = math.floor(tx + 0.5)
        ty = math.floor(ty + 0.5)
        if HAS_MOUSEMOVEABS then
            local ok = pcall(mousemoveabs, tx, ty)
            if not ok then
                local ddx = math.floor(tx - mx + 0.5)
                local ddy = math.floor(ty - my + 0.5)
                if ddx ~= 0 or ddy ~= 0 then
                    pcall(mousemoverel, ddx, ddy)
                end
            end
        else
            local ddx = math.floor(tx - mx + 0.5)
            local ddy = math.floor(ty - my + 0.5)
            if ddx ~= 0 or ddy ~= 0 then
                pcall(mousemoverel, ddx, ddy)
            end
        end
    end

    local lasersDrawn = 0
    if S.showShotLine and t and shotOrigin and not capture and not reloading and beamOriginV then
        local l2 = samples
        for i = 1, #l2 do
            if lasersDrawn >= LASER_POOL then break end
            local s = l2[i]
            if s and s.anyVis and s.part then
                local pos = partPos(s.part)
                if pos then
                    local eS, eV = WorldToScreen(pos)
                    if eV and eS then
                        lasersDrawn = lasersDrawn + 1
                        local Lp = laserPool[lasersDrawn]
                        Lp.line.From = Vector2.new(beamOriginS.X, beamOriginS.Y)
                        Lp.line.To   = Vector2.new(eS.X, eS.Y)
                        Lp.line.Color = COL_LINE_OK
                        Lp.line.Visible = true
                        Lp.dot.Position = Vector2.new(eS.X, eS.Y)
                        Lp.dot.Color = COL_DOT_OK
                        Lp.dot.Visible = true
                    end
                end
            end
        end
    end
    for i = lasersDrawn + 1, LASER_POOL do
        laserPool[i].line.Visible = false
        laserPool[i].dot.Visible = false
    end

    local nsOn = S.noSpread
    if type(_G.__NS) == "boolean" then nsOn = _G.__NS end
    local nsTxt = ""
    if nsOn and equippedTool then
        nsTxt = "  NS:" .. tostring(equippedTool.Name)
    elseif nsOn then
        nsTxt = "  NS:unarmed"
    else
        nsTxt = "  NS:off"
    end

    local shTxt = S.shieldHide and "  [SHIELD]" or ""
    local gmTxt = S.gmEnabled and "  [GMODS]" or ""
    local hpTxt = ""
    if S.aim and t then
        if headAim then
            hpTxt = "  AIM:HEAD"
        elseif bodyAim then
            hpTxt = "  AIM:BODY"
        end
    end

    local y = 12
    if capture then
        ovText.Color = COL_SETTLE
        setRight(ovText, vpX, y, "REBIND " .. capture:upper() .. ": press a key now")
    elseif state == "RELOADING" then
        ovText.Color = COL_SETTLE
        setRight(ovText, vpX, y, "RELOADING ALL...")
    elseif state == "PAUSED" then
        ovText.Color = COL_PAUSE
        setRight(ovText, vpX, y, "TRIGGER PAUSED  (enable toggle in menu)")
    elseif lockedUid then
        local dtxt = (t and t.dist < math.huge) and string.format("  %.0f st", t.dist) or ""
        local ttxt = (t and t.team) and ("  [" .. t.team .. "]") or ""
        local htxt = (t and t.hostileInmate) and "  [FLAGGED]" or ""
        local vtxt = isVirtual and "  (VGUN)" or ""
        local gtxt = string.format("  green %d", greenTotal)
        ovText.Color = (state == "FIRING") and COL_FIRE or COL_WAIT
        setRight(ovText, vpX, y,
            "LOCKED: " .. tostring(lockedName) .. dtxt .. ttxt .. htxt .. vtxt
            .. gtxt .. "  [GUN-LOS]  [" .. state .. "]" .. hpTxt .. nsTxt .. shTxt .. gmTxt)
    else
        ovText.Color = COL_IDLE
        setRight(ovText, vpX, y,
            "UNLOCKED  " .. #targets .. " targets  [GUN-LOS]" .. nsTxt .. shTxt .. gmTxt)
    end
    ovText.Visible = true

    local boxOn = false
    local boxColor = fireOk and COL_FIRE or COL_WAIT
    if S.esp and t and t.head and t.root and not capture and not reloading then
        local okh, hp = pcall(function() return t.head.Position end)
        local okr, rp = pcall(function() return t.root.Position end)
        if okh and okr and hp and rp then
            local top, v1 = WorldToScreen(hp + Vector3.new(0, 0.7, 0))
            local bot, v2 = WorldToScreen(rp - Vector3.new(0, 3.2, 0))
            if v1 and v2 and top and bot then
                local h = bot.Y - top.Y
                if h > 2 then
                    local w = h * 0.5
                    box.Position = Vector2.new(top.X - w * 0.5, top.Y)
                    box.Size = Vector2.new(w, h)
                    box.Color = boxColor
                    box.Visible = true
                    boxOn = true
                end
            end
        end
    end
    if not boxOn then box.Visible = false end

    local inmateIdx = 0
    if S.inmateESP and not capture and not reloading then
        local baseSize = MARKER_SIZE_FIXED
        local minSize  = baseSize * MARKER_MIN_FACTOR
        local maxSize  = baseSize * MARKER_MAX_FACTOR
        for i = 1, #inmates do
            if inmateIdx >= INMATE_POOL then break end
            local inmate = inmates[i]
            if inmate then
                local showAggro  = inmate.aggro == true
                local showArrest = (inmate.arrest == true) and not showAggro

                if inmate.head and (showAggro or showArrest) then
                    local okh2, hp2 = pcall(function() return inmate.head.Position end)
                    if okh2 and hp2 then
                        local sp, vis = WorldToScreen(hp2 + Vector3.new(0, 2.2, 0))
                        if vis and sp then
                            inmateIdx = inmateIdx + 1
                            local slot = inmatePool[inmateIdx]
                            local sz = baseSize
                            if myRootP then
                                local d = (hp2 - myRootP).Magnitude
                                sz = baseSize * MARKER_REF_DIST / math.max(d, 1)
                                sz = math.max(minSize, math.min(maxSize, sz))
                            end
                            sz = math.floor(sz + 0.5)
                            local half = sz / 2

                            if showAggro then
                                slot.aggro.Size = Vector2.new(sz, sz)
                                slot.aggro.Position = Vector2.new(sp.X - half, sp.Y - half)
                                slot.aggro.Visible  = true
                                slot.arrest.Visible = false
                            else
                                if USE_TEXT_ARREST_FALLBACK then
                                    slot.arrest.Size = math.max(10, math.floor(sz * 0.6))
                                    slot.arrest.Position = Vector2.new(sp.X, sp.Y - sz * 0.3)
                                else
                                    slot.arrest.Size = Vector2.new(sz, sz)
                                    slot.arrest.Position = Vector2.new(sp.X - half, sp.Y - half)
                                end
                                slot.arrest.Visible = true
                                slot.aggro.Visible  = false
                            end
                        end
                    end
                end
            end
        end
    end
    for i = inmateIdx + 1, INMATE_POOL do
        inmatePool[i].aggro.Visible = false
        inmatePool[i].arrest.Visible = false
    end
end

