local function isHostile(tName)
    if tName and TEAM_TARGET[tName] == false then return false end
    return true
end

local FLAG_AGGRO  = { "Hostile" }
local FLAG_ARREST = { "Trespassing" }

local function readAttr(ch, name)
    local ok, v = pcall(function() return ch:GetAttribute(name) end)
    if ok then return v end
    return nil
end

local function flagOn(ch, names)
    for _, n in ipairs(names) do
        local v = readAttr(ch, n)
        if v == true then return true end
        if type(v) == "number" and v > 0 then return true end
    end
    return false
end

local function hasArrestHighlight(ch)
    local okd, desc = pcall(function() return ch:GetDescendants() end)
    if not okd or not desc then return false end
    for i = 1, #desc do
        local d = desc[i]
        local cls
        pcall(function() cls = d.ClassName end)
        if cls == "Highlight" then
            local nm, en
            pcall(function() nm = d.Name end)
            pcall(function() en = d.Enabled end)
            if en ~= false and nm == "ArrestHighlight" then return true end
        end
    end
    return false
end

local lastDbg = {}
local flagCache = {}

local function detectInmateState(ch, uid, pname, now)
    local fc = flagCache[uid]
    if fc and fc.ch == ch and (now - fc.t) < FLAG_REFRESH then
        return fc.aggro, fc.arrest, fc.viaHighlight
    end
    local aggro = flagOn(ch, FLAG_AGGRO)
    local viaHL = hasArrestHighlight(ch)
    local arrest = viaHL or flagOn(ch, FLAG_ARREST)
    flagCache[uid] = { ch=ch, t=now, aggro=aggro, arrest=arrest, viaHighlight=viaHL }
    if DEBUG_FLAGS then
        local key = tostring(aggro) .. "|" .. tostring(arrest) .. "|" .. tostring(viaHL)
        if lastDbg[uid] ~= key then
            lastDbg[uid] = key
            log(string.format("%s aggro=%s arrest=%s viaHL=%s",
                tostring(pname), tostring(aggro), tostring(arrest), tostring(viaHL)))
        end
    end
    return aggro, arrest, viaHL
end

