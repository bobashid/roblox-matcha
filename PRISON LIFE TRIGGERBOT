                            if ok2 and rp then dist = (rp - myPos).Magnitude end
                        end
                        local t = { uid=uid, name=p.Name, team=tName, char=ch,
                                    parts=c.parts, root=c.root, head=c.head,
                                    dist=dist or math.huge, hostileInmate=hostileInmate }
                        out[#out + 1] = t
                        byUid[uid] = t
                        seen[uid] = true
                    end
                    if tName == "Inmates" and c.root and c.head then
                        seen[uid] = true
                        inmateList[#inmateList + 1] = {
                            uid=uid, head=c.head, aggro=aggro, arrest=arrest,
                            hostile=hostileInmate, viaHighlight=viaHL,
                        }
                    end
                end
            end
        end
        for uid in pairs(cache) do
            if not seen[uid] then cache[uid] = nil end
        end

        -- OPT: rebuild charPartSet only when the character set changes,
        -- otherwise refresh every 0.5s. Was: every collector tick.
        if charCount ~= lastCharCount or (now - lastPartSetAt) > 0.5 then
            lastCharCount = charCount
            lastPartSetAt = now
            charPartSet = rebuildCharPartSet(newChars)
        end

        targets, targetByUid, inmates = out, byUid, inmateList
        pcall(function() wallParams.FilterDescendantsInstances = filter end)
        task.wait(COLLECT_WAIT)
    end
end)

-- ============================================================
-- SEE-THROUGH FILTER
-- ============================================================
local lastBlocker = nil
local HEAD_OFFSETS = { Vector3.new(0,0,0), Vector3.new(0,0.5,0) }
local GLASS_KEYS = {
    "glass","window","windshield","windscreen","visor","transparent",
    "wind","shield","screen","pane","tint","carwin","carwindow",
    "vehiclewindow","vehicle_glass","autoglass","clear",
}

local function nameLooksGlass(nm)
    if type(nm) ~= "string" then return false end
    local s = nm:lower():gsub("%s", "")
    for _, key in ipairs(GLASS_KEYS) do
        if s:find(key, 1, true) then return true end
    end
    return false
end

local function isSeeThrough(inst)
    if not inst then return true end

    local tr
    pcall(function() tr = inst.Transparency end)
    if type(tr) == "number" and tr >= 0.95 then return true end

    local ltm
    pcall(function() ltm = inst.LocalTransparencyModifier end)
    if type(ltm) == "number" and ltm >= 0.8 then return true end

    local cq
    pcall(function() cq = inst.CanQuery end)
    if cq == false then return true end

    local cc
    pcall(function() cc = inst.CanCollide end)
    if cc == false then return true end

    local mat
    pcall(function() mat = inst.Material end)
    local isGlassMat = false
    if mat ~= nil then
        local ok1, mn = pcall(function() return mat.Name end)
        if ok1 and type(mn) == "string" and mn:lower():find("glass",1,true) then
            isGlassMat = true
        end
        if not isGlassMat then
            local ok2, ts = pcall(function() return tostring(mat) end)
            if ok2 and type(ts) == "string" and ts:lower():find("glass",1,true) then
                isGlassMat = true
            end
        end
        if not isGlassMat then
            pcall(function() isGlassMat = (mat == Enum.Material.Glass) end)
        end
    end

    local nm
    pcall(function() nm = inst.Name end)
    local isGlassName = nameLooksGlass(nm)

    if isGlassMat or isGlassName then
        if STRICT_PASS then
            if type(tr) == "number" and tr >= 0.5 then return true end
            if type(ltm) == "number" and ltm >= 0.5 then return true end
        else
            if type(tr) == "number" and tr >= 0.15 then return true end
            if type(ltm) == "number" and ltm >= 0.15 then return true end
            return true
        end
    end

    if type(tr) == "number" and tr >= 0.8 then return true end
    return false
end

local function traceRay(origin, goal, targetChar)
    local o = origin
    for _ = 1, RAY_MAX_BOUNCE do
        local dir = goal - o
        local dist = dir.Magnitude
        if dist < 0.3 then return true, goal, nil end
        local ok, res = pcall(function() return Workspace:Raycast(o, dir, shotParams) end)
        if not ok or not res then return true, goal, nil end
        local inst = res.Instance
        if not inst then return true, goal, nil end
        local rd = res.Distance or 0
        if (dist - rd) < 0.5 then return true, goal, nil end

        if targetChar and isDescendantOf(inst, targetChar) then
            return true, res.Position, inst
        end
        if isOtherPlayerPart(inst) then
            o = res.Position + dir.Unit * 0.1
        elseif isSeeThrough(inst) then
            o = res.Position + dir.Unit * 0.1
        else
            return false, res.Position, inst
        end
    end
    return false, goal, nil
end

local function computeVisible(t, origin)
    local visible = {}
    if not t or not t.parts or not origin then return visible end
    local head = t.head or t.root

    if head and isShotPart(head) then
        local ok, base = pcall(function() return head.Position end)
        if ok and base then
            for _, off in ipairs(HEAD_OFFSETS) do
                if traceRay(origin, base + off, t.char) then
                    visible[#visible + 1] = head
                    break
                end
            end
        end
    end

    local parts = t.parts
    for i = 1, #parts do
        if #visible >= VISIBLE_CAP then break end
        local p = parts[i]
        if p ~= head and isShotPart(p) then
            local ok, base = pcall(function() return p.Position end)
            if ok and base then
                if traceRay(origin, base, t.char) then
                    visible[#visible + 1] = p
                end
            end
        end
    end
    return visible
end

local function pickFromVisible(t, visible)
    local head = t.head or t.root
    if not visible or #visible == 0 then return head end
    for i = 1, #visible do
        if visible[i] == head then return head end
    end
    return visible[1]
end

local curMX, curMY, curVX, curVY = 0, 0, 1920, 1080

local function screenInfo(t)
    local bestD, onScr = math.huge, false
    for i = 1, 2 do
        local part = (i == 1) and t.head or t.root
        if part then
            local okp, p = pcall(function() return part.Position end)
            if okp and p then
                local sp, vis = WorldToScreen(p)
                if vis and sp then
                    if sp.X >= 0 and sp.X <= curVX and sp.Y >= 0 and sp.Y <= curVY then onScr = true end
                    local dx, dy = sp.X - curMX, sp.Y - curMY
                    local d = math.sqrt(dx*dx + dy*dy)
                    if d < bestD then bestD = d end
                end
            end
        end
    end
    return bestD, onScr
end

local lockedUid, lockedName = nil, nil
local lostSince = nil
local visState = { uid=nil, vis=false, part=nil, visible=nil, gunOrigin=nil, virtual=false }
local lastLockAt = 0

local function applyLock(t, how, value)
    if not t then
        pcall(function() notify("No valid target", "Trigger", 1) end)
        return
    end
    if lockedUid == t.uid then return end
    local switched = lockedUid ~= nil
    lockedUid, lockedName, lostSince = t.uid, t.name, nil
    visState.uid, visState.vis = nil, false
    visState.part, visState.visible = nil, nil
    lastLockAt = os.clock()
    local extra = ""
    if how == "mouse" and value then extra = string.format(" (%.0f px)", value) end
    if t.team then extra = extra .. " [" .. t.team .. "]" end
    if t.hostileInmate then extra = extra .. " [FLAGGED]" end
    log((switched and "Switched -> " or "Locked -> ") .. t.name .. extra)
    pcall(function() notify((switched and "Switched: " or "Locked: ") .. t.name, "Trigger", 1) end)
end

local function pickByMouse()
    local best, bestD = nil, math.huge
    for _, t in ipairs(targets) do
        local d, on = screenInfo(t)
        if on and d < bestD then bestD, best = d, t end
    end
    if best and (S.lockRadius <= 0 or bestD <= S.lockRadius) then return best, bestD end
    return nil
end

local function doUnlock()
    if lockedUid then
        log("Unlocked " .. tostring(lockedName))
        pcall(function() notify("Unlocked", "Trigger", 1) end)
    end
    lockedUid, lockedName, lostSince = nil, nil, nil
    visState.part, visState.visible = nil, nil
end

-- ============================================================
-- RELOAD ALL  (1 yield per slot; ~3 frames for 3 slots)
-- ============================================================
local function doReloadAll()
    if reloading then return end
    reloading = true
    local slots = cycleKeys
    local n = #slots
    pcall(function() notify("Reloading all", "Trigger", 1) end)

    task.spawn(function()
        local t0 = os.clock()
        if n < 1 then reloading = false; return end

        for i = 1, n do
            local code = slots[i]
            pcall(function() keypress(code) end)
            pcall(function() keyrelease(code) end)

            if not RELOAD_SAME_FRAME then
                task.wait(0.02)
            end

            pcall(function() keypress(RELOAD_KEY) end)
            pcall(function() keyrelease(RELOAD_KEY) end)
        end

        pcall(function() keypress(slots[1]) end)
        pcall(function() keyrelease(slots[1]) end)
        pcall(function() keyrelease(RELOAD_KEY) end)

        reloading = false
        if RELOAD_LOG then
            log(string.format("reload all: %d slots in %.3fs", n, os.clock() - t0))
        end
    end)
end

-- ============================================================
-- VISIBILITY LOOP
-- ============================================================
task.spawn(function()
    local lastVisAt = 0
    while running do
        local uid = lockedUid
        local t = uid and targetByUid[uid]
        if t then
            local now = os.clock()
            if visState.uid ~= uid then
                visState.uid = uid
                visState.vis = false
                visState.part, visState.visible = nil, nil
                lastVisAt = 0
            end
            if (now - lastVisAt) > VIS_REFRESH then
                lastVisAt = now
                local origin, isVirtual = getShotOrigin()
                visState.gunOrigin = origin
                visState.virtual = isVirtual
                if origin then
                    lastBlocker = nil
                    local visible = computeVisible(t, origin)
                    visState.visible = visible
                    visState.vis = #visible > 0
                    visState.part = pickFromVisible(t, visible)
                else
                    visState.visible = nil
                    visState.vis = false
                end
            end
        else
            visState.visible = nil
            visState.vis = false
        end
        task.wait(0.01)
    end
end)

