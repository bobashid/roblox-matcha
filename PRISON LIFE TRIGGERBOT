local equippedTool = nil

local function getEquippedTool()
    local ch = lp.Character
    if not ch then return nil end
    local t = ch:FindFirstChildOfClass("Tool")
    if t then return t end
    local ok, kids = pcall(function() return ch:GetChildren() end)
    if ok and kids then
        for i = 1, #kids do
            local c = kids[i]
            local cls
            pcall(function() cls = c.ClassName end)
            if cls == "Tool" then return c end
        end
    end
    return nil
end

local function applyNoSpread(tool)
    if not tool then return end
    for i = 1, #SPREAD_ATTRS do
        pcall(function() tool:SetAttribute(SPREAD_ATTRS[i], 0) end)
    end
    local ok, desc = pcall(function() return tool:GetDescendants() end)
    if not ok or not desc then return end
    for i = 1, #desc do
        local d = desc[i]
        local cls
        pcall(function() cls = d.ClassName end)
        if cls == "NumberValue" or cls == "IntValue" or cls == "FloatValue"
           or cls == "DoubleValue" then
            local nm
            pcall(function() nm = d.Name end)
            if type(nm) == "string" then
                local ln = nm:lower()
                local hit, isAcc = false, false
                for _, sub in ipairs(SPREAD_SUBSTR) do
                    if ln:find(sub, 1, true) then hit = true break end
                end
                for _, sub in ipairs(ACCURACY_SUBSTR) do
                    if ln:find(sub, 1, true) then isAcc = true hit = true break end
                end
                if hit then
                    pcall(function() d.Value = isAcc and 1 or 0 end)
                end
            end
        end
    end
end

local function applyGunAttrs(tool)
    if not tool or not S.gmEnabled then return end

    local nm
    pcall(function() nm = tool.Name end)
    if type(nm) ~= "string" then return end

    if nm == "Remington 870" then
        local cur
        pcall(function() cur = tool:GetAttribute("AutoFire") end)
        if cur ~= S.shotgunAuto then
            pcall(function() tool:SetAttribute("AutoFire", S.shotgunAuto) end)
        end
    end
    if S.arInstant and AR_SET[nm] then
        local cur
        pcall(function() cur = tool:GetAttribute("FireRate") end)
        if cur ~= 0.001 then
            pcall(function() tool:SetAttribute("FireRate", 0.001) end)
        end
    end
    if S.m9Auto and nm == "M9" then
        local cur
        pcall(function() cur = tool:GetAttribute("AutoFire") end)
        if cur ~= true then
            pcall(function() tool:SetAttribute("AutoFire", true) end)
        end
    end
    if S.instantFire then
        local cur, exists = nil, false
        pcall(function() cur = tool:GetAttribute("FireRate"); exists = (cur ~= nil) end)
        if exists and cur ~= 0.001 then
            pcall(function() tool:SetAttribute("FireRate", 0.001) end)
        end
    end
end

