local TEAM_LIST   = {}
local TEAM_TARGET = {}
local myTeamName  = nil

do
    local seen = {}
    local function add(n)
        if n and n ~= "" and not seen[n] then
            seen[n] = true
            TEAM_LIST[#TEAM_LIST + 1] = n
        end
    end
    for _, t in ipairs(Teams:GetChildren()) do add(t.Name) end
    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function() add((p.Team and p.Team.Name) or nil) end)
    end
    table.sort(TEAM_LIST)
    for _, n in ipairs(TEAM_LIST) do TEAM_TARGET[n] = true end
end

local function isHostile(tName)
    if tName and TEAM_TARGET[tName] == false then return false end
    return true
end

-- ============================================================
-- KEY MAP  (raw Windows VK codes - Enum args throw in this VM)
-- ============================================================
local RAW_NAME = {
    [8]="Backspace",[9]="Tab",[13]="Enter",[16]="Shift",[17]="Ctrl",[18]="Alt",
    [20]="CapsLock",[27]="Escape",[32]="Space",
    [48]="0",[49]="1",[50]="2",[51]="3",[52]="4",[53]="5",[54]="6",[55]="7",[56]="8",[57]="9",
    [65]="A",[66]="B",[67]="C",[68]="D",[69]="E",[70]="F",[71]="G",[72]="H",[73]="I",[74]="J",
    [75]="K",[76]="L",[77]="M",[78]="N",[79]="O",[80]="P",[81]="Q",[82]="R",[83]="S",[84]="T",
    [85]="U",[86]="V",[87]="W",[88]="X",[89]="Y",[90]="Z",
}
for i = 1, 12 do RAW_NAME[111 + i] = "F" .. i end

local NAME_RAW = {}
for raw, name in pairs(RAW_NAME) do NAME_RAW[name] = raw end

local function parseKey(v)
    if v == nil then return nil end
    local t = type(v)
    if t == "number" then
        if v >= 0 and v <= 255 then return v end
        return nil
    elseif t == "string" then
        local s = v:upper():gsub("ENUM%.KEYCODE%.", ""):gsub("ENUMITEM:", ""):gsub("%s", "")
        if NAME_RAW[s] then return NAME_RAW[s] end
        local n = tonumber(s)
        if n and n >= 0 and n <= 255 then return n end
        local f = s:match("^F(%d+)$")
        if f then return 111 + tonumber(f) end
        return nil
    elseif t == "userdata" or t == "table" then
        local ok, name = pcall(function() return v.Name end)
        if ok and type(name) == "string" then
            local r = parseKey(name); if r then return r end
        end
        local ok2, val = pcall(function() return v.Value end)
        if ok2 and (type(val) == "number" or type(val) == "string") then
            local r = parseKey(val); if r then return r end
        end
        local ok3, s = pcall(function() return tostring(v) end)
        if ok3 and s then
            local r = parseKey(s); if r then return r end
        end
    end
    return nil
end

local function keyName(raw)
    if not raw then return "?" end
    return RAW_NAME[raw] or ("0x" .. string.format("%X", raw))
end

local binds   = { lock = 70, unlock = 71, reload = 82 }
local ACTIONS = { "lock", "unlock", "reload" }

local lastUI    = {}
local capture   = nil
local reloading = false

local function uiGet(id)
    local ok, v = pcall(function() return UI.GetValue(id) end)
    if ok then return v end
    return nil
end

local function setBind(act, v, src)
    local raw = parseKey(v)
    if raw then
        binds[act] = raw
        log(act .. " key -> " .. keyName(raw) .. " [" .. tostring(src) .. "]")
    else
        log(act .. " key unparsed [" .. tostring(src) .. "]: " .. tostring(v)
            .. " (" .. type(v) .. " / " .. tostring(typeof(v)) .. ")")
    end
end

