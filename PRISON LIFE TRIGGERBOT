-- LIFECYCLE
-- ============================================================
local running = true
local connRender, connBegan
local drawings = {}

local function newDrawing(kind)
    local d = Drawing.new(kind)
    drawings[#drawings + 1] = d
    return d
end

local function shutdown()
    running = false
    pcall(function() if connRender then connRender:Disconnect() end end)
    pcall(function() if connBegan  then connBegan:Disconnect()  end end)
    for _, d in ipairs(drawings) do pcall(function() d:Remove() end) end
    pcall(function()
        for _, code in ipairs({ 49, 50, 51, 82 }) do keyrelease(code) end
    end)
end

pcall(function() if _G.__TRIGGER_STOP then _G.__TRIGGER_STOP() end end)
pcall(function() _G.__TRIGGER_STOP = shutdown end)

local function log(s) print("[TRIGGER] " .. tostring(s)) end

