        local oS, oV = WorldToScreen(shotOrigin)
        if oV and oS then
            for i = 1, shotCheckN do
                if lasersDrawn >= LASER_POOL then break end
                local c = shotChecks[i]
                local eS, eV = WorldToScreen(c.endPoint)
                if eV and eS then
                    lasersDrawn = lasersDrawn + 1
                    local L = laserPool[lasersDrawn]
                    L.line.From = Vector2.new(oS.X, oS.Y)
                    L.line.To   = Vector2.new(eS.X, eS.Y)
                    L.line.Color = c.lands and COL_LINE_OK or COL_LINE_BAD
                    L.line.Visible = true
                    L.dot.Position = Vector2.new(eS.X, eS.Y)
                    L.dot.Color = c.lands and COL_DOT_OK or COL_DOT_BAD
                    L.dot.Visible = true
                end
            end
        end
    end
    for i = lasersDrawn + 1, LASER_POOL do
        laserPool[i].line.Visible = false
        laserPool[i].dot.Visible = false
    end

    local y = 12
    if capture then
        ovText.Color = COL_SETTLE
        setRight(ovText, vpX, y, "REBIND " .. capture:upper() .. ": press a key now")
    elseif state == "RELOADING" then
        ovText.Color = COL_SETTLE
        setRight(ovText, vpX, y, "RELOADING ALL...")
    elseif state == "PAUSED" then
        ovText.Color = COL_PAUSE
        setRight(ovText, vpX, y, "TRIGGER PAUSED  (enable toggle in menu)")
    elseif lockedUid then
