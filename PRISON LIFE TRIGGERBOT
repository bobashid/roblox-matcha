local COL_FIRE    = Color3.fromRGB(80, 255, 80)
local COL_WAIT    = Color3.fromRGB(255, 140, 0)
local COL_IDLE    = Color3.fromRGB(150, 150, 150)
local COL_PAUSE   = Color3.fromRGB(255, 70, 70)
local COL_SETTLE  = Color3.fromRGB(120, 180, 255)
local COL_LINE_OK = Color3.fromRGB(80, 255, 80)
local COL_LINE_BAD= Color3.fromRGB(255, 70, 70)
local COL_DOT_OK  = Color3.fromRGB(80, 255, 80)
local COL_DOT_BAD = Color3.fromRGB(255, 70, 70)

local cycIndex, cycStage = 1, 0
local lastShot = 0

local function releaseCycle()
    if cycStage == 1 then
        local code = cycleKeys[cycIndex]
        if code then pcall(function() keyrelease(code) end) end
    end
    cycStage, cycIndex = 0, 1
end

local scOrdered = {}
local scSeenP   = {}
local shotChecks = {}
local shotCheckN = 0

local function buildShotChecks(t, origin)
    shotCheckN = 0
    if not t or not origin then return end

    for i = 1, #scOrdered do scOrdered[i] = nil end
    for k in pairs(scSeenP) do scSeenP[k] = nil end

    local head = t.head or t.root
    if head and isShotPart(head) then
        scOrdered[#scOrdered + 1] = head
        scSeenP[head] = true
    end
    local vis = visState.visible
    if vis then
        for i = 1, #vis do
            local p = vis[i]
            if not scSeenP[p] and isShotPart(p) then
                scOrdered[#scOrdered + 1] = p
                scSeenP[p] = true
            end
        end
    end

    updateShotFilter()
    local limit = #scOrdered
    if limit > SHOT_CHECK_CAP then limit = SHOT_CHECK_CAP end
    for i = 1, limit do
        local p = scOrdered[i]
        local okp, pos = pcall(function() return p.Position end)
        if okp and pos then
            local reached, endPos, endInst = traceRay(origin, pos, t.char)
            local lands = reached
            if not lands and endInst then
                lands = isDescendantOf(endInst, t.char)
            end
            shotCheckN = shotCheckN + 1
            local e = shotChecks[shotCheckN]
            if not e then e = {}; shotChecks[shotCheckN] = e end
            e.part = p
            e.endPoint = endPos or pos
            e.lands = lands
            e.isHead = (p == head)
        end
    end
end

connRender = RunService.RenderStepped:Connect(function()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local vpX, vpY = vp.X, vp.Y
    local now = os.clock()

    local camPos
    pcall(function() camPos = cam.CFrame.Position end)

    if testImg and testImg.Visible then
        testImg.Position = Vector2.new(vpX / 2 - 48, vpY / 2 - 48)
    end

    local mx, my = vpX / 2, vpY / 2
    pcall(function()
        local m = lp:GetMouse()
        if m then
            local x, y = m.X, m.Y
            if type(x) == "number" and type(y) == "number" then mx, my = x, y end
        end
    end)
    curMX, curMY, curVX, curVY = mx, my, vpX, vpY

    local t = lockedUid and targetByUid[lockedUid] or nil

    if lockedUid and not t then
        lostSince = lostSince or now
        if (not S.retarget) and (now - lostSince) > DEATH_GRACE then
            doUnlock()
        end
    elseif t then
        lostSince = nil
    end

    local targetOnScreen = false
    if t then
        if t.head then
            local ok, wp = pcall(function() return t.head.Position end)
            if ok and wp then
                local sp, vis = WorldToScreen(wp)
                if vis and sp and sp.X >= 0 and sp.X <= vpX and sp.Y >= 0 and sp.Y <= vpY then
                    targetOnScreen = true
                end
            end
        end
        if not targetOnScreen and t.root then
            local ok, wp = pcall(function() return t.root.Position end)
            if ok and wp then
                local sp, vis = WorldToScreen(wp)
                if vis and sp and sp.X >= 0 and sp.X <= vpX and sp.Y >= 0 and sp.Y <= vpY then
                    targetOnScreen = true
                end
            end
        end
    end

    local onScreen = targetOnScreen
    local los = false
    if t and visState.uid == lockedUid then los = visState.vis end

    local state = "IDLE"
    if not S.enabled then state = "PAUSED"
    elseif lockedUid and not t then state = "LOST"
    elseif t then
        if not onScreen then state = "OFF SCREEN"
        elseif not los then state = "NO LOS"
        else state = "FIRING" end
    end
    if reloading then state = "RELOADING" end

    local shotOrigin, isVirtual = getShotOrigin()

    local fireOk = false
    buildShotChecks(t, shotOrigin)
    for i = 1, shotCheckN do
        if shotChecks[i].lands then fireOk = true; break end
    end

    if fireOk then
        if (now - lastShot) >= RATE then
            lastShot = now
            if S.cycle then
                local code = cycleKeys[cycIndex]
                if code then
                    if cycStage == 0 then
                        pcall(function() keypress(code) end)
                        cycStage = 1
                    else
                        pcall(function() keyrelease(code) end)
                        cycStage = 0
                        cycIndex = cycIndex + 1
                        if cycIndex > #cycleKeys then cycIndex = 1 end
                    end
                end
            end
            pcall(function() mouse1click() end)
        end
    else
        releaseCycle()
    end

    if S.aim and t and S.enabled and not reloading and not capture then
        local active = true
        pcall(function() active = isrbxactive() end)
        if active then
            local part = visState.part or t.head or t.root
            if part then
                local okp, pos = pcall(function() return part.Position end)
                if okp and pos then
                    local sp, vis = WorldToScreen(pos)
                    if vis and sp then
                        local dx, dy = sp.X - mx, sp.Y - my
                        local dist = math.sqrt(dx*dx + dy*dy)
                        if dist > AIM_DEADZONE then
                            local gain = (S.aimStr or 40) / 100
                            gain = gain * (1 + math.min(dist / AIM_FAR_PX, 1) * AIM_FAR_BOOST)
                            if gain > 1 then gain = 1 end
                            local stepX = math.max(-AIM_MAX_STEP, math.min(AIM_MAX_STEP, dx * gain))
                            local stepY = math.max(-AIM_MAX_STEP, math.min(AIM_MAX_STEP, dy * gain))
                            local ix = math.floor(stepX + (stepX >= 0 and 0.5 or -0.5))
                            local iy = math.floor(stepY + (stepY >= 0 and 0.5 or -0.5))
                            if ix ~= 0 or iy ~= 0 then
                                pcall(function() mousemoverel(ix, iy) end)
                            end
                        end
                    end
                end
