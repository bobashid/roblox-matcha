-- ============================================================
-- INMATE FLAG DETECTION  (by VALUE)
--   GetAttributes() only returns attribute NAMES, so we read the
--   real value with GetAttribute(name) and require it to be true.
-- ============================================================
local FLAG_AGGRO  = { "Hostile" }
local FLAG_ARREST = { "Trespassing" }

local function readAttr(ch, name)
    local ok, v = pcall(function() return ch:GetAttribute(name) end)
    if ok then return v end
    return nil
end

local function flagOn(ch, names)
    for _, n in ipairs(names) do
        local v = readAttr(ch, n)
        if v == true then return true end
        if type(v) == "number" and v > 0 then return true end
    end
    return false
end

local lastDbg = {}

local function detectInmateState(ch, uid, pname)
    local aggro  = flagOn(ch, FLAG_AGGRO)
    local arrest = flagOn(ch, FLAG_ARREST)

    if DEBUG_FLAGS then
        local rawA = readAttr(ch, FLAG_AGGRO[1])
        local rawT = readAttr(ch, FLAG_ARREST[1])
        local key = tostring(rawA) .. "|" .. tostring(rawT)
        if lastDbg[uid] ~= key then
            lastDbg[uid] = key
            log(string.format("%s  %s=%s (%s)  %s=%s (%s)",
                tostring(pname),
                FLAG_AGGRO[1],  tostring(rawA), typeof(rawA),
                FLAG_ARREST[1], tostring(rawT), typeof(rawT)))
        end
    end

    return aggro, arrest
end

