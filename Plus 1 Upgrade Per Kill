-- Plus 1 Upgrade Per Kill - kill aura - Matcha LuauVM
-- One toggle. Every pass it hits every alive player inside RANGE, then waits
-- 0.01s. Uses the game's Remotes.Attack with the swing aimed at the target,
-- so the server's own distance check still passes.
-- No Instance.new, no hooks, no input simulation.

local NAME    = 'HitEveryone'
local VERSION = 'v1.2'

if _G[NAME] and _G[NAME].stop then
    pcall(_G[NAME].stop)
end
print('[' .. NAME .. '] ' .. VERSION)

local Players = game:GetService('Players')
local RS      = game:GetService('ReplicatedStorage')
local lp      = Players.LocalPlayer

local remotes = RS:FindFirstChild('Remotes')
local Attack  = remotes and remotes:FindFirstChild('Attack')
if not Attack then
    warn('[' .. NAME .. '] Remotes.Attack not found - script idle')
end

-- kill aura radius in studs
local RANGE = 12

local running = true
local built   = false
local targets = {}

local cfg = {
    aura = true,
}

local function setBool(key, v)
    if cfg[key] ~= v then
        cfg[key] = v
        print('[' .. NAME .. '] ' .. key .. ' = ' .. tostring(v))
    end
end

local function aliveTarget(plr)
    if plr == lp then return nil end
    local c = plr.Character
    if not c then return nil end
    local hrp = c:FindFirstChild('HumanoidRootPart')
    if not hrp then return nil end
    local cid = c:GetAttribute('CombatantId')
    if type(cid) ~= 'number' then return nil end
    local hp = c:GetAttribute('Health')
    if type(hp) == 'number' and hp <= 0 then return nil end
    if c:GetAttribute('Zone') ~= 'Arena' then return nil end
    return { char = c, root = hrp }
end

local function fireAt(char, eye, targetPos)
    local dir = targetPos - eye
    if dir.Magnitude < 0.001 then
        dir = Vector3.new(0, -1, 0)
    else
        dir = dir.Unit
    end
    local payload = {
        sprint = false,
        crit   = false,
        eye    = eye,
        dir    = dir,
        block  = false,
        charge = 1,
        t      = os.clock(),
        vt     = nil,
    }
    pcall(function()
        Attack:FireServer(char, payload)
    end)
end

-- menu ---------------------------------------------------------------

local HAS_UI = type(UI) == 'table' and type(UI.AddTab) == 'function'

local function firstBool(...)
    for i = 1, select('#', ...) do
        local v = select(i, ...)
        if type(v) == 'boolean' then return v end
    end
    return nil
end

local function mkSection(tab, name)
    local sides = { 'Left', 'Right' }
    for i = 1, #sides do
        local ok, sec = pcall(function() return tab:Section(name, sides[i]) end)
        if ok and sec ~= nil then return sec end
    end
    local ok2, sec2 = pcall(function() return tab:Section(name) end)
    if ok2 and sec2 ~= nil then return sec2 end
    warn('[' .. NAME .. '] section ' .. name .. ' failed')
    return nil
end

local function mkToggle(sec, label, id, default, apply)
    local cb = function(...)
        local v = firstBool(...)
        if v ~= nil then apply(v) end
    end
    local tries = {
        function() sec:Toggle(label, id, default, cb) end,
        function() sec:Toggle(id, label, default, cb) end,
        function() sec:Toggle(label, default, cb) end,
    }
    for i = 1, #tries do
        if pcall(tries[i]) then return true end
    end
    warn('[' .. NAME .. '] toggle failed: ' .. label)
    return false
end

local function buildTab(tab)
    if built then return end
    built = true
    local ok, err = pcall(function()
        local sec = mkSection(tab, 'Kill Aura')
        if not sec then return end
        mkToggle(sec, 'Kill Aura', 'he_aura', true, function(v) setBool('aura', v) end)
    end)
    if not ok then
        warn('[' .. NAME .. '] build error: ' .. tostring(err))
    end
    print('[' .. NAME .. '] tab widgets built')
end

if HAS_UI then
    local ok, err = pcall(function()
        UI.AddTab('Kill Aura', function(tab)
            if built then return end
            print('[' .. NAME .. '] tab opened - building widgets')
            pcall(buildTab, tab)
        end)
    end)
    if not ok then
        warn('[' .. NAME .. '] UI.AddTab failed: ' .. tostring(err))
        HAS_UI = false
    end
else
    warn('[' .. NAME .. '] no UI table - menu unavailable')
end

-- poll the menu ------------------------------------------------------

task.spawn(function()
    while running do
        if HAS_UI and type(UI.GetValue) == 'function' then
            pcall(function()
                local v = UI.GetValue('he_aura')
                if type(v) ~= 'boolean' then v = UI.GetValue('Kill Aura') end
                if type(v) == 'boolean' then cfg.aura = v end
            end)
        end
        task.wait(0.2)
    end
end)

-- collector: resolves characters a few times a second -----------------

task.spawn(function()
    while running do
        local out = {}
        local list = Players:GetPlayers()
        for i = 1, #list do
            local t = aliveTarget(list[i])
            if t then out[#out + 1] = t end
        end
        targets = out
        task.wait(0.2)
    end
end)

-- kill aura loop: one sweep every 0.01s -------------------------------

task.spawn(function()
    while running do
        if cfg.aura and Attack then
            local char = lp.Character
            local myRoot = char and char:FindFirstChild('HumanoidRootPart')
            if myRoot then
                local myPos = myRoot.Position
                local eye = myPos + Vector3.new(0, 1.5, 0)
                local list = targets
                for i = 1, #list do
                    if not running or not cfg.aura then break end
                    local t = list[i]
                    local pos = t.root.Position
                    if (pos - myPos).Magnitude <= RANGE then
                        fireAt(t.char, eye, pos)
                    end
                end
            end
            task.wait(0.01)
        else
            task.wait(0.1)
        end
    end
end)

-- stop ---------------------------------------------------------------

local function stop()
    running = false
    cfg.aura = false
    if HAS_UI then
        pcall(function() UI.RemoveTab('Kill Aura') end)
    end
    _G[NAME] = nil
    print('[' .. NAME .. '] stopped')
end

_G[NAME] = { stop = stop, version = VERSION }
print('[' .. NAME .. '] ' .. VERSION .. ' loaded, menu=' .. tostring(HAS_UI) .. ' - open the Kill Aura tab')
